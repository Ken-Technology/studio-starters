{%- assign accent = brand.colors.primary | default: '#c8372d' -%}
{%- assign font_head = brand.fonts.heading | default: 'Schibsted Grotesk' -%}
{%- assign font_body = brand.fonts.body | default: 'Schibsted Grotesk' -%}
{%- assign head_q = font_head | replace: ' ', '+' -%}
{%- assign body_q = font_body | replace: ' ', '+' -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex">
<title>Your new homepage, sketched: {{ account.name | escape }}</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ head_q }}:wght@400;500;700{% if font_body != font_head %}&family={{ body_q }}:wght@400;500;600{% endif %}&display=swap">
<style>
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:#f3f3f0;color:#15171a;font-family:'{{ font_body }}',ui-sans-serif,system-ui,sans-serif;font-size:16px;line-height:1.55;-webkit-font-smoothing:antialiased}
.am{--a:{{ accent }};--ink:#15171a;--mute:#646871;--line:#d9dad5;--sheet:#fff}
.am h1,.am h2{font-family:'{{ font_head }}',ui-sans-serif,system-ui,sans-serif;font-weight:700;line-height:1.1;letter-spacing:-.018em;margin:0;text-wrap:balance}
.am p{margin:0 0 .9rem}
.am-wrap{max-width:44rem;margin:0 auto;padding:0 1.25rem}
.am-top{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:1rem 0;border-bottom:1px solid var(--line)}
.am-logo{height:24px;width:auto;display:block}
.am-brand{font-weight:700;font-size:.95rem;margin:0!important}
.am-for{font-size:.85rem;color:var(--mute);margin:0!important;text-align:right}
.am-for b{color:var(--ink);font-weight:600}
.am-intro{padding:2.2rem 0 1.4rem}
.am h1{font-size:2.3rem;margin:0 0 1rem}
.am-lead{font-size:1.1rem;line-height:1.5}
.am-frame{background:var(--sheet);border:1.5px solid var(--ink);border-radius:10px;margin:0 0 1.6rem;overflow:hidden}
.am-chrome{display:flex;align-items:center;gap:.5rem;padding:.55rem .8rem;background:#f3f3f0;border-bottom:1px solid var(--line)}
.am-chrome i{width:9px;height:9px;border-radius:50%;background:#c9cac5;display:block}
.am-chrome span{flex:1;margin-left:.3rem;background:#fff;border:1px solid var(--line);border-radius:999px;padding:.15rem .7rem;font-size:.78rem;color:var(--mute);text-align:center;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
.am-mock{padding:1.2rem 1.1rem 1.4rem}
.am-nav{display:flex;align-items:center;justify-content:space-between;gap:.8rem;padding:0 0 .9rem;border-bottom:1px solid var(--line);margin:0 0 1.2rem}
.am-nav b{font-size:.95rem;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;min-width:0}
.am-bars{display:flex;gap:.55rem;flex:none}
.am-bars i{display:block;width:30px;height:7px;border-radius:4px;background:#d4d5d0}
.am-bars i:last-child{display:none}
.am-navbtn{display:block;flex:none;width:52px;height:22px;border:1.5px solid var(--ink);border-radius:5px}
.am-lines i{display:block;height:12px;border-radius:4px;background:#e4e4df;margin:0 0 .6rem}
.am-lines i:nth-child(1){width:72%;height:22px;background:#d4d5d0}
.am-lines i:nth-child(2){width:88%}
.am-lines i:nth-child(3){width:60%}
.am-lines i:nth-child(4){width:34%;height:30px;background:#d4d5d0;margin-top:.9rem}
.am-box{background:var(--sheet);border:1.5px solid var(--ink);border-radius:10px;padding:1.4rem 1.2rem 1.3rem;margin:0 0 1.6rem}
.am-box h2{font-size:1.4rem;margin:0 0 .6rem}
.am-cta{margin:1.1rem 0 1.2rem}
.am-cta .ken-cta:focus-visible{outline:2px solid var(--ink);outline-offset:3px}
.am-sign{font-size:.95rem;margin:0!important}
.am-sign span{display:block;color:var(--mute)}
.am-foot{font-size:.8rem;color:var(--mute);padding:0 0 2.2rem;margin:0!important}
@media (min-width:520px){
.am-bars i:last-child{display:block}
}
@media (min-width:900px){
body{font-size:17px}
.am-wrap{padding:0 2.5rem}
.am-intro{padding:3.2rem 0 1.8rem}
.am h1{font-size:3.4rem}
.am-mock{padding:1.6rem 2rem 2rem}
.am-box{padding:2rem 2.2rem 1.8rem}
}
</style>
</head>
<body>
<main class="am">
<div class="am-wrap">
<header class="am-top">
{%- if brand.logo_url %}<img class="am-logo" src="{{ brand.logo_url | escape }}" alt="{{ brand.name | default: 'Logo' | escape }}">{% elsif brand.name %}<p class="am-brand">{{ brand.name | escape }}</p>{% else %}<span></span>{% endif -%}
<p class="am-for">A sketch for <b>{{ account.name | escape }}</b></p>
</header>
<section data-section="intro" class="am-intro">
<h1>Your new homepage, sketched</h1>
<p class="am-lead">{% if person.first_name %}{{ person.first_name | escape }}, I{% else %}I{% endif %} am sketching the top of {{ account.domain | escape }} again, using only the words and facts already on it: the hero and one section below, next to what is there today.</p>
<p>The sketch is not on this page yet. This link stays the same, so check back later today.</p>
</section>
<div class="am-frame" aria-hidden="true">
<div class="am-chrome"><i></i><i></i><i></i><span>{{ account.domain | escape }}</span></div>
<div class="am-mock">
<div class="am-nav"><b>{{ account.name | escape }}</b><span class="am-bars"><i></i><i></i><i></i></span><span class="am-navbtn"></span></div>
<div class="am-lines"><i></i><i></i><i></i><i></i></div>
</div>
</div>
<section data-section="next" class="am-box">
<h2>Rather see it on a call?</h2>
<p>Thirty minutes is enough to walk through the sketch on a screen and decide whether a full homepage is worth doing.</p>
<div class="am-cta">{% render 'ken/cta', label: 'Book 30 minutes', kind: 'booking', color: accent %}</div>
<p class="am-sign">{{ sender.name | default: 'Our team' | escape }}{% if sender.title %}<span>{{ sender.title | escape }}{% if brand.name %}, {{ brand.name | escape }}{% endif %}</span>{% elsif brand.name %}<span>{{ brand.name | escape }}</span>{% endif %}</p>
</section>
<p class="am-foot">Sketched for {{ account.name | escape }} by {{ sender.name | default: 'our team' | escape }}{% if brand.name %} at {{ brand.name | escape }}{% endif %}. This is a private link.</p>
</div>
</main>
</body>
</html>
