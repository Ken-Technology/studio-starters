{%- assign accent = brand.colors.primary | default: '#c8372d' -%}
{%- assign accent2 = brand.colors.secondary | default: '#22303c' -%}
{%- assign font_head = brand.fonts.heading | default: 'Schibsted Grotesk' -%}
{%- assign font_body = brand.fonts.body | default: 'Schibsted Grotesk' -%}
{%- assign head_q = font_head | replace: ' ', '+' -%}
{%- assign body_q = font_body | replace: ' ', '+' -%}
{%- assign hero_keys = 'headline,sub,cta,proof,image' | split: ',' -%}
{%- assign hero_notes = 0 -%}
{%- assign section_notes = 0 -%}
{%- for n in data.notes -%}
{%- if hero_keys contains n.on -%}{%- assign hero_notes = hero_notes | plus: 1 -%}{%- else -%}{%- assign section_notes = section_notes | plus: 1 -%}{%- endif -%}
{%- endfor -%}
{%- assign has_today_section = false -%}
{%- if data.today.section_heading and data.today.section_heading != '' -%}{%- assign has_today_section = true -%}{%- endif -%}
{%- if data.today.section_body and data.today.section_body != '' -%}{%- assign has_today_section = true -%}{%- endif -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex">
<title>Your new homepage, sketched: {{ account.name | escape }}</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ head_q }}:wght@400;500;700{% if font_body != font_head %}&family={{ body_q }}:wght@400;500;600{% endif %}&display=swap">
<style>
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:#f3f3f0;color:#15171a;font-family:'{{ font_body }}',ui-sans-serif,system-ui,sans-serif;font-size:16px;line-height:1.55;-webkit-font-smoothing:antialiased}
.am{--a:{{ accent }};--a2:{{ accent2 }};--ink:#15171a;--mute:#646871;--line:#d9dad5;--sheet:#fff;--clip:#e8e8e3}
.am h1,.am h2,.am h3{font-family:'{{ font_head }}',ui-sans-serif,system-ui,sans-serif;font-weight:700;line-height:1.1;letter-spacing:-.018em;margin:0;text-wrap:balance}
.am p{margin:0 0 .9rem}
.am-wrap{max-width:72rem;margin:0 auto;padding:0 1.25rem}
.am-top{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:1rem 0;border-bottom:1px solid var(--line)}
.am-logo{height:24px;width:auto;display:block}
.am-brand{font-weight:700;font-size:.95rem;margin:0!important}
.am-for{font-size:.85rem;color:var(--mute);margin:0!important;text-align:right}
.am-for b{color:var(--ink);font-weight:600}
.am-intro{padding:2.2rem 0 2rem}
.am h1{font-size:2.3rem;margin:0 0 1rem}
.am-lead{font-size:1.1rem;line-height:1.5;max-width:34rem}
.am-summary{font-size:1.05rem;line-height:1.5;max-width:34rem;color:#2d3035}
.am-meta{margin:1.6rem 0 0;padding:0;border-top:2px solid var(--ink)}
.am-meta div{display:grid;grid-template-columns:6.5rem 1fr;gap:.6rem;padding:.6rem 0;border-bottom:1px solid var(--line)}
.am-meta dt{font-size:.82rem;color:var(--mute);padding-top:.15rem}
.am-meta dd{margin:0;font-weight:500}
.am-meta small{display:block;font-weight:400;color:var(--mute);font-size:.86rem}
.am-key{font-size:.9rem;color:var(--mute);margin:1.2rem 0 0!important}
.am-k{display:inline-flex;align-items:center;justify-content:center;flex:none;width:20px;height:20px;border-radius:50%;background:var(--a);color:#fff;font-family:'{{ font_body }}',ui-sans-serif,system-ui,sans-serif;font-size:.72rem;font-weight:700;letter-spacing:0;line-height:1;vertical-align:top;margin-left:.35rem;position:relative;top:.05em}
.am-part{padding:1.8rem 0 0}
.am-part h2{font-size:1.45rem;margin:0 0 .9rem}
.am-clip{background:var(--clip);border-radius:6px;padding:.9rem 1rem 1rem;margin:0 0 1rem}
.am-clip .am-src{font-size:.78rem;color:var(--mute);margin:0 0 .55rem!important;padding-bottom:.45rem;border-bottom:1px solid #d6d6d0}
.am-clip .am-src b{color:var(--a2);font-weight:600}
.am-clip h3{font-family:inherit;font-weight:600;font-size:1.05rem;line-height:1.3;letter-spacing:0;margin:0 0 .4rem;text-wrap:pretty}
.am-clip p{font-size:.95rem;color:#3a3d42;margin:0 0 .6rem}
.am-clip .am-btn-today{display:inline-block;border:1px solid #9b9d99;border-radius:999px;padding:.2rem .7rem;font-size:.85rem;color:#3a3d42;background:#f6f6f3}
.am-clip .am-btn-lbl{font-size:.8rem;color:var(--mute);margin-right:.4rem}
.am-clip .am-none{font-size:.92rem;color:var(--mute);margin:0}
.am-notes{list-style:none;margin:0 0 1.4rem;padding:0;border-top:1px solid var(--line)}
.am-notes li{display:grid;grid-template-columns:20px 1fr;gap:.6rem;padding:.65rem 0;border-bottom:1px solid var(--line);font-size:.95rem;line-height:1.5}
.am-notes li .am-k{margin:.15rem 0 0}
.am-notes b{font-weight:600}
.am-frame{background:var(--sheet);border:1.5px solid var(--ink);border-radius:10px;margin:0 0 1.2rem;overflow:hidden}
.am-chrome{display:flex;align-items:center;gap:.5rem;padding:.55rem .8rem;background:#f3f3f0;border-bottom:1px solid var(--line)}
.am-chrome i{width:9px;height:9px;border-radius:50%;background:#c9cac5;display:block}
.am-chrome span{flex:1;margin-left:.3rem;background:#fff;border:1px solid var(--line);border-radius:999px;padding:.15rem .7rem;font-size:.78rem;color:var(--mute);text-align:center;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
.am-mock{padding:1rem 1.1rem 1.3rem}
.am-nav{display:flex;align-items:center;justify-content:space-between;gap:.8rem;padding:0 0 .9rem;border-bottom:1px solid var(--line);margin:0 0 1.4rem}
.am-nav b{font-size:.95rem;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;min-width:0}
.am-bars{display:flex;gap:.55rem;flex:none}
.am-bars i{display:block;width:30px;height:7px;border-radius:4px;background:#d4d5d0}
.am-bars i:last-child{display:none}
.am-navbtn{display:block;flex:none;width:52px;height:22px;border:1.5px solid var(--ink);border-radius:5px}
.am-hero h3{font-size:1.55rem;line-height:1.12;margin:0 0 .7rem;max-width:22ch}
.am-hero .am-sub{font-size:1rem;line-height:1.5;color:#3a3d42;max-width:40ch;margin:0 0 1rem}
.am-btn{display:inline-block;background:var(--ink);color:#fff;border-radius:6px;padding:.6rem 1rem;font-weight:600;font-size:.95rem;line-height:1.3}
.am-cta-row{display:flex;align-items:center;flex-wrap:wrap;gap:.6rem 1rem;margin:0 0 1rem}
.am-proof{font-size:.85rem;color:var(--mute);margin:0 0 1.2rem;display:flex;align-items:flex-start;gap:.5rem}
.am-proof .am-k{margin:.1rem 0 0}
.am-proof::before{content:"";flex:none;width:7px;height:7px;border-radius:50%;background:var(--ink);margin-top:.5em}
.am-img{position:relative;border:1.5px solid var(--ink);border-radius:6px;aspect-ratio:16/8;overflow:hidden;background:#fafaf8}
.am-img>svg{position:absolute;inset:0;width:100%;height:100%}
.am-img>span{position:absolute;left:.6rem;right:.6rem;bottom:.5rem;font-size:.8rem;color:var(--ink);background:#fff;padding:.25rem .5rem;border-radius:4px;display:inline-block;width:fit-content;max-width:calc(100% - 1.2rem)}
.am-sec{padding:1.3rem 0 0}
.am-sec h3{font-size:1.3rem;line-height:1.15;margin:0 0 .5rem;max-width:26ch}
.am-sec .am-sub{font-size:.95rem;line-height:1.5;color:#3a3d42;max-width:48ch;margin:0 0 1rem}
.am-points{display:grid;gap:.9rem;margin:0;padding:0;list-style:none}
.am-points li{border-top:2px solid var(--ink);padding:.6rem 0 0}
.am-points b{display:block;font-size:.95rem;font-weight:700;margin:0 0 .25rem}
.am-points p{font-size:.88rem;line-height:1.45;color:#3a3d42;margin:0}
.am-cap{font-size:.82rem;color:var(--mute);margin:0 0 1.5rem}
.am-next{padding:1.2rem 0 1.5rem;border-top:1px solid var(--line);margin-top:.6rem}
.am-box{background:var(--sheet);border:1.5px solid var(--ink);border-radius:10px;padding:1.4rem 1.2rem 1.3rem}
.am-box h2{font-size:1.4rem;margin:0 0 .6rem}
.am-box p{max-width:36rem}
.am-cta{margin:1.1rem 0 1.2rem}
.am-cta .ken-cta:focus-visible{outline:2px solid var(--ink);outline-offset:3px}
.am-sign{font-size:.95rem;margin:0!important}
.am-sign span{display:block;color:var(--mute)}
.am-how{margin:1.4rem 0 0;padding:1rem 0 0;border-top:1px solid var(--line)}
.am-how h3{font-family:inherit;font-size:.95rem;font-weight:600;letter-spacing:0;margin:0 0 .4rem}
.am-how p{font-size:.9rem;color:var(--mute);margin:0 0 .5rem}
.am-foot{font-size:.8rem;color:var(--mute);padding:0 0 2.2rem;margin:0!important}
@media (min-width:520px){
.am-bars i:last-child{display:block}
.am-points{grid-template-columns:repeat(3,1fr);gap:1.2rem}
}
@media (min-width:900px){
body{font-size:17px}
.am-wrap{padding:0 2.5rem}
.am-top{padding:1.2rem 0}
.am-intro{display:grid;grid-template-columns:minmax(0,7fr) minmax(0,5fr);gap:3rem;padding:2.8rem 0 2.4rem;align-items:start}
.am h1{font-size:3.2rem}
.am-lead{font-size:1.2rem}
.am-summary{font-size:1.1rem}
.am-meta{margin:0}
.am-part{display:grid;grid-template-columns:minmax(0,4.5fr) minmax(0,7.5fr);grid-template-areas:"head sketch" "clip sketch" "notes sketch" ". cap";grid-template-rows:auto auto 1fr auto;column-gap:3rem;padding:0}
.am-part h2{grid-area:head;font-size:1.6rem;margin:2.2rem 0 1rem}
.am-part-first h2{margin-top:0}
.am-clip{grid-area:clip;padding:1.1rem 1.2rem 1.2rem}
.am-notes{grid-area:notes;align-self:start}
.am-frame{grid-area:sketch;margin:0;height:100%}
.am-frame-top{border-bottom:0;border-radius:10px 10px 0 0}
.am-frame-bottom{border-top:0;border-radius:0 0 10px 10px}
.am-cap{grid-area:cap;margin:.9rem 0 0}
.am-mock{padding:1.6rem 2rem 2rem}
.am-hero{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(0,1fr);gap:1.6rem;align-items:center}
.am-hero h3{font-size:2rem}
.am-hero .am-sub{font-size:1.05rem}
.am-proof{margin:0}
.am-img{aspect-ratio:4/3}
.am-sec{padding:2.4rem 0 .4rem}
.am-sec h3{font-size:1.6rem}
.am-sec .am-sub{font-size:1rem}
.am-points p{font-size:.9rem}
.am-next{display:grid;grid-template-columns:minmax(0,7fr) minmax(0,5fr);gap:3rem;padding:2.4rem 0 2.2rem;margin-top:1.2rem}
.am-box{padding:2rem 2.2rem 1.8rem}
.am-box h2{font-size:1.7rem}
.am-how{margin:0;padding:.4rem 0 0;border-top:0}
}
</style>
</head>
<body>
<main class="am">
<div class="am-wrap">
<header class="am-top">
{%- if brand.logo_url %}<img class="am-logo" src="{{ brand.logo_url | escape }}" alt="{{ brand.name | default: 'Logo' | escape }}">{% elsif brand.name %}<p class="am-brand">{{ brand.name | escape }}</p>{% else %}<span></span>{% endif -%}
<p class="am-for">A sketch for <b>{{ account.name | escape }}</b></p>
</header>

<section data-section="intro" class="am-intro">
<div>
<h1>Your new homepage, sketched</h1>
<p class="am-lead">{% if person.first_name %}{{ person.first_name | escape }}, this{% else %}This{% endif %} is the top of {{ account.domain | escape }} as it reads today, next to the same two parts sketched again from the words and facts already on it. Nothing here is final, and every line can change.</p>
<p class="am-summary">{{ data.summary | escape }}</p>
<p class="am-key">Numbered marks on the sketch show what changed. The notes beside each part say why.</p>
</div>
<dl class="am-meta">
<div><dt>Sketched for</dt><dd>{% if person.first_name %}{{ person.first_name | escape }} {{ person.last_name | escape }}<small>{% if person.title %}{{ person.title | escape }}, {% endif %}{{ account.name | escape }}</small>{% else %}{{ account.name | escape }}<small>Shared with the team</small>{% endif %}</dd></div>
<div><dt>By</dt><dd>{{ sender.name | default: 'Our team' | escape }}<small>{% if sender.title %}{{ sender.title | escape }}{% if brand.name %}, {% endif %}{% endif %}{% if brand.name %}{{ brand.name | escape }}{% endif %}</small></dd></div>
<div><dt>Built from</dt><dd>{{ account.domain | escape }}<small>The hero and the {{ data.today.section_name | default: 'first' | escape }} section, copy only</small></dd></div>
</dl>
</section>

<section data-section="hero" class="am-part am-part-first">
<h2>The hero</h2>
<div class="am-clip">
<p class="am-src">On <b>{{ account.domain | escape }}</b> today</p>
<h3>{{ data.today.headline | escape }}</h3>
{%- if data.today.sub and data.today.sub != '' %}
<p>{{ data.today.sub | escape | newline_to_br | strip_newlines | raw }}</p>
{%- endif %}
{%- if data.today.cta and data.today.cta != '' %}
<p style="margin:0"><span class="am-btn-lbl">Button</span><span class="am-btn-today">{{ data.today.cta | escape }}</span></p>
{%- endif %}
</div>
<div class="am-frame am-frame-top">
<div class="am-chrome" aria-hidden="true"><i></i><i></i><i></i><span>{{ account.domain | escape }}</span></div>
<div class="am-mock">
<div class="am-nav" aria-hidden="true"><b>{{ account.name | escape }}</b><span class="am-bars"><i></i><i></i><i></i></span><span class="am-navbtn"></span></div>
<div class="am-hero">
<div>
<h3>{{ data.sketch.headline | escape }}{% for n in data.notes %}{% if n.on == 'headline' %}<span class="am-k">{{ forloop.index }}</span>{% endif %}{% endfor %}</h3>
<p class="am-sub">{{ data.sketch.sub | escape }}{% for n in data.notes %}{% if n.on == 'sub' %}<span class="am-k">{{ forloop.index }}</span>{% endif %}{% endfor %}</p>
<div class="am-cta-row"><span class="am-btn">{{ data.sketch.cta | escape }}</span>{% for n in data.notes %}{% if n.on == 'cta' %}<span class="am-k" style="margin:0">{{ forloop.index }}</span>{% endif %}{% endfor %}</div>
{%- if data.sketch.proof and data.sketch.proof != '' %}
<p class="am-proof"><span>{{ data.sketch.proof | escape }}</span>{% for n in data.notes %}{% if n.on == 'proof' %}<span class="am-k">{{ forloop.index }}</span>{% endif %}{% endfor %}</p>
{%- endif %}
</div>
<div class="am-img" role="img" aria-label="Picture placeholder{% if data.sketch.image and data.sketch.image != '' %}: {{ data.sketch.image | escape }}{% endif %}">
<svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true"><path d="M0 0L100 100M100 0L0 100" stroke="#c9cac5" stroke-width="1" vector-effect="non-scaling-stroke"/></svg>
<span>{% if data.sketch.image and data.sketch.image != '' %}Picture: {{ data.sketch.image | escape }}{% else %}Picture: your own, not stock{% endif %}{% for n in data.notes %}{% if n.on == 'image' %}<span class="am-k">{{ forloop.index }}</span>{% endif %}{% endfor %}</span>
</div>
</div>
</div>
</div>
{%- if hero_notes > 0 %}
<ol class="am-notes">
{%- for n in data.notes %}
{%- if hero_keys contains n.on %}
<li><span class="am-k">{{ forloop.index }}</span><span><b>{% case n.on %}{% when 'headline' %}Headline.{% when 'sub' %}Line under it.{% when 'cta' %}Button.{% when 'proof' %}Proof line.{% else %}Picture.{% endcase %}</b> {{ n.note | escape }}</span></li>
{%- endif %}
{%- endfor %}
</ol>
{%- endif %}
</section>

<section data-section="section" class="am-part">
<h2>Below it: {{ data.today.section_name | escape }}</h2>
<div class="am-clip">
<p class="am-src">On <b>{{ account.domain | escape }}</b> today</p>
{%- if has_today_section %}
{%- if data.today.section_heading and data.today.section_heading != '' %}
<h3>{{ data.today.section_heading | escape }}</h3>
{%- endif %}
{%- if data.today.section_body and data.today.section_body != '' %}
<p style="margin:0">{{ data.today.section_body | escape | newline_to_br | strip_newlines | raw }}</p>
{%- endif %}
{%- else %}
<p class="am-none">No section like this on the page yet, so the sketch adds one.</p>
{%- endif %}
</div>
<div class="am-frame am-frame-bottom">
<div class="am-mock">
<div class="am-sec">
<h3>{{ data.sketch.section_heading | escape }}{% for n in data.notes %}{% if n.on == 'section_heading' %}<span class="am-k">{{ forloop.index }}</span>{% endif %}{% endfor %}</h3>
<p class="am-sub">{{ data.sketch.section_intro | escape }}{% for n in data.notes %}{% if n.on == 'section_intro' %}<span class="am-k">{{ forloop.index }}</span>{% endif %}{% endfor %}</p>
<ul class="am-points">
{%- for pt in data.sketch.points %}
<li><b>{{ pt.title | escape }}{% if forloop.first %}{% for n in data.notes %}{% if n.on == 'points' %}<span class="am-k">{{ forloop.index }}</span>{% endif %}{% endfor %}{% endif %}</b><p>{{ pt.text | escape }}</p></li>
{%- endfor %}
</ul>
</div>
</div>
</div>
{%- if section_notes > 0 %}
<ol class="am-notes">
{%- for n in data.notes %}
{%- unless hero_keys contains n.on %}
<li><span class="am-k">{{ forloop.index }}</span><span><b>{% case n.on %}{% when 'section_heading' %}Section heading.{% when 'section_intro' %}Section intro.{% else %}The three points.{% endcase %}</b> {{ n.note | escape }}</span></li>
{%- endunless %}
{%- endfor %}
</ol>
{%- endif %}
<p class="am-cap">Sketched from the copy on {{ account.domain | escape }} and nothing else. Layout and type are a starting point, the picture is a placeholder, and the menu stays as it is.</p>
</section>

<section data-section="next" class="am-next">
<div class="am-box">
<h2>Want the rest of the page?</h2>
<p>Thirty minutes is enough to walk through the sketch on a screen, hear what is off, and decide whether a full homepage is worth doing. If you would rather, reply with notes and I will revise this page.</p>
<div class="am-cta">{% render 'ken/cta', label: 'Book 30 minutes', kind: 'booking', color: accent %}</div>
<p class="am-sign">{{ sender.name | default: 'Our team' | escape }}{% if sender.title %}<span>{{ sender.title | escape }}{% if brand.name %}, {{ brand.name | escape }}{% endif %}</span>{% elsif brand.name %}<span>{{ brand.name | escape }}</span>{% endif %}</p>
</div>
<div class="am-how">
<h3>How this was made</h3>
<p>Every line in the sketch comes from the copy on {{ account.domain | escape }}. No customer names, numbers or claims were added.</p>
<p>The layout is the same for every sketch we send: a hero with a headline, a line under it, a button, a proof line and a picture, then one section with three points. The point is the words, not the grid.</p>
<p>The quotes on the left are your page as it reads today, copied word for word.</p>
</div>
</section>
<p class="am-foot">Sketched for {{ account.name | escape }} by {{ sender.name | default: 'our team' | escape }}{% if brand.name %} at {{ brand.name | escape }}{% endif %}. This is a private link.</p>
</div>
</main>
</body>
</html>
