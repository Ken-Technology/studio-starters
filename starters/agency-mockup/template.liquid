{%- assign accent = brand.colors.primary | default: '#6a2624' -%}
{%- assign accent2 = brand.colors.secondary | default: '#4a4a4a' -%}
{%- assign font_head = brand.fonts.heading | default: 'Bricolage Grotesque' -%}
{%- assign font_body = brand.fonts.body | default: 'Bricolage Grotesque' -%}
{%- assign hero_keys = 'headline,sub,cta,proof,image' | split: ',' -%}
{%- assign hero_notes = 0 -%}
{%- assign section_notes = 0 -%}
{%- for n in data.notes -%}
{%- if hero_keys contains n.on -%}{%- assign hero_notes = hero_notes | plus: 1 -%}{%- else -%}{%- assign section_notes = section_notes | plus: 1 -%}{%- endif -%}
{%- endfor -%}
{%- assign has_today_section = false -%}
{%- if data.today.section_heading and data.today.section_heading != '' -%}{%- assign has_today_section = true -%}{%- endif -%}
{%- if data.today.section_body and data.today.section_body != '' -%}{%- assign has_today_section = true -%}{%- endif -%}
{%- assign old_len = data.today.headline | size -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex">
<title>Your new homepage, sketched: {{ account.name | escape }}</title>
{%- if font_head == 'Bricolage Grotesque' %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@400;600;700&display=swap">
{%- else %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_head | url_encode }}&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_head | url_encode }}:wght@600&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_head | url_encode }}:wght@700&display=swap">
{%- endif %}
{%- if font_body != font_head %}
{%- if font_body == 'Bricolage Grotesque' %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@400;600;700&display=swap">
{%- else %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_body | url_encode }}&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_body | url_encode }}:wght@600&display=swap">
{%- endif %}
{%- endif %}
<style>
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:#e2e2e2;color:#6a2624;font-family:'{{ font_body }}',ui-sans-serif,system-ui,sans-serif;font-size:1.125rem;line-height:1.5;-webkit-font-smoothing:antialiased}
.am{--paper:#e2e2e2;--surface:#d6d6d6;--sheet:#f2f2f2;--a:{{ accent }};--a2:{{ accent2 }};--ink:#6a2624;--ink:oklch(from var(--a) min(l,0.36) min(c,0.16) h);--muted:#6e3a3e;--muted:color-mix(in oklch,var(--ink) 88%,var(--paper));--f-ink:#e2e2e2;--f-ink:color(from var(--a) xyz-d65 clamp(0,(.18 - y) * 1000000,.9505) clamp(0,(.18 - y) * 1000000,1) clamp(0,(.18 - y) * 1000000,1.089));--m:clamp(1rem,2.4vw,2rem);--head:'{{ font_head }}',ui-sans-serif,system-ui,sans-serif;color:var(--ink)}
.am h1,.am h2,.am h3{font-family:var(--head);font-weight:700;line-height:1;letter-spacing:-.03em;margin:0;text-wrap:balance}
.am p{margin:0;text-wrap:pretty}
.am ol,.am ul{margin:0;padding:0;list-style:none}
.am ::selection{background:var(--a);color:var(--f-ink)}
.am-wrap{max-width:90rem;margin:0 auto;padding:0 var(--m)}
.am-top{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:1.1rem 0}
.am-logo{height:26px;width:auto;display:block}
.am-brand{font-family:var(--head);font-weight:700;font-size:1.125rem}
.am-for{font-size:.9375rem;text-align:right}
.am-for b{font-weight:600}
.am-board{display:grid;grid-template-columns:minmax(0,1fr);gap:.5rem}
.am-tile{padding:1.25rem 1.25rem 1.5rem;display:flex;flex-direction:column;justify-content:flex-end;gap:.75rem}
.am-tA{background:var(--a);color:var(--f-ink);min-height:18rem}
.am h1{font-size:clamp(2.1rem,.6rem + 4.2vw,5.25rem);line-height:.92;letter-spacing:-.045em}
.am-tB{background:var(--surface)}
.am-tC{background:var(--sheet)}
.am-cap{font-size:.9375rem;color:var(--muted)}
.am-old,.am-new{font-family:var(--head);font-size:clamp(1.5rem,1rem + 1.6vw,2.25rem);line-height:1.1;letter-spacing:-.025em;font-weight:600}
.am-old{color:var(--muted);text-decoration:line-through;text-decoration-thickness:.09em;text-decoration-color:var(--a2)}
.am-old.is-long{font-size:1.5rem}
.am-new{font-weight:700}
.am-stand{display:grid;gap:1.75rem;padding:2.5rem 0 4.5rem}
.am-lead{font-size:clamp(1.25rem,1rem + .8vw,1.5rem);line-height:1.35;max-width:36ch}
.am-stand p+p{margin-top:1rem}
.am-meta{margin:0;display:grid;gap:.9rem;align-content:start}
.am-meta dt{font-size:.9375rem;color:var(--muted)}
.am-meta dd{margin:0;font-weight:600}
.am-meta small{display:block;font-weight:400}
.am-part{display:grid;grid-template-columns:minmax(0,1fr);gap:1.25rem;padding:0 0 4.5rem}
.am-part h2,.am-next h2{font-size:clamp(2rem,1.2rem + 2.8vw,3.75rem);letter-spacing:-.035em}
.am-clip{background:var(--surface);padding:1.25rem 1.25rem 1.5rem;border-left:6px solid var(--a2)}
.am-clip .am-cap{margin:0 0 .75rem}
.am-clip h3{font-family:inherit;font-weight:600;font-size:1.125rem;line-height:1.35;letter-spacing:0;margin:0 0 .5rem;text-wrap:pretty}
.am-clip p{color:var(--muted)}
.am-clip .am-btn-today{display:inline-block;margin:.75rem 0 0;font-weight:600;color:var(--ink)}
.am-k{display:inline-flex;align-items:center;justify-content:center;flex:none;width:1.5rem;height:1.5rem;border-radius:50%;background:var(--a);color:var(--f-ink);font-family:var(--head);font-size:.9375rem;font-weight:700;letter-spacing:0;line-height:1;vertical-align:.35em;margin-left:.4rem}
.am-notes{display:grid;gap:1rem;align-content:start}
.am-notes li{display:grid;grid-template-columns:1.5rem 1fr;gap:.75rem;line-height:1.5}
.am-notes li .am-k{margin:.1rem 0 0;vertical-align:0}
.am-notes b{font-weight:700}
.am-sheet{background:var(--sheet);padding:1.25rem 1.25rem 1.75rem}
.am-nav{display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:.25rem 1rem;margin:0 0 2rem}
.am-nav b{font-family:var(--head);font-size:1.125rem;font-weight:700;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.am-nav span{font-size:.9375rem;color:var(--muted);white-space:nowrap}
.am-hero h3{font-size:clamp(2rem,1.3rem + 2.2vw,3.25rem);line-height:.98;letter-spacing:-.04em;margin:0 0 1rem;max-width:20ch}
.am-hero .am-sub{font-size:1.125rem;max-width:40ch;margin:0 0 1.5rem}
.am-cta-row{display:flex;align-items:center;flex-wrap:wrap;gap:.75rem;margin:0 0 1.25rem}
.am-btn{display:inline-block;background:var(--a);color:var(--f-ink);padding:.7rem 1.2rem;font-family:var(--head);font-weight:700;font-size:1.125rem;line-height:1.3}
.am-proof{font-size:.9375rem;color:var(--muted);margin:0 0 1.5rem;max-width:40ch}
.am-img{background:var(--surface);aspect-ratio:4/3;display:flex;align-items:flex-end;padding:1.1rem;margin:1.5rem 0 0}
.am-img p{font-family:var(--head);font-weight:600;font-size:1.25rem;line-height:1.25;max-width:22ch}
.am-sec h3{font-size:clamp(1.75rem,1.2rem + 1.6vw,2.5rem);line-height:1.02;letter-spacing:-.035em;margin:0 0 .75rem;max-width:20ch}
.am-sec .am-sub{font-size:1.125rem;max-width:48ch;margin:0 0 1.75rem}
.am-points{display:grid;gap:1.5rem}
.am-points li{border-top:4px solid var(--ink);padding:.9rem 0 0}
.am-points b{display:block;font-family:var(--head);font-size:1.25rem;font-weight:700;line-height:1.2;margin:0 0 .4rem}
.am-note-none{color:var(--muted)}
.am-capline{font-size:.9375rem;color:var(--muted);max-width:60ch}
.am-next{background:var(--a);color:var(--f-ink);padding:4.5rem 0 2.5rem}
.am-next-in{display:grid;gap:2.5rem}
.am-next p{max-width:38rem}
.am-next-main p{margin:1.25rem 0 0}
.am-cta{margin:2rem 0 0}
.am .ken-cta{display:inline-flex!important;align-items:center;min-height:52px;padding:.85rem 1.6rem!important;border-radius:0!important;background:var(--f-ink)!important;color:var(--a)!important;font-family:var(--head);font-size:1.125rem;font-weight:700!important;text-decoration:none}
.am .ken-cta:hover{background:var(--sheet)!important}
.am .ken-cta:focus-visible,.am a:focus-visible{outline:3px solid var(--f-ink);outline-offset:4px}
.am-sign{margin:2rem 0 0!important;font-weight:600}
.am-sign span{display:block;font-weight:400}
.am-how h3{font-family:var(--head);font-size:1.5rem;font-weight:700;letter-spacing:-.02em;margin:0 0 .75rem}
.am-how p+p{margin-top:.75rem}
.am-foot{margin:4rem 0 0!important;font-size:.9375rem}
@keyframes am-strike{from{text-decoration-color:transparent}}
@keyframes am-rise{from{opacity:0;transform:translateY(14px)}}
.am-old{animation:am-strike .4s ease-out .3s both}
.am-tC .am-new{animation:am-rise .5s cubic-bezier(.2,.7,.2,1) .6s both}
@media (prefers-reduced-motion:reduce){.am-old,.am-tC .am-new{animation:none}}
@media (min-width:600px){
.am-points{grid-template-columns:repeat(3,minmax(0,1fr))}
}
@media (min-width:900px){
.am-board{grid-template-columns:repeat(12,minmax(0,1fr));grid-template-rows:minmax(17rem,1fr) minmax(17rem,1fr);min-height:min(74vh,44rem)}
.am-tile{padding:1.5rem 1.75rem 1.75rem}
.am-tA{grid-column:1/8;grid-row:1/3}
.am-tB{grid-column:8/13;grid-row:1}
.am-tC{grid-column:8/13;grid-row:2}
.am-stand{grid-template-columns:repeat(12,minmax(0,1fr));column-gap:1.5rem;padding:3.5rem 0 7rem}
.am-meta{grid-column:1/5;grid-row:1}
.am-stand-text{grid-column:6/13;grid-row:1}
.am-part{grid-template-columns:repeat(12,minmax(0,1fr));column-gap:1.5rem;row-gap:1.5rem;padding:0 0 7rem;align-items:start}
.am-part h2{grid-column:6/13}
.am-hero-part .am-clip{grid-column:1/6;grid-row:2}
.am-hero-part .am-sheet{grid-column:6/13;grid-row:2/4}
.am-hero-part .am-notes{grid-column:1/6;grid-row:3}
.am-sec-part .am-sheet{grid-column:1/13}
.am-sec-part .am-clip{grid-column:1/6}
.am-sec-part .am-notes,.am-sec-part .am-capline{grid-column:6/13}
.am-sheet{padding:1.5rem 2rem 2.25rem}
.am-hero{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,1fr);gap:0 1.75rem;align-items:start}
.am-hero h3{grid-column:1/-1;margin-bottom:1.5rem}
.am-img{margin:0}
.am-proof{margin:0}
.am-next{padding:7rem 0 3rem}
.am-next-in{grid-template-columns:repeat(12,minmax(0,1fr));column-gap:1.5rem;align-items:start}
.am-how{grid-column:1/5;padding-top:.75rem}
.am-next-main{grid-column:6/13;grid-row:1}
}
</style>
</head>
<body>
<main class="am">
<div class="am-wrap">
<header class="am-top">
{%- if brand.logo_url %}<img class="am-logo" src="{{ brand.logo_url | escape }}" alt="{{ brand.name | default: 'Logo' | escape }}">{% elsif brand.name %}<p class="am-brand">{{ brand.name | escape }}</p>{% else %}<span></span>{% endif -%}
<p class="am-for">A sketch for <b>{{ account.name | escape }}</b></p>
</header>

<section data-section="intro" class="am-intro">
<div class="am-board">
<div class="am-tile am-tA"><h1>Your new homepage, sketched</h1></div>
<div class="am-tile am-tB"><p class="am-old{% if old_len > 70 %} is-long{% endif %}">{{ data.today.headline | escape }}</p><p class="am-cap">Your headline on {{ account.domain | escape }} today</p></div>
<div class="am-tile am-tC"><p class="am-new">{{ data.sketch.headline | escape }}</p><p class="am-cap">The same line, sketched again</p></div>
</div>
<div class="am-stand">
<dl class="am-meta">
<div><dt>Sketched for</dt><dd>{% if person.first_name %}{{ person.first_name | escape }} {{ person.last_name | escape }}<small>{% if person.title %}{{ person.title | escape }}, {% endif %}{{ account.name | escape }}</small>{% else %}{{ account.name | escape }}<small>Shared with the team</small>{% endif %}</dd></div>
<div><dt>By</dt><dd>{{ sender.name | default: 'Our team' | escape }}<small>{% if sender.title %}{{ sender.title | escape }}{% if brand.name %}, {% endif %}{% endif %}{% if brand.name %}{{ brand.name | escape }}{% endif %}</small></dd></div>
<div><dt>Built from</dt><dd>{{ account.domain | escape }}<small>The hero and the {{ data.today.section_name | default: 'first' | escape }} section, copy only</small></dd></div>
</dl>
<div class="am-stand-text">
<p class="am-lead">{% if person.first_name %}{{ person.first_name | escape }}, this{% else %}This{% endif %} is the top of {{ account.domain | escape }} as it reads today, next to the same two parts sketched again from the words and facts already on it. Nothing here is final, and every line can change.</p>
<p>{{ data.summary | escape }}</p>
<p class="am-cap">Numbered marks on the sketch show what changed. The notes beside each part say why.</p>
</div>
</div>
</section>

<section data-section="hero" class="am-part am-hero-part">
<h2>The hero</h2>
<div class="am-clip">
<p class="am-cap">On {{ account.domain | escape }} today</p>
<h3>{{ data.today.headline | escape }}</h3>
{%- if data.today.sub and data.today.sub != '' %}
<p>{{ data.today.sub | escape | newline_to_br | strip_newlines | raw }}</p>
{%- endif %}
{%- if data.today.cta and data.today.cta != '' %}
<p class="am-btn-today">Button: {{ data.today.cta | escape }}</p>
{%- endif %}
</div>
<div class="am-sheet" data-ui>
<div class="am-nav" aria-hidden="true"><b>{{ account.name | escape }}</b><span>{{ account.domain | escape }}</span></div>
<div class="am-hero">
<h3>{{ data.sketch.headline | escape }}{% for n in data.notes %}{% if n.on == 'headline' %}<span class="am-k">{{ forloop.index }}</span>{% endif %}{% endfor %}</h3>
<div>
<p class="am-sub">{{ data.sketch.sub | escape }}{% for n in data.notes %}{% if n.on == 'sub' %}<span class="am-k">{{ forloop.index }}</span>{% endif %}{% endfor %}</p>
<div class="am-cta-row"><span class="am-btn">{{ data.sketch.cta | escape }}</span>{% for n in data.notes %}{% if n.on == 'cta' %}<span class="am-k">{{ forloop.index }}</span>{% endif %}{% endfor %}</div>
{%- if data.sketch.proof and data.sketch.proof != '' %}
<p class="am-proof">{{ data.sketch.proof | escape }}{% for n in data.notes %}{% if n.on == 'proof' %}<span class="am-k">{{ forloop.index }}</span>{% endif %}{% endfor %}</p>
{%- endif %}
</div>
<div class="am-img" role="img" aria-label="Picture to shoot{% if data.sketch.image and data.sketch.image != '' %}: {{ data.sketch.image | escape }}{% endif %}">
<p>{% if data.sketch.image and data.sketch.image != '' %}Picture to shoot: {{ data.sketch.image | escape }}{% else %}Picture to shoot: your own, not stock{% endif %}{% for n in data.notes %}{% if n.on == 'image' %}<span class="am-k">{{ forloop.index }}</span>{% endif %}{% endfor %}</p>
</div>
</div>
</div>
{%- if hero_notes > 0 %}
<ol class="am-notes">
{%- for n in data.notes %}
{%- if hero_keys contains n.on %}
<li><span class="am-k">{{ forloop.index }}</span><span><b>{% case n.on %}{% when 'headline' %}Headline.{% when 'sub' %}Line under it.{% when 'cta' %}Button.{% when 'proof' %}Proof line.{% else %}Picture.{% endcase %}</b> {{ n.note | escape }}</span></li>
{%- endif %}
{%- endfor %}
</ol>
{%- endif %}
</section>

<section data-section="section" class="am-part am-sec-part">
<h2>Below it: {{ data.today.section_name | escape }}</h2>
<div class="am-sheet" data-ui>
<div class="am-sec">
<h3>{{ data.sketch.section_heading | escape }}{% for n in data.notes %}{% if n.on == 'section_heading' %}<span class="am-k">{{ forloop.index }}</span>{% endif %}{% endfor %}</h3>
<p class="am-sub">{{ data.sketch.section_intro | escape }}{% for n in data.notes %}{% if n.on == 'section_intro' %}<span class="am-k">{{ forloop.index }}</span>{% endif %}{% endfor %}</p>
<ul class="am-points">
{%- for pt in data.sketch.points %}
<li><b>{{ pt.title | escape }}{% if forloop.first %}{% for n in data.notes %}{% if n.on == 'points' %}<span class="am-k">{{ forloop.index }}</span>{% endif %}{% endfor %}{% endif %}</b><p>{{ pt.text | escape }}</p></li>
{%- endfor %}
</ul>
</div>
</div>
<div class="am-clip">
<p class="am-cap">On {{ account.domain | escape }} today</p>
{%- if has_today_section %}
{%- if data.today.section_heading and data.today.section_heading != '' %}
<h3>{{ data.today.section_heading | escape }}</h3>
{%- endif %}
{%- if data.today.section_body and data.today.section_body != '' %}
<p>{{ data.today.section_body | escape | newline_to_br | strip_newlines | raw }}</p>
{%- endif %}
{%- else %}
<p class="am-note-none">No section like this on the page yet, so the sketch adds one.</p>
{%- endif %}
</div>
{%- if section_notes > 0 %}
<ol class="am-notes">
{%- for n in data.notes %}
{%- unless hero_keys contains n.on %}
<li><span class="am-k">{{ forloop.index }}</span><span><b>{% case n.on %}{% when 'section_heading' %}Section heading.{% when 'section_intro' %}Section intro.{% else %}The three points.{% endcase %}</b> {{ n.note | escape }}</span></li>
{%- endunless %}
{%- endfor %}
</ol>
{%- endif %}
<p class="am-capline">Sketched from the copy on {{ account.domain | escape }} and nothing else. Layout and type are a starting point, the picture is a brief for a photo you take, and the menu stays as it is.</p>
</section>
</div>

<section data-section="next" class="am-next">
<div class="am-wrap">
<div class="am-next-in">
<div class="am-next-main">
<h2>Want the rest of the page?</h2>
<p>Thirty minutes is enough to walk through the sketch on a screen, hear what is off, and decide whether a full homepage is worth doing. If you would rather, reply with notes and I will revise this page.</p>
<div class="am-cta">{% render 'ken/cta', label: 'Book 30 minutes', kind: 'booking', color: accent %}</div>
<p class="am-sign">{{ sender.name | default: 'Our team' | escape }}{% if sender.title %}<span>{{ sender.title | escape }}{% if brand.name %}, {{ brand.name | escape }}{% endif %}</span>{% elsif brand.name %}<span>{{ brand.name | escape }}</span>{% endif %}</p>
</div>
<div class="am-how">
<h3>How this was made</h3>
<p>Every line in the sketch comes from the copy on {{ account.domain | escape }}. No customer names, numbers or claims were added.</p>
<p>The layout is the same for every sketch we send: a hero with a headline, a line under it, a button, a proof line and a picture, then one section with three points. The point is the words, not the grid.</p>
<p>The grey panels are your page as it reads today, copied word for word.</p>
</div>
</div>
<p class="am-foot">Sketched for {{ account.name | escape }} by {{ sender.name | default: 'our team' | escape }}{% if brand.name %} at {{ brand.name | escape }}{% endif %}. This is a private link.</p>
</div>
</section>
</main>
</body>
</html>
