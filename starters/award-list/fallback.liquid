{%- assign accent = brand.colors.primary | default: '#e3a300' -%}
{%- assign accent2 = brand.colors.secondary | default: '#16181d' -%}
{%- assign font_head = brand.fonts.heading | default: 'Saira' -%}
{%- assign font_body = brand.fonts.body | default: 'Saira' -%}
{%- assign head_q = font_head | replace: ' ', '+' -%}
{%- assign body_q = font_body | replace: ' ', '+' -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex">
<title>A list of growing companies, with {{ account.name | escape }} on it</title>
{%- if font_head == 'Saira' or font_body == 'Saira' %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Saira:wdth,wght@62.5..100,400..800&display=swap">
{%- endif %}
{%- if font_head != 'Saira' %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ head_q }}:wght@400;700&display=swap">
{%- endif %}
{%- if font_body != 'Saira' and font_body != font_head %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ body_q }}:wght@400;700&display=swap">
{%- endif %}
<style>
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:#efefec;color:#16181d;font-family:'{{ font_body }}',ui-sans-serif,system-ui,sans-serif;font-size:17px;line-height:1.5;-webkit-font-smoothing:antialiased}
.al{--a:{{ accent }};--a2:{{ accent2 }};--wd:{% if font_head == 'Saira' %}75%{% else %}normal{% endif %};--ink:#16181d;--soft:#4a4d55;--paper:#efefec;
--on-a:#16181d;--on-a:oklch(from var(--a) clamp(0.2,(0.6 - l) * 1000,0.985) 0.01 h);
--on-a2:#efefec;--on-a2:oklch(from var(--a2) clamp(0.2,(0.6 - l) * 1000,0.975) 0.01 h);
--m:clamp(1.125rem,3.2vw,2.5rem);overflow-x:clip}
.al h1,.al h2,.al-no{font-family:'{{ font_head }}',ui-sans-serif,system-ui,sans-serif;font-stretch:var(--wd);letter-spacing:-.01em}
.al p{margin:0}
.al .ken-cta:focus-visible{outline:3px solid var(--ink);outline-offset:3px}
.al-wrap{padding:0 var(--m);max-width:90rem;margin:0 auto}
.al-top{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:1.1rem 0}
.al-logo{height:26px;width:auto;display:block}
.al-brand{font-weight:700;font-size:1rem}
.al-type{font-size:.875rem;color:var(--soft);white-space:nowrap}
.al-cover{display:grid;padding:0 0 3rem}
.al-kit{position:relative;order:-1;margin:0 calc(var(--m) * -1) 1.8rem;height:18rem;background:var(--a);overflow:hidden}
.al-sash{position:absolute;left:-20%;top:42%;width:160%;height:5rem;background:var(--a2);transform:rotate(-24deg)}
.al-bib{position:absolute;left:50%;top:52%;width:min(15rem,70%);background:#fff;color:var(--ink);transform:translate(-50%,-50%) rotate(-3deg);text-align:center}
.al-bib-name{background:var(--a2);color:var(--on-a2);font-weight:600;font-size:.875rem;padding:.7rem 1.4rem;overflow-wrap:anywhere}
.al-no{font-weight:800;font-size:8rem;line-height:.82;padding:.9rem 0 .5rem}
.al-bib-of{font-size:.875rem;padding:0 1.2rem 1.2rem}
.al h1{font-size:1.85rem;line-height:1.04;font-weight:700;text-wrap:balance;margin:0 0 1.2rem}
.al-intro{font-size:1.1rem;max-width:36rem;margin:0 0 1rem!important}
.al-cta{background:var(--a);color:var(--on-a);padding:3rem 0}
.al-cta h2{font-size:1.85rem;line-height:1.04;font-weight:700;margin:0 0 .8rem}
.al-cta p{max-width:34rem}
.al-btn{margin:1.4rem 0 1.2rem}
.al-btn .ken-cta{display:inline-flex!important;align-items:center;min-height:52px;padding:.85rem 1.6rem!important;border-radius:0!important;background:var(--a2)!important;color:var(--on-a2)!important;font-family:inherit;font-weight:600!important;text-decoration:none}
.al-sign{font-weight:600}
.al-sign span{display:block;font-weight:400}
@media (min-width:860px){
body{font-size:18px}
.al-cover{grid-template-columns:minmax(0,7fr) minmax(0,5fr);column-gap:3.5rem;padding:0;min-height:34rem}
.al-cover-text{align-self:center;padding:3rem 0}
.al-kit{order:0;height:auto;margin:0 calc(var(--m) * -1) 0 0}
.al-sash{height:7rem}
.al-bib{width:min(19rem,76%)}
.al-no{font-size:12rem}
.al h1{font-size:clamp(2.6rem,.9rem + 3.2vw,4rem)}
.al-cta{padding:4.5rem 0}
.al-cta h2{font-size:clamp(2.4rem,1.3rem + 2vw,3.4rem)}
}
</style>
</head>
<body>
<main class="al">
<div class="al-wrap">
<header class="al-top">
{%- if brand.logo_url %}<img class="al-logo" src="{{ brand.logo_url | escape }}" alt="{{ brand.name | default: 'Logo' | escape }}">{% elsif brand.name %}<p class="al-brand">{{ brand.name | escape }}</p>{% else %}<span></span>{% endif -%}
<p class="al-type">Top 25 list</p>
</header>
<section data-section="cover" class="al-cover">
<div class="al-cover-text">
<h1>A list of growing companies, with {{ account.name | escape }} on it</h1>
<p class="al-intro">Hi {{ person.first_name | default: 'there' | escape }}, I am putting together a list of companies in the same market as {{ account.name | escape }} that are adding people right now, with {{ account.name | escape }} placed on it and a note on how the list was made.</p>
<p class="al-intro">The list is not on this page yet. The link stays the same, so check back later today.</p>
</div>
<div class="al-kit">
<span class="al-sash" aria-hidden="true"></span>
<div class="al-bib">
<p class="al-bib-name">{{ account.name | escape }}</p>
<p class="al-no" aria-label="Place not set yet">?</p>
<p class="al-bib-of">place still being worked out</p>
</div>
</div>
</section>
</div>
<section data-section="cta" class="al-cta">
<div class="al-wrap">
<h2>Rather see it now?</h2>
<p>Grab 20 minutes and I will walk you through the list and where {{ account.name | escape }} sits on it.</p>
<div class="al-btn">{% render 'ken/cta', label: 'Book 20 minutes', kind: 'booking', color: accent2 %}</div>
<p class="al-sign">{{ sender.name | default: 'Our team' | escape }}{% if sender.title %}<span>{{ sender.title | escape }}{% if brand.name %}, {{ brand.name | escape }}{% endif %}</span>{% elsif brand.name %}<span>{{ brand.name | escape }}</span>{% endif %}</p>
</div>
</section>
</main>
</body>
</html>
