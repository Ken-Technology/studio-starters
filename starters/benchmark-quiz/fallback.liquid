{%- assign accent = brand.colors.primary | default: '#ed4b44' -%}
{%- assign font_head = brand.fonts.heading | default: 'Epilogue' -%}
{%- assign font_body = brand.fonts.body | default: 'Epilogue' -%}
{%- assign brand_name = brand.name | default: 'our team' -%}
{%- assign sender_name = sender.name | default: 'our team' -%}
{%- assign sender_first = sender_name | split: ' ' | first -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex">
<title>How does {{ account.name | escape }} compare?</title>
{%- if font_head == 'Epilogue' %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Epilogue:wght@400;500;900&display=swap">
{%- else %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_head | url_encode }}&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_head | url_encode }}:wght@700&display=swap">
{%- endif %}
{%- if font_body != font_head %}
{%- if font_body == 'Epilogue' %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Epilogue:wght@400;500;900&display=swap">
{%- else %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_body | url_encode }}&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_body | url_encode }}:wght@700&display=swap">
{%- endif %}
{%- endif %}
<style>
:root{--p:{{ accent | escape }};--on-p:#0f0f0f;--on-p:color(from var(--p) xyz-d65 clamp(0,(.18 - y) * 1000000,.9505) clamp(0,(.18 - y) * 1000000,1) clamp(0,(.18 - y) * 1000000,1.089));--fh:'{{ font_head | escape }}','Helvetica Neue',Arial,sans-serif;--fb:'{{ font_body | escape }}','Helvetica Neue',Arial,sans-serif;--bg:#e4e2dc;--ink:#1a1a1a;--muted:#4a4740;--m:clamp(1.125rem,3vw,2.75rem)}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:var(--bg);color:var(--ink);font:400 1.125rem/1.5 var(--fb);-webkit-font-smoothing:antialiased}
h1,h2{font-family:var(--fh);font-weight:900;line-height:.9;letter-spacing:-.04em;margin:0;text-wrap:balance}
p{margin:0}
:focus-visible{outline:3px solid currentColor;outline-offset:3px}
.intro{background:var(--p);color:var(--on-p);padding:1.25rem var(--m) clamp(2rem,5vw,3.5rem);display:grid;gap:1.25rem}
.top{display:flex;align-items:baseline;justify-content:space-between;gap:1rem;font-size:.9375rem;margin-bottom:clamp(2rem,8vw,6rem)}
.brand{font-family:var(--fh);font-weight:900;font-size:1.125rem;letter-spacing:-.03em}
.logo{height:28px;width:auto;max-width:9rem;display:block}
.top p{text-align:right}
.intro h1{font-size:clamp(2.25rem,1.2rem + 5vw,7rem);max-width:14ch;margin-bottom:1rem}
.lede{font-size:clamp(1.25rem,1.1rem + .5vw,1.5rem);line-height:1.35;max-width:40ch}
.cta{padding:clamp(2.5rem,6vw,4.5rem) var(--m);display:grid;gap:1.25rem;justify-items:start}
.cta h2{font-size:clamp(2rem,1.3rem + 3vw,4rem);max-width:14ch}
.cta p{max-width:44ch}
.cta .ken-cta{display:inline-flex!important;align-items:center;min-height:56px;padding:1rem 1.6rem!important;border-radius:0!important;background:var(--ink)!important;color:var(--bg)!important;font-family:var(--fh);font-weight:500!important;text-decoration:none}
.sign{font-weight:500}
.sign span{display:block;font-weight:400;color:var(--muted)}
.foot{padding:1.5rem var(--m) 3rem;font-size:.9375rem;color:var(--muted)}
</style>
</head>
<body>
<main>
<section data-section="intro" class="intro">
<header class="top">
{%- if brand.logo_url %}<img class="logo" src="{{ brand.logo_url | escape }}" alt="{{ brand_name | escape }}">{% elsif brand.name %}<span class="brand">{{ brand.name | escape }}</span>{% else %}<span></span>{% endif -%}
<p>{% if person.first_name %}For {{ person.first_name | escape }} {{ person.last_name | escape }}, {{ account.name | escape }}{% else %}For {{ account.name | escape }}{% endif %}</p>
</header>
<h1>How does {{ account.name | escape }} compare?</h1>
<p class="lede">Hi {{ person.first_name | default: 'there' | escape }}, this page will ask {{ account.name | escape }} five quick questions and show where it stands next to companies like it.</p>
<p class="lede">The questions are not on this page yet. The link stays the same, so check back later today.</p>
</section>
<section data-section="cta" class="cta">
<h2>Rather go through them now?</h2>
<p>Twenty minutes with {{ sender_first | escape }}: the five questions, how companies like {{ account.name | escape }} answered them, and what tends to sit behind the gaps.</p>
{% render 'ken/cta', label: 'Book 20 minutes', kind: 'booking' %}
<p class="sign">{{ sender_name | escape }}<span>{% if sender.title %}{{ sender.title | escape }}, {% endif %}{{ brand_name | escape }}</span></p>
</section>
<footer class="foot">Made for {% if person.first_name %}{{ person.first_name | escape }} {{ person.last_name | escape }} at {% endif %}{{ account.name | escape }} by {{ sender_name | escape }} at {{ brand_name | escape }}.</footer>
</main>
</body>
</html>
