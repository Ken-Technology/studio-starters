{%- comment -%}
Brand: brand.colors.primary is the poster (the opening field, the picked answers, the account's dot, the closing field),
brand.colors.secondary the result chapter where the peers stand as a crowd. Text on either takes a light or dark ink from
the colour itself (CSS relative colour). brand.fonts.heading and .body replace Epilogue.
{%- endcomment -%}
{%- assign accent = brand.colors.primary | default: '#ed4b44' -%}
{%- assign accent2 = brand.colors.secondary | default: '#1a1a1a' -%}
{%- assign font_head = brand.fonts.heading | default: 'Epilogue' -%}
{%- assign font_body = brand.fonts.body | default: 'Epilogue' -%}
{%- assign head_q = font_head | replace: ' ', '+' -%}
{%- assign body_q = font_body | replace: ' ', '+' -%}
{%- if font_head == 'Epilogue' -%}{%- assign head_w = '400;500;900' -%}{%- else -%}{%- assign head_w = '400;700' -%}{%- endif -%}
{%- if font_body == 'Epilogue' -%}{%- assign body_w = '400;500;900' -%}{%- else -%}{%- assign body_w = '400;700' -%}{%- endif -%}
{%- assign brand_name = brand.name | default: 'our team' -%}
{%- assign sender_name = sender.name | default: 'our team' -%}
{%- assign sender_first = sender_name | split: ' ' | first -%}
{%- assign industry = account.industry | default: 'your industry' -%}
{%- assign topic = data.topic | default: 'work' -%}
{%- assign h1_len = account.name | size | plus: 19 -%}
{%- assign h1_v = 300.0 | divided_by: h1_len | at_most: 13 | round: 2 -%}
{%- comment -%} Peer rows: every question needs one row with at least one answer, or the comparison hides. {%- endcomment -%}
{%- assign matched = 0 -%}
{%- assign peer_total = 0 -%}
{%- assign peer_source = '' -%}
{%- for q in data.questions -%}
{%- assign row = false -%}
{%- for r in data.peers -%}{%- if r.question == q.key -%}{%- assign row = r -%}{%- endif -%}{%- endfor -%}
{%- if row -%}
{%- assign total = row.n_1 | plus: row.n_2 | plus: row.n_3 | plus: row.n_4 -%}
{%- if total > 0 -%}
{%- assign matched = matched | plus: 1 -%}
{%- if peer_total == 0 -%}{%- assign peer_total = total -%}{%- assign peer_source = row.source | default: '' -%}{%- endif -%}
{%- endif -%}
{%- endif -%}
{%- endfor -%}
{%- assign has_peers = false -%}
{%- if matched == data.questions.size and matched > 0 -%}{%- assign has_peers = true -%}{%- endif -%}
{%- assign dots = peer_total | at_most: 200 -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex">
<title>How does {{ account.name | escape }} compare?</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ head_q | escape }}:wght@{{ head_w }}&display=swap">
{%- if body_q != head_q %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ body_q | escape }}:wght@{{ body_w }}&display=swap">
{%- endif %}
<script defer src="https://cdn.jsdelivr.net/npm/@alpinejs/csp@3/dist/cdn.min.js"></script>
<style>
:root{
  --p:{{ accent | escape }};
  --s:{{ accent2 | escape }};
  --on-p:#0f0f0f;
  --on-p:oklch(from var(--p) clamp(0.16,(0.6 - l) * 1000,0.99) 0 0);
  --on-s:#e4e2dc;
  --on-s:oklch(from var(--s) clamp(0.16,(0.6 - l) * 1000,0.99) 0 0);
  --fh:'{{ font_head | escape }}','Helvetica Neue',Arial,sans-serif;
  --fb:'{{ font_body | escape }}','Helvetica Neue',Arial,sans-serif;
  --bg:#e4e2dc;
  --surface:#d6d3cb;
  --ink:#1a1a1a;
  --muted:#4a4740;
  --m:clamp(1.125rem,3vw,2.75rem);
  --small:.9375rem;
  --body:1.125rem;
  --lead:clamp(1.25rem,1.1rem + .5vw,1.5rem);
  --head:clamp(1.25rem,.8rem + 2vw,2.25rem);
  --big:clamp(2.5rem,1.4rem + 4.6vw,5.5rem);
}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%;scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--ink);font:400 var(--body)/1.5 var(--fb);-webkit-font-smoothing:antialiased;font-variant-numeric:tabular-nums}
h1,h2,h3{font-family:var(--fh);margin:0;text-wrap:balance}
h1,h2{font-weight:900;line-height:.9;letter-spacing:-.04em}
h3{font-weight:500;font-size:var(--head);line-height:1.1;letter-spacing:-.025em}
p{margin:0}
a{color:inherit}
[hidden]{display:none!important}
:focus-visible{outline:3px solid currentColor;outline-offset:3px}

.poster{background:var(--p);color:var(--on-p);padding:1.25rem var(--m) clamp(1.75rem,4vw,2.75rem);display:grid;grid-template-rows:auto 1fr auto;gap:clamp(2rem,6vw,4rem)}
.top{display:flex;align-items:baseline;justify-content:space-between;gap:1rem;font-size:var(--small)}
.brand{font-family:var(--fh);font-weight:900;font-size:1.125rem;letter-spacing:-.03em}
.logo{height:28px;width:auto;max-width:9rem;display:block}
.top p{text-align:right}
.poster h1{font-size:clamp(1.75rem,var(--hv),11rem);align-self:center;overflow:clip;padding-bottom:.08em}
.poster h1 span{display:block}
.base{display:grid;gap:1.5rem;align-items:end}
.lede{font-size:var(--lead);line-height:1.35;max-width:34ch}
.go{display:inline-flex;align-items:center;min-height:56px;padding:1rem 1.6rem;background:var(--on-p);color:var(--p);font-family:var(--fh);font-weight:500;font-size:1.125rem;text-decoration:none;width:fit-content}

.facts{display:grid;grid-template-columns:1fr 1fr;gap:1.5rem 1.5rem;margin:0;padding:clamp(1.75rem,4vw,2.75rem) var(--m)}
.facts dt{font-size:var(--small);color:var(--muted)}
.facts dd{margin:.25rem 0 0;font-family:var(--fh);font-weight:500;font-size:var(--body);line-height:1.25;letter-spacing:-.015em}
.facts small{display:block;font-family:var(--fb);font-weight:400;font-size:var(--small);color:var(--muted);letter-spacing:0;margin-top:.2rem;line-height:1.4}

.qs{padding:clamp(3.5rem,6vw,5rem) var(--m) clamp(2rem,5vw,4rem);scroll-margin-top:0}
.qs-head{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:end;gap:1rem 2rem;margin-bottom:clamp(1.5rem,4vw,3rem)}
.qs-head h2{font-size:var(--big);max-width:14ch}
.prog{display:flex;align-items:center;gap:.75rem;font-size:var(--small);color:var(--muted);white-space:nowrap}
.prog b{font-weight:500;color:var(--ink)}
.pips{display:flex;gap:5px}
.pips i{width:12px;height:12px;border-radius:50%;background:var(--surface);border:1.5px solid var(--ink)}
.pips i.on{background:var(--ink)}
.qlist{list-style:none;margin:0;padding:0}
.q{display:grid;gap:1.25rem;padding:clamp(1.75rem,4vw,2.75rem) 0;border-top:2px solid var(--ink)}
.q-n{float:left;font-family:var(--fh);font-weight:900;font-size:var(--head);line-height:1;letter-spacing:-.04em;margin-right:.6rem}
.q-label{font-size:var(--small);color:var(--muted);margin-top:.5rem}
.q h3{max-width:32ch}
.opts{display:grid;gap:6px}
.opt{display:grid;grid-template-columns:14px minmax(0,1fr);gap:.85rem;align-items:center;width:100%;min-height:56px;padding:.85rem 1rem;border:0;background:var(--surface);color:var(--ink);font:inherit;line-height:1.3;text-align:left;cursor:pointer}
.opt:hover{background:color-mix(in srgb,var(--ink) 14%,var(--surface))}
.opt:focus-visible{outline:3px solid var(--ink);outline-offset:2px}
.opt[aria-pressed=true]{background:var(--p);color:var(--on-p)}
.box{width:14px;height:14px;border-radius:50%;border:1.5px solid currentColor}
.opt[aria-pressed=true] .box{background:currentColor}
.qs-foot{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:1rem;padding-top:clamp(1.5rem,3vw,2rem);border-top:2px solid var(--ink)}
.hint{color:var(--muted)}
.btn{display:inline-flex;align-items:center;min-height:56px;padding:1rem 1.6rem;background:var(--ink);color:var(--bg);font-family:var(--fh);font-weight:500;font-size:1.125rem;text-decoration:none}
.btn:focus-visible{outline-color:var(--ink)}

.res{scroll-margin-top:0}
.chapter{background:var(--s);color:var(--on-s);padding:clamp(3rem,8vw,6.5rem) var(--m) clamp(2.5rem,6vw,4.5rem)}
.chapter .sub{font-family:var(--fh);font-weight:500;font-size:var(--head);line-height:1.1;letter-spacing:-.025em;margin-top:1.25rem;max-width:26ch}
.chapter h2{font-size:var(--big);max-width:16ch}
.chapter .lede{margin-top:1.25rem;max-width:44ch}
.stats{display:grid;gap:2rem;margin:clamp(2rem,5vw,3.5rem) 0 clamp(2rem,5vw,3.5rem)}
.big{font-family:var(--fh);font-weight:900;font-size:clamp(4.5rem,3rem + 7vw,10rem);line-height:.8;letter-spacing:-.05em;margin-bottom:.75rem}
.big .of{font-size:.3em;font-weight:500;letter-spacing:-.02em;margin-left:.2em}
.cap{font-size:var(--lead);line-height:1.35;max-width:26ch}
.crowd{margin:0}
.crowd svg{width:100%;height:auto;display:block;overflow:visible}
.peer{fill:color-mix(in srgb,var(--on-s) 42%,var(--s))}
.behind{fill:color-mix(in srgb,var(--on-s) 12%,var(--s))}
.track{stroke:var(--on-s);stroke-width:.3}
.median{stroke:var(--on-s);stroke-width:.3;stroke-dasharray:.8 .8}
.qdot{fill:var(--s);stroke:var(--on-s);stroke-width:.35}
.you{fill:var(--p);stroke:var(--on-s);stroke-width:.5}
.crowd figcaption{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem;font-size:var(--small);margin-top:.75rem}
.crowd figcaption span:nth-child(2){text-align:center}
.crowd figcaption span:last-child{text-align:right}
.legend{font-size:var(--small);opacity:.85;margin-top:1.25rem;max-width:60ch}

.rows{list-style:none;margin:0;padding:clamp(1rem,3vw,2rem) var(--m) 0}
.row{display:grid;gap:1.25rem;padding:clamp(1.75rem,4vw,2.5rem) 0;border-bottom:2px solid var(--ink)}
.row:last-child{border-bottom:0}
.row-k{display:flex;gap:.75rem;align-items:baseline;font-family:var(--fh);font-weight:500;font-size:var(--head);line-height:1.1;letter-spacing:-.025em}
.row-k .n{font-weight:900;letter-spacing:-.04em}
.row-q{margin-top:.5rem;color:var(--muted);font-size:var(--small);max-width:40ch}
.row-you{margin-top:.75rem;display:flex;gap:.6rem;align-items:baseline}
.row-you i{width:12px;height:12px;border-radius:50%;background:var(--p);border:1.5px solid var(--ink);flex:none;display:inline-block;position:relative;top:.05rem}
.row-you b{font-weight:500}
.dist{display:flex;height:3rem;gap:3px}
.seg{display:flex;align-items:center;justify-content:center;font-size:var(--small);font-weight:500;color:var(--ink);min-width:0;overflow:hidden;white-space:nowrap}
.seg:nth-child(1){background:#d0cdc5}
.seg:nth-child(2){background:#bdbab1}
.seg:nth-child(3){background:#aaa79d}
.seg:nth-child(4){background:#97948a}
.seg.is-you{background:var(--p);color:var(--on-p)}
.dist-key{display:flex;justify-content:space-between;gap:1.5rem;font-size:var(--small);line-height:1.35;color:var(--muted);margin-top:.5rem}
.dist-key span{flex:1 1 0;min-width:0}
.dist-key span:last-child{text-align:right}
.verdict{margin-top:1rem;display:flex;flex-wrap:wrap;gap:.25rem .75rem;align-items:baseline}
.verdict b{font-family:var(--fh);font-weight:500;font-size:var(--lead);letter-spacing:-.02em}
.verdict span{color:var(--muted)}
.gap{margin-top:.6rem;max-width:52ch}
.scale{list-style:none;display:flex;gap:4px;margin:0;padding:0}
.scale li{flex:1;height:3rem;background:var(--surface)}
.scale li.on{background:var(--p)}
.method{font-size:var(--small);color:var(--muted);max-width:68ch;padding:1.5rem var(--m) 0}
.method b{color:var(--ink);font-weight:500}

.cta{background:var(--p);color:var(--on-p);margin-top:clamp(3rem,7vw,5rem);padding:clamp(3rem,8vw,6.5rem) var(--m);display:grid;gap:1.5rem;justify-items:start}
.cta h2{font-size:var(--big);max-width:14ch}
.cta p{font-size:var(--lead);line-height:1.35;max-width:40ch}
.cta .ken-cta{display:inline-flex!important;align-items:center;min-height:60px;padding:1rem 1.8rem!important;border-radius:0!important;background:var(--on-p)!important;color:var(--p)!important;font-family:var(--fh);font-weight:500!important;font-size:var(--body);text-decoration:none}
.cta .ken-cta:focus-visible{outline:3px solid var(--on-p);outline-offset:4px}
.sign{font-weight:500}
.sign span{display:block;font-weight:400}
.foot{padding:1.5rem var(--m) 3rem;font-size:var(--small);color:var(--muted);max-width:70ch}

@keyframes rise{from{transform:translateY(105%)}}
@keyframes up{from{opacity:0;transform:translateY(.75rem)}}
@media (prefers-reduced-motion:no-preference){
  .poster h1 span{animation:rise .9s cubic-bezier(.2,.75,.1,1) both}
  .base{animation:up .6s .55s ease-out both}
}
@media (min-width:640px){
  .poster{min-height:min(88svh,56rem)}
  .facts{grid-template-columns:repeat(4,minmax(0,1fr))}
  .opts{grid-template-columns:1fr 1fr}
  .stats{grid-template-columns:1fr 1fr;gap:3rem}
}
@media (min-width:900px){
  .base{grid-template-columns:minmax(0,1fr) auto}
  .q-top{display:grid;grid-template-columns:auto minmax(0,1fr);column-gap:1.5rem;align-items:start}
  .q-n{float:none;font-size:var(--big);line-height:.8;letter-spacing:-.05em;min-width:.6em;margin:0}
  .row{grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:3rem}
}
@media (min-width:1200px){
  .opts{grid-template-columns:repeat(4,minmax(0,1fr));align-items:stretch}
  .opt{grid-template-columns:1fr;align-content:space-between;align-items:start;min-height:8.5rem;padding:1rem 1rem 1.1rem}
}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
</style>
</head>
<body style="--hv:{{ h1_v }}vw">
<main class="bq" x-data="{ a1: null, a2: null, a3: null, a4: null, a5: null, p1: 0, p2: 0, p3: 0, p4: 0, p5: 0, g1: 0, g2: 0, g3: 0, g4: 0, g5: 0, answered: 0, done: false, ahead: 0, avgn: 0, avg: 0, peers: {{ peer_total | escape }} }">
<span hidden x-effect="answered = (a1 === null ? 0 : 1) + (a2 === null ? 0 : 1) + (a3 === null ? 0 : 1) + (a4 === null ? 0 : 1) + (a5 === null ? 0 : 1)"></span>
<span hidden x-effect="done = answered === 5"></span>
<span hidden x-effect="ahead = (g1 > 0 ? 1 : 0) + (g2 > 0 ? 1 : 0) + (g3 > 0 ? 1 : 0) + (g4 > 0 ? 1 : 0) + (g5 > 0 ? 1 : 0)"></span>
<span hidden x-effect="avgn = (p1 + p2 + p3 + p4 + p5) / 5"></span>
<span hidden x-effect="avg = avgn.toFixed(0)"></span>
<section data-section="intro">
<div class="poster">
<header class="top">
{%- if brand.logo_url %}<img class="logo" src="{{ brand.logo_url | escape }}" alt="{{ brand_name | escape }}">{% elsif brand.name %}<span class="brand">{{ brand.name | escape }}</span>{% else %}<span></span>{% endif -%}
<p>{% if person.first_name %}For {{ person.first_name | escape }} {{ person.last_name | escape }}, {{ account.name | escape }}{% else %}For {{ account.name | escape }}{% endif %}</p>
</header>
<h1><span>How does {{ account.name | escape }} compare?</span></h1>
<div class="base">
<p class="lede">{{ data.intro | escape }}</p>
<a class="go" href="#questions">Start the five questions</a>
</div>
</div>
<dl class="facts">
<div><dt>The questions</dt><dd>Five on {{ topic | escape }}<small>About two minutes</small></dd></div>
{%- if has_peers %}
<div><dt>The peers</dt><dd>{{ peer_total }} {{ industry | escape }} companies<small>{% if peer_source != '' %}{{ peer_source | escape }}{% else %}Answered the same five questions{% endif %}</small></dd></div>
{%- else %}
<div><dt>The peers</dt><dd>None for {{ industry | escape }} yet<small>You still see your own picture</small></dd></div>
{%- endif %}
<div><dt>From</dt><dd>{{ sender_name | escape }}<small>{% if sender.title %}{{ sender.title | escape }}, {% endif %}{{ brand_name | escape }}</small></dd></div>
<div><dt>Your answers</dt><dd>Stay in your browser<small>Nothing is sent</small></dd></div>
</dl>
</section>
<section id="questions" data-section="questions" class="qs">
<div class="qs-head"><h2>Five questions on {{ topic | escape }}</h2><div class="prog"><span class="pips" aria-hidden="true">{% for q in data.questions %}<i x-bind:class="answered >= {{ forloop.index }} ? 'on' : ''"></i>{% endfor %}</span><p><b x-text="answered">0</b> of 5 answered</p></div></div>
<ol class="qlist">
{%- for q in data.questions %}
{%- assign i = forloop.index -%}
{%- assign row = false -%}
{%- for r in data.peers -%}{%- if r.question == q.key -%}{%- assign row = r -%}{%- endif -%}{%- endfor -%}
{%- assign total = 0 -%}
{%- if row and has_peers -%}{%- assign total = row.n_1 | plus: row.n_2 | plus: row.n_3 | plus: row.n_4 -%}{%- endif -%}
{%- assign m = 0 -%}
{%- assign cum = 0 -%}
{%- if total > 0 -%}
{%- for opt in q.options -%}
{%- case forloop.index -%}{%- when 1 -%}{%- assign nk = row.n_1 -%}{%- when 2 -%}{%- assign nk = row.n_2 -%}{%- when 3 -%}{%- assign nk = row.n_3 -%}{%- else -%}{%- assign nk = row.n_4 -%}{%- endcase -%}
{%- assign cum = cum | plus: nk -%}
{%- assign cum2 = cum | times: 2 -%}
{%- if m == 0 and cum2 >= total -%}{%- assign m = forloop.index -%}{%- endif -%}
{%- endfor -%}
{%- endif -%}
<li class="q">
<div class="q-top">
<span class="q-n" aria-hidden="true">{{ i }}</span>
<div><h3>{{ q.text | escape }}</h3><p class="q-label">{{ q.label | escape }}</p></div>
</div>
<div class="opts" data-ui role="group" aria-label="Question {{ i }}">
{%- assign cum = 0 -%}
{%- for opt in q.options %}
{%- assign k = forloop.index0 -%}
{%- assign pk = 0 -%}
{%- assign gk = 0 -%}
{%- if total > 0 -%}
{%- case forloop.index -%}{%- when 1 -%}{%- assign nk = row.n_1 -%}{%- when 2 -%}{%- assign nk = row.n_2 -%}{%- when 3 -%}{%- assign nk = row.n_3 -%}{%- else -%}{%- assign nk = row.n_4 -%}{%- endcase -%}
{%- assign pk = cum | times: 2 | plus: nk | times: 50.0 | divided_by: total | round -%}
{%- if forloop.index > m -%}{%- assign gk = 1 -%}{%- elsif forloop.index < m -%}{%- assign gk = -1 -%}{%- endif -%}
{%- assign cum = cum | plus: nk -%}
{%- endif -%}
<button type="button" class="opt" x-on:click="[a{{ i }} = {{ k | escape }}, p{{ i }} = {{ pk | escape }}, g{{ i }} = {{ gk | escape }}]" x-bind:aria-pressed="a{{ i }} === {{ k | escape }}" aria-pressed="false"><span class="box" aria-hidden="true"></span><span>{{ opt | escape }}</span></button>
{%- endfor %}
</div>
</li>
{%- endfor %}
</ol>
<div class="qs-foot">
<p class="hint" x-bind:hidden="done">Answer all five to see where {{ account.name | escape }} stands.</p>
<a class="btn" href="#result" hidden x-bind:hidden="!done">See where {{ account.name | escape }} stands</a>
</div>
</section>
<section id="result" data-section="result" class="res" hidden x-bind:hidden="!done">
{%- if has_peers %}
<div class="chapter">
<h2>Where {{ account.name | escape }} stands</h2>
<div class="stats">
<div class="stat"><p class="big"><span x-text="ahead">0</span><span class="of">of 5</span></p><p class="cap">questions where {{ account.name | escape }} is ahead of the typical {{ industry | escape }} company</p></div>
<div class="stat"><p class="big"><span x-text="avg">0</span><span class="of">%</span></p><p class="cap">of the {{ peer_total }} {{ industry | escape }} peers sit behind {{ account.name | escape }}, averaged over the five questions</p></div>
</div>
<figure class="crowd">
<svg viewBox="0 0 100 22" role="img" aria-label="{{ account.name | escape }} against {{ peer_total }} {{ industry | escape }} peers, one dot per question and a larger dot for the average">
<rect class="behind" x="0" y="0" width="0" x-bind:width="avgn" height="16"/>
{%- for k in (1..dots) %}
{%- assign jy = k | times: 7 | modulo: 5 | times: 2.4 | plus: 3.2 %}
<circle class="peer" cx="{{ k | minus: 0.5 | times: 100.0 | divided_by: dots | round: 2 }}" cy="{{ jy | round: 1 }}" r=".8"/>
{%- endfor %}
<line class="track" x1="0" y1="19" x2="100" y2="19"/>
<line class="median" x1="50" y1="0" x2="50" y2="21"/>
{%- for q in data.questions %}
<circle class="qdot" cx="0" x-bind:cx="p{{ forloop.index }}" cy="19" r="1.1"/>
{%- endfor %}
<circle class="you" cx="0" x-bind:cx="avgn" cy="8" r="2.4"/>
</svg>
<figcaption><span>Behind every peer</span><span>The typical peer</span><span>Ahead of every peer</span></figcaption>
</figure>
<p class="legend">{% if dots == peer_total %}Each small dot is one of the {{ peer_total }} peers, lined up from behind to ahead.{% else %}The small dots stand for the {{ peer_total }} peers, lined up from behind to ahead.{% endif %} Rings on the line: one per question. Large dot: the average of the five.</p>
</div>
<ol class="rows">
{%- for q in data.questions %}
{%- assign i = forloop.index -%}
{%- assign row = false -%}
{%- for r in data.peers -%}{%- if r.question == q.key -%}{%- assign row = r -%}{%- endif -%}{%- endfor -%}
{%- assign line = false -%}
{%- for l in data.lines -%}{%- if l.key == q.key -%}{%- assign line = l -%}{%- endif -%}{%- endfor -%}
{%- assign total = row.n_1 | plus: row.n_2 | plus: row.n_3 | plus: row.n_4 -%}
{%- assign s1 = row.n_1 | times: 100.0 | divided_by: total | round -%}
{%- assign s2 = row.n_2 | times: 100.0 | divided_by: total | round -%}
{%- assign s3 = row.n_3 | times: 100.0 | divided_by: total | round -%}
{%- assign s4 = 100 | minus: s1 | minus: s2 | minus: s3 | at_least: 0 -%}
<li class="row">
<div>
<p class="row-k"><span class="n">{{ i }}</span>{{ q.label | escape }}</p>
<p class="row-q">{{ q.text | escape }}</p>
<p class="row-you"><i aria-hidden="true"></i><span>You:
{%- for opt in q.options %} <b hidden x-bind:hidden="a{{ i }} !== {{ forloop.index0 }}">{{ opt | escape }}</b>{% endfor %}</span></p>
</div>
<div>
<div class="dist" role="img" aria-label="How {{ total }} peers answered, weakest option on the left">
{%- for opt in q.options %}
{%- case forloop.index -%}{%- when 1 -%}{%- assign sk = s1 -%}{%- when 2 -%}{%- assign sk = s2 -%}{%- when 3 -%}{%- assign sk = s3 -%}{%- else -%}{%- assign sk = s4 -%}{%- endcase -%}
<span class="seg" style="width:{{ sk }}%" x-bind:class="a{{ i }} === {{ forloop.index0 }} ? 'seg is-you' : 'seg'">{% if sk >= 11 %}{{ sk }}%{% endif %}</span>
{%- endfor %}
</div>
<div class="dist-key"><span>{{ q.options | first | escape }}</span><span>{{ q.options | last | escape }}</span></div>
<p class="verdict"><b hidden x-bind:hidden="g{{ i }} !== 1">Ahead of most peers</b><b hidden x-bind:hidden="g{{ i }} !== 0">In line with peers</b><b hidden x-bind:hidden="g{{ i }} !== -1">Behind most peers</b><span>ahead of <span x-text="p{{ i }}">0</span>% of peers</span></p>
{%- if line %}
<p class="gap" hidden x-bind:hidden="g{{ i }} !== 1">{{ line.ahead | escape }}</p>
<p class="gap" hidden x-bind:hidden="g{{ i }} !== 0">{{ line.level | escape }}</p>
<p class="gap" hidden x-bind:hidden="g{{ i }} !== -1">{{ line.behind | escape }}</p>
{%- endif %}
</div>
</li>
{%- endfor %}
</ol>
<p class="method"><b>How this is counted.</b> The peers are {{ peer_total }} {{ industry | escape }} companies{% if peer_source != '' %} from {{ peer_source | escape }}{% endif %}, answering the same five questions. Each bar shows how they answered, weakest option on the left. The percentage under a bar counts the peers who picked a weaker option than you plus half of those who picked the same one. Ahead, in line and behind compare your pick with the median peer's. Nothing is weighted or adjusted.</p>
{%- else %}
<div class="chapter">
<h2>Where {{ account.name | escape }} stands</h2>
<p class="sub">Your five answers, without a peer group yet</p>
<p class="lede">We have no answers from {{ industry | escape }} companies yet, so this page shows {{ account.name | escape }}'s own picture: each scale runs from the weakest option on the left to the strongest on the right. {{ sender_first | escape }} will bring the closest peer group to the call.</p>
</div>
<ol class="rows">
{%- for q in data.questions %}
{%- assign i = forloop.index -%}
<li class="row">
<div>
<p class="row-k"><span class="n">{{ i }}</span>{{ q.label | escape }}</p>
<p class="row-q">{{ q.text | escape }}</p>
</div>
<div>
<ol class="scale" aria-label="Your answer on a scale from the weakest option to the strongest">
{%- for opt in q.options %}
<li x-bind:class="a{{ i }} === {{ forloop.index0 }} ? 'on' : ''"></li>
{%- endfor %}
</ol>
<div class="dist-key"><span>{{ q.options | first | escape }}</span><span>{{ q.options | last | escape }}</span></div>
<p class="row-you"><i aria-hidden="true"></i><span>You:
{%- for opt in q.options %} <b hidden x-bind:hidden="a{{ i }} !== {{ forloop.index0 }}">{{ opt | escape }}</b>{% endfor %}</span></p>
</div>
</li>
{%- endfor %}
</ol>
{%- endif %}
</section>
<section data-section="cta" class="cta">
<h2>Go through the five with {{ sender_first | escape }}</h2>
<p>Twenty minutes. {{ sender_first | escape }} walks through the five questions{% if has_peers %} with the peer answers behind each one, and what usually sits behind each gap{% else %} with the closest peer group to {{ account.name | escape }}{% endif %}.</p>
{% render 'ken/cta', label: 'Book 20 minutes', kind: 'booking' %}
<p class="sign">{{ sender_name | escape }}<span>{% if sender.title %}{{ sender.title | escape }}, {% endif %}{{ brand_name | escape }}</span></p>
</section>
<footer class="foot">Made for {% if person.first_name %}{{ person.first_name | escape }} {{ person.last_name | escape }} at {% endif %}{{ account.name | escape }} by {{ sender_name | escape }} at {{ brand_name | escape }}. Your answers stay in your browser and are not sent anywhere.</footer>
</main>
</body>
</html>
