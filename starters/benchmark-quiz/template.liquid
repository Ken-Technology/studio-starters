{%- assign accent = brand.colors.primary | default: '#0b6e5f' -%}
{%- assign accent2 = brand.colors.secondary | default: '#17202a' -%}
{%- assign font_head = brand.fonts.heading | default: 'Schibsted Grotesk' -%}
{%- assign font_body = brand.fonts.body | default: 'Instrument Sans' -%}
{%- assign head_q = font_head | replace: ' ', '+' -%}
{%- assign body_q = font_body | replace: ' ', '+' -%}
{%- assign brand_name = brand.name | default: 'our team' -%}
{%- assign sender_name = sender.name | default: 'our team' -%}
{%- assign sender_first = sender_name | split: ' ' | first -%}
{%- assign industry = account.industry | default: 'your industry' -%}
{%- assign topic = data.topic | default: 'work' -%}
{%- comment -%} Peer rows: every question needs one row with at least one answer, or the comparison hides. {%- endcomment -%}
{%- assign matched = 0 -%}
{%- assign peer_total = 0 -%}
{%- assign peer_source = '' -%}
{%- for q in data.questions -%}
{%- assign row = false -%}
{%- for r in data.peers -%}{%- if r.question == q.key -%}{%- assign row = r -%}{%- endif -%}{%- endfor -%}
{%- if row -%}
{%- assign total = row.n_1 | plus: row.n_2 | plus: row.n_3 | plus: row.n_4 -%}
{%- if total > 0 -%}
{%- assign matched = matched | plus: 1 -%}
{%- if peer_total == 0 -%}{%- assign peer_total = total -%}{%- assign peer_source = row.source | default: '' -%}{%- endif -%}
{%- endif -%}
{%- endif -%}
{%- endfor -%}
{%- assign has_peers = false -%}
{%- if matched == data.questions.size and matched > 0 -%}{%- assign has_peers = true -%}{%- endif -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex">
<title>How does {{ account.name | escape }} compare?</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ head_q }}:wght@400;500;600;700&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ body_q }}:wght@400;500;600;700&display=swap">
<script defer src="https://cdn.jsdelivr.net/npm/@alpinejs/csp@3/dist/cdn.min.js"></script>
<style>
:root{--p:{{ accent }};--s:{{ accent2 }};--ink:var(--s);--mute:color-mix(in srgb,var(--s) 60%,#fff);--faint:color-mix(in srgb,var(--s) 40%,#fff);--line:color-mix(in srgb,var(--s) 15%,#fff);--hair:color-mix(in srgb,var(--s) 8%,#fff);--paper:color-mix(in srgb,var(--s) 3%,#fbfaf7);--card:#fff;--tint:color-mix(in srgb,var(--p) 8%,#fff);--p-deep:color-mix(in srgb,var(--p) 78%,var(--s));--t1:color-mix(in srgb,var(--s) 12%,#fff);--t2:color-mix(in srgb,var(--s) 20%,#fff);--t3:color-mix(in srgb,var(--s) 30%,#fff);--t4:color-mix(in srgb,var(--s) 42%,#fff)}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%;scroll-behavior:smooth}
body{margin:0;background:var(--paper);color:var(--ink);font-family:'{{ font_body }}',ui-sans-serif,system-ui,sans-serif;font-size:16px;line-height:1.55;-webkit-font-smoothing:antialiased;font-variant-numeric:tabular-nums}
h1,h2,h3,.big,.q-n{font-family:'{{ font_head }}',ui-sans-serif,system-ui,sans-serif;font-weight:600;line-height:1.1;letter-spacing:-.015em;margin:0}
p{margin:0}
.wrap{max-width:66rem;margin:0 auto;padding:0 1.15rem}
[hidden]{display:none!important}
.top{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:1rem 0;border-bottom:1px solid var(--line)}
.brand{font-family:'{{ font_head }}',ui-sans-serif,system-ui,sans-serif;font-weight:700;font-size:1.05rem;letter-spacing:-.01em}
.logo{height:26px;width:auto;display:block}
.top-r{font-size:.84rem;color:var(--mute);white-space:nowrap}
.eyebrow{font-size:.76rem;font-weight:600;letter-spacing:.09em;text-transform:uppercase;color:var(--p-deep)}
.intro{padding:2.3rem 0 2rem}
.intro .eyebrow{margin-bottom:1rem}
h1{font-size:clamp(2.3rem,9vw,4rem);line-height:1;letter-spacing:-.03em;max-width:13ch;margin-bottom:1.1rem;text-wrap:balance}
.lede{font-size:1.1rem;line-height:1.5;max-width:36rem}
.facts{display:grid;grid-template-columns:1fr 1fr;gap:0 1.5rem;margin:1.8rem 0 0;padding:0;border-top:2px solid var(--ink)}
.facts div{padding:.7rem 0 .8rem;border-bottom:1px solid var(--line)}
.facts dt{font-size:.74rem;color:var(--mute)}
.facts dd{margin:.15rem 0 0;font-weight:600;font-size:.96rem;line-height:1.3}
.facts small{display:block;font-weight:400;color:var(--mute);font-size:.8rem;line-height:1.4;margin-top:.1rem}
.qs{padding:1.4rem 0 .6rem}
.qs-head{display:grid;gap:.25rem;padding-bottom:.8rem;border-bottom:1px solid var(--ink)}
.qs-head h2{font-size:1.3rem}
.prog{font-size:.88rem;color:var(--mute);white-space:nowrap}
.res h2.eyebrow{font-family:inherit;font-size:.76rem;line-height:1.5;letter-spacing:.09em;max-width:none}
.prog b{color:var(--ink)}
.qlist{list-style:none;margin:0;padding:0}
.q{padding:1.5rem 0 1.7rem;border-bottom:1px solid var(--line)}
.q-top{display:flex;gap:.9rem;align-items:flex-start;margin-bottom:1rem}
.q-n{font-size:2.2rem;line-height:.9;letter-spacing:-.04em;color:var(--ink);min-width:1.4rem;padding-top:.15rem}
.q-label{font-size:.74rem;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--mute);margin-bottom:.3rem}
.q h3{font-size:1.25rem;line-height:1.3;letter-spacing:-.01em;text-wrap:balance}
.opts{display:grid;gap:.55rem}
.opt{display:grid;grid-template-columns:1.15rem minmax(0,1fr);gap:.8rem;align-items:center;width:100%;min-height:3.1rem;padding:.7rem .95rem;border:1px solid var(--line);border-radius:6px;background:var(--card);color:var(--ink);font:inherit;font-size:.97rem;line-height:1.35;text-align:left;cursor:pointer;transition:border-color .12s,background .12s}
.opt:hover{border-color:var(--faint)}
.opt:focus-visible{outline:2px solid var(--p);outline-offset:2px}
.opt[aria-pressed=true]{border-color:var(--p);background:var(--tint);box-shadow:inset 0 0 0 1px var(--p)}
.box{width:1.15rem;height:1.15rem;border:1.5px solid var(--faint);border-radius:4px;position:relative;background:#fff}
.opt[aria-pressed=true] .box{background:var(--p);border-color:var(--p)}
.opt[aria-pressed=true] .box::after{content:'';position:absolute;left:.33rem;top:.1rem;width:.3rem;height:.58rem;border:solid #fff;border-width:0 2px 2px 0;transform:rotate(45deg)}
.qs-foot{display:flex;flex-direction:column;gap:.9rem;align-items:flex-start;padding:1.5rem 0 .6rem}
.hint{color:var(--mute);font-size:.95rem}
.btn{display:inline-block;background:var(--p);color:#fff;text-decoration:none;font-weight:600;padding:.85rem 1.3rem;border-radius:6px;font-size:1rem}
.btn:hover{background:var(--p-deep)}
.btn:focus-visible,a:focus-visible{outline:2px solid var(--p);outline-offset:3px}
.res{padding:2.2rem 0 1rem;border-top:2px solid var(--ink);scroll-margin-top:1rem}
.res .eyebrow{margin-bottom:.9rem}
.res h2{font-size:1.75rem;letter-spacing:-.02em;max-width:22ch;text-wrap:balance}
.res .lede{margin-top:.8rem;font-size:1.02rem;color:var(--mute)}
.stats{display:grid;gap:1.1rem;margin:.2rem 0 1.6rem}
.stat{border-top:1px solid var(--line);padding-top:.75rem}
.big{font-size:3.3rem;line-height:1;letter-spacing:-.035em;margin-bottom:.4rem}
.big .of{font-size:1.35rem;letter-spacing:-.01em;color:var(--mute);font-weight:500;margin-left:.15rem}
.cap{color:var(--mute);font-size:.92rem;line-height:1.45;max-width:24rem}
.strip{margin:0;padding:.4rem .6rem 0;max-width:42rem}
.strip svg{width:100%;height:auto;display:block;overflow:visible}
.track{stroke:var(--line);stroke-width:1.1;stroke-linecap:round}
.median{stroke:var(--ink);stroke-width:.45}
.qdot{fill:#fff;stroke:var(--ink);stroke-width:.45}
.you{fill:var(--p);stroke:#fff;stroke-width:.6}
.strip figcaption{display:flex;justify-content:space-between;gap:.5rem;font-size:.76rem;color:var(--mute);margin-top:.4rem}
.strip figcaption span:nth-child(2){text-align:center}
.strip figcaption span:last-child{text-align:right}
.legend{font-size:.8rem;color:var(--mute);margin-top:.4rem}
.rows{list-style:none;margin:1.6rem 0 0;padding:0;border-top:1px solid var(--ink)}
.row{padding:1.35rem 0 1.5rem;border-bottom:1px solid var(--line);display:grid;gap:.9rem}
.row-k{font-weight:600;font-size:1.02rem;display:flex;gap:.6rem;align-items:baseline}
.row-k .n{font-family:'{{ font_head }}',ui-sans-serif,system-ui,sans-serif;color:var(--mute);font-size:.86rem;min-width:1rem}
.row-q{margin-top:.2rem;color:var(--mute);font-size:.9rem;line-height:1.4}
.row-you{margin-top:.6rem;font-size:.92rem;display:flex;gap:.5rem;align-items:baseline}
.row-you i{width:.6rem;height:.6rem;border-radius:2px;background:var(--p);flex:none;display:inline-block;position:relative;top:.05rem}
.row-you b{font-weight:600}
.dist{display:flex;height:1.75rem;border-radius:4px;overflow:hidden;gap:2px}
.seg{display:flex;align-items:center;justify-content:center;font-size:.72rem;font-weight:600;color:var(--ink);min-width:0;overflow:hidden;white-space:nowrap}
.seg:nth-child(1){background:var(--t1)}
.seg:nth-child(2){background:var(--t2)}
.seg:nth-child(3){background:var(--t3)}
.seg:nth-child(4){background:var(--t4)}
.seg.is-you{background:var(--p);color:#fff}
.dist-key{display:flex;justify-content:space-between;gap:1.2rem;font-size:.72rem;line-height:1.35;color:var(--mute);margin-top:.35rem}
.dist-key span{flex:1 1 0;min-width:0}
.dist-key span:last-child{text-align:right}
.verdict{margin-top:.7rem;font-size:.95rem;display:flex;flex-wrap:wrap;gap:.2rem .7rem;align-items:baseline}
.verdict b{font-weight:600}
.verdict span{color:var(--mute);font-size:.9rem}
.gap{margin-top:.55rem;font-size:1rem;line-height:1.5;max-width:40rem;padding-left:.9rem;border-left:2px solid var(--p)}
.scale{list-style:none;display:flex;gap:.35rem;margin:0;padding:0}
.scale li{flex:1;height:.65rem;border-radius:3px;background:var(--t1)}
.scale li.on{background:var(--p)}
.method{font-size:.82rem;color:var(--mute);line-height:1.55;max-width:46rem;margin-top:1.3rem}
.method b{color:var(--ink);font-weight:600}
.cta{padding:2.2rem 0 1rem}
.cta-box{background:var(--card);border:1px solid var(--line);border-top:3px solid var(--p);padding:1.5rem 1.3rem 1.4rem;max-width:44rem}
.cta-box h2{font-size:1.45rem;margin-bottom:.6rem}
.cta-box p{margin-bottom:1.2rem;max-width:34rem}
.cta-box .ken-cta{font-family:inherit;font-size:1rem;background:var(--p)!important;border-radius:6px!important;padding:.85rem 1.3rem!important}
.cta-box .ken-cta:hover{background:var(--p-deep)!important}
.sign{margin:1.3rem 0 0;font-size:.95rem;font-weight:600}
.sign span{display:block;color:var(--mute);font-size:.86rem;font-weight:400}
.foot{padding:1.4rem 0 4rem;font-size:.8rem;color:var(--mute);border-top:1px solid var(--line);margin-top:1.6rem;line-height:1.5}
@media (min-width:600px){
.stats{grid-template-columns:1fr 1fr;gap:2rem}
.qs-head{display:flex;align-items:baseline;justify-content:space-between;gap:1rem}
}
@media (min-width:760px){
body{font-size:17px}
.wrap{padding:0 2rem}
.intro{padding:3.4rem 0 2.6rem}
.facts{grid-template-columns:repeat(4,minmax(0,1fr));border-bottom:1px solid var(--line)}
.facts div{border-bottom:0;padding:.8rem 0 .9rem}
.qs{padding:1.8rem 0 .8rem}
.q{display:grid;grid-template-columns:minmax(0,20rem) minmax(0,1fr);gap:2.5rem;padding:1.8rem 0 2rem}
.q-top{margin-bottom:0}
.opts{grid-template-columns:1fr 1fr;align-content:start}
.qs-foot{flex-direction:row;align-items:center;justify-content:space-between}
.res{padding:3rem 0 1.2rem}
.row{grid-template-columns:minmax(0,17rem) minmax(0,1fr);gap:2.5rem}
.row-you{margin-top:.8rem}
.cta-box{padding:2rem 2.2rem 1.9rem}
}
@media (min-width:1040px){
.wrap{padding:0 2.5rem}
.intro{display:grid;grid-template-columns:minmax(0,1fr) 20rem;gap:4rem;align-items:end}
.facts{grid-template-columns:1fr;margin:0;border-bottom:0}
.facts div{border-bottom:1px solid var(--line)}
.q{grid-template-columns:minmax(0,24rem) minmax(0,1fr);gap:4rem}
.row{grid-template-columns:minmax(0,20rem) minmax(0,1fr);gap:4rem}
}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}.opt{transition:none}}
</style>
</head>
<body>
<main class="bq" x-data="{ a1: null, a2: null, a3: null, a4: null, a5: null, p1: 0, p2: 0, p3: 0, p4: 0, p5: 0, g1: 0, g2: 0, g3: 0, g4: 0, g5: 0, answered: 0, done: false, ahead: 0, avgn: 0, avg: 0, peers: {{ peer_total | escape }} }">
<span hidden x-effect="answered = (a1 === null ? 0 : 1) + (a2 === null ? 0 : 1) + (a3 === null ? 0 : 1) + (a4 === null ? 0 : 1) + (a5 === null ? 0 : 1)"></span>
<span hidden x-effect="done = answered === 5"></span>
<span hidden x-effect="ahead = (g1 > 0 ? 1 : 0) + (g2 > 0 ? 1 : 0) + (g3 > 0 ? 1 : 0) + (g4 > 0 ? 1 : 0) + (g5 > 0 ? 1 : 0)"></span>
<span hidden x-effect="avgn = (p1 + p2 + p3 + p4 + p5) / 5"></span>
<span hidden x-effect="avg = avgn.toFixed(0)"></span>
<div class="wrap">
<header class="top">
{%- if brand.logo_url %}<img class="logo" src="{{ brand.logo_url | escape }}" alt="{{ brand_name | escape }}">{% else %}<span class="brand">{{ brand_name | escape }}</span>{% endif -%}
<span class="top-r">Five questions, two minutes</span>
</header>
<section data-section="intro" class="intro">
<div>
<p class="eyebrow">{% if person.first_name %}For {{ person.first_name | escape }} {{ person.last_name | escape }}, {{ account.name | escape }}{% else %}For {{ account.name | escape }}{% endif %}</p>
<h1>How does {{ account.name | escape }} compare?</h1>
<p class="lede">{{ data.intro | escape }}</p>
</div>
<dl class="facts">
<div><dt>The questions</dt><dd>Five on {{ topic | escape }}<small>About two minutes</small></dd></div>
{%- if has_peers %}
<div><dt>The peers</dt><dd>{{ peer_total }} {{ industry | escape }} companies<small>{% if peer_source != '' %}{{ peer_source | escape }}{% else %}Answered the same five questions{% endif %}</small></dd></div>
{%- else %}
<div><dt>The peers</dt><dd>None for {{ industry | escape }} yet<small>You still see your own picture</small></dd></div>
{%- endif %}
<div><dt>From</dt><dd>{{ sender_name | escape }}<small>{% if sender.title %}{{ sender.title | escape }}, {% endif %}{{ brand_name | escape }}</small></dd></div>
<div><dt>Your answers</dt><dd>Stay in your browser<small>Nothing is sent</small></dd></div>
</dl>
</section>
<section data-section="questions" class="qs">
<div class="qs-head"><h2>Five questions on {{ topic | escape }}</h2><p class="prog"><b x-text="answered">0</b> of 5 answered</p></div>
<ol class="qlist">
{%- for q in data.questions %}
{%- assign i = forloop.index -%}
{%- assign row = false -%}
{%- for r in data.peers -%}{%- if r.question == q.key -%}{%- assign row = r -%}{%- endif -%}{%- endfor -%}
{%- assign total = 0 -%}
{%- if row and has_peers -%}{%- assign total = row.n_1 | plus: row.n_2 | plus: row.n_3 | plus: row.n_4 -%}{%- endif -%}
{%- assign m = 0 -%}
{%- assign cum = 0 -%}
{%- if total > 0 -%}
{%- for opt in q.options -%}
{%- case forloop.index -%}{%- when 1 -%}{%- assign nk = row.n_1 -%}{%- when 2 -%}{%- assign nk = row.n_2 -%}{%- when 3 -%}{%- assign nk = row.n_3 -%}{%- else -%}{%- assign nk = row.n_4 -%}{%- endcase -%}
{%- assign cum = cum | plus: nk -%}
{%- assign cum2 = cum | times: 2 -%}
{%- if m == 0 and cum2 >= total -%}{%- assign m = forloop.index -%}{%- endif -%}
{%- endfor -%}
{%- endif -%}
<li class="q">
<div class="q-top">
<span class="q-n" aria-hidden="true">{{ i }}</span>
<div><p class="q-label">{{ q.label | escape }}</p><h3>{{ q.text | escape }}</h3></div>
</div>
<div class="opts" role="group" aria-label="Question {{ i }}">
{%- assign cum = 0 -%}
{%- for opt in q.options %}
{%- assign k = forloop.index0 -%}
{%- assign pk = 0 -%}
{%- assign gk = 0 -%}
{%- if total > 0 -%}
{%- case forloop.index -%}{%- when 1 -%}{%- assign nk = row.n_1 -%}{%- when 2 -%}{%- assign nk = row.n_2 -%}{%- when 3 -%}{%- assign nk = row.n_3 -%}{%- else -%}{%- assign nk = row.n_4 -%}{%- endcase -%}
{%- assign pk = cum | times: 2 | plus: nk | times: 50.0 | divided_by: total | round -%}
{%- if forloop.index > m -%}{%- assign gk = 1 -%}{%- elsif forloop.index < m -%}{%- assign gk = -1 -%}{%- endif -%}
{%- assign cum = cum | plus: nk -%}
{%- endif -%}
<button type="button" class="opt" x-on:click="[a{{ i }} = {{ k | escape }}, p{{ i }} = {{ pk | escape }}, g{{ i }} = {{ gk | escape }}]" x-bind:aria-pressed="a{{ i }} === {{ k | escape }}" aria-pressed="false"><span class="box" aria-hidden="true"></span><span>{{ opt | escape }}</span></button>
{%- endfor %}
</div>
</li>
{%- endfor %}
</ol>
<div class="qs-foot">
<p class="hint" x-bind:hidden="done">Answer all five to see where {{ account.name | escape }} stands.</p>
<a class="btn" href="#result" hidden x-bind:hidden="!done">See where {{ account.name | escape }} stands</a>
</div>
</section>
<section id="result" data-section="result" class="res" hidden x-bind:hidden="!done">
{%- if has_peers %}
<h2 class="eyebrow">Where {{ account.name | escape }} stands</h2>
<div class="stats">
<div class="stat"><p class="big"><span x-text="ahead">0</span><span class="of">of 5</span></p><p class="cap">questions where {{ account.name | escape }} is ahead of the typical {{ industry | escape }} company</p></div>
<div class="stat"><p class="big"><span x-text="avg">0</span><span class="of">%</span></p><p class="cap">of the {{ peer_total }} {{ industry | escape }} peers sit behind {{ account.name | escape }}, averaged over the five questions</p></div>
</div>
<figure class="strip">
<svg viewBox="0 0 100 12" role="img" aria-label="{{ account.name | escape }} against {{ peer_total }} {{ industry | escape }} peers, one dot per question and a larger dot for the average">
<line class="track" x1="0" y1="6" x2="100" y2="6"/>
<line class="median" x1="50" y1="1.5" x2="50" y2="10.5"/>
{%- for q in data.questions %}
<circle class="qdot" cx="0" x-bind:cx="p{{ forloop.index }}" cy="6" r="1.5"/>
{%- endfor %}
<circle class="you" cx="0" x-bind:cx="avgn" cy="6" r="2.6"/>
</svg>
<figcaption><span>Behind every peer</span><span>The typical peer</span><span>Ahead of every peer</span></figcaption>
</figure>
<p class="legend">Small dots: one per question. Large dot: the average of the five.</p>
<ol class="rows">
{%- for q in data.questions %}
{%- assign i = forloop.index -%}
{%- assign row = false -%}
{%- for r in data.peers -%}{%- if r.question == q.key -%}{%- assign row = r -%}{%- endif -%}{%- endfor -%}
{%- assign line = false -%}
{%- for l in data.lines -%}{%- if l.key == q.key -%}{%- assign line = l -%}{%- endif -%}{%- endfor -%}
{%- assign total = row.n_1 | plus: row.n_2 | plus: row.n_3 | plus: row.n_4 -%}
{%- assign s1 = row.n_1 | times: 100.0 | divided_by: total | round -%}
{%- assign s2 = row.n_2 | times: 100.0 | divided_by: total | round -%}
{%- assign s3 = row.n_3 | times: 100.0 | divided_by: total | round -%}
{%- assign s4 = 100 | minus: s1 | minus: s2 | minus: s3 | at_least: 0 -%}
<li class="row">
<div>
<p class="row-k"><span class="n">{{ i }}</span>{{ q.label | escape }}</p>
<p class="row-q">{{ q.text | escape }}</p>
<p class="row-you"><i aria-hidden="true"></i><span>You:
{%- for opt in q.options %} <b hidden x-bind:hidden="a{{ i }} !== {{ forloop.index0 }}">{{ opt | escape }}</b>{% endfor %}</span></p>
</div>
<div>
<div class="dist" role="img" aria-label="How {{ total }} peers answered, weakest option on the left">
{%- for opt in q.options %}
{%- case forloop.index -%}{%- when 1 -%}{%- assign sk = s1 -%}{%- when 2 -%}{%- assign sk = s2 -%}{%- when 3 -%}{%- assign sk = s3 -%}{%- else -%}{%- assign sk = s4 -%}{%- endcase -%}
<span class="seg" style="width:{{ sk }}%" x-bind:class="a{{ i }} === {{ forloop.index0 }} ? 'seg is-you' : 'seg'">{% if sk >= 11 %}{{ sk }}%{% endif %}</span>
{%- endfor %}
</div>
<div class="dist-key"><span>{{ q.options | first | escape }}</span><span>{{ q.options | last | escape }}</span></div>
<p class="verdict"><b hidden x-bind:hidden="g{{ i }} !== 1">Ahead of most peers</b><b hidden x-bind:hidden="g{{ i }} !== 0">In line with peers</b><b hidden x-bind:hidden="g{{ i }} !== -1">Behind most peers</b><span>ahead of <span x-text="p{{ i }}">0</span>% of peers</span></p>
{%- if line %}
<p class="gap" hidden x-bind:hidden="g{{ i }} !== 1">{{ line.ahead | escape }}</p>
<p class="gap" hidden x-bind:hidden="g{{ i }} !== 0">{{ line.level | escape }}</p>
<p class="gap" hidden x-bind:hidden="g{{ i }} !== -1">{{ line.behind | escape }}</p>
{%- endif %}
</div>
</li>
{%- endfor %}
</ol>
<p class="method"><b>How this is counted.</b> The peers are {{ peer_total }} {{ industry | escape }} companies{% if peer_source != '' %} from {{ peer_source | escape }}{% endif %}, answering the same five questions. Each bar shows how they answered, weakest option on the left. The percentage under a bar counts the peers who picked a weaker option than you plus half of those who picked the same one. Ahead, in line and behind compare your pick with the median peer's. Nothing is weighted or adjusted.</p>
{%- else %}
<p class="eyebrow">Where {{ account.name | escape }} stands</p>
<h2>Your five answers, without a peer group yet</h2>
<p class="lede">We have no answers from {{ industry | escape }} companies yet, so this page shows {{ account.name | escape }}'s own picture: each scale runs from the weakest option on the left to the strongest on the right. {{ sender_first | escape }} will bring the closest peer group to the call.</p>
<ol class="rows">
{%- for q in data.questions %}
{%- assign i = forloop.index -%}
<li class="row">
<div>
<p class="row-k"><span class="n">{{ i }}</span>{{ q.label | escape }}</p>
<p class="row-q">{{ q.text | escape }}</p>
</div>
<div>
<ol class="scale" aria-label="Your answer on a scale from the weakest option to the strongest">
{%- for opt in q.options %}
<li x-bind:class="a{{ i }} === {{ forloop.index0 }} ? 'on' : ''"></li>
{%- endfor %}
</ol>
<div class="dist-key"><span>{{ q.options | first | escape }}</span><span>{{ q.options | last | escape }}</span></div>
<p class="row-you"><i aria-hidden="true"></i><span>You:
{%- for opt in q.options %} <b hidden x-bind:hidden="a{{ i }} !== {{ forloop.index0 }}">{{ opt | escape }}</b>{% endfor %}</span></p>
</div>
</li>
{%- endfor %}
</ol>
{%- endif %}
</section>
<section data-section="cta" class="cta">
<div class="cta-box">
<h2>Go through the five with {{ sender_first | escape }}</h2>
<p>Twenty minutes. {{ sender_first | escape }} walks through the five questions{% if has_peers %} with the peer answers behind each one, and what usually sits behind each gap{% else %} with the closest peer group to {{ account.name | escape }}{% endif %}.</p>
{% render 'ken/cta', label: 'Book 20 minutes', kind: 'booking' %}
<p class="sign">{{ sender_name | escape }}<span>{% if sender.title %}{{ sender.title | escape }}, {% endif %}{{ brand_name | escape }}</span></p>
</div>
</section>
<footer class="foot">Made for {% if person.first_name %}{{ person.first_name | escape }} {{ person.last_name | escape }} at {% endif %}{{ account.name | escape }} by {{ sender_name | escape }} at {{ brand_name | escape }}. Your answers stay in your browser and are not sent anywhere.</footer>
</div>
</main>
</body>
</html>
