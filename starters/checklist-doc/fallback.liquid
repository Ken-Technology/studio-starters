{%- assign accent = brand.colors.primary | default: '#def915' -%}
{%- assign accent2 = brand.colors.secondary | default: '#0a0a0a' -%}
{%- assign font_head = brand.fonts.heading | default: 'Stack Sans Headline' -%}
{%- assign body_default = 'Stack Sans Text' -%}
{%- if brand.fonts.heading -%}{%- assign body_default = font_head -%}{%- endif -%}
{%- assign font_body = brand.fonts.body | default: body_default -%}
{%- assign short_name = account.name | split: ' - ' | first | split: ' | ' | first | strip | default: account.name -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex">
<title>A checklist for {{ short_name | escape }}</title>
{%- if font_head == 'Stack Sans Headline' %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Stack+Sans+Headline:wght@300;500;600&display=swap">
{%- else %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_head | url_encode }}&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_head | url_encode }}:wght@700&display=swap">
{%- endif %}
{%- if font_body != font_head %}
{%- if font_body == 'Stack Sans Text' %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Stack+Sans+Text:wght@400;500&display=swap">
{%- else %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_body | url_encode }}&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_body | url_encode }}:wght@500&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_body | url_encode }}:wght@600&display=swap">
{%- endif %}
{%- endif %}
<style>
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
html,body{margin:0;background:#ff87ab}
.ck{--p:{{ accent }};--s:{{ accent2 }};--bg:#ff87ab;--ink:#0a0a0a;--mute:#6b1f3a;--hw:600;--tw:500;{% if font_head == 'Stack Sans Headline' %}--hw:300;--tw:300;{% endif %}--onp:#0a0a0a;--onp:oklch(from var(--p) clamp(0.2, (0.6 - l) * 100, 0.97) min(c, 0.03) h);--ons:#ff87ab;--ons:oklch(from var(--s) clamp(0.2, (0.6 - l) * 100, 0.93) min(c, 0.02) h);--fh:'{{ font_head }}',ui-sans-serif,system-ui,sans-serif;--fb:'{{ font_body }}',ui-sans-serif,system-ui,sans-serif;--m:clamp(1.25rem,3vw,3rem);min-height:100vh;background:var(--bg);color:var(--ink);font-family:var(--fb);font-size:1.125rem;line-height:1.5;-webkit-font-smoothing:antialiased}
.ck p{margin:0}
.ck h1,.ck h2{font-family:var(--fh);font-weight:var(--hw);margin:0;text-wrap:balance}
.wrap{max-width:86rem;margin:0 auto;padding:0 var(--m)}
.ck-top{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding-top:1.25rem;padding-bottom:1.25rem;font-size:.875rem}
.ck-logo{height:26px;width:auto;display:block}
.ck-wordmark{font-family:var(--fh);font-weight:600;font-size:1.125rem}
.ck-doc{color:var(--mute);text-align:right}
.ck-cover{padding-top:3.5rem;padding-bottom:4rem}
.ck h1{font-size:clamp(2.5rem,8vw,6rem);line-height:.96;letter-spacing:-.04em;max-width:14ch}
.box{display:inline-block;width:.8em;height:.8em;vertical-align:-.04em;border:.07em solid var(--ink);border-radius:.06em;background:var(--bg)}
.ck-intro{max-width:36rem;margin-top:2.5rem!important;font-size:1.25rem;line-height:1.45}
.ck-close{background:var(--s);color:var(--ons);padding-top:4rem;padding-bottom:4.5rem}
.ck-close h2{font-size:clamp(2rem,6vw,3.5rem);line-height:1;letter-spacing:-.035em;max-width:14ch}
.ck-closing{max-width:34rem;margin-top:1.25rem!important}
.ck-cta{margin:2rem 0}
.ck-cta .ken-cta{display:inline-block!important;min-height:56px;padding:17px 28px!important;border-radius:4px!important;background:var(--p)!important;color:var(--onp)!important;font-family:var(--fh);font-weight:600!important;font-size:1.125rem;line-height:22px}
.ck-cta .ken-cta:focus-visible{outline:3px solid var(--ons);outline-offset:3px}
.ck-sign{font-family:var(--fh)}
.ck-sign b{display:block;font-weight:600;font-size:1.25rem}
</style>
</head>
<body>
<main class="ck">
<header class="ck-top wrap">
{%- if brand.logo_url %}
<img class="ck-logo" src="{{ brand.logo_url | escape }}" alt="{{ brand.name | default: 'Logo' | escape }}">
{%- elsif brand.name %}
<p class="ck-wordmark">{{ brand.name | escape }}</p>
{%- else %}
<span></span>
{%- endif %}
<p class="ck-doc">Checklist for {{ short_name | escape }}</p>
</header>
<section data-section="cover" class="ck-cover wrap">
<h1><span class="box" role="img" aria-label="An empty tick box"></span> A checklist for {{ short_name | escape }}</h1>
<p class="ck-intro">Hi {{ person.first_name | default: 'there' | escape }}. {{ sender.name | default: 'Our team' | escape }} is putting together a short checklist for {{ short_name | escape }}: the checks worth doing before the next change to how your team works, each with a one-line why. It is not on this page yet.</p>
</section>
<section data-section="close" class="ck-close">
<div class="wrap">
<h2>Rather not wait?</h2>
<p class="ck-closing">If you would like it sooner, reply to my email and I will send the list as soon as it is ready.</p>
<div class="ck-cta">{% render 'ken/cta', label: 'Book 20 minutes', kind: 'booking' %}</div>
<p class="ck-sign"><b>{{ sender.name | default: 'Our team' | escape }}</b>{% if sender.title %}{{ sender.title | escape }}{% if brand.name %}, {{ brand.name | escape }}{% endif %}{% elsif brand.name %}{{ brand.name | escape }}{% endif %}</p>
</div>
</section>
</main>
</body>
</html>
