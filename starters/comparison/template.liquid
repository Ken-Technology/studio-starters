{%- assign accent = brand.colors.primary | default: '#007bab' -%}
{%- assign accent2 = brand.colors.secondary | default: '#121316' -%}
{%- assign font_head = brand.fonts.heading | default: 'Alfa Slab One' -%}
{%- assign font_body = brand.fonts.body | default: 'Golos Text' -%}
{%- assign us = brand.name | default: 'Us' -%}
{%- assign them = data.current_tool | default: '' -%}
{%- assign has_tool = false -%}
{%- if them != '' -%}{%- assign has_tool = true -%}{%- endif -%}
{%- assign has_rows = false -%}
{%- if data.rows.size > 0 -%}{%- assign has_rows = true -%}{%- endif -%}
{%- assign has_evidence = false -%}
{%- if data.evidence.size > 0 -%}{%- assign has_evidence = true -%}{%- endif -%}
{%- assign has_them_fit = false -%}
{%- if data.them_fit and data.them_fit != '' -%}{%- assign has_them_fit = true -%}{%- endif -%}
{%- assign has_us_fit = false -%}
{%- if data.us_fit and data.us_fit != '' -%}{%- assign has_us_fit = true -%}{%- endif -%}
{%- assign n_them = 0 -%}
{%- assign n_us = 0 -%}
{%- assign n_either = 0 -%}
{%- for r in data.rows -%}
{%- assign fit = r.better_fit | default: '' | downcase | strip -%}
{%- if fit == 'them' -%}{%- assign n_them = n_them | plus: 1 -%}{%- elsif fit == 'us' -%}{%- assign n_us = n_us | plus: 1 -%}{%- else -%}{%- assign n_either = n_either | plus: 1 -%}{%- endif -%}
{%- endfor -%}
{%- assign k = 0 -%}
{%- capture either_list -%}
{%- for r in data.rows -%}
{%- assign fit = r.better_fit | default: '' | downcase | strip -%}
{%- if fit != 'them' and fit != 'us' -%}
{%- assign k = k | plus: 1 -%}
{%- if k > 1 -%}, {% endif -%}{{ r.criterion | escape }}
{%- endif -%}
{%- endfor -%}
{%- endcapture -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex">
<title>{{ data.headline | escape }}</title>
{%- if font_head == 'Alfa Slab One' %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Alfa+Slab+One&display=swap">
{%- else %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_head | url_encode }}&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_head | url_encode }}:wght@700&display=swap">
{%- endif %}
{%- if font_body != font_head %}
{%- if font_body == 'Golos Text' %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Golos+Text:wght@400;600;800&display=swap">
{%- else %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_body | url_encode }}&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_body | url_encode }}:wght@700&display=swap">
{%- endif %}
{%- endif %}
<style>
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:#f2f2ef;color:#121316;font-family:'{{ font_body }}',ui-sans-serif,system-ui,sans-serif;font-size:17px;line-height:1.5;-webkit-font-smoothing:antialiased}
.vs{--a:{{ accent }};--a2:{{ accent2 }};--hw:{% if font_head == 'Alfa Slab One' %}400{% else %}700{% endif %};--ink:#121316;--soft:#4a4c52;--paper:#f2f2ef;--tone:#e3e3de;
--on-a:#fff;--on-a:oklch(from var(--a) clamp(0.2,(0.6 - l) * 1000,0.99) 0.01 h);
--on-a2:#f2f2ef;--on-a2:oklch(from var(--a2) clamp(0.2,(0.6 - l) * 1000,0.97) 0.01 h);
--mark:{{ accent }};--mark:oklch(from var(--a) min(l,0.5) c h);
--mark2:{{ accent2 }};--mark2:oklch(from var(--a2) min(l,0.45) c h);
--m:clamp(1.125rem,3vw,2.5rem);overflow-x:clip}
.vs h1,.vs h2,.vs h3,.c-name,.c-score b,.disc{font-family:'{{ font_head }}',Rockwell,Georgia,serif;font-weight:var(--hw);letter-spacing:-.005em;line-height:1.02;text-wrap:balance;margin:0}
.vs p{margin:0}
.vs ul,.vs ol{margin:0;padding:0;list-style:none}
.vs .ken-cta:focus-visible{outline:3px solid var(--ink);outline-offset:3px}
.wrap{padding:0 var(--m);max-width:90rem;margin:0 auto}
.top{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:1.1rem 0}
.logo{height:26px;width:auto;display:block}
.brand{font-weight:800;font-size:1rem}
.tag{font-size:.875rem;color:var(--soft)}
.hero-head{display:grid;gap:1.2rem;padding-top:.8rem;padding-bottom:2.2rem}
.hero h1{font-size:2rem}
.intro{font-size:1.125rem;max-width:38rem}
.by{font-size:1rem;color:var(--soft);margin-top:.9rem!important}
.by b{color:var(--ink);font-weight:600}
.bill{position:relative;display:grid}
.corner{position:relative;padding:2rem var(--m) 2.2rem;display:grid;grid-template-columns:minmax(0,1fr) auto;grid-template-areas:"name num" "lab num" "more more";column-gap:1.2rem;align-items:end}
.corner.t{background:var(--a2);color:var(--on-a2);padding-bottom:3.4rem}
.corner.u{background:var(--a);color:var(--on-a);padding-top:3.4rem}
.c-lab{grid-area:lab;font-size:1rem;font-weight:600;margin-top:.5rem!important}
.c-name{grid-area:name;font-size:2rem;overflow-wrap:anywhere}
.c-score{grid-area:num;text-align:center;line-height:1}
.c-score b{display:block;font-size:6rem;line-height:.85}
.c-score span{display:block;font-size:.875rem;font-weight:600;margin-top:.5rem!important}
.c-more{grid-area:more;margin-top:1.4rem;font-size:1rem;max-width:34rem}
.c-more li{padding:.55rem 0 .55rem 1.3rem;position:relative;border-top:2px solid currentColor}
.c-more li::before{content:'';position:absolute;left:0;top:1.05rem;width:.55rem;height:.55rem;background:currentColor}
.c-more p+p,.c-more ul+p{margin-top:.8rem!important;font-weight:600}
.disc{position:relative;z-index:2;justify-self:center;width:4.5rem;height:4.5rem;margin:-2.25rem 0;display:grid;place-items:center;border-radius:50%;background:var(--paper);color:var(--ink);font-size:1.5rem;border:5px solid var(--ink)}
.even{grid-area:more;font-size:1rem;font-weight:600;margin-top:1rem!important}
.tape{padding:4rem 0 3rem}
.vs h2{font-size:2rem;margin:0 0 .9rem}
.sub{font-size:1.125rem;max-width:40rem;color:var(--soft)}
.tape-head{display:none}
.rows{margin-top:2rem!important;border-top:6px solid var(--ink)}
.row{padding:1.4rem 0 1.6rem;border-bottom:2px solid var(--tone)}
.crit h3{font-size:1.5rem}
.crit small{display:block;font-size:1rem;color:var(--soft);margin-top:.4rem;line-height:1.4}
.call{font-size:1rem;font-weight:800;margin-top:.6rem!important}
.call.t{color:var(--mark2)}
.call.u{color:var(--mark)}
.call.e{color:var(--soft);font-weight:600}
.cell{margin-top:.9rem;padding:1rem 1.1rem;background:#fff;font-size:1rem}
.cell.t.win{background:var(--a2);color:var(--on-a2)}
.cell.u.win{background:var(--a);color:var(--on-a)}
.who{display:block;font-weight:800;margin-bottom:.25rem}
.tape-foot{font-size:1rem;color:var(--soft);margin-top:1.6rem!important;max-width:44rem}
.tape-wait{background:#fff;padding:1.6rem;margin-top:1.4rem}
.fit{padding:0 0 1rem}
.fit.is-empty{display:none}
.fit-head{padding-top:1rem;padding-bottom:2rem}
.fit-cols{display:grid}
.side{padding:2.4rem var(--m) 2.6rem}
.side.t{background:var(--a2);color:var(--on-a2)}
.side.u{background:var(--a);color:var(--on-a)}
.side h3{font-size:1.5rem;margin:0 0 1rem}
.side p{font-size:1.125rem;max-width:34rem}
.side p+ul{margin-top:1.4rem}
.chips{display:flex;flex-wrap:wrap;gap:.5rem}
.chips li{font-size:1rem;font-weight:600;border:2px solid currentColor;padding:.3rem .75rem}
.same{font-size:1.125rem;padding-top:1.6rem;padding-bottom:1rem}
.same b{font-weight:800}
.cta{padding:3rem 0 2.4rem}
.cta-in{border-top:6px solid var(--ink);padding-top:2.4rem;display:grid;gap:1.6rem}
.cta h2{font-size:2rem}
.cta p{font-size:1.125rem;max-width:36rem}
.btn{margin:1.6rem 0 1.4rem}
.hero .btn{margin:1.4rem 0 0}
.btn .ken-cta{display:inline-flex!important;align-items:center;min-height:56px;padding:.9rem 1.8rem!important;border-radius:0!important;background:var(--a)!important;color:var(--on-a)!important;font-family:inherit;font-size:1.125rem;font-weight:800!important;text-decoration:none}
.btn .ken-cta:hover{background:var(--ink)!important;color:var(--paper)!important}
.sign{font-size:1rem;font-weight:800}
.sign span{display:block;font-weight:400}
.foot{font-size:.875rem;color:var(--soft);padding:2.4rem 0 0;max-width:44rem}
@media (prefers-reduced-motion:no-preference){
.corner.t{animation:vs-in-l .7s cubic-bezier(.2,.8,.2,1) both}
.corner.u{animation:vs-in-r .7s cubic-bezier(.2,.8,.2,1) both}
.disc{animation:vs-disc .5s .45s cubic-bezier(.3,1.5,.5,1) both}
@keyframes vs-in-l{from{transform:translateX(-40px);opacity:0}}
@keyframes vs-in-r{from{transform:translateX(40px);opacity:0}}
@keyframes vs-disc{from{transform:scale(.3);opacity:0}}
}
@media (min-width:760px){
body{font-size:18px}
.hero-head{padding-top:1.4rem;padding-bottom:2.8rem}
.hero h1{font-size:3rem}
.bill{grid-template-columns:1fr 1fr}
.corner{padding:2.6rem 3.6rem 2.8rem var(--m);align-content:start;align-items:start;grid-template-rows:auto 1fr}
.corner.t{padding-bottom:2.8rem}
.corner.u{padding:2.6rem var(--m) 2.8rem 3.6rem;grid-template-columns:auto minmax(0,1fr);grid-template-areas:"num name" "num lab" "more more"}
.c-name{font-size:2rem}
.c-score b{font-size:6rem}
.disc{position:absolute;left:50%;top:6rem;width:6rem;height:6rem;margin:-3rem 0 0 -3rem;font-size:2rem}
.tape{padding:5.5rem 0 4rem}
.vs h2{font-size:2rem}
.tape-head{display:grid;grid-template-columns:minmax(0,1fr) 14rem minmax(0,1fr);gap:1.4rem;margin-top:2.4rem;align-items:end}
.tape-head span{font-family:'{{ font_head }}',Rockwell,Georgia,serif;font-weight:var(--hw);font-size:1.5rem;line-height:1.05}
.tape-head .t{text-align:right;color:var(--mark2)}
.tape-head .c{text-align:center;font-family:inherit;font-weight:600;font-size:1rem;color:var(--soft)}
.tape-head .u{color:var(--mark)}
.rows{margin-top:.8rem!important}
.row{display:grid;grid-template-columns:minmax(0,1fr) 14rem minmax(0,1fr);grid-template-areas:"t crit u";gap:1.4rem;padding:1.2rem 0;align-items:stretch}
.crit{grid-area:crit;text-align:center;align-self:center}
.cell{margin:0;padding:1.1rem 1.3rem}
.cell.t{grid-area:t;text-align:right}
.cell.u{grid-area:u}
.who{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
.fit-head{padding-top:2rem}
.fit-cols{grid-template-columns:1fr 1fr}
.side{padding:3.4rem var(--m) 3.6rem}
.side.u{padding-left:3.6rem}
.side.t{padding-right:3.6rem}
.side h3{font-size:1.5rem}
.cta{padding:5rem 0 2.6rem}
.cta-in{padding-top:3.2rem}
.cta h2{font-size:3rem}
.foot{grid-column:1 / -1}
}
@media (min-width:1100px){
.corner.t,.side.t{padding-left:max(var(--m),calc(50vw - 45rem + var(--m)))}
.corner.u,.side.u{padding-right:max(var(--m),calc(50vw - 45rem + var(--m)))}
.row,.tape-head{grid-template-columns:minmax(0,1fr) 17rem minmax(0,1fr);gap:2rem}
.hero-head>div{display:grid;grid-template-columns:minmax(0,7fr) minmax(0,5fr);column-gap:3.5rem;align-items:start}
.intro{grid-row:1 / 3}
.by{margin-top:.3rem!important}
.hero h1{font-size:4rem}
.c-name{font-size:3rem}
.c-score b{font-size:8rem}
.disc{top:7rem}
.vs h2,.cta h2{font-size:3rem}
.side h3{font-size:2rem}
.cta-in{grid-template-columns:minmax(0,7fr) minmax(0,5fr);column-gap:4rem;align-items:end}
}
</style>
</head>
<body>
<main class="vs">
<div class="wrap">
<header class="top">
{%- if brand.logo_url %}<img class="logo" src="{{ brand.logo_url | escape }}" alt="{{ brand.name | default: 'Logo' | escape }}">{% elsif brand.name %}<p class="brand">{{ brand.name | escape }}</p>{% else %}<span></span>{% endif -%}
<p class="tag">Side by side</p>
</header>
</div>
<section data-section="hero" class="hero">
<div class="wrap hero-head">
<h1>{{ data.headline | escape }}</h1>
<div>
<p class="intro">{{ data.intro | escape }}</p>
<p class="by">{% if person.first_name %}For <b>{{ person.first_name | escape }}</b> at <b>{{ account.name | escape }}</b>{% else %}For <b>{{ account.name | escape }}</b>{% endif %}, from {{ sender.name | default: 'our team' | escape }}{% if sender.title %}, {{ sender.title | escape }}{% endif %}{% if brand.name %} at {{ brand.name | escape }}{% endif %}</p>
<div class="btn">{% render 'ken/cta', label: 'Book 20 minutes', kind: 'booking', id: 'hero' %}</div>
</div>
</div>
<div class="bill">
<div class="corner t">
<p class="c-name">{% if has_tool %}{{ them | escape }}{% else %}Not worked out yet{% endif %}</p>
<p class="c-lab">{% if has_evidence %}What your site points to{% elsif has_tool %}Our best guess at what you use{% else %}What you use today{% endif %}</p>
{%- if has_rows %}
<p class="c-score"><b>{{ n_them }}</b><span>{% if n_them == 1 %}row goes to it{% else %}rows go to it{% endif %}</span></p>
{%- endif %}
<div class="c-more">
{%- if has_evidence %}
<ul>
{%- for e in data.evidence %}
<li>{{ e | escape }}</li>
{%- endfor %}
</ul>
{%- elsif has_tool %}
<p>Nothing on your site names the tool you use for this, so this page compares {{ us | escape }} with {{ them | escape }}.</p>
{%- else %}
<p>We have not worked out which tool {{ account.name | escape }} uses today.</p>
{%- endif %}
{%- if has_tool %}
<p>Wrong tool? Tell me and I will redo this page for the one you use.</p>
{%- endif %}
</div>
</div>
<span class="disc" aria-hidden="true">vs</span>
<div class="corner u">
<p class="c-name">{{ us | escape }}</p>
<p class="c-lab">What we offer</p>
{%- if has_rows %}
<p class="c-score"><b>{{ n_us }}</b><span>{% if n_us == 1 %}row goes to it{% else %}rows go to it{% endif %}</span></p>
{%- if n_either > 0 %}
<p class="even">{{ n_either }} {% if n_either == 1 %}row is{% else %}rows are{% endif %} about the same either way.</p>
{%- endif %}
{%- endif %}
</div>
</div>
</section>
<section data-section="comparison" class="tape">
<div class="wrap">
{%- if has_rows %}
<h2>{{ them | escape }} next to {{ us | escape }}, row by row</h2>
<p class="sub">Both columns are our own notes, written to be fair to both. The filled cell is the better fit on that row, in our view.</p>
<div class="tape-head" aria-hidden="true"><span class="t">{{ them | escape }}</span><span class="c">The row</span><span class="u">{{ us | escape }}</span></div>
<ol class="rows">
{%- for r in data.rows %}
{%- assign fit = r.better_fit | default: '' | downcase | strip %}
<li class="row">
<div class="crit"><h3>{{ r.criterion | escape }}</h3>{% if r.note and r.note != '' %}<small>{{ r.note | escape }}</small>{% endif %}<p class="call{% if fit == 'them' %} t">Better fit: {{ them | escape }}{% elsif fit == 'us' %} u">Better fit: {{ us | escape }}{% else %} e">About the same{% endif %}</p></div>
<div class="cell t{% if fit == 'them' %} win{% endif %}"><span class="who">{{ them | escape }}</span><p>{{ r.them | escape }}</p></div>
<div class="cell u{% if fit == 'us' %} win{% endif %}"><span class="who">{{ us | escape }}</span><p>{{ r.us | escape }}</p></div>
</li>
{%- endfor %}
</ol>
<p class="tape-foot">A row marked about the same is close either way. Where a row says nothing about your setup, ask and I will fill it in.</p>
{%- else %}
<h2>The side by side is not on this page yet</h2>
<p class="tape-wait">{% if has_tool %}Our notes on {{ them | escape }} are not loaded yet. {% endif %}This link stays the same, so check back later. If you would rather go through it now, book a time below and I will walk you through it.</p>
{%- endif %}
</div>
</section>
<section data-section="fit" class="fit{% unless has_rows %} is-empty{% endunless %}">
{%- if has_rows %}
<div class="wrap fit-head">
<h2>Where each one is the better fit</h2>
<p class="sub">The honest split, from the rows above.</p>
</div>
<div class="fit-cols">
<div class="side t">
<h3>Where {{ them | escape }} is the better fit</h3>
{%- if n_them > 0 %}
{%- if has_them_fit %}
<p>{{ data.them_fit | escape }}</p>
{%- endif %}
<ul class="chips">
{%- for r in data.rows %}
{%- assign fit = r.better_fit | default: '' | downcase | strip %}
{%- if fit == 'them' %}<li>{{ r.criterion | escape }}</li>{% endif %}
{%- endfor %}
</ul>
{%- else %}
<p>No row in our notes goes to {{ them | escape }}. That is our view, so weigh it as one.</p>
{%- endif %}
</div>
<div class="side u">
<h3>Where {{ us | escape }} is the better fit</h3>
{%- if n_us > 0 %}
{%- if has_us_fit %}
<p>{{ data.us_fit | escape }}</p>
{%- endif %}
<ul class="chips">
{%- for r in data.rows %}
{%- assign fit = r.better_fit | default: '' | downcase | strip %}
{%- if fit == 'us' %}<li>{{ r.criterion | escape }}</li>{% endif %}
{%- endfor %}
</ul>
{%- else %}
<p>No row in our notes goes to {{ us | escape }} on its own.</p>
{%- endif %}
</div>
</div>
{%- if n_either > 0 %}
<p class="wrap same"><b>About the same either way:</b> {{ either_list }}.</p>
{%- endif %}
{%- endif %}
</section>
<section data-section="cta" class="cta">
<div class="wrap">
<div class="cta-in">
<div>
<h2>Want it checked for your setup?</h2>
</div>
<div>
<p>Book 20 minutes. Tell me what {{ account.name | escape }} runs on today and I will go through the rows that do not hold for you, as well as the ones that do.</p>
<div class="btn">{% render 'ken/cta', label: 'Book 20 minutes', kind: 'booking' %}</div>
<p class="sign">{{ sender.name | default: 'Our team' | escape }}{% if sender.title %}<span>{{ sender.title | escape }}{% if brand.name %}, {{ brand.name | escape }}{% endif %}</span>{% elsif brand.name %}<span>{{ brand.name | escape }}</span>{% endif %}</p>
</div>
<p class="foot">Written for {{ account.name | escape }} by {{ sender.name | default: 'our team' | escape }}. Both columns come from our own comparison notes, so they carry our view.</p>
</div>
</div>
</section>
</main>
</body>
</html>
