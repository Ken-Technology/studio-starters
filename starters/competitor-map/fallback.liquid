{%- assign accent = brand.colors.primary | default: '#0f6f6c' -%}
{%- assign accent2 = brand.colors.secondary | default: '#e6c46b' -%}
{%- assign font_head = brand.fonts.heading | default: 'Barlow Semi Condensed' -%}
{%- assign font_body = brand.fonts.body | default: 'Barlow' -%}
{%- assign head_q = font_head | replace: ' ', '+' -%}
{%- assign body_q = font_body | replace: ' ', '+' -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex">
<title>A competitive map for {{ account.name | escape }}</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ head_q }}:wght@400;600;700&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ body_q }}:wght@400;500;600;700&display=swap">
<style>
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:#f5f6f3;color:#1c1c1c;font-family:'{{ font_body }}',ui-sans-serif,system-ui,sans-serif;font-size:17px;line-height:1.55;-webkit-font-smoothing:antialiased}
.cm{--a:{{ accent }};--a2:{{ accent2 }};--ink:#1c1c1c;--text:#2e302f;--mute:#6b706e;--line:#d7dad6;--mid:#c3c8c2;--grid:#e6e9e5;--paper:#f5f6f3;--white:#fff}
.cm h1,.cm h2{font-family:'{{ font_head }}',ui-sans-serif,system-ui,sans-serif;font-weight:600;letter-spacing:-.01em;line-height:1.05;text-wrap:balance;margin:0}
p{margin:0}
.cm a:focus-visible{outline:3px solid var(--a);outline-offset:3px}
.wrap{max-width:68rem;margin:0 auto;padding:0 1.25rem}
.top{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:1rem 0;border-bottom:1px solid var(--ink)}
.logo{height:26px;width:auto;display:block}
.brand{font-weight:700;font-size:1rem}
.tag{font-size:.9rem;color:var(--mute)}
.hero{padding:2.2rem 0 2rem}
.kicker{font-size:.95rem;font-weight:600;color:var(--a);margin:0 0 .9rem}
.hero h1{font-size:2.35rem}
.intro{font-size:1.08rem;line-height:1.5;color:var(--text);margin:1.1rem 0 0;max-width:36rem}
.sketch{position:relative;aspect-ratio:1/1;max-width:22rem;margin:1.8rem 0 0;background-color:var(--white);background-image:linear-gradient(to right,var(--grid) 1px,transparent 1px),linear-gradient(to bottom,var(--grid) 1px,transparent 1px);background-size:10% 10%;border:1.5px solid var(--ink)}
.sketch::before,.sketch::after{content:"";position:absolute;background:var(--mid)}
.sketch::before{left:50%;top:0;bottom:0;width:1px}
.sketch::after{top:50%;left:0;right:0;height:1px}
.sketch-open{position:absolute;left:66%;top:30%;width:27%;aspect-ratio:1/1;transform:translate(-50%,-50%);border:2px dashed var(--a);border-radius:50%;background:color-mix(in srgb,var(--a2) 24%,transparent)}
.sketch-you{position:absolute;left:36%;top:58%;width:32px;height:32px;transform:translate(-50%,-50%);border-radius:5px;background:var(--a);color:#fff;font-weight:600;font-size:.9rem;display:grid;place-items:center}
.sketch-note{position:absolute;left:.6rem;bottom:.5rem;font-size:.78rem;color:var(--mute);font-weight:500}
.cta{padding:2rem 0 3rem}
.cta-in{border-top:2px solid var(--ink);padding-top:1.5rem}
.cta h2{font-size:1.65rem;margin:0 0 .7rem}
.cta p{color:var(--text)}
.btn{margin:1.2rem 0 1.2rem}
.sign{font-size:.95rem}
.sign span{display:block;color:var(--mute)}
@media (min-width:760px){
body{font-size:18px}
.wrap{padding:0 2rem}
.hero{display:grid;grid-template-columns:7fr 5fr;gap:3.5rem;align-items:center;padding:3.4rem 0 2.6rem}
.hero h1{font-size:3.5rem}
.sketch{margin:0;max-width:none}
.cta-in{display:grid;grid-template-columns:1fr 1fr;gap:3.5rem;padding-top:2rem}
.cta h2{font-size:2rem}
.btn{margin:.4rem 0 1.2rem}
}
</style>
</head>
<body>
<main class="cm">
<div class="wrap">
<header class="top">
{%- if brand.logo_url %}<img class="logo" src="{{ brand.logo_url | escape }}" alt="{{ brand.name | default: 'Logo' | escape }}">{% elsif brand.name %}<p class="brand">{{ brand.name | escape }}</p>{% else %}<span></span>{% endif -%}
<p class="tag">Competitive map</p>
</header>
<section data-section="hero" class="hero">
<div>
<p class="kicker">{% if person.first_name %}For {{ person.first_name | escape }} at {{ account.name | escape }}{% else %}For {{ account.name | escape }}{% endif %}</p>
<h1>A map of the companies that sell what {{ account.name | escape }} sells</h1>
<p class="intro">Hi {{ person.first_name | default: 'there' | escape }}, I'm placing {{ account.name | escape }} and about six of its competitors on one map: two axes, one line on how each company sells, and the space on the map nobody has taken yet.</p>
<p class="intro">The map is not on this page yet. The link stays the same, so check back later today.</p>
</div>
<div class="sketch" aria-hidden="true">
<div class="sketch-open"></div>
<div class="sketch-you">{{ account.name | slice: 0, 1 | upcase | escape }}</div>
<p class="sketch-note">Being drawn</p>
</div>
</section>
<section data-section="cta" class="cta">
<div class="cta-in">
<div>
<h2>Rather walk through it now?</h2>
<p>Book 20 minutes and I will draw the map with you on the call: who {{ account.name | escape }} loses deals to, and where the open space is.</p>
</div>
<div>
<div class="btn">{% render 'ken/cta', label: 'Book 20 minutes', kind: 'booking' %}</div>
<p class="sign">{{ sender.name | default: 'Our team' | escape }}{% if sender.title %}<span>{{ sender.title | escape }}{% if brand.name %}, {{ brand.name | escape }}{% endif %}</span>{% elsif brand.name %}<span>{{ brand.name | escape }}</span>{% endif %}</p>
</div>
</div>
</section>
</div>
</main>
</body>
</html>
