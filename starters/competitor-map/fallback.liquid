{%- assign accent = brand.colors.primary | default: '#a54474' -%}
{%- assign accent2 = brand.colors.secondary | default: '#e9c57d' -%}
{%- assign font_head = brand.fonts.heading | default: 'Overpass' -%}
{%- assign font_body = brand.fonts.body | default: 'Overpass' -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex">
<title>A competitive map for {{ account.name | escape }}</title>
{%- if font_head == 'Overpass' %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Overpass:wght@400;600;800&display=swap">
{%- else %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_head | url_encode }}&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_head | url_encode }}:wght@700&display=swap">
{%- endif %}
{%- if font_body != font_head %}
{%- if font_body == 'Overpass' %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Overpass:wght@400;600;800&display=swap">
{%- else %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_body | url_encode }}&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_body | url_encode }}:wght@700&display=swap">
{%- endif %}
{%- endif %}
<style>
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:#fff;color:#1d1d1b;font-family:'{{ font_body }}',ui-sans-serif,system-ui,sans-serif;font-size:17px;line-height:1.5;-webkit-font-smoothing:antialiased}
.cm{--a:{{ accent }};--a2:{{ accent2 }};--ink:#1d1d1b;--soft:#4b4f48;--paper:#fff;--grass:#e2efd5;--wood:#cfe5b8;
--mark:{{ accent }};--mark:oklch(from var(--a) min(l,0.48) c h);
--on-a:#fff;--on-a:color(from var(--a) xyz-d65 clamp(0,(.18 - y) * 1000000,.9505) clamp(0,(.18 - y) * 1000000,1) clamp(0,(.18 - y) * 1000000,1.089));
--on-a2:#1d1d1b;--on-a2:color(from var(--a2) xyz-d65 clamp(0,(.18 - y) * 1000000,.9505) clamp(0,(.18 - y) * 1000000,1) clamp(0,(.18 - y) * 1000000,1.089));
--m:clamp(1.125rem,3vw,2.5rem);overflow-x:clip}
.cm h1,.cm h2{font-family:'{{ font_head }}',ui-sans-serif,system-ui,sans-serif;font-weight:800;letter-spacing:-.02em;line-height:1.02;text-wrap:balance;margin:0}
.cm p{margin:0}
.cm .ken-cta:focus-visible{outline:3px solid var(--paper);outline-offset:3px}
.wrap{padding:0 var(--m);max-width:90rem;margin:0 auto}
.top{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:1.1rem 0}
.logo{height:26px;width:auto;display:block}
.brand{font-weight:800;font-size:1rem}
.tag{font-size:.875rem;color:var(--soft)}
.hero{background:var(--grass);padding-bottom:3rem}
.hero-in{display:grid;gap:2rem}
.hero h1{font-size:1.85rem;margin:.6rem 0 1.2rem}
.intro{font-size:1.125rem;max-width:36rem}
.intro+.intro{margin-top:1rem!important}
.for{font-size:1rem;color:var(--soft);margin:1.4rem 0 0!important}
.for b{color:var(--ink);font-weight:600}
.sheet{background:var(--paper);padding:.7rem;transform:rotate(-1.2deg);max-width:24rem}
.terrain{position:relative;aspect-ratio:1/1;display:grid;grid-template-columns:1fr 1fr;grid-template-rows:1fr 1fr}
.terrain>i{display:block}
.terrain>i:nth-child(1),.terrain>i:nth-child(4){background:#f6f9f1}
.terrain>i:nth-child(2),.terrain>i:nth-child(3){background:var(--wood)}
.land{position:absolute;left:68%;top:30%;width:34%;aspect-ratio:1/1;transform:translate(-50%,-50%);background:var(--a2);border-radius:44% 56% 52% 48% / 52% 40% 60% 48%}
.marks{position:absolute;inset:0;width:100%;height:100%}
.marks *{fill:none;stroke:var(--mark);stroke-width:.85}
.marks .course{stroke-dasharray:2 2}
.wait{position:absolute;left:.5rem;bottom:.4rem;font-size:.875rem;font-weight:600;color:var(--soft)}
.cta{background:var(--ink);color:var(--paper);padding:4rem 0 3rem}
.cta-in{display:grid;gap:1.4rem}
.cta h2{font-size:1.85rem;margin:0 0 1rem}
.cta p{font-size:1.125rem;max-width:34rem}
.btn{margin:.4rem 0 1.2rem}
.btn .ken-cta{display:inline-flex!important;align-items:center;min-height:52px;padding:.85rem 1.6rem!important;border-radius:999px!important;background:var(--a)!important;color:var(--on-a)!important;font-family:inherit;font-size:1rem;font-weight:600!important;text-decoration:none}
.btn .ken-cta:hover{background:var(--paper)!important;color:var(--ink)!important}
.sign{font-size:1rem;font-weight:600}
.sign span{display:block;font-weight:400}
@media (min-width:760px){
body{font-size:18px}
.hero{padding-bottom:5rem}
.hero-in{grid-template-columns:minmax(0,7fr) minmax(0,5fr);column-gap:3.5rem;align-items:center}
.hero h1{font-size:clamp(2.4rem,.4rem + 3.3vw,3.6rem);margin:1.2rem 0 1.6rem}
.sheet{max-width:none;padding:1rem}
.cta{padding:6rem 0 4rem}
.cta-in{grid-template-columns:minmax(0,7fr) minmax(0,5fr);column-gap:4rem;align-items:end}
.cta h2{font-size:clamp(2.4rem,1.3rem + 2vw,3.4rem)}
}
@media (prefers-reduced-motion:no-preference){
.sheet{animation:cm-lay 1s cubic-bezier(.2,.7,.2,1) both}
@keyframes cm-lay{from{transform:translateY(24px) rotate(-5deg);opacity:0}}
}
</style>
</head>
<body>
<main class="cm">
<section data-section="hero" class="hero">
<div class="wrap">
<header class="top">
{%- if brand.logo_url %}<img class="logo" src="{{ brand.logo_url | escape }}" alt="{{ brand.name | default: 'Logo' | escape }}">{% elsif brand.name %}<p class="brand">{{ brand.name | escape }}</p>{% else %}<span></span>{% endif -%}
<p class="tag">Competitive map</p>
</header>
<div class="hero-in">
<div>
<h1>A map of the companies that sell what {{ account.name | escape }} sells</h1>
<p class="intro">Hi {{ person.first_name | default: 'there' | escape }}, I am placing {{ account.name | escape }} and about six of its competitors on one map: two axes, one line on how each company sells, and the space on the map nobody has taken yet.</p>
<p class="intro">The map is not on this page yet. The link stays the same, so check back later today.</p>
<p class="for">{% if person.first_name %}For <b>{{ person.first_name | escape }}</b> at <b>{{ account.name | escape }}</b>{% else %}For <b>{{ account.name | escape }}</b>{% endif %}</p>
</div>
<div class="sheet" aria-hidden="true">
<div class="terrain">
<i></i><i></i><i></i><i></i>
<span class="land"></span>
<svg class="marks" viewBox="0 0 100 100" focusable="false">
<path class="course" d="M36 58L68 30"/>
<circle cx="68" cy="30" r="2.6"/><circle cx="68" cy="30" r="4"/>
<path d="M36 52.5L41 61H31Z"/>
</svg>
<p class="wait">Being drawn</p>
</div>
</div>
</div>
</div>
</section>
<section data-section="cta" class="cta">
<div class="wrap cta-in">
<div>
<h2>Rather walk through it now?</h2>
<p>Book 20 minutes and I will draw the map with you on the call: who {{ account.name | escape }} loses deals to, and where the open space is.</p>
</div>
<div>
<div class="btn">{% render 'ken/cta', label: 'Book 20 minutes', kind: 'booking' %}</div>
<p class="sign">{{ sender.name | default: 'Our team' | escape }}{% if sender.title %}<span>{{ sender.title | escape }}{% if brand.name %}, {{ brand.name | escape }}{% endif %}</span>{% elsif brand.name %}<span>{{ brand.name | escape }}</span>{% endif %}</p>
</div>
</div>
</section>
</main>
</body>
</html>
