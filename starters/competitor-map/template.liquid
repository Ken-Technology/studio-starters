{%- assign accent = brand.colors.primary | default: '#c2007a' -%}
{%- assign accent2 = brand.colors.secondary | default: '#f9b233' -%}
{%- assign font_head = brand.fonts.heading | default: 'Overpass' -%}
{%- assign font_body = brand.fonts.body | default: 'Overpass' -%}
{%- assign has_map = false -%}
{%- if data.axes.x.name and data.competitors.size > 0 -%}{%- assign has_map = true -%}{%- endif -%}
{%- assign has_you = false -%}
{%- if data.account_position.line and data.account_position.line != '' -%}{%- assign has_you = true -%}{%- endif -%}
{%- assign has_open = false -%}
{%- if data.open_space.title and data.open_space.title != '' -%}{%- assign has_open = true -%}{%- endif -%}
{%- assign n_comp = data.competitors | size -%}
{%- assign m0 = data.market[0].value -%}
{%- assign m1 = data.market[1].value -%}
{%- capture m0_text -%}{%- if m0 >= 1000000 -%}{%- assign g1 = m0 | divided_by: 1000000 | floor -%}{%- assign g2 = m0 | modulo: 1000000 | divided_by: 1000 | floor -%}{%- assign g3 = m0 | modulo: 1000 -%}{{ g1 }},{% if g2 < 10 %}00{% elsif g2 < 100 %}0{% endif %}{{ g2 }},{% if g3 < 10 %}00{% elsif g3 < 100 %}0{% endif %}{{ g3 }}{%- elsif m0 >= 1000 -%}{%- assign g2 = m0 | divided_by: 1000 | floor -%}{%- assign g3 = m0 | modulo: 1000 -%}{{ g2 }},{% if g3 < 10 %}00{% elsif g3 < 100 %}0{% endif %}{{ g3 }}{%- else -%}{{ m0 }}{%- endif -%}{%- endcapture -%}
{%- capture m1_text -%}{%- if m1 >= 1000000 -%}{%- assign h1 = m1 | divided_by: 1000000 | floor -%}{%- assign h2 = m1 | modulo: 1000000 | divided_by: 1000 | floor -%}{%- assign h3 = m1 | modulo: 1000 -%}{{ h1 }},{% if h2 < 10 %}00{% elsif h2 < 100 %}0{% endif %}{{ h2 }},{% if h3 < 10 %}00{% elsif h3 < 100 %}0{% endif %}{{ h3 }}{%- elsif m1 >= 1000 -%}{%- assign h2 = m1 | divided_by: 1000 | floor -%}{%- assign h3 = m1 | modulo: 1000 -%}{{ h2 }},{% if h3 < 10 %}00{% elsif h3 < 100 %}0{% endif %}{{ h3 }}{%- else -%}{{ m1 }}{%- endif -%}{%- endcapture -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex">
<title>{{ data.headline | escape }}</title>
{%- if font_head == 'Overpass' %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Overpass:wght@400;600;800&display=swap">
{%- else %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_head | url_encode }}&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_head | url_encode }}:wght@700&display=swap">
{%- endif %}
{%- if font_body != font_head %}
{%- if font_body == 'Overpass' %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Overpass:wght@400;600;800&display=swap">
{%- else %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_body | url_encode }}&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_body | url_encode }}:wght@700&display=swap">
{%- endif %}
{%- endif %}
<style>
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:#fff;color:#1d1d1b;font-family:'{{ font_body }}',ui-sans-serif,system-ui,sans-serif;font-size:17px;line-height:1.5;-webkit-font-smoothing:antialiased}
.cm{--a:{{ accent }};--a2:{{ accent2 }};--ink:#1d1d1b;--soft:#4b4f48;--paper:#fff;--grass:#e2efd5;--wood:#cfe5b8;
--mark:{{ accent }};--mark:oklch(from var(--a) min(l,0.48) c h);
--on-a:#fff;--on-a:color(from var(--a) xyz-d65 clamp(0,(.18 - y) * 1000000,.9505) clamp(0,(.18 - y) * 1000000,1) clamp(0,(.18 - y) * 1000000,1.089));
--on-a2:#1d1d1b;--on-a2:color(from var(--a2) xyz-d65 clamp(0,(.18 - y) * 1000000,.9505) clamp(0,(.18 - y) * 1000000,1) clamp(0,(.18 - y) * 1000000,1.089));
--m:clamp(1.125rem,3vw,2.5rem);overflow-x:clip}
.cm h1,.cm h2,.cm-fig{font-family:'{{ font_head }}',ui-sans-serif,system-ui,sans-serif;font-weight:800;letter-spacing:-.02em;line-height:1.02;text-wrap:balance;margin:0}
.cm p{margin:0}
.cm a{color:inherit;text-decoration-thickness:.07em;text-underline-offset:.18em}
.cm a:focus-visible,.cm .ken-cta:focus-visible{outline:3px solid var(--ink);outline-offset:3px}
.cm ::selection{background:var(--a2);color:var(--on-a2)}
.wrap{padding:0 var(--m);max-width:90rem;margin:0 auto}
.cm-first{background:var(--grass);padding-bottom:3rem}
.top{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:1.1rem 0}
.logo{height:26px;width:auto;display:block}
.brand{font-weight:800;font-size:1rem}
.tag{font-size:.875rem;color:var(--soft)}
.cm-grid{display:grid;grid-template-columns:minmax(0,1fr);grid-template-rows:auto auto auto auto}
.hero{display:grid;grid-column:1;grid-row:1 / 5;grid-template-rows:subgrid}
.hero h1{grid-row:1}
.hero-text{display:contents}
.go{grid-row:3}
.ht-body{grid-row:4;padding:2.4rem 0 1rem}
.map{grid-column:1;grid-row:2;padding:1.6rem 0 2rem}
.hero h1{font-size:1.85rem;margin:.6rem 0 0}
.intro{font-size:1.125rem;max-width:36rem}
.for{font-size:1rem;color:var(--soft);margin:1.6rem 0 0!important}
.for b{color:var(--ink);font-weight:600}
.facts{list-style:none;margin:1.8rem 0 0;padding:0;display:grid;grid-template-columns:auto 1fr;gap:1rem .9rem;align-items:baseline}
.facts li{display:contents}
.facts .cm-fig{font-size:1.85rem;font-variant-numeric:tabular-nums;line-height:1;text-align:right}
.facts span{font-size:1rem;line-height:1.35}
.go{margin:0}
.go .ken-cta,.btn .ken-cta{display:inline-flex!important;align-items:center;min-height:52px;padding:.85rem 1.6rem!important;border-radius:999px!important;background:var(--a)!important;color:var(--on-a)!important;font-family:inherit;font-size:1rem;font-weight:600!important;text-decoration:none}
.go .ken-cta:hover,.btn .ken-cta:hover{background:var(--ink)!important;color:var(--paper)!important}
.map-h{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
.sheet{background:var(--paper);padding:.7rem .7rem 2.6rem 2.1rem;position:relative;transform:rotate(-1.2deg);margin:0 -.2rem}
.terrain{position:relative;aspect-ratio:1/1;container-type:inline-size;display:grid;grid-template-columns:1fr 1fr;grid-template-rows:1fr 1fr}
.terrain>i{display:block}
.terrain>i:nth-child(1),.terrain>i:nth-child(4){background:#f6f9f1}
.terrain>i:nth-child(2),.terrain>i:nth-child(3){background:var(--wood)}
.land{position:absolute;width:34%;aspect-ratio:1/1;transform:translate(-50%,-50%);background:var(--a2);border-radius:44% 56% 52% 48% / 52% 40% 60% 48%}
.land span{position:absolute;left:50%;top:22%;transform:translate(-50%,-50%);font-size:.875rem;font-weight:800;line-height:1.1;color:var(--on-a2);text-align:center;white-space:nowrap}
.marks{position:absolute;inset:0;width:100%;height:100%;overflow:visible}
.marks *{fill:none;stroke:var(--mark);stroke-width:.85}
.marks .course{stroke-width:.7}
{%- if brand.colors.secondary %}
.marks .fx{stroke:var(--on-a2)}
{%- endif %}
.pin{position:absolute;width:0;height:0}
.pin b{position:absolute;left:calc(2.5cqw + 2px);top:calc(-2.5cqw - 1rem);font-size:1rem;font-weight:800;color:var(--mark);line-height:1;white-space:nowrap}
.pin span{display:none;position:absolute;left:0;top:calc(3.4cqw + 4px);transform:translateX(-50%);font-size:.875rem;font-weight:600;line-height:1.15;white-space:nowrap;color:var(--ink)}
.pin b,.pin span{background:var(--paper);padding:.12em .3em}
.pin.is-left span{transform:none;left:-8px}
.pin.is-right span{transform:none;left:auto;right:-8px}
.pin.is-low span{top:auto;bottom:calc(3.4cqw + 4px)}
.pin.you span{display:block;font-weight:800;color:var(--mark);top:calc(3cqw + 6px)}
.pin.you.is-low span{top:auto;bottom:calc(4.4cqw + 6px)}
.ax-y{position:absolute;left:0;top:.7rem;bottom:2.6rem;width:2.1rem;display:flex;align-items:center;justify-content:center}
.ax-y b{writing-mode:vertical-rl;transform:rotate(180deg);font-size:.875rem;font-weight:800;white-space:nowrap}
.ax-x{position:absolute;left:2.1rem;right:.7rem;bottom:0;height:2.6rem;display:flex;align-items:center;justify-content:space-between;gap:.5rem;font-size:.875rem;color:var(--soft)}
.ax-x b{color:var(--ink);font-weight:800}
.end{position:absolute;left:.45rem;font-size:.875rem;line-height:1.15;color:var(--soft);max-width:44%}
.end.t{top:.4rem}.end.b{bottom:.4rem}
.map-note{font-size:1rem;line-height:1.45;margin:1.5rem 0 0!important;max-width:34rem}
.map-wait{font-size:1.125rem;max-width:34rem;background:var(--paper);padding:1.4rem}
.key{padding:4rem 0 1rem}
.key h2,.cta h2{font-size:1.85rem;margin:0 0 1.4rem}
.key table{width:100%;border-collapse:collapse}
.key th{text-align:left;font-size:.875rem;font-weight:600;color:var(--soft);padding:0 .8rem .6rem 0}
.key td{vertical-align:top;padding:.95rem .8rem .95rem 0;border-top:2px solid var(--wood)}
.key td.sym{width:3.2rem}
.key .ring{display:grid;place-items:center;width:2.2rem;height:2.2rem;border:3px solid var(--mark);border-radius:50%;color:var(--mark);font-weight:800;font-size:1rem}
.key .tri{display:block;width:2.2rem;height:2rem}
.key .tri path{fill:none;stroke:var(--mark);stroke-width:3}
.key b{display:block;font-weight:800;font-size:1.125rem;line-height:1.25}
.key small{display:block;font-size:.875rem;color:var(--soft)}
.key .line{font-size:1rem;line-height:1.45;margin-top:.35rem}
.key tr.you td{background:var(--grass)}
@media (max-width:759px){
.key thead{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
.key tr{display:grid;grid-template-columns:3.2rem minmax(0,1fr);border-top:2px solid var(--wood);padding:.95rem 0}
.key td{border:0;padding:0}
.key td:last-child{grid-column:2}
.key tr.you{background:var(--grass);padding-left:.6rem;padding-right:.6rem}
.key tr.you td{background:none}
.key tr.you td:first-child{padding-left:0}
}
.key tr.you td:first-child{padding-left:.6rem}
.open-space{background:var(--a2);color:var(--on-a2);padding:4rem 0;margin-top:3rem}
.open-space .wrap{display:grid;gap:1.6rem}
.open-space h2{font-size:2rem;line-height:1}
.fin{display:block;width:3.6rem;height:3.6rem;margin:0 0 1.4rem}
.fin circle{fill:none;stroke:currentColor;stroke-width:5}
.why{font-size:1.25rem;line-height:1.45;max-width:36rem}
.open-wait{font-size:1.125rem;max-width:36rem}
.cta{background:var(--ink);color:var(--paper);padding:4rem 0 2rem}
.cta .wrap{display:grid;gap:1.4rem}
.cta h2{margin:0 0 1rem}
.cta p{font-size:1.125rem;max-width:34rem}
.btn{margin:.4rem 0 1.2rem}
.btn .ken-cta:hover{background:var(--paper)!important;color:var(--ink)!important}
.sign{font-size:1rem;font-weight:600}
.sign span{display:block;font-weight:400}
.foot{font-size:.875rem;line-height:1.45;opacity:.8;padding:2.4rem 0 0;max-width:46rem}
.vh{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
@media (prefers-reduced-motion:no-preference){
.sheet{animation:cm-lay 1s cubic-bezier(.2,.7,.2,1) both}
.marks .course{stroke-dasharray:100;animation:cm-route 1.2s .7s cubic-bezier(.4,0,.2,1) both}
@keyframes cm-lay{from{transform:translateY(24px) rotate(-5deg);opacity:0}}
@keyframes cm-route{from{stroke-dashoffset:100}}
}
@media (min-width:760px){
body{font-size:18px}
.hero h1{font-size:2rem;max-width:46ch}
.facts .cm-fig{font-size:2.4rem}
.sheet{padding:1rem 1rem 3rem 2.6rem}
.ax-y{width:2.6rem;top:1rem;bottom:3rem}
.ax-x{left:2.6rem;right:1rem;height:3rem}
.pin span{display:block}
.land span{top:76%}
.key{padding:5.5rem 0 1.5rem}
.key h2,.cta h2{font-size:clamp(2.4rem,1.3rem + 2vw,3.4rem)}
.open-space{padding:6rem 0;margin-top:3.5rem}
.open-space h2{font-size:clamp(2.2rem,.6rem + 2.4vw,3.4rem)}
.fin{width:5rem;height:5rem}
.cta{padding:6rem 0 2.4rem}
.cta .wrap{grid-template-columns:minmax(0,7fr) minmax(0,5fr);column-gap:4rem;align-items:end}
.foot{grid-column:1 / -1}
}
@media (min-width:1000px){
.cm-first{padding-bottom:0}
.cm-grid{grid-template-columns:minmax(0,5fr) minmax(0,7fr);column-gap:3.5rem;grid-template-rows:auto auto}
.hero{grid-column:1 / -1;grid-row:1 / 3;grid-template-columns:subgrid;grid-template-rows:subgrid}
.hero h1{grid-column:1 / -1;grid-row:1;margin:1.2rem 0 2rem;font-size:clamp(2.4rem,.4rem + 3.3vw,3.6rem)}
.hero-text{display:block;grid-column:1;grid-row:2;padding-bottom:4rem}
.ht-body{padding:0}
.go{margin:1.8rem 0 0}
.map{grid-column:2;grid-row:2;padding:0;margin-bottom:-6rem;position:relative;z-index:1}
.key{padding-top:9rem}
.open-space .wrap{grid-template-columns:minmax(0,7fr) minmax(0,5fr);column-gap:4rem;align-items:end}
.key .wrap{max-width:none}
}
</style>
</head>
<body>
<main class="cm">
<div class="cm-first">
<div class="wrap">
<header class="top">
{%- if brand.logo_url %}<img class="logo" src="{{ brand.logo_url | escape }}" alt="{{ brand.name | default: 'Logo' | escape }}">{% elsif brand.name %}<p class="brand">{{ brand.name | escape }}</p>{% else %}<span></span>{% endif -%}
<p class="tag">Competitive map</p>
</header>
<div class="cm-grid">
<section data-section="hero" class="hero">
<h1>{{ data.headline | escape }}</h1>
<div class="hero-text">
<div class="ht-body">
<p class="intro">{{ data.intro | escape }}</p>

<ul class="facts">
{%- if m0 %}
<li><span class="cm-fig">{{ m0_text }}</span><span>companies in {{ account.industry | default: 'this industry' | escape }}, counted from company profiles</span></li>
{%- endif %}
{%- if m1 %}
<li><span class="cm-fig">{{ m1_text }}</span><span>of them growing headcount right now</span></li>
{%- endif %}
{%- if has_map %}
<li><span class="cm-fig">{{ n_comp }}</span><span>competitors placed from what their own homepages say</span></li>
{%- endif %}
</ul>
<p class="for">{% if person.first_name %}For <b>{{ person.first_name | escape }}</b> at <b>{{ account.name | escape }}</b>{% else %}For <b>{{ account.name | escape }}</b>{% endif %}</p>
</div>
<div class="go">{% render 'ken/cta', label: 'Book 20 minutes', kind: 'booking', id: 'hero' %}</div>
</div>
</section>
<section data-section="map" class="map">
<h2 class="map-h">Where each one stands</h2>
{%- if has_map %}
{%- assign ax = data.account_position.x | at_least: 4 | at_most: 96 -%}
{%- assign ay = data.account_position.y | at_least: 4 | at_most: 96 -%}
{%- assign ay_top = 100 | minus: ay -%}
{%- assign ox = data.open_space.x | at_least: 17 | at_most: 83 -%}
{%- assign oy = data.open_space.y | at_least: 17 | at_most: 83 -%}
{%- assign oy_top = 100 | minus: oy %}
<div class="sheet">
<div class="terrain">
<i></i><i></i><i></i><i></i>
{%- if has_open %}
<div class="land" style="left:{{ ox }}%;top:{{ oy_top }}%"><span>Open space</span></div>
{%- endif %}
<svg class="marks" viewBox="0 0 100 100" aria-hidden="true" focusable="false">
{%- if has_open and has_you %}
<path class="course" pathLength="100" d="M{{ ax }} {{ ay_top }}L{{ ox }} {{ oy_top }}"/>
{%- endif %}
{%- if has_open %}
<circle class="fx" cx="{{ ox }}" cy="{{ oy_top }}" r="2.6"/><circle class="fx" cx="{{ ox }}" cy="{{ oy_top }}" r="4"/>
{%- endif %}
{%- for c in data.competitors limit: 6 %}
{%- assign cx = c.x | at_least: 4 | at_most: 96 -%}
{%- assign cy = c.y | at_least: 4 | at_most: 96 -%}
{%- assign cy_top = 100 | minus: cy %}
<circle cx="{{ cx }}" cy="{{ cy_top }}" r="3.4"/>
{%- endfor %}
{%- if has_you %}
{%- assign t1 = ay_top | minus: 4 -%}{%- assign t2 = ay_top | plus: 2.6 -%}{%- assign t3 = ax | minus: 4 -%}{%- assign t4 = ax | plus: 4 %}
<path d="M{{ ax }} {{ t1 }}L{{ t4 }} {{ t2 }}L{{ t3 }} {{ t2 }}Z"/>
{%- endif %}
</svg>
{%- for c in data.competitors limit: 6 %}
{%- assign cx = c.x | at_least: 4 | at_most: 96 -%}
{%- assign cy = c.y | at_least: 4 | at_most: 96 -%}
{%- assign cy_top = 100 | minus: cy %}
<div class="pin{% if cx < 14 %} is-left{% elsif cx > 86 %} is-right{% endif %}{% if cy < 14 %} is-low{% endif %}" style="left:{{ cx }}%;top:{{ cy_top }}%"><b>{{ forloop.index }}</b><span>{{ c.name | escape }}</span></div>
{%- endfor %}
{%- if has_you %}
<div class="pin you{% if ax < 14 %} is-left{% elsif ax > 86 %} is-right{% endif %}{% if ay < 14 %} is-low{% endif %}" style="left:{{ ax }}%;top:{{ ay_top }}%"><span>{{ account.name | escape }}</span></div>
{%- endif %}
<p class="end t">{{ data.axes.y.high | escape }}</p>
<p class="end b">{{ data.axes.y.low | escape }}</p>
</div>
<div class="ax-y"><b>{{ data.axes.y.name | escape }}</b></div>
<p class="ax-x"><span>{{ data.axes.x.low | escape }}</span><b>{{ data.axes.x.name | escape }}</b><span>{{ data.axes.x.high | escape }}</span></p>
</div>
<p class="map-note">Placed by {{ sender.name | default: 'our team' | escape }} from what each company's own homepage says about who it sells to and how. A position is a reading of how a company sells, not a measurement.</p>
{%- else %}
<p class="map-wait">I'm still placing {{ account.name | escape }} and the companies that sell the same thing. This link stays the same, so check back later today.</p>
{%- endif %}
</section>
</div>
</div>
</div>
<section data-section="positions" class="key">
<div class="wrap">
<h2>How each one positions</h2>
<table>
<thead><tr><th scope="col"><span class="vh">Mark on the map</span></th><th scope="col">Company</th><th scope="col">How it sells</th></tr></thead>
<tbody>
{%- for c in data.competitors limit: 6 %}
<tr><td class="sym"><span class="ring">{{ forloop.index }}</span></td><td><b>{{ c.name | escape }}</b>{% if c.domain and c.domain != '' %}<small>{{ c.domain | escape }}</small>{% endif %}</td><td><p class="line">{{ c.line | escape }}</p></td></tr>
{%- endfor %}
{%- if has_you %}
<tr class="you"><td class="sym"><svg class="tri" viewBox="0 0 36 32" aria-hidden="true" focusable="false"><path d="M18 3L33 29H3Z"/></svg></td><td><b>{{ account.name | escape }}</b><small>where you sit today</small></td><td><p class="line">{{ data.account_position.line | escape }}</p></td></tr>
{%- endif %}
</tbody>
</table>
</div>
</section>
<section data-section="open_space" class="open-space">
<div class="wrap">
{%- if has_open %}
<div>
<svg class="fin" viewBox="0 0 40 40" aria-hidden="true" focusable="false"><circle cx="20" cy="20" r="11"/><circle cx="20" cy="20" r="17"/></svg>
<h2>{{ data.open_space.title | escape }}</h2>
</div>
<p class="why">{{ data.open_space.why | escape }}</p>
{%- else %}
<h2>The open space</h2>
<p class="open-wait">The open space on this map is the part I want to talk through with you, so it is not written down here.</p>
{%- endif %}
</div>
</section>
<section data-section="cta" class="cta">
<div class="wrap">
<div>
<h2>Does the map match what you see?</h2>
<p>Book 20 minutes and I will move the dots with you: who {{ account.name | escape }} loses deals to, and whether the open space is worth going after.</p>
</div>
<div>
<div class="btn">{% render 'ken/cta', label: 'Book 20 minutes', kind: 'booking' %}</div>
<p class="sign">{{ sender.name | default: 'Our team' | escape }}{% if sender.title %}<span>{{ sender.title | escape }}{% if brand.name %}, {{ brand.name | escape }}{% endif %}</span>{% elsif brand.name %}<span>{{ brand.name | escape }}</span>{% endif %}</p>
</div>
<p class="foot">Drawn for {{ account.name | escape }} by {{ sender.name | default: 'our team' | escape }}{% if brand.name %} at {{ brand.name | escape }}{% endif %}. Company names come from company profiles and positions from each company's public website.</p>
</div>
</section>
</main>
</body>
</html>
