{%- assign accent = brand.colors.primary | default: '#0f6f6c' -%}
{%- assign accent2 = brand.colors.secondary | default: '#e6c46b' -%}
{%- assign font_head = brand.fonts.heading | default: 'Barlow Semi Condensed' -%}
{%- assign font_body = brand.fonts.body | default: 'Barlow' -%}
{%- assign head_q = font_head | replace: ' ', '+' -%}
{%- assign body_q = font_body | replace: ' ', '+' -%}
{%- assign has_map = false -%}
{%- if data.axes.x.name and data.competitors.size > 0 -%}{%- assign has_map = true -%}{%- endif -%}
{%- assign has_you = false -%}
{%- if data.account_position.line and data.account_position.line != '' -%}{%- assign has_you = true -%}{%- endif -%}
{%- assign has_open = false -%}
{%- if data.open_space.title and data.open_space.title != '' -%}{%- assign has_open = true -%}{%- endif -%}
{%- assign n_comp = data.competitors | size -%}
{%- assign initial = account.name | slice: 0, 1 | upcase -%}
{%- assign m0 = data.market[0].value -%}
{%- assign m1 = data.market[1].value -%}
{%- capture m0_text -%}{%- if m0 >= 1000000 -%}{%- assign g1 = m0 | divided_by: 1000000 | floor -%}{%- assign g2 = m0 | modulo: 1000000 | divided_by: 1000 | floor -%}{%- assign g3 = m0 | modulo: 1000 -%}{{ g1 }},{% if g2 < 10 %}00{% elsif g2 < 100 %}0{% endif %}{{ g2 }},{% if g3 < 10 %}00{% elsif g3 < 100 %}0{% endif %}{{ g3 }}{%- elsif m0 >= 1000 -%}{%- assign g2 = m0 | divided_by: 1000 | floor -%}{%- assign g3 = m0 | modulo: 1000 -%}{{ g2 }},{% if g3 < 10 %}00{% elsif g3 < 100 %}0{% endif %}{{ g3 }}{%- else -%}{{ m0 }}{%- endif -%}{%- endcapture -%}
{%- capture m1_text -%}{%- if m1 >= 1000000 -%}{%- assign h1 = m1 | divided_by: 1000000 | floor -%}{%- assign h2 = m1 | modulo: 1000000 | divided_by: 1000 | floor -%}{%- assign h3 = m1 | modulo: 1000 -%}{{ h1 }},{% if h2 < 10 %}00{% elsif h2 < 100 %}0{% endif %}{{ h2 }},{% if h3 < 10 %}00{% elsif h3 < 100 %}0{% endif %}{{ h3 }}{%- elsif m1 >= 1000 -%}{%- assign h2 = m1 | divided_by: 1000 | floor -%}{%- assign h3 = m1 | modulo: 1000 -%}{{ h2 }},{% if h3 < 10 %}00{% elsif h3 < 100 %}0{% endif %}{{ h3 }}{%- else -%}{{ m1 }}{%- endif -%}{%- endcapture -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex">
<title>{{ data.headline | escape }}</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ head_q }}:wght@400;600;700&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ body_q }}:wght@400;500;600;700&display=swap">
<style>
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:#f5f6f3;color:#1c1c1c;font-family:'{{ font_body }}',ui-sans-serif,system-ui,sans-serif;font-size:17px;line-height:1.55;-webkit-font-smoothing:antialiased}
.cm{--a:{{ accent }};--a2:{{ accent2 }};--ink:#1c1c1c;--text:#2e302f;--mute:#6b706e;--line:#d7dad6;--mid:#c3c8c2;--grid:#e6e9e5;--paper:#f5f6f3;--white:#fff}
.cm h1,.cm h2,.cm h3{font-family:'{{ font_head }}',ui-sans-serif,system-ui,sans-serif;font-weight:600;letter-spacing:-.01em;line-height:1.05;text-wrap:balance;margin:0}
p{margin:0}
.cm a:focus-visible{outline:3px solid var(--a);outline-offset:3px}
.wrap{max-width:68rem;margin:0 auto;padding:0 1.25rem}
.top{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:1rem 0;border-bottom:1px solid var(--ink)}
.logo{height:26px;width:auto;display:block}
.brand{font-weight:700;font-size:1rem}
.tag{font-size:.9rem;color:var(--mute)}
.hero{padding:2.2rem 0 2rem}
.kicker{font-size:.95rem;font-weight:600;color:var(--a);margin:0 0 .9rem}
.hero h1{font-size:2.25rem}
.intro{font-size:1.08rem;line-height:1.5;color:var(--text);margin:1.3rem 0 0;max-width:36rem}
.facts{list-style:none;margin:1.9rem 0 0;padding:0;border-top:2px solid var(--ink)}
.facts li{display:grid;grid-template-columns:auto 1fr;align-items:baseline;gap:.9rem;padding:.7rem 0;border-bottom:1px solid var(--line)}
.facts b{font-family:'{{ font_head }}',ui-sans-serif,system-ui,sans-serif;font-weight:600;font-size:1.7rem;line-height:1;min-width:2.6rem;font-variant-numeric:tabular-nums;letter-spacing:-.01em}
.facts span{font-size:.95rem;line-height:1.35;color:var(--text)}
.map{padding:2rem 0 1.6rem}
.map h2,.key h2{font-size:1.55rem;margin:0 0 1rem}
.plot{display:grid;grid-template-columns:1.4rem 1fr;grid-template-rows:auto auto;gap:.45rem .55rem}
.plot-y{display:flex;align-items:center;justify-content:center;writing-mode:vertical-rl;transform:rotate(180deg);font-size:.82rem;font-weight:600;color:var(--ink);line-height:1}
.plot-area{position:relative;aspect-ratio:1/1;background-color:var(--white);background-image:linear-gradient(to right,var(--grid) 1px,transparent 1px),linear-gradient(to bottom,var(--grid) 1px,transparent 1px);background-size:10% 10%;border:1.5px solid var(--ink)}
.plot-area::before,.plot-area::after{content:"";position:absolute;background:var(--mid)}
.plot-area::before{left:50%;top:0;bottom:0;width:1px}
.plot-area::after{top:50%;left:0;right:0;height:1px}
.plot-end{position:absolute;left:.45rem;font-size:.72rem;line-height:1.1;font-weight:500;color:var(--mute);max-width:40%}
.plot-end-top{top:.4rem}
.plot-end-bottom{bottom:.4rem}
.plot-x{grid-column:2;display:flex;align-items:baseline;justify-content:space-between;gap:.6rem;font-size:.72rem;font-weight:500;color:var(--mute)}
.plot-x b{font-size:.82rem;font-weight:600;color:var(--ink);text-align:center}
.plot-open{position:absolute;width:27%;aspect-ratio:1/1;transform:translate(-50%,-50%);border:2px dashed var(--a);border-radius:50%;background:color-mix(in srgb,var(--a2) 24%,transparent);display:grid;place-items:center;z-index:1}
.plot-open span{font-size:.68rem;font-weight:600;line-height:1.1;color:var(--a);text-align:center;padding:0 .3rem}
.pt{position:absolute;width:0;height:0;z-index:2}
.pt i{position:absolute;left:0;top:0;width:28px;height:28px;transform:translate(-50%,-50%);border-radius:50%;background:var(--white);border:1.5px solid var(--ink);color:var(--ink);font-style:normal;font-size:.8rem;font-weight:600;display:grid;place-items:center}
.pt span{display:none;position:absolute;left:0;top:16px;transform:translateX(-50%);white-space:nowrap;font-size:.76rem;line-height:1.2;font-weight:600;color:var(--ink);background:rgba(255,255,255,.9);padding:.05rem .3rem;border-radius:3px}
.pt.is-left span{left:-15px;transform:none}
.pt.is-right span{left:auto;right:-15px;transform:none}
.pt.is-low span{top:auto;bottom:16px}
.pt.you{z-index:3}
.pt.you i{width:32px;height:32px;border-radius:5px;background:var(--a);border-color:var(--a);color:#fff;font-size:.9rem}
.pt.you span{display:block;top:19px;color:var(--a)}
.pt.you.is-low span{top:auto;bottom:19px}
.plot-note{font-size:.85rem;line-height:1.45;color:var(--mute);margin:1rem 0 0}
.key{padding:.6rem 0 2.2rem}
.key ol{list-style:none;margin:0;padding:0;border-top:2px solid var(--ink)}
.key li{display:grid;grid-template-columns:28px 1fr;gap:.8rem;padding:.85rem 0;border-bottom:1px solid var(--line)}
.key li i{width:28px;height:28px;margin-top:.1rem;border-radius:50%;background:var(--white);border:1.5px solid var(--ink);color:var(--ink);font-style:normal;font-size:.8rem;font-weight:600;display:grid;place-items:center}
.key li.you i{border-radius:5px;background:var(--a);border-color:var(--a);color:#fff}
.key b{font-weight:600}
.key small{font-size:.82rem;color:var(--mute);margin-left:.45rem;white-space:nowrap}
.key p{font-size:.95rem;line-height:1.45;color:var(--text);margin:.15rem 0 0}
.open-space{padding:0 0 2.4rem}
.box{border:2px dashed var(--a);background:color-mix(in srgb,var(--a2) 16%,var(--paper));padding:1.4rem 1.25rem 1.35rem}
.lbl{font-size:.9rem;font-weight:600;color:var(--a);margin:0 0 .45rem}
.box h2{font-size:1.8rem;margin:0 0 .8rem}
.box-why{font-size:1.02rem;line-height:1.5;color:var(--text)}
.cta{padding:0 0 3rem}
.cta-in{border-top:2px solid var(--ink);padding-top:1.5rem}
.cta h2{font-size:1.65rem;margin:0 0 .7rem}
.cta p{color:var(--text)}
.btn{margin:1.2rem 0 1.2rem}
.sign{font-size:.95rem}
.sign span{display:block;color:var(--mute)}
.foot{font-size:.8rem;line-height:1.45;color:var(--mute);border-top:1px solid var(--line);padding:1rem 0 2rem}
@media (min-width:760px){
body{font-size:18px}
.wrap{padding:0 2rem}
.hero{display:grid;grid-template-columns:7fr 4fr;gap:3.5rem;align-items:end;padding:3rem 0 2.4rem}
.hero h1{font-size:3.15rem}
.intro{font-size:1.15rem;margin-top:1.5rem}
.facts{margin:0}
.facts b{font-size:2rem;min-width:3rem}
.grid{display:grid;grid-template-columns:7fr 5fr;gap:3.5rem;align-items:start}
.map{padding:2.4rem 0 2rem}
.key{padding:2.4rem 0 2rem}
.map h2,.key h2{font-size:1.75rem}
.plot{grid-template-columns:1.6rem 1fr}
.plot-y{font-size:.88rem}
.plot-end,.plot-x{font-size:.78rem}
.plot-x b{font-size:.88rem}
.pt span{display:block}
.pt.you i{width:36px;height:36px;font-size:1rem}
.pt.you span{top:21px;font-size:.84rem}
.pt.you.is-low span{top:auto;bottom:21px}
.plot-open span{font-size:.78rem}
.open-space{padding:.6rem 0 3rem}
.box{display:grid;grid-template-columns:1fr 1fr;gap:3rem;align-items:start;padding:2.2rem 2.4rem 2.3rem}
.box h2{font-size:2.5rem;margin:0}
.box-why{font-size:1.08rem;padding-top:.3rem}
.cta-in{display:grid;grid-template-columns:1fr 1fr;gap:3.5rem;padding-top:2rem}
.cta h2{font-size:2rem}
.btn{margin:.4rem 0 1.2rem}
.foot{padding:1.2rem 0 2.5rem}
}
</style>
</head>
<body>
<main class="cm">
<div class="wrap">
<header class="top">
{%- if brand.logo_url %}<img class="logo" src="{{ brand.logo_url | escape }}" alt="{{ brand.name | default: 'Logo' | escape }}">{% elsif brand.name %}<p class="brand">{{ brand.name | escape }}</p>{% else %}<span></span>{% endif -%}
<p class="tag">Competitive map</p>
</header>
<section data-section="hero" class="hero">
<div>
<p class="kicker">{% if person.first_name %}For {{ person.first_name | escape }} at {{ account.name | escape }}{% else %}For {{ account.name | escape }}{% endif %}</p>
<h1>{{ data.headline | escape }}</h1>
<p class="intro">{{ data.intro | escape }}</p>
</div>
<ul class="facts">
{%- if m0 %}
<li><b>{{ m0_text }}</b><span>companies in {{ account.industry | default: 'this industry' | escape }}, counted from company profiles</span></li>
{%- endif %}
{%- if m1 %}
<li><b>{{ m1_text }}</b><span>of them growing headcount right now</span></li>
{%- endif %}
{%- if has_map %}
<li><b>{{ n_comp }}</b><span>competitors placed from what their own homepages say</span></li>
{%- endif %}
</ul>
</section>
<div class="grid">
<section data-section="map" class="map">
<h2>Where each one stands</h2>
{%- if has_map %}
<div class="plot">
<div class="plot-y"><span>{{ data.axes.y.name | escape }}</span></div>
<div class="plot-area">
<span class="plot-end plot-end-top">{{ data.axes.y.high | escape }}</span>
<span class="plot-end plot-end-bottom">{{ data.axes.y.low | escape }}</span>
{%- if has_open %}
{%- assign ox = data.open_space.x | at_least: 14 | at_most: 86 -%}
{%- assign oy = data.open_space.y | at_least: 14 | at_most: 86 -%}
{%- assign oy_top = 100 | minus: oy %}
<div class="plot-open" style="left:{{ ox }}%;top:{{ oy_top }}%"><span>Open space</span></div>
{%- endif %}
{%- for c in data.competitors limit: 6 %}
{%- assign cx = c.x | at_least: 4 | at_most: 96 -%}
{%- assign cy = c.y | at_least: 4 | at_most: 96 -%}
{%- assign cy_top = 100 | minus: cy %}
<div class="pt{% if cx < 12 %} is-left{% elsif cx > 88 %} is-right{% endif %}{% if cy < 12 %} is-low{% endif %}" style="left:{{ cx }}%;top:{{ cy_top }}%"><i>{{ forloop.index }}</i><span>{{ c.name | escape }}</span></div>
{%- endfor %}
{%- if has_you %}
{%- assign ax = data.account_position.x | at_least: 4 | at_most: 96 -%}
{%- assign ay = data.account_position.y | at_least: 4 | at_most: 96 -%}
{%- assign ay_top = 100 | minus: ay %}
<div class="pt you{% if ax < 12 %} is-left{% elsif ax > 88 %} is-right{% endif %}{% if ay < 12 %} is-low{% endif %}" style="left:{{ ax }}%;top:{{ ay_top }}%"><i>{{ initial | escape }}</i><span>{{ account.name | escape }}</span></div>
{%- endif %}
</div>
<div class="plot-x"><span>{{ data.axes.x.low | escape }}</span><b>{{ data.axes.x.name | escape }}</b><span>{{ data.axes.x.high | escape }}</span></div>
</div>
<p class="plot-note">Placed by {{ sender.name | default: 'our team' | escape }} from what each company's own homepage says about who it sells to and how. A position is a reading of how a company sells, not a measurement.</p>
{%- else %}
<p class="intro">I'm still placing {{ account.name | escape }} and the companies that sell the same thing. This link stays the same, so check back later today.</p>
{%- endif %}
</section>
<section data-section="positions" class="key">
<h2>How each one positions</h2>
<ol>
{%- for c in data.competitors limit: 6 %}
<li><i>{{ forloop.index }}</i><div><b>{{ c.name | escape }}</b>{% if c.domain and c.domain != '' %}<small>{{ c.domain | escape }}</small>{% endif %}<p>{{ c.line | escape }}</p></div></li>
{%- endfor %}
{%- if has_you %}
<li class="you"><i>{{ initial | escape }}</i><div><b>{{ account.name | escape }}</b><small>where you sit today</small><p>{{ data.account_position.line | escape }}</p></div></li>
{%- endif %}
</ol>
</section>
</div>
<section data-section="open_space" class="open-space">
{%- if has_open %}
<div class="box">
<div><p class="lbl">The open space</p><h2>{{ data.open_space.title | escape }}</h2></div>
<p class="box-why">{{ data.open_space.why | escape }}</p>
</div>
{%- else %}
<p class="intro">The open space on this map is the part I want to talk through with you, so it is not written down here.</p>
{%- endif %}
</section>
<section data-section="cta" class="cta">
<div class="cta-in">
<div>
<h2>Does the map match what you see?</h2>
<p>Book 20 minutes and I will move the dots with you: who {{ account.name | escape }} loses deals to, and whether the open space is worth going after.</p>
</div>
<div>
<div class="btn">{% render 'ken/cta', label: 'Book 20 minutes', kind: 'booking' %}</div>
<p class="sign">{{ sender.name | default: 'Our team' | escape }}{% if sender.title %}<span>{{ sender.title | escape }}{% if brand.name %}, {{ brand.name | escape }}{% endif %}</span>{% elsif brand.name %}<span>{{ brand.name | escape }}</span>{% endif %}</p>
</div>
</div>
</section>
<p class="foot">Drawn for {{ account.name | escape }} by {{ sender.name | default: 'our team' | escape }}{% if brand.name %} at {{ brand.name | escape }}{% endif %}. Company names come from company profiles and positions from each company's public website.</p>
</div>
</main>
</body>
</html>
