{%- assign accent = brand.colors.primary | default: '#0f4c81' -%}
{%- assign accent2 = brand.colors.secondary | default: '#e3a82b' -%}
{%- assign font_head = brand.fonts.heading | default: 'Archivo' -%}
{%- assign font_body = brand.fonts.body | default: 'Archivo' -%}
{%- assign head_q = font_head | replace: ' ', '+' -%}
{%- assign body_q = font_body | replace: ' ', '+' -%}
{%- assign company = brand.name | default: sender.name | default: 'Our team' -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex">
<title>See you at the show</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ head_q }}:wght@400;500;700&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ body_q }}:wght@400;500;700&display=swap">
<style>
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:#f4f5f3;color:#16181d;font-family:'{{ font_body }}',ui-sans-serif,system-ui,sans-serif;font-size:16px;line-height:1.55;-webkit-font-smoothing:antialiased}
.cm{--p:{{ accent }};--s:{{ accent2 }};--ink:#16181d;--mute:#5d646d;--line:#dcdfe2;--card:#fff}
.cm h1,.cm h2,.cm .sign{font-family:'{{ font_head }}',ui-sans-serif,system-ui,sans-serif;font-weight:700;letter-spacing:-.015em;line-height:1.1;margin:0}
.cm p{margin:0 0 .8rem}
.wrap{max-width:72rem;margin:0 auto;padding:0 1.1rem}
.top{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:.9rem 0;border-bottom:1px solid var(--line)}
.logo{height:26px;width:auto;display:block}
.brand{font-family:'{{ font_head }}',ui-sans-serif,system-ui,sans-serif;font-weight:700;font-size:1rem}
.hero{display:grid;gap:1.6rem;padding:2rem 0 2rem}
.for{font-size:.95rem;color:var(--mute);margin:0 0 .7rem}
.for b{font-weight:500;color:var(--ink)}
.cm h1{font-size:2.35rem;text-wrap:balance;max-width:16ch}
.dek{font-size:1.08rem;color:var(--mute);max-width:36rem;margin:1rem 0 0}
.sign{position:relative;background:var(--p);color:#fff;border-radius:8px;padding:1.3rem 1.3rem 1.2rem;overflow:hidden;align-self:start}
.sign::before{content:"";position:absolute;left:0;top:0;right:0;height:6px;background:var(--s)}
.sign-hall{font-size:.95rem;font-weight:500;opacity:.9;margin:.3rem 0 0}
.sign-num{font-size:4rem;line-height:1;letter-spacing:-.03em;margin:.1rem 0 .3rem}
.sign-brand{font-size:1.05rem;font-weight:700;padding-top:.8rem;border-top:1px solid rgba(255,255,255,.3)}
.meet{background:var(--card);border:1px solid var(--line);border-radius:8px;padding:1.3rem 1.2rem 1.2rem;margin:0 0 3rem;max-width:40rem}
.meet h2{font-size:1.35rem;margin:0 0 .5rem}
.meet .lede{color:var(--mute);margin-bottom:1.1rem}
.cta{margin:0 0 1.3rem}
.sig{margin:0;font-size:.95rem}
.sig b{display:block;font-weight:600}
.sig span{color:var(--mute);font-size:.88rem}
@media (min-width:700px){
body{font-size:17px}
.wrap{padding:0 2rem}
.hero{grid-template-columns:minmax(0,1fr) 19rem;gap:3rem;align-items:center;padding:3.4rem 0 2.6rem}
.cm h1{font-size:3.5rem}
.sign{padding:1.6rem 1.6rem 1.4rem}
.meet{padding:1.6rem 1.7rem 1.5rem}
}
</style>
</head>
<body>
<main class="cm">
<div class="wrap">
<header class="top">
{%- if brand.logo_url %}<img class="logo" src="{{ brand.logo_url | escape }}" alt="{{ company | escape }}">{% else %}<span class="brand">{{ company | escape }}</span>{% endif -%}
</header>
<section data-section="hero" class="hero">
<div>
<p class="for">{% if person.first_name %}For <b>{{ person.first_name | escape }} {{ person.last_name | escape }}</b> at {{ account.name | escape }}{% else %}For the team at <b>{{ account.name | escape }}</b>{% endif %}</p>
<h1>See you at the show</h1>
<p class="dek">Hi {{ person.first_name | default: 'there' | escape }}, this page will show where {{ company | escape }} is at the show, when the team is at the booth, and the side events worth going to. It is not ready yet. The link stays the same, so check back shortly.</p>
</div>
<aside class="sign" aria-label="Booth details to follow">
<p class="sign-hall">Booth</p>
<p class="sign-num">Soon</p>
<p class="sign-brand">{{ company | escape }}</p>
</aside>
</section>
<section data-section="meet" class="meet">
<h2>Rather pick a time now?</h2>
<p class="lede">Choose a slot and it goes on both calendars. {{ sender.name | default: 'Our team' | escape }} will meet you at the booth or over a coffee nearby.</p>
<div class="cta">{% render 'ken/cta', label: 'Pick a time at the show', kind: 'booking', color: accent %}</div>
<p class="sig"><b>{{ sender.name | default: company | escape }}</b><span>{% if sender.title %}{{ sender.title | escape }}, {% endif %}{{ company | escape }}</span></p>
</section>
</div>
</main>
</body>
</html>
