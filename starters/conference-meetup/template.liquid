{%- assign accent = brand.colors.primary | default: '#5c6b54' -%}
{%- assign accent2 = brand.colors.secondary | default: '#cdc3b6' -%}
{%- assign font_head = brand.fonts.heading | default: 'Barlow Condensed' -%}
{%- assign font_body = brand.fonts.body | default: 'Barlow' -%}
{%- assign head_q = font_head | replace: ' ', '+' -%}
{%- assign body_q = font_body | replace: ' ', '+' -%}
{%- assign company = brand.name | default: sender.name | default: 'Our team' -%}
{%- assign sender_first = sender.name | default: 'us' | split: ' ' | first -%}
{%- assign has_talk = false -%}
{%- if data.talk.title and data.talk.title != '' -%}{%- assign has_talk = true -%}{%- endif -%}
{%- assign day_count = data.booth_hours | size -%}
{%- assign booth_len = data.booth | size -%}
{%- assign booth_size = 'b3' -%}
{%- if booth_len > 3 -%}{%- assign booth_size = 'b4' -%}{%- endif -%}
{%- if booth_len > 4 -%}{%- assign booth_size = 'b5' -%}{%- endif -%}
{%- if booth_len > 6 -%}{%- assign booth_size = 'b7' -%}{%- endif -%}
{%- assign name_len = data.conference_name | size -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex">
<title>See you at {{ data.conference_name | escape }}</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ head_q }}:wght@{% if font_head == 'Barlow Condensed' %}600;700{% else %}400;500;700{% endif %}&display=swap">
{%- if font_body != font_head %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ body_q }}:wght@400;500;600&display=swap">
{%- endif %}
<style>
:root{
  --p:{{ accent | escape }};
  --s:{{ accent2 | escape }};
  --fh:'{{ font_head | escape }}','Arial Narrow',ui-sans-serif,system-ui,sans-serif;
  --fb:'{{ font_body | escape }}',ui-sans-serif,system-ui,sans-serif;
  /* the show floor: stone ground, charcoal print, one sign colour */
  --bg:#eeecea;
  --surface:#e4e1dd;
  --ink:#333231;
  --muted:#5f5b58;
  --on-p:#fff;
  --on-s:var(--ink);
  --step-small:clamp(.875rem,.84rem + .1vw,.9375rem);
  --step-body:clamp(1.0625rem,1rem + .25vw,1.1875rem);
  --step-lead:clamp(1.25rem,1.1rem + .7vw,1.625rem);
  --step-head:clamp(2.5rem,1.2rem + 5vw,5.5rem);
  --margin:clamp(1rem,2.4vw,2rem);
}
@supports (color:oklch(from red l c h)){:root{
  --on-p:oklch(from var(--p) clamp(0,(.68 - l) * 1000,1) 0 0);
  --on-s:oklch(from var(--s) clamp(.2,(.68 - l) * 1000,.98) 0 0);
}}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%;scroll-behavior:smooth;background:var(--bg)}
body{margin:0;background:var(--bg);color:var(--ink);font:400 var(--step-body)/1.5 var(--fb);-webkit-font-smoothing:antialiased;font-variant-numeric:tabular-nums}
h1,h2,h3{font-family:var(--fh);font-weight:700;margin:0;line-height:.92;letter-spacing:-.01em;text-wrap:balance}
p{margin:0}
a{color:inherit;text-underline-offset:.18em;text-decoration-thickness:.07em}
a:focus-visible,.btn:focus-visible,.ken-cta:focus-visible{outline:3px solid var(--ink);outline-offset:3px}
::selection{background:var(--p);color:var(--on-p)}
.frame{padding-left:var(--margin);padding-right:var(--margin);max-width:100rem;margin:0 auto}
.sign{font-family:var(--fh);font-weight:700;text-transform:uppercase;line-height:.82;letter-spacing:-.01em}

/* first screen: the hall top-left, the booth number bottom-right, the page between them */
.hero{display:grid;grid-template-areas:"top" "sign" "lead";padding-top:1rem;overflow:hidden}
.top{grid-area:top;display:flex;justify-content:space-between;align-items:baseline;gap:1rem;font-size:var(--step-small)}
.top .co{font-family:var(--fh);font-weight:700;font-size:var(--step-lead);line-height:1;letter-spacing:0}
.top img{height:26px;width:auto;display:block}
.top .for{text-align:right;color:var(--muted);max-width:28rem}
.signage{grid-area:sign;display:flex;flex-direction:column;margin-top:1.6rem}
.hall{font-size:clamp(3rem,1rem + 8vw,8rem)}
.num{align-self:flex-end;text-align:right;margin:.2em -.04em 0 0;white-space:nowrap}
.num.b3{font-size:50vw}
.num.b4{font-size:40vw}
.num.b5{font-size:31vw}
.num.b7{font-size:17vw}
.lead-in{grid-area:lead;padding:2.2rem 0 1rem;max-width:44rem;position:relative;z-index:1}
.top .for b{color:var(--ink);font-weight:500}
.hero h1{font-size:clamp(2.125rem,.9rem + 3.9vw,4rem);max-width:22ch}
.hero h1.long{font-size:clamp(1.875rem,.9rem + 2.8vw,3.25rem);max-width:24ch}
.dek{margin-top:1.3rem;max-width:40ch}
.go{display:flex;flex-wrap:wrap;align-items:center;gap:.8rem 1.4rem;margin-top:1.6rem}
.btn{display:inline-flex;align-items:center;min-height:3rem;padding:.75rem 1.4rem;background:var(--p);color:var(--on-p);font-weight:600;text-decoration:none}
.btn:hover{background:color-mix(in srgb,var(--p) 86%,#000)}
.go span{color:var(--muted);font-size:var(--step-small);max-width:24rem}
@keyframes rise{from{transform:translateY(18%)}to{transform:none}}
.num{animation:rise 1s cubic-bezier(.2,.7,.2,1) both}

/* the note: heading left, the line right */
.note{display:grid;gap:1.4rem;padding-top:4.5rem}
.note h2,.block h2,.where h2{font-size:clamp(1.75rem,1.3rem + 1.6vw,2.5rem);line-height:1}
.note .line{font-size:var(--step-lead);line-height:1.4;max-width:40ch}
.note .hi{font-weight:500;margin-bottom:.6rem}
.sig{margin-top:1.4rem;font-size:var(--step-small);color:var(--muted)}
.sig b{display:block;color:var(--ink);font-weight:600;font-size:var(--step-body)}

/* booth hours, one poster line a day */
.block{padding-top:6rem}
.block .lede{margin-top:.9rem;max-width:44ch}
.days{list-style:none;margin:2rem 0 0;padding:0}
.days li{display:grid;gap:.35rem;padding:.9rem 0 1.1rem}
.days li+li{border-top:6px solid var(--surface)}
.days .d{font-size:clamp(2.25rem,.6rem + 6.4vw,6.5rem)}
.days .h{font-size:var(--step-lead);font-weight:500;line-height:1.2}
.days small{display:block;font-size:var(--step-body);color:var(--muted);font-weight:400;margin-top:.2rem}

/* our session, on a square plate */
.talk{display:grid;gap:1.6rem;margin-top:2rem}
.plate{min-height:13rem;gap:2rem;background:var(--p);color:var(--on-p);padding:1.4rem;display:flex;flex-direction:column;justify-content:space-between}
.plate .when{font-size:clamp(2.25rem,.6rem + 6.4vw,6.5rem)}
.plate .day{font-size:var(--step-body);font-weight:500;line-height:1.3}
.talk-title{font-family:var(--fh);font-weight:700;font-size:clamp(1.375rem,1rem + 1.4vw,2.25rem);line-height:1.1;max-width:30ch;text-wrap:balance}
.meta{list-style:none;margin:1.4rem 0 0;padding:0;display:grid;gap:.4rem}
.meta b{font-weight:600}

/* side events, by day; the day holds while its events pass */
.off h2{font-size:clamp(3rem,1rem + 8vw,8rem);line-height:.82;text-transform:uppercase}
.group{margin-top:2.6rem;display:grid;gap:.9rem}
.group h3{font-size:var(--step-lead);text-transform:uppercase;line-height:1;align-self:start}
.ev{list-style:none;margin:0;padding:0;display:grid;gap:6px}
.ev li{background:var(--surface);padding:1.1rem 1.1rem 1.2rem;display:grid;gap:.15rem .8rem;grid-template-columns:5.5rem minmax(0,1fr)}
.ev .t{font-family:var(--fh);font-weight:700;font-size:var(--step-lead);line-height:1.1;white-space:nowrap}
.ev b{display:block;font-weight:600;font-size:var(--step-body);line-height:1.3}
.ev .w{display:block;color:var(--muted)}
.ev .n{margin-top:.45rem}
.ev .h{margin-top:.35rem;color:var(--muted);font-size:var(--step-small)}

/* where we are, then a time */
.where{margin-top:6rem;background:var(--s);color:var(--on-s);padding-top:3.5rem;padding-bottom:4rem;display:grid;gap:2.4rem;max-width:none}
.rows{list-style:none;margin:0;padding:0}
.rows li{font-family:var(--fh);font-weight:700;font-size:clamp(2rem,1rem + 3.4vw,4rem);line-height:1;text-transform:uppercase;padding:.25rem 0;overflow-wrap:anywhere}
.book .lede{margin:.9rem 0 1.4rem;max-width:42ch}
.book .after{margin-top:1rem;font-size:var(--step-small)}
.book .ken-booking{color:var(--on-s);border-radius:0!important}
.book .ken-cta{background:var(--p)!important;color:var(--on-p)!important;border-radius:0!important}

/* the foot: the number once more, inverted */
.foot{background:var(--ink);color:var(--bg);padding-top:2rem;padding-bottom:2rem;max-width:none;overflow:hidden}
.foot .sign{font-size:clamp(3rem,1rem + 8vw,8rem);white-space:nowrap}
.foot p{margin-top:1.2rem;font-size:var(--step-small);max-width:60ch}
.foot b{font-weight:600}

@media (min-width:760px){
  .note{grid-template-columns:minmax(0,4fr) minmax(0,8fr);gap:3rem;padding-top:7rem}
  .block{padding-top:8rem}
  .booth-head{display:grid;grid-template-columns:minmax(0,4fr) minmax(0,8fr);gap:3rem;align-items:end}
  .booth-head .lede{margin:0}
  .days li{grid-template-columns:minmax(0,1fr) minmax(16rem,22rem);align-items:end;gap:2rem}
  .days .h{text-align:right;padding-bottom:.4rem}
  .talk{grid-template-columns:minmax(0,4fr) minmax(0,8fr);gap:3rem;align-items:end}
  .plate{aspect-ratio:1/1;padding:1.6rem}
  .meta{grid-template-columns:repeat(3,auto);justify-content:start;gap:.4rem 2.4rem}
  .group{grid-template-columns:minmax(0,4fr) minmax(0,8fr);gap:3rem}
  .group h3{position:sticky;top:1.5rem;padding-top:1rem}
  .ev li{grid-template-columns:7rem minmax(0,1fr);padding:1.3rem 1.5rem}
  .where{margin-top:8rem;grid-template-columns:minmax(0,6fr) minmax(0,6fr);gap:3rem;align-items:start;padding-top:5rem;padding-bottom:5rem}
}
@media (min-width:1000px){
  .hero{padding-top:1.5rem;padding-bottom:1.5rem;min-height:min(100svh,50rem);grid-template-columns:minmax(0,6fr) minmax(0,6fr);grid-template-rows:auto 1fr;grid-template-areas:"top top" "lead sign";column-gap:3rem}
  .lead-in{align-self:center;padding:2rem 0}
  .signage{margin-top:1rem;justify-content:space-between}
  .num.b3{font-size:min(31vw,30rem)}
  .num.b4{font-size:min(24vw,23rem)}
  .num.b5{font-size:min(19vw,18rem)}
  .num.b7{font-size:min(11vw,10.5rem)}
}
@media (min-width:760px) and (max-width:999px){
  .num.b3{font-size:40vw}
  .num.b4{font-size:32vw}
  .num.b5{font-size:25vw}
  .num.b7{font-size:14vw}
}
/* a brand heading face is usually wider than the condensed default: the signage steps down */
.wide .hero h1{font-size:clamp(1.875rem,.8rem + 2.8vw,3rem)}
.wide .hero h1.long{font-size:clamp(1.625rem,.8rem + 2.2vw,2.5rem)}
.wide .days .d,.wide .plate .when{font-size:clamp(1.75rem,.6rem + 4.2vw,4.25rem)}
.wide .hall,.wide .off h2,.wide .foot .sign{font-size:clamp(2.5rem,1rem + 6vw,6rem)}
.wide .rows li{font-size:clamp(1.625rem,1rem + 2.4vw,3rem)}
.wide .num.b3{font-size:40vw}
.wide .num.b4{font-size:31vw}
.wide .num.b5{font-size:24vw}
.wide .num.b7{font-size:13vw}
@media (min-width:1000px){
  .wide .num.b3{font-size:min(25vw,24rem)}
  .wide .num.b4{font-size:min(19vw,18rem)}
  .wide .num.b5{font-size:min(15vw,14rem)}
  .wide .num.b7{font-size:min(8.5vw,8rem)}
}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}.num{animation:none}}
@media print{.num{animation:none}.group h3{position:static}.btn{display:none}}
</style>
</head>
<body{% unless font_head == 'Barlow Condensed' %} class="wide"{% endunless %}>
<main>
<section data-section="hero" class="hero frame">
  <header class="top">
    {%- if brand.logo_url %}<img src="{{ brand.logo_url | escape }}" alt="{{ company | escape }}">{% else %}<span class="co">{{ company | escape }}</span>{% endif %}
    <p class="for">{% if person.first_name %}For <b>{{ person.first_name | escape }} {{ person.last_name | escape }}</b>{% if person.title %}, {{ person.title | escape }}{% endif %} at {{ account.name | escape }}{% else %}For the team at <b>{{ account.name | escape }}</b>{% endif %}</p>
  </header>
  <div class="lead-in">
    <h1{% if name_len > 26 %} class="long"{% endif %}>See you at {{ data.conference_name | escape }}</h1>
    <p class="dek">{{ data.dates_text | escape }}{% if data.venue and data.venue != '' %} at {{ data.venue | escape }}{% endif %}{% if data.city and data.city != '' %}, {{ data.city | escape }}{% endif %}. {{ company | escape }} is at booth {{ data.booth | escape }} in {{ data.hall | escape }}{% case day_count %}{% when 1 %} on {{ data.booth_hours[0].day | escape }}{% when 2 %} both days{% when 3 %} all three days{% when 4 %} all four days{% when 5 %} all five days{% else %} every day of the show{% endcase %}.</p>
    <div class="go"><a class="btn" href="#meet">Pick a time at the show</a><span>20 minutes at the booth, or a coffee nearby. {{ sender_first | escape }} holds the slot.</span></div>
  </div>
  <div class="signage" aria-label="Booth {{ data.booth | escape }} in {{ data.hall | escape }}">
    <p class="hall sign">{{ data.hall | escape }}</p>
    <p class="num sign {{ booth_size }}" aria-hidden="true">{{ data.booth | escape }}</p>
  </div>
</section>

<section data-section="note" class="note frame">
  <h2>A note from {{ sender_first | escape }}</h2>
  <div>
    {%- if person.first_name %}<p class="hi">{{ person.first_name | escape }},</p>{% endif %}
    <p class="line">{{ data.personal_line | escape }}</p>
    <p class="sig"><b>{{ sender.name | default: company | escape }}</b>{% if sender.title %}{{ sender.title | escape }}, {% endif %}{{ company | escape }}</p>
  </div>
</section>

<section data-section="booth" class="block frame">
  <div class="booth-head">
    <h2>At the booth</h2>
    {%- if data.booth_note and data.booth_note != '' %}<p class="lede">{{ data.booth_note | escape }}</p>{% endif %}
  </div>
  <ul class="days">
    {%- for h in data.booth_hours %}
    <li><span class="d sign">{{ h.day | escape }}</span><span class="h">{{ h.hours | escape }}{% if h.who and h.who != '' %}<small>{{ h.who | escape }}</small>{% endif %}</span></li>
    {%- endfor %}
  </ul>
</section>

{%- if has_talk %}
<section data-section="talk" class="block frame">
  <h2>Our session</h2>
  <div class="talk">
    <div class="plate" aria-hidden="true">
      <span class="day">{{ data.talk.day | default: data.dates_text | escape }}{% if data.talk.stage and data.talk.stage != '' %}<br>{{ data.talk.stage | escape }}{% endif %}</span>
      {%- if data.talk.time and data.talk.time != '' %}<span class="when sign">{{ data.talk.time | split: ' to ' | first | escape }}</span>{% endif %}
    </div>
    <div>
      <p class="talk-title">{{ data.talk.title | escape }}</p>
      <ul class="meta">
        {%- if data.talk.day and data.talk.day != '' %}<li><b>{{ data.talk.day | escape }}</b>{% if data.talk.time and data.talk.time != '' %}, {{ data.talk.time | escape }}{% endif %}</li>{% endif %}
        {%- if data.talk.stage and data.talk.stage != '' %}<li>{{ data.talk.stage | escape }}</li>{% endif %}
        {%- if data.talk.speaker and data.talk.speaker != '' %}<li>{{ data.talk.speaker | escape }}</li>{% endif %}
      </ul>
    </div>
  </div>
</section>
{%- endif %}

<section data-section="events" class="block off frame">
  <h2>Off the floor</h2>
  <p class="lede">The side events we are going to. Tell {{ sender_first | escape }} which ones you will be at and we can walk over together.</p>
  {%- assign prev_day = '' %}
  {%- for e in data.side_events %}
  {%- if e.day != prev_day %}
  {%- if prev_day != '' %}</ul></div>{% endif %}
  <div class="group">
  <h3>{{ e.day | escape }}</h3>
  <ul class="ev">
  {%- assign prev_day = e.day %}
  {%- endif %}
    <li><span class="t">{{ e.time | default: 'All day' | escape }}</span><div><b>{{ e.title | escape }}</b>{% if e.where and e.where != '' %}<span class="w">{{ e.where | escape }}</span>{% endif %}{% if e.note and e.note != '' %}<p class="n">{{ e.note | escape }}</p>{% endif %}{% if e.host and e.host != '' %}<p class="h">Hosted by {{ e.host | escape }}</p>{% endif %}</div></li>
  {%- endfor %}
  </ul></div>
</section>

<section data-section="meet" id="meet" class="where frame">
  <div>
    <h2>Where to find us</h2>
    <ul class="rows">
      {%- if data.venue and data.venue != '' %}<li>{{ data.venue | escape }}</li>{% endif %}
      <li>{{ data.hall | escape }}, booth {{ data.booth | escape }}</li>
      {%- if data.city and data.city != '' %}<li>{{ data.city | escape }}</li>{% endif %}
      <li>{{ data.dates_text | escape }}</li>
    </ul>
  </div>
  <div class="book">
    <h2>Pick a time</h2>
    <p class="lede">Choose a slot and it goes on both calendars. If none of them fits, come by the booth and ask for {{ sender_first | escape }}.</p>
    {% render 'ken/booking', title: 'Meet at the show', height: 560, color: accent %}
    <p class="after">Bring a colleague if you like. There is room for three at the back of the stand.</p>
  </div>
</section>
</main>
<footer class="foot frame">
  <p class="sign" aria-hidden="true">Booth {{ data.booth | escape }}</p>
  <p>This page was made for <b>{% if person.first_name %}{{ person.first_name | escape }} {{ person.last_name | escape }} at {% endif %}{{ account.name | escape }}</b> by {{ sender.name | default: company | escape }} at {{ company | escape }}. It is a private link.</p>
</footer>
</body>
</html>
