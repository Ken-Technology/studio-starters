{%- assign accent = brand.colors.primary | default: '#0f4c81' -%}
{%- assign accent2 = brand.colors.secondary | default: '#e3a82b' -%}
{%- assign font_head = brand.fonts.heading | default: 'Archivo' -%}
{%- assign font_body = brand.fonts.body | default: 'Archivo' -%}
{%- assign head_q = font_head | replace: ' ', '+' -%}
{%- assign body_q = font_body | replace: ' ', '+' -%}
{%- assign company = brand.name | default: sender.name | default: 'Our team' -%}
{%- assign sender_first = sender.name | default: 'us' | split: ' ' | first -%}
{%- assign has_talk = false -%}
{%- if data.talk.title and data.talk.title != '' -%}{%- assign has_talk = true -%}{%- endif -%}
{%- assign day_count = data.booth_hours | size -%}
{%- assign long_booth = false -%}
{%- assign booth_len = data.booth | size -%}
{%- if booth_len > 4 -%}{%- assign long_booth = true -%}{%- endif -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex">
<title>See you at {{ data.conference_name | escape }}</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ head_q }}:wght@400;500;700&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ body_q }}:wght@400;500;700&display=swap">
<style>
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%;scroll-behavior:smooth}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
body{margin:0;background:#f4f5f3;color:#16181d;font-family:'{{ font_body }}',ui-sans-serif,system-ui,sans-serif;font-size:16px;line-height:1.55;-webkit-font-smoothing:antialiased;font-variant-numeric:tabular-nums}
.cm{--p:{{ accent }};--s:{{ accent2 }};--ink:#16181d;--mute:#5d646d;--faint:#8b929a;--line:#dcdfe2;--card:#fff}
.cm h1,.cm h2,.cm h3,.cm .sign,.cm .talk-title{font-family:'{{ font_head }}',ui-sans-serif,system-ui,sans-serif;font-weight:700;letter-spacing:-.015em;line-height:1.1;margin:0}
.cm p{margin:0 0 .8rem}
.cm a{color:var(--p)}
.cm a:focus-visible,.cm .btn:focus-visible{outline:3px solid var(--p);outline-offset:3px}
.wrap{max-width:72rem;margin:0 auto;padding:0 1.1rem}
.top{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:.9rem 0;border-bottom:1px solid var(--line)}
.logo{height:26px;width:auto;display:block}
.brand{font-family:'{{ font_head }}',ui-sans-serif,system-ui,sans-serif;font-weight:700;font-size:1rem;color:var(--ink);text-decoration:none}
.top-show{font-size:.85rem;color:var(--mute);text-align:right;min-width:0}
.top-show b{display:block;font-weight:500;color:var(--ink)}
.hero{display:grid;gap:1.6rem;padding:2rem 0 2.2rem}
.for{font-size:.95rem;color:var(--mute);margin:0 0 .7rem}
.for b{font-weight:500;color:var(--ink)}
.cm h1{font-size:2.35rem;text-wrap:balance;max-width:16ch}
.dek{font-size:1.08rem;color:var(--mute);max-width:36rem;margin:1rem 0 1.4rem}
.dek b{font-weight:500;color:var(--ink)}
.go{display:flex;flex-wrap:wrap;align-items:center;gap:.7rem 1.1rem}
.cm a.btn{display:inline-block;background:var(--p);color:#fff;text-decoration:none;font-weight:600;padding:.8rem 1.25rem;border-radius:7px;line-height:1.3;min-height:44px}
.go span{font-size:.9rem;color:var(--mute);max-width:20rem}
.sign{position:relative;background:var(--p);color:#fff;border-radius:8px;padding:1.3rem 1.3rem 1.2rem;overflow:hidden;align-self:start;box-shadow:0 1px 0 rgba(0,0,0,.05)}
.sign::before{content:"";position:absolute;left:0;top:0;right:0;height:6px;background:var(--s)}
.sign-hall{font-size:.95rem;font-weight:500;opacity:.9;margin:.3rem 0 0}
.sign-num{font-size:5.6rem;line-height:.95;letter-spacing:-.04em;margin:.1rem 0 .3rem;word-break:break-word}
.sign-num.is-long{font-size:3.4rem;letter-spacing:-.03em}
.sign-brand{font-size:1.05rem;font-weight:700;padding-top:.8rem;border-top:1px solid rgba(255,255,255,.3)}
.sign-dates{font-size:.9rem;opacity:.85;font-family:'{{ font_body }}',ui-sans-serif,system-ui,sans-serif;font-weight:400;letter-spacing:0}
.note{background:var(--card);border:1px solid var(--line);border-left:4px solid var(--p);padding:1.2rem 1.2rem 1.1rem;margin:0 0 2.4rem}
.note p{font-size:1.06rem;max-width:44rem}
.note .hi{margin-bottom:.5rem}
.sig{margin-top:1rem;font-size:.95rem}
.sig b{display:block;font-weight:600}
.sig span{color:var(--mute);font-size:.88rem}
.cols{display:grid;gap:2.4rem;padding:0 0 3.5rem}
.main{min-width:0}
.block{margin:0 0 2.6rem}
.block h2{font-size:1.35rem;padding-bottom:.6rem;border-bottom:2px solid var(--ink);margin-bottom:1rem}
.lede{color:var(--mute);max-width:40rem}
.hrs{list-style:none;margin:0;padding:0}
.hrs li{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:.1rem .9rem;padding:.75rem 0;border-bottom:1px solid var(--line)}
.hrs b{font-weight:600}
.hrs .h{color:var(--ink);text-align:right;white-space:nowrap}
.hrs small{grid-column:1 / -1;color:var(--mute);font-size:.9rem}
.talk{background:var(--card);border:1px solid var(--line);padding:1.1rem 1.2rem;border-radius:8px}
.talk-title{font-size:1.25rem;margin:0 0 .6rem}
.meta{display:flex;flex-wrap:wrap;gap:.3rem 1.2rem;margin:0;padding:0;list-style:none;color:var(--mute);font-size:.95rem}
.meta b{font-weight:500;color:var(--ink)}
.day{margin:1.6rem 0 .3rem;font-size:1.02rem;color:var(--ink);font-weight:700}
.day:first-of-type{margin-top:.4rem}
.ev{list-style:none;margin:0;padding:0}
.ev li{display:grid;grid-template-columns:4.6rem minmax(0,1fr);gap:.15rem .9rem;padding:.8rem 0;border-top:1px solid var(--line)}
.ev .t{color:var(--ink);font-weight:500;font-size:.95rem;padding-top:.1rem}
.ev b{font-weight:600;display:block}
.ev .w{color:var(--mute);font-size:.92rem}
.ev .n{margin:.25rem 0 0;font-size:.95rem}
.ev .h{color:var(--faint);font-size:.84rem;margin-top:.2rem}
.meet{background:var(--card);border:1px solid var(--line);border-radius:8px;padding:1.3rem 1.2rem 1.2rem;align-self:start}
.meet h2{font-size:1.35rem;margin:0 0 .5rem}
.meet .lede{margin-bottom:1.1rem}
.meet .ken-booking{color:var(--mute)}
.meet .after{font-size:.9rem;color:var(--mute);margin:1rem 0 0}
.foot{font-size:.82rem;color:var(--mute);padding:1.2rem 0 2.4rem;border-top:1px solid var(--line)}
.foot b{font-weight:500;color:var(--ink)}
@media (min-width:700px){
body{font-size:17px}
.wrap{padding:0 2rem}
.hero{grid-template-columns:minmax(0,1fr) 19rem;gap:3rem;align-items:center;padding:3.4rem 0 3rem}
.cm h1{font-size:3.5rem}
.sign{padding:1.6rem 1.6rem 1.4rem}
.sign-num{font-size:7rem}
.sign-num.is-long{font-size:4.2rem}
.note{padding:1.5rem 1.7rem 1.4rem}
.hrs li{grid-template-columns:minmax(9rem,max-content) minmax(9rem,max-content) minmax(0,1fr);gap:.1rem 1.4rem}
.hrs small{grid-column:auto;font-size:.95rem}
.hrs .h{text-align:left}
}
@media (min-width:980px){
.cols{grid-template-columns:minmax(0,1fr) 23rem;gap:4rem}
.sign{padding:1.8rem 1.8rem 1.6rem}
.meet{position:sticky;top:1rem}
}
</style>
</head>
<body>
<main class="cm">
<div class="wrap">
<header class="top">
{%- if brand.logo_url %}<img class="logo" src="{{ brand.logo_url | escape }}" alt="{{ company | escape }}">{% else %}<span class="brand">{{ company | escape }}</span>{% endif -%}
<p class="top-show"><b>{{ data.conference_name | escape }}</b>{{ data.dates_text | escape }}</p>
</header>
<section data-section="hero" class="hero">
<div>
<p class="for">{% if person.first_name %}For <b>{{ person.first_name | escape }} {{ person.last_name | escape }}</b>{% if person.title %}, {{ person.title | escape }}{% endif %} at {{ account.name | escape }}{% else %}For the team at <b>{{ account.name | escape }}</b>{% endif %}</p>
<h1>See you at {{ data.conference_name | escape }}</h1>
<p class="dek">{{ data.dates_text | escape }}{% if data.venue and data.venue != '' %} at {{ data.venue | escape }}{% endif %}{% if data.city and data.city != '' %}, {{ data.city | escape }}{% endif %}. <b>{{ company | escape }}</b> is at booth {{ data.booth | escape }} in {{ data.hall | escape }}{% case day_count %}{% when 1 %} on {{ data.booth_hours[0].day | escape }}{% when 2 %} both days{% when 3 %} all three days{% when 4 %} all four days{% when 5 %} all five days{% else %} every day of the show{% endcase %}.</p>
<div class="go"><a class="btn" href="#meet">Pick a time at the show</a><span>20 minutes at the booth, or a coffee nearby. {{ sender_first | escape }} holds the slot.</span></div>
</div>
<aside class="sign" aria-label="Booth {{ data.booth | escape }} in {{ data.hall | escape }}">
<p class="sign-hall">{{ data.hall | escape }}</p>
<p class="sign-num{% if long_booth %} is-long{% endif %}">{{ data.booth | escape }}</p>
<p class="sign-brand">{{ company | escape }}<br><span class="sign-dates">{{ data.dates_text | escape }}</span></p>
</aside>
</section>
<section data-section="note" class="note">
{%- if person.first_name %}<p class="hi">{{ person.first_name | escape }},</p>{% endif %}
<p>{{ data.personal_line | escape }}</p>
<p class="sig"><b>{{ sender.name | default: company | escape }}</b><span>{% if sender.title %}{{ sender.title | escape }}, {% endif %}{{ company | escape }}</span></p>
</section>
<div class="cols">
<div class="main">
<section data-section="booth" class="block">
<h2>At the booth</h2>
{%- if data.booth_note and data.booth_note != '' %}<p class="lede">{{ data.booth_note | escape }}</p>{% endif %}
<ul class="hrs">
{%- for h in data.booth_hours %}
<li><b>{{ h.day | escape }}</b><span class="h">{{ h.hours | escape }}</span>{% if h.who and h.who != '' %}<small>{{ h.who | escape }}</small>{% endif %}</li>
{%- endfor %}
</ul>
</section>
{%- if has_talk %}
<section data-section="talk" class="block">
<h2>Our session</h2>
<div class="talk">
<p class="talk-title">{{ data.talk.title | escape }}</p>
<ul class="meta">
{%- if data.talk.day and data.talk.day != '' %}<li><b>{{ data.talk.day | escape }}</b>{% if data.talk.time and data.talk.time != '' %}, {{ data.talk.time | escape }}{% endif %}</li>{% endif %}
{%- if data.talk.stage and data.talk.stage != '' %}<li>{{ data.talk.stage | escape }}</li>{% endif %}
{%- if data.talk.speaker and data.talk.speaker != '' %}<li>{{ data.talk.speaker | escape }}</li>{% endif %}
</ul>
</div>
</section>
{%- endif %}
<section data-section="events" class="block">
<h2>Worth leaving the hall for</h2>
<p class="lede">The side events we are going to. Tell {{ sender_first | escape }} which ones you will be at and we can walk over together.</p>
{%- assign prev_day = '' %}
{%- for e in data.side_events %}
{%- if e.day != prev_day %}
{%- if prev_day != '' %}</ul>{% endif %}
<h3 class="day">{{ e.day | escape }}</h3>
<ul class="ev">
{%- assign prev_day = e.day %}
{%- endif %}
<li><span class="t">{{ e.time | default: 'All day' | escape }}</span><div><b>{{ e.title | escape }}</b>{% if e.where and e.where != '' %}<span class="w">{{ e.where | escape }}</span>{% endif %}{% if e.note and e.note != '' %}<p class="n">{{ e.note | escape }}</p>{% endif %}{% if e.host and e.host != '' %}<div class="h">Hosted by {{ e.host | escape }}</div>{% endif %}</div></li>
{%- endfor %}
</ul>
</section>
</div>
<section data-section="meet" id="meet" class="meet">
<h2>Pick a time</h2>
<p class="lede">Choose a slot and it goes on both calendars. If none of them fits, come by the booth and ask for {{ sender_first | escape }}.</p>
{% render 'ken/booking', title: 'Meet at the show', height: 560, color: accent %}
<p class="after">Bring a colleague if you like. There is room for three at the back of the stand.</p>
</section>
</div>
<p class="foot">This page was made for <b>{% if person.first_name %}{{ person.first_name | escape }} {{ person.last_name | escape }} at {% endif %}{{ account.name | escape }}</b> by {{ sender.name | default: company | escape }} at {{ company | escape }}. It is a private link.</p>
</div>
</main>
</body>
</html>
