{%- assign accent = brand.colors.primary | default: '#f53fd6' -%}
{%- assign accent2 = brand.colors.secondary | default: '#ffd249' -%}
{%- assign font_head = brand.fonts.heading | default: 'Josefin Sans' -%}
{%- assign font_body = brand.fonts.body | default: 'Karla' -%}
{%- assign head_q = font_head | replace: ' ', '+' -%}
{%- assign body_q = font_body | replace: ' ', '+' -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex">
<title>A note for {{ account.name | escape }}</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ head_q }}:wght@600;700&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ body_q }}:wght@400;500&display=swap">
<style>
:root{--p:{{ accent }};--s:{{ accent2 }};--ink:#0a0a0a;--paper:#ffffff;--fh:'{{ font_head }}',ui-sans-serif,system-ui,sans-serif;--fb:'{{ font_body }}',ui-sans-serif,system-ui,sans-serif;--m:clamp(1rem,3.2vw,2.5rem)}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:var(--paper);color:var(--ink);font:400 1.125rem/1.55 var(--fb);-webkit-font-smoothing:antialiased}
p{margin:0}
h1,h2{font-family:var(--fh);font-weight:600;margin:0;line-height:1.05;letter-spacing:-.02em}
.top{display:flex;align-items:center;min-height:3.75rem;padding:1rem var(--m) 0}
.top img{height:28px;width:auto;max-width:10rem;display:block}
.top b{font-family:var(--fh);font-weight:700;font-size:1.5rem}
.front{padding:5rem var(--m) 4rem;text-align:center;display:grid;justify-items:center;gap:1.5rem}
.front h1{font-size:clamp(2.5rem,5vw,4rem);max-width:16ch;text-wrap:balance}
.front p{font-size:1.5rem;line-height:1.45;max-width:28em;text-wrap:balance}
.next{background:color-mix(in srgb,var(--s) 40%,#fff);padding:4rem var(--m) 5rem;text-align:center;display:grid;justify-items:center;gap:1.5rem}
.next .ken-cta{display:inline-flex!important;align-items:center;min-height:52px;padding:0 1.75rem!important;background:var(--ink)!important;color:var(--paper)!important;border-radius:0!important;font-family:var(--fh);font-weight:700;text-decoration:none}
.ken-cta:focus-visible{outline:3px solid var(--ink);outline-offset:3px}
.sign b{display:block;font-family:var(--fh);font-weight:700;font-size:1.5rem}
</style>
</head>
<body>
<main>
<header class="top">
{%- if brand.logo_url %}<img src="{{ brand.logo_url | escape }}" alt="{{ brand.name | default: 'Logo' | escape }}">{% elsif brand.name %}<b>{{ brand.name | escape }}</b>{% endif -%}
</header>
<section data-section="occasion" class="front">
<h1>A note for {{ account.name | escape }}</h1>
<p>{% if person.first_name %}{{ person.first_name | escape }}, I{% else %}I{% endif %} am writing you a short note with one idea for the next 90 days at {{ account.name | escape }}. It is not on this page yet. The link stays the same, so check back later today.</p>
</section>
<section data-section="next" class="next">
<p>If you would rather hear it now, I have 15 minutes whenever suits you.</p>
{% render 'ken/cta', label: 'Book 15 minutes', kind: 'booking' %}
<p class="sign"><b>{{ sender.name | default: 'Our team' | escape }}</b>{% if sender.title %}{{ sender.title | escape }}{% if brand.name %}, {{ brand.name | escape }}{% endif %}{% elsif brand.name %}{{ brand.name | escape }}{% endif %}</p>
</section>
</main>
</body>
</html>
