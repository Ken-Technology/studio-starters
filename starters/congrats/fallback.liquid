{%- assign accent = brand.colors.primary | default: '#8a2a3e' -%}
{%- assign accent2 = brand.colors.secondary | default: '#c9a24a' -%}
{%- assign font_head = brand.fonts.heading | default: 'Instrument Sans' -%}
{%- assign font_body = brand.fonts.body | default: 'Newsreader' -%}
{%- assign head_q = font_head | replace: ' ', '+' -%}
{%- assign body_q = font_body | replace: ' ', '+' -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex">
<title>A note for {{ account.name | escape }}</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ head_q }}:wght@400;500;600;700&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ body_q }}:wght@400;500;600;700&display=swap">
<style>
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:#fcfbf8;color:#1f1b17;font-family:'{{ font_body }}',Georgia,'Times New Roman',serif;font-size:17px;line-height:1.6;-webkit-font-smoothing:antialiased}
.cg{--a:{{ accent }};--a2:{{ accent2 }};--ink:#1f1b17;--mute:#6f6861;--line:#e6e1d8}
.cg p{margin:0 0 1.1rem}
.cg a{color:var(--a)}
.cg h1,.cg-top,.cg-sign{font-family:'{{ font_head }}',ui-sans-serif,system-ui,sans-serif}
.cg-wrap{max-width:44rem;margin:0 auto;padding:0 1.25rem}
.cg-text{max-width:36rem}
.cg-top{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:.35rem 1.25rem;padding:1.05rem 0;border-bottom:1px solid var(--line);font-size:.9rem}
.cg-logo{height:26px;width:auto;display:block}
.cg-brand{font-weight:600;color:var(--ink);margin:0!important}
.cg-for{color:var(--mute);margin:0!important}
.cg-for b{font-weight:500;color:var(--ink)}
.cg-hero{padding:2.4rem 0 .6rem}
.cg h1{font-size:2.1rem;line-height:1.1;font-weight:600;letter-spacing:-.022em;margin:0 0 1.5rem;text-wrap:balance}
.cg-hi{font-size:1.45rem;line-height:1.3;font-weight:500;margin:0 0 1rem!important}
.cg-hero p,.cg-next p{font-size:1.125rem;line-height:1.6}
.cg-next{padding:.2rem 0 3.5rem}
.cg-btn{margin:1.3rem 0 1.5rem}
.cg-btn .ken-cta{background:var(--a)!important;border-radius:6px!important;font-family:'{{ font_head }}',ui-sans-serif,system-ui,sans-serif;font-size:1rem;line-height:1.3;min-height:44px}
.cg-sign{margin-top:2.2rem;padding-top:1.3rem;border-top:2px solid var(--a2);font-size:.95rem}
.cg-sign p{margin:0!important}
.cg-sign-name{font-weight:600;color:var(--ink)}
.cg-sign-title{color:var(--mute)}
@media (min-width:760px){
body{font-size:18px}
.cg-wrap{padding:0 2rem}
.cg-top{padding:1.25rem 0;font-size:.95rem}
.cg-hero{padding:3.6rem 0 .6rem}
.cg h1{font-size:3.4rem;line-height:1.04;margin:0 0 2rem}
.cg-hi{font-size:1.6rem}
.cg-hero p,.cg-next p{font-size:1.25rem;line-height:1.55}
.cg-next{padding:.4rem 0 5rem}
}
</style>
</head>
<body>
<main class="cg">
<div class="cg-wrap">
<header class="cg-top">
{%- if brand.logo_url %}<img class="cg-logo" src="{{ brand.logo_url | escape }}" alt="{{ brand.name | default: 'Logo' | escape }}">{% elsif brand.name %}<p class="cg-brand">{{ brand.name | escape }}</p>{% else %}<span></span>{% endif -%}
<p class="cg-for">For {% if person.first_name %}<b>{{ person.first_name | escape }} {{ person.last_name | escape }}</b>, {{ account.name | escape }}{% else %}the team at <b>{{ account.name | escape }}</b>{% endif %}</p>
</header>
<section data-section="occasion" class="cg-hero cg-text">
<h1>A note for {{ account.name | escape }}</h1>
<p class="cg-hi">{% if person.first_name %}{{ person.first_name | escape }},{% else %}To the team at {{ account.name | escape }},{% endif %}</p>
<p>I am writing you a short note with one idea for the next 90 days at {{ account.name | escape }}. It is not on this page yet. The link stays the same, so check back later today.</p>
</section>
<section data-section="next" class="cg-next cg-text">
<p>If you would rather hear it now, I have 15 minutes whenever suits you.</p>
<div class="cg-btn">{% render 'ken/cta', label: 'Book 15 minutes', kind: 'booking' %}</div>
<div class="cg-sign">
<p class="cg-sign-name">{{ sender.name | default: 'Our team' | escape }}</p>
<p class="cg-sign-title">{% if sender.title %}{{ sender.title | escape }}{% if brand.name %}, {{ brand.name | escape }}{% endif %}{% elsif brand.name %}{{ brand.name | escape }}{% endif %}</p>
</div>
</section>
</div>
</main>
</body>
</html>
