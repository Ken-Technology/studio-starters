{%- assign accent = brand.colors.primary | default: '#a1ffcb' -%}
{%- assign accent2 = brand.colors.secondary | default: '#232323' -%}
{%- assign font_head = brand.fonts.heading | default: 'Funnel Display' -%}
{%- assign font_body = brand.fonts.body | default: 'Funnel Sans' -%}
{%- assign us_name = brand.name | default: '' -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex">
<title>Deal room: {{ account.name | escape }}</title>
{%- if font_head == 'Funnel Display' %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Funnel+Display:wght@600&display=swap">
{%- else %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_head | url_encode }}&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_head | url_encode }}:wght@500&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_head | url_encode }}:wght@600&display=swap">
{%- endif %}
{%- if font_body != font_head %}
{%- if font_body == 'Funnel Sans' %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Funnel+Sans:wght@400;600&display=swap">
{%- else %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_body | url_encode }}&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_body | url_encode }}:wght@600&display=swap">
{%- endif %}
{%- endif %}
<style>
:root{--bg:#fff;--ink:#111;--them:color-mix(in srgb,{{ accent2 }} 75%,#000);--us:color-mix(in srgb,{{ accent }} 45%,#fff);--g:2.5rem;--fh:'{{ font_head }}',ui-sans-serif,system-ui,sans-serif;--fb:'{{ font_body }}',ui-sans-serif,system-ui,sans-serif;--m:clamp(1rem,3vw,2.5rem)}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:var(--bg);color:var(--ink);font:400 1.125rem/1.55 var(--fb);-webkit-font-smoothing:antialiased}
p{margin:0}
h1,h2{font-family:var(--fh);font-weight:600;margin:0;letter-spacing:-.015em;line-height:1.02}
.f{position:relative;padding:2.5rem var(--m);display:grid;gap:1.5rem}
.them{background:var(--them);color:#fff}
.them h1{font-size:clamp(2.5rem,5.4vw,5.25rem);max-width:14ch;text-wrap:balance}
.them p{font-size:1.5rem;line-height:1.4;max-width:30em}
.us{background:var(--us);padding-top:3.5rem}
.zip{position:absolute;left:0;top:-9px;width:18%;height:18px;background:repeating-linear-gradient(to right,var(--them) 0 9px,var(--us) 9px 18px)}
.us::before{content:'';position:absolute;right:0;top:0;width:82%;height:var(--g);background:var(--bg);clip-path:polygon(0 0,100% 0,100% 100%)}
.us h2{font-size:clamp(2rem,3.4vw,2.5rem)}
.us .b{font-weight:600}
.us img{height:32px;width:auto;max-width:11rem;display:block}
.ken-cta{display:inline-flex;align-items:center;justify-content:center;min-height:56px;padding:0 1.8rem;background:var(--ink);color:#fff;font-weight:600;text-decoration:none;border-radius:0}
.ken-cta:focus-visible{outline:3px solid var(--ink);outline-offset:3px}
</style>
</head>
<body>
<main>
<section data-section="head" class="f them">
<h1>{{ person.first_name | default: 'Hello' | escape }}, your deal room is on its way</h1>
<p>I am pulling together everything from our calls with {{ account.name | escape }}: the next meeting, the plan, who is involved and what to read. It is not on this page yet.</p>
</section>
<section data-section="booking" class="f us">
<div class="zip" aria-hidden="true"></div>
<h2>Want to talk now?</h2>
<p>Twenty minutes with {{ sender.name | default: 'us' | escape }}, at a time that suits you.</p>
<div>{% render 'ken/cta', label: 'Book 20 minutes', kind: 'booking', variant: 'link' %}</div>
{%- if brand.logo_url %}
<p><img src="{{ brand.logo_url | escape }}" alt="{{ us_name | default: 'Logo' | escape }}"></p>
{%- elsif us_name != '' %}
<p class="b">{{ us_name | escape }}</p>
{%- endif %}
</section>
</main>
</body>
</html>
