{%- assign accent = brand.colors.primary | default: '#a1ffcb' -%}
{%- assign accent2 = brand.colors.secondary | default: '#232323' -%}
{%- assign font_head = brand.fonts.heading | default: 'Funnel Display' -%}
{%- assign font_body = brand.fonts.body | default: 'Funnel Sans' -%}
{%- assign us_name = brand.name | default: '' -%}
{%- assign us_label = us_name | default: 'Our team' -%}
{%- comment -%} Is a brand color light? Brightness is (299 r + 587 g + 114 b) / 1000 of a hex color; 110 or more takes dark text. {%- endcomment -%}
{%- assign hx = '0123456789abcdef' -%}
{%- assign pair = accent | append: ',' | append: accent2 | split: ',' -%}
{%- assign lights = '' -%}
{%- assign lums = '' -%}
{%- for c in pair -%}
  {%- assign h = c | remove: '#' | strip | downcase -%}
  {%- assign ch = h | split: '' -%}
  {%- if ch.size == 3 -%}
    {%- assign h = ch[0] | append: ch[0] | append: ch[1] | append: ch[1] | append: ch[2] | append: ch[2] -%}
    {%- assign ch = h | split: '' -%}
  {%- endif -%}
  {%- assign light = 'n' -%}
  {%- assign lum = 0 -%}
  {%- if ch.size == 6 -%}
    {%- assign v0 = hx | split: ch[0] | first | size -%}
    {%- assign v1 = hx | split: ch[1] | first | size -%}
    {%- assign v2 = hx | split: ch[2] | first | size -%}
    {%- assign v3 = hx | split: ch[3] | first | size -%}
    {%- assign v4 = hx | split: ch[4] | first | size -%}
    {%- assign v5 = hx | split: ch[5] | first | size -%}
    {%- if v0 < 16 and v1 < 16 and v2 < 16 and v3 < 16 and v4 < 16 and v5 < 16 -%}
      {%- assign lr = v0 | times: 16 | plus: v1 | times: 299 -%}
      {%- assign lg = v2 | times: 16 | plus: v3 | times: 587 -%}
      {%- assign lb = v4 | times: 16 | plus: v5 | times: 114 -%}
      {%- assign lum = lr | plus: lg | plus: lb | divided_by: 1000 -%}
      {%- if lum >= 110 -%}{%- assign light = 'y' -%}{%- endif -%}
    {%- endif -%}
  {%- endif -%}
  {%- assign lights = lights | append: light -%}
  {%- assign lums = lums | append: lum | append: ',' -%}
{%- endfor -%}
{%- assign p_light = lights | slice: 0, 1 -%}
{%- assign s_light = lights | slice: 1, 1 -%}
{%- comment -%} Two fields that are about as bright would melt into one, so the account's field turns pale. {%- endcomment -%}
{%- assign lv = lums | split: ',' -%}
{%- assign l_gap = lv[0] | plus: 0 | minus: lv[1] | abs -%}

{%- assign n_facts = data.facts | size -%}
{%- assign n_agenda = data.agenda.items | size -%}
{%- assign n_plan = data.plan | size -%}
{%- assign n_their = data.their_people | size -%}
{%- assign n_our = data.our_people | size -%}
{%- assign n_res = data.resources | size -%}
{%- assign has_note = false -%}
{%- if data.note and data.note != '' -%}{%- assign has_note = true -%}{%- endif -%}
{%- assign has_main = false -%}
{%- if has_note or n_agenda > 0 or n_plan > 0 -%}{%- assign has_main = true -%}{%- endif -%}
{%- assign has_people = false -%}
{%- if n_their > 0 or n_our > 0 -%}{%- assign has_people = true -%}{%- endif -%}
{%- assign n_done = 0 -%}
{%- for s in data.plan -%}{%- if s.done -%}{%- assign n_done = n_done | plus: 1 -%}{%- endif -%}{%- endfor -%}
{%- comment -%} The zipper between the two fields is closed as far as the plan has got: 18 percent with nothing done, 82 with everything done. {%- endcomment -%}
{%- assign closed = 18 -%}
{%- if n_plan > 0 -%}{%- assign closed = n_done | times: 64 | divided_by: n_plan | plus: 18 -%}{%- endif -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex">
<title>Deal room: {{ account.name | escape }}{% if us_name != '' %} and {{ us_name | escape }}{% endif %}</title>
{%- if font_head == 'Funnel Display' %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Funnel+Display:wght@500;600&display=swap">
{%- else %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_head | url_encode }}&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_head | url_encode }}:wght@500&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_head | url_encode }}:wght@600&display=swap">
{%- endif %}
{%- if font_body != font_head %}
{%- if font_body == 'Funnel Sans' %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Funnel+Sans:wght@400;600&display=swap">
{%- else %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_body | url_encode }}&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_body | url_encode }}:wght@600&display=swap">
{%- endif %}
{%- endif %}
<style>
:root{
  --bg:#ffffff;
  --ink:#232323;
  --muted:#5c5c5c;
  --us:{{ accent }};
  {%- if p_light == 'y' %}
  --on-us:#111111;
  {%- else %}
  --on-us:#ffffff;
  {%- endif %}
  --both:#ececec;
  {%- if l_gap < 50 %}
  --them:color-mix(in srgb,{{ accent2 }} 14%,#fff);
  --on-them:#111111;
  --both:color-mix(in srgb,{{ accent }} 40%,#fff);
  {%- elsif s_light == 'y' %}
  --them:{{ accent2 }};
  --on-them:#111111;
  {%- else %}
  --them:{{ accent2 }};
  --on-them:#ffffff;
  {%- endif %}
  --c:{{ closed }}%;
  --g:2.5rem;
  --fh:'{{ font_head }}',ui-sans-serif,system-ui,sans-serif;
  --fb:'{{ font_body }}',ui-sans-serif,system-ui,sans-serif;
  --m:clamp(1rem,3vw,2.5rem);
}
/* text on a brand field: white under luminance .18, black above, so it passes AA for any colour */
@supports (color:color(from red xyz-d65 x y z)){:root{--on-us:color(from var(--us) xyz-d65 clamp(0,(.18 - y) * 1000000,.9505) clamp(0,(.18 - y) * 1000000,1) clamp(0,(.18 - y) * 1000000,1.089));--on-them:color(from var(--them) xyz-d65 clamp(0,(.18 - y) * 1000000,.9505) clamp(0,(.18 - y) * 1000000,1) clamp(0,(.18 - y) * 1000000,1.089))}}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:var(--bg);color:var(--ink);font:400 1.125rem/1.55 var(--fb);-webkit-font-smoothing:antialiased;font-variant-numeric:tabular-nums}
p{margin:0}
a{color:inherit;text-decoration-thickness:.08em;text-underline-offset:.2em}
a:focus-visible,.ken-cta:focus-visible{outline:3px solid currentColor;outline-offset:3px}
h1,h2,h3{font-family:var(--fh);font-weight:600;margin:0;letter-spacing:-.015em}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
.ken-cta{display:inline-flex;align-items:center;justify-content:center;min-height:56px;padding:0 1.8rem;font-weight:600;font-size:1.125rem;text-decoration:none;border-radius:0}

/* First screen: the account's field and ours, joined by a zipper that is closed as far as the plan has got. */
.head{display:grid}
.f{position:relative;padding:2rem var(--m) 2.5rem;display:flex;flex-direction:column;gap:1.5rem}
.them{background:var(--them);color:var(--on-them)}
.us{background:var(--us);color:var(--on-us);padding-top:3rem}
.them::after,.us::before{content:'';position:absolute;background:var(--bg)}
.them::after{right:0;bottom:0;width:calc(100% - var(--c));height:var(--g);clip-path:polygon(100% 0,100% 100%,0 100%)}
.us::before{right:0;top:0;width:calc(100% - var(--c));height:var(--g);clip-path:polygon(0 0,100% 0,100% 100%)}
.zip{position:absolute;left:0;top:-9px;width:var(--c);height:18px;background:repeating-linear-gradient(to right,var(--them) 0 9px,var(--us) 9px 18px);z-index:1} /* taste-skill-ignore: hard stops draw zipper teeth, not a fill */
.zip::after{content:'';position:absolute;right:-22px;top:50%;width:44px;height:22px;transform:translateY(-50%);background:var(--bg);border:3px solid var(--ink);border-radius:4px}
.names{font-size:clamp(2.5rem,5.4vw,5.25rem);line-height:.98;text-wrap:balance;overflow-wrap:break-word}
.name{font-family:var(--fh);font-weight:600;letter-spacing:-.015em}
.lede{font-size:1.5rem;line-height:1.4;max-width:30em}
.for{margin-top:auto;padding-top:1rem}
.logo img{height:32px;width:auto;max-width:11rem;display:block}
.facts{margin:0;display:grid;grid-template-columns:1fr 1fr;gap:1.25rem var(--m)}
.facts dt{font-size:1rem}
.facts dd{margin:0;font-family:var(--fh);font-weight:600;font-size:1.5rem;line-height:1.2}
.facts dd.d{font-family:var(--fb);font-weight:400;font-size:1rem;line-height:1.45;margin-top:.2rem}
.us .ken-cta{background:var(--on-us);color:var(--us)}
.us .ken-cta:hover{background:var(--them);color:var(--on-them)}

/* The rest of the room */
.wrap{padding:0 var(--m)}
.sec{padding-top:5rem;display:grid;gap:2rem}
.sec h2{font-size:clamp(2rem,3.4vw,2.5rem);line-height:1.1}
.sec .meta{font-size:1.125rem;margin-top:.5rem;color:var(--muted)}
.letter{font-size:1.5rem;line-height:1.45;max-width:32em}
.sig{margin-top:1.25rem}
.sig b{display:block;font-weight:600}
.sig span{color:var(--muted)}

.agenda{list-style:none;margin:0;padding:0;display:grid;gap:1.75rem}
.agenda li{display:grid;grid-template-columns:4.5rem minmax(0,1fr);gap:.2rem 1.25rem}
.agenda .t{font-family:var(--fh);font-weight:600;font-size:1.5rem;line-height:1.2;grid-row:1/4}
.agenda .ti{font-weight:600;font-size:1.5rem;line-height:1.25;font-family:var(--fh)}
.agenda .who{color:var(--muted)}

/* The plan is the zipper drawn out: every step a tooth on its owner's side, closed up to where we are. */
.key{display:flex;flex-wrap:wrap;gap:.5rem 1.5rem;font-size:1rem}
.key span{display:inline-flex;align-items:center;gap:.5rem}
.key i{width:1rem;height:1rem;display:block}
.key .k-them i{background:var(--them);outline:1px solid var(--ink)}
.key .k-us i{background:var(--us);outline:1px solid var(--ink)}
.key .k-both i{background:var(--both)}
.plan{list-style:none;margin:0;padding:0;display:grid;gap:.375rem}
.plan li{padding:1rem 1.25rem 1.1rem;display:grid;gap:.15rem;margin-left:var(--g)}
.plan li.done{margin-left:0}
.plan .st-them{background:var(--them);color:var(--on-them)}
.plan .st-us{background:var(--us);color:var(--on-us)}
.plan .st-both{background:var(--both)}
.plan .tt{font-family:var(--fh);font-weight:600;font-size:1.5rem;line-height:1.2}
.plan .ok{font-weight:600}
.plan .today{margin:1rem 0;padding:0;display:flex;align-items:center;gap:1rem;font-weight:600}
.plan .today::before{content:'';width:44px;height:22px;border:3px solid var(--ink);border-radius:4px;flex:none}

.people{display:grid;gap:.375rem}
.people > div{padding:1.75rem var(--m) 2rem}
.people .p-them{background:var(--them);color:var(--on-them)}
.people .p-us{background:var(--us);color:var(--on-us)}
.people h3{font-size:1.5rem;line-height:1.2}
.people ul{list-style:none;margin:1.25rem 0 0;padding:0;display:grid;gap:.9rem}
.people li b{display:block;font-weight:600}

.res{list-style:none;margin:0;padding:0;display:grid;gap:2rem}
.res li{display:grid;gap:.2rem;max-width:34em}
.res .tt{font-family:var(--fh);font-weight:600;font-size:1.5rem;line-height:1.2}
.res .k{color:var(--muted)}
.res a{display:inline-flex;align-items:center;min-height:44px;font-weight:600;justify-self:start}

.book{margin-top:6rem;background:var(--them);color:var(--on-them);padding:4.5rem var(--m) 2rem;display:grid;gap:1.5rem}
.book h2{font-size:clamp(2.5rem,6vw,5.25rem);line-height:1}
.book p{max-width:32em}
.book .ask{font-size:1.5rem;line-height:1.4}
.book .ken-cta{background:var(--us);color:var(--on-us)}
.book .ken-cta:hover{background:var(--bg);color:var(--ink)}
.foot{margin-top:3rem;font-size:1rem;display:grid;gap:.25rem}

@media (prefers-reduced-motion:no-preference){
  .zip{animation:zip 1.1s cubic-bezier(.3,.7,.2,1) .2s backwards}
  @keyframes zip{from{clip-path:inset(0 100% 0 0)}}
}

@media (min-width:600px){
  .people,.res{grid-template-columns:1fr 1fr;column-gap:var(--m)}
  .people{column-gap:.375rem}
}
@media (min-width:900px){
  :root{--g:4rem}
  .head{grid-template-columns:1fr 1fr;min-height:100svh}
  .f{padding:2.25rem var(--m) 2.5rem}
  .them{padding-right:calc(var(--m) + var(--g))}
  .us{padding-left:calc(var(--m) + var(--g))}
  .them::after{width:var(--g);height:calc(100% - var(--c));clip-path:polygon(100% 0,100% 100%,0 100%)}
  .us::before{left:0;right:auto;top:auto;bottom:0;width:var(--g);height:calc(100% - var(--c));clip-path:polygon(0 0,0 100%,100% 100%)}
  .zip{left:-9px;top:0;width:18px;height:var(--c);background:repeating-linear-gradient(to bottom,var(--them) 0 9px,var(--us) 9px 18px)} /* taste-skill-ignore: hard stops draw zipper teeth, not a fill */
  .zip::after{right:auto;left:50%;top:auto;bottom:-22px;width:22px;height:44px;transform:translateX(-50%)}
  .sec{grid-template-columns:4fr 8fr;column-gap:var(--m);padding-top:7.5rem}
  .sec > :first-child{grid-row:1/3}
  .us{justify-content:flex-end}
  .agenda li{grid-template-columns:5.5rem minmax(0,1fr) 12rem}
  .agenda .t{grid-row:1/3}
  .agenda .who{grid-column:3;grid-row:1;text-align:right;padding-top:.3rem}
  .plan{grid-template-columns:1fr 1fr;column-gap:0}
  .plan li{margin:0}
  .plan .st-them{grid-column:1;margin-right:calc(var(--g) / 2)}
  .plan .st-us{grid-column:2;margin-left:calc(var(--g) / 2)}
  .plan .st-both{grid-column:1/-1;margin:0 18%;background:linear-gradient(to right,var(--both) calc(50% - var(--g) / 2),transparent calc(50% - var(--g) / 2) calc(50% + var(--g) / 2),var(--both) calc(50% + var(--g) / 2))} /* taste-skill-ignore: hard stops split the step, not a fill */
  .plan .st-them.done{margin-right:0}
  .plan .st-us.done{margin-left:0}
  .plan .st-both.done{background:var(--both)}
  .plan .today{grid-column:1/-1;justify-content:center;flex-direction:column;gap:.5rem}
  .plan .today::before{width:22px;height:44px}
  .people{grid-template-columns:1fr 1fr}
  .res{grid-template-columns:1fr 1fr;column-gap:var(--m)}
  .book{margin-top:8rem;padding-top:6rem;grid-template-columns:minmax(0,1fr) auto;column-gap:var(--m);align-items:end}
  .book h2,.book .foot{grid-column:1/-1}
  @media (prefers-reduced-motion:no-preference){
    @keyframes zip{from{clip-path:inset(0 0 100% 0)}}
  }
}
@media print{
  .head{min-height:0}
  .zip{animation:none}
}
</style>
</head>
<body>
<main>
<section class="head" data-section="head">
<div class="f them">
<h1 class="names">{{ account.name | escape }}{% if us_name != '' %}<span class="sr"> and {{ us_name | escape }}</span>{% endif %}</h1>
<p class="lede">{{ data.lede | escape }}</p>
<p class="for">Deal room for {% if person.first_name and person.first_name != '' %}{{ person.first_name | escape }}{% if person.last_name and person.last_name != '' %} {{ person.last_name | escape }}{% endif %}{% if person.title and person.title != '' %}, {{ person.title | escape }}{% endif %}{% else %}the team at {{ account.name | escape }}{% endif %}</p>
</div>
<div class="f us">
<div class="zip" aria-hidden="true"></div>
<p class="names name" aria-hidden="true">{{ us_label | escape }}</p>
{%- if brand.logo_url %}
<p class="logo"><img src="{{ brand.logo_url | escape }}" alt="{{ us_label | escape }}"></p>
{%- endif %}
{%- if n_facts > 0 %}
<dl class="facts">
{%- for f in data.facts %}
<div><dt>{{ f.label | escape }}</dt><dd>{{ f.value | escape }}</dd>{% if f.detail and f.detail != '' %}<dd class="d">{{ f.detail | escape }}</dd>{% endif %}</div>
{%- endfor %}
</dl>
{%- endif %}
<div>{% render 'ken/cta', label: 'Book 20 minutes', kind: 'booking', id: 'booking-top', variant: 'link' %}</div>
</div>
</section>

<div class="wrap">
{%- if has_note %}
<section class="sec note" data-section="note">
<h2>From {{ sender.name | default: 'our team' | escape }}</h2>
<div>
<p class="letter">{{ data.note | escape | newline_to_br | strip_newlines | raw }}</p>
{%- if sender.name and sender.name != '' %}
<p class="sig"><b>{{ sender.name | escape }}</b><span>{% if sender.title and sender.title != '' %}{{ sender.title | escape }}{% if us_name != '' %}, {{ us_name | escape }}{% endif %}{% elsif us_name != '' %}{{ us_name | escape }}{% endif %}</span></p>
{%- endif %}
</div>
</section>
{%- endif %}

{%- if n_agenda > 0 %}
<section class="sec" data-section="agenda">
<div><h2>{{ data.agenda.heading | default: 'Agenda for the next meeting' | escape }}</h2>{% if data.agenda.meta and data.agenda.meta != '' %}<p class="meta">{{ data.agenda.meta | escape }}</p>{% endif %}</div>
<ol class="agenda">
{%- for a in data.agenda.items %}
<li><p class="t">{{ a.time | escape }}</p><p class="ti">{{ a.title | escape }}</p>{% if a.detail and a.detail != '' %}<p>{{ a.detail | escape }}</p>{% endif %}{% if a.who and a.who != '' %}<p class="who">{{ a.who | escape }}</p>{% endif %}</li>
{%- endfor %}
</ol>
</section>
{%- endif %}

{%- if n_plan > 0 %}
<section class="sec" data-section="plan">
<div><h2>Mutual action plan</h2><p class="meta">{% if n_done > 0 %}{{ n_done }} of {{ n_plan }} steps done{% else %}{{ n_plan }} steps{% endif %}</p></div>
<div>
<p class="key"><span class="k-them"><i></i>{{ account.name | escape }} owns</span><span class="k-us"><i></i>{{ us_label | escape }} owns</span><span class="k-both"><i></i>Both</span></p>
<ol class="plan">
{%- assign marked = false %}
{%- for s in data.plan %}
{%- case s.side %}{% when 'them' %}{% assign side = 'them' %}{% when 'us' %}{% assign side = 'us' %}{% else %}{% assign side = 'both' %}{% endcase %}
{%- unless s.done %}
{%- if marked == false and n_done > 0 %}
<li class="today">We are here</li>
{%- endif %}
{%- assign marked = true %}
{%- endunless %}
<li class="st-{{ side }}{% if s.done %} done{% endif %}"><p>{% if s.weekday and s.weekday != '' %}{{ s.weekday | escape }} {% endif %}{{ s.date | escape }}{% if s.done %}, <span class="ok">done</span>{% endif %}</p><p class="tt"><span class="sr">{% if s.done %}Done: {% else %}Up next: {% endif %}</span>{{ s.title | escape }}</p><p>{{ s.owner | escape }}</p></li>
{%- endfor %}
</ol>
</div>
</section>
{%- endif %}

{%- if has_people %}
<section class="sec" data-section="people">
<h2>Who is in the room</h2>
<div class="people">
{%- if n_their > 0 %}
<div class="p-them"><h3>{{ account.name | escape }}</h3><ul>
{%- for p in data.their_people %}
<li><b>{{ p.name | escape }}</b>{% if p.title and p.title != '' %}{{ p.title | escape }}{% endif %}</li>
{%- endfor %}
</ul></div>
{%- endif %}
{%- if n_our > 0 %}
<div class="p-us"><h3>{{ us_label | escape }}</h3><ul>
{%- for p in data.our_people %}
<li><b>{{ p.name | escape }}</b>{% if p.title and p.title != '' %}{{ p.title | escape }}{% endif %}</li>
{%- endfor %}
</ul></div>
{%- endif %}
</div>
</section>
{%- endif %}

{%- if n_res > 0 %}
<section class="sec" data-section="resources">
<h2>Resources</h2>
<ul class="res">
{%- for r in data.resources %}
{%- case r.kind %}{% when 'security' %}{% assign kl = 'Security' %}{% when 'pricing' %}{% assign kl = 'Pricing' %}{% when 'recording' %}{% assign kl = 'Recording' %}{% else %}{% assign kl = 'Document' %}{% endcase %}
<li><p class="k">{{ kl }}</p><p class="tt">{{ r.title | escape }}</p>{% if r.detail and r.detail != '' %}<p>{{ r.detail | escape }}</p>{% endif %}{% if r.url and r.url != '' %}<a href="{{ r.url | escape }}" target="_blank" rel="noopener noreferrer">{% if r.kind == 'recording' %}Watch{% else %}Open{% endif %}<span class="sr">: {{ r.title | escape }}</span></a>{% endif %}</li>
{%- endfor %}
</ul>
</section>
{%- endif %}
</div>

<section class="book" data-section="booking">
<h2>Need to talk sooner?</h2>
<div>
<p class="ask">Twenty minutes with {{ sender.name | default: 'us' | escape }}, at a time that suits you.</p>
{%- if has_main %}
<p>Or reply with changes to the plan and I will update this page.</p>
{%- endif %}
</div>
<div>{% render 'ken/cta', label: 'Book 20 minutes', kind: 'booking', variant: 'link' %}</div>
<footer class="foot">
<p>This page was made for {% if person.first_name and person.first_name != '' %}{{ person.first_name | escape }}{% if person.last_name and person.last_name != '' %} {{ person.last_name | escape }}{% endif %}{% if person.title and person.title != '' %}, {{ person.title | escape }}, {% else %} {% endif %}at {% endif %}{{ account.name | escape }}{% if sender.name and sender.name != '' %} by {{ sender.name | escape }}{% if us_name != '' %} at {{ us_name | escape }}{% endif %}{% endif %}.</p>
