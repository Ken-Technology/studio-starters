{%- assign accent = brand.colors.primary | default: '#6b1e2c' -%}
{%- assign font_head = brand.fonts.heading | default: 'Bodoni Moda' -%}
{%- assign font_body = brand.fonts.body | default: 'Jost' -%}
{%- assign first = person.first_name | default: 'there' -%}
{%- assign is_webinar = false -%}
{%- if data.format == 'webinar' -%}{%- assign is_webinar = true -%}{%- endif -%}
{%- assign seats = data.seats_left | default: 0 -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex">
<title>{{ data.event_name | escape }}</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_head | url_encode }}:wght@400;600&display=swap">
{%- if font_body != font_head %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_body | url_encode }}:wght@400;500&display=swap">
{%- endif %}
<style>
:root{--a:{{ accent | escape }};--ink:#2a1d20;--mute:#6c6164;--card:#fffefb;--line:#dccbcd;--fh:'{{ font_head | escape }}','Didot','Bodoni 72',Georgia,serif;--fb:'{{ font_body | escape }}','Futura','Avenir Next',ui-sans-serif,system-ui,sans-serif}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%;scroll-behavior:smooth}
body{margin:0;background:var(--a);color:var(--ink);font:16px/1.6 var(--fb);-webkit-font-smoothing:antialiased}
.suite{max-width:54rem;margin:0 auto;padding:1.6rem .75rem 2.5rem;display:grid;gap:.85rem}
.card{position:relative;background:var(--card);padding:1.6rem 1.25rem;box-shadow:0 1px 1px rgba(0,0,0,.18),0 14px 34px rgba(0,0,0,.22)}
h1,h2{font-family:var(--fh);font-weight:400;line-height:1.05;letter-spacing:-.01em;margin:0}
h2{font-size:1.7rem;margin-bottom:1.1rem}
p{margin:0 0 .9rem}
.invite{padding:3.6rem 1.4rem 2.2rem;text-align:center}
.invite::before{content:'';position:absolute;inset:.55rem;border:1px solid var(--line);border-color:color-mix(in srgb,var(--a) 35%,#fff);pointer-events:none}
.logo{height:26px;width:auto;display:block;margin:0 auto 1.2rem}
.brand{font-weight:500;font-size:.85rem;letter-spacing:.04em;margin:0 0 1rem}
.for{font-size:.95rem;color:var(--mute);margin:0 0 1.3rem}
.invite h1{font-size:2.6rem;margin:0 auto .7rem;max-width:14ch}
.kind{font-family:var(--fh);font-size:1.25rem;margin:0}
.orn{display:block;margin:1.1rem auto;color:var(--a)}
.when{font-family:var(--fh);font-size:1.4rem;line-height:1.2;margin:0 0 .2rem}
.hours{color:var(--mute);margin:0}
.letter{text-align:left;max-width:31rem;margin:1.8rem auto 0;padding-top:1.5rem;border-top:1px solid var(--line)}
.letter .sig{font-family:var(--fh);font-size:1.35rem;margin:1.2rem 0 0}
.jump{display:inline-block;margin-top:1.6rem;background:var(--a);color:#fff;text-decoration:none;font-weight:500;padding:.85rem 1.7rem;border-radius:999px}
.jump:focus-visible,.rsvp :focus-visible{outline:2px solid var(--a);outline-offset:3px}
.stamp{position:absolute;top:-.9rem;right:.5rem;width:4.8rem;height:4.8rem;border-radius:50%;background:var(--card);color:var(--a);border:2px solid var(--a);box-shadow:inset 0 0 0 3px var(--card),inset 0 0 0 4px var(--a);display:flex;flex-direction:column;align-items:center;justify-content:center;transform:rotate(-12deg);font-size:.66rem;line-height:1.1;text-align:center}
.stamp b{font-family:var(--fh);font-weight:600;font-size:1.65rem;line-height:1}
dl{margin:0}
dl div{padding:.75rem 0;border-top:1px solid var(--line)}
dl div:first-child{border-top:0;padding-top:0}
dt{font-size:.85rem;font-weight:500;color:var(--a)}
dd{margin:.1rem 0 0}
dd small{display:block;color:var(--mute);font-size:.9rem}
.agenda ol{list-style:none;margin:0;padding:0}
.agenda li{display:grid;grid-template-columns:4.6rem minmax(0,1fr);gap:.9rem;padding:.75rem 0;border-top:1px solid var(--line)}
.agenda li:first-child{border-top:0;padding-top:0}
.agenda .t{font-family:var(--fh);font-size:1.05rem;color:var(--a);padding-top:.05rem}
.agenda b{font-weight:500;display:block}
.agenda li p{margin:.15rem 0 0;color:var(--mute);font-size:.95rem}
.rsvp{scroll-margin-top:1rem}
.rsvp .left p{max-width:28rem}
.seats{font-family:var(--fh);font-size:1.2rem;color:var(--a)}
.rsvp form{display:grid;gap:.85rem}
.rsvp label{display:grid;gap:.3rem;font-size:.9rem;color:var(--mute)}
.rsvp input,.rsvp select,.rsvp textarea{font:inherit;font-size:1rem;width:100%;padding:.75rem .85rem;border:1px solid #cdbfc1;border-radius:3px;background:#fff;color:var(--ink)}
.rsvp button,.rsvp [type=submit]{font:inherit;font-weight:500;font-size:1rem;background:var(--a);color:#fff;border:0;border-radius:999px;padding:.9rem 1.7rem;cursor:pointer}
.rsvp .right{margin-top:1.2rem}
.decline{color:var(--mute);font-size:.92rem;margin:1.4rem 0 0}
@media (min-width:760px){
.suite{padding:3.5rem 1.5rem 4rem;grid-template-columns:1fr 1fr;gap:1.1rem}
.invite,.rsvp{grid-column:1/-1}
.invite{padding:4.4rem 3rem 3rem}
.invite h1{font-size:3.9rem}
.stamp{width:6.2rem;height:6.2rem;top:-1.4rem;right:-1.2rem;font-size:.78rem}
.stamp b{font-size:2.2rem}
.card{padding:2.2rem 2.2rem}
.rsvp{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.1fr);grid-template-rows:auto 1fr;column-gap:2.4rem;padding:2.6rem}
.rsvp .left{grid-column:1;grid-row:1}
.rsvp .right{grid-column:2;grid-row:1/3;margin:0}
.decline{grid-column:1;grid-row:2;align-self:end}
}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
</style>
</head>
<body>
<main class="suite">

<section data-section="invite" class="card invite">
{%- if seats > 0 %}
<p class="stamp"><b>{{ seats }}</b>{% if seats == 1 %}seat left{% else %}seats left{% endif %}</p>
{%- else %}
<p class="stamp"><b>Full</b>waitlist open</p>
{%- endif %}
{%- if brand.logo_url %}
<img class="logo" src="{{ brand.logo_url | escape }}" alt="{{ brand.name | default: 'Logo' | escape }}">
{%- elsif brand.name %}
<p class="brand">{{ brand.name | escape }}</p>
{%- endif %}
<p class="for">{% if person.first_name %}An invitation for {{ person.first_name | escape }}{% if person.last_name %} {{ person.last_name | escape }}{% endif %}<br>at {{ account.name | escape }}{% else %}An invitation for the team<br>at {{ account.name | escape }}{% endif %}</p>
<h1>{{ data.event_name | escape }}</h1>
<p class="kind">{% if is_webinar %}A webinar{% if data.platform and data.platform != '' %} on {{ data.platform | escape }}{% endif %}{% else %}A dinner{% if data.city and data.city != '' %} in {{ data.city | escape }}{% endif %}{% endif %}</p>
<svg class="orn" width="120" height="12" viewBox="0 0 120 12" aria-hidden="true"><path d="M0 6h50M70 6h50" stroke="currentColor" stroke-width="1"/><path d="M60 1l5 5-5 5-5-5z" fill="currentColor"/></svg>
<p class="when">{{ data.date_text | escape }}</p>
<p class="hours">{{ data.time_text | escape }}</p>
<div class="letter">
<p>Hi {{ first | escape }},</p>
<p>{{ data.why_you | escape | newline_to_br | strip_newlines }}</p>
{%- if is_webinar %}
<p>It's a small group with plenty of time for questions, so I'm asking a few people myself before it goes out more widely.</p>
{%- else %}
<p>It's one long table, so I'm asking a few people myself before the rest of the seats go out.</p>
{%- endif %}
<p class="sig">{{ sender.name | default: data.host | escape }}</p>
</div>
<a class="jump" href="#seat">Save my seat</a>
</section>

<section data-section="details" class="card details">
<h2>The details</h2>
<dl>
<div><dt>When</dt><dd>{{ data.date_text | escape }}<small>{{ data.time_text | escape }}</small></dd></div>
<div><dt>Where</dt><dd>
{%- if is_webinar -%}
Online{% if data.platform and data.platform != '' %}, on {{ data.platform | escape }}{% endif %}<small>The link comes by email once your seat is saved.</small>
{%- else -%}
{%- if data.venue and data.venue != '' %}{{ data.venue | escape }}{% else %}Venue to be confirmed{% endif %}{% if data.city and data.city != '' %}<small>{{ data.city | escape }}</small>{% endif %}
{%- endif -%}
</dd></div>
<div><dt>Hosted by</dt><dd>{{ data.host | escape }}</dd></div>
{%- if data.guests and data.guests != '' %}
<div><dt>Who's coming</dt><dd>{{ data.guests | escape }}</dd></div>
{%- endif %}
</dl>
</section>

<section data-section="agenda" class="card agenda">
<h2>{% if is_webinar %}What we'll cover{% else %}How the evening runs{% endif %}</h2>
<ol>
{%- for item in data.agenda %}
<li><span class="t">{{ item.time | escape }}</span><div><b>{{ item.title | escape }}</b>{% if item.note and item.note != '' %}<p>{{ item.note | escape }}</p>{% endif %}</div></li>
{%- endfor %}
</ol>
</section>

<section data-section="rsvp" class="card rsvp" id="seat">
<div class="left">
<h2>Will you join us?</h2>
{%- if seats > 0 %}
<p class="seats">{{ seats }} {% if seats == 1 %}seat{% else %}seats{% endif %} left</p>
<p>Leave your details and the seat is yours.{% unless is_webinar %} If there's anything you don't eat, say so and we'll sort it with the kitchen.{% endunless %}</p>
{%- else %}
<p class="seats">The table is full</p>
<p>Leave your details anyway. If a seat opens up, it goes to you first.</p>
{%- endif %}
</div>
<div class="right">
{%- if is_webinar %}
{% render 'ken/form', id: 'rsvp', fields: 'name*,email*,company,title', submit: 'Save my seat' %}
{%- else %}
{% render 'ken/form', id: 'rsvp', fields: 'name*,email*,company,dietary', submit: 'Save my seat' %}
{%- endif %}
</div>
<p class="decline">Can't make this one? Reply to my email and I'll send you {% if is_webinar %}the recording{% else %}the notes{% endif %} afterward.</p>
</section>

</main>
</body>
</html>
