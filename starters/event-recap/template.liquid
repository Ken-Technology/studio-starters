{%- assign brand_p = brand.colors.primary | default: '#bfb21a' -%}
{%- assign brand_s = brand.colors.secondary | default: '#181715' -%}
{%- assign font_head = brand.fonts.heading | default: 'Unbounded' -%}
{%- assign font_body = brand.fonts.body | default: 'Onest' -%}
{%- assign bname = brand.name | default: 'Northbeam' -%}
{%- assign first = person.first_name | default: '' -%}
{%- assign vu = data.video_url | default: '' | split: '#' | first | default: '' -%}
{%- assign provider = '' -%}
{%- if vu contains 'youtube.com/' or vu contains 'youtu.be/' -%}{%- assign provider = 'youtube' -%}
{%- elsif vu contains 'loom.com/' -%}{%- assign provider = 'loom' -%}
{%- elsif vu contains 'vimeo.com/' -%}{%- assign provider = 'vimeo' -%}
{%- elsif vu contains 'wistia.' -%}{%- assign provider = 'wistia' -%}
{%- endif -%}
{%- if provider == 'youtube' and vu contains 'v=' -%}{%- assign vid = vu | split: 'v=' | last | split: '&' | first -%}
{%- else -%}{%- assign vid = vu | split: '?' | first | split: '/' | last -%}{%- endif -%}
{%- assign has_video = false -%}
{%- if provider != '' and vid != '' -%}{%- assign has_video = true -%}{%- endif -%}
{%- comment -%} A link to a recording on a host that cannot be embedded (a Zoom or company page) opens in a new tab. {%- endcomment -%}
{%- assign has_link = false -%}
{%- if has_video == false and vu != '' -%}{%- assign vu_head = vu | slice: 0, 8 -%}{%- if vu_head == 'https://' -%}{%- assign has_link = true -%}{%- endif -%}{%- endif -%}
{%- comment -%} A chapter link loads the embed again with a start parameter, which differs by video host. {%- endcomment -%}
{%- case provider -%}
{%- when 'youtube' -%}{%- assign embed = 'https://www.youtube-nocookie.com/embed/' | append: vid -%}{%- assign seek_pre = '?start=' -%}{%- assign seek_post = '&autoplay=1' -%}
{%- when 'loom' -%}{%- assign embed = 'https://www.loom.com/embed/' | append: vid -%}{%- assign seek_pre = '?t=' -%}{%- assign seek_post = '&autoplay=1' -%}
{%- when 'vimeo' -%}{%- assign embed = 'https://player.vimeo.com/video/' | append: vid -%}{%- assign seek_pre = '?autoplay=1#t=' -%}{%- assign seek_post = 's' -%}
{%- when 'wistia' -%}{%- assign embed = 'https://fast.wistia.net/embed/iframe/' | append: vid -%}{%- assign seek_pre = '?wtime=' -%}{%- assign seek_post = 's' -%}
{%- endcase -%}
{%- assign chapters = data.chapters -%}
{%- assign has_ch = false -%}
{%- if chapters and chapters.size > 0 -%}{%- assign has_ch = true -%}{%- endif -%}
{%- assign takes = data.takeaways -%}
{%- assign has_takes = false -%}
{%- if takes and takes.size > 0 -%}{%- assign has_takes = true -%}{%- endif -%}
{%- assign pages = data.slide_pages -%}
{%- assign has_pages = false -%}
{%- if pages and pages.size > 0 -%}{%- assign has_pages = true -%}{%- endif -%}
{%- assign slides_url = data.slides_url | default: '' -%}
{%- assign has_slides = false -%}
{%- if slides_url != '' or pages and pages.size > 0 -%}{%- assign has_slides = true -%}{%- endif -%}
{%- assign tx = data.transcript -%}
{%- assign has_tx = false -%}
{%- if tx and tx.size > 0 -%}{%- assign has_tx = true -%}{%- endif -%}
{%- assign dur = data.duration_seconds | default: 0 -%}
{%- assign mins = dur | plus: 30 | divided_by: 60 | floor -%}
{%- assign recorded_on = data.recorded_on | default: '' -%}
{%- assign speakers = data.speakers | default: '' -%}
{%- assign room_for = 'you' -%}
{%- if person.title and person.title != '' and account.name -%}
{%- capture room_for -%}your role at {{ account.name }}{%- endcapture -%}
{%- elsif account.name -%}
{%- assign room_for = account.name -%}
{%- endif -%}
{%- comment -%} The drawn timeline: the recording's length, the chapter cuts and the reader's start point. {%- endcomment -%}
{%- assign tl_dur = dur -%}
{%- if tl_dur < 1 and has_ch -%}{%- assign last_ch = chapters | last -%}{%- assign tl_dur = last_ch.seconds | plus: 60 -%}{%- endif -%}
{%- assign start_at = data.start_at | default: 0 -%}
{%- assign tl_start = 0 -%}
{%- if tl_dur > 0 -%}{%- assign tl_start = start_at | times: 212.0 | divided_by: tl_dur | round: 1 -%}{%- endif -%}
{%- if tl_start > 212 -%}{%- assign tl_start = 212 -%}{%- endif -%}
{%- assign tl_head = tl_start | plus: 14 -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex">
<title>The recording of {{ data.event_title | escape }}</title>
{%- if font_head == 'Unbounded' %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Unbounded:wght@600;700&display=swap">
{%- else %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_head | url_encode }}&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_head | url_encode }}:wght@500&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_head | url_encode }}:wght@700&display=swap">
{%- endif %}
{%- if font_body != font_head %}
{%- if font_body == 'Onest' %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Onest:wght@400;700&display=swap">
{%- else %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_body | url_encode }}&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_body | url_encode }}:wght@700&display=swap">
{%- endif %}
{%- endif %}
<style>
:root{
  --brand-primary:{{ brand_p | escape }};
  --brand-secondary:{{ brand_s | escape }};
  --brand-heading-font:'{{ font_head | escape }}';
  --brand-body-font:'{{ font_body | escape }}';
  --p:var(--brand-primary);
  --s:var(--brand-secondary);
  --fh:var(--brand-heading-font),'Helvetica Neue',Arial,sans-serif;
  --fb:var(--brand-body-font),'Helvetica Neue',Arial,sans-serif;
  --paper:#e8e8e3;
  --surface:#dcdcd6;
  --ink:var(--s);
  --muted:#55544e;
  --on-p:#181715;
  --lit:var(--p);
  --night-muted:#a9a8a1;
  --n1:#22211f;
  --n2:#2b2a27;
  --n3:#34332f;
  --n4:#57564f;
  --m:clamp(1rem,3vw,2.5rem);
  --step-small:.875rem;
  --step-body:clamp(1.0625rem,1rem + .25vw,1.1875rem);
  --step-lead:clamp(1.3125rem,1.15rem + .7vw,1.75rem);
  --step-head:clamp(2.25rem,1.3rem + 3.8vw,4.75rem);
}
@supports (color:oklch(from red l c h)){
  :root{
    --ink:oklch(from var(--s) min(l,.24) c h);
    --on-p:oklch(from var(--p) clamp(.2,(.6 - l) * 1000,1) 0 h);
    --lit:oklch(from var(--p) max(l,.72) c h);
    --n1:color-mix(in oklab,var(--ink) 95%,#fff);
    --n2:color-mix(in oklab,var(--ink) 90%,#fff);
    --n3:color-mix(in oklab,var(--ink) 84%,#fff);
    --n4:color-mix(in oklab,var(--ink) 68%,#fff);
  }
}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%;scroll-behavior:smooth}
body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--fb);font-size:var(--step-body);line-height:1.5;-webkit-font-smoothing:antialiased;font-variant-numeric:tabular-nums}
h1,h2,h3{font-family:var(--fh);font-weight:500;margin:0;text-wrap:balance;hyphens:none}
h2{font-size:var(--step-head);line-height:.98;letter-spacing:-.04em;max-width:18ch}
h3{font-size:var(--step-lead);line-height:1.15;letter-spacing:-.02em}
p{margin:0}
a{color:inherit;text-underline-offset:.2em;text-decoration-thickness:.08em}
:focus-visible{outline:3px solid currentColor;outline-offset:3px}
::selection{background:var(--p);color:var(--on-p)}
.wrap{padding:0 var(--m)}
.band{padding:clamp(4.5rem,9vw,8.5rem) 0}

/* the sentence */
.top{padding:1.3rem 0 clamp(3.5rem,7vw,6rem)}
.bar{display:flex;justify-content:space-between;align-items:center;gap:1rem;min-height:2.5rem}
.mark{display:flex;align-items:center;gap:.6rem;font-family:var(--fh);font-weight:700;font-size:1.25rem;letter-spacing:-.02em}
.mark img{height:28px;width:auto;max-width:10rem;display:block}
.bar .sig{font-size:var(--step-small);text-align:right}
.bar .sig b{font-weight:700}
.top h1{margin-top:clamp(3rem,9vw,7rem);font-size:clamp(2.6rem,12.5vw,9.5rem);line-height:.94;letter-spacing:-.055em}
.top h1{display:flex;flex-direction:column;align-items:flex-start}
.top h1 .l{display:block;white-space:nowrap}
.top h1 .tl{order:3;display:block;width:100%;max-width:26rem;height:auto;margin-top:1.4rem}
.tl .scr{fill:var(--ink)}
.tl .trk{fill:var(--n4)}
.tl .cut{fill:var(--ink)}
.tl .run{fill:var(--lit);transform-box:fill-box;transform-origin:left center;animation:run 1.3s cubic-bezier(.2,.7,.2,1) .3s both}
.tl .head{fill:var(--lit)}
.tl .tri{fill:var(--paper)}
@keyframes run{from{transform:scaleX(0)}to{transform:scaleX(1)}}
.go{margin-top:1.8rem}
.btn{display:inline-flex;align-items:center;min-height:52px;padding:0 1.5rem;background:var(--p);color:var(--on-p);font-weight:700;text-decoration:none;transition:transform .15s ease}
.btn:hover{transform:translateY(-2px)}
.lede{margin-top:clamp(1.5rem,3vw,2.25rem);font-size:var(--step-lead);line-height:1.35;letter-spacing:-.01em;max-width:36ch}

/* the screening room */
.room{background:var(--ink);color:var(--paper)}
.room h2{margin-bottom:clamp(2rem,4vw,3.5rem)}
.player{display:block}
.vid{display:contents}
.frame{position:relative;aspect-ratio:16/9;background:var(--n2);overflow:hidden}
.frame.poster{display:block;aspect-ratio:4/3;color:inherit;text-decoration:none}
.frame .play{position:absolute;left:50%;top:56%;width:4rem;height:4rem;transform:translate(-50%,-50%);border-radius:50%;background:var(--lit);display:grid;place-items:center;transition:transform .15s ease}
.frame .play svg{width:1.3rem;height:1.3rem;margin-left:.2rem;fill:var(--ink)}
a.poster:hover .play{transform:translate(-50%,-50%) scale(1.06)}
.frame .bar2{position:absolute;left:1.1rem;right:1.1rem;bottom:.9rem;display:grid;grid-template-columns:1fr auto;align-items:center;gap:.8rem;font-size:var(--step-small);color:var(--night-muted)}
.frame .track{display:block;width:100%;height:10px}
.frame .track .t0{fill:var(--n4)}
.frame .track .t1{fill:var(--n2)}
.frame.live{position:sticky;top:0;z-index:3}
.frame iframe{position:absolute;inset:0;width:100%;height:100%;border:0;display:block;background:#000}
.frame .cap{position:absolute;left:1.1rem;top:1rem;right:1.1rem}
.frame .title{display:block;font-family:var(--fh);font-weight:500;font-size:var(--step-lead);line-height:1.15;letter-spacing:-.02em;color:var(--paper)}
.frame .sub{display:block;font-size:var(--step-small);line-height:1.4;color:var(--night-muted);margin-top:.35rem}
.frame .soon{position:absolute;left:1.1rem;right:1.1rem;bottom:1rem;margin:0;font-size:var(--step-small);line-height:1.4;color:var(--night-muted)}
.vid>.frame:last-child{margin-bottom:2rem}
.embed-note{margin:.9rem 0 2rem;font-size:var(--step-small);line-height:1.45;color:var(--night-muted)}
.embed-note b{display:block;color:var(--paper);font-weight:700;font-size:var(--step-body);margin-bottom:.15rem}
.scrub{display:block;width:100%;height:14px;margin:0 0 1.6rem}
.scrub .seg{fill:var(--n4)}
.scrub .seg.you{fill:var(--lit)}
.chapters h3{font-size:var(--step-lead);margin:0 0 .8rem}
.chapters ol{list-style:none;margin:0;padding:0;display:grid;gap:4px}
.chapters li{scroll-margin-top:calc((100vw - 2rem) * .5625 + 1.2rem)}
.chapters a,.chapters .row{display:grid;grid-template-columns:3.6rem minmax(0,1fr) auto;gap:.8rem;align-items:baseline;padding:.85rem .9rem;background:var(--n1);color:var(--paper);text-decoration:none;line-height:1.35}
.chapters a:hover{background:var(--n2)}
.chapters .t{font-weight:700}
.chapters .d{color:var(--night-muted);font-size:var(--step-small)}
.chapters li:target a,.chapters li:target .row{background:var(--n3)}
.chapters .you a,.chapters .you .row{background:var(--p);color:var(--on-p)}
.chapters .you .d{color:inherit}
.chapters .you .tag{display:block;font-weight:700;font-size:var(--step-small);margin-top:.2rem}

/* takeaways */
.takes-band .for{margin-top:1.2rem;font-size:var(--step-lead);line-height:1.35;max-width:30ch}
.takes{list-style:none;margin:clamp(2.5rem,5vw,3.5rem) 0 0;padding:0;display:grid;gap:clamp(2rem,4vw,3rem)}
.takes h3{margin-bottom:.6rem;max-width:26ch}
.takes p{max-width:52ch}
.takes a{display:inline-flex;align-items:center;min-height:44px;margin-top:.3rem;font-weight:700}

/* slides */
.slides-band{background:var(--surface)}
.sheet{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin:clamp(2rem,4vw,3rem) 0 1.4rem}
.slide{aspect-ratio:16/9;margin:0;padding:.8rem .9rem;display:flex;flex-direction:column;justify-content:space-between;background:var(--paper);overflow:hidden}
.slide:first-child{background:var(--ink);color:var(--paper)}
.slide span{font-size:var(--step-small);line-height:1.2}
.slide b{display:block;font-family:var(--fh);font-weight:500;font-size:var(--step-body);line-height:1.2;letter-spacing:-.01em}
.dl{display:inline-flex;flex-wrap:wrap;align-items:baseline;gap:.2rem .6rem;min-height:44px;font-weight:700}
.proof>.dl:first-child{margin-top:1.4rem}
.dl .ken-cta{color:inherit}
.dl small{font-weight:400;font-size:var(--step-small)}

/* transcript */
.tx-band{background:var(--ink);color:var(--paper)}
.tx-band .for{margin-top:1.2rem;color:var(--night-muted)}
.tx{margin-top:clamp(2rem,4vw,3rem);display:grid;gap:1.4rem;max-width:46rem}
.tx div{display:grid;grid-template-columns:3.6rem minmax(0,1fr);gap:.8rem;line-height:1.6}
.tx .t{color:var(--night-muted);font-size:var(--step-small);padding-top:.25rem}
.tx b{font-weight:700}
.tx-more{margin-top:1.6rem}
.tx-more a{display:inline-flex;align-items:center;min-height:44px;font-weight:700}

/* book */
.book{text-align:center}
.book h2{margin:0 auto;max-width:20ch}
h2.long{font-size:clamp(1.625rem,.85rem + 3.2vw,4.5rem);max-width:26ch}
.book p{margin:1.2rem auto 0;max-width:38ch;font-size:var(--step-lead);line-height:1.35}
.book .btn{margin-top:2rem}
.book .btn .ken-cta{display:inline-flex!important;align-items:center;min-height:56px;padding:0 1.8rem!important;background:var(--p)!important;color:var(--on-p)!important;border-radius:0!important;font-weight:700;font-size:var(--step-body);transition:transform .15s ease}
.book .btn .ken-cta:hover{transform:translateY(-2px)}
.book .alt{font-size:var(--step-body)}
footer{padding:0 0 2.5rem;font-size:var(--step-small);text-align:center}
footer b{font-weight:700}

@media (min-width:700px){
  .top h1{display:block}
  .top h1 .l{display:inline}
  .top h1 .l1{display:block}
  .top h1 .tl{display:inline-block;width:2.4em;max-width:none;height:.86em;margin:0 .14em 0 -.02em;vertical-align:-.06em}
  .sheet{grid-template-columns:repeat(3,minmax(0,1fr))}
  .frame.poster{aspect-ratio:16/9}
  .tx div{grid-template-columns:4.4rem minmax(0,1fr)}
}
@media (min-width:960px){
  .top h1{font-size:clamp(5rem,11vw,12.5rem)}
  .top .wrap{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));column-gap:1.5rem}
  .top .bar,.top h1{grid-column:1/13}
  .top .after{grid-column:7/13}
  .player{display:grid;grid-template-columns:minmax(0,7fr) minmax(0,5fr);gap:2.5rem;align-items:start}
  .player.one{grid-template-columns:minmax(0,46rem)}
  .vid{display:block}
  .frame.live{position:relative;top:auto;z-index:auto}
  .embed-note,.vid>.frame:last-child{margin-bottom:0}
  .chapters li{scroll-margin-top:2rem}
  .frame .cap{left:1.6rem;top:1.4rem;right:1.6rem}
  .frame .soon,.frame .bar2{left:1.6rem;right:1.6rem;bottom:1.3rem}
  .frame .play{top:50%;width:5.5rem;height:5.5rem}
  .frame .play svg{width:1.8rem;height:1.8rem}
  .split{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));column-gap:1.5rem;align-items:start}
  .split .head{grid-column:1/6}
  .split .proof{grid-column:6/13}
  .takes-band .head{grid-column:1/10}
  .takes-band .proof{grid-column:5/13;margin-top:clamp(2.5rem,5vw,4rem)}
  .takes-band h2,.takes-band h2.long{max-width:22ch}
  .sheet,.proof>.dl:first-child{margin-top:0}
  .tx{margin-top:0}
}
{%- if font_head == 'Unbounded' %}
/* Unbounded is wide: its own size steps, and looser tracking than a narrow brand face needs */
h1,h2,h3{font-weight:600}
.top h1{font-size:clamp(2rem,9.4vw,7.4rem);line-height:1;letter-spacing:-.02em}
h2{font-size:clamp(1.75rem,1rem + 3vw,3.7rem);line-height:1.02;letter-spacing:-.02em}
h2.long{font-size:clamp(1.3rem,.66rem + 2.5vw,3.5rem)}
h3,.mark{letter-spacing:-.015em}
@media (min-width:960px){
  .top h1{font-size:clamp(3.6rem,9.2vw,10.5rem)}
}
{%- endif %}
@media (prefers-reduced-motion:reduce){
  html{scroll-behavior:auto}
  .tl .run{animation:none}
  .frame .play,.book .btn .ken-cta,.btn{transition:none}
}
</style>
</head>
<body>
<header class="top" data-section="top">
  <div class="wrap">
    <div class="bar">
      <div class="mark">
        {%- if brand.logo_url and brand.logo_url != '' %}
        <img src="{{ brand.logo_url | escape }}" alt="{{ bname | escape }}">
        {%- else %}
        <span>{{ bname | escape }}</span>
        {%- endif %}
      </div>
      {%- if sender.name and sender.name != '' %}
      <p class="sig"><b>{{ sender.name | escape }}</b>{% if sender.title and sender.title != '' %}, {{ sender.title | escape }}{% endif %}, {{ bname | escape }}</p>
      {%- endif %}
    </div>
    <h1><span class="l l1">You missed it.</span> <svg class="tl" viewBox="0 0 240 90" aria-hidden="true">
    <rect class="scr" width="240" height="90"/>
    <rect class="trk" x="14" y="64" width="212" height="8"/>
    {%- if tl_dur > 0 %}{% for c in chapters %}{% if c.seconds > 0 %}<rect class="cut" x="{{ c.seconds | times: 212.0 | divided_by: tl_dur | plus: 13 | round: 1 }}" y="62" width="3" height="12"/>{% endif %}{% endfor %}{% endif -%}
    {%- if tl_start > 0 %}<rect class="run" x="14" y="64" width="{{ tl_start }}" height="8"/>{% endif -%}
    <circle class="head" cx="{{ tl_head }}" cy="68" r="9"/>
    <path class="tri" d="M108 22 L108 50 L132 36 Z"/>
    </svg><span class="l l2">Here it is.</span></h1>
    <div class="after">
    <p class="lede">
      {%- if first != '' %}{{ first | escape }}, you{% else %}You{% endif %} registered for “{{ data.event_title | escape }}”{% if recorded_on != '' %} on {{ recorded_on | escape }}{% endif %} and could not join on the day.
      {%- if mins > 0 %} The full {{ mins }} minutes are below{% if has_ch %}, cut into {{ chapters.size }} chapters{% endif %}{% else %} The full recording is below{% if has_ch %}, cut into chapters{% endif %}{% endif %}
      {%- if has_takes %}, with the three parts that matter most for {{ room_for | escape }}.{% else %}.{% endif %}
      {%- if has_slides and has_tx %} The slides and a piece of the transcript follow.
      {%- elsif has_slides %} The slides follow.
      {%- elsif has_tx %} A piece of the transcript follows.{% endif -%}
    </p>
    {%- if has_video or has_link or has_ch %}
    {%- assign go_at = '' -%}
    {%- for c in chapters -%}{%- if data.start_at == c.seconds -%}{%- assign go_at = c -%}{%- endif -%}{%- endfor %}
    <p class="go">{% if go_at != '' %}<a class="btn" href="#ch-{{ go_at.seconds }}">Watch from {{ go_at.start | escape }}</a>{% else %}<a class="btn" href="#recording">Watch the recording</a>{% endif %}</p>
    {%- endif %}
    </div>
  </div>
</header>

{%- if has_video or has_link or has_ch %}
<section class="room band" id="recording" data-section="recording">
  <div class="wrap">
    {%- assign ev_title = data.event_title | default: '' %}
    <h2{% if ev_title.size > 32 %} class="long"{% endif %}>{{ data.event_title | escape }}</h2>
    <div class="player{% unless has_ch %} one{% endunless %}">
      <div class="vid">
        {%- if has_video %}
        <div class="frame live">
          {%- case provider %}
          {%- when 'loom' %}
          <iframe name="recording" src="https://www.loom.com/embed/{{ vid | url_encode }}" title="Recording: {{ data.event_title | escape }}" loading="lazy" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe>
          {%- when 'youtube' %}
          <iframe name="recording" src="https://www.youtube-nocookie.com/embed/{{ vid | url_encode }}" title="Recording: {{ data.event_title | escape }}" loading="lazy" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe>
          {%- when 'vimeo' %}
          <iframe name="recording" src="https://player.vimeo.com/video/{{ vid | url_encode }}" title="Recording: {{ data.event_title | escape }}" loading="lazy" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe>
          {%- when 'wistia' %}
          <iframe name="recording" src="https://fast.wistia.net/embed/iframe/{{ vid | url_encode }}" title="Recording: {{ data.event_title | escape }}" loading="lazy" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe>
          {%- endcase %}
        </div>
        {%- else %}
        {%- if has_link %}
        <a class="frame poster" href="{{ vu | escape }}" target="_blank" rel="noopener noreferrer" data-ken-cta="recording" aria-label="Watch the recording: {{ data.event_title | escape }}">
        {%- else %}
        <div class="frame poster" role="img" aria-label="The recording is not available yet">
        {%- endif %}
          <span class="cap"><span class="title">{{ data.event_title | escape }}</span>{% if recorded_on != '' or speakers != '' %}<span class="sub">{% if recorded_on != '' %}Recorded {{ recorded_on | escape }}.{% endif %}{% if speakers != '' %} {{ speakers | escape }}{% endif %}</span>{% endif %}</span>
          {%- if has_link %}
          <span class="play" aria-hidden="true"><svg viewBox="0 0 20 20"><path d="M4 2.5v15l13-7.5z"/></svg></span>
          {%- if dur > 0 %}
          <span class="bar2" aria-hidden="true">
            <svg class="track" aria-hidden="true"><rect class="t0" x="0" y="3" width="100%" height="4"/>
              {%- for c in chapters %}{% if c.seconds > 0 %}<rect class="t1" x="{{ c.seconds | times: 100.0 | divided_by: dur | round: 1 }}%" y="0" width="3" height="10"/>{% endif %}{% endfor -%}
            </svg>
            <span class="time">0:00 / {{ dur | divided_by: 60 | floor }}:{% assign dur_s = dur | modulo: 60 %}{% if dur_s < 10 %}0{% endif %}{{ dur_s }}</span>
          </span>
          {%- endif %}
          {%- else %}
          <span class="soon">The video link is not ready yet. The chapters show where each part starts.</span>
          {%- endif %}
        {%- if has_link %}
        </a>
        {%- else %}
        </div>
        {%- endif %}
        {%- endif %}
        {%- if has_video %}
        <p class="embed-note"><b>{{ data.event_title | escape }}</b>
          {%- if recorded_on != '' %}Recorded {{ recorded_on | escape }}.{% endif %}{% if speakers != '' %} {{ speakers | escape }}{% endif %}{% if has_ch %} Chapter links start the video at that point.{% endif -%}
        </p>
        {%- elsif has_link %}
        <p class="embed-note">The recording opens in a new tab. The chapters show where each part starts.</p>
        {%- endif %}
      </div>
      {%- if has_ch %}
      <div class="chapters">
        <h3>Chapters</h3>
        {%- if tl_dur > 0 %}
        <svg class="scrub" viewBox="0 0 1000 14" preserveAspectRatio="none" aria-hidden="true">
          {%- for c in chapters %}
          {%- assign nxt = chapters[forloop.index] -%}
          {%- assign seg_end = tl_dur -%}
          {%- if nxt -%}{%- assign seg_end = nxt.seconds -%}{%- endif -%}
          {%- assign seg_x = c.seconds | times: 1000.0 | divided_by: tl_dur | round: 1 -%}
          {%- assign seg_w = seg_end | minus: c.seconds | times: 1000.0 | divided_by: tl_dur | minus: 6 | round: 1 -%}
          {%- if seg_w < 1 -%}{%- assign seg_w = 1 -%}{%- endif %}
          <rect class="seg{% if data.start_at == c.seconds %} you{% endif %}" x="{{ seg_x }}" y="0" width="{{ seg_w }}" height="14"/>
          {%- endfor %}
        </svg>
        {%- endif %}
        <ol>
          {%- for c in chapters %}
          {%- assign nxt = chapters[forloop.index] -%}
          {%- assign end_at = 0 -%}
          {%- if nxt -%}{%- assign end_at = nxt.seconds -%}{%- elsif dur > 0 -%}{%- assign end_at = dur -%}{%- endif -%}
          {%- assign len = end_at | minus: c.seconds -%}
          {%- assign len_s = len | modulo: 60 -%}
          {%- assign you = false -%}
          {%- if data.start_at == c.seconds -%}{%- assign you = true -%}{%- endif %}
          <li id="ch-{{ c.seconds }}"{% if you %} class="you"{% endif %}>
            {%- if has_video %}
            <a href="{{ embed | escape }}{{ seek_pre }}{{ c.seconds }}{{ seek_post }}" target="recording" data-ken-cta="chapter-{{ forloop.index }}">
            {%- else %}
            <div class="row">
            {%- endif %}
              <span class="t">{{ c.start | escape }}</span>
              <span>{{ c.title | escape }}{% if you %}<span class="tag">Start here{% if account.name %} for {{ account.name | escape }}{% endif %}</span>{% endif %}</span>
              <span class="d">{% if len > 0 %}{{ len | divided_by: 60 | floor }}:{% if len_s < 10 %}0{% endif %}{{ len_s }}{% endif %}</span>
            {%- if has_video %}
            </a>
            {%- else %}
            </div>
            {%- endif %}
          </li>
          {%- endfor %}
        </ol>
      </div>
      {%- endif %}
    </div>
  </div>
</section>
{%- endif %}

{%- if has_takes %}
<section class="takes-band band" data-section="takeaways">
  <div class="wrap split">
    <div class="head">
      {%- assign acct = account.name | default: '' %}
      <h2{% if acct.size > 16 %} class="long"{% endif %}>{% if account.name %}Three things for {{ account.name | escape }}{% else %}Three things to watch for{% endif %}</h2>
      <p class="for">Picked for {% if person.title and person.title != '' and account.name %}your role as {{ person.title | escape }} at {{ account.name | escape }}{% elsif account.name %}{{ account.name | escape }}{% else %}you{% endif %}.</p>
    </div>
    <ul class="takes proof">
      {%- for t in takes %}
      {%- assign t_start = '' -%}
      {%- if has_ch -%}
      {%- for c in chapters -%}{%- if c.seconds == t.at -%}{%- assign t_start = c.start -%}{%- endif -%}{%- endfor -%}
      {%- endif %}
      <li><h3>{{ t.title | escape }}</h3><p>{{ t.body | escape }}</p>{% if t_start != '' %}<a href="#ch-{{ t.at }}">Chapter at {{ t_start | escape }}</a>{% endif %}</li>
      {%- endfor %}
    </ul>
  </div>
</section>
{%- endif %}

{%- if has_slides %}
<section class="slides-band band" data-section="slides">
  <div class="wrap split">
    <div class="head">
      <h2>The slides</h2>
    </div>
    <div class="proof">
      {%- if pages and pages.size > 0 %}
      <div class="sheet">
        {%- for pg in pages %}
        <figure class="slide"><span>Page {{ pg.page }}</span><b>{{ pg.caption | escape }}</b></figure>
        {%- endfor %}
      </div>
      {%- endif %}
      {%- if slides_url != '' %}
      <p class="dl">{% render 'ken/cta', label: 'Download the slides', href: slides_url, variant: 'link', id: 'slides' %}{% if data.slide_count and data.slide_count > 0 %} <small>{{ data.slide_count }} pages</small>{% endif %}</p>
      {%- endif %}
    </div>
  </div>
</section>
{%- endif %}

{%- if has_tx %}
<section class="tx-band band" data-section="transcript">
  <div class="wrap split">
    <div class="head">
      <h2>From the transcript</h2>
      <p class="for">An excerpt from the recording, starting at {{ tx[0].at | escape }}.</p>
    </div>
    <div class="proof">
      <div class="tx">
        {%- for line in tx %}
        <div><span class="t">{{ line.at | escape }}</span><p><b>{{ line.speaker | escape }}:</b> {{ line.text | escape }}</p></div>
        {%- endfor %}
      </div>
      {%- if data.transcript_url and data.transcript_url != '' %}
      <p class="tx-more">{% render 'ken/cta', label: 'Read the full transcript', href: data.transcript_url, variant: 'link', id: 'transcript' %}</p>
      {%- endif %}
    </div>
  </div>
</section>
{%- endif %}

<section class="book band" data-section="book">
  <div class="wrap">
    {%- assign book_title = data.book_title | default: 'Want to talk it through?' %}
    <h2{% if book_title.size > 32 %} class="long"{% endif %}>{{ book_title | escape }}</h2>
    <p>{{ data.book_text | default: 'We can answer questions about your own setup in 20 minutes.' | escape }}</p>
    <div class="btn">{% render 'ken/cta', label: data.book_label, kind: 'booking' %}</div>
    <p class="alt">Or reply to the message this came with. Questions about your own setup are welcome.</p>
  </div>
</section>

<footer class="wrap">A recording from <b>{{ bname | escape }}</b>, made for {% if first != '' %}{{ person.first_name | escape }}{% if person.last_name and person.last_name != '' %} {{ person.last_name | escape }}{% endif %}{% if account.name %} at {{ account.name | escape }}{% endif %}{% elsif account.name %}{{ account.name | escape }}{% else %}you{% endif %}.</footer>
</body>
</html>
