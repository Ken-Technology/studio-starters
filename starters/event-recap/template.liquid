{%- assign brand_p = brand.colors.primary | default: '#2a4bd7' -%}
{%- assign brand_s = brand.colors.secondary | default: '#0e1530' -%}
{%- assign font_head = brand.fonts.heading | default: 'Inter Tight' -%}
{%- assign font_body = brand.fonts.body | default: 'Inter' -%}
{%- assign bname = brand.name | default: 'Northbeam' -%}
{%- assign first = person.first_name | default: '' -%}
{%- assign vu = data.video_url | default: '' | split: '#' | first | default: '' -%}
{%- assign provider = '' -%}
{%- if vu contains 'youtube.com/' or vu contains 'youtu.be/' -%}{%- assign provider = 'youtube' -%}
{%- elsif vu contains 'loom.com/' -%}{%- assign provider = 'loom' -%}
{%- elsif vu contains 'vimeo.com/' -%}{%- assign provider = 'vimeo' -%}
{%- elsif vu contains 'wistia.' -%}{%- assign provider = 'wistia' -%}
{%- endif -%}
{%- if provider == 'youtube' and vu contains 'v=' -%}{%- assign vid = vu | split: 'v=' | last | split: '&' | first -%}
{%- else -%}{%- assign vid = vu | split: '?' | first | split: '/' | last -%}{%- endif -%}
{%- assign has_video = false -%}
{%- if provider != '' and vid != '' -%}{%- assign has_video = true -%}{%- endif -%}
{%- comment -%} A link to a recording on a host that cannot be embedded (a Zoom or company page) opens in a new tab. {%- endcomment -%}
{%- assign has_link = false -%}
{%- if has_video == false and vu != '' -%}{%- assign vu_head = vu | slice: 0, 8 -%}{%- if vu_head == 'https://' -%}{%- assign has_link = true -%}{%- endif -%}{%- endif -%}
{%- comment -%} A chapter link loads the embed again with a start parameter, which differs by video host. {%- endcomment -%}
{%- case provider -%}
{%- when 'youtube' -%}{%- assign embed = 'https://www.youtube-nocookie.com/embed/' | append: vid -%}{%- assign seek_pre = '?start=' -%}{%- assign seek_post = '&autoplay=1' -%}
{%- when 'loom' -%}{%- assign embed = 'https://www.loom.com/embed/' | append: vid -%}{%- assign seek_pre = '?t=' -%}{%- assign seek_post = '&autoplay=1' -%}
{%- when 'vimeo' -%}{%- assign embed = 'https://player.vimeo.com/video/' | append: vid -%}{%- assign seek_pre = '?autoplay=1#t=' -%}{%- assign seek_post = 's' -%}
{%- when 'wistia' -%}{%- assign embed = 'https://fast.wistia.net/embed/iframe/' | append: vid -%}{%- assign seek_pre = '?wtime=' -%}{%- assign seek_post = 's' -%}
{%- endcase -%}
{%- assign chapters = data.chapters -%}
{%- assign has_ch = false -%}
{%- if chapters and chapters.size > 0 -%}{%- assign has_ch = true -%}{%- endif -%}
{%- assign takes = data.takeaways -%}
{%- assign has_takes = false -%}
{%- if takes and takes.size > 0 -%}{%- assign has_takes = true -%}{%- endif -%}
{%- assign pages = data.slide_pages -%}
{%- assign has_pages = false -%}
{%- if pages and pages.size > 0 -%}{%- assign has_pages = true -%}{%- endif -%}
{%- assign slides_url = data.slides_url | default: '' -%}
{%- assign has_slides = false -%}
{%- if slides_url != '' or pages and pages.size > 0 -%}{%- assign has_slides = true -%}{%- endif -%}
{%- assign tx = data.transcript -%}
{%- assign has_tx = false -%}
{%- if tx and tx.size > 0 -%}{%- assign has_tx = true -%}{%- endif -%}
{%- assign dur = data.duration_seconds | default: 0 -%}
{%- assign mins = dur | plus: 30 | divided_by: 60 | floor -%}
{%- assign recorded_on = data.recorded_on | default: '' -%}
{%- assign speakers = data.speakers | default: '' -%}
{%- assign room_for = 'you' -%}
{%- if person.title and person.title != '' and account.name -%}
{%- capture room_for -%}your role at {{ account.name }}{%- endcapture -%}
{%- elsif account.name -%}
{%- assign room_for = account.name -%}
{%- endif -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex">
<title>The recording of {{ data.event_title | escape }}</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_head | url_encode }}:wght@400;600&display=swap">
{%- if font_body != font_head %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_body | url_encode }}:wght@400;600&display=swap">
{%- endif %}
<style>
:root{
  --brand-primary:{{ brand_p | escape }};
  --brand-secondary:{{ brand_s | escape }};
  --brand-heading-font:'{{ font_head | escape }}';
  --brand-body-font:'{{ font_body | escape }}';
  --p:var(--brand-primary);
  --s:var(--brand-secondary);
  --fh:var(--brand-heading-font),ui-sans-serif,system-ui,sans-serif;
  --fb:var(--brand-body-font),ui-sans-serif,system-ui,sans-serif;
  --ink:var(--s);
  --mute:color-mix(in srgb,var(--s) 60%,#fff);
  --rule:color-mix(in srgb,var(--s) 13%,#fff);
  --tint:color-mix(in srgb,var(--p) 10%,#fff);
  --accent:color-mix(in srgb,var(--p) 86%,var(--s));
  --room:var(--s);
  --room-ink:#fff;
  --room-mute:color-mix(in srgb,#fff 62%,var(--s));
  --room-rule:color-mix(in srgb,#fff 14%,var(--s));
  --room-accent:color-mix(in srgb,var(--p) 38%,#fff);
}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%;scroll-behavior:smooth}
body{margin:0;background:#fff;color:var(--ink);font:17px/1.55 var(--fb);-webkit-font-smoothing:antialiased;font-variant-numeric:tabular-nums}
h1,h2,h3{font-family:var(--fh);font-weight:600;line-height:1.12;letter-spacing:-.018em;margin:0}
h2{font-size:1.5rem;margin-bottom:.9rem}
p{margin:0 0 .85rem}
a{color:var(--accent)}
a:focus-visible,button:focus-visible{outline:2px solid var(--accent);outline-offset:3px}
.wrap{max-width:68rem;margin:0 auto;padding:0 1.35rem}

/* top */
.top{padding:1.5rem 0 1.6rem}
.mark{display:flex;align-items:center;gap:.55rem;font-weight:600;font-size:.95rem}
.mark .logo{width:24px;height:24px;display:block;flex:none;border-radius:6px;object-fit:contain}
.mark span.logo{background:var(--p);color:#fff;font:700 .8rem/24px var(--fh);text-align:center}
.top h1{font-size:1.9rem;margin:1.6rem 0 .8rem;max-width:22ch}
.top .lede{max-width:40rem;font-size:1.06rem;line-height:1.6}
.top .sig{color:var(--mute);font-size:.95rem;margin:0}
.top .sig b{color:var(--ink);font-weight:600}

/* screening room */
.room{background:var(--room);color:var(--room-ink);padding:1.5rem 0 1.6rem}
.player{display:block}
.vid{display:contents}
.frame{position:relative;aspect-ratio:16/9;background:color-mix(in srgb,#000 35%,var(--room));border:1px solid var(--room-rule);overflow:hidden}
.frame.poster{display:block;color:inherit;text-decoration:none}
.frame .play{position:absolute;left:50%;top:60%;width:3rem;height:3rem;transform:translate(-50%,-50%);border-radius:50%;background:var(--p);display:grid;place-items:center;box-shadow:0 0 0 2px rgba(255,255,255,.5),0 10px 30px rgba(0,0,0,.4)}
.frame .play svg{position:static;width:1.1rem;height:1.1rem;margin-left:.15rem}
a.poster:hover .play{filter:brightness(1.12)}
.frame .bar{position:absolute;left:1.1rem;right:1.1rem;bottom:.9rem;display:grid;grid-template-columns:1fr auto;align-items:center;gap:.8rem;font-size:.8rem;color:var(--room-mute)}
.frame .track{display:block;width:100%;height:9px}
.frame.live{position:sticky;top:0;z-index:3;box-shadow:0 14px 18px -14px rgba(0,0,0,.6)}
.frame>svg{position:absolute;inset:0;width:100%;height:100%;display:block}
.frame iframe{position:absolute;inset:0;width:100%;height:100%;border:0;display:block;background:#000}
.frame .title{position:absolute;left:1.1rem;top:1rem;right:1.1rem;font-family:var(--fh);font-weight:600;font-size:1rem;line-height:1.25;letter-spacing:-.01em;color:var(--room-ink)}
.frame .title small{display:block;font-family:var(--fb);font-weight:400;font-size:.8rem;line-height:1.4;color:var(--room-mute);margin-top:.25rem}
.frame .soon{position:absolute;left:1.1rem;right:1.1rem;bottom:1rem;margin:0;font-size:.88rem;line-height:1.4;color:var(--room-mute)}
.embed-note{margin:.7rem 0 1.5rem;font-size:.86rem;line-height:1.45;color:var(--room-mute)}
.embed-note b{display:block;color:var(--room-ink);font-weight:600;font-size:.95rem;margin-bottom:.1rem}
.chapters h2{font-size:.88rem;font-variant-caps:all-small-caps;letter-spacing:.12em;font-weight:400;color:var(--room-mute);margin:0 0 .3rem;font-family:var(--fb)}
.chapters ol{list-style:none;margin:0;padding:0}
.chapters li{border-top:1px solid var(--room-rule);scroll-margin-top:calc((100vw - 2.7rem) * .5625 + 1.2rem)}
.chapters li:last-child{border-bottom:1px solid var(--room-rule)}
.chapters a,.chapters .row{display:grid;grid-template-columns:3.3rem minmax(0,1fr) auto;gap:.6rem;align-items:baseline;padding:.8rem 0;color:var(--room-ink);text-decoration:none;font-size:.95rem;line-height:1.35}
.chapters .t{color:var(--room-accent);font-weight:600;font-size:.9rem}
.chapters .d{color:var(--room-mute);font-size:.8rem}
.chapters a:hover span:nth-child(2){text-decoration:underline;text-underline-offset:3px}
.chapters li:target a,.chapters li:target .row{background:color-mix(in srgb,#fff 8%,transparent);margin:0 -.5rem;padding-left:.5rem;padding-right:.5rem}
.chapters .you a,.chapters .you .row{background:linear-gradient(to right,color-mix(in srgb,var(--room-accent) 17%,transparent),transparent);margin:0 -.5rem;padding-left:.5rem;padding-right:.5rem}
.chapters .you .tag{display:block;font-size:.76rem;color:var(--room-accent);margin-top:.1rem}

/* below */
section{padding:2rem 0;border-top:1px solid var(--rule)}
.cols{display:grid;gap:0;border-top:1px solid var(--rule)}
.cols>section{border-top:0}
.cols>section+section{border-top:1px solid var(--rule)}
.for{margin:-.3rem 0 1.2rem;color:var(--mute);font-size:.95rem}
.takes{list-style:none;margin:0;padding:0;display:grid;gap:1.3rem;max-width:40rem}
.takes li{display:grid;grid-template-columns:2rem minmax(0,1fr);gap:.6rem}
.takes .n{font-family:var(--fh);font-weight:600;color:var(--p);font-size:1.25rem;line-height:1.3}
.takes h3{font-size:1.1rem;letter-spacing:-.01em;margin-bottom:.3rem}
.takes p{margin:0 0 .1rem;color:color-mix(in srgb,var(--s) 85%,#fff)}
.takes a{display:inline-flex;align-items:center;min-height:44px;font-size:.9rem;text-decoration:underline;text-decoration-color:color-mix(in srgb,var(--accent) 40%,transparent);text-underline-offset:4px}

.slides{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.9rem;margin:0 0 1rem}
.slide{position:relative;aspect-ratio:16/9;margin:0;padding:.7rem .75rem .65rem;display:flex;flex-direction:column;justify-content:space-between;border:1px solid var(--rule);background:#fff;overflow:hidden}
.slide:first-child{background:var(--s);border-color:var(--s);color:#fff}
.slide i{display:block;width:.6rem;height:.6rem;border-radius:2px;background:var(--p)}
.slide:first-child i{background:var(--room-accent)}
.slide span{font-size:.72rem;line-height:1.2;color:var(--mute)}
.slide:first-child span{color:var(--room-mute)}
.slide b{display:block;font:600 .92rem/1.2 var(--fh);letter-spacing:-.01em}
.slide .meta{display:grid;gap:.3rem}
.dl{display:inline-flex;align-items:center;gap:.5rem;min-height:44px;font-weight:600;font-size:.98rem}
.dl svg{width:18px;height:18px;flex:none;color:var(--accent)}
.dl a{text-decoration:none}
.dl small{font-weight:400;color:var(--mute);font-size:.88rem}

.tx{max-width:40rem;border-left:2px solid var(--tint);padding-left:1.1rem;display:grid;gap:.9rem}
.tx div{display:grid;grid-template-columns:3.3rem minmax(0,1fr);gap:.6rem;font-size:.98rem;line-height:1.6}
.tx p{margin:0}
.tx .t{color:var(--accent);font-size:.84rem;font-weight:600;padding-top:.2rem}
.tx b{font-weight:600}
.tx-more{margin:.4rem 0 0;font-size:.95rem}
.tx-more a{display:inline-flex;align-items:center;min-height:44px}

.book{background:var(--tint);padding:1.6rem 1.35rem;margin:0 -1.35rem;border-top:0}
.book h2{margin-bottom:.4rem}
.book p{max-width:34rem}
.book .btn{margin-top:.4rem}
.book .btn .ken-cta{display:inline-block;background:var(--p) !important;color:#fff !important;font-weight:600;font-size:1rem;padding:.9rem 1.6rem !important;border-radius:6px !important;min-height:44px}
.book .alt{margin:1rem 0 0;font-size:.92rem;color:var(--mute)}
footer{padding:1.2rem 0 2rem;border-top:1px solid var(--rule);font-size:.86rem;color:var(--mute)}
footer b{color:var(--ink);font-weight:600}

@media (min-width:860px){
  .wrap{padding:0 2.5rem}
  .top{padding:2.4rem 0 2.2rem}
  .top h1{font-size:2.5rem}
  .room{padding:2.4rem 0 2.6rem}
  .player{display:grid;grid-template-columns:minmax(0,1.6fr) minmax(0,1fr);gap:2.4rem;align-items:start}
  .player.one{grid-template-columns:minmax(0,46rem)}
  .vid{display:block}
  .frame.live{position:relative;top:auto;z-index:auto;box-shadow:none}
  .embed-note{margin:.6rem 0 0}
  .chapters li{scroll-margin-top:2rem}
  .frame .title{font-size:1.2rem;left:1.5rem;top:1.3rem}
  .frame .soon{left:1.5rem;right:1.5rem;bottom:1.3rem}
  .frame .bar{left:1.5rem;right:1.5rem;bottom:1.3rem}
  .frame .play{top:50%;width:4.4rem;height:4.4rem}
  .frame .play svg{width:1.6rem;height:1.6rem}
  section{padding:2.8rem 0}
  .cols.two{grid-template-columns:minmax(0,1.3fr) minmax(0,1fr);gap:3.5rem;align-items:start}
  .cols.two>section+section{border-top:0}
  .book{margin:0;padding:2.4rem 2.6rem;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:.4rem 2.5rem;align-items:center}
  .book .btn{margin:0;white-space:nowrap}
  .book .alt{grid-column:1/-1;margin:0}
}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
</style>
</head>
<body>
<header class="top" data-section="top">
  <div class="wrap">
    <div class="mark">
      {%- if brand.logo_url and brand.logo_url != '' %}
      <img class="logo" src="{{ brand.logo_url | escape }}" alt="">
      {%- else %}
      <span class="logo" aria-hidden="true">{{ bname | slice: 0, 1 | upcase | escape }}</span>
      {%- endif %}
      <span>{{ bname | escape }}</span>
    </div>
    <h1>You missed the live session. {% if has_ch %}Here it is, cut into chapters.{% else %}Here is the recording.{% endif %}</h1>
    <p class="lede">
      {%- if first != '' %}{{ first | escape }}, you{% else %}You{% endif %} registered for “{{ data.event_title | escape }}”{% if recorded_on != '' %} on {{ recorded_on | escape }}{% endif %} and could not join on the day.
      {%- if mins > 0 %} The full {{ mins }} minutes are below{% else %} The full recording is below{% endif %}
      {%- if has_takes %}, with the three parts that matter most for {{ room_for | escape }}.{% else %}.{% endif %}
      {%- if has_slides and has_tx %} The slides and a piece of the transcript follow.
      {%- elsif has_slides %} The slides follow.
      {%- elsif has_tx %} A piece of the transcript follows.{% endif -%}
    </p>
    {%- if sender.name and sender.name != '' %}
    <p class="sig"><b>{{ sender.name | escape }}</b>{% if sender.title and sender.title != '' %}, {{ sender.title | escape }}{% endif %}, {{ bname | escape }}</p>
    {%- endif %}
  </div>
</header>

{%- if has_video or has_link or has_ch %}
<section class="room" data-section="recording">
  <div class="wrap">
    <div class="player{% unless has_ch %} one{% endunless %}">
      <div class="vid">
        {%- if has_video %}
        <div class="frame live">
          {%- case provider %}
          {%- when 'loom' %}
          <iframe name="recording" src="https://www.loom.com/embed/{{ vid | url_encode }}" title="Recording: {{ data.event_title | escape }}" loading="lazy" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe>
          {%- when 'youtube' %}
          <iframe name="recording" src="https://www.youtube-nocookie.com/embed/{{ vid | url_encode }}" title="Recording: {{ data.event_title | escape }}" loading="lazy" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe>
          {%- when 'vimeo' %}
          <iframe name="recording" src="https://player.vimeo.com/video/{{ vid | url_encode }}" title="Recording: {{ data.event_title | escape }}" loading="lazy" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe>
          {%- when 'wistia' %}
          <iframe name="recording" src="https://fast.wistia.net/embed/iframe/{{ vid | url_encode }}" title="Recording: {{ data.event_title | escape }}" loading="lazy" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe>
          {%- endcase %}
        </div>
        {%- else %}
        {%- if has_link %}
        <a class="frame poster" href="{{ vu | escape }}" target="_blank" rel="noopener noreferrer" data-ken-cta="recording" aria-label="Watch the recording: {{ data.event_title | escape }}">
        {%- else %}
        <div class="frame poster" role="img" aria-label="The recording is not available yet">
        {%- endif %}
          <svg viewBox="0 0 160 90" preserveAspectRatio="none" aria-hidden="true">
            <defs><linearGradient id="g" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#fff" stop-opacity=".07"/><stop offset="1" stop-color="#000" stop-opacity=".25"/></linearGradient></defs>
            <rect width="160" height="90" fill="url(#g)"/>
          </svg>
          <span class="title">{{ data.event_title | escape }}{% if recorded_on != '' or speakers != '' %}<small>{% if recorded_on != '' %}Recorded {{ recorded_on | escape }}.{% endif %}{% if speakers != '' %} {{ speakers | escape }}{% endif %}</small>{% endif %}</span>
          {%- if has_link %}
          <span class="play" aria-hidden="true"><svg viewBox="0 0 20 20" fill="#fff"><path d="M4 2.5v15l13-7.5z"/></svg></span>
          {%- if dur > 0 %}
          <span class="bar" aria-hidden="true">
            <svg class="track" aria-hidden="true"><line x1="0" x2="100%" y1="4.5" y2="4.5" stroke="rgba(255,255,255,.22)" stroke-width="3"/><g stroke="rgba(255,255,255,.6)" stroke-width="1">
              {%- for c in chapters %}{% if c.seconds > 0 %}<line x1="{{ c.seconds | times: 100.0 | divided_by: dur | round: 1 }}%" x2="{{ c.seconds | times: 100.0 | divided_by: dur | round: 1 }}%" y1="0" y2="9"/>{% endif %}{% endfor -%}
            </g></svg>
            <span class="time">0:00 / {{ dur | divided_by: 60 | floor }}:{% assign dur_s = dur | modulo: 60 %}{% if dur_s < 10 %}0{% endif %}{{ dur_s }}</span>
          </span>
          {%- endif %}
          {%- else %}
          <span class="soon">The video link is not ready yet. The chapters show where each part starts.</span>
          {%- endif %}
        {%- if has_link %}
        </a>
        {%- else %}
        </div>
        {%- endif %}
        {%- endif %}
        {%- if has_video %}
        <p class="embed-note"><b>{{ data.event_title | escape }}</b>
          {%- if recorded_on != '' %}Recorded {{ recorded_on | escape }}.{% endif %}{% if speakers != '' %} {{ speakers | escape }}{% endif %}{% if has_ch %} Chapter links start the video at that point.{% endif -%}
        </p>
        {%- elsif has_link %}
        <p class="embed-note">The recording opens in a new tab. The chapters show where each part starts.</p>
        {%- endif %}
      </div>
      {%- if has_ch %}
      <div class="chapters">
        <h2>Chapters</h2>
        <ol>
          {%- for c in chapters %}
          {%- assign nxt = chapters[forloop.index] -%}
          {%- assign end_at = 0 -%}
          {%- if nxt -%}{%- assign end_at = nxt.seconds -%}{%- elsif dur > 0 -%}{%- assign end_at = dur -%}{%- endif -%}
          {%- assign len = end_at | minus: c.seconds -%}
          {%- assign len_s = len | modulo: 60 -%}
          {%- assign you = false -%}
          {%- if data.start_at == c.seconds -%}{%- assign you = true -%}{%- endif %}
          <li id="ch-{{ c.seconds }}"{% if you %} class="you"{% endif %}>
            {%- if has_video %}
            <a href="{{ embed | escape }}{{ seek_pre }}{{ c.seconds }}{{ seek_post }}" target="recording" data-ken-cta="chapter-{{ forloop.index }}">
            {%- else %}
            <div class="row">
            {%- endif %}
              <span class="t">{{ c.start | escape }}</span>
              <span>{{ c.title | escape }}{% if you %}<span class="tag">Start here{% if account.name %} for {{ account.name | escape }}{% endif %}</span>{% endif %}</span>
              <span class="d">{% if len > 0 %}{{ len | divided_by: 60 | floor }}:{% if len_s < 10 %}0{% endif %}{{ len_s }}{% endif %}</span>
            {%- if has_video %}
            </a>
            {%- else %}
            </div>
            {%- endif %}
          </li>
          {%- endfor %}
        </ol>
      </div>
      {%- endif %}
    </div>
  </div>
</section>
{%- endif %}

<div class="wrap">
  {%- if has_takes or has_slides %}
  <div class="cols{% if has_takes and has_pages %} two{% endif %}">
    {%- if has_takes %}
    <section data-section="takeaways">
      <h2>{% if account.name %}Three things for {{ account.name | escape }}{% else %}Three things to watch for{% endif %}</h2>
      <p class="for">Picked for {% if person.title and person.title != '' and account.name %}your role as {{ person.title | escape }} at {{ account.name | escape }}{% elsif account.name %}{{ account.name | escape }}{% else %}you{% endif %}.</p>
      <ol class="takes">
        {%- for t in takes %}
        {%- assign t_start = '' -%}
        {%- if has_ch -%}
        {%- for c in chapters -%}{%- if c.seconds == t.at -%}{%- assign t_start = c.start -%}{%- endif -%}{%- endfor -%}
        {%- endif %}
        <li><span class="n" aria-hidden="true">{{ forloop.index }}</span><div><h3>{{ t.title | escape }}</h3><p>{{ t.body | escape }}</p>{% if t_start != '' %}<a href="#ch-{{ t.at }}">Chapter at {{ t_start | escape }}</a>{% endif %}</div></li>
        {%- endfor %}
      </ol>
    </section>
    {%- endif %}
    {%- if has_slides %}
    <section data-section="slides">
      <h2>The slides</h2>
      {%- if pages and pages.size > 0 %}
      <div class="slides">
        {%- for pg in pages %}
        <figure class="slide"><i aria-hidden="true"></i><div class="meta"><span>Page {{ pg.page }}</span><b>{{ pg.caption | escape }}</b></div></figure>
        {%- endfor %}
      </div>
      {%- endif %}
      {%- if slides_url != '' %}
      <p class="dl"><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M10 3v10M6 9l4 4 4-4M4 16h12"/></svg>{% render 'ken/cta', label: 'Download the slides', href: slides_url, variant: 'link', id: 'slides' %}{% if data.slide_count and data.slide_count > 0 %} <small>{{ data.slide_count }} pages</small>{% endif %}</p>
      {%- endif %}
    </section>
    {%- endif %}
  </div>
  {%- endif %}

  {%- if has_tx %}
  <section data-section="transcript">
    <h2>From the transcript</h2>
    <p class="for">An excerpt from the recording, starting at {{ tx[0].at | escape }}.</p>
    <div class="tx">
      {%- for line in tx %}
      <div><span class="t">{{ line.at | escape }}</span><p><b>{{ line.speaker | escape }}:</b> {{ line.text | escape }}</p></div>
      {%- endfor %}
    </div>
    {%- if data.transcript_url and data.transcript_url != '' %}
    <p class="tx-more">{% render 'ken/cta', label: 'Read the full transcript', href: data.transcript_url, variant: 'link', id: 'transcript' %}</p>
    {%- endif %}
  </section>
  {%- endif %}

  <section class="book" data-section="book">
    <div>
      <h2>{{ data.book_title | default: 'Want to talk it through?' | escape }}</h2>
      <p>{{ data.book_text | default: 'We can answer questions about your own setup in 20 minutes.' | escape }}</p>
    </div>
    <div class="btn">{% render 'ken/cta', label: data.book_label, kind: 'booking' %}</div>
    <p class="alt">Or reply to the message this came with. Questions about your own setup are welcome.</p>
  </section>

  <footer>A recording from <b>{{ bname | escape }}</b>, made for {% if first != '' %}{{ person.first_name | escape }}{% if person.last_name and person.last_name != '' %} {{ person.last_name | escape }}{% endif %}{% if account.name %} at {{ account.name | escape }}{% endif %}{% elsif account.name %}{{ account.name | escape }}{% else %}you{% endif %}.</footer>
</div>
</body>
</html>
