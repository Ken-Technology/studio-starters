{%- assign primary = brand.colors.primary | default: '#f4b9cb' -%}
{%- assign secondary = brand.colors.secondary | default: '#1a2039' -%}
{%- assign font_head = brand.fonts.heading | default: 'Literata' -%}
{%- assign font_body = brand.fonts.body | default: 'Literata' -%}
{%- assign head_q = font_head | replace: ' ', '+' -%}
{%- assign body_q = font_body | replace: ' ', '+' -%}
{%- assign org = brand.name | default: sender.name | default: 'Northbeam' -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex">
<title>A dinner invitation for {{ account.name | escape }}</title>
{%- if font_head == 'Literata' %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Literata:ital,opsz,wght@0,7..72,400;0,7..72,500;1,7..72,400&display=swap">
{%- else %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ head_q }}:wght@400;500&display=swap">
{%- endif %}
{%- if font_body != font_head %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ body_q }}:wght@400;500&display=swap">
{%- endif %}
<style>
:root{
  --p:{{ primary | escape }};
  --s:{{ secondary | escape }};
  --fh:'{{ font_head | escape }}',Georgia,'Times New Roman',serif;
  --fb:'{{ font_body | escape }}',Georgia,'Times New Roman',serif;
  --cloth:color-mix(in srgb,var(--s) 80%,#000);
  --paper:color-mix(in srgb,var(--p) 70%,#fff);
  --print:color-mix(in srgb,var(--s) 70%,#000);
  --ital:{% if font_head == 'Literata' %}italic{% else %}normal{% endif %};
}
@supports (color:oklch(from red l c h)){:root{
  --cloth:oklch(from var(--s) min(l,.27) min(c,.09) h);
  --paper:oklch(from var(--p) max(l,.84) min(c,.12) h);
  --print:oklch(from var(--s) min(l,.25) min(c,.09) h);
}}
*{box-sizing:border-box}
html,body{background:var(--cloth)}
body{margin:0;min-height:100vh;color:var(--paper);font:400 1.125rem/1.6 var(--fb);-webkit-font-smoothing:antialiased;padding:1.1rem 1rem 3rem}
p{margin:0}
.mark{display:inline-flex;align-items:center;gap:.6rem;font-family:var(--fh);font-weight:500;max-width:80rem}
.mark img{height:26px;width:auto;max-width:9rem;display:block}
.card{position:relative;max-width:40rem;margin:1.6rem auto 0;background:var(--paper);color:var(--print);padding:3rem 1.5rem 3rem;text-align:center}
.card::before,.card::after{content:'';position:absolute;top:-12px;width:24px;height:24px;border-radius:50%;background:var(--cloth)}
.card::before{left:-12px}
.card::after{right:-12px}
.name{font-family:var(--fh);font-style:var(--ital);font-size:clamp(2.5rem,1rem + 5vw,4.5rem);line-height:1;letter-spacing:-.03em;text-wrap:balance}
.dia{display:block;width:10px;height:10px;margin:1.6rem auto;background:currentColor;transform:rotate(45deg)}
h1{font-family:var(--fh);font-weight:500;font-size:clamp(1.6rem,1rem + 2vw,2.4rem);line-height:1.1;letter-spacing:-.02em;margin:0 auto;max-width:20ch;text-wrap:balance}
.body{max-width:30rem;margin:1rem auto 0;text-align:left}
.sig{max-width:30rem;margin:1.4rem auto 1.6rem;text-align:left}
.sig b{display:block;font-family:var(--fh);font-style:var(--ital);font-weight:500;font-size:1.3rem}
.sig span{font-size:.95rem}
.ken-cta{background:var(--print)!important;color:var(--paper)!important;border-radius:0!important}
.ken-cta:focus-visible{outline:3px solid var(--print);outline-offset:3px}
@media (min-width:760px){body{padding:1.5rem 2rem 4rem}.card{padding:4rem 3.5rem}}
</style>
</head>
<body>
<p class="mark">{%- if brand.logo_url %}<img src="{{ brand.logo_url | escape }}" alt="">{% endif %}<span>{{ org | escape }}</span></p>
<main class="card">
  <header data-section="face">
    <p class="name">{% if person.first_name %}{{ person.first_name | escape }}{% if person.last_name %} {{ person.last_name | escape }}{% endif %}{% else %}{{ account.name | escape }}{% endif %}</p>
    <span class="dia" aria-hidden="true"></span>
    <h1>A private dinner, with a seat held for you</h1>
    <p class="body">{{ person.first_name | default: 'Hello' | escape }}, I am setting a small table for the people I most want in one room, and {{ account.name | escape }} is on the list.</p>
    <p class="body">The date, the venue and the table plan are not on this page yet. Reply to my email and I will send them, with a seat held.</p>
    <p class="sig"><b>{{ sender.name | default: 'Our team' | escape }}</b><span>{% if sender.title %}{{ sender.title | escape }}, {% endif %}{{ org | escape }}</span></p>
    {% render 'ken/cta', label: 'Check again', href: link.refresh_url %}
  </header>
</main>
</body>
</html>
