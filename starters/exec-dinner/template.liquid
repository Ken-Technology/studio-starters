{%- assign primary = brand.colors.primary | default: '#f4b9cb' -%}
{%- assign secondary = brand.colors.secondary | default: '#1a2039' -%}
{%- assign font_head = brand.fonts.heading | default: 'Literata' -%}
{%- assign font_body = brand.fonts.body | default: 'Literata' -%}
{%- assign org = brand.name | default: sender.name | default: 'Northbeam' -%}
{%- assign has_guest = false -%}
{%- if data.featured_guest.name and data.featured_guest.name != '' -%}{%- assign has_guest = true -%}{%- endif -%}
{%- assign hl_len = data.headline | size -%}
{%- capture you_name -%}{%- if person.first_name -%}{{ person.first_name | escape }}{% if person.last_name %} {{ person.last_name | escape }}{% endif %}{%- else -%}{{ account.name | escape }}{%- endif -%}{%- endcapture -%}
{%- capture you_line -%}{%- if person.first_name -%}{% if person.title %}{{ person.title | escape }}, {% endif %}{{ account.name | escape }}{%- else -%}Held for your team{%- endif -%}{%- endcapture -%}
{%- capture cal_url -%}https://calendar.google.com/calendar/render?action=TEMPLATE&amp;text={{ data.headline | url_encode }}&amp;dates={{ data.calendar_start | url_encode }}/{{ data.calendar_end | url_encode }}{% if data.calendar_tz and data.calendar_tz != '' %}&amp;ctz={{ data.calendar_tz | url_encode }}{% endif %}&amp;location={{ data.venue | append: ', ' | append: data.venue_line | url_encode }}&amp;details={{ data.topic | url_encode }}{%- endcapture -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex">
<meta name="description" content="A personal invitation to a private dinner, with the table plan, the evening, and an RSVP.">
<title>{{ data.headline | escape }}{% if person.first_name %}, for {{ person.first_name | escape }}{% if person.last_name %} {{ person.last_name | escape }}{% endif %}{% endif %}</title>
{%- if font_head == 'Literata' %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Literata:ital,opsz,wght@0,7..72,400;0,7..72,500;0,7..72,600;1,7..72,400;1,7..72,500&display=swap">
{%- else %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_head | url_encode }}&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_head | url_encode }}:wght@500&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_head | url_encode }}:wght@600&display=swap">
{%- endif %}
{%- if font_body != font_head %}
{%- if font_body == 'Literata' %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Literata:ital,opsz,wght@0,7..72,400;0,7..72,500;0,7..72,600;1,7..72,400;1,7..72,500&display=swap">
{%- else %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_body | url_encode }}&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_body | url_encode }}:wght@500&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_body | url_encode }}:wght@600&display=swap">
{%- endif %}
{%- endif %}
<style>
:root{
  --p:{{ primary | escape }};
  --s:{{ secondary | escape }};
  --fh:'{{ font_head | escape }}',Georgia,'Times New Roman',serif;
  --fb:'{{ font_body | escape }}',Georgia,'Times New Roman',serif;
  /* two-colour print: card stock from the primary, the cloth and the print from the secondary */
  --cloth:color-mix(in srgb,var(--s) 80%,#000);
  --paper:color-mix(in srgb,var(--p) 70%,#fff);
  --print:color-mix(in srgb,var(--s) 70%,#000);
  --step-small:clamp(.875rem,.84rem + .1vw,.9375rem);
  --step-body:clamp(1.0625rem,1rem + .3vw,1.25rem);
  --step-lead:clamp(1.25rem,1.1rem + .6vw,1.5rem);
  --step-head:clamp(1.75rem,1rem + 2.6vw,2.875rem);
  --step-name:clamp(2.75rem,1rem + 6.2vw,6rem);
  --margin:clamp(1rem,2.4vw,2rem);
  --ital:{% if font_head == 'Literata' %}italic{% else %}normal{% endif %};
}
@supports (color:oklch(from red l c h)){:root{
  --cloth:oklch(from var(--s) min(l,.27) min(c,.09) h);
  --paper:oklch(from var(--p) max(l,.84) min(c,.12) h);
  --print:oklch(from var(--s) min(l,.25) min(c,.09) h);
}}
:root{
  --soft:color-mix(in srgb,var(--print) 84%,var(--paper));
  --sheet:color-mix(in srgb,var(--paper) 88%,var(--print));
  --table:color-mix(in srgb,var(--cloth) 84%,var(--paper));
  --blank:color-mix(in srgb,var(--cloth) 76%,var(--paper));
  --on-cloth:var(--paper);
  --on-cloth-soft:color-mix(in srgb,var(--paper) 86%,var(--cloth));
}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%;scroll-behavior:smooth;background:var(--cloth)}
body{margin:0;background:var(--cloth);color:var(--on-cloth);font:400 var(--step-body)/1.6 var(--fb);font-optical-sizing:auto;-webkit-font-smoothing:antialiased;font-variant-numeric:lining-nums}
h1,h2,h3{font-family:var(--fh);font-weight:500;margin:0;text-wrap:balance;letter-spacing:-.02em}
p{margin:0}
a{color:inherit;text-underline-offset:.2em;text-decoration-thickness:.06em}
a:focus-visible,.ken-form input:focus-visible,.ken-form textarea:focus-visible{outline:3px solid currentColor;outline-offset:3px}
::selection{background:var(--paper);color:var(--print)}

/* the cloth: wordmark and the one action */
.top{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:1.1rem var(--margin);max-width:80rem;margin:0 auto}
.mark{display:inline-flex;align-items:center;gap:.6rem;font-family:var(--fh);font-weight:500;font-size:var(--step-body);letter-spacing:-.01em;margin:0;color:var(--on-cloth)}
.mark img{height:26px;width:auto;max-width:9rem;display:block}
.btn{display:inline-flex;align-items:center;justify-content:center;min-height:2.875rem;padding:.7rem 1.35rem;background:var(--paper);color:var(--print);font:500 var(--step-small)/1.2 var(--fb);text-decoration:none;letter-spacing:.01em}
.btn:hover{background:color-mix(in srgb,var(--paper) 86%,#fff)}
.btn:focus-visible{outline:3px solid var(--paper);outline-offset:3px}

/* the invitation card: cut off by the fold, the note is its lower half */
.card{position:relative;background:var(--paper);color:var(--print);margin:.5rem var(--margin) 0;padding:3rem 1.5rem 3.25rem;text-align:center}
.card::before,.card::after{content:'';position:absolute;top:-12px;width:24px;height:24px;border-radius:50%;background:var(--cloth)}
.card::before{left:-12px}
.card::after{right:-12px}
.name{font-family:var(--fh);font-style:var(--ital);font-weight:400;font-size:var(--step-name);line-height:1;letter-spacing:-.03em;margin:0 auto;max-width:12ch;text-wrap:balance;overflow-wrap:anywhere}
.who{margin:.9rem auto 0;font-size:var(--step-body);max-width:34ch}
.dia{display:block;width:10px;height:10px;margin:1.8rem auto;background:currentColor;transform:rotate(45deg)}
.card h1{font-size:var(--step-head);line-height:1.08;max-width:20ch;margin:0 auto}
.card h1.long{font-size:clamp(1.5rem,.9rem + 2.2vw,2.5rem)}
.sub{font-style:var(--ital);margin:.85rem auto 0;color:var(--soft);font-size:var(--step-lead);line-height:1.35;max-width:30ch}
.facts{list-style:none;margin:2rem auto 0;padding:0;display:grid;gap:1.15rem;max-width:30rem}
.facts li{display:grid;gap:.1rem}
.facts b{font-weight:500;font-size:var(--step-lead);line-height:1.25}
.facts span{color:var(--soft);font-size:var(--step-small)}
.cal{display:inline-flex;align-items:center;gap:.5rem;min-height:2.75rem;margin-top:1.6rem;font-size:var(--step-small);font-weight:500}
.cal svg{width:16px;height:16px;flex:none}
.note{max-width:34rem;margin:3.25rem auto 0;text-align:left;padding-top:2.6rem;position:relative}
.note::before{content:'';position:absolute;top:0;left:50%;width:10px;height:10px;margin-left:-5px;background:currentColor;transform:rotate(45deg)}
.note h2{font-size:var(--step-lead);font-style:var(--ital);font-weight:400;letter-spacing:-.01em;color:var(--soft);margin-bottom:1rem}
.note .sal{font-weight:500;margin-bottom:.4rem}
.note .body{font-size:var(--step-lead);line-height:1.5}
.sig{margin-top:1.4rem}
.sig b{display:block;font-family:var(--fh);font-style:var(--ital);font-weight:500;font-size:var(--step-lead);line-height:1.2}
.sig span{color:var(--soft);font-size:var(--step-small)}

/* the table, seen from above */
.room{padding:5rem var(--margin) 0}
.room h2,.reply h2{font-size:var(--step-head);line-height:1.05;color:var(--on-cloth)}
.room .lede{color:var(--on-cloth);max-width:38ch;margin-top:.8rem}
.plan{margin:2.4rem 0 0;display:grid;gap:.6rem;grid-template-columns:minmax(0,1fr) 1.25rem minmax(0,1fr);grid-template-areas:"head head head" "a board b" "foot foot foot"}
.plan.solo{grid-template-areas:"head head head" "a board b"}
.side{display:flex;flex-direction:column;gap:.6rem}
.side.a{grid-area:a}
.side.b{grid-area:b}
.board{grid-area:board;background:var(--table);border-radius:999px;position:relative;min-height:14rem}
.board span{display:none;position:absolute;left:50%;top:50%;transform:translate(-50%,-50%) rotate(90deg);white-space:nowrap;color:var(--on-cloth-soft);font-style:var(--ital);font-size:var(--step-small)}
.seat{display:grid;gap:.2rem;align-content:center;padding:.9rem 1rem;background:var(--blank);color:var(--on-cloth);font-size:var(--step-body);line-height:1.35;min-height:6.25rem;overflow-wrap:anywhere}
.seat b{font-weight:500;font-size:var(--step-body);line-height:1.2}
.seat span{color:var(--on-cloth)}
.seat.printed{background:var(--paper);color:var(--print)}
.seat.printed span{color:var(--soft)}
.seat.printed b{font-style:var(--ital);font-size:var(--step-lead)}
.seat.end{grid-area:head;text-align:center;justify-items:center}
.seat.end.foot{grid-area:foot}
.seat .tag{display:flex;align-items:center;gap:.5rem;font-style:normal;color:var(--print)}
.seat .tag::before{content:'';width:8px;height:8px;background:currentColor;transform:rotate(45deg);flex:none}
.seat .role{color:var(--soft)}
.plan-note{color:var(--on-cloth);margin-top:1.2rem;max-width:44ch}

/* the evening, printed as a menu sheet */
.evening{padding:5rem .75rem 0}
.sheet{max-width:44rem;margin:0 auto;color:var(--print)}
.edge{display:block;width:100%;height:12px;color:var(--sheet)}
.edge.down{transform:scaleY(-1)}
.sheet-in{background:var(--sheet);padding:2.6rem 1.5rem 2.8rem}
.sheet h2{font-size:var(--step-head);line-height:1.05;text-align:center}
.venue{text-align:center;font-style:var(--ital);color:var(--soft);margin-top:.6rem}
.course{margin-top:2.6rem}
.course h3{font-size:var(--step-lead);text-align:center;font-style:var(--ital);font-weight:400;letter-spacing:-.01em;margin-bottom:.9rem}
.course p,.runs{max-width:30rem;margin-left:auto;margin-right:auto}
.course .lead{font-size:var(--step-lead);line-height:1.45;font-weight:500}
.course .aside{margin-top:.8rem;line-height:1.55}
.course .aside b{font-weight:600;color:var(--print)}
.runs{list-style:none;padding:0;display:grid;gap:.75rem;font-variant-numeric:tabular-nums lining-nums}
.runs li{display:flex;justify-content:space-between;align-items:baseline;gap:1.5rem}
.runs .t{font-weight:500;white-space:nowrap}
.dress{text-align:center;font-style:var(--ital);color:var(--soft);margin:2.4rem auto 0;max-width:32ch}

/* the reply card */
.reply{padding:5rem var(--margin) 0;display:grid;gap:2rem}
.reply .lede{color:var(--on-cloth);margin-top:.9rem;max-width:36ch}
.reply .alt{color:var(--on-cloth);margin-top:1.2rem;max-width:38ch}
.rcard{background:var(--paper);color:var(--print);padding:1.8rem 1.4rem 1.6rem;border-top:6px dotted var(--cloth);position:relative}
.rcard h3{font-size:var(--step-lead);font-style:var(--ital);font-weight:400;margin-bottom:1.1rem}
.ken-form{display:grid;gap:.9rem;grid-template-columns:minmax(0,1fr) minmax(0,1fr)}
.ken-form .ken-form-field{display:grid;gap:.3rem;font-size:var(--step-small);color:var(--print);grid-column:1/-1}
.ken-form .ken-form-field:nth-of-type(n+3){grid-column:auto}
.ken-form input,.ken-form textarea,.ken-form select{font:inherit;font-size:1rem;width:100%;min-height:2.875rem;padding:.7rem .8rem;border:0;border-radius:0;background:color-mix(in srgb,var(--paper) 72%,#fff);color:var(--print)}
.ken-form .ken-form-submit{grid-column:1/-1;justify-self:start;font:500 var(--step-small)/1.2 var(--fb)!important;min-height:2.875rem;background:var(--print)!important;color:var(--paper)!important;border-radius:0!important;padding:.85rem 1.5rem!important}
.ken-form .ken-form-preview,.ken-form>p{grid-column:1/-1;margin:0;color:var(--soft)}
.fine{color:var(--print);margin-top:1rem}

/* the back of the card */
.back{padding:5rem var(--margin) 2.5rem;text-align:center;color:var(--on-cloth)}
.back b{display:block;font-family:var(--fh);font-weight:500;font-style:var(--ital);font-size:var(--step-lead);color:var(--on-cloth);margin-bottom:.3rem}

/* one moment on load: the card is laid on the cloth */
@keyframes lay{from{transform:translateY(28px)}to{transform:none}}
.card{animation:lay .9s cubic-bezier(.2,.7,.2,1) both}

@media (min-width:760px){
  .top{padding:1.5rem var(--margin)}
  .card{width:min(66%,52rem);margin:1.5rem auto 0;padding:4rem 3.5rem 4.25rem}
  .card::before,.card::after{top:-18px;width:36px;height:36px}
  .card::before{left:-18px}
  .card::after{right:-18px}
  .facts{display:flex;justify-content:center;gap:0;max-width:none}
  .facts li{padding:0 1.6rem;position:relative;max-width:16rem}
  .facts li+li::before{content:'';position:absolute;left:-5px;top:.55em;width:10px;height:10px;background:currentColor;transform:rotate(45deg)}
  .facts li:first-child{padding-left:0}
  .facts li:last-child{padding-right:0}
  .room,.evening,.reply{padding-top:8rem}
  .room{max-width:80rem;margin:0 auto}
  .room .intro{display:flex;justify-content:space-between;align-items:flex-end;gap:3rem}
  .room .lede{margin:0;text-align:right}
  .plan{margin:2.6rem 0 0;grid-template-columns:11rem minmax(0,1fr) 11rem;grid-template-rows:auto 3.5rem auto;grid-template-areas:"head a foot" "head board foot" "head b foot";gap:.75rem}
  .plan.solo{grid-template-columns:11rem minmax(0,1fr);grid-template-areas:"head a" "head board" "head b"}
  .side{flex-direction:row}
  .side .seat{flex:1 1 0}
  .board{min-height:0}
  .board span{display:block;transform:translate(-50%,-50%)}
  .sheet-in{padding:3.6rem 4rem 3.8rem}
  .reply{max-width:80rem;margin:0 auto;grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:3rem;align-items:start}
  .rcard{padding:2.4rem 2.4rem 2.2rem;border-top:0;border-left:6px dotted var(--cloth)}
  .back{padding-top:7rem}
}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}.card{animation:none}}
@media print{
  html,body{background:#fff}
  .top .btn{display:none}
  .card{animation:none;margin:0;width:auto}
  .room,.evening,.reply{break-before:page;padding-top:2rem}
  .ken-form-submit{display:none}
}
</style>
</head>
<body>
<header class="top">
  <p class="mark">{%- if brand.logo_url %}<img src="{{ brand.logo_url | escape }}" alt="">{% endif %}<span>{{ org | escape }}</span></p>
  <a class="btn" href="#rsvp">Hold my seat</a>
</header>
<main>
  <div class="card">
    <header data-section="face">
      <p class="name">{{ you_name }}</p>
      <p class="who">{{ you_line }}</p>
      <span class="dia" aria-hidden="true"></span>
      <h1{% if hl_len > 44 %} class="long"{% endif %}>{{ data.headline | escape }}</h1>
      {%- if data.subline and data.subline != '' %}
      <p class="sub">{{ data.subline | escape }}</p>
      {%- endif %}
      <ul class="facts">
        <li><b>{{ data.date_text | escape }}</b>{% if data.year_text and data.year_text != '' %}<span>{{ data.year_text | escape }}</span>{% endif %}</li>
        <li><b>{{ data.time_text | escape }}</b>{% if data.time_note and data.time_note != '' %}<span>{{ data.time_note | escape }}</span>{% endif %}</li>
        <li><b>{{ data.venue | escape }}</b>{% if data.venue_line and data.venue_line != '' %}<span>{{ data.venue_line | escape }}</span>{% endif %}</li>
      </ul>
      {%- if data.calendar_start and data.calendar_start != '' and data.calendar_end and data.calendar_end != '' %}
      <a class="cal" href="{{ cal_url }}"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><rect x="1.5" y="2.5" width="13" height="12"/><path d="M1.5 6.5h13M5 1v3M11 1v3"/></svg><span>Add to calendar</span></a>
      {%- endif %}
    </header>
    <section class="note" data-section="note">
      <h2>A note from {{ data.host | escape }}</h2>
      <p class="sal">{% if person.first_name %}{{ person.first_name | escape }},{% else %}Hello,{% endif %}</p>
      <p class="body">{{ data.why_you | escape | newline_to_br | strip_newlines | raw }}</p>
      <p class="sig"><b>{{ data.host | escape }}</b><span>{% if sender.title %}{{ sender.title | escape }}, {% endif %}{{ org | escape }}</span></p>
    </section>
  </div>

  <section class="room" data-section="table">
    <div class="intro">
      <h2>The table</h2>
      <p class="lede">You, the other guests{% if has_guest %}, our guest for the evening{% endif %} and me. Nobody is selling anything.</p>
    </div>
    <div class="plan{% unless has_guest %} solo{% endunless %}" role="list">
      <div class="seat end printed" role="listitem"><b>{{ data.host | escape }}</b><span class="role">Your host, {{ org | escape }}</span></div>
      <div class="side a">
        <div class="seat printed" role="listitem"><span class="tag">Your seat</span><b>{{ you_name }}</b><span>{{ you_line }}</span></div>
        {%- for g in data.guests limit: 2 %}
        <div class="seat" role="listitem"><b>{{ g.title | escape }}</b><span>{{ g.company_type | escape }}</span></div>
        {%- endfor %}
      </div>
      <div class="board" aria-hidden="true">{% if data.date_short and data.date_short != '' %}<span>{{ data.date_short | escape }}</span>{% endif %}</div>
      <div class="side b">
        {%- for g in data.guests offset: 2 %}
        <div class="seat" role="listitem"><b>{{ g.title | escape }}</b><span>{{ g.company_type | escape }}</span></div>
        {%- endfor %}
      </div>
      {%- if has_guest %}
      <div class="seat end foot printed" role="listitem"><b>{{ data.featured_guest.name | escape }}</b><span class="role">Guest of the evening, {{ data.featured_guest.role | escape }}</span></div>
      {%- endif %}
    </div>
    <p class="plan-note">Other guests are shown by title and company type. Names are shared at the table.</p>
  </section>

  <section class="evening" data-section="evening">
    <div class="sheet">
      <svg class="edge" aria-hidden="true" preserveAspectRatio="none"><defs><pattern id="scallop" width="24" height="12" patternUnits="userSpaceOnUse"><circle cx="12" cy="12" r="12" fill="currentColor"/></pattern></defs><rect width="100%" height="12" fill="url(#scallop)"/></svg>
      <div class="sheet-in">
        <h2>The evening</h2>
        <p class="venue">{{ data.venue | escape }}{% if data.venue_line and data.venue_line != '' %}, {{ data.venue_line | escape }}{% endif %}</p>
        <div class="course">
          <h3>The conversation</h3>
          <p class="lead">{{ data.topic | escape }}</p>
          {%- if has_guest and data.featured_guest.bio and data.featured_guest.bio != '' %}
          <p class="aside"><b>{{ data.featured_guest.name | escape }} opens it.</b> {{ data.featured_guest.bio | escape }}</p>
          {%- endif %}
          {%- if data.topic_note and data.topic_note != '' %}
          <p class="aside">{{ data.topic_note | escape }}</p>
          {%- endif %}
        </div>
        {%- if data.menu and data.menu != '' %}
        <div class="course">
          <h3>The menu</h3>
          <p class="lead">{{ data.menu | escape }}</p>
          {%- if data.menu_note and data.menu_note != '' %}
          <p class="aside">{{ data.menu_note | escape }}</p>
          {%- endif %}
        </div>
        {%- endif %}
        <div class="course">
          <h3>How it runs</h3>
          <ul class="runs">
            {%- for item in data.run_of_show %}
            <li><span>{{ item.text | escape }}</span><span class="t">{{ item.time | escape }}</span></li>
            {%- endfor %}
          </ul>
        </div>
        {%- if data.dress_note and data.dress_note != '' %}
        <p class="dress">{{ data.dress_note | escape }}</p>
        {%- endif %}
      </div>
      <svg class="edge down" aria-hidden="true" preserveAspectRatio="none"><rect width="100%" height="12" fill="url(#scallop)"/></svg>
    </div>
  </section>

  <section class="reply" id="rsvp" data-section="rsvp">
    <div>
      <h2>Hold your seat</h2>
      <p class="lede">{% if data.rsvp_by and data.rsvp_by != '' %}Reply by {{ data.rsvp_by | escape }}. {% endif %}If you would like to bring a colleague from {{ account.name | escape }}, say so and we will make room.</p>
      <p class="alt">Can't make it? Reply to my email and you are first on the list for the next table.</p>
    </div>
    <div class="rcard">
      <h3>The reply card</h3>
      {% render 'ken/form', id: 'rsvp', fields: 'name*,email*,guests,dietary', submit: 'Hold my seat' %}
      <p class="fine">Your details go to {{ data.host | escape }} only. Nothing is shared with the other guests.</p>
    </div>
  </section>
</main>
<footer class="back">
  <b>{{ data.venue | escape }}</b>
