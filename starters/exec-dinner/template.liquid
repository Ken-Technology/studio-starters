{%- assign primary = brand.colors.primary | default: '#2a4bd7' -%}
{%- assign secondary = brand.colors.secondary | default: '#0e1530' -%}
{%- assign font_head = brand.fonts.heading | default: 'Inter Tight' -%}
{%- assign font_body = brand.fonts.body | default: 'Inter' -%}
{%- assign head_q = font_head | replace: ' ', '+' -%}
{%- assign body_q = font_body | replace: ' ', '+' -%}
{%- assign org = brand.name | default: sender.name | default: 'Northbeam' -%}
{%- assign has_guest = false -%}
{%- if data.featured_guest.name and data.featured_guest.name != '' -%}{%- assign has_guest = true -%}{%- endif -%}
{%- capture you_name -%}{%- if person.first_name -%}{{ person.first_name | escape }}{% if person.last_name %} {{ person.last_name | escape }}{% endif %}{%- else -%}{{ account.name | escape }}{%- endif -%}{%- endcapture -%}
{%- capture you_line -%}{%- if person.first_name -%}{% if person.title %}{{ person.title | escape }}, {% endif %}{{ account.name | escape }}{%- else -%}Held for your team{%- endif -%}{%- endcapture -%}
{%- capture cal_url -%}https://calendar.google.com/calendar/render?action=TEMPLATE&amp;text={{ data.headline | url_encode }}&amp;dates={{ data.calendar_start | url_encode }}/{{ data.calendar_end | url_encode }}{% if data.calendar_tz and data.calendar_tz != '' %}&amp;ctz={{ data.calendar_tz | url_encode }}{% endif %}&amp;location={{ data.venue | append: ', ' | append: data.venue_line | url_encode }}&amp;details={{ data.topic | url_encode }}{%- endcapture -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex">
<meta name="description" content="A personal invitation to a private dinner, with the table plan, the evening, and an RSVP.">
<title>{{ data.headline | escape }}{% if person.first_name %}, for {{ person.first_name | escape }}{% if person.last_name %} {{ person.last_name | escape }}{% endif %}{% endif %}</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ head_q }}:wght@500;600&display=swap">
{%- if font_body != font_head %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ body_q }}:wght@400;500;600&display=swap">
{%- endif %}
<style>
:root{
  --p:{{ primary | escape }};
  --s:{{ secondary | escape }};
  --fh:'{{ font_head | escape }}',ui-sans-serif,system-ui,sans-serif;
  --fb:'{{ font_body | escape }}',ui-sans-serif,system-ui,sans-serif;
  --stock:color-mix(in srgb,var(--p) 3%,#fffdf8);
  --ink:color-mix(in srgb,var(--s) 55%,#15120e);
  --ground:color-mix(in srgb,var(--s) 70%,#0c0a08);
  --mute:color-mix(in srgb,var(--ink) 62%,var(--stock));
  --rule:color-mix(in srgb,var(--ink) 16%,var(--stock));
  --rule-soft:color-mix(in srgb,var(--ink) 9%,var(--stock));
  --accent:color-mix(in srgb,var(--p) 78%,var(--ink));
  --tint:color-mix(in srgb,var(--p) 9%,var(--stock));
  --on-p:#fff;
}
@supports (color:oklch(from red l c h)){:root{
  --on-p:oklch(from var(--p) clamp(0,(0.7 - l) * 1000,1) 0 0);
  --ink:oklch(from var(--s) min(l,0.26) min(c,0.04) h);
  --ground:oklch(from var(--s) min(l,0.2) min(c,0.06) h);
  --accent:oklch(from var(--p) min(l,0.5) c h);
}}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%;scroll-behavior:smooth}
body{margin:0;background:var(--ground);color:var(--ink);font:17px/1.55 var(--fb);-webkit-font-smoothing:antialiased;font-variant-numeric:tabular-nums}
body::before{content:'';position:fixed;inset:0;background:radial-gradient(120% 80% at 50% 0%,color-mix(in srgb,var(--p) 18%,transparent),transparent 60%);pointer-events:none}
.card{position:relative;max-width:46rem;margin:1rem auto 3rem;background:var(--stock);box-shadow:5px 5px 0 0 var(--p),0 30px 60px -20px rgba(0,0,0,.55)}
.card>*{padding-left:1.35rem;padding-right:1.35rem}
h1,h2{font-family:var(--fh);font-weight:500;line-height:1.08;letter-spacing:-.015em;margin:0;text-wrap:balance}
h2{font-size:1.45rem;margin:0 0 .45rem}
p{margin:0 0 .85rem}
a{color:var(--accent)}
.lbl{font-variant-caps:all-small-caps;letter-spacing:.12em;font-size:.86rem;color:var(--mute);font-weight:500}

/* face */
.face{text-align:center;padding-top:2.6rem;padding-bottom:2.2rem}
.mark{display:inline-flex;align-items:center;gap:.55rem;font-weight:600;font-size:.95rem;letter-spacing:.01em;margin:0}
.mark img{height:24px;width:auto;max-width:9rem;display:block}
.to{margin:2.2rem 0 .7rem;color:var(--mute);font-size:.98rem}
.to b{color:var(--ink);font-weight:500}
.face h1{font-size:2.45rem;max-width:15ch;margin:0 auto}
.face .sub{margin:.9rem auto 0;max-width:30ch;color:var(--mute);text-wrap:balance}
.orn{display:block;margin:1.6rem auto;width:88px;height:10px;color:var(--p)}
.when{display:grid;gap:1rem;margin:0 auto;max-width:30rem;justify-content:center}
.when div{display:grid;gap:.1rem}
.when b{font-family:var(--fh);font-weight:500;font-size:1.42rem;line-height:1.15;letter-spacing:-.01em}
.when span{color:var(--mute);font-size:.95rem}
.actions{display:flex;flex-direction:column;align-items:center;gap:.9rem;margin-top:1.9rem}
.btn{display:inline-flex;align-items:center;justify-content:center;min-height:2.75rem;background:var(--p);color:var(--on-p);text-decoration:none;font-weight:600;font-size:1rem;padding:.9rem 1.8rem;border-radius:2px;letter-spacing:.005em}
.btn:focus-visible,a:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{outline:2px solid var(--accent);outline-offset:3px}
.cal{display:inline-flex;align-items:center;gap:.45rem;min-height:2.75rem;font-size:.95rem;text-decoration:none}
.cal span{border-bottom:1px solid color-mix(in srgb,var(--accent) 40%,transparent);padding-bottom:1px}
.cal svg{width:16px;height:16px}

/* sections */
section{padding-top:1.9rem;padding-bottom:1.9rem;border-top:1px solid var(--rule)}
.note{background:linear-gradient(to bottom,var(--tint),color-mix(in srgb,var(--tint) 40%,var(--stock)))}
.note p{max-width:34rem;margin-left:auto;margin-right:auto}
.note .sal{font-family:var(--fh);font-size:1.25rem;margin-bottom:.6rem}
.note .body{font-size:1.06rem;line-height:1.6}
.note .sig{margin-top:1.3rem;margin-bottom:0}
.note .sig b{display:block;font-family:var(--fh);font-weight:500;font-size:1.2rem;line-height:1.2}
.note .sig small{color:var(--mute);font-size:.92rem}
.lede{color:var(--mute);max-width:36rem;margin-bottom:1.4rem}

/* the table */
.plan{display:grid;gap:.7rem .75rem;grid-template-columns:minmax(0,1fr) 1.6rem minmax(0,1fr);grid-template-areas:"head head head" "a board b" "foot foot foot";align-items:stretch}
.plan.solo{grid-template-areas:"head head head" "a board b"}
.side{display:flex;flex-direction:column;justify-content:space-between;gap:.7rem}
.side.a{grid-area:a}
.side.b{grid-area:b}
.board{grid-area:board;background:var(--ink);border-radius:999px;position:relative;min-height:12rem}
.board span{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%) rotate(90deg);white-space:nowrap;color:var(--stock);font-variant-caps:all-small-caps;letter-spacing:.2em;font-size:.8rem;font-weight:500}
.seat{border:1px solid var(--rule);background:var(--stock);padding:.7rem .75rem .75rem;font-size:.86rem;line-height:1.3;display:grid;gap:.15rem;align-content:center;position:relative;border-radius:2px;overflow-wrap:anywhere}
.seat::before{content:'';position:absolute;top:0;left:50%;transform:translateX(-50%);width:1.6rem;height:2px;background:var(--rule)}
.seat b{font-weight:600;display:block;font-size:.9rem}
.seat span{color:var(--mute)}
.seat.end{grid-area:head;text-align:center;justify-items:center}
.seat.end.foot{grid-area:foot}
.seat.end::before{display:none}
.seat.end .role{margin-top:.1rem}
.seat.you{border-color:var(--p);background:var(--tint);box-shadow:inset 0 0 0 1px var(--p)}
.seat.you::before{background:var(--p);width:2.2rem}
.seat.you .tag{color:var(--accent);font-weight:600;font-variant-caps:all-small-caps;letter-spacing:.1em;font-size:.86rem}
.foot-note{color:var(--mute);font-size:.9rem;margin:1.1rem 0 0}

/* the evening */
dl{margin:0;display:grid;gap:0}
dl div{display:grid;gap:.15rem;padding:.9rem 0;border-top:1px solid var(--rule-soft)}
dl div:first-child{border-top:0;padding-top:0}
dt{font-variant-caps:all-small-caps;letter-spacing:.12em;font-size:.9rem;color:var(--mute);font-weight:500}
dd{margin:0}
dd .row{display:block}
dd .t{display:inline-block;min-width:3.4rem;font-weight:500}
dd small{display:block;color:var(--mute);font-size:.92rem;margin-top:.15rem}
.menu{font-family:var(--fh);font-size:1.12rem;line-height:1.45;font-weight:500}

/* rsvp */
.rsvp{scroll-margin-top:1rem}
.form{margin-top:1.2rem}
.ken-form{display:grid;gap:.9rem;grid-template-columns:minmax(0,1fr) minmax(0,1fr)}
.ken-form .ken-form-field{display:grid;gap:.3rem;font-size:.9rem;color:var(--mute);grid-column:1/-1}
.ken-form .ken-form-field:nth-of-type(n+3){grid-column:auto}
.ken-form input{font:inherit;font-size:1rem;width:100%;min-height:2.75rem;padding:.72rem .8rem;border:1px solid color-mix(in srgb,var(--ink) 28%,var(--stock));border-radius:2px;background:#fff;color:var(--ink)}
.ken-form .ken-form-submit{grid-column:1/-1;justify-self:start;font:inherit;font-weight:600;font-size:1rem;min-height:2.75rem;background:var(--p)!important;color:var(--on-p)!important;border-radius:2px!important;padding:.85rem 1.6rem!important}
.ken-form .ken-form-preview,.ken-form>p{grid-column:1/-1;margin:0}
.fine{font-size:.84rem;color:var(--mute);margin:.9rem 0 0}
.alt{color:var(--mute);font-size:.95rem;margin:1.4rem 0 0}

footer{padding-top:1.4rem;padding-bottom:1.6rem;border-top:1px solid var(--rule);font-size:.86rem;color:var(--mute);display:grid;gap:.3rem}
footer b{color:var(--ink);font-weight:500}

@media (min-width:760px){
  .card{margin:3.5rem auto 4.5rem;max-width:52rem}
  .card>*{padding-left:3.4rem;padding-right:3.4rem}
  .face{padding-top:3.4rem;padding-bottom:3rem}
  .face h1{font-size:3.2rem}
  .when{display:flex;gap:0;max-width:none;align-items:flex-start}
  .when div{padding:0 1.6rem}
  .when div:first-child{text-align:right;padding-left:0}
  .when div:nth-child(2){border-left:1px solid var(--rule);border-right:1px solid var(--rule);text-align:center}
  .when div:last-child{text-align:left;padding-right:0;max-width:19rem}
  .when b,.when div:nth-child(2) span{white-space:nowrap}
  .actions{flex-direction:row;justify-content:center;gap:1.6rem}
  section{padding-top:2.4rem;padding-bottom:2.4rem}
  .plan{grid-template-columns:7.5rem minmax(0,1fr) 7.5rem;grid-template-rows:auto 1.6rem auto;grid-template-areas:"head a foot" "head board foot" "head b foot";gap:.75rem .9rem;margin-left:-1rem;margin-right:-1rem}
  .plan.solo{grid-template-columns:7.5rem minmax(0,1fr);grid-template-areas:"head a" "head board" "head b"}
  .side{flex-direction:row}
  .side .seat{flex:1 1 0}
  .board{min-height:0}
  .board span{transform:translate(-50%,-50%)}
  .seat.end{text-align:center}
  .two{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.15fr);gap:2.6rem;align-items:start}
  .form{margin-top:0}
  dl{grid-template-columns:1fr 1fr;column-gap:2.4rem}
  dl div:nth-child(2){border-top:0;padding-top:0}
  dl div.wide{grid-column:1/-1}
  footer{grid-template-columns:1fr auto;align-items:end}
}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
@media print{body{background:#fff}.card{box-shadow:none;margin:0;max-width:none}.btn,.ken-form-submit{display:none}}
</style>
</head>
<body>
<main class="card">

  <header class="face" data-section="face">
    <p class="mark">{%- if brand.logo_url %}<img src="{{ brand.logo_url | escape }}" alt="">{% endif %}<span>{{ org | escape }}</span></p>
    <p class="to">{% if person.first_name %}An invitation for <b>{{ you_name }}</b>{% if person.title %}, {{ person.title | escape }}{% endif %}, {{ account.name | escape }}{% else %}An invitation for <b>{{ account.name | escape }}</b>{% endif %}</p>
    <h1>{{ data.headline | escape }}</h1>
    {%- if data.subline and data.subline != '' %}
    <p class="sub">{{ data.subline | escape }}</p>
    {%- endif %}
    <svg class="orn" viewBox="0 0 88 10" aria-hidden="true"><path d="M0 5h34M54 5h34" stroke="currentColor" stroke-width="1"/><circle cx="44" cy="5" r="2.2" fill="currentColor"/></svg>
    <div class="when">
      <div><b>{{ data.date_text | escape }}</b>{% if data.year_text and data.year_text != '' %}<span>{{ data.year_text | escape }}</span>{% endif %}</div>
      <div><b>{{ data.time_text | escape }}</b>{% if data.time_note and data.time_note != '' %}<span>{{ data.time_note | escape }}</span>{% endif %}</div>
      <div><b>{{ data.venue | escape }}</b>{% if data.venue_line and data.venue_line != '' %}<span>{{ data.venue_line | escape }}</span>{% endif %}</div>
    </div>
    <div class="actions">
      <a class="btn" href="#rsvp">Hold my seat</a>
      {%- if data.calendar_start and data.calendar_start != '' and data.calendar_end and data.calendar_end != '' %}
      <a class="cal" href="{{ cal_url }}">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><rect x="1.5" y="2.5" width="13" height="12" rx="1.5"/><path d="M1.5 6.5h13M5 1v3M11 1v3"/></svg>
        <span>Add to calendar</span>
      </a>
      {%- endif %}
    </div>
  </header>

  <section class="note" data-section="note">
    <p class="sal">{% if person.first_name %}{{ person.first_name | escape }},{% else %}Hello,{% endif %}</p>
    <p class="body">{{ data.why_you | escape | newline_to_br | strip_newlines | raw }}</p>
    <p class="sig"><b>{{ data.host | escape }}</b><small>{% if sender.title %}{{ sender.title | escape }}, {% endif %}{{ org | escape }}</small></p>
  </section>

  <section data-section="table">
    <h2>The table</h2>
    <p class="lede">You, the other guests{% if has_guest %}, our guest for the evening{% endif %} and me. Nobody is selling anything.</p>
    <div class="plan{% unless has_guest %} solo{% endunless %}" role="list">
      <div class="seat end" role="listitem">
        <span class="lbl">Host</span>
        <b>{{ data.host | escape }}</b>
        <span class="role">{{ org | escape }}</span>
      </div>
      <div class="side a">
        <div class="seat you" role="listitem"><span class="tag">Your seat</span><b>{{ you_name }}</b><span>{{ you_line }}</span></div>
        {%- for g in data.guests limit: 2 %}
        <div class="seat" role="listitem"><b>{{ g.title | escape }}</b><span>{{ g.company_type | escape }}</span></div>
        {%- endfor %}
      </div>
      <div class="board" aria-hidden="true">{% if data.date_short and data.date_short != '' %}<span>{{ data.date_short | escape }}</span>{% endif %}</div>
      <div class="side b">
        {%- for g in data.guests offset: 2 %}
        <div class="seat" role="listitem"><b>{{ g.title | escape }}</b><span>{{ g.company_type | escape }}</span></div>
        {%- endfor %}
      </div>
      {%- if has_guest %}
      <div class="seat end foot" role="listitem">
        <span class="lbl">Guest</span>
        <b>{{ data.featured_guest.name | escape }}</b>
        <span class="role">{{ data.featured_guest.role | escape }}</span>
      </div>
      {%- endif %}
    </div>
    <p class="foot-note">Other guests are shown by title and company type. Names are shared at the table.</p>
  </section>

  <section data-section="evening">
    <h2>The evening</h2>
    <dl>
      <div class="wide">
        <dt>The conversation</dt>
        <dd>{{ data.topic | escape }}
          {%- if has_guest and data.featured_guest.bio and data.featured_guest.bio != '' %}<small>{{ data.featured_guest.name | escape }} opens it. {{ data.featured_guest.bio | escape }}</small>{% endif %}
          {%- if data.topic_note and data.topic_note != '' %}<small>{{ data.topic_note | escape }}</small>{% endif %}</dd>
      </div>
      {%- if data.menu and data.menu != '' %}
      <div>
        <dt>Menu</dt>
        <dd class="menu">{{ data.menu | escape }}{% if data.menu_note and data.menu_note != '' %}<small>{{ data.menu_note | escape }}</small>{% endif %}</dd>
      </div>
      {%- endif %}
      <div>
        <dt>How it runs</dt>
        <dd>
          {%- for item in data.run_of_show %}<span class="row"><span class="t">{{ item.time | escape }}</span>{{ item.text | escape }}</span>{% endfor -%}
          {%- if data.dress_note and data.dress_note != '' %}<small>{{ data.dress_note | escape }}</small>{% endif -%}
        </dd>
      </div>
    </dl>
  </section>

  <section class="rsvp" id="rsvp" data-section="rsvp">
    <div class="two">
      <div>
        <h2>Hold your seat</h2>
        <p class="lede">{% if data.rsvp_by and data.rsvp_by != '' %}Reply by {{ data.rsvp_by | escape }}. {% endif %}If you would like to bring a colleague from {{ account.name | escape }}, say so and we will make room.</p>
        <p class="alt">Can't make it? Reply to my email and you are first on the list for the next table.</p>
      </div>
      <div class="form">
        {% render 'ken/form', id: 'rsvp', fields: 'name*,email*,guests,dietary', submit: 'Hold my seat' %}
        <p class="fine">Your details go to {{ data.host | escape }} only. Nothing is shared with the other guests.</p>
      </div>
    </div>
  </section>

  <footer>
    <div><b>{{ data.venue | escape }}</b>{% if data.venue_line and data.venue_line != '' %}, {{ data.venue_line | escape }}{% endif %}</div>
    <div>A dinner hosted by {{ org | escape }}, made for {{ you_name }}</div>
  </footer>

</main>
</body>
</html>
