{%- assign accent = brand.colors.primary | default: '#38450f' -%}
{%- assign accent2 = brand.colors.secondary | default: '#d4a017' -%}
{%- assign font_head = brand.fonts.heading | default: 'Rokkitt' -%}
{%- assign font_body = brand.fonts.body | default: 'Spectral' -%}
{%- assign head_q = font_head | replace: ' ', '+' -%}
{%- assign body_q = font_body | replace: ' ', '+' -%}
{%- if brand.fonts.heading -%}{%- assign head_w = 'wght@400;700' -%}{%- else -%}{%- assign head_w = 'wght@700;800' -%}{%- endif -%}
{%- if brand.fonts.body -%}{%- assign body_w = 'wght@400;700' -%}{%- else -%}{%- assign body_w = 'wght@400;600' -%}{%- endif -%}
{%- assign first = person.first_name | default: 'there' -%}
{%- assign short_name = account.name | split: ' - ' | first | split: ' | ' | first | strip | default: account.name -%}
{%- assign industry = account.industry | default: 'your industry' -%}
{%- assign sender_name = sender.name | default: 'Our team' -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex">
<title>Five moves for {{ short_name | escape }}</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ head_q }}:{{ head_w }}&display=swap">
{%- if font_body != font_head %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ body_q }}:{{ body_w }}&display=swap">
{%- endif %}
<style>
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:#ecebe7;-webkit-font-smoothing:antialiased}
.hb{--p:{{ accent }};--s:{{ accent2 }};--bone:#ecebe7;--ink:#2f3a0c;--ink:oklch(from var(--p) min(l, 0.3) min(c, 0.07) h);--soft:color-mix(in oklab,var(--ink) 78%,var(--bone));--fh:'{{ font_head }}',Rockwell,'Roboto Slab',Georgia,serif;--fb:'{{ font_body }}',Georgia,'Times New Roman',serif;--m:clamp(1.25rem,2.6vw,2.5rem);color:var(--ink);font-family:var(--fb);font-size:1.125rem;line-height:1.6;max-width:84rem;margin:0 auto;padding:0 var(--m) 2.5rem}
.hb h1,.hb h2{font-family:var(--fh);font-weight:700;margin:0;text-wrap:balance}
.hb p{margin:0}
.hb a:focus-visible{outline:3px solid var(--s);outline-offset:3px}
.on{background:var(--p);color:#f3f2ee;color:oklch(from var(--p) clamp(0.2, (0.6 - l) * 100, 0.97) min(c, 0.03) h)}
.top{display:flex;align-items:baseline;justify-content:space-between;gap:1rem;padding:1.1rem 0 1rem;font-size:.875rem;line-height:1.4}
.top p{color:var(--soft)}
.logo{height:26px;width:auto;display:block}
.bname{font-family:var(--fh);font-weight:700;font-size:1.3125rem}
.cover{display:grid;gap:2rem}
.book{container-type:inline-size;display:flex;flex-direction:column;justify-content:space-between;gap:2.5rem;min-height:50svh;padding:1.75rem 1.5rem 1.5rem}
.book h1{font-size:min(9.5rem,27cqi);font-weight:800;line-height:.86;text-transform:uppercase;max-width:5ch;margin-left:-.04em}
.sub{font-family:var(--fh);font-weight:700;font-size:clamp(1.3125rem,5.6vw,2rem);line-height:1.12;margin-top:1.1rem!important}
.right{display:grid;gap:1.5rem;align-content:start;max-width:36rem}
.lead{font-size:1.3125rem;line-height:1.5}
.ask .ken-cta{display:inline-block!important;min-height:48px;padding:14px 24px!important;border-radius:0!important;background:var(--p)!important;color:#f3f2ee!important;color:oklch(from var(--p) clamp(0.2, (0.6 - l) * 100, 0.97) min(c, 0.03) h)!important;font-family:var(--fh);font-weight:800!important;font-size:1.3125rem;line-height:20px}
.sign{font-family:var(--fh);font-weight:700;font-size:1.3125rem;line-height:1.2}
.sign span{display:block;font-family:var(--fb);font-weight:400;font-size:1.125rem;margin-top:.2rem}
@media (min-width:1000px){
.cover{grid-template-columns:minmax(0,26rem) minmax(0,1fr);gap:3rem}
.book{min-height:36rem;padding:2.5rem}
.right{padding-top:2.5rem}
}
</style>
</head>
<body>
<main class="hb">
<header class="top">
{%- if brand.logo_url %}
<img class="logo" src="{{ brand.logo_url | escape }}" alt="{{ brand.name | default: 'Logo' | escape }}">
{%- elsif brand.name %}
<p class="bname">{{ brand.name | escape }}</p>
{%- else %}
<span></span>
{%- endif %}
<p>Industry playbook{% if account.industry %} for {{ industry | escape }}{% endif %}</p>
</header>
<div class="cover">
<section data-section="cover" class="book on">
<div>
<h1>Five moves</h1>
<p class="sub">for {{ short_name | escape }}</p>
</div>
<p>Written for {% if person.first_name %}{{ person.first_name | escape }} {{ person.last_name | escape }}{% if person.title %}, {{ person.title | escape }}{% endif %}{% else %}the team at {{ short_name | escape }}{% endif %}, from {{ sender_name | escape }}{% if brand.name %} at {{ brand.name | escape }}{% endif %}.</p>
</section>
<section data-section="closing" class="right">
<p class="lead">Hi {{ first | escape }}, I am writing a short playbook for {{ short_name | escape }}: five moves for {% if person.title %}a {{ person.title | escape }}{% else %}your team{% endif %} in {{ industry | escape }}, each with a worked example and a first step you can take this week.</p>
<p>The moves are not on this page yet. Check back soon, or reply to my email and I will send the finished guide as a PDF.</p>
<h2 class="sign">In the meantime</h2>
<p>If you would rather talk it through, grab 20 minutes and I will walk you through the moves I have so far and what I think applies to {{ short_name | escape }}.</p>
<div class="ask">
{% render 'ken/cta', label: 'Book 20 minutes', kind: 'booking' %}
</div>
<p class="sign">{{ sender_name | escape }}{% if sender.title or brand.name %}<span>{% if sender.title %}{{ sender.title | escape }}{% if brand.name %}, {% endif %}{% endif %}{{ brand.name | escape }}</span>{% endif %}</p>
</section>
</div>
</main>
</body>
</html>
