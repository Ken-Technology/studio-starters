{%- assign accent = brand.colors.primary | default: '#9a3b2e' -%}
{%- assign font_head = brand.fonts.heading | default: 'Bricolage Grotesque' -%}
{%- assign font_body = brand.fonts.body | default: 'Instrument Sans' -%}
{%- assign head_q = font_head | replace: ' ', '+' -%}
{%- assign body_q = font_body | replace: ' ', '+' -%}
{%- assign first = person.first_name | default: 'there' -%}
{%- assign short_name = account.name | split: ' - ' | first | split: ' | ' | first | strip | default: account.name -%}
{%- assign industry = account.industry | default: 'your industry' -%}
{%- assign sender_name = sender.name | default: 'Our team' -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex">
<title>Five moves for {{ short_name | escape }}</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ head_q }}:wght@400;500;600;700{% if font_body != font_head %}&family={{ body_q }}:wght@400;500;600{% endif %}&display=swap">
<style>
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:#fff;-webkit-font-smoothing:antialiased}
.ig{--p:{{ accent }};--ink:#1b1a18;--mute:color-mix(in srgb,var(--ink) 58%,#fff);--rule:color-mix(in srgb,var(--ink) 16%,#fff);--tint:color-mix(in srgb,var(--p) 7%,#fff);--pt:color-mix(in srgb,var(--p) 82%,var(--ink));font-family:'{{ font_body }}',ui-sans-serif,system-ui,sans-serif;font-size:16px;line-height:1.6;color:var(--ink);max-width:62rem;margin:0 auto;padding:0 1.25rem 3rem}
.ig h1{font-family:'{{ font_head }}',ui-sans-serif,system-ui,sans-serif;font-weight:600;font-size:clamp(2.35rem,8.5vw,4.1rem);line-height:1;letter-spacing:-.03em;max-width:15ch;margin:0 0 1.25rem;text-wrap:balance}
.ig p{margin:0 0 1rem}
.ig a{color:var(--pt)}
.lab{font-size:.72rem;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--pt);margin:0 0 .6rem;line-height:1.3}
.top{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:1rem 0;border-bottom:1px solid var(--rule);font-size:.9rem}
.logo{height:26px;width:auto;display:block}
.bname{font-weight:600;margin:0}
.kind{color:var(--mute);margin:0}
.cover{padding:2.5rem 0 1rem}
.stand{font-size:1.08rem;line-height:1.55;color:var(--mute);max-width:34rem}
.note{background:var(--tint);border-left:3px solid var(--p);border-radius:0 8px 8px 0;padding:1rem 1.1rem .05rem;max-width:34rem;margin:1.5rem 0 0}
.plate{display:grid;gap:1.1rem;border-top:3px solid var(--p);padding-top:1.1rem;margin-top:2.25rem;font-size:.92rem;line-height:1.45}
.plate small{display:block;color:var(--mute);font-size:.7rem;font-weight:600;letter-spacing:.12em;text-transform:uppercase;margin-bottom:.3rem}
.plate b{font-weight:600;display:block}
.plate span{display:block;color:var(--mute)}
.closing{padding:2rem 0 1rem}
.closing p{max-width:34rem}
.ask{margin:1.4rem 0 1.75rem}
.ask .ken-cta{min-height:44px;line-height:20px}
.sign{font-weight:600;margin:0}
.sign span{display:block;font-weight:400;color:var(--mute);font-size:.92rem}
@media (min-width:640px){.ig{padding:0 2rem 4rem}.plate{grid-template-columns:repeat(3,minmax(0,1fr))}}
@media (min-width:960px){.ig{padding:0 2.5rem 5rem}.cover{padding:3.5rem 0 1rem}}
</style>
</head>
<body>
<main class="ig">
<header class="top">
{%- if brand.logo_url %}
<img class="logo" src="{{ brand.logo_url | escape }}" alt="{{ brand.name | default: 'Logo' | escape }}">
{%- elsif brand.name %}
<p class="bname">{{ brand.name | escape }}</p>
{%- else %}
<span></span>
{%- endif %}
<p class="kind">Industry playbook</p>
</header>
<section data-section="cover" class="cover">
<p class="lab">{{ industry | capitalize | escape }}</p>
<h1>Five moves for {{ short_name | escape }}</h1>
<p class="stand">Hi {{ first | escape }}, I am writing a short playbook for {{ short_name | escape }}: five moves for {% if person.title %}a {{ person.title | escape }}{% else %}your team{% endif %} in {{ industry | escape }}, each with a worked example and a first step you can take this week.</p>
<div class="note">
<p>The moves are not on this page yet. Check back soon, or reply to my email and I will send the finished guide as a PDF.</p>
</div>
<div class="plate">
<div><small>Written for</small><b>{% if person.first_name %}{{ person.first_name | escape }} {{ person.last_name | escape }}{% else %}The team at {{ short_name | escape }}{% endif %}</b><span>{% if person.first_name %}{% if person.title %}{{ person.title | escape }}, {% endif %}{{ short_name | escape }}{% else %}{{ industry | capitalize | escape }}{% endif %}</span></div>
<div><small>From</small><b>{{ sender_name | escape }}</b><span>{% if sender.title %}{{ sender.title | escape }}{% if brand.name %}, {% endif %}{% endif %}{{ brand.name | escape }}</span></div>
<div><small>Inside</small><b>Five moves</b><span>Each with an example and a first step</span></div>
</div>
</section>
<section data-section="closing" class="closing">
<p class="lab">In the meantime</p>
<p>If you would rather talk it through, grab 20 minutes and I will walk you through the moves I have so far and what I think applies to {{ short_name | escape }}.</p>
<div class="ask">
{% render 'ken/cta', label: 'Book 20 minutes', kind: 'booking' %}
</div>
<p class="sign">{{ sender_name | escape }}<span>{% if sender.title %}{{ sender.title | escape }}{% if brand.name %}, {% endif %}{% endif %}{{ brand.name | escape }}</span></p>
</section>
</main>
</body>
</html>
