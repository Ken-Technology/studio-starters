{%- assign accent = brand.colors.primary | default: '#9a3b2e' -%}
{%- assign accent2 = brand.colors.secondary | default: '#2d3f50' -%}
{%- assign font_head = brand.fonts.heading | default: 'Bricolage Grotesque' -%}
{%- assign font_body = brand.fonts.body | default: 'Instrument Sans' -%}
{%- assign head_q = font_head | replace: ' ', '+' -%}
{%- assign body_q = font_body | replace: ' ', '+' -%}
{%- assign short_name = account.name | split: ' - ' | first | split: ' | ' | first | strip | default: account.name -%}
{%- assign industry = account.industry | default: 'your industry' -%}
{%- assign sender_name = sender.name | default: 'Our team' -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex">
<title>{{ data.title | escape }}</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ head_q }}:wght@400;500;600;700{% if font_body != font_head %}&family={{ body_q }}:wght@400;500;600{% endif %}&display=swap">
<style>
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:#fff;-webkit-font-smoothing:antialiased;-webkit-print-color-adjust:exact;print-color-adjust:exact}
.ig{--p:{{ accent }};--s:{{ accent2 }};--ink:#1b1a18;--mute:color-mix(in srgb,var(--ink) 58%,#fff);--rule:color-mix(in srgb,var(--ink) 16%,#fff);--hair:color-mix(in srgb,var(--ink) 9%,#fff);--tint:color-mix(in srgb,var(--p) 7%,#fff);--pt:color-mix(in srgb,var(--p) 82%,var(--ink));font-family:'{{ font_body }}',ui-sans-serif,system-ui,sans-serif;font-size:16px;line-height:1.6;color:var(--ink);max-width:62rem;margin:0 auto;padding:0 1.25rem 3rem}
.ig h1,.ig h2{font-family:'{{ font_head }}',ui-sans-serif,system-ui,sans-serif;font-weight:600;line-height:1.1;letter-spacing:-.018em;margin:0;text-wrap:balance}
.ig p{margin:0 0 1rem}
.ig a{color:var(--pt);text-decoration-thickness:1px;text-underline-offset:.15em}
.ig a:focus-visible{outline:2px solid var(--p);outline-offset:3px}
.lab{font-size:.72rem;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--pt);margin:0 0 .6rem;line-height:1.3}
.top{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:1rem 0;border-bottom:1px solid var(--rule);font-size:.9rem}
.logo{height:26px;width:auto;display:block}
.bname{font-weight:600;margin:0}
.kind{color:var(--mute);margin:0}
.cover{padding:2.5rem 0 2.25rem}
.cover-grid{display:grid;gap:2.25rem}
.cover h1{font-size:clamp(2.35rem,8.5vw,3.9rem);line-height:1;letter-spacing:-.03em;max-width:16ch;margin:0 0 1.25rem}
.stand{font-size:1.08rem;line-height:1.55;color:var(--mute);max-width:34rem;margin:0}
.toc{list-style:none;margin:0;padding:0;counter-reset:mv}
.toc li{counter-increment:mv;border-top:1px solid var(--hair)}
.toc li:last-child{border-bottom:1px solid var(--hair)}
.toc a{display:grid;grid-template-columns:2.1rem minmax(0,1fr);gap:.5rem;align-items:baseline;min-height:44px;padding:.7rem 0;color:var(--ink);text-decoration:none;font-family:'{{ font_head }}',ui-sans-serif,system-ui,sans-serif;font-weight:500;font-size:1.04rem;line-height:1.3}
.toc a::before{content:counter(mv,decimal-leading-zero);font-size:.82rem;font-weight:600;color:var(--p);letter-spacing:.04em;font-variant-numeric:tabular-nums}
.toc a:hover{color:var(--pt)}
.plate{display:grid;gap:1.1rem;border-top:3px solid var(--p);padding-top:1.1rem;margin-top:2.25rem;font-size:.92rem;line-height:1.45}
.plate small{display:block;color:var(--mute);font-size:.7rem;font-weight:600;letter-spacing:.12em;text-transform:uppercase;margin-bottom:.3rem}
.plate b{font-weight:600;display:block}
.plate span{display:block;color:var(--mute)}
.move{border-top:1px solid var(--rule);padding:2rem 0 1.25rem;display:grid;gap:0 3rem;grid-template-columns:minmax(0,1fr);grid-template-areas:"num" "head" "body" "step"}
.num{grid-area:num;display:flex;align-items:baseline;gap:.6rem;margin:0 0 .9rem;font-family:'{{ font_head }}',ui-sans-serif,system-ui,sans-serif;font-weight:500;font-size:2.4rem;line-height:1;letter-spacing:-.04em;color:var(--p);font-variant-numeric:tabular-nums}
.num small{font-family:'{{ font_body }}',ui-sans-serif,system-ui,sans-serif;font-size:.72rem;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--mute)}
.move h2{grid-area:head;font-size:clamp(1.5rem,5.2vw,2rem);line-height:1.12;margin:0 0 1rem;max-width:22ch}
.body{grid-area:body;max-width:38rem}
.ex{background:var(--tint);border-left:3px solid var(--s);padding:1rem 1.1rem .05rem;margin:.25rem 0 1.25rem;border-radius:0 8px 8px 0}
.ex .lab{margin-bottom:.4rem}
.step{grid-area:step;border:1px solid var(--rule);border-radius:10px;padding:1rem 1.1rem .05rem;align-self:start;max-width:38rem}
.step .lab{display:flex;align-items:center;gap:.5rem}
.step .lab::before{content:"";width:.8rem;height:.8rem;border:1.5px solid var(--p);border-radius:3px;flex:none}
.step p{font-size:.95rem;line-height:1.55}
.closing{border-top:1px solid var(--rule);padding:2.5rem 0 1rem}
.close-grid{display:grid;gap:2.25rem}
.closing h2{font-size:clamp(1.6rem,5.5vw,2.2rem);line-height:1.1;margin:0 0 1rem;max-width:18ch}
.close-main p{max-width:38rem}
.offer{border-top:1px solid var(--hair);padding-top:1.1rem;margin:1.5rem 0 0}
.ask{margin:1.6rem 0 1.75rem}
.ask .ken-cta{min-height:44px;line-height:20px;background:var(--p)!important}
.ask-alt{font-size:.92rem;color:var(--mute);margin:.9rem 0 0;max-width:30rem}
.sign{font-weight:600;margin:0}
.sign span{display:block;font-weight:400;color:var(--mute);font-size:.92rem}
.aside{border-top:3px solid var(--p);padding-top:1.1rem;align-self:start}
.sig{list-style:none;margin:0;padding:0}
.sig li{border-top:1px solid var(--hair);font-size:.95rem;line-height:1.45}
.sig a,.sig span{display:block;padding:.7rem 0;color:var(--ink)}
.sig a{text-decoration-color:var(--rule)}
.sig a:hover{text-decoration-color:var(--pt)}
.sig time{display:block;font-size:.78rem;color:var(--mute);font-variant-numeric:tabular-nums;margin-bottom:.15rem}
.sig-note{font-size:.85rem;color:var(--mute);margin:.9rem 0 0}
.foot{border-top:1px solid var(--rule);margin-top:2.5rem;padding-top:1rem;font-size:.82rem;color:var(--mute)}
.foot p{margin:0}
@media (min-width:640px){
.ig{padding:0 2rem 4rem}
.move{grid-template-columns:6rem minmax(0,1fr);grid-template-areas:"num head" "num body" "num step";padding:2.5rem 0 1.5rem}
.num{font-size:3.2rem;flex-direction:column;align-items:flex-start;gap:.55rem;margin:0}
.step{margin-top:.2rem}
.plate{grid-template-columns:repeat(3,minmax(0,1fr))}
}
@media (min-width:960px){
.ig{padding:0 2.5rem 5rem}
.cover{padding:3.5rem 0 2.5rem}
.cover-grid{grid-template-columns:minmax(0,1.45fr) minmax(0,1fr);gap:3.5rem;align-items:start}
.move{grid-template-columns:13rem minmax(0,1fr);grid-template-areas:"num head" "step body";gap:0 4rem;padding:3rem 0 2rem}
.num{font-size:3.8rem}
.close-grid.has-aside{grid-template-columns:minmax(0,1.3fr) minmax(0,1fr);gap:4rem}
}
@page{margin:16mm 16mm 18mm}
@media print{
.ig{max-width:none;padding:0;font-size:11pt;line-height:1.5}
.top{padding:.5rem 0}
.cover,.move,.closing{break-before:page}
.cover{break-before:auto;padding-top:3rem}
.cover-grid{grid-template-columns:minmax(0,1fr);gap:2rem}
.move{grid-template-columns:5rem minmax(0,1fr);grid-template-areas:"num head" "num body" "num step";gap:0 1.25rem;padding:1.4rem 0 .4rem;break-inside:avoid}
.move+.move{break-before:auto;border-top:1px solid var(--rule)}
.num{font-size:2.6rem}
.move h2{font-size:1.55rem;margin-bottom:.7rem}
.body,.step{max-width:none}
.body p{margin-bottom:.8rem}
.ex{padding:.75rem .95rem .05rem;margin:0 0 .9rem}
.step{padding:.75rem .95rem .05rem}
.ex p,.step p{margin-bottom:.75rem}
.lab{margin-bottom:.35rem}
.toc a{min-height:0;padding:.45rem 0}
.closing{border-top:0;padding-top:.5rem}
.close-grid.has-aside{grid-template-columns:minmax(0,1.3fr) minmax(0,1fr);gap:2.5rem}
.foot{margin-top:1.5rem;break-inside:avoid}
}
</style>
</head>
<body>
<main class="ig">
<header class="top">
{%- if brand.logo_url %}
<img class="logo" src="{{ brand.logo_url | escape }}" alt="{{ brand.name | default: 'Logo' | escape }}">
{%- elsif brand.name %}
<p class="bname">{{ brand.name | escape }}</p>
{%- else %}
<span></span>
{%- endif %}
<p class="kind">Industry playbook</p>
</header>
<section data-section="cover" class="pg cover">
<div class="cover-grid">
<div class="cover-main">
<p class="lab">{{ industry | capitalize | escape }}</p>
<h1>{{ data.title | escape }}</h1>
<p class="stand">{{ data.intro | escape | newline_to_br | strip_newlines | raw }}</p>
</div>
<nav class="toc-wrap" aria-label="The five moves">
<p class="lab">The five moves</p>
<ol class="toc">
{%- for m in data.moves %}
<li><a href="#move-{{ forloop.index }}">{{ m.name | escape }}</a></li>
{%- endfor %}
</ol>
</nav>
</div>
<div class="plate">
<div><small>Written for</small><b>{% if person.first_name %}{{ person.first_name | escape }} {{ person.last_name | escape }}{% else %}The team at {{ short_name | escape }}{% endif %}</b><span>{% if person.first_name %}{% if person.title %}{{ person.title | escape }}, {% endif %}{{ short_name | escape }}{% else %}{{ industry | capitalize | escape }}{% endif %}</span></div>
<div><small>From</small><b>{{ sender_name | escape }}</b><span>{% if sender.title %}{{ sender.title | escape }}{% if brand.name %}, {% endif %}{% endif %}{{ brand.name | escape }}</span></div>
<div><small>Inside</small><b>Five moves</b><span>Each with an example and a first step</span></div>
</div>
</section>

{%- assign m = data.moves[0] %}
<section data-section="move_1" id="move-1" class="pg move">
<p class="num"><span>01</span><small>of five</small></p>
<h2>{{ m.name | escape }}</h2>
<div class="body">
<p>{{ m.why | escape | newline_to_br | strip_newlines | raw }}</p>
<div class="ex"><p class="lab">Example</p><p>{{ m.example | escape | newline_to_br | strip_newlines | raw }}</p></div>
</div>
<div class="step"><p class="lab">First step</p><p>{{ m.first_step | escape }}</p></div>
</section>

{%- assign m = data.moves[1] %}
<section data-section="move_2" id="move-2" class="pg move">
<p class="num"><span>02</span><small>of five</small></p>
<h2>{{ m.name | escape }}</h2>
<div class="body">
<p>{{ m.why | escape | newline_to_br | strip_newlines | raw }}</p>
<div class="ex"><p class="lab">Example</p><p>{{ m.example | escape | newline_to_br | strip_newlines | raw }}</p></div>
</div>
<div class="step"><p class="lab">First step</p><p>{{ m.first_step | escape }}</p></div>
</section>

{%- assign m = data.moves[2] %}
<section data-section="move_3" id="move-3" class="pg move">
<p class="num"><span>03</span><small>of five</small></p>
<h2>{{ m.name | escape }}</h2>
<div class="body">
<p>{{ m.why | escape | newline_to_br | strip_newlines | raw }}</p>
<div class="ex"><p class="lab">Example</p><p>{{ m.example | escape | newline_to_br | strip_newlines | raw }}</p></div>
</div>
<div class="step"><p class="lab">First step</p><p>{{ m.first_step | escape }}</p></div>
</section>

{%- assign m = data.moves[3] %}
<section data-section="move_4" id="move-4" class="pg move">
<p class="num"><span>04</span><small>of five</small></p>
<h2>{{ m.name | escape }}</h2>
<div class="body">
<p>{{ m.why | escape | newline_to_br | strip_newlines | raw }}</p>
<div class="ex"><p class="lab">Example</p><p>{{ m.example | escape | newline_to_br | strip_newlines | raw }}</p></div>
</div>
<div class="step"><p class="lab">First step</p><p>{{ m.first_step | escape }}</p></div>
</section>

{%- assign m = data.moves[4] %}
<section data-section="move_5" id="move-5" class="pg move">
<p class="num"><span>05</span><small>of five</small></p>
<h2>{{ m.name | escape }}</h2>
<div class="body">
<p>{{ m.why | escape | newline_to_br | strip_newlines | raw }}</p>
<div class="ex"><p class="lab">Example</p><p>{{ m.example | escape | newline_to_br | strip_newlines | raw }}</p></div>
</div>
<div class="step"><p class="lab">First step</p><p>{{ m.first_step | escape }}</p></div>
</section>

<section data-section="closing" id="closing" class="pg closing">
<div class="close-grid{% if data.signals.size > 0 %} has-aside{% endif %}">
<div class="close-main">
<p class="lab">Where to start</p>
<h2>Start with one move this week</h2>
<p>{{ data.closing | escape | newline_to_br | strip_newlines | raw }}</p>
{%- if data.offer and data.offer != '' %}
<div class="offer"><p class="lab">{% if brand.name %}How {{ brand.name | escape }} helps{% else %}How we help{% endif %}</p><p>{{ data.offer | escape | newline_to_br | strip_newlines | raw }}</p></div>
{%- endif %}
<div class="ask">
{% render 'ken/cta', label: 'Book 20 minutes', kind: 'booking' %}
<p class="ask-alt">Or reply to my email with the move you want to talk through, and I will send what we have on it.</p>
</div>
<p class="sign">{{ sender_name | escape }}<span>{% if sender.title %}{{ sender.title | escape }}{% if brand.name %}, {% endif %}{% endif %}{{ brand.name | escape }}</span></p>
</div>
{%- if data.signals.size > 0 %}
<aside class="aside">
<p class="lab">Why now at {{ short_name | escape }}</p>
<ul class="sig">
{%- for s in data.signals limit: 3 %}
{%- assign s_head = s.source_url | slice: 0, 8 %}
<li>{% if s_head == 'https://' %}<a href="{{ s.source_url | escape }}">{% if s.date %}<time>{{ s.date | date: '%b %-d, %Y' }}</time>{% endif %}{{ s.title | escape }}</a>{% else %}<span>{% if s.date %}<time>{{ s.date | date: '%b %-d, %Y' }}</time>{% endif %}{{ s.title | escape }}</span>{% endif %}</li>
{%- endfor %}
</ul>
<p class="sig-note">What we read about {{ short_name | escape }} while writing this. It shaped the examples.</p>
</aside>
{%- endif %}
</div>
</section>
<footer class="foot"><p>Written for {% if person.first_name %}{{ person.first_name | escape }} {{ person.last_name | escape }} at {% endif %}{{ short_name | escape }} by {{ sender_name | escape }}{% if brand.name %} at {{ brand.name | escape }}{% endif %}. A private link.</p></footer>
</main>
</body>
</html>
