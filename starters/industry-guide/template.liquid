{%- assign accent = brand.colors.primary | default: '#38450f' -%}
{%- assign accent2 = brand.colors.secondary | default: '#d4a017' -%}
{%- assign font_head = brand.fonts.heading | default: 'Rokkitt' -%}
{%- assign font_body = brand.fonts.body | default: 'Spectral' -%}
{%- assign head_q = font_head | replace: ' ', '+' -%}
{%- assign body_q = font_body | replace: ' ', '+' -%}
{%- if brand.fonts.heading -%}{%- assign head_w = 'wght@400;700' -%}{%- else -%}{%- assign head_w = 'wght@700;800' -%}{%- endif -%}
{%- if brand.fonts.body -%}{%- assign body_w = 'wght@400;700' -%}{%- else -%}{%- assign body_w = 'wght@400;600' -%}{%- endif -%}
{%- assign short_name = account.name | split: ' - ' | first | split: ' | ' | first | strip | default: account.name -%}
{%- assign industry = account.industry | default: 'your industry' -%}
{%- assign sender_name = sender.name | default: 'Our team' -%}
{%- assign t_parts = data.title | split: ' for ' -%}
{%- assign t_big = t_parts | first -%}
{%- assign t_split = false -%}
{%- if t_parts.size > 1 and t_big.size <= 10 -%}{%- assign t_split = true -%}{%- assign t_rest = data.title | remove_first: t_big | strip -%}{%- endif -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex">
<title>{{ data.title | escape }}</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ head_q }}:{{ head_w }}&display=swap">
{%- if font_body != font_head %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ body_q }}:{{ body_w }}&display=swap">
{%- endif %}
<style>
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:#ecebe7;-webkit-font-smoothing:antialiased;-webkit-print-color-adjust:exact;print-color-adjust:exact}
.hb{--p:{{ accent }};--s:{{ accent2 }};--bone:#ecebe7;--leaf:#e1dfd9;--ink:#2f3a0c;--ink:oklch(from var(--p) min(l, 0.3) min(c, 0.07) h);--soft:color-mix(in oklab,var(--ink) 78%,var(--bone));--fh:'{{ font_head }}',Rockwell,'Roboto Slab',Georgia,serif;--fb:'{{ font_body }}',Georgia,'Times New Roman',serif;--m:clamp(1.25rem,2.6vw,2.5rem);--t1:var(--p);--t2:color-mix(in oklab,var(--p) 84%,var(--bone));--t3:color-mix(in oklab,var(--p) 76%,var(--bone));--t4:color-mix(in oklab,var(--p) 36%,var(--bone));--t5:color-mix(in oklab,var(--p) 18%,var(--bone));background:var(--bone);color:var(--ink);font-family:var(--fb);font-size:1.125rem;line-height:1.6;max-width:84rem;margin:0 auto;padding:0 var(--m) 2rem}
.hb ::selection{background:var(--s);color:var(--ink)}
.hb h1,.hb h2,.hb h3{font-family:var(--fh);font-weight:700;margin:0;text-wrap:balance}
.hb p{margin:0}
.hb a{color:inherit;text-decoration-thickness:.07em;text-underline-offset:.18em}
.hb a:focus-visible{outline:3px solid var(--s);outline-offset:3px}
.on{--bgc:var(--p);background:var(--bgc);color:#f3f2ee;color:oklch(from var(--bgc) clamp(0.2, (0.6 - l) * 100, 0.97) min(c, 0.03) h)}
.top{display:flex;align-items:baseline;justify-content:space-between;gap:1rem;padding:1.1rem 0 1rem;font-size:.875rem;line-height:1.4}
.top p{color:var(--soft)}
.logo{height:26px;width:auto;display:block}
.bname{font-family:var(--fh);font-weight:700;font-size:1.3125rem;color:var(--ink)!important}
.cover{display:grid;gap:1.25rem;padding-bottom:3.5rem}
.book{container-type:inline-size;display:flex;flex-direction:column;justify-content:space-between;gap:2.5rem;min-height:56svh;padding:1.75rem 1.5rem 1.5rem}
.book h1{font-size:min(9.5rem,27cqi);font-weight:800;line-height:.86;letter-spacing:-.01em;text-transform:uppercase;max-width:5ch;margin-left:-.04em}
.book h1.long{font-size:clamp(2.1rem,8vw,3.6rem);line-height:1;text-transform:none;max-width:16ch;letter-spacing:-.015em}
.sub{font-family:var(--fh);font-weight:700;font-size:clamp(1.3125rem,5.6vw,2rem);line-height:1.12;max-width:20ch;margin-top:1.1rem!important;text-wrap:balance}
.made{display:grid;gap:.6rem;font-size:1.125rem;line-height:1.45;max-width:30rem}
.tabs{list-style:none;margin:0;padding:0;display:grid;gap:.4rem}
.tabs li{--bgc:var(--t1);border-radius:0 14px 14px 0}
.tabs li:nth-child(2){--bgc:var(--t2);margin-left:5%}
.tabs li:nth-child(3){--bgc:var(--t3);margin-left:10%}
.tabs li:nth-child(4){--bgc:var(--t4);margin-left:15%}
.tabs li:nth-child(5){--bgc:var(--t5);margin-left:20%}
.tabs a{display:grid;grid-template-columns:4.6rem minmax(0,1fr);align-items:baseline;gap:.5rem;min-height:3.4rem;padding:.75rem 1.1rem .7rem 1rem;text-decoration:none;font-size:1.125rem;line-height:1.3}
.tabs a:hover .tt{text-decoration:underline}
.tn{font-family:var(--fh);font-weight:800;font-size:1.3125rem}
.tt{font-weight:600}
.intro{font-size:1.3125rem;line-height:1.5;max-width:34rem;padding-top:1.75rem}
.move{padding:4.5rem 0 1rem}
.band{--bgc:var(--t1);display:grid;gap:.75rem;padding:1.5rem 1.25rem 1.35rem;border-radius:0 14px 14px 0}
.move-2 .band{--bgc:var(--t2)}
.move-3 .band{--bgc:var(--t3)}
.move-4 .band{--bgc:var(--t4)}
.move-5 .band{--bgc:var(--t5)}
.band h2{font-size:1.5rem;line-height:1.05;letter-spacing:-.015em;max-width:26ch}
.mark{font-family:var(--fh);font-weight:700;font-size:1.3125rem;line-height:1}
.mark b{font-weight:800}
.body{display:grid;gap:2rem;padding-top:2rem}
.why{font-size:1.3125rem;line-height:1.5;max-width:44rem}
.ex{background:var(--leaf);padding:1.4rem 1.25rem 1.5rem;margin-top:1.75rem}
.ex h3,.todo h3{font-size:1.3125rem;line-height:1.2;margin-bottom:.5rem}
.todo{--bgc:var(--s);display:grid;grid-template-columns:2.25rem minmax(0,1fr);gap:.2rem 1rem;align-content:start;padding:1.4rem 1.25rem 1.5rem;align-self:start}
.todo svg{grid-row:1 / span 2;width:2.25rem;height:2.25rem;display:block}
.todo svg rect{fill:none;stroke:currentColor;stroke-width:3}
.closing{margin-top:4.5rem;padding:2.75rem 1.5rem 2.5rem;display:grid;gap:2.5rem}
.closing h2{font-size:clamp(2rem,7vw,3.4rem);line-height:1;letter-spacing:-.01em;max-width:13ch;margin-bottom:1.25rem}
.close-main>p{max-width:36rem}
.offer{margin-top:1.75rem;max-width:36rem}
.offer h3,.aside h3{font-size:1.3125rem;line-height:1.2;margin-bottom:.4rem}
.ask{margin:2rem 0 1.75rem}
.ask .ken-cta{display:inline-block!important;min-height:48px;padding:14px 24px!important;border-radius:0!important;background:var(--bone)!important;color:var(--ink)!important;font-family:var(--fh);font-weight:800!important;font-size:1.3125rem;line-height:20px}
.ask .ken-cta:hover{background:var(--s)!important}
.ask .ken-cta:focus-visible{outline:3px solid var(--s);outline-offset:3px}
.ask-alt{margin-top:.9rem!important;max-width:30rem}
.sign{font-family:var(--fh);font-weight:700;font-size:1.3125rem;line-height:1.2}
.sign span{display:block;font-family:var(--fb);font-weight:400;font-size:1.125rem;margin-top:.2rem}
.aside{align-self:start}
.sig{list-style:none;margin:0;padding:0;display:grid;gap:1rem}
.sig a,.sig span{display:block;font-size:1.125rem;line-height:1.4}
.sig time{display:block;font-family:var(--fh);font-weight:700;font-size:1.125rem;margin-bottom:.1rem}
.sig-note{margin-top:1.25rem!important;line-height:1.45}
.foot{padding:1.5rem 0 0;font-size:.875rem;line-height:1.45;color:var(--soft)}
@media (prefers-reduced-motion:no-preference){
.tabs li{animation:pull .7s cubic-bezier(.2,.7,.2,1) both}
.tabs li:nth-child(2){animation-delay:.07s}
.tabs li:nth-child(3){animation-delay:.14s}
.tabs li:nth-child(4){animation-delay:.21s}
.tabs li:nth-child(5){animation-delay:.28s}
@keyframes pull{from{transform:translateX(-2.5rem)}to{transform:none}}
}
@media (min-width:700px){
.book{padding:2.25rem 2.25rem 2rem}
.band{grid-template-columns:minmax(0,1fr) auto;align-items:end;gap:2rem;padding:1.75rem 2rem 1.6rem}
.mark{text-align:right}
.mark b{display:block;font-size:3.4rem;line-height:.9}
.band h2{font-size:clamp(2rem,4.4vw,3.4rem);line-height:1}
.body{grid-template-columns:minmax(0,1fr) minmax(15rem,20rem);gap:3rem}
.closing{padding:3.5rem 2.5rem 3rem}
}
@media (min-width:1000px){
.cover{grid-template-columns:minmax(0,26rem) minmax(0,1fr);gap:0;align-items:stretch;padding-bottom:5rem}
.book{min-height:40rem;padding:2.5rem 2.5rem 2.25rem}
.right{padding:2.25rem 0 0}
.tabs{gap:.45rem}
.tabs li{margin-left:0}
.tabs li:nth-child(2){margin-left:3rem}
.tabs li:nth-child(3){margin-left:6rem}
.tabs li:nth-child(4){margin-left:9rem}
.tabs li:nth-child(5){margin-left:12rem}
.tabs a{min-height:4rem;padding:1rem 1.5rem 1rem 1.25rem;grid-template-columns:5.5rem minmax(0,1fr)}
.intro{padding:2.5rem 0 0 1.25rem;max-width:38rem}
.move{padding-top:6.5rem}
.band{padding:2.25rem 2.5rem 2rem}
.body{grid-template-columns:minmax(0,1fr) 22rem;gap:3.5rem;padding-top:2.5rem}
.ex{padding:1.75rem 2rem 1.9rem}
.ex p{max-width:66ch}
.closing{grid-template-columns:minmax(0,1.35fr) minmax(0,1fr);gap:4.5rem;padding:4rem 3.5rem 3.5rem;margin-top:6.5rem}
}
@page{margin:14mm 14mm 16mm}
@media print{
.hb{max-width:none;padding:0;font-size:11pt;line-height:1.5}
.top{padding:0 0 4mm}
.cover{grid-template-columns:1fr;padding:0}
.book{min-height:150mm}
.right{padding:0}
.tabs li{margin-left:0!important;animation:none}
.tabs a{min-height:0;padding:2.2mm 4mm}
.intro{padding:5mm 0 0;font-size:12pt}
.move,.closing{break-before:page}
.move{padding:0}
.band{break-inside:avoid}
.band h2{font-size:24pt}
.body{grid-template-columns:1fr 58mm;gap:8mm;padding-top:6mm}
.why{font-size:12.5pt}
.ex{margin-top:5mm;padding:4mm 5mm}
.todo{padding:4mm}
.closing{margin-top:0;padding:10mm;grid-template-columns:1.3fr 1fr;gap:8mm}
.closing h2{font-size:28pt}
.foot{break-inside:avoid}
}
</style>
</head>
<body>
<main class="hb">
<header class="top">
{%- if brand.logo_url %}
<img class="logo" src="{{ brand.logo_url | escape }}" alt="{{ brand.name | default: 'Logo' | escape }}">
{%- elsif brand.name %}
<p class="bname">{{ brand.name | escape }}</p>
{%- else %}
<span></span>
{%- endif %}
<p>Industry playbook{% if account.industry %} for {{ industry | escape }}{% endif %}</p>
</header>
<section data-section="cover" class="cover">
<div class="book on">
<div>
{%- if t_split %}
<h1>{{ t_big | escape }}</h1>
<p class="sub">{{ t_rest | escape }}</p>
{%- else %}
<h1 class="long">{{ data.title | escape }}</h1>
{%- endif %}
</div>
<div class="made">
<p>Written for {% if person.first_name %}{{ person.first_name | escape }} {{ person.last_name | escape }}{% if person.title %}, {{ person.title | escape }}{% endif %} at {{ short_name | escape }}{% else %}the team at {{ short_name | escape }}{% endif %}{% if account.industry %}, in {{ industry | escape }}{% endif %}.</p>
<p>From {{ sender_name | escape }}{% if sender.title %}, {{ sender.title | escape }}{% endif %}{% if brand.name %} at {{ brand.name | escape }}{% endif %}.</p>
</div>
</div>
<div class="right">
<nav aria-label="The five moves">
<ol class="tabs">
{%- for m in data.moves %}
<li class="on"><a href="#move-{{ forloop.index }}"><span class="tn">Move {{ forloop.index }}</span><span class="tt">{{ m.name | escape }}</span></a></li>
{%- endfor %}
</ol>
</nav>
<p class="intro">{{ data.intro | escape | newline_to_br | strip_newlines | raw }}</p>
</div>
</section>
{%- for m in data.moves limit: 5 %}
{%- case forloop.index %}
{%- when 1 %}
<section data-section="move_1" id="move-1" class="move move-1">
{%- when 2 %}
<section data-section="move_2" id="move-2" class="move move-2">
{%- when 3 %}
<section data-section="move_3" id="move-3" class="move move-3">
{%- when 4 %}
<section data-section="move_4" id="move-4" class="move move-4">
{%- else %}
<section data-section="move_5" id="move-5" class="move move-5">
{%- endcase %}
<div class="band on">
<h2>{{ m.name | escape }}</h2>
<p class="mark">Move <b>{{ forloop.index }}</b> of {{ forloop.length }}</p>
</div>
<div class="body">
<div>
<p class="why">{{ m.why | escape | newline_to_br | strip_newlines | raw }}</p>
<div class="ex">
<h3>Worked example</h3>
<p>{{ m.example | escape | newline_to_br | strip_newlines | raw }}</p>
</div>
</div>
<div class="todo on">
<svg viewBox="0 0 36 36" aria-hidden="true"><rect x="3" y="3" width="30" height="30"/></svg>
<h3>First step</h3>
<p>{{ m.first_step | escape }}</p>
</div>
</div>
</section>
{%- endfor %}
<section data-section="closing" id="closing" class="closing on">
<div class="close-main">
<h2>Start with one move this week</h2>
<p>{{ data.closing | escape | newline_to_br | strip_newlines | raw }}</p>
{%- if data.offer and data.offer != '' %}
<div class="offer">
<h3>{% if brand.name %}How {{ brand.name | escape }} helps{% else %}How we help{% endif %}</h3>
<p>{{ data.offer | escape | newline_to_br | strip_newlines | raw }}</p>
</div>
{%- endif %}
<div class="ask">
{% render 'ken/cta', label: 'Book 20 minutes', kind: 'booking' %}
<p class="ask-alt">Or reply to my email with the move you want to talk through, and I will send what we have on it.</p>
</div>
<p class="sign">{{ sender_name | escape }}{% if sender.title or brand.name %}<span>{% if sender.title %}{{ sender.title | escape }}{% if brand.name %}, {% endif %}{% endif %}{{ brand.name | escape }}</span>{% endif %}</p>
</div>
{%- if data.signals.size > 0 %}
<aside class="aside">
<h3>Why now at {{ short_name | escape }}</h3>
<ul class="sig">
{%- for s in data.signals limit: 3 %}
{%- assign s_head = s.source_url | slice: 0, 8 %}
<li>{% if s_head == 'https://' %}<a href="{{ s.source_url | escape }}">{% if s.date %}<time>{{ s.date | date: '%b %-d, %Y' }}</time>{% endif %}{{ s.title | escape }}</a>{% else %}<span>{% if s.date %}<time>{{ s.date | date: '%b %-d, %Y' }}</time>{% endif %}{{ s.title | escape }}</span>{% endif %}</li>
{%- endfor %}
</ul>
<p class="sig-note">What we read about {{ short_name | escape }} while writing this. It shaped the examples.</p>
</aside>
{%- endif %}
</section>
<footer class="foot"><p>Written for {% if person.first_name %}{{ person.first_name | escape }} {{ person.last_name | escape }} at {% endif %}{{ short_name | escape }} by {{ sender_name | escape }}{% if brand.name %} at {{ brand.name | escape }}{% endif %}. A private link.</p></footer>
</main>
</body>
</html>
