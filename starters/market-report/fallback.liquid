{%- assign accent = brand.colors.primary | default: '#30734a' | escape -%}
{%- assign accent2 = brand.colors.secondary | default: '#2b2622' | escape -%}
{%- assign font_head = brand.fonts.heading | default: 'Red Hat Display' | escape -%}
{%- assign font_body = brand.fonts.body | default: 'Red Hat Text' | escape -%}
{%- assign acct = account.name | default: 'your company' -%}
{%- assign logo = brand.logo_url | default: '' -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex">
<title>{{ acct | escape }} market report</title>
{%- if font_head == 'Red Hat Display' %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Red+Hat+Display:wght@900&display=swap">
{%- else %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_head | url_encode }}&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_head | url_encode }}:wght@700&display=swap">
{%- endif %}
{%- if font_body != font_head %}
{%- if font_body == 'Red Hat Text' %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Red+Hat+Text:wght@400;500&display=swap">
{%- else %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_body | url_encode }}&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_body | url_encode }}:wght@700&display=swap">
{%- endif %}
{%- endif %}
<style>
:root{--p:{{ accent }};--s:{{ accent2 }};--fh:'{{ font_head }}',ui-sans-serif,system-ui,sans-serif;--fb:'{{ font_body }}',ui-sans-serif,system-ui,sans-serif;--ink:color-mix(in srgb,var(--s) 70%,#1d1916)}
@supports (color:oklch(from red l c h)){:root{--ink:oklch(from color-mix(in srgb,var(--s) 70%,#1d1916) min(l,.3) c h)}}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:#ebe5e3;color:var(--ink);font:16px/1.6 var(--fb);-webkit-font-smoothing:antialiased;padding-bottom:4rem}
.doc{max-width:58rem;margin:0 auto;padding:0 1.25rem}
h1{font-family:var(--fh);font-weight:900;letter-spacing:-.01em;margin:0 0 1.25rem;font-size:clamp(2.4rem,8vw,3.8rem);line-height:1;max-width:14ch;text-wrap:balance}
p{margin:0 0 1rem}
.brandline{display:flex;align-items:center;gap:.6rem;padding:1rem 0 3rem;font-size:.9rem}
.logo{width:28px;height:28px;display:block;flex:none;border-radius:0;background:var(--p);color:#fff;color:color(from var(--p) xyz-d65 clamp(0,(.18 - y) * 1000000,.9505) clamp(0,(.18 - y) * 1000000,1) clamp(0,(.18 - y) * 1000000,1.089));font:700 15px/28px var(--fh);text-align:center}
.logo-img{height:28px;width:auto;max-width:9rem;display:block;flex:none}
.bname{font-weight:600}
.meta{margin-left:auto}
.cover{padding:1rem 0 1.5rem}
.stand{font-size:1.25rem;line-height:1.45;max-width:34rem}
.next{padding-top:2rem;max-width:34rem}
.ken-cta{min-height:48px;line-height:20px;border-radius:0!important;background:var(--p)!important;color:#fff!important;color:color(from var(--p) xyz-d65 clamp(0,(.18 - y) * 1000000,.9505) clamp(0,(.18 - y) * 1000000,1) clamp(0,(.18 - y) * 1000000,1.089))!important}
.sign{font-size:.95rem;margin:1.5rem 0 0}
.sign b{display:block;font-weight:600}
@media (min-width:760px){.doc{padding:0 2.5rem}.cover{padding:1rem 0 2.5rem}}
@media print{body{padding:0;-webkit-print-color-adjust:exact;print-color-adjust:exact}.cta-wrap{display:none}}
</style>
</head>
<body>
<main class="doc">
<section class="cover" data-section="cover">
<div class="brandline">
{%- if logo != '' %}<img class="logo-img" src="{{ brand.logo_url | escape }}" alt="{{ brand.name | default: 'Logo' | escape }}">{% elsif brand.name %}<span class="logo" aria-hidden="true">{{ brand.name | slice: 0, 1 | upcase | escape }}</span>{% endif -%}
{%- if brand.name and logo == '' %}<span class="bname">{{ brand.name | escape }}</span>{% endif %}
<span class="meta">Market report</span>
</div>
<h1>{{ acct | escape }} and its market</h1>
<p class="stand">Hi {{ person.first_name | default: 'there' | escape }}. I am putting together a short report on the companies and buyers in {{ account.industry | default: 'your market' | escape }}, with company counts and where {{ acct | escape }} sits among them.</p>
<p>The numbers are not on this page yet. Book a time and I will walk you through them.</p>
</section>
<section class="next" data-section="next">
<div class="cta-wrap">{% render 'ken/cta', label: 'Book 30 minutes', kind: 'booking' %}</div>
<p class="sign"><b>{{ sender.name | default: 'Our team' | escape }}</b>{% if sender.title or brand.name %}<span>{% if sender.title %}{{ sender.title | escape }}{% if brand.name %}, {% endif %}{% endif %}{% if brand.name %}{{ brand.name | escape }}{% endif %}</span>{% endif %}</p>
</section>
</main>
</body>
</html>
