{%- assign accent = brand.colors.primary | default: '#2a4bd7' | escape -%}
{%- assign accent2 = brand.colors.secondary | default: '#0e1530' | escape -%}
{%- assign font_head = brand.fonts.heading | default: 'Inter Tight' | escape -%}
{%- assign font_body = brand.fonts.body | default: 'Inter' | escape -%}
{%- assign head_q = font_head | replace: ' ', '+' -%}
{%- assign body_q = font_body | replace: ' ', '+' -%}
{%- assign acct = account.name | default: 'your company' -%}
{%- assign logo = brand.logo_url | default: '' -%}
{%- assign acct_s = acct | append: "'s" -%}
{%- assign acct_end = acct | slice: -1 -%}
{%- if acct_end == 's' %}{% assign acct_s = acct | append: "'" %}{% endif -%}
{%- assign market_label = data.scope.market | default: account.industry | default: 'your market' -%}
{%- assign total = data.total.first.value | default: 0 -%}
{%- assign segs = data.segments | sort: 'value' | reverse -%}
{%- assign regs = data.regions | sort: 'value' | reverse -%}
{%- assign segsum = 0 -%}
{%- for s in segs %}{% assign segsum = segsum | plus: s.value %}{% endfor -%}
{%- assign segsum = segsum | at_least: 1 -%}
{%- assign regsum = 0 -%}
{%- for r in regs %}{% assign regsum = regsum | plus: r.value %}{% endfor -%}
{%- assign regsum = regsum | at_least: 1 -%}
{%- assign people = 0 -%}
{%- assign has_roles = false -%}
{%- if data.roles_small.size > 0 and data.roles_large.size == data.roles_small.size -%}
{%- assign has_roles = true -%}
{%- for r in data.roles_small %}{% assign people = people | plus: r.value %}{% endfor -%}
{%- for r in data.roles_large %}{% assign people = people | plus: r.value %}{% endfor -%}
{%- endif -%}
{%- assign has_hiring = false -%}
{%- if data.hiring.size > 0 and data.signals.size > 0 and total > 0 -%}{%- assign has_hiring = true -%}{%- endif -%}
{%- assign has_peers = false -%}
{%- if data.bands.size > 0 and data.band_hiring.size == data.bands.size and data.scope.account_band -%}
{%- for b in data.bands %}{% if b.label == data.scope.account_band %}{% assign has_peers = true %}{% endif %}{% endfor -%}
{%- endif -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex">
<title>{{ data.headline | default: market_label | escape }}</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ head_q }}:wght@500;600;700&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ body_q }}:wght@400;500;600&display=swap">
<style>
:root{
  --p:{{ accent }};
  --s:{{ accent2 }};
  --fh:'{{ font_head }}',ui-sans-serif,system-ui,sans-serif;
  --fb:'{{ font_body }}',ui-sans-serif,system-ui,sans-serif;
  --ink:var(--s);
  --mute:color-mix(in srgb,var(--s) 62%,#fff);
  --rule:color-mix(in srgb,var(--s) 14%,#fff);
  --hair:color-mix(in srgb,var(--s) 9%,#fff);
  --c1:var(--p);
  --c2:color-mix(in srgb,var(--p) 78%,#fff);
  --c3:color-mix(in srgb,var(--p) 60%,#fff);
  --c4:color-mix(in srgb,var(--p) 44%,#fff);
  --c5:color-mix(in srgb,var(--p) 30%,#fff);
  --c6:color-mix(in srgb,var(--p) 18%,#fff);
}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:#fff;color:var(--ink);font:16px/1.6 var(--fb);-webkit-font-smoothing:antialiased;padding-bottom:5.5rem;-webkit-print-color-adjust:exact;print-color-adjust:exact}
.doc{max-width:58rem;margin:0 auto;padding:0 1.25rem}
h1,h2,h3{font-family:var(--fh);font-weight:600;line-height:1.1;letter-spacing:-.015em;margin:0}
p{margin:0 0 1rem}
a{color:var(--p)}
a:focus-visible{outline:2px solid var(--p);outline-offset:3px}
.tn{font-variant-numeric:tabular-nums}

.brandline{display:flex;align-items:center;gap:.6rem;padding:1rem 0;border-bottom:1px solid var(--rule);font-size:.9rem}
.logo{width:28px;height:28px;display:block;flex:none;border-radius:8px;background:var(--p);color:#fff;font:700 15px/28px var(--fh);text-align:center}
.logo-img{height:28px;width:auto;max-width:9rem;display:block;flex:none}
.bname{font-weight:600}
.meta{margin-left:auto;color:var(--mute);text-align:right;line-height:1.45}

.cover{padding-bottom:2.5rem}
.cover-grid{display:grid;gap:2rem;margin-top:2.5rem}
.cover h1{font-size:clamp(2.7rem,9vw,4.4rem);line-height:.98;letter-spacing:-.03em;max-width:13ch;margin:0 0 1.25rem;text-wrap:balance;overflow-wrap:break-word}
.stand{font-size:1.15rem;line-height:1.5;color:var(--mute);max-width:32rem}
.waffle{max-width:230px}
.waffle svg{width:100%;height:auto;display:block}
.waffle p{font-size:.78rem;color:var(--mute);margin:.6rem 0 0;line-height:1.45}
.plate{display:grid;gap:1rem;border-top:3px solid var(--p);padding-top:1.25rem;margin-top:2.5rem;font-size:.92rem;line-height:1.45}
.plate small{display:block;color:var(--mute);font-size:.78rem;margin-bottom:.2rem}
.plate b{font-weight:600}
.toc{list-style:none;margin:2.5rem 0 0;padding:0;max-width:30rem;counter-reset:t}
.toc li{counter-increment:t;display:flex;gap:.9rem;align-items:baseline;padding:.45rem 0;border-top:1px solid var(--hair);font-size:.95rem}
.toc li::before{content:counter(t);font:600 .9rem/1 var(--fh);color:var(--p);min-width:1.1rem}

.sec{padding:2.5rem 0 .5rem;border-top:1px solid var(--rule);display:grid;gap:.2rem 3rem}
.sec .n{font:700 1.6rem/1 var(--fh);letter-spacing:-.03em;color:var(--p)}
.sec h2{font-size:1.9rem;margin:.1rem 0 1rem;text-wrap:balance}
.body{max-width:44rem}
.body p{font-size:1.02rem}
.brief{list-style:none;margin:0;padding:0}
.brief li{padding:.9rem 0;border-top:1px solid var(--hair);font-size:1.02rem}
.brief li:first-child{border-top:0;padding-top:0}
.brief b{font-family:var(--fh);font-weight:600;font-size:1.35rem;letter-spacing:-.01em;margin-right:.4rem;white-space:nowrap}

figure{margin:1.75rem 0 2rem;display:grid;gap:.8rem}
figure svg{width:100%;height:auto;display:block;overflow:visible}
figure .fig{max-width:30rem}
figcaption{font-size:.82rem;line-height:1.5;color:var(--mute)}
figcaption b{color:var(--ink);font-weight:600}
.lab{font:500 12px var(--fb);fill:var(--ink)}
.val{font:600 12px var(--fb);fill:var(--ink);font-variant-numeric:tabular-nums;paint-order:stroke;stroke:#fff;stroke-width:4px;stroke-linejoin:round}
.mut{font:500 10px var(--fb);fill:var(--mute)}
.bar{fill:var(--p)}
.bar2{fill:var(--c4)}
.bar3{fill:var(--c5)}
.ref{stroke:var(--mute);stroke-width:1;stroke-dasharray:3 3}
.c1{fill:var(--c1)}.c2{fill:var(--c2)}.c3{fill:var(--c3)}.c4{fill:var(--c4)}.c5{fill:var(--c5)}.c6{fill:var(--c6)}
.legend{list-style:none;margin:.6rem 0 0;padding:0;display:flex;flex-wrap:wrap;gap:.35rem 1.1rem;font-size:.82rem}
.legend li{display:flex;align-items:center;gap:.4rem}
.legend i{width:11px;height:11px;border-radius:2px;display:inline-block;flex:none}
.legend i.c1{background:var(--c1)}.legend i.c2{background:var(--c2)}.legend i.c3{background:var(--c3)}.legend i.c4{background:var(--c4)}.legend i.c5{background:var(--c5)}.legend i.c6{background:var(--c6)}
.legend b{font-weight:600}
.legend .tn{color:var(--mute)}
.legend.top{margin:0 0 .7rem}
.region .legend li{flex-basis:calc(50% - .55rem)}

.tiles{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.25rem;margin:1.5rem 0 1rem}
.tile{border-top:2px solid var(--ink);padding-top:.7rem}
.tile b{display:block;font:600 1.8rem/1 var(--fh);letter-spacing:-.03em;margin-bottom:.35rem}
.tile span{display:block;font-size:.85rem;line-height:1.35;color:var(--mute)}

.plays{list-style:none;margin:0;padding:0;counter-reset:pl;display:grid;gap:1.5rem}
.plays li{counter-increment:pl;padding-top:1rem;border-top:2px solid var(--ink)}
.plays li::before{content:"Play " counter(pl);display:block;font:600 .85rem/1 var(--fb);color:var(--p);margin-bottom:.6rem}
.plays h3{font-size:1.3rem;margin-bottom:.5rem}
.plays p{margin:0;font-size:.98rem}

.next{display:grid;gap:1rem;max-width:none}
.cta-wrap{justify-self:start}
.ken-cta{min-height:44px;line-height:20px;border-radius:3px!important;background:var(--p)!important}
.sign{margin:0;font-size:.95rem}
.sign b{display:block;font-weight:600}
.sign span{color:var(--mute)}
.method{margin-top:2rem;padding-top:1rem;border-top:1px solid var(--rule);font-size:.8rem;line-height:1.55;color:var(--mute);max-width:46rem}
.method b{color:var(--ink);font-weight:600}

@media (min-width:760px){
  .doc{padding:0 2.5rem}
  .cover{padding-bottom:3.5rem}
  .cover-grid{grid-template-columns:minmax(0,1fr) 15rem;gap:3rem;align-items:end;margin-top:4rem}
  .waffle{max-width:15rem;justify-self:end}
  .plate{grid-template-columns:repeat(3,minmax(0,1fr));gap:2rem;margin-top:3.5rem}
  .sec{grid-template-columns:5.5rem minmax(0,1fr);padding:3.5rem 0 1rem}
  .sec .n{font-size:2.6rem;padding-top:.35rem}
  .sec h2{font-size:2.2rem;margin-bottom:1.25rem}
  .tile b{font-size:2.1rem}
  figure{grid-template-columns:minmax(0,1fr) 11rem;gap:1.5rem;align-items:end}
  figure .fig{max-width:32rem}
  .region .legend li{flex-basis:auto}
  .plays{grid-template-columns:repeat(3,minmax(0,1fr));gap:2.5rem}
  .next{grid-template-columns:minmax(0,1fr) auto;align-items:center;gap:1rem 3rem}
  .next p{max-width:34rem}
  .next .sign{grid-column:1}
  .next .cta-wrap{grid-column:2;grid-row:1/3;align-self:center}
}
@media print{
  @page{margin:16mm}
  body{padding:0}
  .doc{max-width:none;padding:0}
  .sec{break-before:page;border-top:0;padding-top:.5rem}
  .method{break-inside:avoid;margin-top:1rem}
  .cover{break-before:auto;padding-bottom:0}
  .cover-grid{margin-top:1.5rem}
  .cover h1{font-size:3.4rem}
  .plate{margin-top:1.75rem}
  .toc{margin-top:1.25rem}
  .toc li{padding:.3rem 0}
  .sec.last{break-before:auto;border-top:1px solid var(--rule);margin-top:.75rem;padding-top:1.5rem}
  figure,.tile,.plays li{break-inside:avoid}
  .cta-wrap{display:none}
}
</style>
</head>
<body>
<main class="doc">
<section class="cover" data-section="cover">
<div class="brandline">
{%- if logo != '' %}<img class="logo-img" src="{{ brand.logo_url | escape }}" alt="{{ brand.name | default: 'Logo' | escape }}">{% elsif brand.name %}<span class="logo" aria-hidden="true">{{ brand.name | slice: 0, 1 | upcase | escape }}</span>{% endif -%}
{%- if brand.name and logo == '' %}<span class="bname">{{ brand.name | escape }}</span>{% endif %}
<span class="meta">Market report<br>{{ market_label | escape }}</span>
</div>
<div class="cover-grid">
<div>
<h1>{{ data.headline | default: market_label | escape }}</h1>
{%- if data.stand and data.stand != '' %}
<p class="stand">{{ data.stand | escape }}</p>
{%- endif %}
</div>
{%- if segs.size > 0 %}
{%- assign ends = '' -%}
{%- assign cum = 0 -%}
{%- for s in segs %}{% assign cum = cum | plus: s.value %}{% assign e = cum | times: 100.0 | divided_by: segsum | round %}{% assign ends = ends | append: e | append: ';' %}{% endfor -%}
{%- assign end_list = ends | split: ';' -%}
<div class="waffle">
<svg viewBox="0 0 198 198" role="img" aria-label="{{ market_label | escape }}: companies as 100 squares, shaded by segment">
{%- for i in (0..99) %}
{%- assign k = 0 %}
{%- for e in end_list %}{% assign en = e | plus: 0 %}{% if i < en %}{% assign k = forloop.index %}{% break %}{% endif %}{% endfor %}
{%- if k == 0 %}{% assign k = segs.size %}{% endif %}
<rect x="{{ i | modulo: 10 | times: 20 }}" y="{{ i | divided_by: 10.0 | floor | times: 20 }}" width="18" height="18" rx="2" class="c{{ k | at_most: 6 }}"/>
{%- endfor %}
</svg>
<p>{% if total > 0 %}{% assign nv = total %}{% if nv >= 1000000 %}{{ nv | divided_by: 1000000.0 | floor }},{{ nv | divided_by: 1000.0 | floor | modulo: 1000 | prepend: '000' | slice: -3, 3 }},{{ nv | modulo: 1000 | prepend: '000' | slice: -3, 3 }}{% elsif nv >= 1000 %}{{ nv | divided_by: 1000.0 | floor }},{{ nv | modulo: 1000 | prepend: '000' | slice: -3, 3 }}{% else %}{{ nv }}{% endif %} companies. {% endif %}Each square is one percent of the segments in figure 1, shaded by segment: darkest for {{ segs.first.label | escape }}, lightest for {{ segs.last.label | escape }}.</p>
</div>
{%- endif %}
</div>
<div class="plate">
<div><small>Prepared for</small>{% if person.first_name %}<b>{{ person.first_name | escape }}{% if person.last_name %} {{ person.last_name | escape }}{% endif %}</b><br>{% if person.title %}{{ person.title | escape }}, {% endif %}{{ acct | escape }}{% else %}<b>{{ acct | escape }}</b>{% endif %}</div>
<div><small>Written by</small><b>{{ sender.name | default: 'Our team' | escape }}</b>{% if sender.title or brand.name %}<br>{% if sender.title %}{{ sender.title | escape }}{% if brand.name %}, {% endif %}{% endif %}{% if brand.name %}{{ brand.name | escape }}{% endif %}{% endif %}</div>
<div><small>Data</small><b>Ken Search</b>{% if total > 0 %}<br>{% assign nv = total %}{% if nv >= 1000000 %}{{ nv | divided_by: 1000000.0 | floor }},{{ nv | divided_by: 1000.0 | floor | modulo: 1000 | prepend: '000' | slice: -3, 3 }},{{ nv | modulo: 1000 | prepend: '000' | slice: -3, 3 }}{% elsif nv >= 1000 %}{{ nv | divided_by: 1000.0 | floor }},{{ nv | modulo: 1000 | prepend: '000' | slice: -3, 3 }}{% else %}{{ nv }}{% endif %} companies{% if has_roles %}, {% assign nv = people %}{% if nv >= 1000000 %}{{ nv | divided_by: 1000000.0 | floor }},{{ nv | divided_by: 1000.0 | floor | modulo: 1000 | prepend: '000' | slice: -3, 3 }},{{ nv | modulo: 1000 | prepend: '000' | slice: -3, 3 }}{% elsif nv >= 1000 %}{{ nv | divided_by: 1000.0 | floor }},{{ nv | modulo: 1000 | prepend: '000' | slice: -3, 3 }}{% else %}{{ nv }}{% endif %} people{% endif %}{% endif %}</div>
</div>
<ol class="toc" aria-label="Contents">
<li>In brief</li>
<li>Who is in the market</li>
<li>Where they are</li>
{%- if has_roles %}
<li>Who buys</li>
{%- endif %}
<li>Who is growing</li>
{%- if has_peers %}
<li>Where {{ acct | escape }} sits</li>
{%- endif %}
<li>Three plays for {{ acct | escape }}</li>
</ol>
</section>
{%- assign sn = 1 %}

{%- if data.brief.size > 0 %}
<section class="sec" data-section="brief">
<span class="n">{{ sn }}</span>
{%- assign sn = sn | plus: 1 %}
<div class="body">
<h2>In brief</h2>
<ul class="brief">
{%- for b in data.brief %}
<li><b class="tn">{{ b.figure | escape }}</b>{{ b.text | escape }}</li>
{%- endfor %}
</ul>
</div>
</section>
{%- endif %}

<section class="sec" data-section="segments">
<span class="n">{{ sn }}</span>
{%- assign sn = sn | plus: 1 %}
<div class="body">
<h2>Who is in the market</h2>
{%- if data.narrative.segments and data.narrative.segments != '' %}
<p>{{ data.narrative.segments | escape }}</p>
{%- endif %}
{%- assign segmax = segs | map: 'value' | sort | last | at_least: 1 %}
<figure>
<div class="fig"><svg viewBox="0 0 360 {{ segs.size | times: 30 }}" role="img" aria-label="Companies by segment, horizontal bars">
{%- for s in segs %}
{%- assign y = forloop.index0 | times: 30 | plus: 4 %}
<text x="0" y="{{ y | plus: 12.5 }}" class="lab">{{ s.label | escape }}</text>
<rect x="164" y="{{ y }}" width="{{ s.value | times: 136.0 | divided_by: segmax | round: 1 }}" height="16" rx="2" class="bar"/>
<text x="{{ s.value | times: 136.0 | divided_by: segmax | plus: 170 | round: 1 }}" y="{{ y | plus: 12.5 }}" class="val">{% assign nv = s.value %}{% if nv >= 1000000 %}{{ nv | divided_by: 1000000.0 | floor }},{{ nv | divided_by: 1000.0 | floor | modulo: 1000 | prepend: '000' | slice: -3, 3 }},{{ nv | modulo: 1000 | prepend: '000' | slice: -3, 3 }}{% elsif nv >= 1000 %}{{ nv | divided_by: 1000.0 | floor }},{{ nv | modulo: 1000 | prepend: '000' | slice: -3, 3 }}{% else %}{{ nv }}{% endif %}</text>
{%- endfor %}
</svg></div>
<figcaption><b>Figure 1.</b> Companies by segment, {{ data.scope.size | default: 'all sizes' | escape }}. Segments follow the company's primary industry in Ken Search.{% if total > 0 %} Total {% assign nv = total %}{% if nv >= 1000000 %}{{ nv | divided_by: 1000000.0 | floor }},{{ nv | divided_by: 1000.0 | floor | modulo: 1000 | prepend: '000' | slice: -3, 3 }},{{ nv | modulo: 1000 | prepend: '000' | slice: -3, 3 }}{% elsif nv >= 1000 %}{{ nv | divided_by: 1000.0 | floor }},{{ nv | modulo: 1000 | prepend: '000' | slice: -3, 3 }}{% else %}{{ nv }}{% endif %}.{% endif %}</figcaption>
</figure>
{%- if data.narrative.segments_after and data.narrative.segments_after != '' %}
<p>{{ data.narrative.segments_after | escape }}</p>
{%- endif %}
</div>
</section>

<section class="sec region" data-section="regions">
<span class="n">{{ sn }}</span>
{%- assign sn = sn | plus: 1 %}
<div class="body">
<h2>Where they are</h2>
{%- if data.narrative.regions and data.narrative.regions != '' %}
<p>{{ data.narrative.regions | escape }}</p>
{%- endif %}
{%- assign avail = regs.size | minus: 1 | times: 2 | times: -1 | plus: 360 %}
{%- assign rx = 0.0 %}
<figure>
<div class="fig">
<svg viewBox="0 0 360 28" role="img" aria-label="Share of companies by region, one stacked bar">
{%- for r in regs %}
{%- assign w = r.value | times: 1.0 | times: avail | divided_by: regsum %}
<rect x="{{ rx | round: 1 }}" y="0" width="{{ w | round: 1 }}" height="28" rx="2" class="c{{ forloop.index | at_most: 6 }}"/>
{%- assign rx = rx | plus: w | plus: 2 %}
{%- endfor %}
</svg>
<ul class="legend">
{%- for r in regs %}
<li><i class="c{{ forloop.index | at_most: 6 }}"></i><b>{{ r.label | escape }}</b><span class="tn">{{ r.value | times: 100.0 | divided_by: regsum | round }}%, {% assign nv = r.value %}{% if nv >= 1000000 %}{{ nv | divided_by: 1000000.0 | floor }},{{ nv | divided_by: 1000.0 | floor | modulo: 1000 | prepend: '000' | slice: -3, 3 }},{{ nv | modulo: 1000 | prepend: '000' | slice: -3, 3 }}{% elsif nv >= 1000 %}{{ nv | divided_by: 1000.0 | floor }},{{ nv | modulo: 1000 | prepend: '000' | slice: -3, 3 }}{% else %}{{ nv }}{% endif %}</span></li>
{%- endfor %}
</ul>
</div>
<figcaption><b>Figure 2.</b> Share of companies by headquarters region, from Ken Search company records.</figcaption>
</figure>
{%- if data.narrative.regions_after and data.narrative.regions_after != '' %}
<p>{{ data.narrative.regions_after | escape }}</p>
{%- endif %}
</div>
</section>

{%- if has_roles %}
{%- assign rmax = 1 %}
{%- for r in data.roles_small %}{% assign rt = r.value | plus: data.roles_large[forloop.index0].value %}{% if rt > rmax %}{% assign rmax = rt %}{% endif %}{% endfor %}
<section class="sec" data-section="buyers">
<span class="n">{{ sn }}</span>
{%- assign sn = sn | plus: 1 %}
<div class="body">
<h2>Who buys</h2>
{%- if data.narrative.buyers and data.narrative.buyers != '' %}
<p>{{ data.narrative.buyers | escape }}</p>
{%- endif %}
<figure>
<div class="fig">
<ul class="legend top">
<li><i class="c1"></i><b>{{ data.scope.small_band | default: 'Smaller companies' | escape }}</b></li>
<li><i class="c4"></i><b>{{ data.scope.large_band | default: 'Larger companies' | escape }}</b></li>
</ul>
<svg viewBox="0 0 360 {{ data.roles_small.size | times: 30 }}" role="img" aria-label="People in each buying role by company size, stacked bars">
{%- for r in data.roles_small %}
{%- assign y = forloop.index0 | times: 30 | plus: 4 %}
{%- assign lg = data.roles_large[forloop.index0].value %}
{%- assign ws = r.value | times: 136.0 | divided_by: rmax %}
{%- assign wl = lg | times: 136.0 | divided_by: rmax %}
<text x="0" y="{{ y | plus: 12.5 }}" class="lab">{{ r.label | escape }}</text>
<rect x="164" y="{{ y }}" width="{{ ws | round: 1 }}" height="16" rx="2" class="bar"/>
<rect x="{{ ws | plus: 166 | round: 1 }}" y="{{ y }}" width="{{ wl | round: 1 }}" height="16" rx="2" class="bar2"/>
<text x="{{ ws | plus: wl | plus: 172 | round: 1 }}" y="{{ y | plus: 12.5 }}" class="val">{% assign nv = r.value | plus: lg %}{% if nv >= 1000000 %}{{ nv | divided_by: 1000000.0 | floor }},{{ nv | divided_by: 1000.0 | floor | modulo: 1000 | prepend: '000' | slice: -3, 3 }},{{ nv | modulo: 1000 | prepend: '000' | slice: -3, 3 }}{% elsif nv >= 1000 %}{{ nv | divided_by: 1000.0 | floor }},{{ nv | modulo: 1000 | prepend: '000' | slice: -3, 3 }}{% else %}{{ nv }}{% endif %}</text>
{%- endfor %}
</svg>
</div>
<figcaption><b>Figure 3.</b> People in each buying role, by the size of their company. Ken Search, current titles only. Total {% assign nv = people %}{% if nv >= 1000000 %}{{ nv | divided_by: 1000000.0 | floor }},{{ nv | divided_by: 1000.0 | floor | modulo: 1000 | prepend: '000' | slice: -3, 3 }},{{ nv | modulo: 1000 | prepend: '000' | slice: -3, 3 }}{% elsif nv >= 1000 %}{{ nv | divided_by: 1000.0 | floor }},{{ nv | modulo: 1000 | prepend: '000' | slice: -3, 3 }}{% else %}{{ nv }}{% endif %}.</figcaption>
</figure>
{%- if data.narrative.buyers_after and data.narrative.buyers_after != '' %}
<p>{{ data.narrative.buyers_after | escape }}</p>
{%- endif %}
</div>
</section>
{%- endif %}

<section class="sec" data-section="signals">
<span class="n">{{ sn }}</span>
{%- assign sn = sn | plus: 1 %}
<div class="body">
<h2>Who is growing</h2>
{%- if data.narrative.signals and data.narrative.signals != '' %}
<p>{{ data.narrative.signals | escape }}</p>
{%- endif %}
<div class="tiles">
{%- for s in data.signals %}
<div class="tile"><b class="tn">{% assign nv = s.value %}{% if nv >= 1000000 %}{{ nv | divided_by: 1000000.0 | floor }},{{ nv | divided_by: 1000.0 | floor | modulo: 1000 | prepend: '000' | slice: -3, 3 }},{{ nv | modulo: 1000 | prepend: '000' | slice: -3, 3 }}{% elsif nv >= 1000 %}{{ nv | divided_by: 1000.0 | floor }},{{ nv | modulo: 1000 | prepend: '000' | slice: -3, 3 }}{% else %}{{ nv }}{% endif %}</b><span>{{ s.label | escape }}.{% if total > 0 %} {{ s.value | times: 100.0 | divided_by: total | round }}% of the market.{% endif %}</span></div>
{%- endfor %}
</div>
{%- if has_hiring %}
{%- assign keys = '' %}
{%- assign topshare = 1 %}
{%- for h in data.hiring %}
{%- assign base = 0 %}
{%- for s in segs %}{% if s.label == h.label %}{% assign base = s.value %}{% endif %}{% endfor %}
{%- if base > 0 %}
{%- assign sh = h.value | times: 1000.0 | divided_by: base | round | plus: 10000 %}
{%- assign keys = keys | append: sh | append: '|' | append: forloop.index0 | append: ';' %}
{%- endif %}
{%- endfor %}
{%- assign key_list = keys | split: ';' | sort | reverse | compact %}
{%- assign topkey = key_list.first | split: '|' %}
{%- assign topshare = topkey.first | minus: 10000 | divided_by: 10.0 | at_least: 1 %}
{%- assign mkt = data.signals.first.value | times: 100.0 | divided_by: total %}
{%- if key_list.size > 0 %}
<figure>
<div class="fig"><svg viewBox="0 0 360 {{ key_list.size | times: 30 | plus: 16 }}" role="img" aria-label="Share of companies hiring, by segment">
<line x1="{{ mkt | times: 136.0 | divided_by: topshare | at_most: 170 | plus: 164 | round: 1 }}" y1="14" x2="{{ mkt | times: 136.0 | divided_by: topshare | at_most: 170 | plus: 164 | round: 1 }}" y2="{{ key_list.size | times: 30 | plus: 16 }}" class="ref"/>
<text x="{{ mkt | times: 136.0 | divided_by: topshare | at_most: 170 | plus: 167 | round: 1 }}" y="9" class="mut" text-anchor="end">All segments, {{ mkt | round }}%</text>
{%- for key in key_list %}
{%- assign parts = key | split: '|' %}
{%- assign hi = parts.last | plus: 0 %}
{%- assign h = data.hiring[hi] %}
{%- assign y = forloop.index0 | times: 30 | plus: 20 %}
<text x="0" y="{{ y | plus: 12.5 }}" class="lab">{{ h.label | escape }}</text>
<rect x="164" y="{{ y }}" width="{{ parts.first | minus: 10000 | divided_by: 10.0 | times: 136.0 | divided_by: topshare | round: 1 }}" height="16" rx="2" class="bar"/>
<text x="{{ parts.first | minus: 10000 | divided_by: 10.0 | times: 136.0 | divided_by: topshare | plus: 170 | round: 1 }}" y="{{ y | plus: 12.5 }}" class="val">{{ parts.first | minus: 10000 | divided_by: 10.0 | round }}%</text>
{%- endfor %}
</svg></div>
<figcaption><b>Figure 4.</b> Share of companies in each segment that are hiring. The dashed line is the whole market, {{ mkt | round }} percent.</figcaption>
</figure>
{%- endif %}
{%- endif %}
{%- if data.narrative.signals_after and data.narrative.signals_after != '' %}
<p>{{ data.narrative.signals_after | escape }}</p>
{%- endif %}
</div>
</section>

{%- if has_peers %}
{%- assign bmax = data.bands | map: 'value' | sort | last | at_least: 1 %}
{%- assign bsum = 0 %}
{%- for b in data.bands %}{% assign bsum = bsum | plus: b.value %}{% endfor %}
<section class="sec" data-section="peers">
<span class="n">{{ sn }}</span>
{%- assign sn = sn | plus: 1 %}
<div class="body">
<h2>Where {{ acct | escape }} sits</h2>
{%- if data.narrative.peers and data.narrative.peers != '' %}
<p>{{ data.narrative.peers | escape }}</p>
{%- endif %}
<figure>
<div class="fig">
<ul class="legend top"><li><i class="c1"></i>{{ acct_s | escape }} size band</li><li><i class="c5"></i>other size bands</li></ul>
<svg viewBox="0 0 360 {{ data.bands.size | times: 30 | plus: 16 }}" role="img" aria-label="Companies in each size band and how many of them are hiring">
<text x="360" y="9" class="mut" text-anchor="end">Hiring now</text>
{%- for b in data.bands %}
{%- assign y = forloop.index0 | times: 30 | plus: 20 %}
{%- assign hb = data.band_hiring[forloop.index0].value | default: 0 %}
{%- assign mine = false %}
{%- if b.label == data.scope.account_band %}{% assign mine = true %}{% endif %}
<text x="0" y="{{ y | plus: 12.5 }}" class="lab"{% if mine %} style="font-weight:700"{% endif %}>{{ b.label | escape }}</text>
<rect x="124" y="{{ y }}" width="{{ b.value | times: 110.0 | divided_by: bmax | round: 1 }}" height="16" rx="2" class="{% if mine %}bar{% else %}bar3{% endif %}"/>
<text x="{{ b.value | times: 110.0 | divided_by: bmax | plus: 130 | round: 1 }}" y="{{ y | plus: 12.5 }}" class="val">{% assign nv = b.value %}{% if nv >= 1000000 %}{{ nv | divided_by: 1000000.0 | floor }},{{ nv | divided_by: 1000.0 | floor | modulo: 1000 | prepend: '000' | slice: -3, 3 }},{{ nv | modulo: 1000 | prepend: '000' | slice: -3, 3 }}{% elsif nv >= 1000 %}{{ nv | divided_by: 1000.0 | floor }},{{ nv | modulo: 1000 | prepend: '000' | slice: -3, 3 }}{% else %}{{ nv }}{% endif %}</text>
<text x="360" y="{{ y | plus: 12.5 }}" class="val" text-anchor="end">{% if b.value > 0 %}{{ hb | times: 100.0 | divided_by: b.value | round }}%{% else %}0%{% endif %}</text>
{%- endfor %}
</svg>
</div>
<figcaption><b>Figure 5.</b> Companies in {{ acct_s | escape }} industry and region, by headcount, and the share of each band that is hiring. {{ acct | escape }} is in the {{ data.scope.account_band | escape }} band. Total {% assign nv = bsum %}{% if nv >= 1000000 %}{{ nv | divided_by: 1000000.0 | floor }},{{ nv | divided_by: 1000.0 | floor | modulo: 1000 | prepend: '000' | slice: -3, 3 }},{{ nv | modulo: 1000 | prepend: '000' | slice: -3, 3 }}{% elsif nv >= 1000 %}{{ nv | divided_by: 1000.0 | floor }},{{ nv | modulo: 1000 | prepend: '000' | slice: -3, 3 }}{% else %}{{ nv }}{% endif %}.</figcaption>
</figure>
{%- if data.narrative.peers_after and data.narrative.peers_after != '' %}
<p>{{ data.narrative.peers_after | escape }}</p>
{%- endif %}
</div>
</section>
{%- endif %}

<section class="sec" data-section="plays">
<span class="n">{{ sn }}</span>
{%- assign sn = sn | plus: 1 %}
<div class="body" style="max-width:none">
<h2>Three plays for {{ acct | escape }}</h2>
<ol class="plays">
{%- for p in data.plays %}
<li><h3>{{ p.title | escape }}</h3><p>{{ p.body | escape }}</p></li>
{%- endfor %}
</ol>
</div>
</section>

<section class="sec last" data-section="next">
<span class="n" aria-hidden="true"></span>
<div class="body next">
<p>The companies and people behind this report are in Ken Search, filtered to {{ acct_s | escape }} market. Book 30 minutes and I will go through the list with you.</p>
<p class="sign"><b>{{ sender.name | default: 'Our team' | escape }}</b>{% if sender.title or brand.name %}<span>{% if sender.title %}{{ sender.title | escape }}{% if brand.name %}, {% endif %}{% endif %}{% if brand.name %}{{ brand.name | escape }}{% endif %}</span>{% endif %}</p>
<div class="cta-wrap">{% render 'ken/cta', label: 'Book 30 minutes', kind: 'booking' %}</div>
{%- if data.method and data.method != '' %}
<p class="method" style="grid-column:1/-1"><b>How this was built.</b> {{ data.method | escape }}</p>
{%- endif %}
</div>
</section>
</main>
</body>
</html>
