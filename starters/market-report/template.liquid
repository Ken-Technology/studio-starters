{%- comment -%}Brand: the two colours and faces take over when a workspace sets them. Read how light each colour is so text on it stays readable.{%- endcomment -%}
{%- assign accent = brand.colors.primary | default: '#0f7d45' | strip | downcase | escape -%}
{%- assign accent2 = brand.colors.secondary | default: '#2b2622' | strip | downcase | escape -%}
{%- assign font_head = brand.fonts.heading | default: 'Red Hat Display' | escape -%}
{%- assign font_body = brand.fonts.body | default: 'Red Hat Text' | escape -%}
{%- assign head_q = font_head | replace: ' ', '+' -%}
{%- assign body_q = font_body | replace: ' ', '+' -%}
{%- assign head_w = '700' -%}
{%- assign head_wq = '400;700' -%}
{%- if font_head == 'Red Hat Display' -%}{%- assign head_w = '900' -%}{%- assign head_wq = '900' -%}{%- endif -%}
{%- assign body_wq = '400;700' -%}
{%- if font_body == 'Red Hat Text' -%}{%- assign body_wq = '400;500' -%}{%- endif -%}
{%- assign hexd = '0123456789abcdef' | split: '' -%}
{%- assign cols = accent | append: '|' | append: accent2 | split: '|' -%}
{%- assign lumc = '' -%}
{%- for c in cols -%}
{%- assign n = c | size -%}
{%- assign chars = c | split: '' -%}
{%- assign digits = '' -%}
{%- assign bad = false -%}
{%- if n != 7 and n != 4 -%}{%- assign bad = true -%}{%- endif -%}
{%- for ch in chars offset: 1 -%}
{%- assign found = -1 -%}
{%- for hd in hexd -%}{%- if hd == ch -%}{%- assign found = forloop.index0 -%}{%- endif -%}{%- endfor -%}
{%- if found < 0 -%}{%- assign bad = true -%}{%- endif -%}
{%- assign digits = digits | append: found | append: ',' -%}
{%- endfor -%}
{%- if bad -%}
{%- assign lumc = lumc | append: 'x|' -%}
{%- else -%}
{%- assign dg = digits | split: ',' -%}
{%- if n == 7 -%}
{%- assign cr = dg[0] | times: 16 | plus: dg[1] -%}
{%- assign cg = dg[2] | times: 16 | plus: dg[3] -%}
{%- assign cb = dg[4] | times: 16 | plus: dg[5] -%}
{%- else -%}
{%- assign cr = dg[0] | times: 17 -%}
{%- assign cg = dg[1] | times: 17 -%}
{%- assign cb = dg[2] | times: 17 -%}
{%- endif -%}
{%- assign lum = cr | times: 299 -%}
{%- assign lum_g = cg | times: 587 -%}
{%- assign lum_b = cb | times: 114 -%}
{%- assign lum = lum | plus: lum_g | plus: lum_b -%}
{%- assign lumc = lumc | append: lum | append: '|' -%}
{%- endif -%}
{%- endfor -%}
{%- assign lums = lumc | split: '|' -%}
{%- if lums[0] == 'x' -%}{%- assign accent = '#0f7d45' -%}{%- assign p_lum = 85726 -%}{%- else -%}{%- assign p_lum = lums[0] | plus: 0 -%}{%- endif -%}
{%- if lums[1] == 'x' -%}{%- assign accent2 = '#2b2622' -%}{%- assign s_lum = 40000 -%}{%- else -%}{%- assign s_lum = lums[1] | plus: 0 -%}{%- endif -%}
{%- comment -%}Text on the accent: white on a dark accent, the ink on a light one. Accent marks on the ground darken when the accent is pale.{%- endcomment -%}
{%- if p_lum < 110000 -%}
{%- assign on_accent = '#ffffff' -%}
{%- assign accent_mark = 'var(--p)' -%}
{%- else -%}
{%- assign on_accent = '#1d1916' -%}
{%- assign accent_mark = 'color-mix(in srgb,var(--p) 40%,#1d1916)' -%}
{%- endif -%}
{%- if s_lum < 110000 -%}
{%- assign ink_css = 'var(--s)' -%}
{%- else -%}
{%- assign ink_css = 'color-mix(in srgb,var(--s) 30%,#1d1916)' -%}
{%- endif -%}
{%- comment -%}Account and counts.{%- endcomment -%}
{%- assign acct = account.name | default: 'your company' -%}
{%- assign logo = brand.logo_url | default: '' -%}
{%- assign acct_s = acct | append: "'s" -%}
{%- assign acct_end = acct | slice: -1 -%}
{%- if acct_end == 's' %}{% assign acct_s = acct | append: "'" %}{% endif -%}
{%- assign market_label = data.scope.market | default: account.industry | default: 'your market' -%}
{%- assign total = data.total.first.value | default: 0 -%}
{%- assign segs = data.segments | sort: 'value' | reverse -%}
{%- assign regs = data.regions | sort: 'value' | reverse -%}
{%- assign segsum = 0 -%}
{%- for s in segs %}{% assign segsum = segsum | plus: s.value %}{% endfor -%}
{%- assign segsum = segsum | at_least: 1 -%}
{%- assign regsum = 0 -%}
{%- for r in regs %}{% assign regsum = regsum | plus: r.value %}{% endfor -%}
{%- assign regsum = regsum | at_least: 1 -%}
{%- assign people = 0 -%}
{%- assign p_small = 0 -%}
{%- assign p_large = 0 -%}
{%- assign has_roles = false -%}
{%- if data.roles_small.size > 0 and data.roles_large.size == data.roles_small.size -%}
{%- assign has_roles = true -%}
{%- for r in data.roles_small %}{% assign p_small = p_small | plus: r.value %}{% endfor -%}
{%- for r in data.roles_large %}{% assign p_large = p_large | plus: r.value %}{% endfor -%}
{%- assign people = p_small | plus: p_large -%}
{%- endif -%}
{%- assign has_hiring = false -%}
{%- if data.hiring.size > 0 and data.signals.size > 0 and total > 0 -%}{%- assign has_hiring = true -%}{%- endif -%}
{%- assign has_peers = false -%}
{%- if data.bands.size > 0 and data.band_hiring.size == data.bands.size and data.scope.account_band -%}
{%- for b in data.bands %}{% if b.label == data.scope.account_band %}{% assign has_peers = true %}{% endif %}{% endfor -%}
{%- endif -%}
{%- assign nv = total -%}
{%- capture total_f %}{% if nv >= 1000000 %}{{ nv | divided_by: 1000000.0 | floor }},{{ nv | divided_by: 1000.0 | floor | modulo: 1000 | plus: 1000 | slice: 1, 3 }},{{ nv | modulo: 1000 | plus: 1000 | slice: 1, 3 }}{% elsif nv >= 1000 %}{{ nv | divided_by: 1000.0 | floor }},{{ nv | modulo: 1000 | plus: 1000 | slice: 1, 3 }}{% else %}{{ nv }}{% endif %}{% endcapture -%}
{%- assign nv = people -%}
{%- capture people_f %}{% if nv >= 1000000 %}{{ nv | divided_by: 1000000.0 | floor }},{{ nv | divided_by: 1000.0 | floor | modulo: 1000 | plus: 1000 | slice: 1, 3 }},{{ nv | modulo: 1000 | plus: 1000 | slice: 1, 3 }}{% elsif nv >= 1000 %}{{ nv | divided_by: 1000.0 | floor }},{{ nv | modulo: 1000 | plus: 1000 | slice: 1, 3 }}{% else %}{{ nv }}{% endif %}{% endcapture -%}
{%- assign nv = p_small -%}
{%- capture small_f %}{% if nv >= 1000000 %}{{ nv | divided_by: 1000000.0 | floor }},{{ nv | divided_by: 1000.0 | floor | modulo: 1000 | plus: 1000 | slice: 1, 3 }},{{ nv | modulo: 1000 | plus: 1000 | slice: 1, 3 }}{% elsif nv >= 1000 %}{{ nv | divided_by: 1000.0 | floor }},{{ nv | modulo: 1000 | plus: 1000 | slice: 1, 3 }}{% else %}{{ nv }}{% endif %}{% endcapture -%}
{%- assign nv = p_large -%}
{%- capture large_f %}{% if nv >= 1000000 %}{{ nv | divided_by: 1000000.0 | floor }},{{ nv | divided_by: 1000.0 | floor | modulo: 1000 | plus: 1000 | slice: 1, 3 }},{{ nv | modulo: 1000 | plus: 1000 | slice: 1, 3 }}{% elsif nv >= 1000 %}{{ nv | divided_by: 1000.0 | floor }},{{ nv | modulo: 1000 | plus: 1000 | slice: 1, 3 }}{% else %}{{ nv }}{% endif %}{% endcapture -%}
{%- assign total_len = total_f | strip | size | at_least: 1 -%}
{%- comment -%}The count fills its column: size it from its length, with room for a wider brand face.{%- endcomment -%}
{%- assign big_k = 62 -%}
{%- if font_head == 'Red Hat Display' -%}{%- assign big_k = 47 -%}{%- endif -%}
{%- assign big_cqi = 9600.0 | divided_by: total_len | divided_by: big_k | round: 1 -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex">
<title>{{ data.headline | default: market_label | escape }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com/">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ head_q }}:wght@{{ head_wq }}&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ body_q }}:wght@{{ body_wq }}&display=swap">
<style>
:root{
  --p:{{ accent }};
  --s:{{ accent2 }};
  --fh:'{{ font_head }}',ui-sans-serif,system-ui,sans-serif;
  --fb:'{{ font_body }}',ui-sans-serif,system-ui,sans-serif;
  --hw:{{ head_w }};
  --bg:#ebe5e3;
  --surface:#e1dad7;
  --ink:{{ ink_css }};
  --mute:color-mix(in srgb,var(--ink) 80%,var(--bg));
  --on-p:{{ on_accent }};
  --mark:{{ accent_mark }};
  --c1:var(--ink);
  --c2:color-mix(in srgb,var(--ink) 80%,var(--bg));
  --c3:color-mix(in srgb,var(--ink) 62%,var(--bg));
  --c4:color-mix(in srgb,var(--ink) 46%,var(--bg));
  --c5:color-mix(in srgb,var(--ink) 32%,var(--bg));
  --c6:color-mix(in srgb,var(--ink) 20%,var(--bg));
  --m:clamp(1.25rem,3vw,2.5rem);
  --t-small:.875rem;
  --t-body:clamp(1.0625rem,1rem + .25vw,1.1875rem);
  --t-lead:clamp(1.25rem,1.1rem + .7vw,1.625rem);
  --t-sub:clamp(1.5rem,1rem + 1.6vw,2.25rem);
  --t-head:clamp(2.25rem,1.3rem + 3vw,3.75rem);
  --t-fig:clamp(4rem,2rem + 7vw,8rem);
}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%;background:var(--bg)}
body{margin:0;background:var(--bg);color:var(--ink);font:400 var(--t-body)/1.5 var(--fb);-webkit-font-smoothing:antialiased;-webkit-print-color-adjust:exact;print-color-adjust:exact}
h1,h2,h3{font-family:var(--fh);font-weight:var(--hw);margin:0;letter-spacing:-.03em;line-height:.95;text-wrap:balance}
p{margin:0}
a{color:inherit;text-underline-offset:.18em;text-decoration-thickness:.07em}
:focus-visible{outline:3px solid var(--mark);outline-offset:3px}
::selection{background:var(--ink);color:var(--bg)}
.tn{font-variant-numeric:tabular-nums lining-nums}
.wrap{padding-inline:var(--m);max-width:96rem;margin-inline:auto}
.n{font-variant-numeric:tabular-nums;color:var(--mute);margin-right:.35em}

.cover{min-height:100svh;display:flex;flex-direction:column;padding-bottom:3rem}
.top{display:flex;align-items:center;gap:1rem;justify-content:space-between;padding-block:1.25rem;font-size:var(--t-small)}
.brand{display:flex;align-items:center;gap:.55rem;font-weight:500}
.logo-img{height:26px;width:auto;max-width:9rem;display:block}
.mono{width:26px;height:26px;display:grid;place-items:center;background:var(--ink);color:var(--bg);font:var(--hw) .85rem/1 var(--fh)}
.for{text-align:right;color:var(--mute);max-width:24rem}
.hero{flex:1;display:grid;gap:2rem;align-content:center;padding-block:1.5rem 0}
.cover h1{font-size:clamp(1.625rem,.7rem + 3.4vw,3.75rem);line-height:1;max-width:22ch}
.count{display:grid;gap:1.75rem;align-items:end}
.num{container-type:inline-size}
.big{display:block;overflow:hidden;font:var(--hw) min(24rem,{{ big_cqi }}cqi)/.82 var(--fh);letter-spacing:-.055em;padding-bottom:.04em;margin-left:-.04em}
.big span{display:block}
.what{font-size:var(--t-lead);line-height:1.3;max-width:30ch;margin-top:.75rem}
.plate{width:min(100%,19rem)}
.plate svg{display:block;width:100%;height:auto}
.plate p{font-size:var(--t-small);line-height:1.45;color:var(--mute);margin-top:.7rem;max-width:34ch}
.c1{fill:var(--c1)}.c2{fill:var(--c2)}.c3{fill:var(--c3)}.c4{fill:var(--c4)}.c5{fill:var(--c5)}.c6{fill:var(--c6)}
.foot{display:grid;gap:1rem;padding-top:2.5rem}
.stand{font-size:var(--t-lead);line-height:1.35;max-width:36ch}
.byline{max-width:44ch}
.byline b{color:var(--ink);font-weight:500}

.toc{list-style:none;margin:0;padding:3.5rem 0 0;display:grid;gap:.15rem;counter-reset:t}
.toc li{counter-increment:t;font:500 var(--t-lead)/1.35 var(--fb);break-inside:avoid}
.toc li::before{content:counter(t) " ";color:var(--mute);font-variant-numeric:tabular-nums}

.sec{padding-block:clamp(4.5rem,3rem + 8vw,10rem) 0}
.sec h2{font-size:var(--t-head);max-width:18ch}
.sec .lede{font-size:var(--t-lead);line-height:1.38;max-width:34ch;margin-top:1.5rem}
.sec .after{max-width:60ch;margin-top:2rem}
.split{display:grid;gap:2.5rem}

.ledger{list-style:none;margin:0;padding:0;display:grid;gap:1.75rem}
.ledger li{display:grid;gap:.4rem}
.ledger b{font:var(--hw) var(--t-fig)/.86 var(--fh);letter-spacing:-.045em;font-variant-numeric:tabular-nums lining-nums}
.ledger span{max-width:40ch}

.bars{list-style:none;margin:0;padding:0;display:grid;gap:.9rem}
.bars li{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:.3rem 1rem;align-items:baseline}
.bars .l{font-weight:500}
.bars .v{font-variant-numeric:tabular-nums;font-weight:500;grid-row:1;grid-column:2;text-align:right}
.bars .t{grid-column:1/-1;height:1.1rem;background:var(--surface)}
.bars .f{display:block;height:100%;background:var(--ink)}
.bars .f2{display:block;height:100%;background:var(--c4)}
.bars .duo{display:flex;gap:3px}
.bars .mk{position:relative}
.bars .mk i{position:absolute;top:-.35rem;bottom:-.35rem;width:4px;margin-left:-2px;background:var(--mark)}
.bars li.mine .l,.bars li.mine .v{font-weight:700}
.bars li.mine .f{background:var(--mark)}
figure{margin:0;display:grid;gap:1rem}
figcaption{font-size:var(--t-small);line-height:1.5;color:var(--mute);max-width:52ch}
figcaption b{color:var(--ink);font-weight:500}
.key{display:flex;flex-wrap:wrap;gap:.4rem 1.4rem;font-size:var(--t-small);margin:0 0 .4rem;padding:0;list-style:none}
.key li{display:flex;align-items:center;gap:.45rem}
.key i{width:.9rem;height:.9rem;display:inline-block;background:var(--ink)}
.key i.k2{background:var(--c4)}
.key i.k3{background:var(--mark)}

.field{background:var(--ink);color:var(--bg);margin-top:clamp(4.5rem,3rem + 8vw,10rem);padding-block:clamp(4rem,3rem + 5vw,8rem)}
.field.sec{padding-top:clamp(4rem,3rem + 5vw,8rem)}
.field .n{color:color-mix(in srgb,var(--bg) 70%,var(--ink))}
.field figcaption{color:color-mix(in srgb,var(--bg) 78%,var(--ink))}
.field figcaption b{color:var(--bg)}
.stack{display:flex;gap:4px;height:clamp(5rem,3rem + 6vw,9rem);margin-top:3rem}
.stack span{display:block;min-width:4px}
.r1{background:var(--bg)}.r2{background:color-mix(in srgb,var(--bg) 78%,var(--ink))}.r3{background:color-mix(in srgb,var(--bg) 58%,var(--ink))}.r4{background:color-mix(in srgb,var(--bg) 42%,var(--ink))}.r5{background:color-mix(in srgb,var(--bg) 30%,var(--ink))}.r6{background:color-mix(in srgb,var(--bg) 20%,var(--ink))}
.regs{list-style:none;margin:1.5rem 0 0;padding:0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.25rem 1.5rem}
.regs li{display:grid;gap:.15rem}
.regs i{width:1.4rem;height:.5rem;display:block;margin-bottom:.35rem}
.regs b{font:var(--hw) var(--t-lead)/1 var(--fh);letter-spacing:-.02em}
.regs span{font-variant-numeric:tabular-nums;color:color-mix(in srgb,var(--bg) 82%,var(--ink))}

.pair{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.25rem;margin:3rem 0}
.pair div{display:grid;gap:.6rem;align-content:start}
.pair b{font:var(--hw) var(--t-fig)/.85 var(--fh);letter-spacing:-.05em;font-variant-numeric:tabular-nums lining-nums}
.pair div+div b{color:var(--c3)}
.pair span{max-width:24ch}

.sigs{list-style:none;margin:2.5rem 0 3rem;padding:0;display:grid;gap:1.75rem}
.sigs li{display:grid;gap:.4rem}
.sigs b{font:var(--hw) var(--t-fig)/.86 var(--fh);letter-spacing:-.045em;font-variant-numeric:tabular-nums lining-nums}
.sigs span{max-width:28ch}

.plays-f{background:var(--p);color:var(--on-p);margin-top:clamp(4.5rem,3rem + 8vw,10rem);padding-block:clamp(4rem,3rem + 5vw,8rem)}
.plays-f .n{color:inherit;opacity:.72}
.plays{list-style:none;margin:3rem 0 0;padding:0;display:grid;gap:2.75rem}
.plays li{display:grid;gap:.8rem}
.plays h3{font-size:var(--t-sub);line-height:1.05;max-width:24ch}
.plays p{max-width:58ch}

.close{padding-block:clamp(4.5rem,3rem + 8vw,10rem) 4rem;display:grid;gap:2rem}
.close .ask{font:var(--hw) var(--t-sub)/1.12 var(--fh);letter-spacing:-.02em;max-width:26ch}
.close .src{max-width:52ch}
.act{display:flex;flex-wrap:wrap;gap:1.25rem 2rem;align-items:center}
.ken-cta{display:inline-block!important;min-height:52px;padding:15px 26px!important;border-radius:0!important;background:var(--p)!important;color:var(--on-p)!important;font:600 var(--t-body)/1.3 var(--fb)!important;text-decoration:none!important}
.ken-cta:hover{background:var(--ink)!important;color:var(--bg)!important}
.sign b{display:block;font-weight:500}
.sign span{color:var(--mute)}
.method{font-size:var(--t-small);line-height:1.55;color:var(--mute);max-width:60ch;background:var(--surface);padding:1.25rem 1.4rem}
.method b{color:var(--ink);font-weight:500}

@keyframes up{from{transform:translateY(105%)}to{transform:none}}
@media (prefers-reduced-motion:no-preference){
  .big span{animation:up .9s cubic-bezier(.16,.84,.24,1) both}
  .cover h1{animation:up .9s cubic-bezier(.16,.84,.24,1) .11s both}
  .h1m{overflow:hidden;padding-bottom:.08em}
}

@media (min-width:760px){
  .hero{grid-template-columns:repeat(12,minmax(0,1fr));column-gap:1.5rem;row-gap:2.5rem}
  .h1m{grid-column:1/-1}
  .count{grid-column:1/-1;grid-template-columns:repeat(12,minmax(0,1fr));column-gap:1.5rem}
  .count .num{grid-column:1/9}
  .count .plate{grid-column:9/-1;justify-self:end;width:100%;max-width:23rem}
  .foot{grid-template-columns:repeat(12,minmax(0,1fr));column-gap:1.5rem;align-items:end;padding-top:3rem}
  .foot .stand{grid-column:1/7}
  .foot .byline{grid-column:8/-1}
  .toc{display:block;columns:2;column-gap:1.5rem}
  .split{grid-template-columns:repeat(12,minmax(0,1fr));column-gap:1.5rem}
  .split>.hd{grid-column:1/6}
  .peers>.split>.hd{grid-column:1/-1}
  .peers>.split>.bd{grid-column:6/-1}
  .peers .hd h2{max-width:none}
  .split>.bd{grid-column:7/-1}
  .split.wide>.hd{grid-column:1/6}
  .split.wide>.bd{grid-column:6/-1}
  .brief>.hd,.brief>.bd{grid-column:1/-1}
  .ledger li{grid-template-columns:repeat(12,minmax(0,1fr));column-gap:1.5rem;align-items:baseline}
  .ledger b{grid-column:1/6}
  .ledger span{grid-column:6/-1}
  .ledger b{text-align:right}
  .bars li{grid-template-columns:minmax(0,15rem) minmax(0,1fr) 4.5rem;gap:1rem}
  .bars .t{grid-column:2;grid-row:1;align-self:center}
  .bars .v{grid-column:3}
  .regs{grid-template-columns:repeat(var(--nr,5),minmax(0,1fr))}
  .sigs{grid-template-columns:repeat(var(--ns,3),minmax(0,1fr));gap:1.5rem}
  .close{grid-template-columns:repeat(12,minmax(0,1fr));column-gap:1.5rem;row-gap:2.5rem}
  .close .ask{grid-column:1/8}
  .close .src{grid-column:1/7}
  .close .act{grid-column:8/-1;grid-row:1/3;align-self:end;flex-direction:column;align-items:flex-start}
  .close .method{grid-column:1/-1}
}
@media (min-width:1000px){
  .h1m{grid-column:1/10}
  .plays li{grid-template-columns:repeat(12,minmax(0,1fr));column-gap:1.5rem;align-items:baseline}
  .plays h3{grid-column:1/7}
  .plays p{grid-column:7/-1}
}
@media print{
  @page{margin:15mm}
  html,body{background:#fff}
  .cover{min-height:auto}
  .hero{padding-top:2rem}
  .big{font-size:9rem}
  .sec{break-before:page;padding-top:0}
  .field,.plays-f{background:#fff;color:var(--ink);margin-top:0;padding-block:0}
  .field .r1{background:var(--ink)}
  .field figcaption,.field .regs span{color:var(--mute)}
  .field figcaption b{color:var(--ink)}
  .field .n{color:var(--mute)}
  .close{break-before:auto;padding-top:2.5rem}
  .act{display:none}
  figure,.ledger li,.plays li,.pair,.sigs li{break-inside:avoid}
  .big span,.cover h1{animation:none}
}
</style>
</head>
<body>
<main>
<section class="cover wrap" data-section="cover">
<header class="top">
<div class="brand">
{%- if logo != '' %}<img class="logo-img" src="{{ brand.logo_url | escape }}" alt="{{ brand.name | default: 'Logo' | escape }}">{% elsif brand.name %}<span class="mono" aria-hidden="true">{{ brand.name | slice: 0, 1 | upcase | escape }}</span>{% endif -%}
{%- if brand.name and logo == '' %}<span>{{ brand.name | escape }}</span>{% endif -%}
</div>
<p class="for">Market report for {{ acct | escape }}</p>
</header>
<div class="hero">
<div class="h1m">
<h1>{{ data.headline | default: market_label | escape }}</h1>
</div>
{%- if total > 0 or segs.size > 0 %}
<div class="count">
<div class="num">
{%- if total > 0 %}
<p class="big tn" aria-label="{{ total_f | strip }} companies"><span>{{ total_f | strip }}</span></p>
<p class="what">{{ market_label | escape }}, {{ data.scope.size | default: 'all sizes' | escape }}.</p>
{%- endif %}
</div>
{%- if segs.size > 0 %}
{%- assign ends = '' -%}
{%- assign cum = 0 -%}
{%- for s in segs %}{% assign cum = cum | plus: s.value %}{% assign e = cum | times: 100.0 | divided_by: segsum | round %}{% assign ends = ends | append: e | append: ';' %}{% endfor -%}
{%- assign end_list = ends | split: ';' -%}
<div class="plate">
<svg viewBox="0 0 200 200" role="img" aria-label="{{ market_label | escape }}: companies as 100 squares, shaded by segment">
{%- for i in (0..99) %}
{%- assign k = 0 %}
{%- for e in end_list %}{% assign en = e | plus: 0 %}{% if i < en %}{% assign k = forloop.index %}{% break %}{% endif %}{% endfor %}
{%- if k == 0 %}{% assign k = segs.size %}{% endif %}
<rect x="{{ i | modulo: 10 | times: 20 }}" y="{{ i | divided_by: 10.0 | floor | times: 20 }}" width="17" height="17" class="c{{ k | at_most: 6 }}"/>
{%- endfor %}
</svg>
<p>Each square is one percent of the segments in figure 1, darkest for {{ segs.first.label | escape }}, lightest for {{ segs.last.label | escape }}.</p>
</div>
{%- endif %}
</div>
{%- endif %}
</div>
<div class="foot">
{%- if data.stand and data.stand != '' %}
<p class="stand">{{ data.stand | escape }}</p>
{%- endif %}
<p class="byline">Prepared for {% if person.first_name %}<b>{{ person.first_name | escape }}{% if person.last_name %} {{ person.last_name | escape }}{% endif %}</b>{% if person.title %}, {{ person.title | escape }}{% endif %} at {{ acct | escape }}{% else %}<b>{{ acct | escape }}</b>{% endif %}, by <b>{{ sender.name | default: 'Our team' | escape }}</b>{% if sender.title %}, {{ sender.title | escape }}{% endif %}{% if brand.name %} at {{ brand.name | escape }}{% endif %}. Counted from company profiles and hiring data{% if total > 0 %}: {{ total_f | strip }} companies{% if has_roles %} and {{ people_f | strip }} people{% endif %}{% endif %}.</p>
</div>
<ol class="toc" aria-label="Contents">
{%- if data.brief.size > 0 %}
<li>In brief</li>
{%- endif %}
<li>Who is in the market</li>
<li>Where they are</li>
{%- if has_roles %}
<li>Who buys</li>
{%- endif %}
<li>Who is growing</li>
{%- if has_peers %}
<li>Where {{ acct | escape }} sits</li>
{%- endif %}
<li>Three plays for {{ acct | escape }}</li>
</ol>
</section>
{%- assign sn = 1 %}
{%- if data.brief.size > 0 %}
<section class="sec wrap split brief" data-section="brief">
<div class="hd">
<h2><span class="n">{{ sn }}</span>In brief</h2>
</div>
{%- assign sn = sn | plus: 1 %}
<ul class="ledger bd">
{%- for b in data.brief %}
<li><b>{{ b.figure | escape }}</b><span>{{ b.text | escape }}</span></li>
{%- endfor %}
</ul>
</section>
{%- endif %}
<section class="sec wrap" data-section="segments">
<div class="split wide">
<div class="hd">
<h2><span class="n">{{ sn }}</span>Who is in the market</h2>
{%- assign sn = sn | plus: 1 %}
{%- if data.narrative.segments and data.narrative.segments != '' %}
<p class="lede">{{ data.narrative.segments | escape }}</p>
{%- endif %}
</div>
{%- assign segmax = segs | map: 'value' | sort | last | at_least: 1 %}
<figure class="bd">
<ul class="bars" role="img" aria-label="Companies by segment, as bars">
{%- for s in segs %}
<li><span class="l">{{ s.label | escape }}</span><span class="t"><span class="f" style="width:{{ s.value | times: 100.0 | divided_by: segmax | round: 1 }}%"></span></span><span class="v">{% assign nv = s.value %}{% if nv >= 1000000 %}{{ nv | divided_by: 1000000.0 | floor }},{{ nv | divided_by: 1000.0 | floor | modulo: 1000 | plus: 1000 | slice: 1, 3 }},{{ nv | modulo: 1000 | plus: 1000 | slice: 1, 3 }}{% elsif nv >= 1000 %}{{ nv | divided_by: 1000.0 | floor }},{{ nv | modulo: 1000 | plus: 1000 | slice: 1, 3 }}{% else %}{{ nv }}{% endif %}</span></li>
{%- endfor %}
</ul>
<figcaption><b>Figure 1.</b> Companies by segment, {{ data.scope.size | default: 'all sizes' | escape }}. Segments follow each company's primary industry in its profile.{% if total > 0 %} Total {{ total_f | strip }}.{% endif %}</figcaption>
{%- if data.narrative.segments_after and data.narrative.segments_after != '' %}
<p class="after">{{ data.narrative.segments_after | escape }}</p>
{%- endif %}
</figure>
</div>
</section>
<section class="sec field" data-section="regions">
<div class="wrap">
<div class="split">
<div class="hd">
<h2><span class="n">{{ sn }}</span>Where they are</h2>
{%- assign sn = sn | plus: 1 %}
</div>
{%- if data.narrative.regions and data.narrative.regions != '' %}
<p class="lede bd">{{ data.narrative.regions | escape }}</p>
{%- endif %}
</div>
<figure>
<div class="stack" role="img" aria-label="Share of companies by region, one stacked bar">
{%- for r in regs %}
<span class="r{{ forloop.index | at_most: 6 }}" style="flex:{{ r.value }} 1 0"></span>
{%- endfor %}
</div>
<ul class="regs" style="--nr:{{ regs.size | at_most: 6 }}">
{%- for r in regs %}
<li><i class="r{{ forloop.index | at_most: 6 }}"></i><b>{{ r.label | escape }}</b><span>{{ r.value | times: 100.0 | divided_by: regsum | round }}%, {% assign nv = r.value %}{% if nv >= 1000000 %}{{ nv | divided_by: 1000000.0 | floor }},{{ nv | divided_by: 1000.0 | floor | modulo: 1000 | plus: 1000 | slice: 1, 3 }},{{ nv | modulo: 1000 | plus: 1000 | slice: 1, 3 }}{% elsif nv >= 1000 %}{{ nv | divided_by: 1000.0 | floor }},{{ nv | modulo: 1000 | plus: 1000 | slice: 1, 3 }}{% else %}{{ nv }}{% endif %}</span></li>
{%- endfor %}
</ul>
<figcaption><b>Figure 2.</b> Share of companies by headquarters region, from company profiles.</figcaption>
</figure>
{%- if data.narrative.regions_after and data.narrative.regions_after != '' %}
<p class="after">{{ data.narrative.regions_after | escape }}</p>
{%- endif %}
</div>
</section>
{%- if has_roles %}
{%- assign rmax = 1 %}
{%- for r in data.roles_small %}{% assign rt = r.value | plus: data.roles_large[forloop.index0].value %}{% if rt > rmax %}{% assign rmax = rt %}{% endif %}{% endfor %}
<section class="sec wrap" data-section="buyers">
<div class="split">
<div class="hd">
<h2><span class="n">{{ sn }}</span>Who buys</h2>
{%- assign sn = sn | plus: 1 %}
</div>
{%- if data.narrative.buyers and data.narrative.buyers != '' %}
<p class="lede bd">{{ data.narrative.buyers | escape }}</p>
{%- endif %}
</div>
<div class="pair">
<div><b>{{ small_f | strip }}</b><span>people in these roles at companies with {{ data.scope.small_band | default: 'smaller headcounts' | downcase | escape }}</span></div>
<div><b>{{ large_f | strip }}</b><span>at companies with {{ data.scope.large_band | default: 'larger headcounts' | downcase | escape }}</span></div>
</div>
<figure>
<ul class="key">
<li><i></i>{{ data.scope.small_band | default: 'Smaller companies' | escape }}</li>
<li><i class="k2"></i>{{ data.scope.large_band | default: 'Larger companies' | escape }}</li>
</ul>
<ul class="bars" role="img" aria-label="People in each buying role by company size, stacked bars">
{%- for r in data.roles_small %}
{%- assign lg = data.roles_large[forloop.index0].value %}
<li><span class="l">{{ r.label | escape }}</span><span class="t duo"><span class="f" style="width:{{ r.value | times: 100.0 | divided_by: rmax | round: 1 }}%"></span><span class="f2" style="width:{{ lg | times: 100.0 | divided_by: rmax | round: 1 }}%"></span></span><span class="v">{% assign nv = r.value | plus: lg %}{% if nv >= 1000000 %}{{ nv | divided_by: 1000000.0 | floor }},{{ nv | divided_by: 1000.0 | floor | modulo: 1000 | plus: 1000 | slice: 1, 3 }},{{ nv | modulo: 1000 | plus: 1000 | slice: 1, 3 }}{% elsif nv >= 1000 %}{{ nv | divided_by: 1000.0 | floor }},{{ nv | modulo: 1000 | plus: 1000 | slice: 1, 3 }}{% else %}{{ nv }}{% endif %}</span></li>
{%- endfor %}
</ul>
<figcaption><b>Figure 3.</b> People in each buying role, by the size of their company. Current titles only. Total {{ people_f | strip }}.</figcaption>
</figure>
{%- if data.narrative.buyers_after and data.narrative.buyers_after != '' %}
<p class="after">{{ data.narrative.buyers_after | escape }}</p>
{%- endif %}
</section>
{%- endif %}
<section class="sec wrap" data-section="signals">
<div class="split">
<div class="hd">
<h2><span class="n">{{ sn }}</span>Who is growing</h2>
{%- assign sn = sn | plus: 1 %}
</div>
{%- if data.narrative.signals and data.narrative.signals != '' %}
<p class="lede bd">{{ data.narrative.signals | escape }}</p>
{%- endif %}
</div>
{%- if data.signals.size > 0 %}
<ul class="sigs" style="--ns:{{ data.signals.size | at_most: 4 }}">
{%- for s in data.signals %}
<li><b>{% assign nv = s.value %}{% if nv >= 1000000 %}{{ nv | divided_by: 1000000.0 | floor }},{{ nv | divided_by: 1000.0 | floor | modulo: 1000 | plus: 1000 | slice: 1, 3 }},{{ nv | modulo: 1000 | plus: 1000 | slice: 1, 3 }}{% elsif nv >= 1000 %}{{ nv | divided_by: 1000.0 | floor }},{{ nv | modulo: 1000 | plus: 1000 | slice: 1, 3 }}{% else %}{{ nv }}{% endif %}</b><span>{{ s.label | escape }}.{% if total > 0 %} {{ s.value | times: 100.0 | divided_by: total | round }}% of the market.{% endif %}</span></li>
{%- endfor %}
</ul>
{%- endif %}
{%- if has_hiring %}
{%- assign keys = '' %}
{%- assign topshare = 1 %}
{%- for h in data.hiring %}
{%- assign base = 0 %}
{%- for s in segs %}{% if s.label == h.label %}{% assign base = s.value %}{% endif %}{% endfor %}
{%- if base > 0 %}
{%- assign sh = h.value | times: 1000.0 | divided_by: base | round | plus: 10000 %}
{%- assign keys = keys | append: sh | append: '|' | append: forloop.index0 | append: ';' %}
{%- endif %}
{%- endfor %}
{%- assign key_list = keys | split: ';' | sort | reverse | compact %}
{%- assign topkey = key_list.first | split: '|' %}
{%- assign topshare = topkey.first | minus: 10000 | divided_by: 10.0 | at_least: 1 %}
{%- assign mkt = data.signals.first.value | times: 100.0 | divided_by: total %}
{%- assign mkt_x = mkt | times: 100.0 | divided_by: topshare | at_most: 100 | round: 1 %}
{%- if key_list.size > 0 %}
<figure class="split">
<div class="hd">
<ul class="key"><li><i class="k3"></i>All segments, {{ mkt | round }}%</li></ul>
<figcaption><b>Figure 4.</b> Share of companies in each segment that are hiring. The marked line is the whole market, {{ mkt | round }} percent.</figcaption>
</div>
<div class="bd">
<ul class="bars" role="img" aria-label="Share of companies hiring, by segment">
{%- for key in key_list %}
{%- assign parts = key | split: '|' %}
{%- assign hi = parts.last | plus: 0 %}
{%- assign h = data.hiring[hi] %}
<li><span class="l">{{ h.label | escape }}</span><span class="t mk"><span class="f" style="width:{{ parts.first | minus: 10000 | divided_by: 10.0 | times: 100.0 | divided_by: topshare | round: 1 }}%"></span><i style="left:{{ mkt_x }}%"></i></span><span class="v">{{ parts.first | minus: 10000 | divided_by: 10.0 | round }}%</span></li>
{%- endfor %}
</ul>
</div>
</figure>
{%- endif %}
{%- endif %}
{%- if data.narrative.signals_after and data.narrative.signals_after != '' %}
<p class="after">{{ data.narrative.signals_after | escape }}</p>
{%- endif %}
</section>
{%- if has_peers %}
{%- assign bmax = data.bands | map: 'value' | sort | last | at_least: 1 %}
{%- assign bsum = 0 %}
{%- for b in data.bands %}{% assign bsum = bsum | plus: b.value %}{% endfor %}
<section class="sec wrap peers" data-section="peers">
<div class="split">
<div class="hd">
<h2><span class="n">{{ sn }}</span>Where {{ acct | escape }} sits</h2>
{%- assign sn = sn | plus: 1 %}
{%- if data.narrative.peers and data.narrative.peers != '' %}
<p class="lede">{{ data.narrative.peers | escape }}</p>
{%- endif %}
</div>
<figure class="bd">
<ul class="key"><li><i class="k3"></i>{{ acct_s | escape }} size band</li><li><i></i>Other size bands</li></ul>
<ul class="bars" role="img" aria-label="Companies in each size band and the share of each band that is hiring">
{%- for b in data.bands %}
{%- assign hb = data.band_hiring[forloop.index0].value | default: 0 %}
{%- assign mine = false %}
{%- if b.label == data.scope.account_band %}{% assign mine = true %}{% endif %}
<li{% if mine %} class="mine"{% endif %}><span class="l">{{ b.label | escape }}, {% if b.value > 0 %}{{ hb | times: 100.0 | divided_by: b.value | round }}%{% else %}0%{% endif %} hiring</span><span class="t"><span class="f" style="width:{{ b.value | times: 100.0 | divided_by: bmax | round: 1 }}%"></span></span><span class="v">{% assign nv = b.value %}{% if nv >= 1000000 %}{{ nv | divided_by: 1000000.0 | floor }},{{ nv | divided_by: 1000.0 | floor | modulo: 1000 | plus: 1000 | slice: 1, 3 }},{{ nv | modulo: 1000 | plus: 1000 | slice: 1, 3 }}{% elsif nv >= 1000 %}{{ nv | divided_by: 1000.0 | floor }},{{ nv | modulo: 1000 | plus: 1000 | slice: 1, 3 }}{% else %}{{ nv }}{% endif %}</span></li>
{%- endfor %}
</ul>
<figcaption><b>Figure 5.</b> Companies in {{ acct_s | escape }} industry and region, by headcount, and the share of each band that is hiring. {{ acct | escape }} is in the {{ data.scope.account_band | escape }} band. Total {% assign nv = bsum %}{% if nv >= 1000000 %}{{ nv | divided_by: 1000000.0 | floor }},{{ nv | divided_by: 1000.0 | floor | modulo: 1000 | plus: 1000 | slice: 1, 3 }},{{ nv | modulo: 1000 | plus: 1000 | slice: 1, 3 }}{% elsif nv >= 1000 %}{{ nv | divided_by: 1000.0 | floor }},{{ nv | modulo: 1000 | plus: 1000 | slice: 1, 3 }}{% else %}{{ nv }}{% endif %}.</figcaption>
{%- if data.narrative.peers_after and data.narrative.peers_after != '' %}
<p class="after">{{ data.narrative.peers_after | escape }}</p>
{%- endif %}
</figure>
</div>
</section>
{%- endif %}
<section class="sec plays-f" data-section="plays">
<div class="wrap">
<h2><span class="n">{{ sn }}</span>Three plays</h2>
<p class="lede">For {{ acct | escape }}, drawn from the counts in this report.</p>
{%- assign sn = sn | plus: 1 %}
<ul class="plays">
{%- for p in data.plays %}
<li><h3>{{ p.title | escape }}</h3><p>{{ p.body | escape }}</p></li>
{%- endfor %}
</ul>
</div>
</section>
<section class="close wrap" data-section="next">
<p class="ask">Book 30 minutes and I will go through the list with you.</p>
<p class="src">The companies and people behind this report come from company profiles and hiring data, filtered to {{ acct_s | escape }} market.</p>
<div class="act">
{% render 'ken/cta', label: 'Book 30 minutes', kind: 'booking' %}
<p class="sign"><b>{{ sender.name | default: 'Our team' | escape }}</b>{% if sender.title or brand.name %}<span>{% if sender.title %}{{ sender.title | escape }}{% if brand.name %}, {% endif %}{% endif %}{% if brand.name %}{{ brand.name | escape }}{% endif %}</span>{% endif %}</p>
</div>
{%- if data.method and data.method != '' %}
<p class="method"><b>How this was built.</b> {{ data.method | escape }}</p>
{%- endif %}
</section>
</main>
</body>
</html>
