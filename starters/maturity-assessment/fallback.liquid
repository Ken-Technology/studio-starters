{%- assign brand_p = brand.colors.primary | default: '#e8dd90' -%}
{%- assign brand_s = brand.colors.secondary | default: '#0d2a1c' -%}
{%- assign font_head = brand.fonts.heading | default: 'Hanken Grotesk' -%}
{%- assign font_body = brand.fonts.body | default: 'Hanken Grotesk' -%}
{%- assign brand_name = brand.name | default: '' -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex">
<title>An operations check for {{ account.name | escape }}</title>
{%- if font_head == 'Hanken Grotesk' %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500&display=swap">
{%- else %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_head | url_encode }}&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_head | url_encode }}:wght@700&display=swap">
{%- endif %}
{%- if font_body != font_head %}
{%- if font_body == 'Hanken Grotesk' %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500&display=swap">
{%- else %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_body | url_encode }}&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_body | url_encode }}:wght@700&display=swap">
{%- endif %}
{%- endif %}
<style>
:root{--p:{{ brand_p | escape }};--s:{{ brand_s | escape }};--on-p:#0d2a1c;--on-p:color(from var(--p) xyz-d65 clamp(0,(.18 - y) * 1000000,.9505) clamp(0,(.18 - y) * 1000000,1) clamp(0,(.18 - y) * 1000000,1.089));--on-s:#f7f7f7;--on-s:color(from var(--s) xyz-d65 clamp(0,(.18 - y) * 1000000,.9505) clamp(0,(.18 - y) * 1000000,1) clamp(0,(.18 - y) * 1000000,1.089));--fh:'{{ font_head | escape }}','Helvetica Neue',Arial,sans-serif;--fb:'{{ font_body | escape }}','Helvetica Neue',Arial,sans-serif;--bg:#f7f7f7;--ink:#0d2a1c;--muted:#4f5d55;--m:clamp(1.125rem,3.4vw,2.75rem)}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:var(--bg);color:var(--ink);font:400 1.0625rem/1.5 var(--fb);-webkit-font-smoothing:antialiased}
h1,h2{font-family:var(--fh);margin:0;font-weight:500;line-height:.98;letter-spacing:-.04em;text-wrap:balance}
p{margin:0}
:focus-visible{outline:3px solid var(--ink);outline-offset:3px}
.top{display:flex;align-items:baseline;justify-content:space-between;gap:1rem;padding:1.25rem var(--m) 0}
.brand{font-family:var(--fh);font-weight:500;font-size:1.125rem;letter-spacing:-.02em;min-width:0}
.logo{height:28px;width:auto;max-width:9rem;display:block}
.for{font-size:.875rem;color:var(--muted);text-align:right}
.intro{padding:clamp(2.5rem,7vw,5rem) var(--m) clamp(2.5rem,6vw,4rem);display:grid;gap:1rem}
.intro h1{font-size:clamp(2.125rem,1.2rem + 4.4vw,5.5rem);max-width:16ch;margin-bottom:.5rem}
.intro p{max-width:46ch;font-size:clamp(1.1875rem,1.05rem + .5vw,1.5rem);line-height:1.4}
.stair{display:flex;align-items:flex-end;height:clamp(4rem,9vw,7rem);padding:0 var(--m)}
.stair i{flex:1;background:var(--p)}
.stair i:nth-child(1){height:25%}.stair i:nth-child(2){height:50%}.stair i:nth-child(3){height:75%}.stair i:nth-child(4){height:100%}
.cta{background:var(--s);color:var(--on-s);padding:clamp(3rem,8vw,6rem) var(--m);display:grid;gap:1.25rem;justify-items:start}
.cta h2{font-size:clamp(1.875rem,1.2rem + 2.6vw,3.5rem)}
.cta p{font-size:clamp(1.0625rem,1rem + .3vw,1.25rem);line-height:1.45;max-width:44ch}
.who b{display:block;font-weight:500}
.cta .ken-cta{display:inline-flex!important;align-items:center;justify-content:center;min-height:56px;padding:1rem 1.75rem!important;border-radius:0!important;background:var(--p)!important;color:var(--on-p)!important;font-family:var(--fh);font-weight:500!important;font-size:1.375rem;letter-spacing:-.02em;text-decoration:none}
.cta .ken-cta:focus-visible{outline:3px solid var(--on-s);outline-offset:4px}
</style>
</head>
<body>
<header class="top">
  <div class="brand">{% if brand.logo_url %}<img class="logo" src="{{ brand.logo_url | escape }}" alt="{{ brand_name | default: 'Logo' | escape }}">{% elsif brand_name != '' %}<span>{{ brand_name | escape }}</span>{% endif %}</div>
  <p class="for">{% if person.first_name %}For {{ person.first_name | escape }}{% if person.last_name %} {{ person.last_name | escape }}{% endif %}, {{ account.name | escape }}{% else %}Prepared for {{ account.name | escape }}{% endif %}</p>
</header>
<main>
  <section class="intro" data-section="start">
    <h1>How mature are {{ account.name | escape }}'s operations?</h1>
    <p>Hi {{ person.first_name | default: 'there' | escape }}, the self-assessment for {{ account.name | escape }} is not ready on this page yet. It is eight questions across process, data, automation and team, scored from 1 to 4.</p>
    <p>We can go through the same questions together on a short call.</p>
  </section>
  <div class="stair" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
  <section class="cta" data-section="book">
    <h2>Walk through it together</h2>
    <p>Thirty minutes. You answer the eight questions out loud, and we talk about where {{ account.name | escape }} scored lowest and what the first move would take.</p>
    {%- if sender.name %}
    <p class="who"><b>{{ sender.name | escape }}</b>{% if sender.title %}{{ sender.title | escape }}{% if brand_name != '' %}, {% endif %}{% endif %}{{ brand_name | escape }}</p>
    {%- endif %}
    {% render 'ken/cta', label: 'Book 30 minutes', kind: 'booking', id: 'fallback-booking' %}
  </section>
</main>
</body>
</html>
