{%- assign brand_p = brand.colors.primary | default: '#2a4bd7' -%}
{%- assign brand_s = brand.colors.secondary | default: '#0e1530' -%}
{%- assign font_head = brand.fonts.heading | default: 'Inter Tight' -%}
{%- assign font_body = brand.fonts.body | default: 'Inter' -%}
{%- assign brand_name = brand.name | default: 'Northbeam' -%}
{%- assign head_q = font_head | replace: ' ', '+' -%}
{%- assign body_q = font_body | replace: ' ', '+' -%}
{%- if font_head == 'Inter Tight' -%}{%- assign head_w = '500;600;700' -%}{%- else -%}{%- assign head_w = '400;700' -%}{%- endif -%}
{%- if font_body == 'Inter' -%}{%- assign body_w = '400;500;600' -%}{%- else -%}{%- assign body_w = '400;700' -%}{%- endif -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex">
<title>An operations check for {{ account.name | escape }}</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ head_q | escape }}:wght@{{ head_w }}&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ body_q | escape }}:wght@{{ body_w }}&display=swap">
<style>
:root{--p:{{ brand_p | escape }};--s:{{ brand_s | escape }};--fh:'{{ font_head | escape }}',ui-sans-serif,system-ui,-apple-system,'Segoe UI',sans-serif;--fb:'{{ font_body | escape }}',ui-sans-serif,system-ui,-apple-system,'Segoe UI',sans-serif;--ink:color-mix(in srgb,var(--s) 70%,#000);--text:color-mix(in srgb,var(--ink) 84%,#fff);--mute:color-mix(in srgb,var(--ink) 58%,#fff);--line:color-mix(in srgb,var(--ink) 14%,#fff);--stage:color-mix(in srgb,var(--p) 6%,#fff);--p-deep:color-mix(in srgb,var(--p) 80%,#000)}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:var(--stage);color:var(--text);font:16px/1.55 var(--fb);-webkit-font-smoothing:antialiased;min-height:100vh}
h1,h2{font-family:var(--fh);color:var(--ink);margin:0;line-height:1.12;letter-spacing:-.015em;font-weight:600;text-wrap:balance}
p{margin:0}
.top{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:1rem 1.25rem}
.brand{display:flex;align-items:center;gap:.6rem;font-family:var(--fh);font-weight:600;color:var(--ink);min-width:0}
.logo{height:26px;width:auto;max-width:120px;display:block;flex:none}
.mark{width:26px;height:26px;border-radius:7px;background:var(--p);color:#fff;display:grid;place-items:center;font:700 14px/1 var(--fh);flex:none}
.for{font-size:.85rem;color:var(--mute);text-align:right}
.wrap{max-width:46rem;margin:0 auto;padding:.75rem 1rem 5rem}
.card{background:#fff;border:1px solid var(--line);border-radius:18px;padding:1.4rem 1.25rem 1.6rem;box-shadow:0 14px 40px color-mix(in srgb,var(--ink) 10%,transparent)}
.card h1{font-size:2rem;margin:.2rem 0 .9rem}
.card p+p{margin-top:.8rem}
.lede{font-size:1.05rem;max-width:34rem}
.book{margin-top:1.4rem;background:var(--stage);border-radius:14px;padding:1.3rem 1.25rem;display:grid;gap:.9rem}
.book h2{font-size:1.25rem}
.book p{font-size:.95rem;max-width:34rem}
.book .ken-cta{display:inline-flex!important;align-items:center;justify-content:center;min-height:48px;padding:.9rem 1.5rem!important;border-radius:10px!important;background:var(--p)!important;color:#fff!important;font-weight:600!important;width:fit-content}
.book .ken-cta:hover{background:var(--p-deep)!important}
.who{font-size:.88rem;color:var(--mute)}
.who b{display:block;color:var(--ink);font-weight:600}
@media (min-width:760px){.top{padding:1.2rem 2rem}.wrap{padding:1.5rem 1.5rem 6rem}.card{padding:2.2rem 2.4rem 2.4rem}.card h1{font-size:2.6rem}.book{grid-template-columns:minmax(0,1fr) auto;align-items:center;padding:1.6rem 1.8rem}.book .ken-cta{grid-column:2;grid-row:1/4}}
</style>
</head>
<body>
<header class="top">
  <div class="brand">{% if brand.logo_url %}<img class="logo" src="{{ brand.logo_url | escape }}" alt="">{% else %}<span class="mark" aria-hidden="true">{{ brand_name | slice: 0, 1 | upcase | escape }}</span>{% endif %}<span>{{ brand_name | escape }}</span></div>
  <p class="for">{% if person.first_name %}For {{ person.first_name | escape }}{% if person.last_name %} {{ person.last_name | escape }}{% endif %}<br>{{ account.name | escape }}{% else %}Prepared for<br>{{ account.name | escape }}{% endif %}</p>
</header>
<main class="wrap">
  <div class="card">
    <section data-section="start">
      <h1>How mature are {{ account.name | escape }}'s operations?</h1>
      <p class="lede">Hi {{ person.first_name | default: 'there' | escape }}, the self-assessment for {{ account.name | escape }} is not ready on this page yet. It is eight questions across process, data, automation and team, scored from 1 to 4.</p>
      <p class="lede">We can go through the same questions together on a short call.</p>
    </section>
    <section class="book" data-section="book">
      <h2>Walk through it together</h2>
      <p>Thirty minutes. You answer the eight questions out loud, and we talk about where {{ account.name | escape }} scored lowest and what the first move would take.</p>
      {%- if sender.name %}
      <p class="who"><b>{{ sender.name | escape }}</b>{% if sender.title %}{{ sender.title | escape }}, {% endif %}{{ brand_name | escape }}</p>
      {%- endif %}
      {% render 'ken/cta', label: 'Book 30 minutes', kind: 'booking', id: 'fallback-booking' %}
    </section>
  </div>
</main>
</body>
</html>
