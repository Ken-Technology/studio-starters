{%- comment -%}
Brand: brand.colors.primary is the staircase (the stages, the answer steps, the score), brand.colors.secondary the dark
closing field. Text on either takes a light or dark ink from the colour itself (CSS relative colour), so any brand colour
reads. brand.fonts.heading and .body replace Hanken Grotesk.
{%- endcomment -%}
{%- assign brand_p = brand.colors.primary | default: '#f6e016' -%}
{%- assign brand_s = brand.colors.secondary | default: '#0d2a1c' -%}
{%- assign font_head = brand.fonts.heading | default: 'Hanken Grotesk' -%}
{%- assign font_body = brand.fonts.body | default: 'Hanken Grotesk' -%}
{%- assign brand_name = brand.name | default: '' -%}
{%- assign peer = data.peers | first -%}
{%- assign has_peers = false -%}
{%- if peer.score_1 and peer.score_2 and peer.score_3 and peer.score_4 -%}{%- assign has_peers = true -%}{%- endif -%}
{%- assign qcount = data.questions | size -%}
{%- assign last_q = qcount | minus: 1 -%}
{%- assign sender_first = sender.name | split: ' ' | first -%}
{%- assign h_len = data.headline | size | at_least: 1 -%}
{%- assign h_v = 236.0 | divided_by: h_len | at_most: 8 | round: 2 -%}
{%- assign h_m = 300.0 | divided_by: h_len | at_most: 11 | round: 2 -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex">
<title>{{ data.headline | escape }}</title>
{%- if font_head == 'Hanken Grotesk' %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500&display=swap">
{%- else %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_head | url_encode }}&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_head | url_encode }}:wght@700&display=swap">
{%- endif %}
{%- if font_body != font_head %}
{%- if font_body == 'Hanken Grotesk' %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500&display=swap">
{%- else %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_body | url_encode }}&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_body | url_encode }}:wght@700&display=swap">
{%- endif %}
{%- endif %}
<script defer src="https://cdn.jsdelivr.net/npm/@alpinejs/csp@3/dist/cdn.min.js"></script>
<style>
:root{
  --p:{{ brand_p | escape }};
  --s:{{ brand_s | escape }};
  --on-p:#0d2a1c;
  --on-p:color(from var(--p) xyz-d65 clamp(0,(.18 - y) * 1000000,.9505) clamp(0,(.18 - y) * 1000000,1) clamp(0,(.18 - y) * 1000000,1.089));
  --on-s:#f7f7f7;
  --on-s:color(from var(--s) xyz-d65 clamp(0,(.18 - y) * 1000000,.9505) clamp(0,(.18 - y) * 1000000,1) clamp(0,(.18 - y) * 1000000,1.089));
  --fh:'{{ font_head | escape }}','Helvetica Neue',Arial,sans-serif;
  --fb:'{{ font_body | escape }}','Helvetica Neue',Arial,sans-serif;
  --bg:#f7f7f7;
  --surface:#e9eae8;
  --ink:#0d2a1c;
  --muted:#4f5d55;
  --m:clamp(1.125rem,3.4vw,2.75rem);
  --small:.875rem;
  --body:1.0625rem;
  --lead:clamp(1.1875rem,1.05rem + .5vw,1.5rem);
  --head:clamp(1.875rem,1.2rem + 2.6vw,3.5rem);
}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:var(--bg);color:var(--ink);font:400 var(--body)/1.5 var(--fb);-webkit-font-smoothing:antialiased;font-variant-numeric:tabular-nums;min-height:100svh}
h1,h2,h3{font-family:var(--fh);margin:0;font-weight:500;line-height:.98;letter-spacing:-.04em;text-wrap:balance}
p{margin:0}
button{font:inherit;cursor:pointer;color:inherit}
:focus-visible{outline:3px solid var(--ink);outline-offset:3px}
[tabindex="-1"]:focus{outline:none}
[x-cloak],.shut{display:none!important}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}

.top{display:flex;align-items:baseline;justify-content:space-between;gap:1rem;padding:1.25rem var(--m) 0;position:relative;z-index:2}
.brand{font-family:var(--fh);font-weight:500;font-size:1.125rem;letter-spacing:-.02em;min-width:0}
.logo{height:28px;width:auto;max-width:9rem;display:block}
.for{font-size:var(--small);color:var(--muted);text-align:right}

.wrap{padding:0 var(--m) 0}
.wrap.wide{padding-bottom:0}

/* Start: the staircase of the four stages */
.hero{display:grid;gap:2rem;padding:clamp(2rem,6vw,4rem) 0 0}
.copy{display:grid;gap:1.25rem;align-content:start}
.start h1{font-size:clamp(1.875rem,var(--hm),4rem)}
.lede{font-size:var(--lead);line-height:1.35;max-width:34ch}
.stair{display:block;width:100%;height:auto}
.stair rect{fill:var(--p)}
.stair text{font-family:var(--fh);font-weight:500;fill:var(--on-p);letter-spacing:-.02em}
.more{display:grid;gap:1.5rem;padding:clamp(2.5rem,6vw,4.5rem) 0 clamp(3rem,6vw,5rem)}
.more h2{font-size:var(--head)}
.dims{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:1fr 1fr;gap:1.25rem 1.5rem}
.dims b{display:block;font-family:var(--fh);font-weight:500;font-size:var(--lead);letter-spacing:-.02em;line-height:1.2}
.dims span{display:block;color:var(--muted);line-height:1.4;margin-top:.2rem}
.aside{max-width:52ch;font-size:var(--lead);line-height:1.4}
.nojs{padding:.8rem 1rem;background:var(--surface);max-width:46ch}
.startrow{display:flex;flex-wrap:wrap;align-items:center;gap:.5rem 1.5rem;margin-top:.5rem}
.startrow .ken-cta{color:var(--ink)!important;font-size:var(--body);min-height:44px;display:inline-flex;align-items:center;text-underline-offset:.2em}

.btn{display:inline-flex;align-items:center;justify-content:center;min-height:54px;background:var(--ink);color:var(--bg);font-family:var(--fh);font-weight:500;font-size:1.1875rem;letter-spacing:-.01em;padding:.9rem 1.6rem;border:0}
.btn:hover{background:var(--p);color:var(--on-p)}
.ghost{background:none;border:0;color:var(--ink);padding:.5rem 0;min-height:44px;font-size:var(--body);text-decoration:underline;text-underline-offset:.2em}

/* Questions */
.qs{padding:clamp(2rem,5vw,3.5rem) 0 clamp(3rem,6vw,5rem);max-width:64rem}
.prog{display:flex;align-items:flex-end;gap:4px;height:40px;margin-bottom:1.75rem;max-width:22rem}
.prog i{flex:1;background:var(--surface)}
{%- for i in (0..last_q) %}
.prog i:nth-child({{ i | plus: 1 }}){height:{{ i | plus: 1 | times: 100.0 | divided_by: qcount | round: 1 }}%}
{%- endfor %}
.prog i.done{background:var(--p)}
.prog i.now{background:var(--ink)}
.meta{display:flex;justify-content:space-between;align-items:baseline;gap:1rem;font-size:var(--small);color:var(--muted);margin-bottom:1rem}
.meta b{font-weight:500;color:var(--ink)}
.q h2{font-size:var(--head);margin-bottom:1.75rem;max-width:22ch}
.opts{list-style:none;margin:0;padding:0;display:grid;gap:.5rem}
.opt{display:grid;grid-template-columns:3rem minmax(0,1fr);gap:1rem;align-items:center;width:100%;min-height:64px;text-align:left;background:var(--surface);border:0;padding:.9rem 1.1rem .9rem .9rem}
.opt:hover{background:color-mix(in srgb,var(--p) 30%,var(--surface))}
.opt .n{display:block;width:3rem;height:2.25rem}
.opt .n svg{display:block;width:100%;height:100%}
.opt .n rect{fill:color-mix(in srgb,var(--ink) 16%,var(--surface))}
.opt .n rect.on{fill:var(--ink)}
.opt b{display:block;font-family:var(--fh);font-weight:500;font-size:1.1875rem;letter-spacing:-.015em;line-height:1.25}
.opt span.h{display:block;font-size:.9375rem;color:var(--muted);margin-top:.15rem;line-height:1.4}
.opt[aria-pressed=true]{background:var(--p);color:var(--on-p)}
.opt[aria-pressed=true] span.h{color:inherit}
.opt[aria-pressed=true] .n rect{fill:color-mix(in srgb,var(--on-p) 25%,var(--p))}
.opt[aria-pressed=true] .n rect.on{fill:var(--on-p)}
.scale{display:flex;justify-content:space-between;gap:1rem;font-size:var(--small);color:var(--muted);margin:.75rem 0 0}
.qnav{display:flex;justify-content:space-between;align-items:center;margin-top:1.5rem}
.qnav .meta{margin:0}

/* Result */
.res{padding:clamp(2rem,5vw,3.5rem) 0 0}
.res .stage-line{font-size:var(--body);color:var(--muted);margin-bottom:.75rem}
.res h1{font-size:clamp(2.25rem,1.2rem + 4.4vw,5.5rem);margin-bottom:1rem;max-width:18ch}
.res .score{font-size:var(--lead);line-height:1.4;max-width:46ch}
.res .score b{font-family:var(--fh);font-weight:500}
.ladder{list-style:none;margin:clamp(2rem,5vw,3.5rem) calc(var(--m) * -1) 0;padding:0;display:grid;grid-template-columns:repeat(4,1fr);align-items:end;gap:0}
.ladder li{position:relative;display:flex;align-items:flex-end;padding:.75rem var(--m) .9rem;background:var(--surface);font-family:var(--fh);font-weight:500;font-size:clamp(1rem,.7rem + 1.2vw,1.75rem);letter-spacing:-.02em;line-height:1.1;color:var(--ink)}
.ladder li:nth-child(1){height:4.5rem}
.ladder li:nth-child(2){height:7.5rem}
.ladder li:nth-child(3){height:10.5rem}
.ladder li:nth-child(4){height:13.5rem}
.ladder li.done{background:color-mix(in srgb,var(--p) 38%,var(--surface))}
.ladder li.now{background:var(--p);color:var(--on-p)}
.ladder li.peer::after{content:'Peers';position:absolute;left:var(--m);top:.7rem;font-family:var(--fb);font-weight:500;font-size:var(--small);letter-spacing:0;padding:.1rem .5rem;background:var(--ink);color:var(--bg)}

.areas{display:grid;gap:2rem;padding:clamp(2.5rem,6vw,4.5rem) 0}
.areas h2,.steps h2,.cta h2{font-size:var(--head)}
.radar{width:100%;max-width:440px;height:auto;display:block}
.radar .ring{fill:none;stroke:color-mix(in srgb,var(--ink) 14%,var(--bg));stroke-width:1}
.radar .axis{stroke:color-mix(in srgb,var(--ink) 14%,var(--bg));stroke-width:1}
.radar .peer{fill:none;stroke:var(--ink);stroke-width:2;stroke-dasharray:5 5;stroke-linejoin:round}
.radar .me{fill:var(--p);fill-opacity:.85;stroke:var(--ink);stroke-width:2.5;stroke-linejoin:round}
.radar .dot{fill:var(--ink)}
.radar text{font-family:var(--fb);font-size:14px;fill:var(--muted)}
.radar text.lab{fill:var(--ink);font-weight:500;font-size:15px}
.legend{display:flex;gap:.3rem 1.4rem;flex-wrap:wrap;font-size:var(--small);color:var(--muted);margin-top:.75rem}
.legend i{display:inline-block;width:1rem;height:1rem;background:var(--p);vertical-align:-.15rem;margin-right:.45rem}
.legend i.pr{background:none;height:0;width:1.5rem;border-top:2px dashed var(--ink);vertical-align:.2rem}
.dtab{width:100%;border-collapse:collapse}
.dtab th{text-align:left;font-weight:400;color:var(--muted);font-size:var(--small);padding:0 0 .6rem}
.dtab th.r,.dtab td.r{text-align:right;white-space:nowrap}
.dtab td{padding:.8rem 0;border-top:1px solid color-mix(in srgb,var(--ink) 14%,var(--bg));font-family:var(--fh);font-size:var(--lead);font-weight:500;letter-spacing:-.015em}
.dtab td.pr{color:var(--muted)}
.dtab .delta{font-family:var(--fb);font-size:var(--small);font-weight:500;margin-left:.45rem;padding:.1rem .4rem;background:var(--p);color:var(--on-p);letter-spacing:0}
.dtab .delta.neg{background:var(--surface);color:var(--ink)}

/* Next moves climb like steps on a wide screen */
.steps{padding:clamp(2.5rem,6vw,4.5rem) 0;background:var(--surface);margin:0 calc(var(--m) * -1);padding-left:var(--m);padding-right:var(--m)}
.steps h2{margin-bottom:clamp(1.5rem,3vw,2.5rem)}
.steps ol{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:1rem}
.steps li{display:grid;grid-template-columns:3.25rem minmax(0,1fr);gap:1rem;max-width:46rem;padding:1.1rem 1.25rem 1.2rem 1rem;background:var(--bg)}
.steps .num{display:block;font-family:var(--fh);font-weight:500;font-size:2.75rem;line-height:.9;letter-spacing:-.05em;color:var(--ink)}
.steps b{display:block;font-family:var(--fh);font-weight:500;font-size:var(--lead);letter-spacing:-.015em;line-height:1.2}
.steps b small{display:block;font-family:var(--fb);font-weight:400;font-size:var(--small);letter-spacing:0;color:var(--muted);margin-top:.3rem}
.steps p{margin-top:.45rem}

.cta{background:var(--s);color:var(--on-s);margin:0 calc(var(--m) * -1);padding:clamp(3rem,8vw,6.5rem) var(--m);display:grid;gap:1.25rem;align-content:end}
.cta p{font-size:var(--lead);line-height:1.4;max-width:40ch}
.who b{display:block;font-weight:500}
.cta .ken-cta{display:inline-flex!important;align-items:center;justify-content:center;min-height:64px;padding:1rem 2rem!important;border-radius:0!important;background:var(--p)!important;color:var(--on-p)!important;font-family:var(--fh);font-weight:500!important;font-size:clamp(1.375rem,1rem + 1.6vw,2.25rem);letter-spacing:-.03em;text-decoration:none;width:fit-content}
.cta .ken-cta:hover{background:var(--on-s)!important;color:var(--s)!important}
.cta .ken-cta:focus-visible{outline:3px solid var(--on-s);outline-offset:4px}
.foot{font-size:var(--small);color:var(--muted);padding:1.5rem 0 0;max-width:60ch}
.foot + .foot{padding:.5rem 0 2.5rem}

@media (min-width:760px){
  .top{padding-top:1.6rem}
  .hero{grid-template-columns:minmax(0,1fr) minmax(0,1.15fr);grid-template-rows:auto 1fr;column-gap:clamp(2rem,4vw,4rem);row-gap:clamp(1.5rem,3vw,2.5rem);min-height:calc(100svh - 4.5rem);padding-bottom:0}
  .start h1{font-size:clamp(2.5rem,var(--hv),8.5rem);grid-column:1 / -1}
  .copy{padding-bottom:3rem}
  .stair{align-self:end;max-height:68svh}
  .more{grid-template-columns:minmax(0,1fr) minmax(0,1fr);column-gap:clamp(2rem,4vw,4rem);align-items:start}
  .more h2{grid-column:1 / -1}
  .dims{grid-row:2}
  .aside{grid-row:2}
  .opts{grid-template-columns:1fr 1fr}
  .areas{grid-template-columns:minmax(0,1fr) minmax(0,1.1fr);column-gap:clamp(2rem,5vw,5rem);align-items:start}
  .areas h2{grid-column:1 / -1}
  .ladder li{padding-bottom:1.1rem}
  .ladder li.peer::after{top:.9rem}
  .steps li{margin-left:calc(var(--r, 0) * clamp(2rem,9vw,9rem))}
  .cta{grid-template-columns:minmax(0,1.3fr) minmax(0,1fr);column-gap:4rem;align-items:end}
  .cta h2{grid-row:1 / span 3}
}

/* The one moment: the four steps rise into place on load */
@media (prefers-reduced-motion:no-preference){
  @keyframes rise{from{transform:translateY(100%)}to{transform:none}}
  .stair .st{transform-box:fill-box;animation:rise .8s cubic-bezier(.2,.75,.2,1) both}
  .stair .st:nth-of-type(2){animation-delay:.08s}
  .stair .st:nth-of-type(3){animation-delay:.16s}
  .stair .st:nth-of-type(4){animation-delay:.24s}
  .opt,.btn{transition:background-color .12s,color .12s}
}
</style>
</head>
<body>
<div class="app" x-data="{ q: -1, a: [{% for i in (1..qcount) %}0{% unless forloop.last %}, {% endunless %}{% endfor %}], s: [0, 0, 0, 0], o: 0, st: 0, na: 0{% if has_peers %}, p: [{{ peer.score_1 | plus: 0 | escape }}, {{ peer.score_2 | plus: 0 | escape }}, {{ peer.score_3 | plus: 0 | escape }}, {{ peer.score_4 | plus: 0 | escape }}], po: 0, pst: 0, ah: 0{% endif %} }" style="--hv:{{ h_v }}vw;--hm:{{ h_m }}vw">
{%- comment -%} Derived numbers: the CSP build has no getters, so each one is an x-effect that writes its value back into the state. {%- endcomment %}
{%- for d in (1..4) %}
{%- assign terms = '' -%}
{%- assign cnt = 0 -%}
{%- for qu in data.questions -%}
{%- if qu.dimension == d -%}
{%- assign cnt = cnt | plus: 1 -%}
{%- capture term -%}a[{{ forloop.index0 }}]{%- endcapture -%}
{%- if terms == '' -%}{%- assign terms = term -%}{%- else -%}{%- assign terms = terms | append: ' + ' | append: term -%}{%- endif -%}
{%- endif -%}
{%- endfor %}
<i hidden x-effect="s[{{ d | minus: 1 }}] = {% if cnt > 0 %}({{ terms }}) / {{ cnt }}{% else %}0{% endif %}"></i>
{%- endfor %}
<i hidden x-effect="o = (s[0] + s[1] + s[2] + s[3]) / 4"></i>
<i hidden x-effect="st = (o >= 1.75) + (o >= 2.5) + (o >= 3.25)"></i>
<i hidden x-effect="na = {% for i in (0..last_q) %}(a[{{ i }}] > 0){% unless forloop.last %} + {% endunless %}{% endfor %}"></i>
{%- if has_peers %}
<i hidden x-effect="po = (p[0] + p[1] + p[2] + p[3]) / 4 + 0.001"></i>
<i hidden x-effect="pst = (po >= 1.75) + (po >= 2.5) + (po >= 3.25)"></i>
<i hidden x-effect="ah = (s[0] > p[0]) + (s[1] > p[1]) + (s[2] > p[2]) + (s[3] > p[3])"></i>
{%- endif %}

<header class="top" x-effect="(q > -2) && $el.scrollIntoView()">
  <div class="brand">{% if brand.logo_url %}<img class="logo" src="{{ brand.logo_url | escape }}" alt="{{ brand_name | default: 'Logo' | escape }}">{% elsif brand_name != '' %}<span>{{ brand_name | escape }}</span>{% endif %}</div>
  <p class="for">{% if person.first_name %}For {{ person.first_name | escape }}{% if person.last_name %} {{ person.last_name | escape }}{% endif %}, {{ account.name | escape }}{% else %}Prepared for {{ account.name | escape }}{% endif %}</p>
</header>

<main class="wrap" :class="q === {{ qcount }} ? 'wide' : ''">
  <div class="deck none" :class="(q < 0 || q > {{ last_q }}) ? 'none' : q === {{ last_q }} ? 'last' : ''">
  <div class="card">

    <!-- Start -->
    <section class="start" data-section="start" x-show="q < 0">
      <div class="hero">
        <h1>{{ data.headline | escape }}</h1>
        <div class="copy">
          <p class="lede">Eight questions across four areas, about three minutes. At the end you see {% if has_peers %}where {{ account.name | escape }} stands next to {{ peer.assessments | escape }} {{ peer.peer_group | escape }}{% else %}the score for each area and the stage {{ account.name | escape }} is at{% endif %}, and the three moves that usually come next.</p>
          <noscript><p class="nojs">The questions need JavaScript. Turn it on and reload, or book a time and we will go through them together.</p></noscript>
          <div class="startrow">
            <button class="btn" type="button" x-cloak @click="q = 0">Start the assessment</button>
            {% render 'ken/cta', label: 'Prefer to talk it through? Book 30 minutes', kind: 'booking', variant: 'link', id: 'start-booking' %}
          </div>
        </div>
        <svg class="stair" viewBox="0 0 800 520" preserveAspectRatio="xMaxYMax meet" role="img" aria-label="The four stages, from {{ data.stages | first | escape }} to {{ data.stages | last | escape }}">
          {%- for name in data.stages %}
          {%- assign sx = forloop.index0 | times: 200 %}
          {%- assign sh = forloop.index | times: 130 %}
          {%- assign sy = 520 | minus: sh %}
          <rect class="st" x="{{ sx }}" y="{{ sy }}" width="201" height="{{ sh }}"/>
          <text x="{{ sx | plus: 18 }}" y="{{ sy | plus: 46 }}" font-size="36">{{ name | escape }}</text>
          {%- endfor %}
        </svg>
      </div>
      <div class="more">
        <h2>What the eight questions cover</h2>
        <ul class="dims">
          {%- for dim in data.dimensions %}
          <li><b>{{ dim.name | escape }}</b><span>{{ dim.blurb | escape }}</span></li>
          {%- endfor %}
        </ul>
        <p class="aside">{{ data.intro | escape }} Pick the closest option. Honesty matters more than precision, and nothing here is scored against you.</p>
      </div>
    </section>

    <!-- Questions -->
    <section class="qs" data-section="questions" x-cloak :class="q >= 0 && q < {{ qcount }} ? '' : 'shut'">
      <div class="prog" aria-hidden="true">
        {%- for i in (0..last_q) %}<i :class="q > {{ i }} ? 'done' : q === {{ i }} ? 'now' : ''"></i>{% endfor %}
      </div>
      {%- for qu in data.questions %}
      {%- assign di = qu.dimension | minus: 1 %}
      {%- assign dim = data.dimensions[di] %}
      {%- assign qi = forloop.index0 %}
      <div class="q" x-cloak :class="q === {{ qi }} ? '' : 'shut'">
        <div class="meta"><span>Question <b>{{ forloop.index }}</b> of {{ qcount }}</span><span>{{ dim.name | escape }}</span></div>
        <h2 tabindex="-1" x-effect="(q === {{ qi }}) && $el.focus({ preventScroll: true })">{{ qu.text | escape }}</h2>
        <ul class="opts">
          {%- for ans in qu.answers %}
          {%- assign lvl = forloop.index %}
          <li><button class="opt" type="button" aria-pressed="false" :aria-pressed="a[{{ qi }}] === {{ forloop.index }}" @click="(a[{{ qi }}] = {{ forloop.index }}) && (q = {{ qi | plus: 1 }})"><span class="n" aria-hidden="true"><svg viewBox="0 0 48 36">{% for k in (1..4) %}<rect{% if k <= lvl %} class="on"{% endif %} x="{{ k | minus: 1 | times: 12 }}" y="{{ 4 | minus: k | times: 9 }}" width="11" height="{{ k | times: 9 }}"/>{% endfor %}</svg></span><span><span class="sr">{{ forloop.index }}. </span><b>{{ ans.label | escape }}</b><span class="h">{{ ans.hint | escape }}</span></span></button></li>
          {%- endfor %}
        </ul>
      </div>
      {%- endfor %}
      <div class="scale" aria-hidden="true"><span>One step, where most teams start</span><span>Four steps, as good as it gets</span></div>
      <div class="qnav"><button class="ghost" type="button" :style="q === 0 ? 'visibility:hidden' : ''" @click="q = q - 1">Back</button><span class="meta"><span x-text="na + ' answered'"></span></span></div>
    </section>

    <!-- Result -->
    <div x-cloak :class="q === {{ qcount }} ? '' : 'shut'">
    <section class="res" data-section="result">
      <p class="stage-line">{{ account.name | escape }}{% if person.first_name %}, answered by {{ person.first_name | escape }}{% if person.last_name %} {{ person.last_name | escape }}{% endif %}{% else %}, self-assessed{% endif %}</p>
      <h1 tabindex="-1" x-effect="(q === {{ qcount }}) && $el.focus({ preventScroll: true })">{{ account.name | escape }} is at the
        {%- for name in data.stages -%}<span x-cloak x-show="st === {{ forloop.index0 }}"> {{ name | escape }}</span>{%- endfor %} stage</h1>
      <p class="score"><b x-text="o.toFixed(1)"></b> of 4 overall.
        {%- if has_peers %} Peers average <b x-text="po.toFixed(1)"></b>, which puts {{ account.name | escape }} <span x-cloak x-show="ah === 4">ahead in all four areas</span><span x-cloak x-show="ah === 3">ahead in three of the four areas</span><span x-cloak x-show="ah === 2">ahead in two of the four areas</span><span x-cloak x-show="ah === 1">ahead in one of the four areas</span><span x-cloak x-show="ah === 0">level with or behind peers in every area</span>.{% endif %}</p>
      <ol class="ladder">
        {%- for name in data.stages %}
        <li :class="{ done: st > {{ forloop.index0 }}, now: st === {{ forloop.index0 }}{% if has_peers %}, peer: pst === {{ forloop.index0 }}{% endif %} }">{{ name | escape }}</li>
        {%- endfor %}
      </ol>

      <div class="areas">
        <h2>Area by area</h2>
        <div>
          <svg class="radar" viewBox="0 0 360 290" role="img" aria-label="Radar chart of the four area scores, from 0 to 4">
            {%- for k in (1..4) %}
            {%- assign k21 = k | times: 21 %}
            <polygon class="ring" points="180,{{ 150 | minus: k21 }} {{ 180 | plus: k21 }},150 180,{{ 150 | plus: k21 }} {{ 180 | minus: k21 }},150"/>
            {%- endfor %}
            <line class="axis" x1="180" y1="66" x2="180" y2="234"/>
            <line class="axis" x1="96" y1="150" x2="264" y2="150"/>
            <polygon class="me" :points="'180,' + (150 - 21 * s[0]) + ' ' + (180 + 21 * s[1]) + ',150 180,' + (150 + 21 * s[2]) + ' ' + (180 - 21 * s[3]) + ',150'"/>
            {%- if has_peers %}
            <polygon class="peer" :points="'180,' + (150 - 21 * p[0]) + ' ' + (180 + 21 * p[1]) + ',150 180,' + (150 + 21 * p[2]) + ' ' + (180 - 21 * p[3]) + ',150'"/>
            {%- endif %}
            <circle class="dot" r="4.5" cx="180" :cy="150 - 21 * s[0]"/>
            <circle class="dot" r="4.5" :cx="180 + 21 * s[1]" cy="150"/>
            <circle class="dot" r="4.5" cx="180" :cy="150 + 21 * s[2]"/>
            <circle class="dot" r="4.5" :cx="180 - 21 * s[3]" cy="150"/>
            <text class="lab" x="180" y="40" text-anchor="middle">{{ data.dimensions[0].name | escape }}</text>
            <text x="180" y="56" text-anchor="middle" x-text="s[0].toFixed(1) + ' of 4'"></text>
            <text class="lab" x="274" y="148" text-anchor="start">{{ data.dimensions[1].name | escape }}</text>
            <text x="274" y="164" text-anchor="start" x-text="s[1].toFixed(1) + ' of 4'"></text>
            <text class="lab" x="180" y="254" text-anchor="middle">{{ data.dimensions[2].name | escape }}</text>
            <text x="180" y="270" text-anchor="middle" x-text="s[2].toFixed(1) + ' of 4'"></text>
            <text class="lab" x="86" y="148" text-anchor="end">{{ data.dimensions[3].name | escape }}</text>
            <text x="86" y="164" text-anchor="end" x-text="s[3].toFixed(1) + ' of 4'"></text>
          </svg>
          <div class="legend"><span><i></i>{{ account.name | escape }}</span>{% if has_peers %}<span><i class="pr"></i>Peers, {{ peer.assessments | escape }} companies</span>{% endif %}</div>
        </div>
        <table class="dtab">
          <thead><tr><th>Area</th><th class="r">Score</th>{% if has_peers %}<th class="r">Peers</th>{% endif %}</tr></thead>
          <tbody>
            {%- for dim in data.dimensions %}
            {%- assign di = forloop.index0 %}
            <tr><td>{{ dim.name | escape }}</td><td class="r"><span x-text="s[{{ di }}].toFixed(1)"></span>{% if has_peers %}<span class="delta" :class="s[{{ di }}] < p[{{ di }}] ? 'neg' : ''" x-text="(s[{{ di }}] >= p[{{ di }}] ? '+' : '') + (s[{{ di }}] - p[{{ di }}]).toFixed(1)"></span>{% endif %}</td>{% if has_peers %}<td class="r pr" x-text="p[{{ di }}].toFixed(1)"></td>{% endif %}</tr>
            {%- endfor %}
          </tbody>
        </table>
      </div>
    </section>

    <section class="steps" data-section="steps">
      <h2>Three moves that usually come next</h2>
      <ol>
        {%- for step in data.steps %}
        {%- assign di = forloop.index0 %}
        {%- assign dim = data.dimensions[di] %}
        {%- assign rank = '' %}
        {%- for e in (0..3) %}
        {%- if e != di %}
        {%- if e < di %}{% capture t %}(s[{{ e }}] <= s[{{ di }}]){% endcapture %}{% else %}{% capture t %}(s[{{ e }}] < s[{{ di }}]){% endcapture %}{% endif %}
        {%- if rank == '' %}{% assign rank = t %}{% else %}{% assign rank = rank | append: ' + ' | append: t %}{% endif %}
        {%- endif %}
        {%- endfor %}
        <li x-cloak x-data="{ r: 0 }" x-effect="r = {{ rank }}" x-show="r < 3" :style="'order:' + r + ';--r:' + r">
          <span class="num" aria-hidden="true" x-text="r + 1"></span>
          <div><b>{{ step.title | escape }}<small>{{ dim.name | escape }}, <span x-text="s[{{ di }}].toFixed(1)"></span> of 4</small></b><p>{{ step.body | escape }}</p></div>
        </li>
        {%- endfor %}
      </ol>
    </section>

    <section class="cta" data-section="book">
      <h2>Walk through the results{% if sender_first %} with {{ sender_first | escape }}{% endif %}</h2>
      <p>Thirty minutes. We go through where {{ account.name | escape }} scored lowest and what the first move would take.</p>
      {%- if sender.name %}
      <p class="who"><b>{{ sender.name | escape }}</b>{% if sender.title %}{{ sender.title | escape }}{% if brand_name != '' %}, {% endif %}{% endif %}{{ brand_name | escape }}</p>
      {%- endif %}
      <div>{% render 'ken/cta', label: 'Book 30 minutes', kind: 'booking', id: 'result-booking' %}</div>
    </section>
    {%- if has_peers %}
    <p class="foot">Peer figures come from {{ peer.assessments | escape }} assessments by {{ peer.peer_group | escape }}.{% if peer.source and peer.source != '' %} {{ peer.source | escape }}.{% endif %} Scores are self-reported.</p>
    {%- endif %}
    <p class="foot"><button class="ghost" type="button" @click="q = 0">Change my answers</button></p>
    </div>

  </div>
  </div>
</main>
</div>
</body>
</html>
