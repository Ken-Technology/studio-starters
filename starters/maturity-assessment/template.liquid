{%- assign brand_p = brand.colors.primary | default: '#2a4bd7' -%}
{%- assign brand_s = brand.colors.secondary | default: '#0e1530' -%}
{%- assign font_head = brand.fonts.heading | default: 'Inter Tight' -%}
{%- assign font_body = brand.fonts.body | default: 'Inter' -%}
{%- assign brand_name = brand.name | default: 'Northbeam' -%}
{%- assign head_q = font_head | replace: ' ', '+' -%}
{%- assign body_q = font_body | replace: ' ', '+' -%}
{%- if font_head == 'Inter Tight' -%}{%- assign head_w = '500;600;700' -%}{%- else -%}{%- assign head_w = '400;700' -%}{%- endif -%}
{%- if font_body == 'Inter' -%}{%- assign body_w = '400;500;600' -%}{%- else -%}{%- assign body_w = '400;700' -%}{%- endif -%}
{%- assign peer = data.peers | first -%}
{%- assign has_peers = false -%}
{%- if peer.score_1 and peer.score_2 and peer.score_3 and peer.score_4 -%}{%- assign has_peers = true -%}{%- endif -%}
{%- assign qcount = data.questions | size -%}
{%- assign last_q = qcount | minus: 1 -%}
{%- assign sender_first = sender.name | split: ' ' | first -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex">
<title>{{ data.headline | escape }}</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ head_q | escape }}:wght@{{ head_w }}&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ body_q | escape }}:wght@{{ body_w }}&display=swap">
<script defer src="https://cdn.jsdelivr.net/npm/@alpinejs/csp@3/dist/cdn.min.js"></script>
<style>
:root{
  --p:{{ brand_p | escape }};
  --s:{{ brand_s | escape }};
  --fh:'{{ font_head | escape }}',ui-sans-serif,system-ui,-apple-system,'Segoe UI',sans-serif;
  --fb:'{{ font_body | escape }}',ui-sans-serif,system-ui,-apple-system,'Segoe UI',sans-serif;
  --ink:color-mix(in srgb,var(--s) 70%,#000);
  --text:color-mix(in srgb,var(--ink) 84%,#fff);
  --mute:color-mix(in srgb,var(--ink) 58%,#fff);
  --line:color-mix(in srgb,var(--ink) 14%,#fff);
  --hair:color-mix(in srgb,var(--ink) 8%,#fff);
  --stage:color-mix(in srgb,var(--p) 6%,#fff);
  --tint:color-mix(in srgb,var(--p) 10%,#fff);
  --p-deep:color-mix(in srgb,var(--p) 80%,#000);
  --peer:color-mix(in srgb,var(--ink) 62%,#fff);
}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:var(--stage);color:var(--text);font:16px/1.55 var(--fb);-webkit-font-smoothing:antialiased;font-variant-numeric:tabular-nums;min-height:100vh}
h1,h2,h3{font-family:var(--fh);color:var(--ink);margin:0;line-height:1.12;letter-spacing:-.015em;font-weight:600;text-wrap:balance}
p{margin:0}
button{font:inherit;cursor:pointer}
:focus-visible{outline:2px solid var(--p);outline-offset:3px}
[tabindex="-1"]:focus{outline:none}
[x-cloak]{display:none!important}

.top{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:1rem 1.25rem}
.brand{display:flex;align-items:center;gap:.6rem;font-family:var(--fh);font-weight:600;color:var(--ink);min-width:0}
.logo{height:26px;width:auto;max-width:120px;display:block;flex:none}
.mark{width:26px;height:26px;border-radius:7px;background:var(--p);color:#fff;display:grid;place-items:center;font:700 14px/1 var(--fh);flex:none}
.for{font-size:.85rem;color:var(--mute);text-align:right}

.wrap{max-width:46rem;margin:0 auto;padding:.5rem 1rem 5rem}

/* The deck: a white card with two faint cards behind it, one per unanswered group */
.deck{position:relative;margin-top:.75rem}
.deck::before,.deck::after{content:'';position:absolute;left:10px;right:10px;top:-8px;height:24px;border-radius:18px 18px 0 0;background:#fff;border:1px solid var(--line);z-index:0;opacity:.7}
.deck::after{left:20px;right:20px;top:-15px;opacity:.4}
.deck.last::before,.deck.last::after,.deck.none::before,.deck.none::after{display:none}
.card{position:relative;z-index:1;background:#fff;border:1px solid var(--line);border-radius:18px;padding:1.4rem 1.25rem 1.6rem;box-shadow:0 14px 40px color-mix(in srgb,var(--ink) 10%,transparent)}

/* progress */
.prog{display:grid;grid-template-columns:repeat(8,1fr);gap:4px;margin-bottom:1.2rem}
.prog i{height:4px;border-radius:2px;background:var(--line)}
.prog i.done{background:var(--p)}
.prog i.now{background:color-mix(in srgb,var(--p) 45%,#fff)}
.meta{display:flex;justify-content:space-between;align-items:baseline;gap:1rem;font-size:.85rem;color:var(--mute);margin-bottom:.9rem}
.meta b{font-weight:600;color:var(--p-deep)}

/* start */
.start h1{font-size:2rem;margin:.2rem 0 .9rem}
.start .lede{font-size:1.05rem;max-width:34rem}
.start .lede b{font-weight:600;color:var(--ink)}
.dims{list-style:none;margin:1.4rem 0;padding:0;display:grid;grid-template-columns:1fr;gap:.6rem}
.dims li{display:flex;gap:.6rem;align-items:flex-start;font-size:.92rem;padding:.7rem .8rem;border:1px solid var(--hair);border-radius:12px;background:var(--stage)}
.dims svg{width:18px;height:18px;flex:none;margin-top:.15rem;color:var(--p)}
.dims b{display:block;color:var(--ink);font-weight:600}
.dims span{color:var(--mute);font-size:.84rem}
.aside{font-size:.92rem;color:var(--mute);max-width:34rem;margin-bottom:1.4rem}
.startrow{display:flex;flex-wrap:wrap;align-items:center;gap:.4rem 1.4rem}
.startrow .ken-cta{color:var(--mute)!important;font-size:.9rem;min-height:44px;display:inline-flex;align-items:center;text-underline-offset:3px}
.nojs{margin:0 0 1rem;padding:.7rem .9rem;border-radius:10px;background:var(--tint);font-size:.92rem;color:var(--ink)}

.btn{display:inline-flex;align-items:center;justify-content:center;gap:.5rem;min-height:48px;background:var(--p);color:#fff;text-decoration:none;font-weight:600;padding:.9rem 1.5rem;border-radius:10px;border:0;width:fit-content}
.btn:hover{background:var(--p-deep)}
.ghost{background:none;border:0;color:var(--mute);padding:.5rem 0;min-height:44px;font-size:.9rem;text-decoration:underline;text-underline-offset:3px}
.ghost:hover{color:var(--ink)}

/* question */
.q h2{font-size:1.5rem;margin-bottom:1.2rem;max-width:30ch}
.opts{list-style:none;margin:0;padding:0;display:grid;gap:.6rem}
.opt{display:grid;grid-template-columns:2rem minmax(0,1fr);gap:.8rem;align-items:start;width:100%;min-height:44px;text-align:left;background:#fff;border:1.5px solid var(--line);border-radius:12px;padding:.85rem .9rem;color:var(--text);transition:border-color .12s,background .12s}
.opt:hover{border-color:color-mix(in srgb,var(--p) 55%,var(--line))}
.opt .n{width:2rem;height:2rem;border-radius:50%;border:1.5px solid var(--line);display:grid;place-items:center;font-family:var(--fh);font-weight:600;color:var(--mute);font-size:.95rem}
.opt b{display:block;font-weight:600;color:var(--ink)}
.opt span{display:block;font-size:.88rem;color:var(--mute);margin-top:.1rem}
.opt .n{margin-top:0}
.opt[aria-pressed=true]{border-color:var(--p);background:var(--tint)}
.opt[aria-pressed=true] .n{background:var(--p);border-color:var(--p);color:#fff}
.scale{display:flex;justify-content:space-between;gap:1rem;font-size:.78rem;color:var(--mute);margin:.5rem .2rem 0}
.qnav{display:flex;justify-content:space-between;align-items:center;margin-top:1.4rem;padding-top:1rem;border-top:1px solid var(--hair)}
.qnav .meta{margin:0}

/* result */
.res .stage-line{font-size:.9rem;color:var(--mute);margin-bottom:.3rem}
.res h1{font-size:2rem;margin-bottom:.4rem}
.res h1 em{font-style:normal;color:var(--p)}
.res .score{font-size:1.05rem;color:var(--text);margin-bottom:1.4rem}
.res .score b{font-family:var(--fh);font-weight:600;color:var(--ink)}
.ladder{list-style:none;margin:0 0 1.8rem;padding:0;display:grid;grid-template-columns:repeat(4,1fr);gap:4px}
.ladder li{position:relative;padding-top:.6rem;font-size:.8rem;color:var(--mute)}
.ladder li::before{content:'';display:block;height:6px;border-radius:3px;background:var(--line);margin-bottom:.45rem}
.ladder li.done::before{background:color-mix(in srgb,var(--p) 40%,#fff)}
.ladder li.now::before{background:var(--p)}
.ladder li.now{color:var(--ink);font-weight:600}
.ladder li.peer::after{content:'Peers';position:absolute;top:-.55rem;left:50%;transform:translateX(-50%);font-size:.7rem;font-weight:400;color:var(--mute);background:#fff;padding:0 .25rem}

.radar-wrap{display:grid;gap:1.2rem;margin:0 0 1.6rem}
.radar{width:100%;max-width:400px;height:auto;display:block;margin:0 auto}
.radar .ring{fill:none;stroke:var(--hair);stroke-width:1}
.radar .ring.outer{stroke:var(--line)}
.radar .axis{stroke:var(--hair);stroke-width:1}
.radar .peer{fill:none;stroke:var(--peer);stroke-width:2;stroke-dasharray:5 5;stroke-linejoin:round}
.radar .me{fill:color-mix(in srgb,var(--p) 22%,transparent);stroke:var(--p);stroke-width:2.5;stroke-linejoin:round}
.radar .dot{fill:#fff;stroke:var(--p);stroke-width:2.5}
.radar text{font-family:var(--fb);font-size:13px;fill:var(--mute)}
.radar text.lab{fill:var(--ink);font-weight:600;font-size:14px}
.legend{display:flex;gap:.3rem 1.2rem;flex-wrap:wrap;font-size:.85rem;color:var(--mute);justify-content:center}
.legend i{display:inline-block;width:22px;height:0;border-top:3px solid var(--p);vertical-align:middle;margin-right:.4rem}
.legend i.pr{border-top:2px dashed var(--peer)}

.dtab{width:100%;border-collapse:collapse;font-size:.95rem}
.dtab th{text-align:left;font-weight:400;color:var(--mute);font-size:.8rem;padding:0 0 .5rem;border-bottom:1px solid var(--line)}
.dtab th.r,.dtab td.r{text-align:right;white-space:nowrap}
.dtab td{padding:.65rem 0;border-bottom:1px solid var(--hair);color:var(--ink)}
.dtab td.r{font-family:var(--fh);font-weight:600}
.dtab td.pr{color:var(--mute);font-family:var(--fh);font-weight:500}
.dtab .delta{font-family:var(--fb);font-size:.78rem;font-weight:600;color:var(--p-deep);margin-left:.35rem}
.dtab .delta.neg{color:var(--mute)}

.steps{margin:1.8rem 0 0;padding-top:1.4rem;border-top:1px solid var(--line)}
.steps h2{font-size:1.25rem;margin-bottom:.9rem}
.steps ol{list-style:none;margin:0;padding:0;display:grid;gap:.9rem}
.steps li{display:grid;grid-template-columns:2.1rem minmax(0,1fr);gap:.8rem}
.steps .num{width:2.1rem;height:2.1rem;border-radius:50%;background:var(--ink);color:#fff;display:grid;place-items:center;font-family:var(--fh);font-weight:600;font-size:.95rem}
.steps b{display:block;color:var(--ink);font-weight:600}
.steps b small{display:block;font-weight:400;color:var(--mute);font-size:.8rem;margin-top:.1rem}
.steps p{font-size:.93rem;margin-top:.25rem}

.cta{margin-top:1.8rem;background:var(--stage);border-radius:14px;padding:1.3rem 1.25rem;display:grid;gap:.9rem}
.cta h2{font-size:1.25rem}
.cta p{font-size:.95rem;max-width:34rem}
.cta .who{display:flex;align-items:center;gap:.7rem;font-size:.88rem;color:var(--mute)}
.cta .who b{display:block;color:var(--ink);font-weight:600}
.avatar{width:36px;height:36px;border-radius:50%;background:var(--ink);color:#fff;display:grid;place-items:center;font-family:var(--fh);font-weight:600;flex:none}
.cta .ken-cta{display:inline-flex!important;align-items:center;justify-content:center;min-height:48px;padding:.9rem 1.5rem!important;border-radius:10px!important;background:var(--p)!important;color:#fff!important;font-weight:600!important;width:fit-content}
.cta .ken-cta:hover{background:var(--p-deep)!important}
.foot{font-size:.8rem;color:var(--mute);margin-top:1.4rem;max-width:36rem}

@media (min-width:760px){
  .top{padding:1.2rem 2rem}
  .wrap{padding:1.5rem 1.5rem 6rem}
  .wrap.wide{max-width:58rem}
  .card{padding:2.2rem 2.4rem 2.4rem}
  .start h1{font-size:2.6rem}
  .q h2{font-size:1.9rem}
  .opts{grid-template-columns:1fr 1fr}
  .dims{grid-template-columns:1fr 1fr}
  .res h1{font-size:2.6rem}
  .radar-wrap{grid-template-columns:minmax(0,1fr) minmax(0,1.1fr);align-items:center;gap:2.4rem}
  .radar{max-width:420px}
  .legend{justify-content:flex-start;margin-top:.6rem}
  .cta{grid-template-columns:minmax(0,1fr) auto;align-items:center;padding:1.6rem 1.8rem}
  .cta .ken-cta{grid-column:2;grid-row:1/4}
}
@media (prefers-reduced-motion:reduce){.opt{transition:none}}
</style>
</head>
<body>
<div class="app" x-data="{ q: -1, a: [{% for i in (1..qcount) %}0{% unless forloop.last %}, {% endunless %}{% endfor %}], s: [0, 0, 0, 0], o: 0, st: 0, na: 0{% if has_peers %}, p: [{{ peer.score_1 | plus: 0 | escape }}, {{ peer.score_2 | plus: 0 | escape }}, {{ peer.score_3 | plus: 0 | escape }}, {{ peer.score_4 | plus: 0 | escape }}], po: 0, pst: 0, ah: 0{% endif %} }">
{%- comment -%} Derived numbers: the CSP build has no getters, so each one is an x-effect that writes its value back into the state. {%- endcomment %}
{%- for d in (1..4) %}
{%- assign terms = '' -%}
{%- assign cnt = 0 -%}
{%- for qu in data.questions -%}
{%- if qu.dimension == d -%}
{%- assign cnt = cnt | plus: 1 -%}
{%- capture term -%}a[{{ forloop.index0 }}]{%- endcapture -%}
{%- if terms == '' -%}{%- assign terms = term -%}{%- else -%}{%- assign terms = terms | append: ' + ' | append: term -%}{%- endif -%}
{%- endif -%}
{%- endfor %}
<i hidden x-effect="s[{{ d | minus: 1 }}] = {% if cnt > 0 %}({{ terms }}) / {{ cnt }}{% else %}0{% endif %}"></i>
{%- endfor %}
<i hidden x-effect="o = (s[0] + s[1] + s[2] + s[3]) / 4"></i>
<i hidden x-effect="st = (o >= 1.75) + (o >= 2.5) + (o >= 3.25)"></i>
<i hidden x-effect="na = {% for i in (0..last_q) %}(a[{{ i }}] > 0){% unless forloop.last %} + {% endunless %}{% endfor %}"></i>
{%- if has_peers %}
<i hidden x-effect="po = (p[0] + p[1] + p[2] + p[3]) / 4 + 0.001"></i>
<i hidden x-effect="pst = (po >= 1.75) + (po >= 2.5) + (po >= 3.25)"></i>
<i hidden x-effect="ah = (s[0] > p[0]) + (s[1] > p[1]) + (s[2] > p[2]) + (s[3] > p[3])"></i>
{%- endif %}

<header class="top" x-effect="(q > -2) && $el.scrollIntoView()">
  <div class="brand">{% if brand.logo_url %}<img class="logo" src="{{ brand.logo_url | escape }}" alt="">{% else %}<span class="mark" aria-hidden="true">{{ brand_name | slice: 0, 1 | upcase | escape }}</span>{% endif %}<span>{{ brand_name | escape }}</span></div>
  <p class="for">{% if person.first_name %}For {{ person.first_name | escape }}{% if person.last_name %} {{ person.last_name | escape }}{% endif %}<br>{{ account.name | escape }}{% else %}Prepared for<br>{{ account.name | escape }}{% endif %}</p>
</header>

<main class="wrap" :class="q === {{ qcount }} ? 'wide' : ''">
  <div class="deck none" :class="(q < 0 || q > {{ last_q }}) ? 'none' : q === {{ last_q }} ? 'last' : ''">
  <div class="card">

    <!-- Start -->
    <section class="start" data-section="start" x-show="q < 0">
      <h1>{{ data.headline | escape }}</h1>
      <p class="lede">Eight questions across four areas, about three minutes. At the end you see {% if has_peers %}where {{ account.name | escape }} stands next to <b>{{ peer.assessments | escape }} {{ peer.peer_group | escape }}</b>{% else %}the score for each area and the stage {{ account.name | escape }} is at{% endif %}, and the three moves that usually come next.</p>
      <ul class="dims">
        {%- for dim in data.dimensions %}
        <li>
          {%- case forloop.index -%}
          {%- when 1 -%}<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M3 5h14M3 10h10M3 15h7"/></svg>
          {%- when 2 -%}<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M3 16V9M8 16V4M13 16v-5M18 16V7"/></svg>
          {%- when 3 -%}<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="6" cy="6" r="2.5"/><circle cx="14" cy="14" r="2.5"/><path d="M8.5 6H14v5.5M11.5 14H6V8.5"/></svg>
          {%- else -%}<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="7" cy="7" r="3"/><path d="M1.5 17a5.5 5.5 0 0111 0M13 4.5a3 3 0 010 5.5M15 12.5a5 5 0 013.5 4.5"/></svg>
          {%- endcase -%}
          <div><b>{{ dim.name | escape }}</b><span>{{ dim.blurb | escape }}</span></div>
        </li>
        {%- endfor %}
      </ul>
      <p class="aside">{{ data.intro | escape }} Pick the closest option. Honesty matters more than precision, and nothing here is scored against you.</p>
      <noscript><p class="nojs">The questions need JavaScript. Turn it on and reload, or book a time and we will go through them together.</p></noscript>
      <div class="startrow">
        <button class="btn" type="button" x-cloak @click="q = 0">Start the assessment</button>
        {% render 'ken/cta', label: 'Prefer to talk it through? Book 30 minutes', kind: 'booking', variant: 'link', id: 'start-booking' %}
      </div>
    </section>

    <!-- Questions -->
    <section data-section="questions" x-cloak x-show="q >= 0 && q < {{ qcount }}">
      <div class="prog" aria-hidden="true">
        {%- for i in (0..last_q) %}<i :class="q > {{ i }} ? 'done' : q === {{ i }} ? 'now' : ''"></i>{% endfor %}
      </div>
      {%- for qu in data.questions %}
      {%- assign di = qu.dimension | minus: 1 %}
      {%- assign dim = data.dimensions[di] %}
      {%- assign qi = forloop.index0 %}
      <div class="q" x-cloak x-show="q === {{ qi }}">
        <div class="meta"><span>Question <b>{{ forloop.index }}</b> of {{ qcount }}</span><span>{{ dim.name | escape }}</span></div>
        <h2 tabindex="-1" x-effect="(q === {{ qi }}) && $el.focus({ preventScroll: true })">{{ qu.text | escape }}</h2>
        <ul class="opts">
          {%- for ans in qu.answers %}
          <li><button class="opt" type="button" aria-pressed="false" :aria-pressed="a[{{ qi }}] === {{ forloop.index }}" @click="(a[{{ qi }}] = {{ forloop.index }}) && (q = {{ qi | plus: 1 }})"><span class="n">{{ forloop.index }}</span><span><b>{{ ans.label | escape }}</b><span>{{ ans.hint | escape }}</span></span></button></li>
          {%- endfor %}
        </ul>
      </div>
      {%- endfor %}
      <div class="scale" aria-hidden="true"><span>1, where most teams start</span><span>4, as good as it gets</span></div>
      <div class="qnav"><button class="ghost" type="button" :style="q === 0 ? 'visibility:hidden' : ''" @click="q = q - 1">Back</button><span class="meta"><span x-text="na + ' answered'"></span></span></div>
    </section>

    <!-- Result -->
    <div x-cloak x-show="q === {{ qcount }}">
    <section class="res" data-section="result">
      <p class="stage-line">{{ account.name | escape }}{% if person.first_name %}, answered by {{ person.first_name | escape }}{% if person.last_name %} {{ person.last_name | escape }}{% endif %}{% else %}, self-assessed{% endif %}</p>
      <h1>{{ account.name | escape }} is at the <em>
        {%- for name in data.stages -%}<span x-cloak x-show="st === {{ forloop.index0 }}">{{ name | escape }}</span>{%- endfor -%}
      </em> stage</h1>
      <p class="score"><b x-text="o.toFixed(1)"></b> of 4 overall.
        {%- if has_peers %} Peers average <b x-text="po.toFixed(1)"></b>, which puts {{ account.name | escape }} <span x-cloak x-show="ah === 4">ahead in all four areas</span><span x-cloak x-show="ah === 3">ahead in three of the four areas</span><span x-cloak x-show="ah === 2">ahead in two of the four areas</span><span x-cloak x-show="ah === 1">ahead in one of the four areas</span><span x-cloak x-show="ah === 0">level with or behind peers in every area</span>.{% endif %}</p>
      <ol class="ladder">
        {%- for name in data.stages %}
        <li :class="{ done: st > {{ forloop.index0 }}, now: st === {{ forloop.index0 }}{% if has_peers %}, peer: pst === {{ forloop.index0 }}{% endif %} }">{{ name | escape }}</li>
        {%- endfor %}
      </ol>

      <div class="radar-wrap">
        <div>
          <svg class="radar" viewBox="0 0 360 290" role="img" aria-label="Radar chart of the four area scores, from 0 to 4">
            {%- for k in (1..4) %}
            {%- assign k21 = k | times: 21 %}
            <polygon class="ring{% if k == 4 %} outer{% endif %}" points="180,{{ 150 | minus: k21 }} {{ 180 | plus: k21 }},150 180,{{ 150 | plus: k21 }} {{ 180 | minus: k21 }},150"/>
            {%- endfor %}
            <line class="axis" x1="180" y1="66" x2="180" y2="234"/>
            <line class="axis" x1="96" y1="150" x2="264" y2="150"/>
            {%- if has_peers %}
            <polygon class="peer" :points="'180,' + (150 - 21 * p[0]) + ' ' + (180 + 21 * p[1]) + ',150 180,' + (150 + 21 * p[2]) + ' ' + (180 - 21 * p[3]) + ',150'"/>
            {%- endif %}
            <polygon class="me" :points="'180,' + (150 - 21 * s[0]) + ' ' + (180 + 21 * s[1]) + ',150 180,' + (150 + 21 * s[2]) + ' ' + (180 - 21 * s[3]) + ',150'"/>
            <circle class="dot" r="4.5" cx="180" :cy="150 - 21 * s[0]"/>
            <circle class="dot" r="4.5" :cx="180 + 21 * s[1]" cy="150"/>
            <circle class="dot" r="4.5" cx="180" :cy="150 + 21 * s[2]"/>
            <circle class="dot" r="4.5" :cx="180 - 21 * s[3]" cy="150"/>
            <text class="lab" x="180" y="40" text-anchor="middle">{{ data.dimensions[0].name | escape }}</text>
            <text x="180" y="56" text-anchor="middle" x-text="s[0].toFixed(1) + ' of 4'"></text>
            <text class="lab" x="274" y="148" text-anchor="start">{{ data.dimensions[1].name | escape }}</text>
            <text x="274" y="164" text-anchor="start" x-text="s[1].toFixed(1) + ' of 4'"></text>
            <text class="lab" x="180" y="254" text-anchor="middle">{{ data.dimensions[2].name | escape }}</text>
            <text x="180" y="270" text-anchor="middle" x-text="s[2].toFixed(1) + ' of 4'"></text>
            <text class="lab" x="86" y="148" text-anchor="end">{{ data.dimensions[3].name | escape }}</text>
            <text x="86" y="164" text-anchor="end" x-text="s[3].toFixed(1) + ' of 4'"></text>
          </svg>
          <div class="legend"><span><i></i>{{ account.name | escape }}</span>{% if has_peers %}<span><i class="pr"></i>Peers, {{ peer.assessments | escape }} companies</span>{% endif %}</div>
        </div>
        <table class="dtab">
          <thead><tr><th>Area</th><th class="r">Score</th>{% if has_peers %}<th class="r">Peers</th>{% endif %}</tr></thead>
          <tbody>
            {%- for dim in data.dimensions %}
            {%- assign di = forloop.index0 %}
            <tr><td>{{ dim.name | escape }}</td><td class="r"><span x-text="s[{{ di }}].toFixed(1)"></span>{% if has_peers %}<span class="delta" :class="s[{{ di }}] < p[{{ di }}] ? 'neg' : ''" x-text="(s[{{ di }}] >= p[{{ di }}] ? '+' : '') + (s[{{ di }}] - p[{{ di }}]).toFixed(1)"></span>{% endif %}</td>{% if has_peers %}<td class="r pr" x-text="p[{{ di }}].toFixed(1)"></td>{% endif %}</tr>
            {%- endfor %}
          </tbody>
        </table>
      </div>
    </section>

    <section class="steps" data-section="steps">
      <h2>Three moves that usually come next</h2>
      <ol>
        {%- for step in data.steps %}
        {%- assign di = forloop.index0 %}
        {%- assign dim = data.dimensions[di] %}
        {%- assign rank = '' %}
        {%- for e in (0..3) %}
        {%- if e != di %}
        {%- if e < di %}{% capture t %}(s[{{ e }}] <= s[{{ di }}]){% endcapture %}{% else %}{% capture t %}(s[{{ e }}] < s[{{ di }}]){% endcapture %}{% endif %}
        {%- if rank == '' %}{% assign rank = t %}{% else %}{% assign rank = rank | append: ' + ' | append: t %}{% endif %}
        {%- endif %}
        {%- endfor %}
        <li x-cloak x-data="{ r: 0 }" x-effect="r = {{ rank }}" x-show="r < 3" :style="'order:' + r">
          <span class="num" aria-hidden="true" x-text="r + 1"></span>
          <div><b>{{ step.title | escape }}<small>{{ dim.name | escape }}, <span x-text="s[{{ di }}].toFixed(1)"></span> of 4</small></b><p>{{ step.body | escape }}</p></div>
        </li>
        {%- endfor %}
      </ol>
    </section>

    <section class="cta" data-section="book">
      <h2>Walk through the results{% if sender_first %} with {{ sender_first | escape }}{% endif %}</h2>
      <p>Thirty minutes. We go through where {{ account.name | escape }} scored lowest and what the first move would take.</p>
      {%- if sender.name %}
      <div class="who"><span class="avatar" aria-hidden="true">{{ sender.name | slice: 0, 1 | upcase | escape }}</span><span><b>{{ sender.name | escape }}</b>{% if sender.title %}{{ sender.title | escape }}, {% endif %}{{ brand_name | escape }}</span></div>
      {%- endif %}
      {% render 'ken/cta', label: 'Book 30 minutes', kind: 'booking', id: 'result-booking' %}
    </section>
    {%- if has_peers %}
    <p class="foot">Peer figures come from {{ peer.assessments | escape }} assessments by {{ peer.peer_group | escape }}.{% if peer.source and peer.source != '' %} {{ peer.source | escape }}.{% endif %} Scores are self-reported.</p>
    {%- endif %}
    <p class="foot"><button class="ghost" type="button" @click="q = 0">Change my answers</button></p>
    </div>

  </div>
  </div>
</main>
</div>
</body>
</html>
