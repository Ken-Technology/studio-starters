{%- assign accent = brand.colors.primary | default: '#0f6b4f' -%}
{%- assign accent2 = brand.colors.secondary | default: '#17211d' -%}
{%- assign font_head = brand.fonts.heading | default: 'Instrument Sans' -%}
{%- assign font_body = brand.fonts.body | default: 'Inter' -%}
{%- assign head_q = font_head | replace: ' ', '+' -%}
{%- assign body_q = font_body | replace: ' ', '+' -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex">
<title>Recap of our call with {{ account.name | escape }}</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ head_q }}:wght@400;500;600;700&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ body_q }}:wght@400;500;600;700&display=swap">
<style>
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:#f5f4ef;color:#1a1d21;font-family:'{{ font_body }}',ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;font-size:16px;line-height:1.55;-webkit-font-smoothing:antialiased}
.mr{--p:{{ accent }};--s:{{ accent2 }};--ink:#1a1d21;--mute:#5d646b;--line:#dedcd4;--card:#fff;border-top:4px solid var(--s)}
.mr h1,.mr h2,.mr-letter,.mr-brand{font-family:'{{ font_head }}',ui-sans-serif,system-ui,sans-serif}
.mr h1,.mr h2{font-weight:600;letter-spacing:-.015em;line-height:1.12;margin:0;text-wrap:balance}
.mr p{margin:0}
.mr-wrap{max-width:66rem;margin:0 auto;padding:0 1.25rem}
.mr-top{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:1rem 0;border-bottom:1px solid var(--line)}
.mr-logo{height:28px;width:auto;display:block}
.mr-brand{font-weight:600;font-size:1.05rem;line-height:1}
.mr-tag{font-size:.8rem;color:var(--mute);white-space:nowrap}
.mr-tag::before{content:'';display:inline-block;width:.5rem;height:.5rem;border-radius:50%;background:var(--p);margin-right:.5rem;vertical-align:.02em}
.mr-head{padding:2.2rem 0 0}
.mr-kicker{font-size:.95rem;color:var(--mute);margin:0 0 .75rem}
.mr-kicker b{font-weight:500;color:var(--ink)}
.mr h1{font-size:2.15rem;margin:0 0 1.4rem}
.mr-note{padding:.4rem 0 2rem;border-bottom:1px solid var(--line)}
.mr-hi{font-size:1.05rem;font-weight:500;margin:0 0 .55rem}
.mr-letter{font-size:1.22rem;line-height:1.45;max-width:40rem;margin:0 0 1.3rem;font-weight:400}
.mr-sig{font-size:.95rem;line-height:1.3}
.mr-sig b{font-weight:600;display:block}
.mr-sig span{color:var(--mute);display:block;font-size:.88rem;margin-top:.15rem}
.mr-next{padding:2rem 0 3rem}
.mr-box{background:var(--card);border:1px solid var(--line);border-top:3px solid var(--s);border-radius:6px;padding:1.5rem 1.25rem}
.mr-box h2{font-size:1.4rem;margin:0 0 .5rem}
.mr-box p{color:var(--mute);max-width:36rem}
.mr-btn{margin-top:1.2rem}
.mr-btn .ken-cta{background:var(--p)!important;border-radius:6px!important;padding:.85rem 1.35rem!important;font-family:inherit;font-size:1rem}
.ken-cta:focus-visible{outline:2px solid var(--p);outline-offset:3px}
@media (min-width:760px){
body{font-size:17px}
.mr-wrap{padding:0 2.5rem}
.mr-top{padding:1.2rem 0}
.mr-head{padding:3.2rem 0 0}
.mr h1{font-size:3.1rem;margin-bottom:1.8rem;max-width:28ch}
.mr-note{padding:.5rem 0 2.4rem}
.mr-letter{font-size:1.45rem;line-height:1.4}
.mr-next{padding:2.6rem 0 4rem}
.mr-box{display:flex;justify-content:space-between;align-items:center;gap:2.5rem;padding:1.9rem 2.2rem}
.mr-btn{margin:0;flex:none}
}
</style>
</head>
<body>
<main class="mr">
<div class="mr-wrap">
<header class="mr-top">
{%- if brand.logo_url %}<img class="mr-logo" src="{{ brand.logo_url | escape }}" alt="{{ brand.name | default: 'Logo' | escape }}">{% elsif brand.name %}<p class="mr-brand">{{ brand.name | escape }}</p>{% else %}<span></span>{% endif -%}
<p class="mr-tag">Meeting recap</p>
</header>
<section data-section="head" class="mr-head">
<p class="mr-kicker">{% if person.first_name %}For <b>{{ person.first_name | escape }} {{ person.last_name | escape }}</b>{% if person.title %}, {{ person.title | escape }}{% endif %} at {{ account.name | escape }}{% else %}For the team at <b>{{ account.name | escape }}</b>{% endif %}</p>
<h1>Recap of our call with {{ account.name | escape }}</h1>
</section>
<section data-section="note" class="mr-note">
<p class="mr-hi">{% if person.first_name %}{{ person.first_name | escape }},{% else %}Hello,{% endif %}</p>
<p class="mr-letter">Thanks for the time. I am writing up what we covered, what we agreed and who does what next. This page fills in as soon as my notes are in, and the link stays the same, so check back later today.</p>
<p class="mr-sig"><b>{{ sender.name | default: 'Our team' | escape }}</b>{% if sender.title %}<span>{{ sender.title | escape }}{% if brand.name %}, {{ brand.name | escape }}{% endif %}</span>{% elsif brand.name %}<span>{{ brand.name | escape }}</span>{% endif %}</p>
</section>
<section data-section="next" class="mr-next">
<div class="mr-box">
<div class="mr-box-t">
<h2>Ready for the next call?</h2>
<p>Pick a time that suits you. If you would rather wait for the recap, this page is the place to come back to.</p>
</div>
<div class="mr-btn">{% render 'ken/cta', label: 'Book the next call', kind: 'booking', color: accent %}</div>
</div>
</section>
</div>
</main>
</body>
</html>
