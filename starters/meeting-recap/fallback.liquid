{%- assign accent2 = brand.colors.secondary | default: '#0e1726' -%}
{%- assign font_head = brand.fonts.heading | default: 'Anton' -%}
{%- assign font_body = brand.fonts.body | default: 'Host Grotesk' -%}
{%- assign head_q = font_head | replace: ' ', '+' -%}
{%- assign body_q = font_body | replace: ' ', '+' -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex">
<title>Recap of our call with {{ account.name | escape }}</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ head_q }}{% if brand.fonts.heading %}:wght@400;700{% endif %}&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ body_q }}:wght@400;600&display=swap">
<style>
:root{--bg:#d4e4ee;--ink:#0e1726;--muted:#3a4a5e;--fh:'{{ font_head }}',Impact,'Arial Narrow',sans-serif;--fb:'{{ font_body }}',ui-sans-serif,system-ui,sans-serif;--m:clamp(1rem,2.4vw,2rem){% if brand.fonts.heading %};--hw:700;--hc:none{% else %};--hw:400;--hc:uppercase{% endif %}}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:var(--bg);color:var(--ink);font:400 1.125rem/1.55 var(--fb);-webkit-font-smoothing:antialiased}
p{margin:0}
h1,h2{font-family:var(--fh);font-weight:var(--hw);text-transform:var(--hc);margin:0;line-height:1}
.wrap{padding:0 var(--m)}
.top{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:baseline;gap:.4rem 2rem;padding:1.1rem 0}
.top img{height:28px;width:auto;max-width:10rem;display:block}
.top .brand{font-weight:600;font-size:1.25rem}
.head{padding:4rem 0 0}
.head h1{font-size:clamp(2.125rem,3.9vw,4rem);max-width:20ch;text-wrap:balance}
.note{display:grid;gap:1.4rem;padding:3rem 0 5rem;max-width:40rem}
.note .hi{font-family:var(--fb);text-transform:none;font-size:1.25rem;font-weight:600;line-height:1.4}
.letter{font-size:clamp(1.25rem,1.1rem + .6vw,1.5rem);line-height:1.5}
.sig b{display:block;font-weight:600}
.sig span{color:var(--muted)}
.next{background:color-mix(in srgb,{{ accent2 }} 70%,#000);color:#fff;padding:4rem var(--m) 5rem;display:grid;gap:1.6rem}
.next h2{font-size:clamp(2.5rem,6vw,5rem);max-width:12ch}
.next p{font-size:1.25rem;max-width:30em}
.ken-cta{display:inline-flex;align-items:center;justify-content:center;min-height:56px;padding:0 1.8rem;background:var(--bg);color:var(--ink);font-weight:600;font-size:1.0625rem;text-decoration:none;border-radius:0}
.ken-cta:focus-visible{outline:3px solid #fff;outline-offset:3px}
</style>
</head>
<body>
<main>
<div class="wrap">
<header class="top">
{%- if brand.logo_url %}<img src="{{ brand.logo_url | escape }}" alt="{{ brand.name | default: 'Logo' | escape }}">{% elsif brand.name %}<p class="brand">{{ brand.name | escape }}</p>{% else %}<span></span>{% endif -%}
<p>{% if person.first_name %}Recap for {{ person.first_name | escape }} {{ person.last_name | escape }}{% if person.title %}, {{ person.title | escape }}{% endif %} at {{ account.name | escape }}{% else %}Recap for the team at {{ account.name | escape }}{% endif %}</p>
</header>
<section data-section="head" class="head">
<h1>Recap of our call with {{ account.name | escape }}</h1>
</section>
<section data-section="note" class="note">
<h2 class="hi">{% if person.first_name %}{{ person.first_name | escape }},{% else %}Hello,{% endif %}</h2>
<p class="letter">Thanks for the time. I am writing up what we covered, what we agreed and who does what next. This page fills in as soon as my notes are in, and the link stays the same, so check back later today.</p>
<p class="sig"><b>{{ sender.name | default: 'Our team' | escape }}</b>{% if sender.title %}<span>{{ sender.title | escape }}{% if brand.name %}, {{ brand.name | escape }}{% endif %}</span>{% elsif brand.name %}<span>{{ brand.name | escape }}</span>{% endif %}</p>
</section>
</div>
<section data-section="next" class="next">
<h2>Ready for the next call?</h2>
<p>Pick a time that suits you. If you would rather wait for the recap, this page is the place to come back to.</p>
<div>{% render 'ken/cta', label: 'Book the next call', kind: 'booking', variant: 'link' %}</div>
</section>
</main>
</body>
</html>
