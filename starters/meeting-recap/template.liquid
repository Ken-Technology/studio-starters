{%- assign accent = brand.colors.primary | default: '#c8281e' -%}
{%- assign accent2 = brand.colors.secondary | default: '#0e1726' -%}
{%- assign font_head = brand.fonts.heading | default: 'Anton' -%}
{%- assign font_body = brand.fonts.body | default: 'Host Grotesk' -%}
{%- assign our_name = brand.name | default: 'Us' -%}
{%- comment -%} Is a brand color light? Brightness is (299 r + 587 g + 114 b) / 1000 of a hex color; 110 or more takes dark text. {%- endcomment -%}
{%- assign hx = '0123456789abcdef' -%}
{%- assign pair = accent | append: ',' | append: accent2 | split: ',' -%}
{%- assign lights = '' -%}
{%- assign lums = '' -%}
{%- for c in pair -%}
  {%- assign h = c | remove: '#' | strip | downcase -%}
  {%- assign ch = h | split: '' -%}
  {%- if ch.size == 3 -%}
    {%- assign h = ch[0] | append: ch[0] | append: ch[1] | append: ch[1] | append: ch[2] | append: ch[2] -%}
    {%- assign ch = h | split: '' -%}
  {%- endif -%}
  {%- assign light = 'n' -%}
  {%- assign lum = 0 -%}
  {%- if ch.size == 6 -%}
    {%- assign v0 = hx | split: ch[0] | first | size -%}
    {%- assign v1 = hx | split: ch[1] | first | size -%}
    {%- assign v2 = hx | split: ch[2] | first | size -%}
    {%- assign v3 = hx | split: ch[3] | first | size -%}
    {%- assign v4 = hx | split: ch[4] | first | size -%}
    {%- assign v5 = hx | split: ch[5] | first | size -%}
    {%- if v0 < 16 and v1 < 16 and v2 < 16 and v3 < 16 and v4 < 16 and v5 < 16 -%}
      {%- assign lr = v0 | times: 16 | plus: v1 | times: 299 -%}
      {%- assign lg = v2 | times: 16 | plus: v3 | times: 587 -%}
      {%- assign lb = v4 | times: 16 | plus: v5 | times: 114 -%}
      {%- assign lum = lr | plus: lg | plus: lb | divided_by: 1000 -%}
      {%- if lum >= 110 -%}{%- assign light = 'y' -%}{%- endif -%}
    {%- endif -%}
  {%- endif -%}
  {%- assign lights = lights | append: light -%}
  {%- assign lums = lums | append: lum | append: ',' -%}
{%- endfor -%}
{%- assign p_light = lights | slice: 0, 1 -%}
{%- assign s_light = lights | slice: 1, 1 -%}
{%- comment -%} The last button sits on the secondary field; when the two colors are about as bright, it takes the field's text color instead. {%- endcomment -%}
{%- assign lv = lums | split: ',' -%}
{%- assign l_gap = lv[0] | plus: 0 | minus: lv[1] | abs -%}
{%- assign has_heard = false -%}
{%- if data.heard.size > 0 -%}{%- assign has_heard = true -%}{%- endif -%}
{%- assign has_agreed = false -%}
{%- if data.agreed.size > 0 -%}{%- assign has_agreed = true -%}{%- endif -%}
{%- assign has_steps = false -%}
{%- if data.steps.size > 0 -%}{%- assign has_steps = true -%}{%- endif -%}
{%- assign has_res = false -%}
{%- if data.resources.size > 0 -%}{%- assign has_res = true -%}{%- endif -%}
{%- assign has_sources = false -%}
{%- if data.sources.size > 0 -%}{%- assign has_sources = true -%}{%- endif -%}
{%- assign has_them = false -%}
{%- if data.call.them.size > 0 -%}{%- assign has_them = true -%}{%- endif -%}
{%- assign has_us = false -%}
{%- if data.call.us.size > 0 -%}{%- assign has_us = true -%}{%- endif -%}
{%- assign has_when = false -%}
{%- if data.call.date or data.call.length or data.call.channel -%}{%- assign has_when = true -%}{%- endif -%}
{%- assign has_body = false -%}
{%- if has_heard or has_agreed or has_steps -%}{%- assign has_body = true -%}{%- endif -%}
{%- assign n_them_steps = 0 -%}
{%- assign n_us_steps = 0 -%}
{%- for s in data.steps -%}{%- if s.side == 'us' -%}{%- assign n_us_steps = n_us_steps | plus: 1 -%}{%- else -%}{%- assign n_them_steps = n_them_steps | plus: 1 -%}{%- endif -%}{%- endfor -%}
{%- comment -%} The monument is the day of the call: "Wednesday, October 21" sets as "October 21". With no date, the account's name stands in. {%- endcomment -%}
{%- assign mono = account.name -%}
{%- if data.call.date and data.call.date != '' -%}
  {%- assign dparts = data.call.date | split: ', ' -%}
  {%- if dparts.size > 1 -%}{%- assign mono = dparts[1] -%}{%- else -%}{%- assign mono = data.call.date -%}{%- endif -%}
{%- endif -%}
{%- assign mono_len = mono | size -%}
{%- assign mono_size = 'xl' -%}
{%- if mono_len > 8 -%}{%- assign mono_size = 'l' -%}{%- endif -%}
{%- if mono_len > 11 -%}{%- assign mono_size = 'm' -%}{%- endif -%}
{%- if mono_len > 15 -%}{%- assign mono_size = 's' -%}{%- endif -%}
{%- if mono_len > 20 -%}{%- assign mono_size = 'xs' -%}{%- endif -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex">
<title>{{ data.title | escape }}{% if brand.name %}, from {{ brand.name | escape }}{% endif %}</title>
{%- if font_head == 'Anton' %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Anton&display=swap">
{%- else %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_head | url_encode }}&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_head | url_encode }}:wght@700&display=swap">
{%- endif %}
{%- if font_body != font_head %}
{%- if font_body == 'Host Grotesk' %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Host+Grotesk:wght@400;600&display=swap">
{%- else %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_body | url_encode }}&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_body | url_encode }}:wght@600&display=swap">
{%- endif %}
{%- endif %}
<style>
:root{
  --bg:#d4e4ee;
  --surface:#c3d7e4;
  --ink:#0e1726;
  --muted:#3a4a5e;
  --p:{{ accent }};
  --s:{{ accent2 }};
  {%- if p_light == 'y' %}
  --on-p:#0e1726;
  --mark:var(--ink);
  {%- else %}
  --on-p:#ffffff;
  --mark:var(--p);
  {%- endif %}
  {%- if s_light == 'y' %}
  --on-s:#0e1726;
  {%- else %}
  --on-s:#ffffff;
  {%- endif %}
  {%- if l_gap < 50 %}
  --nb:var(--on-s);--nbt:var(--s);
  {%- else %}
  --nb:var(--p);--nbt:var(--on-p);
  {%- endif %}
  --fh:'{{ font_head }}',Impact,'Arial Narrow',sans-serif;
  --fb:'{{ font_body }}',ui-sans-serif,system-ui,sans-serif;
  --m:clamp(1rem,2.4vw,2rem);
  {%- if brand.fonts.heading %}
  --hw:700;--hc:none;--mw:.62;
  {%- else %}
  --hw:400;--hc:uppercase;--mw:1;
  {%- endif %}
}
/* text on a brand field: white under luminance .18, black above, so it passes AA for any colour */
@supports (color:color(from red xyz-d65 x y z)){:root{--on-p:color(from var(--p) xyz-d65 clamp(0,(.18 - y) * 1000000,.9505) clamp(0,(.18 - y) * 1000000,1) clamp(0,(.18 - y) * 1000000,1.089));--on-s:color(from var(--s) xyz-d65 clamp(0,(.18 - y) * 1000000,.9505) clamp(0,(.18 - y) * 1000000,1) clamp(0,(.18 - y) * 1000000,1.089))}}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:var(--bg);color:var(--ink);font:400 1.0625rem/1.55 var(--fb);-webkit-font-smoothing:antialiased;font-variant-numeric:tabular-nums}
p{margin:0}
a{color:inherit;text-decoration-thickness:.07em;text-underline-offset:.18em}
a:focus-visible,.ken-cta:focus-visible{outline:3px solid var(--ink);outline-offset:3px}
h1,h2{font-family:var(--fh);font-weight:var(--hw);text-transform:var(--hc);margin:0;letter-spacing:0}
::selection{background:var(--ink);color:var(--bg)}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
.wrap{padding:0 var(--m)}

/* First screen: the title and who was there, over the day of the call set edge to edge. */
.head{display:flex;flex-direction:column}
.top{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:baseline;gap:.4rem 2rem;padding:1.1rem 0}
.top img{height:28px;width:auto;max-width:10rem;display:block}
.top .brand{font-weight:600;font-size:1.25rem}
.top .for{font-size:1.0625rem}
.lead{display:grid;gap:1.6rem;padding:2.5rem 0 2rem}
h1{font-size:clamp(2.125rem,3.9vw,4rem);line-height:1;text-wrap:balance}
.when{font-size:1.25rem;line-height:1.4;font-weight:600}
.present{display:grid;gap:.9rem;font-size:1.25rem;line-height:1.45;max-width:36em}
.present span{color:var(--muted)}
.mono{margin:5.5rem 0 0;font-family:var(--fh);font-weight:var(--hw);text-transform:uppercase;line-height:.9;white-space:nowrap;letter-spacing:-.01em;padding-bottom:.04em}
.mono.xl{font-size:calc(27vw * var(--mw))}
.mono.l{font-size:calc(21.5vw * var(--mw))}
.mono.m{font-size:calc(17vw * var(--mw))}
.mono.s{font-size:calc(12vw * var(--mw))}
.mono.xs{font-size:calc(8.5vw * var(--mw));white-space:normal;overflow-wrap:anywhere}

/* Sections */
.sec{padding-top:5.5rem}
.sec h2{font-size:clamp(2.25rem,4vw,3.5rem);line-height:1}
.note{display:grid;gap:1.4rem;padding-top:4rem}
.note .hi{font-family:var(--fb);text-transform:none;font-size:1.25rem;font-weight:600;line-height:1.4}
.letter{font-size:clamp(1.25rem,1.1rem + .6vw,1.5rem);line-height:1.5;max-width:32em}
.sig b{display:block;font-weight:600}
.sig span{color:var(--muted)}

.heard dl{margin:2.4rem 0 0;display:grid;gap:1.6rem}
.heard dl div{display:grid;gap:.25rem}
.heard dt{font-weight:600}
.heard dd{margin:0;max-width:36em}

.agreed{margin-top:5.5rem;background:var(--surface);padding:4.5rem var(--m) 5rem}
.agreed ol{list-style:none;margin:2.4rem 0 0;padding:0;display:grid;gap:1.4rem}
.agreed li{display:grid;grid-template-columns:2rem minmax(0,1fr);gap:.9rem;font-size:1.25rem;line-height:1.45;max-width:40em}
.agreed svg{width:1.6rem;height:1.6rem;margin-top:.1rem;color:var(--mark)}

.steps table{width:100%;border-collapse:collapse;margin-top:2.4rem}
.steps tbody+tbody th{padding-top:2.6rem}
.steps th{text-align:left;font-weight:600;font-size:1.25rem;padding:0 0 .8rem}
.steps td{padding:0 0 1.1rem;vertical-align:top}
.steps .what{font-size:1.0625rem}
.steps .who,.steps .by{display:block;color:var(--muted)}
.steps .open{font-style:normal}
.steps thead{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}

.res ul{list-style:none;margin:2.4rem 0 0;padding:0;display:grid;gap:1.8rem}
.res li{display:grid;gap:.2rem;max-width:36em}
.res .t{font-size:1.25rem;font-weight:600;line-height:1.35}
.res .k{color:var(--muted)}
.res a{display:inline-flex;align-items:center;min-height:44px}

.wait p{margin-top:1.4rem;max-width:36em;font-size:1.25rem}

.next{margin-top:6rem;background:var(--s);color:var(--on-s);padding:5rem var(--m) 2rem;display:grid;gap:2rem}
.next h2{font-size:clamp(3rem,8vw,7rem);line-height:.92;max-width:12ch}
.next .row{display:grid;gap:1.6rem;align-items:end}
.go{margin-top:.6rem}
.go .ken-cta:hover{background:var(--ink);color:var(--bg)}
.next p{font-size:1.25rem;max-width:30em}
.ken-cta{display:inline-flex;align-items:center;justify-content:center;min-height:56px;padding:0 1.8rem;background:var(--p);color:var(--on-p);font-weight:600;font-size:1.0625rem;text-decoration:none;border-radius:0}
.ken-cta:hover{background:var(--bg);color:var(--ink)}
.next .ken-cta{background:var(--nb);color:var(--nbt)}
.next .ken-cta:hover{background:var(--bg);color:var(--ink)}
.next a:focus-visible,.next .ken-cta:focus-visible{outline-color:var(--on-s)}
.foot{margin-top:3rem;padding-top:0;font-size:.9375rem;max-width:56em}

@media (prefers-reduced-motion:no-preference){
  .mono{animation:up .9s cubic-bezier(.2,.7,.1,1) .1s backwards}
  @keyframes up{from{transform:translateY(.18em);opacity:0}}
}

@media (min-width:860px){
  body{font-size:1.125rem}
  .head{min-height:100svh}
  .lead{margin:auto 0}
  .mono{margin-top:0}
  .lead{grid-template-columns:1fr 1fr;column-gap:var(--m);align-items:start;padding-top:3.5rem}
  .lead .facts{grid-column:2}
  h1{grid-row:1/3}
  .wrap.sec{padding-top:8rem}
  .note{grid-template-columns:5fr 7fr;column-gap:var(--m);padding-top:5rem}
  .note .hi{grid-row:1/4}
  .heard dl{margin-left:calc((100% - var(--m)) * 5 / 12 + var(--m))}
  .heard dl div{grid-template-columns:minmax(0,14rem) minmax(0,1fr)}
  .agreed{margin-top:8rem;padding:6rem var(--m) 6.5rem}
  .agreed ol{grid-template-columns:1fr 1fr;column-gap:var(--m);row-gap:2rem}
  .steps th{font-size:1.25rem}
  .steps td{padding:0 1.5rem .9rem 0}
  .steps td:last-child{padding-right:0;text-align:right;white-space:nowrap}
  .steps .what{font-size:1.25rem}
  .steps .who,.steps .by{display:inline;color:var(--ink)}
  .steps .open{color:var(--muted)}
  .steps .c-who{width:26%}
  .steps .c-by{width:14%}
  .res ul{grid-template-columns:1fr 1fr;column-gap:var(--m);row-gap:2.4rem}
  .next{margin-top:9rem;padding-top:7rem}
  .next .row{grid-template-columns:minmax(0,1fr) auto}
}
@media (max-width:859px){
  .mono{order:1;margin:2.5rem 0 0}
  .lead{order:2}
  .steps table,.steps tbody,.steps tr,.steps td,.steps th{display:block}
  .steps tr{padding:0 0 1.2rem}
  .steps td{padding:0}
  .steps .what{font-size:1.1875rem;font-weight:600}
  .steps .c-who,.steps .c-by,.steps .who,.steps .by{display:inline}
  .steps .c-by::before{content:', '}
}
@media print{
  .head{min-height:0}
  .mono{animation:none}
  .agreed,.steps,.res{break-inside:avoid}
}
</style>
</head>
<body>
<main>
<div class="wrap head" data-section="head">
<header class="top">
{%- if brand.logo_url %}<img src="{{ brand.logo_url | escape }}" alt="{{ brand.name | default: 'Logo' | escape }}">{% elsif brand.name %}<p class="brand">{{ brand.name | escape }}</p>{% else %}<span></span>{% endif -%}
<p class="for">{% if person.first_name %}Recap for {{ person.first_name | escape }} {{ person.last_name | escape }}{% if person.title %}, {{ person.title | escape }}{% endif %} at {{ account.name | escape }}{% else %}Recap for the team at {{ account.name | escape }}{% endif %}</p>
</header>
<div class="lead">
<h1>{{ data.title | escape }}</h1>
<div class="facts present">
{%- if has_when %}
<p class="when">{% if data.call.date %}{{ data.call.date | escape }}.{% endif %}{% if data.call.length %} {{ data.call.length | escape }}{% if data.call.channel %}, {{ data.call.channel | escape }}{% endif %}.{% elsif data.call.channel %} {{ data.call.channel | capitalize | escape }}.{% endif %}</p>
{%- endif %}
{%- if has_them %}
<p>From {{ account.name | escape }}: {% for p in data.call.them %}{{ p.name | escape }}{% if p.title %} <span>{{ p.title | escape }}</span>{% endif %}{% if forloop.last %}.{% elsif forloop.rindex == 2 %} and {% else %}, {% endif %}{% endfor %}</p>
{%- endif %}
{%- if has_us %}
<p>From {{ our_name | escape }}: {% for p in data.call.us %}{{ p.name | escape }}{% if p.title %} <span>{{ p.title | escape }}</span>{% endif %}{% if forloop.last %}.{% elsif forloop.rindex == 2 %} and {% else %}, {% endif %}{% endfor %}</p>
{%- endif %}
<div class="go">{% render 'ken/cta', label: 'Book the next call', kind: 'booking', id: 'booking-top', variant: 'link' %}</div>
</div>
</div>
<p class="mono {{ mono_size }}" aria-hidden="true">{{ mono | escape }}</p>
</div>

<section class="wrap note" data-section="note">
<h2 class="hi">{% if person.first_name %}{{ person.first_name | escape }},{% else %}Hello,{% endif %}</h2>
<p class="letter">{{ data.note | escape | newline_to_br | strip_newlines | raw }}</p>
<p class="sig"><b>{{ sender.name | default: 'Our team' | escape }}</b>{% if sender.title %}<span>{{ sender.title | escape }}{% if brand.name %}, {{ brand.name | escape }}{% endif %}</span>{% elsif brand.name %}<span>{{ brand.name | escape }}</span>{% endif %}</p>
</section>

{%- if has_heard %}
<section class="wrap sec heard" data-section="heard">
<h2>What we heard</h2>
<dl>
{%- for h in data.heard %}
<div><dt>{{ h.topic | escape }}</dt><dd>{{ h.text | escape }}</dd></div>
{%- endfor %}
</dl>
</section>
{%- endif %}

{%- if has_agreed %}
<section class="agreed" data-section="agreed">
<h2>What we agreed</h2>
<ol>
{%- for a in data.agreed %}
<li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3.5 13.5l5.5 5.5L20.5 5"/></svg><p>{{ a | escape }}</p></li>
{%- endfor %}
</ol>
</section>
{%- endif %}

{%- if has_steps %}
<section class="wrap sec steps" data-section="steps">
<h2>Next steps</h2>
<table>
<thead><tr><th scope="col">What</th><th scope="col">Who</th><th scope="col">By</th></tr></thead>
{%- if n_them_steps > 0 %}
<tbody>
<tr><th colspan="3" scope="rowgroup">{{ account.name | escape }}</th></tr>
{%- for s in data.steps %}{% unless s.side == 'us' %}
<tr><td class="what">{{ s.what | escape }}</td><td class="c-who"><span class="who">{{ s.owner | escape }}</span></td><td class="c-by">{% if s.due %}<span class="by">{{ s.due | escape }}</span>{% else %}<span class="by open">No date yet</span>{% endif %}</td></tr>
{%- endunless %}{% endfor %}
</tbody>
{%- endif %}
{%- if n_us_steps > 0 %}
<tbody>
<tr><th colspan="3" scope="rowgroup">{{ our_name | escape }}</th></tr>
{%- for s in data.steps %}{% if s.side == 'us' %}
<tr><td class="what">{{ s.what | escape }}</td><td class="c-who"><span class="who">{{ s.owner | escape }}</span></td><td class="c-by">{% if s.due %}<span class="by">{{ s.due | escape }}</span>{% else %}<span class="by open">No date yet</span>{% endif %}</td></tr>
{%- endif %}{% endfor %}
</tbody>
{%- endif %}
</table>
</section>
{%- endif %}

{%- if has_res %}
<section class="wrap sec res" data-section="resources">
<h2>What we mentioned</h2>
<ul>
{%- for r in data.resources %}
<li><span class="k">{{ r.kind | escape }}</span><span class="t">{% if r.url %}<a href="{{ r.url | escape }}" target="_blank" rel="noopener noreferrer">{{ r.title | escape }}</a>{% else %}{{ r.title | escape }}{% endif %}</span>{% if r.note %}<span>{{ r.note | escape }}</span>{% endif %}</li>
{%- endfor %}
</ul>
</section>
{%- endif %}

{%- unless has_body %}
<div class="wrap sec wait">
<h2>Still writing it up</h2>
<p>The four parts of this page, what we heard, what we agreed, next steps and what we mentioned, come from my notes of the call. They are not in yet. The link stays the same, so check back later today.</p>
</div>
{%- endunless %}

<section class="next" data-section="next">
<h2>Ready for the next call?</h2>
<div class="row">
<p>Pick a time that suits you. If anything on this page is off, reply to my email and I will fix it the same day.</p>
<div>{% render 'ken/cta', label: 'Book the next call', kind: 'booking', variant: 'link' %}</div>
</div>
<footer class="foot">
<p>Written for {{ account.name | escape }} by {{ sender.name | default: 'our team' | escape }}{% if brand.name %} at {{ brand.name | escape }}{% endif %} from the notes of the call.{% if has_sources %} Sources: {{ data.sources | join: '; ' | escape }}.{% endif %} This is a private link.</p>
</footer>
</section>
</main>
</body>
</html>
