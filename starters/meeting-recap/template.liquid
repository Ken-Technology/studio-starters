{%- assign accent = brand.colors.primary | default: '#0f6b4f' -%}
{%- assign accent2 = brand.colors.secondary | default: '#17211d' -%}
{%- assign font_head = brand.fonts.heading | default: 'Instrument Sans' -%}
{%- assign font_body = brand.fonts.body | default: 'Inter' -%}
{%- assign head_q = font_head | replace: ' ', '+' -%}
{%- assign body_q = font_body | replace: ' ', '+' -%}
{%- assign our_name = brand.name | default: 'Us' -%}
{%- assign has_heard = false -%}
{%- if data.heard.size > 0 -%}{%- assign has_heard = true -%}{%- endif -%}
{%- assign has_agreed = false -%}
{%- if data.agreed.size > 0 -%}{%- assign has_agreed = true -%}{%- endif -%}
{%- assign has_steps = false -%}
{%- if data.steps.size > 0 -%}{%- assign has_steps = true -%}{%- endif -%}
{%- assign has_res = false -%}
{%- if data.resources.size > 0 -%}{%- assign has_res = true -%}{%- endif -%}
{%- assign has_sources = false -%}
{%- if data.sources.size > 0 -%}{%- assign has_sources = true -%}{%- endif -%}
{%- assign has_them = false -%}
{%- if data.call.them.size > 0 -%}{%- assign has_them = true -%}{%- endif -%}
{%- assign has_us = false -%}
{%- if data.call.us.size > 0 -%}{%- assign has_us = true -%}{%- endif -%}
{%- assign has_facts = false -%}
{%- if data.call.date or data.call.length or data.call.channel or has_them or has_us -%}{%- assign has_facts = true -%}{%- endif -%}
{%- assign has_body = false -%}
{%- if has_heard or has_agreed or has_steps -%}{%- assign has_body = true -%}{%- endif -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex">
<title>{{ data.title | escape }}{% if brand.name %}, from {{ brand.name | escape }}{% endif %}</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ head_q }}:wght@400;500;600;700&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ body_q }}:wght@400;500;600;700&display=swap">
<style>
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:#f5f4ef;color:#1a1d21;font-family:'{{ font_body }}',ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;font-size:16px;line-height:1.55;-webkit-font-smoothing:antialiased;font-variant-numeric:tabular-nums}
.mr{--p:{{ accent }};--s:{{ accent2 }};--ink:#1a1d21;--mute:#5d646b;--faint:#8b9197;--line:#dedcd4;--card:#fff;--tint:color-mix(in srgb,var(--p) 8%,#fff);--tint-line:color-mix(in srgb,var(--p) 30%,#fff);--p-text:color-mix(in srgb,var(--p) 78%,#000);border-top:4px solid var(--s);counter-reset:sec}
.mr h1,.mr h2,.mr-letter,.mr-brand{font-family:'{{ font_head }}',ui-sans-serif,system-ui,sans-serif}
.mr h1,.mr h2{font-weight:600;letter-spacing:-.015em;line-height:1.12;margin:0;text-wrap:balance}
.mr p{margin:0}
.mr-wrap{max-width:66rem;margin:0 auto;padding:0 1.25rem}
.mr-top{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:1rem 0;border-bottom:1px solid var(--line)}
.mr-logo{height:28px;width:auto;display:block}
.mr-brand{font-weight:600;font-size:1.05rem;line-height:1}
.mr-tag{font-size:.8rem;color:var(--mute);white-space:nowrap}
.mr-tag::before{content:'';display:inline-block;width:.5rem;height:.5rem;border-radius:50%;background:var(--p);margin-right:.5rem;vertical-align:.02em}
.mr-head{padding:2.2rem 0 0}
.mr-kicker{font-size:.95rem;color:var(--mute);margin:0 0 .75rem}
.mr-kicker b{font-weight:500;color:var(--ink)}
.mr h1{font-size:2.15rem;margin:0 0 1.4rem}
.mr-facts{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 1.25rem;margin:0;border-top:2px solid var(--ink)}
.mr-facts div{padding:.7rem 0 .8rem;border-bottom:1px solid var(--line);min-width:0}
.mr-facts .mr-date,.mr-facts .mr-people{grid-column:1/-1}
.mr-facts dt{font-size:.72rem;font-weight:600;letter-spacing:.07em;text-transform:uppercase;color:var(--mute)}
.mr-facts dd{margin:.2rem 0 0;font-weight:500;line-height:1.35}
.mr-people dd{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.55rem 1rem}
.mr-people span{display:block;min-width:0}
.mr-people b{font-weight:500;display:block}
.mr-people small{display:block;font-weight:400;color:var(--mute);font-size:.82rem}
.mr-note{padding:1.8rem 0 2rem;border-bottom:1px solid var(--line)}
.mr-hi{font-size:1.05rem;font-weight:500;margin:0 0 .55rem}
.mr-letter{font-size:1.22rem;line-height:1.45;max-width:40rem;margin:0 0 1.3rem;font-weight:400}
.mr-sig{font-size:.95rem;line-height:1.3}
.mr-sig b{font-weight:600;display:block}
.mr-sig span{color:var(--mute);display:block;font-size:.88rem;margin-top:.15rem}
.mr-sec{counter-increment:sec;padding:1.9rem 0 2.1rem;border-bottom:1px solid var(--line)}
.mr-sec-h{margin:0 0 1rem}
.mr-num{font-size:.76rem;font-weight:600;letter-spacing:.1em;color:var(--p-text);margin:0 0 .4rem}
.mr-num::before{content:counter(sec,decimal-leading-zero)}
.mr-sec h2{font-size:1.45rem;margin:0 0 .35rem}
.mr-gloss{color:var(--mute);font-size:.92rem}
.mr-heard{margin:0}
.mr-heard div{padding:.8rem 0;border-top:1px solid var(--line)}
.mr-heard div:first-child{border-top:0;padding-top:0}
.mr-heard dt{font-size:.8rem;font-weight:600;color:var(--p-text);margin:0 0 .25rem}
.mr-heard dd{margin:0;font-size:1.02rem}
.mr-agreed{list-style:none;margin:0;padding:.2rem 1.05rem;background:var(--tint);border:1px solid var(--tint-line);border-radius:6px}
.mr-agreed li{display:grid;grid-template-columns:1.5rem minmax(0,1fr);gap:.8rem;align-items:start;padding:.8rem 0;border-top:1px solid var(--tint-line)}
.mr-agreed li:first-child{border-top:0}
.mr-check{width:1.5rem;height:1.5rem;border-radius:50%;background:var(--p);color:#fff;display:grid;place-items:center;margin-top:.05rem}
.mr-check svg{width:.8rem;height:.8rem;display:block}
.mr-agreed p{font-weight:500;font-size:1.02rem}
.mr-steps{background:var(--card);border:1px solid var(--line);border-radius:6px;overflow:hidden}
.mr-steps-head{display:none}
.mr-step{padding:.85rem 1rem;border-top:1px solid var(--line)}
.mr-steps-head+.mr-step{border-top:0}
.mr-what{font-weight:500;margin:0 0 .35rem}
.mr-meta{display:flex;flex-wrap:wrap;gap:.25rem 1.1rem;font-size:.86rem;color:var(--mute)}
.mr-who i{display:inline-block;width:.6rem;height:.6rem;border-radius:2px;margin-right:.45rem;vertical-align:-.02em}
.them .mr-who i{background:var(--ink)}
.us .mr-who i{background:var(--p)}
.mr-by.open{color:var(--faint)}
.mr-legend{list-style:none;margin:.9rem 0 0;padding:0;display:flex;flex-wrap:wrap;gap:.3rem 1.1rem;font-size:.82rem;color:var(--mute)}
.mr-legend i{display:inline-block;width:.6rem;height:.6rem;border-radius:2px;margin-right:.4rem;vertical-align:-.02em}
.mr-legend .them i{background:var(--ink)}
.mr-legend .us i{background:var(--p)}
.mr-res{list-style:none;margin:0;padding:0}
.mr-res li{display:grid;grid-template-columns:auto minmax(0,1fr);gap:.5rem .9rem;align-items:center;padding:.8rem 0;border-top:1px solid var(--line)}
.mr-res li:first-child{border-top:0;padding-top:0}
.mr-kind{font-size:.68rem;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--p-text);background:var(--tint);border:1px solid var(--tint-line);border-radius:3px;padding:.3rem .45rem;min-width:3.8rem;text-align:center;white-space:nowrap;align-self:start;margin-top:.15rem}
.mr-res b{display:block;font-weight:500;line-height:1.3}
.mr-res .n{display:block;font-size:.86rem;color:var(--mute);margin-top:.15rem}
.mr-res a{grid-column:2;justify-self:start;font-size:.88rem;font-weight:500;text-decoration:none;color:var(--p-text);border:1px solid var(--tint-line);padding:.6rem 1rem;border-radius:999px;min-height:2.75rem;display:inline-flex;align-items:center}
.mr-res a:hover,.mr-res a:focus-visible{background:var(--tint)}
.mr-wait p{max-width:40rem;color:var(--mute)}
.mr-next{padding:2rem 0 1rem}
.mr-box{background:var(--card);border:1px solid var(--line);border-top:3px solid var(--s);border-radius:6px;padding:1.5rem 1.25rem}
.mr-box h2{font-size:1.4rem;margin:0 0 .5rem}
.mr-box p{color:var(--mute);max-width:36rem}
.mr-btn{margin-top:1.2rem}
.mr-btn .ken-cta{background:var(--p)!important;border-radius:6px!important;padding:.85rem 1.35rem!important;font-family:inherit;font-size:1rem}
.mr-foot{padding:1.3rem 0 3rem;font-size:.8rem;color:var(--mute);border-top:1px solid var(--line);margin-top:1.5rem}
a:focus-visible,.ken-cta:focus-visible{outline:2px solid var(--p);outline-offset:3px}
@media (min-width:760px){
body{font-size:17px}
.mr-wrap{padding:0 2.5rem}
.mr-top{padding:1.2rem 0}
.mr-head{padding:3.2rem 0 0}
.mr h1{font-size:3.1rem;margin-bottom:1.8rem;max-width:28ch}
.mr-facts{display:flex;flex-wrap:wrap;gap:0 2.5rem;border-bottom:1px solid var(--line)}
.mr-facts div{flex:0 1 auto;border-bottom:0;padding:.9rem 0 1rem}
.mr-facts .mr-people{flex:1 1 13rem}
.mr-people dd{grid-template-columns:1fr;gap:.45rem}
.mr-note{padding:2.2rem 0 2.4rem}
.mr-letter{font-size:1.45rem;line-height:1.4}
.mr-sec{display:grid;grid-template-columns:15rem minmax(0,1fr);gap:2.6rem;padding:2.6rem 0 2.9rem}
.mr-sec-h{margin:0}
.mr-sec h2{font-size:1.45rem}
.mr-heard div{display:grid;grid-template-columns:10rem minmax(0,1fr);gap:1.4rem;padding:1rem 0}
.mr-heard dt{margin:.25rem 0 0}
.mr-steps-head,.mr-step{display:grid;grid-template-columns:minmax(0,1fr) 11.5rem 9rem;gap:1.2rem;align-items:start;padding:.85rem 1.2rem}
.mr-steps-head{font-size:.72rem;letter-spacing:.07em;text-transform:uppercase;color:var(--mute);font-weight:600;background:#faf9f6;border-top:0;border-bottom:1px solid var(--line)}
.mr-what{margin:0}
.mr-meta{display:contents}
.mr-meta p{font-size:.95rem;color:var(--ink)}
.mr-by.open{color:var(--faint)}
.mr-res li{grid-template-columns:auto minmax(0,1fr) auto}
.mr-res a{grid-column:auto}
.mr-next{padding:2.6rem 0 1rem}
.mr-box{display:flex;justify-content:space-between;align-items:center;gap:2.5rem;padding:1.9rem 2.2rem}
.mr-btn{margin:0;flex:none}
}
</style>
</head>
<body>
<main class="mr">
<div class="mr-wrap">
<header class="mr-top">
{%- if brand.logo_url %}<img class="mr-logo" src="{{ brand.logo_url | escape }}" alt="{{ brand.name | default: 'Logo' | escape }}">{% elsif brand.name %}<p class="mr-brand">{{ brand.name | escape }}</p>{% else %}<span></span>{% endif -%}
<p class="mr-tag">Meeting recap</p>
</header>
<section data-section="head" class="mr-head">
<p class="mr-kicker">{% if person.first_name %}For <b>{{ person.first_name | escape }} {{ person.last_name | escape }}</b>{% if person.title %}, {{ person.title | escape }}{% endif %} at {{ account.name | escape }}{% else %}For the team at <b>{{ account.name | escape }}</b>{% endif %}</p>
<h1>{{ data.title | escape }}</h1>
{%- if has_facts %}
<dl class="mr-facts">
{%- if data.call.date %}<div class="mr-date"><dt>Date</dt><dd>{{ data.call.date | escape }}</dd></div>{% endif %}
{%- if data.call.length %}<div><dt>Length</dt><dd>{{ data.call.length | escape }}</dd></div>{% endif %}
{%- if data.call.channel %}<div><dt>Format</dt><dd>{{ data.call.channel | capitalize | escape }}</dd></div>{% endif %}
{%- if has_them %}<div class="mr-people"><dt>From {{ account.name | escape }}</dt><dd>{% for p in data.call.them %}<span><b>{{ p.name | escape }}</b>{% if p.title %}<small>{{ p.title | escape }}</small>{% endif %}</span>{% endfor %}</dd></div>{% endif %}
{%- if has_us %}<div class="mr-people"><dt>From {{ our_name | escape }}</dt><dd>{% for p in data.call.us %}<span><b>{{ p.name | escape }}</b>{% if p.title %}<small>{{ p.title | escape }}</small>{% endif %}</span>{% endfor %}</dd></div>{% endif %}
</dl>
{%- endif %}
</section>
<section data-section="note" class="mr-note">
<p class="mr-hi">{% if person.first_name %}{{ person.first_name | escape }},{% else %}Hello,{% endif %}</p>
<p class="mr-letter">{{ data.note | escape | newline_to_br | strip_newlines | raw }}</p>
<p class="mr-sig"><b>{{ sender.name | default: 'Our team' | escape }}</b>{% if sender.title %}<span>{{ sender.title | escape }}{% if brand.name %}, {{ brand.name | escape }}{% endif %}</span>{% elsif brand.name %}<span>{{ brand.name | escape }}</span>{% endif %}</p>
</section>
{%- if has_heard %}
<section data-section="heard" class="mr-sec">
<div class="mr-sec-h"><p class="mr-num"></p><h2>What we heard</h2><p class="mr-gloss">Your situation, as you described it on the call.</p></div>
<div class="mr-sec-b">
<dl class="mr-heard">
{%- for h in data.heard %}
<div><dt>{{ h.topic | escape }}</dt><dd>{{ h.text | escape }}</dd></div>
{%- endfor %}
</dl>
</div>
</section>
{%- endif %}
{%- if has_agreed %}
<section data-section="agreed" class="mr-sec">
<div class="mr-sec-h"><p class="mr-num"></p><h2>What we agreed</h2><p class="mr-gloss">The decisions both sides made on the call.</p></div>
<div class="mr-sec-b">
<ol class="mr-agreed">
{%- for a in data.agreed %}
<li><span class="mr-check" aria-hidden="true"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3.5 8.5l3 3 6-7"/></svg></span><p>{{ a | escape }}</p></li>
{%- endfor %}
</ol>
</div>
</section>
{%- endif %}
{%- if has_steps %}
<section data-section="steps" class="mr-sec">
<div class="mr-sec-h"><p class="mr-num"></p><h2>Next steps</h2><p class="mr-gloss">Who does what, by when.</p>
<ul class="mr-legend"><li class="them"><i></i>{{ account.name | escape }}</li><li class="us"><i></i>{{ our_name | escape }}</li></ul>
</div>
<div class="mr-sec-b">
<div class="mr-steps">
<div class="mr-steps-head"><span>What</span><span>Who</span><span>By</span></div>
{%- for s in data.steps %}
<div class="mr-step {{ s.side | escape }}"><p class="mr-what">{{ s.what | escape }}</p><div class="mr-meta"><p class="mr-who"><i></i>{{ s.owner | escape }}</p>{% if s.due %}<p class="mr-by">{{ s.due | escape }}</p>{% else %}<p class="mr-by open">No date yet</p>{% endif %}</div></div>
{%- endfor %}
</div>
</div>
</section>
{%- endif %}
{%- if has_res %}
<section data-section="resources" class="mr-sec">
<div class="mr-sec-h"><p class="mr-num"></p><h2>What we mentioned</h2><p class="mr-gloss">The links and files that came up.</p></div>
<div class="mr-sec-b">
<ul class="mr-res">
{%- for r in data.resources %}
<li><span class="mr-kind">{{ r.kind | escape }}</span><div><b>{{ r.title | escape }}</b>{% if r.note %}<span class="n">{{ r.note | escape }}</span>{% endif %}</div>{% if r.url %}<a href="{{ r.url | escape }}" target="_blank" rel="noopener noreferrer">Open</a>{% endif %}</li>
{%- endfor %}
</ul>
</div>
</section>
{%- endif %}
{%- unless has_body %}
<div class="mr-sec mr-wait">
<div class="mr-sec-h"><h2>Still writing it up</h2></div>
<div class="mr-sec-b"><p>The four parts of this page, what we heard, what we agreed, next steps and what we mentioned, come from my notes of the call. They are not in yet. The link stays the same, so check back later today.</p></div>
</div>
{%- endunless %}
<section data-section="next" class="mr-next">
<div class="mr-box">
<div class="mr-box-t">
<h2>Ready for the next call?</h2>
<p>Pick a time that suits you. If anything on this page is off, reply to my email and I will fix it the same day.</p>
</div>
<div class="mr-btn">{% render 'ken/cta', label: 'Book the next call', kind: 'booking', color: accent %}</div>
</div>
</section>
<footer class="mr-foot">
<p>Written for {{ account.name | escape }} by {{ sender.name | default: 'our team' | escape }}{% if brand.name %} at {{ brand.name | escape }}{% endif %} from the notes of the call.{% if has_sources %} Sources: {{ data.sources | join: '; ' | escape }}.{% endif %} This is a private link.</p>
</footer>
</div>
</main>
</body>
</html>
