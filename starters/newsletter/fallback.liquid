{%- assign accent = brand.colors.primary | default: '#c9a45a' -%}
{%- assign accent2 = brand.colors.secondary | default: '#0c0a08' -%}
{%- assign font_head = brand.fonts.heading | default: 'Work Sans' -%}
{%- assign font_body = brand.fonts.body | default: font_head -%}
{%- assign sender_name = sender.name | default: 'Our team' -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex">
<title>A monthly brief for {{ account.name | escape }}</title>
{%- if font_head == 'Work Sans' %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Work+Sans:wght@400;500&display=swap">
{%- else %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_head | url_encode }}&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_head | url_encode }}:wght@700&display=swap">
{%- endif %}
{%- if font_body != font_head %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_body | url_encode }}&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_body | url_encode }}:wght@500&display=swap">
{%- endif %}
<style>
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:#e7e5e1}
.nb{--p:{{ accent }};--s:{{ accent2 }};--paper:#e7e5e1;--ink:#16140f;--onp:#16140f;--onp:oklch(from var(--p) clamp(0.2, (0.6 - l) * 100, 0.96) min(c, 0.03) h);--ons:#e7e5e1;--ons:oklch(from var(--s) clamp(0.2, (0.6 - l) * 100, 0.92) min(c, 0.02) h);--fh:'{{ font_head }}',ui-sans-serif,system-ui,sans-serif;--fb:'{{ font_body }}',ui-sans-serif,system-ui,sans-serif;--m:clamp(1.25rem,6vw,3rem);min-height:100vh;background:var(--paper);color:var(--ink);font-family:var(--fb);font-size:1.125rem;line-height:1.6;-webkit-font-smoothing:antialiased}
.nb p{margin:0}
.nb h1,.nb h2{font-family:var(--fh);font-weight:500;margin:0;text-wrap:balance}
.stage{background:var(--s);color:var(--ons);padding:1.25rem var(--m) 2.5rem}
.top{display:flex;align-items:center;justify-content:space-between;gap:1rem;font-size:.875rem;margin-bottom:2rem}
.logo{height:26px;width:auto;display:block}
.name{font-family:var(--fh);font-weight:500;font-size:1.125rem}
.env{position:relative;background:var(--paper);color:var(--ink);aspect-ratio:1.55;width:100%;max-width:34rem;padding:1rem 1.1rem;display:flex;flex-direction:column;justify-content:flex-end}
.stamp{position:absolute;top:.9rem;right:1rem;width:19%;aspect-ratio:5 / 6;background:var(--p);transform:rotate(-3deg)}
.to{font-family:var(--fh);font-size:1.125rem;line-height:1.3;margin-left:22%!important}
.read{padding:3rem var(--m) 4rem;max-width:48rem}
.nb h1{font-size:clamp(2rem,5vw,3.5rem);line-height:1.02;letter-spacing:-.035em;max-width:16ch}
.state{font-family:var(--fh);font-size:1.375rem;line-height:1.3;margin-top:1.5rem!important;max-width:30ch}
.hi{font-family:var(--fh);font-size:1.375rem;margin-top:2rem!important}
.intro{margin-top:.5rem!important;max-width:40rem}
.reply{background:var(--s);color:var(--ons);padding:3.5rem var(--m) 3rem}
.reply h2{font-size:clamp(1.75rem,5vw,2.75rem);line-height:1.05;letter-spacing:-.03em;margin-bottom:1rem}
.lead{max-width:38rem}
.cta{margin-top:1.5rem}
.cta .ken-cta{display:inline-block!important;min-height:52px;padding:15px 26px!important;border-radius:2px!important;background:var(--p)!important;color:var(--onp)!important;font-family:var(--fh);font-weight:500!important;font-size:1.125rem;line-height:22px}
.cta .ken-cta:focus-visible{outline:3px solid currentColor;outline-offset:3px}
.sign{margin-top:2rem!important;font-family:var(--fh)}
.sign b{display:block;font-weight:500;font-size:1.25rem}
.foot{margin-top:3rem!important;font-size:.875rem;opacity:.8;max-width:38rem}
@media (min-width:1000px){
.split{display:grid;grid-template-columns:minmax(0,44fr) minmax(0,56fr);min-height:80vh}
.stage{padding:1.5rem 4.5rem 3rem}
.read{padding:5.5rem 3rem 5rem 3.5rem}
.reply{padding:4.5rem 4.5rem 3.5rem}
}
</style>
</head>
<body>
<main class="nb">
<div class="split">
<aside class="stage" aria-label="Envelope">
<div class="top">
{%- if brand.logo_url %}
<img class="logo" src="{{ brand.logo_url | escape }}" alt="{{ brand.name | default: 'Logo' | escape }}">
{%- else %}
<p class="name">{{ brand.name | default: sender_name | escape }}</p>
{%- endif %}
<p>Monthly brief</p>
</div>
<div class="env">
<span class="stamp" aria-hidden="true"></span>
<p class="to">{% if person.first_name %}{{ person.first_name | escape }}{% if person.last_name %} {{ person.last_name | escape }}{% endif %}<br>{% else %}The team at<br>{% endif %}{{ account.name | escape }}</p>
</div>
</aside>
<section data-section="hero" class="read">
<h1>Monthly brief for {{ account.name | escape }}</h1>
<p class="state">This month's brief for {{ account.name | escape }} is still being written.</p>
<p class="hi">Hi {{ person.first_name | default: 'there' | escape }},</p>
<p class="intro">Each month I send one note on your industry, one idea for {{ account.name | escape }} and one thing worth reading. This month's three are not on the page yet. The link stays the same, so check back later today.</p>
</section>
</div>
<section data-section="reply" class="reply">
<h2>Before you go</h2>
<p class="lead">If you would rather hear the three in person, pick a time and I will walk you through them.</p>
<div class="cta">{% render 'ken/cta', label: 'Book 15 minutes', kind: 'booking' %}</div>
<p class="sign"><b>{{ sender_name | escape }}</b>{% if sender.title %}{{ sender.title | escape }}{% if brand.name %}, {{ brand.name | escape }}{% endif %}{% elsif brand.name %}{{ brand.name | escape }}{% endif %}</p>
<p class="foot">Written for {{ account.name | escape }} by {{ sender_name | escape }}. One note, one idea and one resource, once a month.</p>
</section>
</main>
</body>
</html>
