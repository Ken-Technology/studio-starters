{%- assign accent = brand.colors.primary | default: '#c9a45a' -%}
{%- assign accent2 = brand.colors.secondary | default: '#0c0a08' -%}
{%- assign font_head = brand.fonts.heading | default: 'Work Sans' -%}
{%- assign font_body = brand.fonts.body | default: font_head -%}
{%- assign sender_name = sender.name | default: 'Our team' -%}
{%- assign sender_parts = sender_name | split: ' ' -%}
{%- assign sender_first = sender_parts | first -%}
{%- assign stamp_name = brand.name | default: sender_name -%}
{%- assign has_seen = false -%}
{%- if data.note.seen and data.note.seen != '' -%}{%- assign has_seen = true -%}{%- endif -%}
{%- assign has_step = false -%}
{%- if data.idea.first_step and data.idea.first_step != '' -%}{%- assign has_step = true -%}{%- endif -%}
{%- assign has_resource = false -%}
{%- if data.resource.title and data.resource.title != '' -%}{%- assign has_resource = true -%}{%- endif -%}
{%- assign has_url = false -%}
{%- if data.resource.url and data.resource.url != '' -%}{%- assign has_url = true -%}{%- endif -%}
{%- assign has_ps = false -%}
{%- if data.ps and data.ps != '' -%}{%- assign has_ps = true -%}{%- endif -%}
{%- assign kind = data.resource.kind | default: 'resource' -%}
{%- assign open_label = 'Open the ' | append: kind -%}
{%- comment %} The h1 is "Monthly brief for" set small over the account name set large. The name is sized to its own line length: one line when it is short, otherwise half its length or its longest word, so it breaks onto two lines at most and stays large. {% endcomment -%}
{%- assign n_len = account.name.size -%}
{%- assign n_cpl = n_len -%}
{%- if n_len > 13 -%}
{%- assign n_cpl = n_len | plus: 1 | divided_by: 2 | plus: 2 -%}
{%- assign n_words = account.name | split: ' ' -%}
{%- for w in n_words -%}{%- if w.size > n_cpl -%}{%- assign n_cpl = w.size -%}{%- endif -%}{%- endfor -%}
{%- endif -%}
{%- assign n_cpl = n_cpl | at_least: 9 -%}
{%- assign h_fit = 1600 | divided_by: n_cpl | divided_by: 10.0 -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex">
<title>{{ data.headline | escape }}</title>
{%- if font_head == 'Work Sans' %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Work+Sans:wght@300;400;500&display=swap">
{%- else %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_head | url_encode }}&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_head | url_encode }}:wght@700&display=swap">
{%- endif %}
{%- if font_body != font_head %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_body | url_encode }}&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_body | url_encode }}:wght@500&display=swap">
{%- endif %}
<style>
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%;scroll-behavior:smooth}
body{margin:0;background:#e7e5e1}
.nb{--p:{{ accent }};--s:{{ accent2 }};--paper:#e7e5e1;--ink:#16140f;--mute:#57544d;--onp:#16140f;--onp:color(from var(--p) xyz-d65 clamp(0,(.18 - y) * 1000000,.9505) clamp(0,(.18 - y) * 1000000,1) clamp(0,(.18 - y) * 1000000,1.089));--ons:#e7e5e1;--ons:color(from var(--s) xyz-d65 clamp(0,(.18 - y) * 1000000,.9505) clamp(0,(.18 - y) * 1000000,1) clamp(0,(.18 - y) * 1000000,1.089));--fh:'{{ font_head }}',ui-sans-serif,system-ui,sans-serif;--fb:'{{ font_body }}',ui-sans-serif,system-ui,sans-serif;--m:clamp(1.25rem,6vw,3rem);background:var(--paper);color:var(--ink);font-family:var(--fb);font-size:1.125rem;line-height:1.6;-webkit-font-smoothing:antialiased}
.nb p{margin:0}
.nb h1,.nb h2,.nb h3{font-family:var(--fh);font-weight:500;margin:0;text-wrap:balance}
.nb a{color:inherit;text-decoration-thickness:.07em;text-underline-offset:.2em}
.nb a:focus-visible{outline:3px solid currentColor;outline-offset:3px}
.stage{background:var(--s);color:var(--ons);padding:1.25rem var(--m) 2.5rem}
.top{display:flex;align-items:center;justify-content:space-between;gap:1rem;font-size:.875rem;margin-bottom:2rem}
.logo{height:26px;width:auto;display:block}
.name{font-family:var(--fh);font-weight:500;font-size:1.125rem}
.env{position:relative;container-type:inline-size;background:var(--paper);color:var(--ink);aspect-ratio:1.55;width:100%;max-width:34rem;padding:1rem 1.1rem;display:flex;flex-direction:column;justify-content:space-between}
.ret{font-size:.875rem;line-height:1.4;max-width:58%}
.to{font-family:var(--fh);font-size:clamp(1rem,5cqi,1.375rem);line-height:1.3;margin-left:22%!important}
.to b{font-weight:500}
.stamp{position:absolute;top:.9rem;right:1rem;width:19%;transform:rotate(-3deg)}
.stamp svg{display:block;width:100%;height:auto;overflow:visible}
.stamp .face{fill:var(--p)}
.stamp .holes{fill:var(--paper)}
.stamp .glyph{fill:none;stroke:var(--onp);stroke-width:4;stroke-linejoin:round}
.stamp text{fill:var(--onp);font-family:var(--fh);font-weight:500}
.mark{position:absolute;top:1.6rem;right:10%;width:30%;color:var(--ink);opacity:.55}
.mark svg{display:block;width:100%;height:auto}
.mark path,.mark circle{fill:none;stroke:currentColor;stroke-width:2}
.inside{margin-top:1.75rem!important;max-width:32rem;font-size:.875rem;line-height:1.7}
.read{padding:3rem var(--m) 4rem}
.hero{container-type:inline-size}
.nb h1{line-height:1;letter-spacing:-.035em}
.nb h1 .pre{display:block;font-size:clamp(1.375rem,4.4cqi,2.25rem);letter-spacing:-.015em;line-height:1.2;margin-bottom:.35em}
.nb h1 .who{display:block;font-size:clamp(2rem,{{ h_fit }}cqi,7.5rem);text-wrap:balance}
.headline{font-family:var(--fh);font-weight:400;font-size:1.5rem;line-height:1.25;letter-spacing:-.015em;margin-top:2rem!important;max-width:30ch}
.hi{font-family:var(--fh);font-size:1.375rem;margin-top:2.5rem!important}
.intro{margin-top:.5rem!important;max-width:42rem}
.part{padding-top:4.5rem}
.nb h2{font-size:1.25rem;line-height:1.2;letter-spacing:-.02em;max-width:30ch;margin-bottom:1.25rem}
.prose{max-width:42rem}
.nb h3{font-size:1.125rem;line-height:1.3;margin-bottom:.3rem}
.seen{margin-top:1.75rem;max-width:42rem}
.seen p{color:var(--mute)}
.step{margin-top:1.75rem;max-width:42rem;padding:1.25rem 1.4rem;background:color-mix(in oklab,var(--p) 26%,var(--paper))}
.slip{background:var(--s);color:var(--ons);padding:1.6rem 1.5rem 1.75rem;max-width:42rem}
.slip-title{font-family:var(--fh);font-size:1.375rem;line-height:1.25;letter-spacing:-.015em;margin-bottom:.75rem!important}
.slip-kind{margin-top:1rem!important;font-size:.875rem}
.cta{margin-top:1.5rem}
.cta .ken-cta{display:inline-block!important;min-height:52px;padding:15px 26px!important;border-radius:2px!important;background:var(--p)!important;color:var(--onp)!important;font-family:var(--fh);font-weight:500!important;font-size:1.125rem;line-height:22px}
.cta .ken-cta:focus-visible{outline:3px solid currentColor;outline-offset:3px}
.muted{color:var(--mute);margin-top:1rem!important}
.slip .muted{color:inherit}
.reply{background:var(--s);color:var(--ons);padding:4rem var(--m) 3rem}
.reply-in{max-width:44rem}
.nb .reply h2{font-size:clamp(2rem,6vw,3.5rem);line-height:1;letter-spacing:-.035em;max-width:14ch;margin-bottom:1.5rem}
.lead{max-width:38rem}
.sign{margin-top:2rem!important;font-family:var(--fh)}
.sign b{display:block;font-weight:500;font-size:1.25rem}
.ps{margin-top:2rem!important;max-width:38rem}
.ps b{font-weight:500;margin-right:.4rem}
.foot{margin-top:3.5rem!important;font-size:.875rem;max-width:38rem}
@media (prefers-reduced-motion:no-preference){
.stamp{animation:land .55s cubic-bezier(.3,1.3,.5,1) .35s both}
.mark{animation:post .3s ease-out .8s both}
@keyframes land{from{transform:translate(10%,-14%) rotate(-16deg) scale(1.3)}to{transform:rotate(-3deg)}}
@keyframes post{from{transform:translateX(-12%)}to{transform:none}}
}
@media (min-width:760px){
.nb h2{font-size:1.75rem}
.headline{font-size:2rem}
.slip-title{font-size:1.375rem}
.slip{padding:2rem 2.25rem 2.25rem}
}
@media (min-width:1000px){
.split{display:grid;grid-template-columns:minmax(0,44fr) minmax(0,56fr)}
.stage{position:sticky;top:0;height:100svh;display:flex;flex-direction:column;padding:1.5rem 4.5rem 2.5rem}
.stage .top{margin-bottom:auto}
.stage .env{margin-top:2rem}
.inside{margin-bottom:auto!important}
.read{padding:5.5rem 3rem 6rem 3.5rem}
.headline{font-size:2.25rem}
.part{padding-top:6rem}
.nb h2{font-size:2rem}
.reply{padding:6rem 3rem 3.5rem 4.5rem}
.reply-in{display:grid;grid-template-columns:minmax(0,44fr) minmax(0,56fr);max-width:none}
.reply-in>h2{grid-column:1;padding-right:2rem}
.reply-in>div{grid-column:2;padding-left:1rem}
.foot{grid-column:2;padding-left:1rem}
}
</style>
</head>
<body>
<main class="nb">
<div class="split">
<aside class="stage" aria-label="Envelope">
<div class="top">
{%- if brand.logo_url %}
<img class="logo" src="{{ brand.logo_url | escape }}" alt="{{ brand.name | default: 'Logo' | escape }}">
{%- else %}
<p class="name">{{ brand.name | default: sender_name | escape }}</p>
{%- endif %}
<p>Monthly brief</p>
</div>
<div class="env">
<p class="ret">From {{ sender_name | escape }}{% if brand.name %}<br>{{ brand.name | escape }}{% endif %}</p>
<div class="mark" aria-hidden="true"><svg viewBox="0 0 120 50"><circle cx="25" cy="25" r="21"/><path d="M50 12c8-5 14 5 22 0s14-5 22 0 14 5 22 0"/><path d="M50 25c8-5 14 5 22 0s14-5 22 0 14 5 22 0"/><path d="M50 38c8-5 14 5 22 0s14-5 22 0 14 5 22 0"/></svg></div>
<div class="stamp" aria-hidden="true"><svg viewBox="0 0 100 120"><rect class="face" width="100" height="120"/>{% for k in (0..9) %}<circle class="holes" cx="{{ k | times: 10 | plus: 5 }}" cy="0" r="3.4"/><circle class="holes" cx="{{ k | times: 10 | plus: 5 }}" cy="120" r="3.4"/>{% endfor %}{% for k in (0..11) %}<circle class="holes" cx="0" cy="{{ k | times: 10 | plus: 5 }}" r="3.4"/><circle class="holes" cx="100" cy="{{ k | times: 10 | plus: 5 }}" r="3.4"/>{% endfor %}<text x="50" y="98" text-anchor="middle" font-size="15"{% if stamp_name.size > 8 %} textLength="78" lengthAdjust="spacingAndGlyphs"{% endif %}>{{ stamp_name | escape }}</text><path class="glyph" d="M24 30h52v38H24z M24 30l26 21 26-21"/></svg></div>
<p class="to">{% if person.first_name %}<b>{{ person.first_name | escape }}{% if person.last_name %} {{ person.last_name | escape }}{% endif %}</b>{% if person.title %}<br>{{ person.title | escape }}{% endif %}<br>{{ account.name | escape }}{% else %}<b>The team at</b><br>{{ account.name | escape }}{% endif %}</p>
</div>
<p class="inside">Inside: <a href="#note">a note on your industry</a>, <a href="#idea">one idea for {{ account.name | escape }}</a> and <a href="#resource">one thing worth your time</a>.</p>
</aside>
<div class="read">
<section data-section="hero" class="hero">
<h1><span class="pre">Monthly brief for</span> <span class="who">{{ account.name | escape }}</span></h1>
<p class="headline">{{ data.headline | escape }}</p>
<p class="hi">Hi {{ person.first_name | default: 'there' | escape }},</p>
<p class="intro">{{ data.intro | escape }}</p>
</section>
<section data-section="note" id="note" class="part">
<h2>{{ data.note.title | escape }}</h2>
<div class="prose"><p>{{ data.note.body | escape | newline_to_br | strip_newlines | raw }}</p></div>
{%- if has_seen %}
<div class="seen"><h3>What prompted it</h3><p>{{ data.note.seen | escape }}</p></div>
{%- endif %}
</section>
<section data-section="idea" id="idea" class="part">
<h2>{{ data.idea.title | escape }}</h2>
<div class="prose"><p>{{ data.idea.body | escape | newline_to_br | strip_newlines | raw }}</p></div>
{%- if has_step %}
<div class="step"><h3>Where to start</h3><p>{{ data.idea.first_step | escape }}</p></div>
{%- endif %}
</section>
<section data-section="resource" id="resource" class="part">
<h2>One thing worth your time</h2>
{%- if has_resource %}
<div class="slip">
<p class="slip-title">{{ data.resource.title | escape }}</p>
<p>{{ data.resource.summary | escape }}</p>
<p class="slip-kind">{{ kind | capitalize | escape }}, picked by {{ sender_first | escape }}.</p>
{%- if has_url %}
<div class="cta">{% render 'ken/cta', id: 'resource', label: open_label, href: data.resource.url %}</div>
{%- else %}
<p class="muted">Reply to the email this came with and I will send it over.</p>
{%- endif %}
</div>
{%- else %}
<div class="prose"><p>I did not want to send something generic here. Reply with what you are working on this month and I will send the one thing that fits.</p></div>
{%- endif %}
</section>
</div>
</div>
<section data-section="reply" class="reply">
<div class="reply-in">
<h2>Before you go</h2>
<div>
<p class="lead">That is the brief. If one of the three is worth a conversation, pick a time below. If not, the next one comes in a month.</p>
<div class="cta">{% render 'ken/cta', label: 'Book 15 minutes', kind: 'booking' %}</div>
<p class="sign"><b>{{ sender_name | escape }}</b>{% if sender.title %}{{ sender.title | escape }}{% if brand.name %}, {{ brand.name | escape }}{% endif %}{% elsif brand.name %}{{ brand.name | escape }}{% endif %}</p>
{%- if has_ps %}
<p class="ps"><b>PS</b>{{ data.ps | escape }}</p>
{%- endif %}
</div>
<p class="foot">Written for {{ account.name | escape }} by {{ sender_name | escape }}. One note, one idea and one resource, once a month.</p>
</div>
</section>
</main>
</body>
</html>
