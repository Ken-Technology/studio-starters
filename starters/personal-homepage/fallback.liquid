{%- assign bname = brand.name | default: 'Northbeam' -%}
{%- assign primary = brand.colors.primary | default: '#000000' -%}
{%- assign secondary = brand.colors.secondary | default: '#000000' -%}
{%- assign font_head = brand.fonts.heading | default: 'Bricolage Grotesque' -%}
{%- assign font_body = brand.fonts.body | default: 'Bricolage Grotesque' -%}
{%- assign head_q = font_head | replace: ' ', '+' -%}
{%- assign body_q = font_body | replace: ' ', '+' -%}
{%- assign sender_first = sender.name | default: 'our team' | split: ' ' | first -%}
{%- assign has_brand_colour = false -%}
{%- if brand.colors.primary and brand.colors.primary != '' -%}{%- assign has_brand_colour = true -%}{%- endif -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex">
<title>{{ bname | escape }} for {{ account.name | escape }}</title>
{%- if font_head == 'Bricolage Grotesque' %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,700&display=swap">
{%- else %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ head_q | escape }}:wght@400;700&display=swap">
{%- endif %}
{%- if font_body != font_head %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ body_q | escape }}:wght@400;700&display=swap">
{%- endif %}
<style>
:root{--p:{{ primary | escape }};--hero:{{ secondary | escape }};--fh:'{{ font_head | escape }}',ui-sans-serif,system-ui,sans-serif;--fb:'{{ font_body | escape }}',ui-sans-serif,system-ui,sans-serif;--manila:{% if has_brand_colour %}color-mix(in srgb,var(--p) 16%,#fff){% else %}#efd38d{% endif %};--m:clamp(1.25rem,3.4vw,3rem)}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:var(--hero);font:400 clamp(1.0625rem,1rem + .25vw,1.1875rem)/1.5 var(--fb);-webkit-font-smoothing:antialiased;overflow-wrap:break-word}
h1{font-family:var(--fh);font-weight:700;margin:0;line-height:.98;letter-spacing:-.04em;text-wrap:balance;font-size:clamp(2.25rem,1rem + 5vw,5rem);max-width:15ch}
p{margin:0}
a:focus-visible{outline:3px solid currentColor;outline-offset:4px}
.on{color:#000;color:rgb(from var(--f) clamp(0,(12800 - (r * r * .2126 + g * g * .7152 + b * b * .0722)) * 999,255) clamp(0,(12800 - (r * r * .2126 + g * g * .7152 + b * b * .0722)) * 999,255) clamp(0,(12800 - (r * r * .2126 + g * g * .7152 + b * b * .0722)) * 999,255));background:var(--f)}
.hero{--f:var(--hero);padding:1.25rem var(--m) clamp(3rem,8vw,6rem)}
.top{font:700 1.125rem/1 var(--fh);min-height:2.75rem;display:flex;align-items:center}
.top img{display:block;height:28px;width:auto;max-width:9rem;object-fit:contain}
.hero h1{margin-top:clamp(2.5rem,8vh,5rem)}
.sub{font-size:clamp(1.25rem,1.1rem + .7vw,1.625rem);line-height:1.35;max-width:40ch;margin-top:1.5rem}
.made{font-size:.9375rem;margin-top:1rem;opacity:.8}
.file{--f:var(--manila)}
.tab{display:inline-block;margin:0 var(--m);padding:.7rem 2rem .65rem;font-weight:700;clip-path:polygon(10px 0,calc(100% - 10px) 0,100% 100%,0 100%)}
.sheet{padding:clamp(1.75rem,4vw,3rem) var(--m) clamp(3rem,6vw,4.5rem);display:grid;gap:1.25rem;justify-items:start}
.sheet .ken-cta{background:var(--p)!important;border-radius:999px!important;padding:.85rem 1.4rem!important;font-weight:700!important;color:#fff!important;color:rgb(from var(--p) clamp(0,(12800 - (r * r * .2126 + g * g * .7152 + b * b * .0722)) * 999,255) clamp(0,(12800 - (r * r * .2126 + g * g * .7152 + b * b * .0722)) * 999,255) clamp(0,(12800 - (r * r * .2126 + g * g * .7152 + b * b * .0722)) * 999,255))!important}
.sheet .ken-cta:focus-visible{outline:3px solid #000;outline-offset:3px}
</style>
</head>
<body>
<section class="hero on" data-section="hero">
  <header class="top">{%- if brand.logo_url and brand.logo_url != '' %}<img src="{{ brand.logo_url }}" alt="{{ bname | escape }}">{% else %}{{ bname | escape }}{% endif -%}</header>
  <h1>A page for {{ account.name | escape }} is on its way</h1>
  <p class="sub">I am putting together what {{ bname | escape }} could do for {{ account.name | escape }}, based on your site. It is not ready on this page yet. The quickest way to see it is a short call.</p>
  <p class="made">A page for {% if person.first_name and person.first_name != '' %}{{ person.first_name | escape }} at {% else %}the team at {% endif %}{{ account.name | escape }}</p>
</section>
<section class="file" data-section="booking">
  <span class="tab on">{{ account.name | escape }}</span>
  <div class="sheet on">
    <p>{% render 'ken/cta', label: 'Book 20 minutes', kind: 'booking' %}</p>
    <p>{{ sender.name | default: 'Our team' | escape }}{% if sender.title and sender.title != '' %}, {{ sender.title | escape }}{% endif %}, {{ bname | escape }}. This is a private link.</p>
  </div>
</section>
</body>
</html>
