{%- assign bname = brand.name | default: 'Northbeam' -%}
{%- assign primary = brand.colors.primary | default: '#2a4bd7' -%}
{%- assign secondary = brand.colors.secondary | default: '#0e1530' -%}
{%- assign font_head = brand.fonts.heading | default: 'Inter Tight' -%}
{%- assign font_body = brand.fonts.body | default: 'Inter' -%}
{%- assign head_q = font_head | replace: ' ', '+' -%}
{%- assign body_q = font_body | replace: ' ', '+' -%}
{%- assign sender_first = sender.name | default: 'our team' | split: ' ' | first -%}
{%- assign sender_full = sender.name | default: 'Our team' -%}
{%- assign nav_label = 'Book time with ' | append: sender_first -%}
{%- assign top = 0 -%}
{%- for p in data.story.chart -%}{%- if p.value > top -%}{%- assign top = p.value -%}{%- endif -%}{%- endfor -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex">
<meta name="description" content="{{ bname | escape }} for {{ account.name | escape }}: what we noticed, three places we would help, a customer story, how a rollout would go and a time to talk.">
<title>{{ bname | escape }} for {{ account.name | escape }}</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ head_q | escape }}:wght@500;600;700&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ body_q | escape }}:wght@400;500;600&display=swap">
<style>
:root{
  --p:{{ primary | escape }};
  --s:{{ secondary | escape }};
  --fh:'{{ font_head | escape }}',ui-sans-serif,system-ui,sans-serif;
  --fb:'{{ font_body | escape }}',ui-sans-serif,system-ui,sans-serif;
  --ink:var(--s);
  --mute:color-mix(in srgb,var(--s) 62%,#fff);
  --faint:color-mix(in srgb,var(--s) 45%,#fff);
  --line:color-mix(in srgb,var(--s) 13%,#fff);
  --paper:color-mix(in srgb,var(--p) 5%,#fff);
  --tint:color-mix(in srgb,var(--p) 10%,#fff);
  --tint-line:color-mix(in srgb,var(--p) 30%,#fff);
  --p-deep:color-mix(in srgb,var(--p) 72%,var(--s));
  --on-dark:color-mix(in srgb,#fff 88%,var(--s));
  --on-dark-mute:color-mix(in srgb,#fff 62%,var(--s));
  --p-light:color-mix(in srgb,var(--p) 70%,#fff);
}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%;scroll-behavior:smooth}
body{margin:0;background:#fff;color:var(--ink);font:16px/1.55 var(--fb);-webkit-font-smoothing:antialiased;font-variant-numeric:tabular-nums;overflow-wrap:break-word}
a{color:var(--p-deep)}
h1,h2,h3{font-family:var(--fh);margin:0;line-height:1.1;letter-spacing:-.015em;font-weight:600;text-wrap:balance}
h2{font-size:1.75rem;max-width:22ch}
p{margin:0 0 .9rem}
.wrap{max-width:72rem;margin:0 auto;padding:0 1.1rem}
.btn{display:inline-block;background:var(--p);color:#fff;text-decoration:none;font-weight:500;padding:.8rem 1.25rem;border-radius:4px;font-size:.98rem;line-height:1.55}
.btn.ghost{background:none;color:var(--ink);border:1px solid var(--line)}
.btn:focus-visible,a:focus-visible,summary:focus-visible{outline:2px solid var(--p);outline-offset:3px}

/* nav */
.nav{display:flex;align-items:center;gap:.75rem;padding:.9rem 0;border-bottom:1px solid var(--line)}
.brand{display:flex;align-items:center;gap:.55rem;font-weight:600;font-family:var(--fh);font-size:1.02rem;min-width:0}
.brand b{font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.logo{width:28px;height:28px;display:block;flex:none;object-fit:contain}
img.logo{width:auto;max-width:7.5rem}
.for{font-size:.82rem;color:var(--p-deep);background:var(--tint);padding:.3rem .65rem;border-radius:999px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;min-width:0}
.nav-cta{margin-left:auto;display:none}
.nav-cta a{display:inline-block;background:var(--p);color:#fff;text-decoration:none;font-weight:500;padding:.55rem .9rem;border-radius:4px;font-size:.88rem;white-space:nowrap}
.nav-cta a:focus-visible{outline:2px solid var(--p);outline-offset:3px}

/* hero */
.hero{padding:2.6rem 0 2.8rem;display:grid;gap:2rem}
.hero .made{font-size:.9rem;color:var(--mute);margin-bottom:1.1rem}
.hero h1{font-size:2.5rem;max-width:16ch}
.hero .sub{font-size:1.1rem;max-width:34rem;color:var(--mute);margin:1.1rem 0 1.5rem}
.hero .acts{display:flex;flex-wrap:wrap;gap:.6rem}
.signals{background:var(--paper);border:1px solid var(--tint-line);border-radius:8px;padding:1.3rem 1.3rem 1rem;align-self:start}
.signals h3{font-size:1.02rem;margin-bottom:.9rem}
.signals ol{list-style:none;margin:0;padding:0;counter-reset:sig}
.signals li{position:relative;padding:.75rem 0 .75rem 1.9rem;border-top:1px solid var(--tint-line)}
.signals li::before{counter-increment:sig;content:counter(sig);position:absolute;left:0;top:.85rem;width:1.25rem;height:1.25rem;border-radius:50%;background:var(--p);color:#fff;font-size:.72rem;font-weight:600;display:grid;place-items:center;font-family:var(--fh)}
.signals b{display:block;font-weight:500;line-height:1.35}
.signals span{display:block;font-size:.8rem;color:var(--mute);margin-top:.2rem}
.signals span a{color:var(--mute)}
.signals .src{font-size:.78rem;color:var(--faint);margin:.8rem 0 0}

/* use cases */
.uses{padding:3rem 0 2.5rem;border-top:1px solid var(--line)}
.uses h2{margin-bottom:.6rem}
.uses .lead{color:var(--mute);max-width:40rem;margin-bottom:2rem}
.ugrid{display:grid;gap:0}
.use{padding:1.4rem 0;border-top:1px solid var(--line)}
.use h3{font-size:1.3rem;margin-bottom:1rem;max-width:18ch}
.use dl{margin:0;display:grid;gap:.75rem}
.use dt{font-size:.78rem;color:var(--p-deep);font-weight:500}
.use dd{margin:.15rem 0 0;color:var(--mute);font-size:.95rem}
.use dd.after{color:var(--ink)}

/* proof */
.proof{background:var(--s);color:var(--on-dark);padding:3rem 0 3.2rem}
.proof .wrap{display:grid;gap:2rem}
.proof .tag{display:inline-block;font-size:.8rem;color:var(--on-dark-mute);border:1px solid color-mix(in srgb,#fff 25%,var(--s));padding:.3rem .65rem;border-radius:999px;margin-bottom:1.2rem}
.proof h2{color:#fff;max-width:20ch}
.proof .who{color:var(--on-dark-mute);margin:.6rem 0 1.6rem;max-width:30rem}
.proof blockquote{margin:0;font-family:var(--fh);font-size:1.35rem;line-height:1.35;font-weight:500;color:#fff;max-width:26ch}
.proof cite{display:block;font-style:normal;font-family:var(--fb);font-size:.9rem;color:var(--on-dark-mute);margin-top:1rem}
.proof figure{margin:0;background:color-mix(in srgb,#fff 6%,var(--s));border:1px solid color-mix(in srgb,#fff 12%,var(--s));border-radius:8px;padding:1.2rem 1.2rem 1rem;align-self:end}
.proof figcaption{font-size:.9rem;color:#fff;margin-bottom:.9rem}
.proof figcaption span{display:block;font-size:.8rem;color:var(--on-dark-mute);margin-top:.15rem}
.bars{display:flex;align-items:stretch;gap:.4rem;height:11.5rem;margin:0;padding:0;list-style:none;border-bottom:1px solid color-mix(in srgb,#fff 22%,var(--s))}
.bars li{flex:1 1 0;min-width:0;display:flex;flex-direction:column;justify-content:flex-end;align-items:center;gap:.3rem}
.bars .v{font-size:.75rem;color:var(--on-dark-mute);line-height:1}
.bars .on .v{color:#fff;font-weight:600;font-size:.82rem}
.bars .fill{display:block;width:100%;height:calc((100% - 1.6rem) * var(--h) / 100);min-height:3px;background:var(--p-light);border-radius:3px 3px 0 0}
.bars .on .fill{background:color-mix(in srgb,var(--p-light) 75%,#fff)}
.ticks{display:flex;gap:.4rem;margin:.45rem 0 0;padding:0;list-style:none}
.ticks li{flex:1 1 0;min-width:0;text-align:center;font-size:.72rem;color:var(--on-dark-mute);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.proof .note{font-size:.78rem;color:var(--on-dark-mute);margin:.9rem 0 0}

/* rollout */
.roll{padding:3rem 0 2.5rem}
.roll h2{margin-bottom:.6rem}
.roll .lead{color:var(--mute);max-width:40rem;margin-bottom:2rem}
.steps{list-style:none;margin:0;padding:0;display:grid;gap:0;position:relative;counter-reset:st}
.steps li{position:relative;padding:0 0 1.6rem 2.4rem}
.steps li::before{counter-increment:st;content:counter(st);position:absolute;left:0;top:0;width:1.7rem;height:1.7rem;border-radius:50%;border:2px solid var(--p);color:var(--p-deep);background:#fff;font-family:var(--fh);font-weight:600;font-size:.85rem;display:grid;place-items:center;z-index:1}
.steps li::after{content:'';position:absolute;left:.8rem;top:1.7rem;bottom:0;width:2px;background:var(--line)}
.steps li:last-child::after{display:none}
.steps .when{font-size:.8rem;color:var(--p-deep);font-weight:500;display:block}
.steps h3{font-size:1.15rem;margin:.1rem 0 .4rem}
.steps p{color:var(--mute);font-size:.95rem;max-width:30rem;margin:0}

/* faq */
.faq{padding:2.5rem 0 3rem;border-top:1px solid var(--line)}
.faq h2{margin-bottom:1.2rem}
.faq details{border-top:1px solid var(--line)}
.faq details:last-child{border-bottom:1px solid var(--line)}
.faq summary{cursor:pointer;list-style:none;padding:.95rem 2rem .95rem 0;font-weight:500;position:relative;font-size:1.02rem;min-height:44px}
.faq summary::-webkit-details-marker{display:none}
.faq summary::after{content:'';position:absolute;right:.3rem;top:1.25rem;width:.55rem;height:.55rem;border:solid var(--p-deep);border-width:0 1.5px 1.5px 0;transform:rotate(45deg);transition:transform .15s}
.faq details[open] summary::after{transform:rotate(225deg);top:1.45rem}
.faq details p{color:var(--mute);max-width:40rem;margin:0 0 1rem;font-size:.97rem}

/* booking */
.booking{padding:3rem 0 3.5rem;background:var(--paper);border-top:1px solid var(--line)}
.booking .wrap{display:grid;gap:1.6rem}
.booking h2{margin-bottom:.6rem}
.booking .lead{color:var(--mute);max-width:28rem}
.cal{background:#fff;border:1px solid var(--line);border-radius:8px;padding:.6rem;color:var(--mute);min-width:0}

footer{padding:1.5rem 0 2.5rem;font-size:.82rem;color:var(--mute);border-top:1px solid var(--line)}
footer .brand{margin-bottom:.5rem;font-size:.95rem;color:var(--ink)}
footer .logo{width:22px;height:22px}
footer img.logo{width:auto;max-width:6rem}

@media (min-width:720px){
  .nav-cta{display:block}
  .hero{grid-template-columns:minmax(0,7fr) minmax(0,5fr);gap:3rem;padding:4rem 0 4.5rem;align-items:center}
  .hero h1{font-size:3.4rem}
  .ugrid{grid-template-columns:repeat(3,minmax(0,1fr));gap:0 2.5rem}
  .use{padding:1.6rem 0 .5rem;border-top:2px solid var(--ink)}
  .proof .wrap{grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:3rem;align-items:end}
  .steps{grid-template-columns:repeat(3,minmax(0,1fr));gap:2rem}
  .steps li{padding:2.6rem 0 0 0}
  .steps li::before{top:0;left:0}
  .steps li::after{left:2.2rem;right:-2rem;top:.8rem;bottom:auto;height:2px;width:auto}
  .booking .wrap{grid-template-columns:minmax(0,1fr) 26rem;gap:4rem;align-items:start}
}
@media (min-width:1000px){
  .wrap{padding:0 2rem}
  .hero h1{font-size:4rem}
  .uses,.roll{padding-top:4rem}
  .proof{padding:4rem 0}
}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}.faq summary::after{transition:none}}
</style>
</head>
<body>
<div class="wrap">
<nav class="nav">
  <div class="brand">
    {%- if brand.logo_url and brand.logo_url != '' %}<img class="logo" src="{{ brand.logo_url }}" alt="">{% else %}<svg class="logo" viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="8" fill="var(--p)"/><text x="16" y="21.5" text-anchor="middle" style="font-family:var(--fh);font-weight:700;font-size:16px" fill="#fff">{{ bname | slice: 0, 1 | upcase | escape }}</text></svg>{% endif -%}
    <b>{{ bname | escape }}</b>
  </div>
  <span class="for">for {{ account.name | escape }}</span>
  <span class="nav-cta">{% render 'ken/cta', label: nav_label, kind: 'booking', variant: 'link', id: 'nav-booking' %}</span>
</nav>

<section class="hero" data-section="hero">
  <div>
    <p class="made">A page for {% if person.first_name and person.first_name != '' %}{{ person.first_name | escape }}{% if person.last_name and person.last_name != '' %} {{ person.last_name | escape }}{% endif %}{% if person.title and person.title != '' %}, {{ person.title | escape }}{% endif %} at {% else %}the team at {% endif %}{{ account.name | escape }}</p>
    <h1>{{ data.hero.headline | escape }}</h1>
    <p class="sub">{{ data.hero.sub | escape }}</p>
    <div class="acts"><a class="btn" href="#rollout">See the rollout at {{ account.name | escape }}</a><a class="btn ghost" href="#book">Book 20 minutes</a></div>
  </div>
  <aside class="signals">
    <h3>What we noticed at {{ account.name | escape }}</h3>
    <ol>
      {%- for n in data.noticed %}
      <li><b>{{ n.fact | escape }}</b><span>{% if n.source_url contains 'https://' %}<a href="{{ n.source_url | escape }}" target="_blank" rel="noopener noreferrer">{{ n.source | escape }}</a>{% else %}{{ n.source | escape }}{% endif %}</span></li>
      {%- endfor %}
    </ol>
    <p class="src">From {{ account.name | escape }}'s site and public notices. Tell {{ sender_first | escape }} if any of this is off.</p>
  </aside>
</section>
</div>

<section class="uses" data-section="uses">
<div class="wrap">
  <h2>Three things {{ bname | escape }} would do for {{ account.name | escape }}</h2>
  <p class="lead">{{ data.uses_lead | escape }}</p>
  <div class="ugrid">
    {%- for u in data.uses %}
    <article class="use">
      <h3>{{ u.title | escape }}</h3>
      <dl>
        <div><dt>Today at {{ account.name | escape }}</dt><dd>{{ u.today | escape }}</dd></div>
        <div><dt>With {{ bname | escape }}</dt><dd class="after">{{ u.after | escape }}</dd></div>
      </dl>
    </article>
    {%- endfor %}
  </div>
</div>
</section>

{%- if data.story and data.story.chart and top > 0 %}
{%- assign first_pt = data.story.chart | first -%}
{%- assign last_pt = data.story.chart | last %}
<section class="proof" data-section="proof">
<div class="wrap">
  <div>
    <span class="tag">Customer story</span>
    <h2>{{ data.story.headline | escape }}</h2>
    <p class="who">{{ data.story.who | escape }}</p>
    {%- if data.story.quote and data.story.quote.text and data.story.quote.text != '' %}
    <blockquote>{{ data.story.quote.text | escape }}{% if data.story.quote.author_title and data.story.quote.author_title != '' %}<cite>{{ data.story.quote.author_title | escape }}</cite>{% endif %}</blockquote>
    {%- endif %}
  </div>
  <figure>
    <figcaption>{{ data.story.chart_title | escape }}{% if data.story.chart_note and data.story.chart_note != '' %}<span>{{ data.story.chart_note | escape }}</span>{% endif %}</figcaption>
    <ul class="bars" role="img" aria-label="Bar chart: {{ data.story.chart_title | escape }}, from {{ first_pt.value }} at {{ first_pt.label | escape }} to {{ last_pt.value }} at {{ last_pt.label | escape }}">
      {%- for p in data.story.chart %}
      {%- assign pct = p.value | times: 100.0 | divided_by: top | round %}
      <li{% if forloop.first or forloop.last %} class="on"{% endif %}><span class="v">{{ p.value }}</span><span class="fill" style="--h:{{ pct }}"></span></li>
      {%- endfor %}
    </ul>
    <ul class="ticks" aria-hidden="true">
      {%- for p in data.story.chart %}<li>{{ p.label | escape }}</li>{% endfor %}
    </ul>
  </figure>
</div>
</section>
{%- endif %}

<section class="roll" id="rollout" data-section="rollout">
<div class="wrap">
  <h2>How a rollout would go at {{ account.name | escape }}</h2>
  <p class="lead">{{ data.rollout_lead | escape }}</p>
  <ol class="steps">
    {%- for s in data.rollout %}
    <li><span class="when">{{ s.when | escape }}</span><h3>{{ s.title | escape }}</h3><p>{{ s.body | escape }}</p></li>
    {%- endfor %}
  </ol>
</div>
</section>

<section class="faq" data-section="faq">
<div class="wrap">
  <h2>Questions people ask before a first call</h2>
  {%- for f in data.faq %}
  <details><summary>{{ f.q | escape }}</summary><p>{{ f.a | escape }}</p></details>
  {%- endfor %}
</div>
</section>

<section class="booking" id="book" data-section="booking">
<div class="wrap">
  <div>
    <h2>Pick a time with {{ sender_first | escape }}</h2>
    <p class="lead">Twenty minutes on video. Bring whoever else should see this, and we will go through the rollout for {{ account.name | escape }} together.</p>
    <p class="lead">{{ sender_full | escape }}{% if sender.title and sender.title != '' %}, {{ sender.title | escape }} at {% else %} at {% endif %}{{ bname | escape }}.</p>
  </div>
  <div class="cal">{% render 'ken/booking', height: 560, title: 'Book 20 minutes' %}</div>
</div>
</section>

<footer>
<div class="wrap">
  <div class="brand">
    {%- if brand.logo_url and brand.logo_url != '' %}<img class="logo" src="{{ brand.logo_url }}" alt="">{% else %}<svg class="logo" viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="8" fill="var(--p)"/><text x="16" y="21.5" text-anchor="middle" style="font-family:var(--fh);font-weight:700;font-size:16px" fill="#fff">{{ bname | slice: 0, 1 | upcase | escape }}</text></svg>{% endif -%}
    <b>{{ bname | escape }}</b>
  </div>
  This page was made for {% if person.first_name and person.first_name != '' %}{{ person.first_name | escape }} at {% else %}the team at {% endif %}{{ account.name | escape }} by {{ sender_full | escape }}. It is a private link. Nothing on it is public.
</div>
</footer>
</body>
</html>
