{%- assign bname = brand.name | default: 'Northbeam' -%}
{%- assign primary = brand.colors.primary | default: '#000000' -%}
{%- assign secondary = brand.colors.secondary | default: '#000000' -%}
{%- assign font_head = brand.fonts.heading | default: 'Besley' -%}
{%- assign font_body = brand.fonts.body | default: 'Libre Franklin' -%}
{%- assign sender_first = sender.name | default: 'our team' | split: ' ' | first -%}
{%- assign sender_full = sender.name | default: 'Our team' -%}
{%- assign nav_label = 'Book time with ' | append: sender_first -%}
{%- assign has_brand_colour = false -%}
{%- if brand.colors.primary and brand.colors.primary != '' -%}{%- assign has_brand_colour = true -%}{%- endif -%}
{%- assign hl_size = data.hero.headline | size -%}
{%- assign top = 0 -%}
{%- for p in data.story.chart -%}{%- if p.value > top -%}{%- assign top = p.value -%}{%- endif -%}{%- endfor -%}
{%- assign has_story = false -%}
{%- if data.story and data.story.chart and top > 0 -%}{%- assign has_story = true -%}{%- endif -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex">
<meta name="description" content="{{ bname | escape }} for {{ account.name | escape }}: what we noticed, three places we would help, a customer story, how a rollout would go and a time to talk.">
<title>{{ bname | escape }} for {{ account.name | escape }}</title>
{%- if font_head == 'Besley' %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Besley:wght@700;800&display=swap">
{%- else %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_head | url_encode }}&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_head | url_encode }}:wght@700&display=swap">
{%- endif %}
{%- if font_body != font_head %}
{%- if font_body == 'Libre Franklin' %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Libre+Franklin:wght@400;700&display=swap">
{%- else %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_body | url_encode }}&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_body | url_encode }}:wght@700&display=swap">
{%- endif %}
{%- endif %}
<style>
:root{
  --p:{{ primary | escape }};
  --hero:{{ secondary | escape }};
  --fh:'{{ font_head | escape }}',ui-sans-serif,system-ui,sans-serif;
  --fb:'{{ font_body | escape }}',ui-sans-serif,system-ui,sans-serif;
  --ink:#000;
  --paper:#fff;
{%- if has_brand_colour %}
  --manila:color-mix(in srgb,var(--p) 16%,#fff);
  --mint:color-mix(in srgb,var(--p) 34%,#fff);
  --deep:color-mix(in srgb,var(--p) 82%,#000);
  --orange:color-mix(in srgb,var(--p) 55%,#fff);
{%- else %}
  --manila:#efd38d;
  --mint:#a9dfb4;
  --deep:#1f5c45;
  --orange:#f5ad74;
{%- endif %}
  --step-small:clamp(.875rem,.85rem + .1vw,.9375rem);
  --step-body:clamp(1.0625rem,1rem + .25vw,1.1875rem);
  --step-lead:clamp(1.25rem,1.1rem + .7vw,1.625rem);
  --step-head:clamp(2.125rem,1.3rem + 3.2vw,4rem);
  --m:clamp(1.25rem,3.4vw,3rem);
}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%;scroll-behavior:smooth}
body{margin:0;background:var(--hero);color:var(--ink);font:400 var(--step-body)/1.5 var(--fb);-webkit-font-smoothing:antialiased;font-variant-numeric:tabular-nums;overflow-wrap:break-word;font-optical-sizing:auto}
h1,h2,h3{font-family:var(--fh);font-weight:700;margin:0;line-height:1;letter-spacing:-.03em;text-wrap:balance}
p{margin:0;text-wrap:pretty}
a{color:inherit;text-underline-offset:.18em;text-decoration-thickness:.07em}
a:focus-visible,summary:focus-visible{outline:3px solid currentColor;outline-offset:4px}
/* every field picks black or white text from its own colour, so any brand colour stays readable */
.on{color:#000;color:rgb(from var(--f) clamp(0,(12800 - (r * r * .2126 + g * g * .7152 + b * b * .0722)) * 999,255) clamp(0,(12800 - (r * r * .2126 + g * g * .7152 + b * b * .0722)) * 999,255) clamp(0,(12800 - (r * r * .2126 + g * g * .7152 + b * b * .0722)) * 999,255));background:var(--f)}
.btn{--f:var(--p);display:inline-flex;align-items:center;min-height:52px;padding:.85rem 1.4rem;font:700 var(--step-body)/1.1 var(--fb);text-decoration:none;border-radius:999px}
.btn:focus-visible{outline:3px solid var(--ink);outline-offset:3px}
.wrap{padding:0 var(--m)}

/* the first screen: the account's file */
.hero{--f:var(--hero);position:relative;overflow:hidden;padding-top:1.25rem}
.top{display:flex;align-items:center;gap:1rem;min-height:2.75rem}
.brand{font:700 1.125rem/1 var(--fh);letter-spacing:-.01em;display:flex;align-items:center;min-width:0}
.brand img{display:block;height:28px;width:auto;max-width:9rem;object-fit:contain}
.top .navcta{margin-left:auto;font-size:var(--step-small);white-space:nowrap}
.top .navcta a{color:inherit}
.head{padding:clamp(2.5rem,7vh,4.5rem) 0 clamp(2rem,5vh,3rem)}
/* the headline is filled per account, 20 to 90 characters, so its size follows its length to stay on two lines */
.hero h1{font-size:clamp(2.75rem,1rem + 6.6vw,6.25rem);max-width:15ch;letter-spacing:-.04em;line-height:.98}
.hero h1.mid{font-size:clamp(1.9rem,.6rem + 5.4vw,5.5rem);max-width:21ch}
.hero h1.long{font-size:clamp(1.625rem,.5rem + 4vw,4.25rem);max-width:25ch}
.sub{font-size:var(--step-lead);line-height:1.35;max-width:40ch;margin-top:1.5rem}
.made{font-size:var(--step-small);margin-top:1rem;opacity:.8}
.stack{position:relative}
.folder{position:relative;margin-top:-1.25rem}
.c-mint{--f:var(--mint)}.c-deep{--f:var(--deep)}.c-orange{--f:var(--orange)}.c-paper{--f:var(--paper)}.c-manila{--f:var(--manila)}
.x1{--x:4%}.x2{--x:30%}.x3{--x:56%}.x4{--x:16%}
.folder:first-child{margin-top:0}
.tab{display:inline-flex;align-items:center;gap:.6rem;min-height:2.75rem;padding:.6rem 1.6rem .55rem;margin-left:var(--x,0);font:700 var(--step-small)/1.1 var(--fb);text-decoration:none;clip-path:polygon(10px 0,calc(100% - 10px) 0,100% 100%,0 100%);border-radius:0}
a.tab:hover{text-decoration:underline}
a.tab:focus-visible{outline:none;text-decoration:underline;text-decoration-thickness:3px}
.sheet{height:1.75rem}
.front .tab{font-size:var(--step-body);padding:.7rem 2rem .65rem}
.front .sheet{height:auto;padding:clamp(1.5rem,3vw,2.5rem) var(--m) clamp(2.5rem,5vw,4rem);margin:0 calc(var(--m) * -1)}
.front .sheet{display:grid;gap:2rem}
.front h2{font-size:var(--step-lead);letter-spacing:-.015em;line-height:1.15}
.noticed{list-style:none;margin:1.25rem 0 0;padding:0;display:grid;gap:1.25rem}
.noticed b{display:block;font-weight:700;font-size:var(--step-body);line-height:1.35}
.noticed span{display:block;font-size:var(--step-small);margin-top:.25rem}
.front .note{font-size:var(--step-small);margin-top:1.5rem}
.acts{display:flex;flex-wrap:wrap;align-items:center;gap:1rem 1.5rem;align-self:start}
.acts .alt{font-weight:700}

/* chapters */
.ch{padding:clamp(4rem,10vw,8rem) var(--m)}
.ch h2{font-size:var(--step-head);max-width:16ch}
.ch h2 + .lead{margin-top:1.25rem}
.lead{font-size:var(--step-lead);line-height:1.35;max-width:40ch;margin-top:1.5rem}

/* use cases: a comparison set as text */
.uses{--f:var(--mint)}
.cmp{width:100%;border-collapse:collapse;margin-top:clamp(2.5rem,5vw,4rem);text-align:left}
.cmp th,.cmp td{vertical-align:top;padding:1.5rem 1.25rem 1.6rem}
.cmp thead th{font-size:var(--step-body);padding-top:0;padding-bottom:1rem}
.cmp tbody th{font:700 var(--step-lead)/1.15 var(--fh);letter-spacing:-.015em;padding-left:0;width:30%}
.cmp tbody tr{border-top:2px solid currentColor}
.cmp td.after{--f:var(--paper);font-weight:700}
.cmp thead .after{--f:var(--paper)}

/* customer story: the bars stand on the field's edge */
.proof{--f:var(--deep);padding-bottom:0;overflow:hidden}
.proof .cols{display:grid;gap:2.5rem}
.proof .who{margin-top:1.5rem;max-width:44ch}
.proof blockquote{margin:2rem 0 0;font:700 var(--step-lead)/1.3 var(--fh);letter-spacing:-.01em;max-width:30ch}
.proof cite{display:block;font:400 var(--step-small)/1.4 var(--fb);margin-top:.75rem}
.fig .big{display:block;font:700 clamp(4rem,2rem + 7vw,8.5rem)/.9 var(--fh);letter-spacing:-.05em;white-space:nowrap}
.fig .what{display:block;font-size:var(--step-lead);line-height:1.25;margin-top:1rem;max-width:24ch;font-weight:700}
.fig .what span{display:block;font-weight:400;font-size:var(--step-body);margin-top:.35rem}
.bars{list-style:none;margin:clamp(3rem,6vw,5rem) 0 0;padding:0;display:grid;grid-auto-flow:column;grid-auto-columns:1fr;gap:8px;align-items:end;height:clamp(13rem,32vh,22rem)}
.bars li{--f:var(--mint);height:calc(var(--h) * 1%);min-height:2.5rem;display:flex;flex-direction:column;justify-content:space-between;padding:.6rem .7rem .5rem;font-size:var(--step-small)}
.bars li.end{--f:var(--paper)}
.bars .v{font:700 var(--step-lead)/1 var(--fh)}
.bars li:not(.end) .v{font-size:var(--step-small);font-family:var(--fb)}

/* rollout: the stages as one bar */
.roll{--f:var(--orange)}
.stages{list-style:none;margin:clamp(2.5rem,5vw,4rem) 0 0;padding:0;display:grid;gap:6px}
.stages li{display:grid;gap:1rem}
.seg{min-height:clamp(6rem,16vh,10rem);padding:1.25rem;font:700 var(--step-lead)/1.15 var(--fh);letter-spacing:-.01em}
.stages li:nth-child(1) .seg{--f:var(--ink)}
.stages li:nth-child(2) .seg{--f:var(--paper)}
.stages li:nth-child(3) .seg{--f:var(--manila)}
.stages h3{font-size:var(--step-body);letter-spacing:0;line-height:1.3}
.stages p{margin-top:.35rem;max-width:34ch}

/* questions: filled tiles */
.faq{--f:var(--paper)}
.faq .cols{display:grid;gap:2rem}
.qs{display:grid;gap:8px}
.qs details{--f:color-mix(in srgb,var(--ink) 6%,var(--paper));border-radius:14px}
.qs details[open]{--f:var(--p)}
.qs summary{cursor:pointer;list-style:none;display:flex;align-items:center;justify-content:space-between;gap:1.5rem;min-height:4.5rem;padding:1.1rem 1.5rem;font-weight:700;font-size:var(--step-body);border-radius:14px}
.qs summary::-webkit-details-marker{display:none}
.qs summary i{position:relative;flex:none;width:16px;height:16px}
.qs summary i::before,.qs summary i::after{content:"";position:absolute;left:0;top:6.5px;width:16px;height:3px;background:currentColor}
.qs summary i::after{transform:rotate(90deg)}
.qs details[open] summary i::after{transform:none}
.qs details p{padding:0 1.5rem 1.5rem;max-width:52ch}

/* booking: the file comes back */
.book{--f:var(--manila)}
.book .cols{display:grid;gap:2.5rem}
.book .lead{max-width:30ch}
.book .from{margin-top:1.5rem;font-weight:700}
.cal{--f:var(--paper);padding:.75rem;border-radius:14px;min-width:0;color:#000}
.cal .ken-cta{background:var(--p)!important;border-radius:999px!important;color:#fff!important;color:rgb(from var(--p) clamp(0,(12800 - (r * r * .2126 + g * g * .7152 + b * b * .0722)) * 999,255) clamp(0,(12800 - (r * r * .2126 + g * g * .7152 + b * b * .0722)) * 999,255) clamp(0,(12800 - (r * r * .2126 + g * g * .7152 + b * b * .0722)) * 999,255))!important}

footer{--f:var(--hero);padding:2rem var(--m) 2.5rem;font-size:var(--step-small)}
footer .brand{font-size:var(--step-lead);margin-bottom:.75rem}
footer p{max-width:60ch}

@media (min-width:760px){
  .front .sheet{grid-template-columns:minmax(0,7fr) minmax(0,4fr);column-gap:4rem;align-items:start}
  .acts{justify-content:flex-start;padding-top:.25rem}
  .noticed{grid-template-columns:repeat(auto-fit,minmax(13rem,1fr));gap:1.5rem 2rem}
  .proof .cols{grid-template-columns:minmax(0,7fr) minmax(0,5fr);column-gap:4rem}
  .fig{padding-top:.5rem}
  .stages{grid-template-columns:repeat(3,minmax(0,1fr))}
  .stages li{align-content:start}
  .faq .cols{grid-template-columns:minmax(0,4fr) minmax(0,8fr);column-gap:4rem;align-items:start}
  .faq .cols>div:first-child{position:sticky;top:2rem}
  .book .cols{grid-template-columns:minmax(0,5fr) minmax(0,6fr);column-gap:4rem;align-items:end}
}
@media (max-width:759px){
  .cmp,.cmp tbody,.cmp tr,.cmp th,.cmp td{display:block;width:auto}
  .cmp thead{display:none}
  .cmp tbody th{padding:1.5rem 0 .75rem;width:auto}
  .cmp td{padding:.9rem 1rem 1rem}
  .cmp td::before{content:attr(data-col);display:block;font-weight:700;margin-bottom:.25rem}
  .cmp td.today{padding-left:0;padding-right:0}
  .bars{grid-auto-flow:row;grid-auto-rows:auto;height:auto;margin:2.5rem 0 0;gap:6px;padding-bottom:clamp(4rem,10vw,8rem)}
  .bars li{height:auto;min-height:2.25rem;width:calc(var(--h) * 1%);min-width:5.5rem;flex-direction:row;align-items:center;padding:.35rem .7rem}
  .bars .v,.bars li:not(.end) .v{font:700 var(--step-small)/1 var(--fb)}
  .seg{min-height:4.5rem}
  .proof .fig{margin-top:3rem}
}
@media (prefers-reduced-motion:no-preference){
  .stack .folder{animation:file .7s cubic-bezier(.2,.7,.2,1) both}
  .stack .folder:nth-child(2){animation-delay:80ms}.stack .folder:nth-child(3){animation-delay:160ms}.stack .folder:nth-child(4){animation-delay:240ms}.stack .folder:nth-child(5){animation-delay:320ms}
  @keyframes file{from{transform:translateY(3rem)}to{transform:none}}
  .qs summary i::after{transition:transform .2s}
}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
{%- if font_head == 'Besley' %}
/* Besley is a wide Clarendon: its own tracking, and a step smaller so headlines keep their two lines */
h1,h2,h3{letter-spacing:-.015em}
.hero h1{font-size:clamp(2.5rem,.9rem + 6vw,5.75rem);letter-spacing:-.02em;line-height:1}
.hero h1.mid{font-size:clamp(1.75rem,.55rem + 4.9vw,5rem)}
.hero h1.long{font-size:clamp(1.5rem,.45rem + 3.6vw,3.9rem)}
.fig .big{font-size:clamp(3rem,1.4rem + 5.4vw,6.5rem);letter-spacing:-.03em}
{%- endif %}
</style>
</head>
<body>
<section class="hero on" data-section="hero">
  <div class="wrap">
    <header class="top">
      <span class="brand">{%- if brand.logo_url and brand.logo_url != '' %}<img src="{{ brand.logo_url }}" alt="{{ bname | escape }}">{% else %}{{ bname | escape }}{% endif -%}</span>
      <span class="navcta">{% render 'ken/cta', label: nav_label, kind: 'booking', variant: 'link', id: 'nav-booking' %}</span>
    </header>
    <div class="head">
      <h1{% if hl_size > 46 %} class="long"{% elsif hl_size > 30 %} class="mid"{% endif %}>{{ data.hero.headline | escape }}</h1>
      <p class="sub">{{ data.hero.sub | escape }}</p>
      <p class="made">A page for {% if person.first_name and person.first_name != '' %}{{ person.first_name | escape }}{% if person.last_name and person.last_name != '' %} {{ person.last_name | escape }}{% endif %}{% if person.title and person.title != '' %}, {{ person.title | escape }}{% endif %} at {% else %}the team at {% endif %}{{ account.name | escape }}, from {{ sender_full | escape }} at {{ bname | escape }}.</p>
    </div>
  </div>
  <nav class="stack wrap" aria-label="Chapters of this page">
    <div class="folder c-mint x1"><a class="tab on" href="#uses">Three things we would do</a><div class="sheet on"></div></div>
    {%- if has_story %}
    <div class="folder c-deep x2"><a class="tab on" href="#proof">A customer like you</a><div class="sheet on"></div></div>
    {%- endif %}
    <div class="folder c-orange x3"><a class="tab on" href="#rollout">The rollout</a><div class="sheet on"></div></div>
    <div class="folder c-paper x4"><a class="tab on" href="#questions">Questions</a><div class="sheet on"></div></div>
    <div class="folder front c-manila">
      <span class="tab on">{{ account.name | escape }}</span>
      <div class="sheet on">
        <div>
          <h2>What we noticed at {{ account.name | escape }}</h2>
          <ol class="noticed">
            {%- for n in data.noticed %}
            <li><b>{{ n.fact | escape }}</b><span>{% if n.source_url contains 'https://' %}<a href="{{ n.source_url | escape }}" target="_blank" rel="noopener noreferrer">{{ n.source | escape }}</a>{% else %}{{ n.source | escape }}{% endif %}</span></li>
            {%- endfor %}
          </ol>
          <p class="note">From {{ account.name | escape }}'s site and public notices. Tell {{ sender_first | escape }} if any of this is off.</p>
        </div>
        <div class="acts"><a class="btn on" href="#book">Book 20 minutes</a><a class="alt" href="#rollout">See the rollout at {{ account.name | escape }}</a></div>
      </div>
    </div>
  </nav>
</section>

<section class="ch uses on" id="uses" data-section="uses">
  <h2>Three things we would do</h2>
  <p class="lead">{{ data.uses_lead | escape }}</p>
  <table class="cmp">
    <thead><tr><td></td><th scope="col">Today at {{ account.name | escape }}</th><th scope="col" class="after on">With {{ bname | escape }}</th></tr></thead>
    <tbody>
      {%- for u in data.uses %}
      <tr><th scope="row">{{ u.title | escape }}</th><td class="today" data-col="Today at {{ account.name | escape }}">{{ u.today | escape }}</td><td class="after on" data-col="With {{ bname | escape }}">{{ u.after | escape }}</td></tr>
      {%- endfor %}
    </tbody>
  </table>
</section>

{%- if has_story %}
{%- assign first_pt = data.story.chart | first -%}
{%- assign last_pt = data.story.chart | last %}
<section class="ch proof on" id="proof" data-section="proof">
  <div class="cols">
    <div>
      <h2>A customer like you</h2>
      <p class="lead">{{ data.story.headline | escape }}</p>
      <p class="who">{{ data.story.who | escape }}</p>
      {%- if data.story.quote and data.story.quote.text and data.story.quote.text != '' %}
      <blockquote>{{ data.story.quote.text | escape }}{% if data.story.quote.author_title and data.story.quote.author_title != '' %}<cite>{{ data.story.quote.author_title | escape }}</cite>{% endif %}</blockquote>
      {%- endif %}
    </div>
    <p class="fig"><span class="big">{{ first_pt.value }} to {{ last_pt.value }}</span><span class="what">{{ data.story.chart_title | escape }}{% if data.story.chart_note and data.story.chart_note != '' %}<span>{{ data.story.chart_note | escape }}</span>{% endif %}</span></p>
  </div>
  <ol class="bars" role="img" aria-label="Bar chart: {{ data.story.chart_title | escape }}, from {{ first_pt.value }} at {{ first_pt.label | escape }} to {{ last_pt.value }} at {{ last_pt.label | escape }}">
    {%- for p in data.story.chart %}
    {%- assign pct = p.value | times: 100.0 | divided_by: top | round %}
    <li class="on{% if forloop.first or forloop.last %} end{% endif %}" style="--h:{{ pct }}"><span class="v">{{ p.value }}</span><span>{{ p.label | escape }}</span></li>
    {%- endfor %}
  </ol>
</section>
{%- endif %}

<section class="ch roll on" id="rollout" data-section="rollout">
  <h2>The rollout</h2>
  <p class="lead">{{ data.rollout_lead | escape }}</p>
  <ol class="stages">
    {%- for s in data.rollout %}
    <li><span class="seg on">{{ s.when | escape }}</span><div><h3>{{ s.title | escape }}</h3><p>{{ s.body | escape }}</p></div></li>
    {%- endfor %}
  </ol>
</section>

<section class="ch faq on" id="questions" data-section="faq">
  <div class="cols">
    <div><h2>Questions</h2><p class="lead">What people ask before a first call with {{ sender_first | escape }}.</p></div>
    <div class="qs">
      {%- for f in data.faq %}
      <details class="on" name="faq"><summary class="on">{{ f.q | escape }}<i aria-hidden="true"></i></summary><p>{{ f.a | escape }}</p></details>
      {%- endfor %}
    </div>
  </div>
</section>

<section class="ch book on" id="book" data-section="booking">
  <div class="cols">
    <div>
      <h2>Pick a time with {{ sender_first | escape }}</h2>
      <p class="lead">Twenty minutes on video. Bring whoever else should see this, and we will go through the rollout for {{ account.name | escape }} together.</p>
      <p class="from">{{ sender_full | escape }}{% if sender.title and sender.title != '' %}, {{ sender.title | escape }} at {% else %} at {% endif %}{{ bname | escape }}</p>
    </div>
    <div class="cal on">{% render 'ken/booking', height: 560, title: 'Book 20 minutes' %}</div>
  </div>
</section>

<footer class="on">
  <p class="brand">{%- if brand.logo_url and brand.logo_url != '' %}<img src="{{ brand.logo_url }}" alt="{{ bname | escape }}">{% else %}{{ bname | escape }}{% endif -%}</p>
  <p>This page was made for {% if person.first_name and person.first_name != '' %}{{ person.first_name | escape }} at {% else %}the team at {% endif %}{{ account.name | escape }} by {{ sender_full | escape }}. It is a private link. Nothing on it is public.</p>
</footer>
</body>
</html>
