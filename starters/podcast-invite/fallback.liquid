{%- assign accent = brand.colors.primary | default: '#ff8126' -%}
{%- assign font_head = brand.fonts.heading | default: 'TikTok Sans' -%}
{%- assign font_body = brand.fonts.body | default: 'TikTok Sans' -%}
{%- assign first = person.first_name | default: '' -%}
{%- assign guest_name = account.name -%}
{%- if person.first_name -%}{%- capture guest_name -%}{{ person.first_name }}{% if person.last_name %} {{ person.last_name }}{% endif %}{%- endcapture -%}{%- endif -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex">
<title>Be our guest, {{ guest_name | escape }}</title>
{%- if font_head == 'TikTok Sans' %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=TikTok+Sans:wdth,wght@100..150,400..800&display=swap">
{%- else %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_head | url_encode }}&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_head | url_encode }}:wght@700&display=swap">
{%- endif %}
{%- if font_body != font_head %}
{%- if font_body == 'TikTok Sans' %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=TikTok+Sans:wdth,wght@100..150,400..800&display=swap">
{%- else %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_body | url_encode }}&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_body | url_encode }}:wght@700&display=swap">
{%- endif %}
{%- endif %}
<style>
:root{--p:{{ accent | escape }};--on-p:#111;--f3:{% if brand.colors.primary %}color-mix(in srgb,var(--p) 22%,#fff){% else %}#c5f53d{% endif %};--paper:#fbfaf6;--ink:#111;--fh:'{{ font_head | escape }}','Arial Black',ui-sans-serif,system-ui,sans-serif;--fb:'{{ font_body | escape }}',ui-sans-serif,system-ui,sans-serif;--wide:{% if font_head == 'TikTok Sans' %}150%{% else %}100%{% endif %};--margin:clamp(1rem,2.4vw,2rem)}
@supports (color:oklch(from red l c h)){:root{--on-p:color(from var(--p) xyz-d65 clamp(0,(.18 - y) * 1000000,.9505) clamp(0,(.18 - y) * 1000000,1) clamp(0,(.18 - y) * 1000000,1.089))}}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%;background:var(--f3)}
body{margin:0;color:var(--ink);font:400 clamp(1.0625rem,1rem + .25vw,1.1875rem)/1.45 var(--fb);-webkit-font-smoothing:antialiased}
p{margin:0}
.frame{padding-left:var(--margin);padding-right:var(--margin)}
.f-p{background:var(--p);color:var(--on-p)}
.f-3{background:var(--f3);color:var(--ink)}
.top{display:flex;justify-content:space-between;align-items:baseline;gap:1rem;padding-top:1rem;font-size:.9375rem}
.top .brand{font-family:var(--fh);font-weight:800}
.top img{height:26px;width:auto;display:block}
.poster{padding-top:2.4rem;padding-bottom:2.2rem}
h1{font-family:var(--fh);font-weight:800;font-stretch:var(--wide);text-transform:uppercase;line-height:.92;letter-spacing:-.01em;margin:0;font-size:clamp(2.125rem,.3rem + 7.2vw,7.5rem);text-wrap:balance}
.for{margin-top:1.4rem;max-width:34ch}
.for b{font-weight:700}
.card{background:var(--paper);color:var(--ink);padding:1.2rem 1.25rem 1.3rem;margin:2.2rem 0 -4.5rem auto;width:min(88%,22rem);transform:rotate(-4deg);position:relative;z-index:2;display:grid;gap:.8rem}
.card .title{font-family:var(--fh);font-weight:800;font-stretch:var(--wide);text-transform:uppercase;font-size:1.375rem;line-height:1}
.card .name{font-family:var(--fh);font-weight:800;font-size:clamp(1.875rem,1rem + 2.8vw,3rem);line-height:.95;letter-spacing:-.02em;overflow-wrap:anywhere}
.card .sub{font-size:.9375rem;margin-top:.4rem}
.wave{display:block;width:100%;height:44px;color:var(--p)}
.band{padding-top:7rem;padding-bottom:3.5rem;display:grid;gap:1rem;max-width:44rem}
.band .lead{font-size:clamp(1.25rem,1.05rem + .7vw,1.625rem);line-height:1.3}
.act{display:flex;flex-wrap:wrap;align-items:center;gap:.8rem 1.4rem;margin-top:.6rem}
.ken-cta{display:inline-flex!important;align-items:center;min-height:3.25rem;padding:.9rem 1.6rem!important;border-radius:0!important;font-family:var(--fb);font-weight:700;line-height:1.2;text-decoration:none;background:var(--ink)!important;color:var(--f3)!important}
.ken-cta:focus-visible{outline:3px solid var(--ink);outline-offset:4px}
.or,.sig span{font-size:.9375rem}
.sig b{display:block;font-family:var(--fh);font-weight:800;font-size:1.25rem}
.book{padding-bottom:3rem;font-size:.9375rem;max-width:44rem}
@media (min-width:860px){
.poster{display:grid;grid-template-columns:minmax(0,7fr) minmax(0,5fr);column-gap:3rem;padding-top:6rem}
.poster h1{grid-column:1 / -1}
.for{grid-column:1;align-self:start;margin-top:2.4rem}
.card{grid-column:2;margin:-1rem 0 -10rem;width:auto;max-width:23rem;justify-self:end;padding:1.6rem}
.band{padding-top:5rem;max-width:none;grid-template-columns:minmax(0,7fr) minmax(0,5fr)}
.band>*{grid-column:1}
}
@keyframes stick{from{transform:translateY(-24px) rotate(2deg)}to{transform:rotate(-4deg)}}
.card{animation:stick .8s cubic-bezier(.2,.8,.2,1) both}
@media (prefers-reduced-motion:reduce){.card{animation:none}}
</style>
</head>
<body>
<main>
<section data-section="invite">
<div class="f-p frame">
<header class="top">
{%- if brand.logo_url %}<img src="{{ brand.logo_url | escape }}" alt="{{ brand.name | default: 'Logo' | escape }}">{% elsif brand.name %}<p class="brand">{{ brand.name | escape }}</p>{% else %}<span></span>{% endif -%}
<p>A guest invitation</p>
</header>
<div class="poster">
<h1>Be our guest{% if first != '' %}, {{ first | escape }}{% endif %}.</h1>
<p class="for">{% if person.first_name %}An invitation for <b>{{ guest_name | escape }}</b>{% if person.title %}, {{ person.title | escape }}{% endif %} at {{ account.name | escape }}{% else %}An invitation for <b>{{ account.name | escape }}</b>{% endif %}</p>
<div class="card" aria-hidden="true">
<p class="title">{{ brand.name | default: 'Our show' | escape }}</p>
<svg class="wave" viewBox="0 0 160 44" preserveAspectRatio="none" fill="currentColor"><rect x="0" y="17" width="5" height="10"/><rect x="9" y="11" width="5" height="22"/><rect x="18" y="4" width="5" height="36"/><rect x="27" y="14" width="5" height="16"/><rect x="36" y="0" width="5" height="44"/><rect x="45" y="9" width="5" height="26"/><rect x="54" y="19" width="5" height="6"/><rect x="63" y="6" width="5" height="32"/><rect x="72" y="13" width="5" height="18"/><rect x="81" y="2" width="5" height="40"/><rect x="90" y="16" width="5" height="12"/><rect x="99" y="8" width="5" height="28"/><rect x="108" y="18" width="5" height="8"/><rect x="117" y="5" width="5" height="34"/><rect x="126" y="12" width="5" height="20"/><rect x="135" y="3" width="5" height="38"/><rect x="144" y="15" width="5" height="14"/><rect x="153" y="10" width="5" height="24"/></svg>
<div>
<p class="name">{{ guest_name | escape }}</p>
<p class="sub">{% if person.first_name %}{% if person.title %}{{ person.title | escape }}, {% endif %}{{ account.name | escape }}{% elsif account.industry %}{{ account.industry | capitalize | escape }}{% else %}Whoever you would put forward{% endif %}</p>
</div>
</div>
</div>
</div>
<div class="f-3 frame band">
<p class="lead">Hi {{ first | default: 'there' | escape }}, I am putting together an invitation for you to be a guest on our show: the angle I would propose for a conversation about {{ account.name | escape }}, and the first questions I would ask.</p>
<p>It is not on this page yet. The link stays the same, so check back later today.</p>
<div class="act">
{% render 'ken/cta', label: 'Pick a time', kind: 'booking', id: 'book', color: accent %}
<p class="or">or reply to my email with a week that works</p>
</div>
<p class="sig"><b>{{ sender.name | default: 'The host' | escape }}</b><span>{% if sender.title %}{{ sender.title | escape }}{% if brand.name %}, {{ brand.name | escape }}{% endif %}{% elsif brand.name %}{{ brand.name | escape }}{% endif %}</span></p>
</div>
</section>

<section data-section="book" class="f-3 frame book">
<p>If you would rather talk it through first, pick a time above and we will shape the angle together.</p>
</section>
</main>
</body>
</html>
