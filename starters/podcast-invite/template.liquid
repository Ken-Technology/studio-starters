{%- assign accent = brand.colors.primary | default: '#ff8126' -%}
{%- assign accent2 = brand.colors.secondary | default: '#4db3ff' -%}
{%- assign font_head = brand.fonts.heading | default: 'TikTok Sans' -%}
{%- assign font_body = brand.fonts.body | default: 'TikTok Sans' -%}
{%- assign first = person.first_name | default: '' -%}
{%- assign is_written = false -%}
{%- if data.show_format == 'written' -%}{%- assign is_written = true -%}{%- endif -%}
{%- assign is_audio = false -%}
{%- if data.show_format == 'audio' -%}{%- assign is_audio = true -%}{%- endif -%}
{%- assign has_eps = false -%}
{%- if data.recent_episodes.size > 0 -%}{%- assign has_eps = true -%}{%- endif -%}
{%- assign guest_name = account.name -%}
{%- if person.first_name -%}{%- capture guest_name -%}{{ person.first_name }}{% if person.last_name %} {{ person.last_name }}{% endif %}{%- endcapture -%}{%- endif -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex">
<title>Be our guest on {{ data.show_name | escape }}</title>
{%- if font_head == 'TikTok Sans' %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=TikTok+Sans:wdth,wght@100..150,400..800&display=swap">
{%- else %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_head | url_encode }}&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_head | url_encode }}:wght@700&display=swap">
{%- endif %}
{%- if font_body != font_head %}
{%- if font_body == 'TikTok Sans' %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=TikTok+Sans:wdth,wght@100..150,400..800&display=swap">
{%- else %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_body | url_encode }}&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_body | url_encode }}:wght@700&display=swap">
{%- endif %}
{%- endif %}
<style>
:root{
  --p:{{ accent | escape }};
  --s:{{ accent2 | escape }};
  --fh:'{{ font_head | escape }}','Arial Black',ui-sans-serif,system-ui,sans-serif;
  --fb:'{{ font_body | escape }}',ui-sans-serif,system-ui,sans-serif;
  --wide:{% if font_head == 'TikTok Sans' %}150%{% else %}100%{% endif %};
  /* flat fields at full strength: the poster (primary), the questions (secondary), the show, one black band */
  --f3:{% if brand.colors.primary %}color-mix(in srgb,var(--p) 22%,#fff){% else %}#c5f53d{% endif %};
  --black:#161615;
  --paper:#fbfaf6;
  --ink:#111;
  --on-p:#111;
  --on-s:#111;
  --step-small:clamp(.875rem,.84rem + .1vw,.9375rem);
  --step-body:clamp(1.0625rem,1rem + .25vw,1.1875rem);
  --step-lead:clamp(1.25rem,1.05rem + .7vw,1.625rem);
  --step-head:clamp(1.875rem,1rem + 2.8vw,3.5rem);
  --step-shout:clamp(2.125rem,.3rem + 7.2vw,7.5rem);
  --margin:clamp(1rem,2.4vw,2rem);
}
@supports (color:oklch(from red l c h)){:root{
  --on-p:color(from var(--p) xyz-d65 clamp(0,(.18 - y) * 1000000,.9505) clamp(0,(.18 - y) * 1000000,1) clamp(0,(.18 - y) * 1000000,1.089));
  --on-s:color(from var(--s) xyz-d65 clamp(0,(.18 - y) * 1000000,.9505) clamp(0,(.18 - y) * 1000000,1) clamp(0,(.18 - y) * 1000000,1.089));
}}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%;background:var(--p)}
body{margin:0;background:var(--p);color:var(--on-p);font:400 var(--step-body)/1.45 var(--fb);-webkit-font-smoothing:antialiased;font-variant-numeric:tabular-nums}
h1,h2,h3{font-family:var(--fh);margin:0;text-wrap:balance}
p{margin:0}
a{color:inherit;text-underline-offset:.18em;text-decoration-thickness:.08em}
a:focus-visible,.ken-cta:focus-visible{outline:3px solid currentColor;outline-offset:4px}
.frame{padding-left:var(--margin);padding-right:var(--margin)}
.shout{font-family:var(--fh);font-weight:800;font-stretch:var(--wide);text-transform:uppercase;line-height:.92;letter-spacing:-.01em}
.f-p{background:var(--p);color:var(--on-p)}
.f-s{background:var(--s);color:var(--on-s)}
.f-3{background:var(--f3);color:var(--ink)}
.f-b{background:var(--black);color:#f2f2f2}
/* the one button: the field's ink as a block, the field's colour as its words */
.pi .ken-cta{display:inline-flex!important;align-items:center;min-height:3.25rem;padding:.9rem 1.6rem!important;border-radius:0!important;font-family:var(--fb);font-weight:700;font-size:var(--step-body);line-height:1.2;text-decoration:none}
.f-p .ken-cta{background:var(--on-p)!important;color:var(--p)!important}
.f-3 .ken-cta{background:var(--ink)!important;color:var(--f3)!important}

/* first screen: the shout on the poster field, the show card stuck on across the seam */
.top{display:flex;justify-content:space-between;align-items:baseline;gap:1rem;padding-top:1rem;font-size:var(--step-small)}
.top b{font-weight:700}
.top .brand{font-family:var(--fh);font-weight:800;font-size:var(--step-body)}
.top img{height:26px;width:auto;display:block}
.top .show{text-align:right;max-width:24rem}
.poster{position:relative;padding-top:2.4rem;padding-bottom:2.2rem}
.poster h1{font-size:var(--step-shout);position:relative;z-index:1}
.for{margin-top:1.4rem;font-size:var(--step-body);max-width:34ch}
.meta .act{margin-top:1.4rem}
.for b{font-weight:700}
.card{background:var(--paper);color:var(--ink);padding:1.2rem 1.25rem 1.3rem;margin:2.2rem 0 -4.5rem auto;width:min(88%,22rem);transform:rotate(-4deg);position:relative;z-index:2;display:grid;gap:.8rem}
.card .title{font-family:var(--fh);font-weight:800;font-stretch:var(--wide);text-transform:uppercase;font-size:var(--step-lead);line-height:1}
.card .kind{font-size:var(--step-small)}
.card .name{font-family:var(--fh);font-weight:800;font-size:var(--step-head);line-height:.95;letter-spacing:-.02em;overflow-wrap:anywhere}
.card .sub{font-size:var(--step-small);margin-top:.4rem}
.card .sub b{font-weight:700}
.wave{display:block;width:100%;height:44px;color:var(--p)}
.lines{display:grid;gap:7px}
.lines span{display:block;height:6px;background:var(--p)}
.lines span:nth-child(2){width:74%}
.lines span:nth-child(3){width:88%}
.lines span:nth-child(4){width:52%}
.band{padding-top:7rem;padding-bottom:3rem;display:grid;gap:1.4rem}
.band .lead{font-size:var(--step-lead);line-height:1.35;max-width:34ch}
.band .more{max-width:52ch}
.act{display:flex;flex-wrap:wrap;align-items:center;gap:.9rem 1.4rem}
.or{font-size:var(--step-small)}
.sig b{display:block;font-family:var(--fh);font-weight:800;font-size:var(--step-lead);line-height:1.1}
.sig span{font-size:var(--step-small)}
@keyframes stick{from{transform:translateY(-24px) rotate(2deg)}to{transform:rotate(-4deg)}}
.card{animation:stick .8s cubic-bezier(.2,.8,.2,1) both}

/* the angle and the three cue cards */
.angle{padding-top:4.5rem;padding-bottom:5rem;display:grid;gap:1.6rem}
.angle h2{font-size:var(--step-head);font-weight:800;line-height:1;letter-spacing:-.02em}
.ep .title{font-family:var(--fh);font-weight:700;font-size:clamp(1.375rem,1rem + 1.2vw,2.125rem);line-height:1.15;margin-top:1rem;max-width:24ch;text-wrap:balance}
.angle .text{font-size:var(--step-lead);line-height:1.4;max-width:46ch}
.angle h3{font-size:var(--step-lead);font-weight:800;margin-top:1.6rem}
.cues{list-style:none;margin:0;padding:0;display:grid;gap:1.1rem;counter-reset:q}
.cues li{background:var(--paper);color:var(--ink);padding:1.2rem 1.25rem 1.4rem;display:grid;gap:.6rem;counter-increment:q}
.cues li:nth-child(1){transform:rotate(-1.2deg)}
.cues li:nth-child(2){transform:rotate(.9deg)}
.cues li:nth-child(3){transform:rotate(-.6deg)}
.cues li::before{content:counter(q);font-family:var(--fh);font-weight:800;font-stretch:var(--wide);font-size:var(--step-head);line-height:.9}
.cues .q{font-family:var(--fh);font-weight:700;font-size:var(--step-lead);line-height:1.2}
.cues .w{font-size:var(--step-small);line-height:1.45}
.after{max-width:52ch}

/* what it takes: one verb a line on the black band */
.takes{padding-top:4.5rem;padding-bottom:4.5rem}
.takes h2,.about h2,.book h2{font-size:var(--step-head);font-weight:800;line-height:1;letter-spacing:-.02em}
.steps{list-style:none;margin:2rem 0 0;padding:0;display:grid;gap:1.6rem}
.steps li{display:grid;gap:.4rem}
.steps b{font-family:var(--fh);font-weight:800;font-stretch:var(--wide);text-transform:uppercase;font-size:clamp(1.75rem,.6rem + 3.6vw,4.25rem);line-height:.95;letter-spacing:-.01em}
.steps p{max-width:44ch}

/* the show */
.about{padding-top:4.5rem;padding-bottom:4.5rem;display:grid;gap:2rem}
.tag{font-size:var(--step-lead);line-height:1.35;max-width:36ch;margin-top:1rem}
.facts{margin:0;display:grid;gap:1.1rem}
.facts dt{font-weight:700}
.facts dd{margin:.15rem 0 0}
.eps h3{font-size:var(--step-lead);font-weight:800;margin-bottom:.9rem}
.eps ul{list-style:none;margin:0;padding:0;display:grid;gap:6px}
.eps li{background:color-mix(in srgb,var(--f3) 70%,#fff);padding:.9rem 1rem;display:grid;gap:.2rem}
.eps b{font-family:var(--fh);font-weight:700;font-size:var(--step-body);line-height:1.25}
.eps span{font-size:var(--step-small)}

/* book it, back on the poster field */
.book{padding-top:4.5rem;padding-bottom:3rem;display:grid;gap:1.2rem}
.book p{max-width:52ch}
.decline{font-size:var(--step-small)}
.foot{padding-top:2rem;padding-bottom:2rem;display:grid;gap:.3rem;font-size:var(--step-small)}
.foot b{font-weight:700}

@media (min-width:860px){
  .top{padding-top:1.5rem}
  .poster{padding-top:4rem;padding-bottom:3rem;min-height:min(80svh,44rem);display:grid;grid-template-columns:minmax(0,7fr) minmax(0,5fr);grid-template-rows:1fr auto;column-gap:2rem}
  .poster .head{display:contents}
  .poster h1{grid-column:1 / -1;align-self:center}
  .poster .meta{grid-column:1;grid-row:2;align-self:start}
  .card{grid-column:2;grid-row:2;margin:-1rem 0 -12rem;width:auto;max-width:23rem;justify-self:end;padding:1.6rem 1.6rem 1.7rem}
  .band{padding-top:3rem;grid-template-columns:minmax(0,7fr) minmax(0,5fr);column-gap:3rem;align-items:start}
  .band>*{grid-column:1}
  .angle{grid-template-columns:minmax(0,5fr) minmax(0,7fr);column-gap:3rem;padding-top:7rem;padding-bottom:7rem}
  .angle .ep{grid-column:1}
  .angle .text{grid-column:2;grid-row:1}
  .angle h3,.cues,.after{grid-column:1 / -1}
  .cues{grid-template-columns:repeat(3,minmax(0,1fr));gap:1.4rem;align-items:start}
  .takes{padding-top:7rem;padding-bottom:7rem}
  .steps{gap:1.2rem}
  .steps li{grid-template-columns:minmax(0,8fr) minmax(0,4fr);align-items:end;gap:2rem}
  .about{grid-template-columns:minmax(0,6fr) minmax(0,6fr);column-gap:3rem;padding-top:7rem;padding-bottom:7rem}
  .about .intro{grid-column:1 / -1}
  .solo .facts{grid-column:1 / -1;grid-template-columns:repeat(2,minmax(0,1fr));column-gap:3rem;row-gap:1.6rem}
  .book{grid-template-columns:minmax(0,6fr) minmax(0,6fr);column-gap:3rem;padding-top:7rem}
  .book h2{grid-column:1;grid-row:1 / span 4}
  .foot{grid-template-columns:1fr auto}
}
@media (prefers-reduced-motion:reduce){.card{animation:none}}
@media print{.card,.cues li{animation:none;transform:none}.ken-cta{display:none!important}}
</style>
</head>
<body>
<main class="pi">
<section data-section="invite">
  <div class="f-p frame">
    <header class="top">
      {%- if brand.logo_url %}<img src="{{ brand.logo_url | escape }}" alt="{{ brand.name | default: 'Logo' | escape }}">{% elsif brand.name %}<p class="brand">{{ brand.name | escape }}</p>{% else %}<span></span>{% endif %}
      <p class="show"><b>{{ data.show_name | escape }}</b>{% if is_written %}, a written interview series{% elsif is_audio %}, a podcast{% else %}, a video podcast{% endif %}</p>
    </header>
    <div class="poster">
      <div class="head">
        <h1 class="shout">Be our guest{% if first != '' %}, {{ first | escape }}{% endif %}.</h1>
        <div class="meta">
          <p class="for">{% if person.first_name %}An invitation for <b>{{ guest_name | escape }}</b>{% if person.title %}, {{ person.title | escape }}{% endif %} at {{ account.name | escape }}{% else %}An invitation for <b>{{ account.name | escape }}</b>{% endif %}</p>
          <div class="act">
            {% render 'ken/cta', label: 'Pick a time', kind: 'booking', id: 'book-top', color: accent %}
            <p class="or">or reply to my email with a week that works</p>
          </div>
        </div>
      </div>
      <div class="card">
        <p class="title">{{ data.show_name | escape }}</p>
        {%- if is_written %}
        <div class="lines" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
        {%- else %}
        <svg class="wave" viewBox="0 0 160 44" preserveAspectRatio="none" aria-hidden="true" fill="currentColor"><rect x="0" y="17" width="5" height="10"/><rect x="9" y="11" width="5" height="22"/><rect x="18" y="4" width="5" height="36"/><rect x="27" y="14" width="5" height="16"/><rect x="36" y="0" width="5" height="44"/><rect x="45" y="9" width="5" height="26"/><rect x="54" y="19" width="5" height="6"/><rect x="63" y="6" width="5" height="32"/><rect x="72" y="13" width="5" height="18"/><rect x="81" y="2" width="5" height="40"/><rect x="90" y="16" width="5" height="12"/><rect x="99" y="8" width="5" height="28"/><rect x="108" y="18" width="5" height="8"/><rect x="117" y="5" width="5" height="34"/><rect x="126" y="12" width="5" height="20"/><rect x="135" y="3" width="5" height="38"/><rect x="144" y="15" width="5" height="14"/><rect x="153" y="10" width="5" height="24"/></svg>
        {%- endif %}
        <div>
          <p class="name">{{ guest_name | escape }}</p>
          <p class="sub">{% if person.first_name %}{% if person.title %}<b>{{ person.title | escape }}</b>, {% endif %}{{ account.name | escape }}{% elsif account.industry %}<b>{{ account.industry | capitalize | escape }}</b>{% if account.size_band %}, {{ account.size_band | escape }} people{% endif %}{% else %}<b>Whoever you would put forward</b>{% endif %}</p>
        </div>
        <p class="kind">{% if is_written %}An interview{% else %}An episode{% endif %}{% unless person.first_name %} with the team{% endunless %}. {% if is_written %}In writing{% elsif is_audio %}Audio, {{ data.episode_length | escape }}{% else %}Video, {{ data.episode_length | escape }}{% endif %}</p>
      </div>
    </div>
  </div>
  <div class="f-3 frame band">
    <p class="lead">{{ data.invite_line | escape }}</p>
    <p class="more">{% if is_written %}It is a written interview. We send the questions, you answer them at your pace, and it takes {{ data.episode_length | escape }} of your time in all.{% elsif is_audio %}It is {{ data.episode_length | escape }} of conversation, recorded remotely, with no prep beyond this page.{% else %}It is {{ data.episode_length | escape }} on a video call, recorded remotely, with no prep beyond this page.{% endif %} The angle I have in mind and three of the questions are below. If they are off, say so and I will reshape them.</p>
    <p class="sig"><b>{{ sender.name | default: 'The host' | escape }}</b><span>{% if sender.title %}{{ sender.title | escape }}{% if brand.name %}, {{ brand.name | escape }}{% endif %}{% elsif brand.name %}{{ brand.name | escape }}{% endif %}{% if sender.title or brand.name %}. {% endif %}Host of {{ data.show_name | escape }}</span></p>
  </div>
</section>

<section data-section="angle" class="f-s frame angle">
  <div class="ep">
    <h2>The angle</h2>
    <p class="title">{{ data.episode_title | escape }}</p>
  </div>
  <p class="text">{{ data.angle | escape | newline_to_br | strip_newlines | raw }}</p>
  <h3>Three questions we would start with</h3>
  <ol class="cues">
    {%- for q in data.questions %}
    <li><p class="q">{{ q.question | escape }}</p>{% if q.why and q.why != '' %}<p class="w">{{ q.why | escape }}</p>{% endif %}</li>
    {%- endfor %}
  </ol>
  <p class="after">{% if is_written %}You get the full set of questions once you say yes, and you can strike any of them.{% else %}You get the full list a week before we record, and you can strike any of them.{% endif %}</p>
</section>

<section data-section="takes" class="f-b frame takes">
  <h2>What it takes</h2>
  <ol class="steps">
    {%- if is_written %}
    <li><b>Say yes</b><p>Reply to my email, or book a short call below if you would rather talk the angle through first.</p></li>
    <li><b>Answer in writing</b><p>{{ data.recording | escape }} Count on {{ data.episode_length | escape }}.</p></li>
    <li><b>Approve the edit</b><p>You read the finished piece before anyone else does and can change anything in it.</p></li>
    <li><b>It goes out</b><p>On {{ data.published_on | escape }}, {{ data.turnaround | escape }}. We send you the piece and a short version to share.</p></li>
    {%- else %}
    <li><b>Pick a time</b><p>{{ data.episode_length | escape }}, at a slot that suits you. Pick one below or reply with a week that works.</p></li>
    <li><b>We record</b><p>{{ data.recording | escape }}</p></li>
    <li><b>Approve the cut</b><p>You {% if is_audio %}hear{% else %}see{% endif %} the edit before anyone else does and can strike anything you want out.</p></li>
    <li><b>It goes out</b><p>On {{ data.published_on | escape }}, {{ data.turnaround | escape }}. We send you the episode and short clips to share.</p></li>
    {%- endif %}
  </ol>
</section>

<section data-section="show" class="f-3 frame about{% unless has_eps %} solo{% endunless %}">
  <div class="intro">
    <h2>About {{ data.show_name | escape }}</h2>
    <p class="tag">{{ data.show_tagline | escape }}</p>
  </div>
  <dl class="facts">
    <div><dt>Who {% if is_written %}reads it{% else %}listens{% endif %}</dt><dd>{{ data.audience | escape }}</dd></div>
    <div><dt>Format</dt><dd>{% if is_written %}A written interview, {{ data.episode_length | escape }}{% elsif is_audio %}Audio, {{ data.episode_length | escape }} an episode{% else %}Video and audio, {{ data.episode_length | escape }} an episode{% endif %}</dd></div>
    <div><dt>Where it goes out</dt><dd>{{ data.published_on | escape }}</dd></div>
    <div><dt>Hosted by</dt><dd>{{ data.host_about | escape }}</dd></div>
  </dl>
  {%- if has_eps %}
  <div class="eps">
    <h3>Recent {% if is_written %}interviews{% else %}episodes{% endif %}</h3>
    <ul>
      {%- for ep in data.recent_episodes %}
      <li><b>{{ ep.title | escape }}</b>{% if ep.guest and ep.guest != '' %}<span>{{ ep.guest | escape }}</span>{% endif %}</li>
      {%- endfor %}
    </ul>
  </div>
  {%- endif %}
</section>

<section data-section="book" class="f-p frame book">
  {%- if is_written %}
  <h2>Say yes and I will send the questions</h2>
  <p>Reply to my email with a yes and the full set of questions comes the same day. If you would like to talk the angle through first, book a short call and we will shape it together.</p>
  <div class="act">{% render 'ken/cta', label: 'Book a short call', kind: 'booking', id: 'book', color: accent %}</div>
  {%- else %}
  <h2>Pick a time to record</h2>
  <p>Choose a slot that suits you and I will send the link and the full question list a week ahead. If nothing fits, reply to my email with a week that works and I will find a time.</p>
  <div class="act">{% render 'ken/cta', label: 'Pick a recording time', kind: 'booking', id: 'book', color: accent %}</div>
  {%- endif %}
  <p class="decline">Not the right moment? Reply and say when would be, and I will come back then.</p>
  <p class="sig"><b>{{ sender.name | default: 'The host' | escape }}</b><span>{% if sender.title %}{{ sender.title | escape }}{% if brand.name %}, {{ brand.name | escape }}{% endif %}{% elsif brand.name %}{{ brand.name | escape }}{% endif %}</span></p>
</section>
</main>
<footer class="f-p frame foot">
  <span>Made for <b>{{ account.name | escape }}</b> by {{ sender.name | default: 'the host' | escape }}{% if brand.name %} at {{ brand.name | escape }}{% endif %}.</span>
  <span>A private link. Nothing goes out until you approve it.</span>
</footer>
</body>
</html>
