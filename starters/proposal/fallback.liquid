{%- assign c_primary = brand.colors.primary | default: '#e99f47' | escape -%}
{%- assign c_secondary = brand.colors.secondary | default: '#1f2b4d' | escape -%}
{%- assign font_head = brand.fonts.heading | default: 'Imbue' | escape -%}
{%- assign font_body = brand.fonts.body | default: 'Albert Sans' | escape -%}
{%- assign company = brand.name | default: 'our company' -%}
{%- assign acct = account.name | default: 'your company' -%}
{%- assign person_name = person.first_name | append: ' ' | append: person.last_name | strip -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex">
<title>Proposal and pilot plan for {{ acct | escape }}</title>
{%- if font_head == 'Imbue' %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Imbue:opsz,wght@10..100,500..700&display=swap">
{%- else %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_head | url_encode }}&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_head | url_encode }}:wght@700&display=swap">
{%- endif %}
{%- if font_body != font_head %}
{%- if font_body == 'Albert Sans' %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Albert+Sans:wght@400;600&display=swap">
{%- else %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_body | url_encode }}&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_body | url_encode }}:wght@700&display=swap">
{%- endif %}
{%- endif %}
<style>
:root{--p:{{ c_primary }};--ink:color-mix(in srgb,{{ c_secondary }} 45%,#141b30);--fh:'{{ font_head }}',Georgia,serif;--fb:'{{ font_body }}',ui-sans-serif,system-ui,sans-serif}
@supports (color:oklch(from red l c h)){:root{--ink:oklch(from color-mix(in srgb,{{ c_secondary }} 45%,#141b30) min(l,.32) c h)}}
*{box-sizing:border-box}
body{margin:0;background:#fff;color:var(--ink);font:400 1.0625rem/1.55 var(--fb);-webkit-font-smoothing:antialiased}
p{margin:0}
.field{background:var(--ink);color:#fff}
.wrap{max-width:60rem;margin:0 auto;padding:1.25rem clamp(1.25rem,4vw,3rem)}
.run{font-weight:600;font-size:.875rem;margin-bottom:clamp(2.5rem,8vw,5rem)}
.mon{font:600 clamp(3rem,11vw,7.5rem)/.88 var(--fh);letter-spacing:-.02em;overflow-wrap:break-word;margin-bottom:2rem}
h1{font:600 clamp(1.875rem,1.3rem + 2vw,2.75rem)/1.06 var(--fh);margin:0 0 1.25rem;max-width:26ch}
.sub{font-size:1.25rem;line-height:1.4;max-width:40ch;margin-bottom:1rem}
.wait{max-width:40ch;margin-bottom:1.75rem}
.field .ken-cta{display:inline-block!important;min-height:52px;padding:15px 26px!important;border-radius:0!important;background:#fff!important;color:var(--ink)!important;font:600 1.0625rem/1.3 var(--fb)!important;text-decoration:none!important;margin-bottom:2.5rem}
.ken-cta:focus-visible{outline:3px solid var(--p);outline-offset:3px}
.by{font-size:1.25rem;line-height:1.4;max-width:44ch;padding-block:2rem 4rem}
@media print{.ken-cta{display:none!important}.field{background:#fff;color:var(--ink)}}
</style>
</head>
<body>
<main>
<section class="cover" data-section="cover">
<div class="field">
<div class="wrap">
<header class="run">{{ brand.name | default: acct | escape }}</header>
<p class="mon">{{ acct | escape }}</p>
<h1>Proposal and pilot plan for {{ acct | escape }}</h1>
<p class="sub">A formal proposal for a 30-day pilot: the problem, the scope, the success criteria, a timeline, the team, the investment and the sign-off.</p>
<p class="wait">The full plan is not ready yet. It follows once the scope is agreed on a short call.</p>
{%- render 'ken/cta', label: 'Book the scoping call', kind: 'booking' %}
</div>
</div>
<div class="wrap">
<p class="by">Prepared for {% if person %}{{ person_name | escape }} at {{ acct | escape }}{% else %}{{ acct | escape }}{% endif %} by {% if sender.name %}{{ sender.name | escape }} at {{ company | escape }}{% else %}{{ company | escape }}{% endif %}.</p>
</div>
</section>
</main>
</body>
</html>
