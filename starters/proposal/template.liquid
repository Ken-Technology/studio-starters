{%- comment -%}Brand: validate the two colours, then read how light each one is so text on them stays readable.{%- endcomment -%}
{%- assign font_head = brand.fonts.heading | default: 'Imbue' -%}
{%- assign font_body = brand.fonts.body | default: 'Albert Sans' -%}
{%- assign head_q = ':wght@400;700' -%}
{%- if font_head == 'Imbue' -%}{%- assign head_q = ':opsz,wght@10..100,500..700' -%}{%- endif -%}
{%- assign body_q = ':wght@400;700' -%}
{%- if font_body == 'Albert Sans' -%}{%- assign body_q = ':wght@400;600' -%}{%- endif -%}
{%- assign c1 = brand.colors.primary | default: '#f7941d' | strip | downcase -%}
{%- assign c2 = brand.colors.secondary | default: '#1f2b4d' | strip | downcase -%}
{%- assign hexd = '0123456789abcdef' | split: '' -%}
{%- assign cols = c1 | append: '|' | append: c2 | split: '|' -%}
{%- assign okc = '' -%}
{%- assign lumc = '' -%}
{%- for c in cols -%}
{%- assign cn = c | size -%}
{%- assign chars = c | split: '' -%}
{%- assign digits = '' -%}
{%- assign bad = false -%}
{%- if cn != 7 and cn != 4 -%}{%- assign bad = true -%}{%- endif -%}
{%- for ch in chars offset: 1 -%}
{%- assign found = -1 -%}
{%- for hd in hexd -%}{%- if hd == ch -%}{%- assign found = forloop.index0 -%}{%- endif -%}{%- endfor -%}
{%- if found < 0 -%}{%- assign bad = true -%}{%- endif -%}
{%- assign digits = digits | append: found | append: ',' -%}
{%- endfor -%}
{%- if bad -%}
{%- assign okc = okc | append: 'n|' -%}
{%- assign lumc = lumc | append: '0|' -%}
{%- else -%}
{%- assign dg = digits | split: ',' -%}
{%- if cn == 7 -%}
{%- assign cr = dg[0] | times: 16 | plus: dg[1] -%}
{%- assign cg = dg[2] | times: 16 | plus: dg[3] -%}
{%- assign cb = dg[4] | times: 16 | plus: dg[5] -%}
{%- else -%}
{%- assign cr = dg[0] | times: 17 -%}
{%- assign cg = dg[1] | times: 17 -%}
{%- assign cb = dg[2] | times: 17 -%}
{%- endif -%}
{%- assign lum = cr | times: 299 -%}
{%- assign lum_g = cg | times: 587 -%}
{%- assign lum_b = cb | times: 114 -%}
{%- assign lum = lum | plus: lum_g | plus: lum_b -%}
{%- assign okc = okc | append: 'y|' -%}
{%- assign lumc = lumc | append: lum | append: '|' -%}
{%- endif -%}
{%- endfor -%}
{%- assign oks = okc | split: '|' -%}
{%- assign lums = lumc | split: '|' -%}
{%- assign c_primary = c1 -%}
{%- assign p_lum = lums[0] | plus: 0 -%}
{%- if oks[0] != 'y' -%}{%- assign c_primary = '#f7941d' -%}{%- assign p_lum = 164035 -%}{%- endif -%}
{%- assign c_secondary = c2 -%}
{%- assign s_lum = lums[1] | plus: 0 -%}
{%- if oks[1] != 'y' -%}{%- assign c_secondary = '#1f2b4d' -%}{%- assign s_lum = 41190 -%}{%- endif -%}
{%- comment -%}Text on the primary turns dark when the primary is light. A light secondary is darkened before it becomes the ink and the cover field.{%- endcomment -%}
{%- if p_lum < 110000 -%}
{%- assign on_p = '#ffffff' -%}
{%- else -%}
{%- assign on_p = '#141b30' -%}
{%- endif -%}
{%- if s_lum < 110000 -%}
{%- assign ink_css = 'var(--brand-secondary)' -%}
{%- else -%}
{%- assign ink_css = 'color-mix(in srgb,var(--brand-secondary) 30%,#141b30)' -%}
{%- endif -%}
{%- assign company = brand.name | default: 'our company' -%}
{%- assign acct = account.name | default: 'your company' -%}
{%- assign acct_last = acct | slice: -1 -%}
{%- if acct_last == 's' or acct_last == 'S' -%}{%- assign acct_p = acct | append: "'" -%}{%- else -%}{%- assign acct_p = acct | append: "'s" -%}{%- endif -%}
{%- assign person_name = person.first_name | append: ' ' | append: person.last_name | strip -%}
{%- assign title = data.title | default: 'Proposal and pilot plan' -%}
{%- comment -%}The account name is set to fill its column: one line where it fits, and on a narrow screen as large as its longest word allows.{%- endcomment -%}
{%- assign mk = 60 -%}
{%- assign h2_max = '3.75rem' -%}
{%- assign mon_floor = '2.5rem' -%}
{%- assign h2_min = '2rem' -%}
{%- if font_head == 'Imbue' -%}{%- assign mk = 30 -%}{%- assign h2_max = '4.5rem' -%}{%- assign mon_floor = '4rem' -%}{%- assign h2_min = '2.5rem' -%}{%- endif -%}
{%- assign words = acct | split: ' ' -%}
{%- assign longest = 1 -%}
{%- for w in words -%}{%- assign wl = w | size -%}{%- if wl > longest -%}{%- assign longest = wl -%}{%- endif -%}{%- endfor -%}
{%- assign total = acct | size -%}
{%- assign one = total | times: mk -%}
{%- assign one = 96000 | divided_by: one -%}
{%- assign wfit = longest | times: mk -%}
{%- assign wfit = 96000 | divided_by: wfit -%}
{%- assign has_problem = false -%}{%- if data.quotes and data.quotes.size > 0 -%}{%- assign has_problem = true -%}{%- endif -%}
{%- assign has_scope = false -%}{%- if data.scope_in and data.scope_in.size > 0 -%}{%- assign has_scope = true -%}{%- endif -%}
{%- assign has_pilot = false -%}{%- if data.criteria and data.criteria.size > 0 -%}{%- assign has_pilot = true -%}{%- endif -%}
{%- assign has_timeline = false -%}{%- if data.tasks and data.tasks.size > 0 and data.weeks and data.weeks.size == 8 -%}{%- assign has_timeline = true -%}{%- endif -%}
{%- assign has_team = false -%}{%- if data.team and data.team.size > 0 -%}{%- assign has_team = true -%}{%- endif -%}
{%- assign has_invest = false -%}{%- if data.investment and data.investment.size > 0 -%}{%- assign has_invest = true -%}{%- endif -%}
{%- assign has_next = false -%}{%- if data.next_steps and data.next_steps.size > 0 -%}{%- assign has_next = true -%}{%- endif -%}
{%- assign has_sign = has_pilot -%}
{%- assign has_any = false -%}{%- if has_problem or has_scope or has_pilot -%}{%- assign has_any = true -%}{%- endif -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex">
<meta name="description" content="{{ data.sub | default: 'A proposal and 30-day pilot plan' | escape }}">
<title>Proposal and pilot plan for {{ acct | escape }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com/">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_head | url_encode }}{{ head_q }}&amp;display=swap">
{%- if font_body != font_head %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_body | url_encode }}{{ body_q }}&amp;display=swap">
{%- endif %}
<style>
:root{
  --brand-primary:{{ c_primary }};
  --brand-secondary:{{ c_secondary }};
  --brand-heading-font:'{{ font_head | escape }}';
  --brand-body-font:'{{ font_body | escape }}';
  --p:var(--brand-primary);
  --on-p:{{ on_p }};
  --ink:{{ ink_css }};
  --bg:#ffffff;
  --paper:color-mix(in srgb,var(--ink) 6%,#fff);
  --soft:color-mix(in srgb,var(--ink) 82%,#fff);
  --rule:color-mix(in srgb,var(--ink) 18%,#fff);
  --them:color-mix(in srgb,var(--ink) 38%,#fff);
  --fh:var(--brand-heading-font),Georgia,serif;
  --fb:var(--brand-body-font),ui-sans-serif,system-ui,sans-serif;
  --t-small:.875rem;
  --t-body:clamp(1.0625rem,1rem + .2vw,1.1875rem);
  --t-lead:clamp(1.25rem,1.1rem + .6vw,1.625rem);
  --t-h3:clamp(1.5rem,1.25rem + 1vw,2.125rem);
  --t-h1:clamp(1.875rem,1.3rem + 2vw,3rem);
  --t-h2:clamp({{ h2_min }},1.6rem + 3.2vw,{{ h2_max }});
  --pad:clamp(1.25rem,4vw,3rem);
}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:var(--bg);color:var(--ink);font:400 var(--t-body)/1.55 var(--fb);-webkit-font-smoothing:antialiased;-webkit-print-color-adjust:exact;print-color-adjust:exact}
h1,h2,h3{font-family:var(--fh);font-weight:600;margin:0;line-height:1.02;letter-spacing:-.01em;font-optical-sizing:auto}
p{margin:0}
a{color:inherit}
a:focus-visible,.ken-cta:focus-visible{outline:3px solid var(--p);outline-offset:3px}
.wrap{max-width:84rem;margin:0 auto;padding-inline:var(--pad)}
.tn{font-variant-numeric:tabular-nums}

/* cover: the account name fills a deep field */
.field{background:var(--ink);color:#fff}
.run{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding-block:1.25rem;font-size:var(--t-small)}
.brand{display:flex;align-items:center;gap:.6rem;font-weight:600;min-width:0}
.logo{width:28px;height:28px;display:block;flex:none;object-fit:contain}
.run .ref{text-align:right}
.mon-box{container-type:inline-size;padding-block:clamp(2.5rem,8vw,6rem) clamp(1.5rem,4vw,3rem)}
.mon{font-family:var(--fh);font-weight:600;line-height:.86;letter-spacing:-.025em;overflow-wrap:break-word;font-optical-sizing:auto;font-size:max(min(calc({{ one }}cqi / 10),32vh),min(calc({{ wfit }}cqi / 10),{{ mon_floor }}))}
.mon-l{display:inline-block}
.cv-text{display:grid;gap:1.25rem;padding-bottom:clamp(2.5rem,6vw,4.5rem)}
.cv-text h1{font-size:var(--t-h1);line-height:1.06;max-width:30ch}
.cv-text .sub{font-size:var(--t-lead);line-height:1.4;max-width:40ch;color:color-mix(in srgb,#fff 88%,var(--ink))}
.cv-text .wait{max-width:40ch}
.cv-after{display:grid;gap:2.5rem;padding-block:clamp(2.5rem,5vw,4rem) 0}
.by{font-size:var(--t-lead);line-height:1.4;max-width:44ch}
.toc{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(14rem,1fr));gap:0 2rem}
.toc li{border-top:4px solid var(--ink)}
.toc a{display:grid;gap:.15rem;padding:.8rem 0 1rem;text-decoration:none;min-height:44px}
.toc b{font:600 var(--t-lead)/1.15 var(--fh)}
.toc span{font-size:var(--t-small)}
.toc a:hover b{text-decoration:underline;text-decoration-color:var(--p);text-decoration-thickness:4px;text-underline-offset:5px}

/* sections */
.sec{padding-top:clamp(5.5rem,4rem + 4vw,8rem)}
.sec>h2{font-size:var(--t-h2);max-width:24ch;margin-bottom:clamp(1.25rem,3vw,2rem)}
.lead{font-size:var(--t-lead);line-height:1.4;max-width:40ch;margin-bottom:clamp(2rem,4vw,3rem)}
.sec h3{font-size:var(--t-h3);margin:clamp(5rem,3rem + 3vw,6rem) 0 .75rem}
.body{max-width:40rem;margin-top:2rem}
.note{font-size:var(--t-small);max-width:52ch;margin-top:1.25rem}

/* the problem */
.quotes{display:grid;gap:2.5rem;margin:0}
.quotes blockquote{margin:0;display:grid;gap:.9rem}
.quotes blockquote p{font:500 var(--t-lead)/1.25 var(--fh);max-width:38ch}
.quotes blockquote p::before{content:"\201C"}
.quotes blockquote p::after{content:"\201D"}
.quotes cite{font-style:normal;font-size:var(--t-small);font-weight:600}
.quotes blockquote:first-child p{font-size:var(--t-h3);line-height:1.12;max-width:36ch}
.facts{display:grid;gap:2rem;margin:1.5rem 0 0}
.facts div{display:grid;gap:.4rem;align-content:start}
.facts b{font:600 var(--t-h2)/.9 var(--fh);letter-spacing:-.02em}
.facts b::after{content:"";display:block;width:3rem;height:6px;margin-top:1rem;background:var(--p)}
.facts span{max-width:24ch}

/* scope */
.scope{display:grid;gap:1rem}
.scope>div{padding:clamp(1.5rem,3vw,2.5rem)}
.scope .in{background:var(--ink);color:#fff}
.scope .out{background:var(--paper)}
.scope h3{font-size:var(--t-lead);margin:0 0 1rem}
.scope ul{margin:0;padding:0;list-style:none;display:grid;gap:.75rem}
.scope li{display:grid;grid-template-columns:.75rem minmax(0,1fr);gap:.9rem;align-items:baseline}
.scope li::before{content:"";width:.75rem;height:.75rem;background:var(--p)}
.scope .out li::before{background:var(--them)}

/* tables: real data, row rules kept */
table{width:100%;border-collapse:collapse;font-size:var(--t-body)}
th{text-align:left;font-weight:600;font-size:var(--t-small);padding:0 1.25rem .6rem 0;border-bottom:4px solid var(--ink);vertical-align:bottom}
td{padding:1rem 1.25rem 1rem 0;border-bottom:1px solid var(--rule);vertical-align:top}
td:first-child{font-weight:600}
td.num,th.num{text-align:right;padding-right:0;white-space:nowrap}
td small{display:block;font-weight:400;font-size:var(--t-small)}
tr.total td{border-bottom:0;padding-top:1.5rem;font:600 var(--t-lead)/1.2 var(--fh)}
tr.total td.num{font-size:var(--t-h3)}
.pass{margin-top:2rem;max-width:44ch;font:500 var(--t-lead)/1.35 var(--fh);padding-left:1.25rem;border-left:6px solid var(--p)}
@media (max-width:719px){
  .stack thead{display:none}
  .stack tr{display:block;padding:1.1rem 0;border-bottom:1px solid var(--rule)}
  .stack td{display:grid;grid-template-columns:7rem minmax(0,1fr);gap:.75rem;border:0;padding:.2rem 0;font-weight:400}
  .stack td::before{content:attr(data-l);font-size:var(--t-small);font-weight:600}
  .stack td:first-child{display:block;font-weight:600;margin-bottom:.4rem}
  .stack td:first-child::before{display:none}
  .stack td.num{text-align:left;white-space:normal}
  .stack tr.total{border-bottom:0;border-top:4px solid var(--ink)}
  .stack tr.total td:first-child{margin:0 0 .4rem}
}

/* timeline: eight weeks, sixteen half-week columns */
.key{display:flex;flex-wrap:wrap;gap:.5rem 1.5rem;font-size:var(--t-small);font-weight:600;margin:0 0 1.25rem}
.key span{display:flex;align-items:center;gap:.5rem}
.key i{display:block;width:1.5rem;height:.75rem;background:var(--p);border-radius:999px}
.key i.them{background:var(--them)}
.gantt{display:grid;gap:0}
.gantt .row{display:grid;grid-template-columns:minmax(0,1fr);gap:.4rem;padding:.6rem 0}
.gantt .lab{font-weight:600}
.gantt .lab small{font-weight:400;font-size:var(--t-small);margin-left:.4rem}
.gantt .track{display:grid;grid-template-columns:repeat(16,minmax(0,1fr));height:1rem;background:var(--paper);border-radius:999px}
.gantt .bar{background:var(--p);border-radius:999px}
.gantt .bar.them{background:var(--them)}
.gantt .ms{width:.8rem;height:.8rem;background:var(--p);transform:rotate(45deg);justify-self:center;align-self:center}
.gantt .ms.them{background:var(--them)}
.gantt .head{display:grid;grid-template-columns:minmax(0,1fr);padding-bottom:.6rem;border-bottom:4px solid var(--ink)}
.gantt .weeks{display:grid;grid-template-columns:repeat(8,minmax(0,1fr));font-size:var(--t-small);font-weight:600}
.gantt .weeks span{white-space:nowrap}
.gantt .weeks em{font-style:normal}
@media (max-width:719px){
  .gantt .weeks span:not(.mo) em{display:none}
  .gantt .weeks span:nth-child(even){visibility:hidden}
}
.cs1{grid-column-start:1}.cs2{grid-column-start:2}.cs3{grid-column-start:3}.cs4{grid-column-start:4}.cs5{grid-column-start:5}.cs6{grid-column-start:6}.cs7{grid-column-start:7}.cs8{grid-column-start:8}
.cs9{grid-column-start:9}.cs10{grid-column-start:10}.cs11{grid-column-start:11}.cs12{grid-column-start:12}.cs13{grid-column-start:13}.cs14{grid-column-start:14}.cs15{grid-column-start:15}.cs16{grid-column-start:16}
.ce2{grid-column-end:2}.ce3{grid-column-end:3}.ce4{grid-column-end:4}.ce5{grid-column-end:5}.ce6{grid-column-end:6}.ce7{grid-column-end:7}.ce8{grid-column-end:8}.ce9{grid-column-end:9}
.ce10{grid-column-end:10}.ce11{grid-column-end:11}.ce12{grid-column-end:12}.ce13{grid-column-end:13}.ce14{grid-column-end:14}.ce15{grid-column-end:15}.ce16{grid-column-end:16}.ce17{grid-column-end:17}
.gantt .track>*{grid-row:1}

/* team */
.team td b{display:block}

/* next steps */
.next{list-style:none;margin:0 0 2.5rem;padding:0;display:grid}
.next li{display:grid;grid-template-columns:minmax(0,1fr);gap:.4rem;padding:1.1rem 0}
.next li:first-child{border-top:4px solid var(--ink)}
.next .d{font:600 var(--t-h3)/1 var(--fh)}
.next b{display:block;font-weight:600}
.next span.dt{display:block;max-width:52ch}
.ken-cta{display:inline-block!important;min-height:52px;padding:15px 26px!important;border-radius:0!important;background:var(--p)!important;color:var(--on-p)!important;font:600 var(--t-body)/1.3 var(--fb)!important;text-decoration:none!important}
.field .ken-cta{background:#fff!important;color:var(--ink)!important}

/* sign-off: the account name again, on the cover's field, over its signature lines */
.close{background:var(--ink);color:#fff;margin-top:clamp(5.5rem,4rem + 4vw,8rem);padding-block:clamp(4rem,3rem + 4vw,7rem) clamp(3rem,2rem + 3vw,5rem)}
.close h2{font-size:var(--t-h2);max-width:24ch;margin-bottom:clamp(1.25rem,3vw,2rem)}
.close .sign .l{border-color:#fff}
.close .approve{background:#fff;color:var(--ink)}
.sign{display:grid;gap:5.5rem;margin:1rem 0 3rem}
.sign>div{container-type:inline-size}
.sign h3{margin:0 0 1.5rem;font-weight:600}
.sign h3{font-size:max(min(calc({{ one }}cqi / 10),var(--t-h2)),min(calc({{ wfit }}cqi / 10),2.5rem));line-height:.92;letter-spacing:-.02em}
.sign .l{display:block;height:2.75rem;border-bottom:2px solid var(--ink)}
.sign .k{display:block;font-size:var(--t-small);font-weight:600;margin:.35rem 0 .5rem}
.approve{background:var(--paper);padding:clamp(1.5rem,3vw,2.5rem);max-width:34rem}
.approve h3{margin:0 0 .5rem;font-size:var(--t-lead)}
.approve p{max-width:40ch}
.approve .ken-form-field{display:block;margin:1rem 0 0}
.approve .ken-form-field span{display:block;font-size:var(--t-small);font-weight:600;margin:0 0 .3rem}
.approve input,.approve textarea{display:block;width:100%;min-height:48px;font:inherit;padding:.6rem .75rem;border:2px solid var(--soft);border-radius:0;background:#fff;color:var(--ink)}
.approve textarea{min-height:6rem}
.approve .ken-form-submit{display:block;min-height:52px;margin-top:1.25rem;padding:0 1.5rem;border:0;border-radius:0!important;background:var(--p)!important;color:var(--on-p)!important;font:600 var(--t-body)/1 var(--fb)}
.approve input:focus-visible,.approve textarea:focus-visible,.approve .ken-form-submit:focus-visible{outline:3px solid var(--p);outline-offset:2px}
.foot{font-size:var(--t-small);max-width:60ch;margin:3rem 0 0}

@media (prefers-reduced-motion:no-preference){
  @keyframes rise{from{transform:translateY(.35em);opacity:0}}
  .mon-l{animation:rise .8s cubic-bezier(.2,.7,.2,1) both}
  .mon-l:nth-child(2){animation-delay:.08s}
  .mon-l:nth-child(3){animation-delay:.16s}
  .mon-l:nth-child(n+4){animation-delay:.24s}
}

@media (min-width:720px){
  .quotes{grid-template-columns:repeat(2,minmax(0,1fr));column-gap:3rem}
  .quotes blockquote:first-child{grid-column:1/-1}
  .facts{grid-template-columns:repeat(3,minmax(0,1fr))}
  .scope{grid-template-columns:repeat(2,minmax(0,1fr))}
  .gantt .row,.gantt .head{grid-template-columns:15rem minmax(0,1fr);gap:1.5rem;align-items:center}
  .gantt .lab small{display:block;margin:0}
  .next li{grid-template-columns:12rem minmax(0,1fr);gap:2rem;align-items:baseline}
  .sign{grid-template-columns:repeat(2,minmax(0,1fr));gap:4rem}
}
@media (min-width:1000px){
  .cv-text{grid-template-columns:repeat(12,minmax(0,1fr));column-gap:1.5rem;align-items:end}
  .cv-text h1{grid-column:1/8}
  .cv-text .sub{grid-column:9/-1}
  .cv-text .wait,.cv-text .ken-cta,.cv-text .cta{grid-column:1/7}
  .cv-after{grid-template-columns:repeat(12,minmax(0,1fr));column-gap:1.5rem}
  .cv-after .by{grid-column:1/8}
  .cv-after nav{grid-column:1/-1}
  .toc{grid-template-columns:repeat(4,minmax(0,1fr))}
  .next{grid-template-columns:repeat(auto-fit,minmax(11rem,1fr));column-gap:1.5rem}
  .next li,.next li:first-child{grid-template-columns:minmax(0,1fr);align-content:start;gap:.6rem;border-top:4px solid var(--ink);padding-top:1rem}
  .sec{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));column-gap:1.5rem;align-content:start}
  .sec>*{grid-column:1/-1}
  .sec>.ken-cta{justify-self:start}
  .sec>h2{grid-column:1/8;margin-bottom:0}
  .sec>h2+.lead{grid-column:8/-1;align-self:end;margin-bottom:0}
  .sec>h2+*{margin-top:0}
  .sec>:nth-child(3){margin-top:clamp(2.5rem,4vw,3.5rem)}
  .sec>h2+:not(.lead){margin-top:clamp(2.5rem,4vw,3.5rem)}
  .close>.wrap{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));column-gap:1.5rem}
  .close>.wrap>*{grid-column:1/-1}
  .close h2{grid-column:1/8;margin-bottom:0}
  .close h2+.lead{grid-column:8/-1;align-self:end;margin-bottom:0}
  .close .sign{margin-top:clamp(2.5rem,4vw,3.5rem)}
  .close .approve{grid-column:1/7}
  .close .foot{grid-column:8/-1;align-self:end;margin:0}
}
@media print{
  @page{margin:16mm}
  body{font-size:11pt;color:#000}
  .field{background:#fff;color:var(--ink)}
  .cv-text .sub{color:var(--ink)}
  .mon{font-size:min(calc({{ one }}cqi / 10),6rem)}
  .scope .in{background:#fff;color:var(--ink);padding:0}
  .scope .out{background:#fff;padding:0}
  .sec,.close{break-before:page;padding-top:0}
  .close{background:#fff;color:var(--ink);margin:0}
  .close .sign .l{border-color:var(--ink)}
  .approve,.ken-cta,.toc{display:none!important}
  table,.quotes blockquote,.sign,.gantt .row,.next li{break-inside:avoid}
}
</style>
</head>
<body>
<main>
<section class="cover" id="cover" data-section="cover">
<div class="field">
<div class="wrap">
<header class="run">
<div class="brand">
{%- if brand.logo_url %}
<img class="logo" src="{{ brand.logo_url | escape }}" alt="">
{%- elsif brand.name %}
<svg class="logo" viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" fill="{{ c_primary }}"/><text x="16" y="22" text-anchor="middle" font-family="{{ font_head | escape }},serif" font-weight="700" font-size="18" fill="{{ on_p }}">{{ brand.name | slice: 0 | upcase | escape }}</text></svg>
{%- endif %}
{%- if brand.name %}
<span>{{ brand.name | escape }}</span>
{%- endif %}
</div>
<span class="ref">Proposal for {{ acct | escape }}<br>Version 1.0</span>
</header>
<div class="mon-box">
<p class="mon">{%- for w in words %}<span class="mon-l">{{ w | escape }}</span> {% endfor -%}</p>
</div>
<div class="cv-text">
<h1>{{ title | escape }}</h1>
<p class="sub">{{ data.sub | default: 'The pilot plan is being prepared. Book the scoping call and it follows once the scope is agreed.' | escape }}</p>
{%- unless has_any %}
<p class="wait">The scope, criteria and timeline are agreed on a short scoping call. The full plan follows from that call.</p>
<div class="cta">{% render 'ken/cta', label: 'Book the scoping call', kind: 'booking' %}</div>
{%- endunless %}
</div>
</div>
</div>
<div class="wrap cv-after">
<p class="by">Prepared for {% if person %}{{ person_name | escape }}{% if person.title %}, {{ person.title | escape }}{% endif %} at {{ acct | escape }}{% else %}{{ acct | escape }}{% if account.domain %} ({{ account.domain | escape }}){% endif %}{% endif %} by {% if sender.name %}{{ sender.name | escape }}{% if sender.title %}, {{ sender.title | escape }}{% endif %} at {{ company | escape }}{% else %}{{ company | escape }}{% endif %}.{% if data.pilot_window and data.pilot_window != '' %} The 30-day pilot runs {{ data.pilot_window | escape }}.{% endif %}{% if data.valid_until and data.valid_until != '' %} This proposal is valid until {{ data.valid_until | escape }}.{% endif %}</p>
{%- if has_any %}
<nav aria-label="Contents">
<ol class="toc">
{%- if has_problem %}
<li><a href="#problem"><b>The problem</b><span>{{ data.problem_when | default: 'In their words' | escape }}</span></a></li>
{%- endif %}
{%- if has_scope %}
<li><a href="#scope"><b>What we propose</b><span>Scope in and out</span></a></li>
{%- endif %}
{%- if has_pilot %}
<li><a href="#pilot"><b>The 30-day pilot</b><span>Success criteria</span></a></li>
{%- endif %}
{%- if has_timeline %}
<li><a href="#timeline"><b>Timeline</b><span>{{ data.timeline_span | default: 'Eight weeks' | escape }}</span></a></li>
{%- endif %}
{%- if has_team %}
<li><a href="#team"><b>The team</b><span>Both sides</span></a></li>
{%- endif %}
{%- if has_invest %}
<li><a href="#investment"><b>Investment</b><span>Pilot and year one</span></a></li>
{%- endif %}
{%- if has_next %}
<li><a href="#next"><b>Next steps</b><span>{{ data.next_steps.size }} dates</span></a></li>
{%- endif %}
{%- if has_sign %}
<li><a href="#signoff"><b>Sign-off</b><span>Approval</span></a></li>
{%- endif %}
</ol>
</nav>
{%- endif %}
</div>
</section>
{%- if has_problem %}
<section class="sec wrap" id="problem" data-section="problem">
<h2>The problem in {{ acct_p | escape }} words</h2>
{%- if data.problem_lead and data.problem_lead != '' %}
<p class="lead">{{ data.problem_lead | escape }}</p>
{%- endif %}
<div class="quotes">
{%- for q in data.quotes %}
<blockquote><p>{{ q.text | escape }}</p><cite>{{ q.who | escape }}{% if q.date and q.date != '' %}, {{ q.date | escape }}{% endif %}</cite></blockquote>
{%- endfor %}
</div>
{%- if data.cost_today and data.cost_today.size > 0 %}
<h3>What it costs today</h3>
{%- if data.cost_source and data.cost_source != '' %}
<p>{{ data.cost_source | escape }}</p>
{%- endif %}
<div class="facts">
{%- for f in data.cost_today %}
<div><b class="tn">{{ f.value | escape }}</b><span>{{ f.label | escape }}</span></div>
{%- endfor %}
</div>
{%- endif %}
{%- if data.problem_close and data.problem_close != '' %}
<p class="body">{{ data.problem_close | escape }}</p>
{%- endif %}
</section>
{%- endif %}
{%- if has_scope %}
<section class="sec wrap" id="scope" data-section="scope">
<h2>What we propose</h2>
{%- if data.scope_lead and data.scope_lead != '' %}
<p class="lead">{{ data.scope_lead | escape }}</p>
{%- endif %}
<div class="scope">
<div class="in"><h3>In scope for the pilot</h3><ul>
{%- for item in data.scope_in %}
<li>{{ item | escape }}</li>
{%- endfor %}
</ul></div>
{%- if data.scope_out and data.scope_out.size > 0 %}
<div class="out"><h3>Out of scope until year one</h3><ul>
{%- for item in data.scope_out %}
<li>{{ item | escape }}</li>
{%- endfor %}
</ul></div>
{%- endif %}
</div>
{%- if data.scope_close and data.scope_close != '' %}
<p class="body">{{ data.scope_close | escape }}</p>
{%- endif %}
</section>
{%- endif %}
{%- if has_pilot %}
<section class="sec wrap" id="pilot" data-section="pilot">
<h2>The 30-day pilot</h2>
{%- if data.pilot_lead and data.pilot_lead != '' %}
<p class="lead">{{ data.pilot_lead | escape }}</p>
{%- endif %}
<table class="stack">
<thead><tr><th>Criterion</th><th>Baseline</th><th>Target by day 30</th><th>Measured by</th></tr></thead>
<tbody>
{%- for c in data.criteria %}
<tr><td>{{ c.name | escape }}</td><td data-l="Baseline">{{ c.baseline | escape }}</td><td data-l="Target by day 30">{{ c.target | escape }}</td><td data-l="Measured by">{{ c.measured_by | escape }}</td></tr>
{%- endfor %}
</tbody>
</table>
{%- if data.pass_rule and data.pass_rule != '' %}
<p class="pass">{{ data.pass_rule | escape }}</p>
{%- endif %}
</section>
{%- endif %}
{%- if has_timeline %}
<section class="sec wrap" id="timeline" data-section="timeline">
<h2>Timeline</h2>
{%- if data.timeline_lead and data.timeline_lead != '' %}
<p class="lead">{{ data.timeline_lead | escape }}</p>
{%- endif %}
<div class="key"><span><i></i>{{ company | escape }}</span><span><i class="them"></i>{{ acct | escape }}</span></div>
<div class="gantt">
<div class="head"><span></span><div class="weeks">
{%- assign prev_month = '' -%}
{%- for w in data.weeks %}
{%- assign month = w | split: ' ' | first -%}
{%- assign day = w | split: ' ' | last -%}
<span{% if month != prev_month %} class="mo"{% endif %}><em>{{ month | escape }} </em>{{ day | escape }}</span>
{%- assign prev_month = month -%}
{%- endfor %}
</div></div>
{%- for t in data.tasks %}
{%- assign tone = '' -%}{%- if t.side == 'them' -%}{%- assign tone = ' them' -%}{%- endif %}
<div class="row"><span class="lab">{{ t.label | escape }}{% if t.who and t.who != '' %}<small>{{ t.who | escape }}</small>{% endif %}</span><div class="track">
{%- if t.span.start and t.span.end %}
<span class="bar{{ tone }} cs{{ t.span.start | plus: 0 }} ce{{ t.span.end | plus: 0 }}"></span>
{%- endif %}
{%- for m in t.marks %}
<span class="ms{{ tone }} cs{{ m | plus: 0 }}"></span>
{%- endfor %}
</div></div>
{%- endfor %}
</div>
{%- if data.timeline_note and data.timeline_note != '' %}
<p class="note">{{ data.timeline_note | escape }}</p>
{%- endif %}
</section>
{%- endif %}
{%- if has_team %}
<section class="sec wrap" id="team" data-section="team">
<h2>The team</h2>
{%- if data.team_lead and data.team_lead != '' %}
<p class="lead">{{ data.team_lead | escape }}</p>
{%- endif %}
<table class="team stack">
<thead><tr><th>Name</th><th>Role in the pilot</th><th>Time</th></tr></thead>
<tbody>
{%- for m in data.team %}
<tr><td><b>{{ m.name | escape }}</b>{% if m.title and m.title != '' %}<small>{{ m.title | escape }}</small>{% endif %}</td><td data-l="Role">{{ m.role | escape }}</td><td data-l="Time">{{ m.time | escape }}</td></tr>
{%- endfor %}
</tbody>
</table>
</section>
{%- endif %}
{%- if has_invest %}
<section class="sec wrap" id="investment" data-section="investment">
<h2>Investment</h2>
{%- if data.investment_lead and data.investment_lead != '' %}
<p class="lead">{{ data.investment_lead | escape }}</p>
{%- endif %}
<table class="stack">
<thead><tr><th>Item</th><th>What it covers</th><th class="num">Amount</th></tr></thead>
<tbody>
{%- for r in data.investment %}
<tr><td>{{ r.item | escape }}</td><td data-l="Covers">{{ r.covers | escape }}</td><td class="num tn" data-l="Amount">{{ r.amount | escape }}</td></tr>
{%- endfor %}
{%- if data.investment_total and data.investment_total.amount %}
<tr class="total"><td colspan="2">{{ data.investment_total.label | escape }}</td><td class="num tn" data-l="Amount">{{ data.investment_total.amount | escape }}</td></tr>
{%- endif %}
</tbody>
</table>
{%- if data.investment_note and data.investment_note != '' %}
<p class="note">{{ data.investment_note | escape }}</p>
{%- endif %}
</section>
{%- endif %}
{%- if has_next %}
<section class="sec wrap" id="next" data-section="next">
<h2>Next steps</h2>
<ol class="next">
{%- for s in data.next_steps %}
<li><span class="d">{{ s.date | escape }}</span><div><b>{{ s.title | escape }}</b>{% if s.detail and s.detail != '' %}<span class="dt">{{ s.detail | escape }}</span>{% endif %}</div></li>
{%- endfor %}
</ol>
{%- render 'ken/cta', label: 'Book the scoping call', kind: 'booking' %}
</section>
{%- endif %}
{%- if has_sign %}
<section class="close" id="signoff" data-section="signoff">
<div class="wrap">
<h2>Sign-off</h2>
<p class="lead">{{ data.signoff_lead | default: 'Approval of the 30-day pilot and its criteria. Year one is a separate decision after the readout.' | escape }}</p>
<div class="sign">
<div><h3>For {{ acct | escape }}</h3><span class="l"></span><span class="k">Name</span><span class="l"></span><span class="k">Title</span><span class="l"></span><span class="k">Signature</span><span class="l"></span><span class="k">Date</span></div>
<div><h3>For {{ company | escape }}</h3><span class="l"></span><span class="k">Name</span><span class="l"></span><span class="k">Title</span><span class="l"></span><span class="k">Signature</span><span class="l"></span><span class="k">Date</span></div>
</div>
<div class="approve">
<h3>Approve on this page</h3>
<p>Approving here tells {{ sender.name | default: 'us' | escape }} to send the order form for the pilot. It is not a contract.</p>
{%- render 'ken/form', id: 'approve', fields: 'name*,title*,note', submit: 'Approve the pilot plan' %}
</div>
<p class="foot">Prepared by {{ sender.name | default: 'our team' | escape }} at {{ company | escape }} for {% if person %}{{ person_name | escape }} at {% endif %}{{ acct | escape }}. Figures come from {{ acct_p | escape }} own numbers, shared on our calls. This document is for {{ acct_p | escape }} internal use.</p>
</div>
</section>
{%- endif %}
</main>
</body>
</html>
