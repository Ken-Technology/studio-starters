{%- assign accent = brand.colors.primary | default: '#4f00d0' -%}
{%- assign font_head = brand.fonts.heading | default: 'Inter' -%}
{%- assign first = person.first_name | default: 'there' -%}
{%- assign short_name = account.name | split: ' - ' | first | split: ' | ' | first | strip | default: account.name -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex">
<title>An outbound campaign for {{ short_name | escape }}</title>
<link rel="icon" type="image/svg+xml" href="{{ asset_url }}/favicon.svg">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_head | replace: ' ', '+' }}:wght@400;600;700&display=swap">
<style>
html,body{margin:0;background:#fff}
.kd{--a:{{ accent }};--ink:#262626;--mute:#62615c;--line:#e7e5dd;--paper:#f4f4f0;font-family:'{{ font_head }}',ui-sans-serif,system-ui,sans-serif;font-size:16px;line-height:1.62;color:var(--ink);max-width:46rem;margin:0 auto;padding:.5rem 1.1rem 4rem}
.kd h1{font-size:2rem;line-height:1.2;letter-spacing:-.012em;margin:1.6rem 0 .5rem}
.kd p{margin:0 0 .9rem}
.kd a{color:var(--a)}
.kd-page{padding:2.6rem 0 .5rem}
.kd-mark{font-weight:700;font-size:.9rem;color:var(--a);margin:0}
.kd-logo{height:28px;width:auto;display:block}
.kd-by{color:var(--mute);margin-bottom:2.2rem!important}
.kd-note{background:var(--paper);border-radius:12px;padding:1rem 1.2rem .2rem;margin:1.4rem 0}
.kd-cta{margin:1.8rem 0}
@media (min-width:640px){.kd{padding:1rem 2rem 5rem}.kd h1{font-size:2.6rem}}
</style>
</head>
<body>
<main class="kd">
<section data-section="cover" class="kd-page">
{%- if brand.logo_url %}
<img class="kd-logo" src="{{ brand.logo_url | escape }}" alt="{{ brand.name | default: 'Logo' | escape }}">
{%- elsif brand.name %}
<p class="kd-mark">{{ brand.name | escape }}</p>
{%- endif %}
<h1>An outbound campaign for {{ short_name | escape }}</h1>
<p class="kd-by">Prepared by {{ sender.name | default: 'our team' | escape }}{% if sender.title %}, {{ sender.title | escape }}{% endif %}</p>
<p>Hi {{ first | escape }},</p>
<p>I'm putting together a sample outbound campaign for {{ short_name | escape }}: who to go after, how to cut the market, a sample of leads, and the first emails written for them.</p>
<div class="kd-note">
<p>The full plan isn't on this page yet. If you'd like it sooner, reply to my email and I'll send it over.</p>
</div>
</section>

<section data-section="next_steps" class="kd-page">
{%- if link.booking_url %}
<p>If you'd rather walk through it together, grab 30 minutes and I'll take you through what I have so far.</p>
<div class="kd-cta">
{% render 'ken/cta', label: 'Book 30 minutes', kind: 'booking' %}
</div>
{%- else %}
<p>If you'd rather walk through it together, reply to my email and I'll take you through what I have so far.</p>
{%- endif %}
<p>Best,<br>{{ sender.name | default: 'Our team' | escape }}</p>
</section>
</main>
</body>
</html>
