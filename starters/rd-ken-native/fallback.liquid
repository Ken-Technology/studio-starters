{%- assign accent = brand.colors.primary | default: '#b3402a' -%}
{%- assign font_head = brand.fonts.heading | default: 'Young Serif' -%}
{%- assign font_body = brand.fonts.body | default: 'Schibsted Grotesk' -%}
{%- assign first = person.first_name | default: 'there' -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex">
<title>A campaign for {{ account.name | escape }}</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_head | replace: ' ', '+' | escape }}&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_body | replace: ' ', '+' | escape }}:wght@400;700&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Courier+Prime:wght@700&display=swap">
<style>
:root{--a:{{ accent | escape }};--ink:#221e19;--mute:#6b6358;--line:#ddd3c2;--paper:#f3ede1;--card:#fffdf8;--hf:'{{ font_head | escape }}',Georgia,serif;--bf:'{{ font_body | escape }}',ui-sans-serif,system-ui,sans-serif;--mf:'Courier Prime',ui-monospace,monospace}
*{box-sizing:border-box}
body{margin:0;background:var(--paper);color:var(--ink);font:16px/1.6 var(--bf);-webkit-font-smoothing:antialiased}
.kn{max-width:40rem;margin:0 auto;padding:0 1.15rem 3rem}
.kn-top{padding:1.1rem 0;border-bottom:1px solid var(--line);font:700 .74rem/1.2 var(--mf);letter-spacing:.09em;text-transform:uppercase}
.kn-logo{height:26px;width:auto;display:block}
.kn .kn-eyebrow{font:700 .78rem/1.3 var(--mf);letter-spacing:.1em;text-transform:uppercase;color:var(--a);margin:2.6rem 0 .9rem}
.kn h1{font:400 2.3rem/1.1 var(--hf);margin:0 0 1.4rem;text-wrap:balance;overflow-wrap:break-word}
.kn p{margin:0 0 1rem}
.kn .kn-note{background:var(--card);border:1px dashed var(--a);border-radius:3px;padding:1rem 1.1rem;margin:1.6rem 0 0}
.kn-cta{margin:2.4rem 0 0;padding:1.6rem 1.3rem;background:var(--card);border:1.5px solid var(--ink);border-radius:4px;box-shadow:6px 6px 0 var(--a)}
.kn-btn{margin:1.2rem 0}
@media (min-width:760px){.kn h1{font-size:3rem}.kn .kn-eyebrow{margin-top:4rem}}
</style>
</head>
<body>
<main class="kn">

<header data-section="hero">
<div class="kn-top">
{%- if brand.logo_url %}
<img class="kn-logo" src="{{ brand.logo_url | escape }}" alt="{{ brand.name | default: 'Logo' | escape }}">
{%- else %}
{{ brand.name | default: sender.name | default: 'Our team' | escape }}
{%- endif %}
</div>
<p class="kn-eyebrow">For {{ account.name | escape }}</p>
<h1>I'm building {{ account.name | escape }} a campaign</h1>
<p>Hi {{ first | escape }},</p>
<p>I'm putting together a short campaign for {{ account.name | escape }}: the people I would email first, and the opening email for a few of them.</p>
<p class="kn-note">The people and the emails aren't on this page yet.</p>
</header>

<section data-section="cta" class="kn-cta">
<p>If you'd rather go through it together, grab 20 minutes and I'll show you what I have so far.</p>
<div class="kn-btn">
{% render 'ken/cta', label: 'Book 20 minutes', kind: 'booking' %}
</div>
<p>{{ sender.name | default: 'Our team' | escape }}</p>
</section>

</main>
</body>
</html>
