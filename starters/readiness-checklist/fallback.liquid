{%- assign accent = brand.colors.primary | default: '#d7261e' -%}
{%- assign accent2 = brand.colors.secondary | default: '#22392f' -%}
{%- assign font_head = brand.fonts.heading | default: 'Young Serif' -%}
{%- assign font_body = brand.fonts.body | default: 'Source Serif 4' -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex">
<title>A readiness checklist for {{ account.name | escape }}</title>
{%- if font_head == 'Young Serif' %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Young+Serif&display=swap">
{%- else %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_head | url_encode }}&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_head | url_encode }}:wght@700&display=swap">
{%- endif %}
{%- if font_body != font_head %}
{%- if font_body == 'Source Serif 4' %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Source+Serif+4:wght@400;600&display=swap">
{%- else %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_body | url_encode }}&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_body | url_encode }}:wght@700&display=swap">
{%- endif %}
{%- endif %}
<style>
:root{--p:{{ accent | escape }};--s:{{ accent2 | escape }};--on-p:#fff;--on-p:oklch(from var(--p) clamp(0.16,(0.6 - l) * 1000,0.99) 0 0);--on-s:#eef0ee;--on-s:oklch(from var(--s) clamp(0.16,(0.6 - l) * 1000,0.99) 0 0);--fh:'{{ font_head | escape }}',Georgia,serif;--fb:'{{ font_body | escape }}',Georgia,serif;--bg:#eef0ee;--ink:#14181a;--text2:#262c29;--muted:#4d5550;--m:clamp(1.125rem,3.6vw,3.5rem)}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:var(--bg);color:var(--ink);font:400 1.125rem/1.6 var(--fb);-webkit-font-smoothing:antialiased}
h1,h2{font-family:var(--fh);font-weight:400;margin:0;line-height:1.08;letter-spacing:-.015em;text-wrap:balance}
p{margin:0}
:focus-visible{outline:3px solid var(--ink);outline-offset:3px}
.rc-top{display:flex;align-items:baseline;justify-content:space-between;gap:1rem;padding:1.25rem var(--m) 0;font-size:.9375rem}
.rc-brand{font-family:var(--fh);font-size:1.125rem}
.rc-logo{height:28px;width:auto;max-width:9rem;display:block}
.rc-top p{color:var(--muted)}
.rc-hero{padding:clamp(2rem,6vw,4rem) var(--m) clamp(2.5rem,6vw,4rem);display:grid;gap:1rem}
.rc-hero h1{font-size:clamp(2rem,1.3rem + 3vw,3.5rem);max-width:20ch;margin-bottom:.5rem}
.rc-hero p{color:var(--text2);max-width:46ch}
.rc-by{font-size:.9375rem;color:var(--muted)!important}
.rc-rows{list-style:none;margin:1rem 0 0;padding:0;border-top:2px solid var(--ink);max-width:40rem}
.rc-rows li{display:grid;grid-template-columns:28px minmax(0,1fr);gap:1rem;align-items:center;padding:1rem 0 .25rem;color:var(--muted)}
.rc-rows i{display:block;width:28px;height:28px;border:2px solid var(--muted);border-radius:2px}
.rc-cta{background:var(--s);color:var(--on-s);padding:clamp(3rem,8vw,6rem) var(--m);display:grid;gap:1.25rem;justify-items:start}
.rc-cta h2{font-size:clamp(2rem,1.3rem + 2.6vw,3.5rem);max-width:18ch}
.rc-cta p{font-size:1.3125rem;line-height:1.5;max-width:44ch}
.rc-cta .ken-cta{display:inline-flex!important;align-items:center;min-height:56px;padding:1rem 1.75rem!important;border-radius:2px!important;background:var(--p)!important;color:var(--on-p)!important;font-family:var(--fb);font-weight:600!important;text-decoration:none}
.rc-cta .ken-cta:focus-visible{outline:3px solid var(--on-s);outline-offset:4px}
.rc-sign{font-weight:600;font-size:1.125rem!important}
.rc-sign span{display:block;font-weight:400}
.rc-foot{font-size:.9375rem;color:var(--muted);padding:1.5rem var(--m) 3rem}
</style>
</head>
<body>
<main class="rc">
<header class="rc-top">
{%- if brand.logo_url %}<img class="rc-logo" src="{{ brand.logo_url | escape }}" alt="{{ brand.name | default: 'Logo' | escape }}">{% elsif brand.name %}<span class="rc-brand">{{ brand.name | escape }}</span>{% else %}<span></span>{% endif -%}
<p>Readiness checklist</p>
</header>
<section data-section="hero" class="rc-hero">
<h1>A readiness checklist for {{ account.name | escape }}</h1>
<p>Hi {{ person.first_name | default: 'there' | escape }}, I'm putting together a short checklist for {{ account.name | escape }}: what is already in place, what is not, and which gaps to close first. You tick the boxes, the page keeps the score.</p>
<p>The list isn't on this page yet. This link stays the same, so check back later today.</p>
<p class="rc-by">{% if person.first_name %}For {{ person.first_name | escape }} at {{ account.name | escape }}{% else %}For the team at {{ account.name | escape }}{% endif %}</p>
<ul class="rc-rows" aria-hidden="true">
<li><i></i>The first thing to have in place</li>
<li><i></i>The second</li>
<li><i></i>The third</li>
</ul>
</section>
<section data-section="cta" class="rc-cta">
<h2>Rather talk it through now?</h2>
<p>Grab 20 minutes and I'll walk you through the list myself, and we can tick it together.</p>
{% render 'ken/cta', label: 'Book 20 minutes', kind: 'booking' %}
<p class="rc-sign">{{ sender.name | default: 'Our team' | escape }}{% if sender.title %}<span>{{ sender.title | escape }}{% if brand.name %}, {{ brand.name | escape }}{% endif %}</span>{% elsif brand.name %}<span>{{ brand.name | escape }}</span>{% endif %}</p>
</section>
<p class="rc-foot">Made for {{ account.name | escape }} by {{ sender.name | default: 'our team' | escape }}.</p>
</main>
</body>
</html>
