{%- comment -%}
Brand: brand.colors.secondary is the stage the inspection tag hangs on (and the closing field), brand.colors.primary the
ticks and the booking button. The tag itself keeps its manila card and red stamp, like the real object. Text on either brand
colour takes a light or dark ink from the colour itself (CSS relative colour). brand.fonts.heading and .body replace Young
Serif and Source Serif 4.
{%- endcomment -%}
{%- assign accent = brand.colors.primary | default: '#b84e49' -%}
{%- assign accent2 = brand.colors.secondary | default: '#22392f' -%}
{%- assign font_head = brand.fonts.heading | default: 'Young Serif' -%}
{%- assign font_body = brand.fonts.body | default: 'Source Serif 4' -%}
{%- assign total = data.items | size -%}
{%- assign safe_total = total | at_least: 1 -%}
{%- assign done = 0 -%}
{%- for item in data.items -%}{%- if item.done -%}{%- assign done = done | plus: 1 -%}{%- endif -%}{%- endfor -%}
{%- assign gaps = total | minus: done -%}
{%- assign pct = done | times: 100 | divided_by: safe_total | floor -%}
{%- if pct >= 80 -%}{%- assign level = 'Ready' -%}{%- elsif pct >= 50 -%}{%- assign level = 'On the way' -%}{%- else -%}{%- assign level = 'Early days' -%}{%- endif -%}
{%- assign has_topic = false -%}
{%- if data.topic and data.topic != '' -%}{%- assign has_topic = true -%}{%- endif -%}
{%- assign h_len = data.headline | size | at_least: 1 -%}
{%- assign h_v = 155.0 | divided_by: h_len | at_most: 5 | round: 2 -%}
{%- assign h_m = 300.0 | divided_by: h_len | at_most: 10 | round: 2 -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex">
<title>{{ data.headline | escape }}</title>
{%- if font_head == 'Young Serif' %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Young+Serif&display=swap">
{%- else %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_head | url_encode }}&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_head | url_encode }}:wght@700&display=swap">
{%- endif %}
{%- if font_body != font_head %}
{%- if font_body == 'Source Serif 4' %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Source+Serif+4:wght@400;600&display=swap">
{%- else %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_body | url_encode }}&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_body | url_encode }}:wght@700&display=swap">
{%- endif %}
{%- endif %}
<script defer src="https://cdn.jsdelivr.net/npm/@alpinejs/csp@3/dist/cdn.min.js"></script>
<style>
:root{
  --p:{{ accent | escape }};
  --s:{{ accent2 | escape }};
  --on-p:#fff;
  --on-p:color(from var(--p) xyz-d65 clamp(0,(.18 - y) * 1000000,.9505) clamp(0,(.18 - y) * 1000000,1) clamp(0,(.18 - y) * 1000000,1.089));
  --on-s:#eef0ee;
  --on-s:color(from var(--s) xyz-d65 clamp(0,(.18 - y) * 1000000,.9505) clamp(0,(.18 - y) * 1000000,1) clamp(0,(.18 - y) * 1000000,1.089));
  --fh:'{{ font_head | escape }}',Georgia,serif;
  --fb:'{{ font_body | escape }}',Georgia,serif;
  --bg:#eef0ee;
  --ink:#14181a;
  --text2:#262c29;
  --muted:#4d5550;
  --line:#c9cfcb;
  --tag:#ead9a8;
  --tag-edge:#b9a674;
  --stamp:#a23d3a;
  --m:clamp(1.125rem,3.6vw,3.5rem);
  --small:.9375rem;
  --body:1.125rem;
  --lead:1.3125rem;
  --head:clamp(1.75rem,1.3rem + 1.4vw,2.25rem);
}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:var(--bg);color:var(--ink);font:400 var(--body)/1.6 var(--fb);-webkit-font-smoothing:antialiased;font-variant-numeric:lining-nums tabular-nums}
h1,h2,h3{font-family:var(--fh);font-weight:400;margin:0;text-wrap:balance}
h1{line-height:1.06;letter-spacing:-.02em}
h2{font-size:var(--head);line-height:1.1;letter-spacing:-.015em}
p{margin:0}
[hidden]{display:none!important}
:focus-visible{outline:3px solid var(--ink);outline-offset:3px}

.rc-cols{display:grid}
.rc-top{display:flex;align-items:baseline;justify-content:space-between;gap:1rem;padding:1.25rem var(--m) 0;font-size:var(--small)}
.rc-brand{font-family:var(--fh);font-size:1.125rem}
.rc-logo{height:28px;width:auto;max-width:9rem;display:block}
.rc-top p{color:var(--muted);text-align:right}

.rc-hero{padding:clamp(2rem,6vw,4rem) var(--m) clamp(2rem,5vw,3rem)}
.rc-hero h1{font-size:clamp(1.375rem,var(--hm),2.75rem);margin-bottom:1.25rem}
.rc-intro{font-size:var(--body);line-height:1.5;color:var(--text2);max-width:40ch;text-wrap:pretty}
.rc-by{font-size:var(--small);color:var(--muted);margin-top:1.5rem;line-height:1.5}

.rc-stage{background:var(--s);color:var(--on-s);display:grid;place-items:center;padding:3.5rem var(--m) 2.75rem;overflow:hidden;position:relative}
.tagwrap{position:relative;width:min(21rem,100%);transform-origin:50% 1.85rem;transform:rotate(-2deg)}
.tagwrap::before{content:'';position:absolute;left:50%;top:-100vh;width:2px;height:calc(100vh + 1.85rem);margin-left:-1px;background:color-mix(in srgb,var(--on-s) 70%,var(--s))}
.tag{position:relative;background:var(--tag);color:var(--ink);padding:3.6rem 1.5rem 1.4rem;clip-path:polygon(16% 0,84% 0,100% 7%,100% 100%,0 100%,0 7%)}
.tag-shape{position:absolute;inset:0;width:100%;height:100%;display:block}
.tag-shape path{fill:none;stroke:var(--tag-edge);stroke-width:3}
.eyelet{position:absolute;left:50%;top:1.85rem;width:1.75rem;height:1.75rem;margin:-.875rem 0 0 -.875rem;border-radius:50%;background:var(--s);border:.4rem solid var(--tag-edge)}
.tag-title{font-family:var(--fh);font-size:var(--lead);line-height:1.2;padding-bottom:.6rem;border-bottom:2px solid var(--ink)}
.tag-for{font-size:var(--small);padding-top:.75rem}
.tag-score{display:flex;align-items:flex-end;justify-content:space-between;gap:1rem;padding:1rem 0 .25rem}
.rc-count{font-size:var(--small);line-height:1.3}
.rc-count b{display:block;font-family:var(--fh);font-weight:400;font-size:5.5rem;line-height:.85;letter-spacing:-.04em;margin-bottom:.35rem}
.rc-pct{font-family:var(--fh);font-size:var(--head);line-height:1}
.rc-lvl{display:inline-block;margin:1rem 0 1.1rem;padding:.2rem .7rem .3rem;border:3px solid var(--stamp);color:var(--stamp);font-family:var(--fh);font-size:1.75rem;line-height:1.15;transform:rotate(-4deg);transform-origin:left center}
.holes{display:grid;grid-template-columns:repeat(5,1.5rem);gap:.7rem 1rem;padding:.9rem 0 1rem;border-top:2px solid var(--ink);border-bottom:2px solid var(--ink)}
.holes i{display:block;width:1.5rem;height:1.5rem;border-radius:50%;border:1.5px solid color-mix(in srgb,var(--ink) 55%,var(--tag))}
.holes i[data-on="yes"]{background:var(--s);border-color:var(--s)}
.rc-scale{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.5rem;padding-top:.85rem}
.rc-seg{font-size:var(--small);line-height:1.3}
.rc-seg i{display:block;width:.9rem;height:.9rem;border:1.5px solid var(--ink);margin-bottom:.35rem}
.rc-seg[data-on="yes"] i{background:var(--ink)}
.rc-seg[data-on="yes"] b{font-weight:600}
.rc-seg b{font-weight:400;display:block}
.rc-hint{font-size:var(--small);line-height:1.45;margin-top:1.75rem;max-width:30ch;text-align:center;color:var(--on-s)}

.rc-list,.rc-gaps{padding:clamp(2.5rem,6vw,4rem) var(--m) 0}
.rc-hero h1{max-width:30ch}
.rc-sub{color:var(--muted);margin:.6rem 0 1.5rem;max-width:44ch;text-wrap:pretty}
.rc-items{list-style:none;margin:0;padding:0;border-top:2px solid var(--ink)}
.rc-hit{display:grid;grid-template-columns:28px minmax(0,1fr);gap:1rem;padding:1.25rem 0 .75rem;cursor:pointer;align-items:start}
.rc-hit:hover .rc-box{background:color-mix(in srgb,var(--p) 14%,var(--bg))}
.rc-box{appearance:none;-webkit-appearance:none;width:28px;height:28px;margin:.15rem 0 0;border:2px solid var(--ink);border-radius:2px;background:var(--bg);position:relative;cursor:pointer}
.rc-box:checked,.rc-hit:hover .rc-box:checked{background:var(--p);border-color:var(--p)}
.rc-box:checked::after{content:'';position:absolute;left:8px;top:2px;width:7px;height:14px;border:solid var(--on-p);border-width:0 3px 3px 0;transform:rotate(45deg)}
.rc-box:focus-visible{outline:3px solid var(--ink);outline-offset:3px}
.rc-label{display:block;font-weight:600;font-size:var(--body);line-height:1.35;text-wrap:pretty}
.rc-detail{display:block;color:var(--text2);margin-top:.3rem;text-wrap:pretty;line-height:1.55}
.rc-note{display:block;font-style:italic;font-size:var(--small);color:var(--muted);margin-top:.5rem;line-height:1.5}

.rc-gap-list{margin:0;padding:0;list-style:none;counter-reset:gap;border-top:2px solid var(--ink)}
.rc-gap{counter-increment:gap;display:grid;grid-template-columns:2.25rem minmax(0,1fr);gap:1rem;padding:1.25rem 0 .5rem}
.rc-gap::before{content:counter(gap);font-family:var(--fh);font-size:var(--head);line-height:1}
.rc-gap h3{font-family:var(--fb);font-weight:600;font-size:var(--body);line-height:1.35;margin:.1rem 0 .35rem}
.rc-step{color:var(--text2);line-height:1.55;text-wrap:pretty}
.rc-steplab{font-weight:600;color:var(--ink)}
.rc-gap-empty{font-size:var(--lead);line-height:1.5;max-width:40ch;padding-top:1.25rem;border-top:2px solid var(--ink)}
{% for item in data.items %}.rc:has(#rc-ck{{ forloop.index0 }}:checked) #rc-gap{{ forloop.index0 }}{display:none}
{% endfor -%}

.rc-cta{background:var(--s);color:var(--on-s);margin-top:clamp(3.5rem,8vw,6rem);padding:clamp(3rem,8vw,6rem) var(--m);display:grid;gap:1.25rem;justify-items:start}
.rc-cta h2{font-size:clamp(2rem,1.3rem + 2.6vw,3.5rem);max-width:18ch}
.rc-cta p{font-size:var(--lead);line-height:1.5;max-width:44ch}
.rc-cta .ken-cta{display:inline-flex!important;align-items:center;min-height:56px;padding:1rem 1.75rem!important;border-radius:2px!important;background:var(--p)!important;color:var(--on-p)!important;font-family:var(--fb);font-weight:600!important;font-size:var(--body);text-decoration:none}
.rc-cta .ken-cta:focus-visible{outline:3px solid var(--on-s);outline-offset:4px}
.rc-sign{font-weight:600;font-size:var(--body)!important}
.rc-sign span{display:block;font-weight:400}
.rc-foot{font-size:var(--small);color:var(--muted);padding:1.5rem var(--m) 3rem;max-width:60ch}

.rc-bar{position:sticky;bottom:0;z-index:5;margin-top:2rem;display:flex;align-items:center;gap:.9rem;padding:.75rem var(--m);padding-bottom:calc(.75rem + env(safe-area-inset-bottom));background:var(--s);color:var(--on-s);font-size:var(--small)}
.rc-bar b{font-family:var(--fh);font-weight:400;font-size:var(--lead)}
.rc-bar-track{flex:1;height:6px;display:block}
.rc-bar-track rect.t{fill:color-mix(in srgb,var(--on-s) 25%,var(--s))}
.rc-bar-track rect.f{fill:var(--tag)}
.rc-bar-pct{font-family:var(--fh);font-size:var(--body)}

@keyframes swing{from{transform:rotate(-11deg)}55%{transform:rotate(2.5deg)}80%{transform:rotate(-3deg)}to{transform:rotate(-2deg)}}
@media (prefers-reduced-motion:no-preference){.tagwrap{animation:swing 1.6s cubic-bezier(.3,.7,.3,1) both}}

@media (min-width:980px){
  .rc-cols{grid-template-columns:minmax(0,44fr) minmax(0,56fr);grid-template-rows:auto auto 1fr}
  .rc-stage{grid-column:1;grid-row:1 / -1;position:sticky;top:0;height:100svh;align-self:start;padding:3rem var(--m)}
  .rc-top{grid-column:2;grid-row:1}
  .rc-hero{grid-column:2;grid-row:2}
  .rc-hero h1{font-size:clamp(2rem,var(--hv),3.75rem)}
  .rc-intro{font-size:var(--lead)}
  .rc-work{grid-column:2;grid-row:3}
  .rc-gaps{padding-bottom:1rem}
  .tagwrap{width:min(22rem,80%)}
  .rc-top,.rc-hero,.rc-list,.rc-gaps{max-width:none;padding-left:clamp(2rem,4vw,4rem);padding-right:var(--m)}
  .rc-bar{display:none}
}
@media (min-width:980px) and (max-height:760px){
  .tag{padding-top:3.2rem}
  .rc-count b{font-size:4.25rem}
  .rc-lvl{margin:.6rem 0 .7rem}
  .rc-hint{margin-top:1rem}
}
</style>
</head>
<body style="--hv:{{ h_v }}vw;--hm:{{ h_m }}vw">
<main class="rc" x-data="{ {% for item in data.items %}d{{ forloop.index0 }}: {% if item.done %}true{% else %}false{% endif %}, {% endfor %}score: {{ done | escape }}, total: {{ safe_total | escape }} }">
<div class="rc-cols">
<header class="rc-top">
{%- if brand.logo_url %}<img class="rc-logo" src="{{ brand.logo_url | escape }}" alt="{{ brand.name | default: 'Logo' | escape }}">{% elsif brand.name %}<span class="rc-brand">{{ brand.name | escape }}</span>{% else %}<span></span>{% endif -%}
<p>{% if has_topic %}{{ data.topic | escape }} readiness{% else %}Readiness checklist{% endif %}</p>
</header>
<section data-section="hero" class="rc-hero">
<h1>{{ data.headline | escape }}</h1>
<p class="rc-intro">{{ data.intro | escape | newline_to_br | strip_newlines | raw }}</p>
<p class="rc-by">{% if person.first_name %}For {{ person.first_name | escape }}{% if person.last_name %} {{ person.last_name | escape }}{% endif %}{% if person.title %}, {{ person.title | escape }}{% endif %} at {{ account.name | escape }}{% else %}For the team at {{ account.name | escape }}{% endif %}<br>Prepared by {{ sender.name | default: 'our team' | escape }}{% if sender.title %}, {{ sender.title | escape }}{% endif %}{% if brand.name %} at {{ brand.name | escape }}{% endif %}</p>
</section>
<aside data-section="score" class="rc-stage">
<div class="tagwrap">
<div class="tag">
<svg class="tag-shape" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true"><path d="M16 0.5H84L99.5 7V99.5H0.5V7Z" vector-effect="non-scaling-stroke"/></svg>
<span class="eyelet" aria-hidden="true"></span>
<p class="tag-title">{% if has_topic %}{{ data.topic | escape }} readiness{% else %}Readiness checklist{% endif %}</p>
<div class="tag-score">
<p class="rc-count"><b x-text="score">{{ done }}</b>of <span x-text="total">{{ total }}</span> in place</p>
<p class="rc-pct"><span x-text="(score * 100 - (score * 100) % total) / total">{{ pct }}</span>%</p>
</div>
<p class="rc-lvl" x-text="score * 100 / total >= 80 ? 'Ready' : score * 100 / total >= 50 ? 'On the way' : 'Early days'">{{ level }}</p>
<div class="holes" aria-hidden="true">
{%- for item in data.items %}<i data-on="{% if item.done %}yes{% else %}no{% endif %}" x-bind:data-on="d{{ forloop.index0 }} ? 'yes' : 'no'"></i>{% endfor -%}
</div>
<div class="rc-scale" aria-hidden="true">
<div class="rc-seg" data-on="{% if pct < 50 %}yes{% else %}no{% endif %}" x-bind:data-on="score * 100 / total < 50 ? 'yes' : 'no'"><i></i><b>Early days</b>0 to 49</div>
<div class="rc-seg" data-on="{% if pct >= 50 and pct < 80 %}yes{% else %}no{% endif %}" x-bind:data-on="score * 100 / total >= 50 && score * 100 / total < 80 ? 'yes' : 'no'"><i></i><b>On the way</b>50 to 79</div>
<div class="rc-seg" data-on="{% if pct >= 80 %}yes{% else %}no{% endif %}" x-bind:data-on="score * 100 / total >= 80 ? 'yes' : 'no'"><i></i><b>Ready</b>80 to 100</div>
</div>
<p class="tag-for">{{ account.name | escape }}</p>
</div>
</div>
<p class="rc-hint">Tick what is in place. The score and the gaps update as you go.</p>
</aside>
<div class="rc-work">
<section data-section="checklist" class="rc-list">
<h2>The checklist</h2>
<p class="rc-sub">{{ total }} items, in the order that matters most.{% if done > 0 %} We ticked what we could see from outside, so fix anything we got wrong.{% endif %}</p>
<ol class="rc-items">
{%- for item in data.items %}
<li class="rc-item">
<label class="rc-hit" for="rc-ck{{ forloop.index0 }}">
<input id="rc-ck{{ forloop.index0 }}" class="rc-box" type="checkbox"{% if item.done %} checked{% endif %} x-model="d{{ forloop.index0 }}" x-on:change="score = score + (d{{ forloop.index0 }} ? 1 : -1)">
<span class="rc-body">
<span class="rc-label">{{ item.label | escape }}</span>
<span class="rc-detail">{{ item.detail | escape }}</span>
{%- if item.note and item.note != '' %}
<span class="rc-note">{{ item.note | escape }}</span>
{%- endif %}
</span>
</label>
</li>
{%- endfor %}
</ol>
</section>
<section data-section="gaps" class="rc-gaps">
<h2>Close these first</h2>
<p class="rc-sub"{% if gaps == 0 %} hidden{% endif %} x-bind:hidden="score == total"><span x-text="total - score">{{ gaps }}</span> <span x-text="total - score == 1 ? 'gap' : 'gaps'">{% if gaps == 1 %}gap{% else %}gaps{% endif %}</span>, in the order to close them. Each one comes with a first step you can take this week.</p>
<ol class="rc-gap-list">
{%- for item in data.items %}
<li class="rc-gap" id="rc-gap{{ forloop.index0 }}"{% if item.done %} hidden{% endif %} x-bind:hidden="d{{ forloop.index0 }}">
<div>
<h3>{{ item.label | escape }}</h3>
<p class="rc-step"><span class="rc-steplab">First step:</span> {{ item.first_step | escape }}</p>
</div>
</li>
{%- endfor %}
</ol>
<p class="rc-gap-empty"{% unless gaps == 0 %} hidden{% endunless %} x-bind:hidden="score != total">Everything on this list is in place. If that holds up on a closer look, {{ account.name | escape }} is ready, and the call below is a short one.</p>
</section>
<div class="rc-bar" aria-hidden="true">
<span class="rc-bar-n"><b x-text="score">{{ done }}</b> of <span x-text="total">{{ total }}</span> in place</span>
<svg class="rc-bar-track" viewBox="0 0 100 4" preserveAspectRatio="none"><rect class="t" x="0" y="0" width="100" height="4"></rect><rect class="f" x="0" y="0" width="{{ pct }}" height="4" x-bind:width="score * 100 / total"></rect></svg>
<span class="rc-bar-pct"><span x-text="(score * 100 - (score * 100) % total) / total">{{ pct }}</span>%</span>
</div>
</div>
</div>
<section data-section="cta" class="rc-cta">
<h2>Want to go through the gaps together?</h2>
<p>{{ data.closing | escape | newline_to_br | strip_newlines | raw }}</p>
{% render 'ken/cta', label: 'Book 20 minutes', kind: 'booking' %}
<p class="rc-sign">{{ sender.name | default: 'Our team' | escape }}{% if sender.title %}<span>{{ sender.title | escape }}{% if brand.name %}, {{ brand.name | escape }}{% endif %}</span>{% elsif brand.name %}<span>{{ brand.name | escape }}</span>{% endif %}</p>
</section>
<p class="rc-foot">Made for {{ account.name | escape }} by {{ sender.name | default: 'our team' | escape }}. Your ticks stay in this browser and are not saved or shared.</p>
</main>
</body>
</html>
