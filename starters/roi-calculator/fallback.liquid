{%- assign accent = brand.colors.primary | default: '#256f82' -%}
{%- assign font_head = brand.fonts.heading | default: 'Libre Franklin' -%}
{%- assign font_body = brand.fonts.body | default: 'Libre Franklin' -%}
{%- assign head_q = font_head | replace: ' ', '+' -%}
{%- assign body_q = font_body | replace: ' ', '+' -%}
{%- if font_head == 'Libre Franklin' -%}{%- assign head_w = '400;600;800' -%}{%- else -%}{%- assign head_w = '400;700' -%}{%- endif -%}
{%- if font_body == 'Libre Franklin' -%}{%- assign body_w = '400;600;800' -%}{%- else -%}{%- assign body_w = '400;700' -%}{%- endif -%}
{%- assign brand_name = brand.name | default: '' -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex">
<title>What manual work costs {{ account.name | escape }} each year</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ head_q | escape }}:wght@{{ head_w }}&display=swap">
{%- if body_q != head_q %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ body_q | escape }}:wght@{{ body_w }}&display=swap">
{%- endif %}
<style>
:root{--p:{{ accent | escape }};--on-p:#fff;--on-p:oklch(from var(--p) clamp(0.16,(0.6 - l) * 1000,0.99) 0 0);--fh:'{{ font_head | escape }}','Helvetica Neue',Arial,sans-serif;--fb:'{{ font_body | escape }}','Helvetica Neue',Arial,sans-serif;--bg:#dedad3;--ink:#0a0a0a;--muted:#57534d;--m:clamp(1.125rem,3.2vw,2.5rem)}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:var(--bg);color:var(--ink);font:400 1.0625rem/1.5 var(--fb);-webkit-font-smoothing:antialiased}
h1,h2{font-family:var(--fh);margin:0;font-weight:800;letter-spacing:-.03em;line-height:1;text-wrap:balance}
p{margin:0}
:focus-visible{outline:3px solid var(--ink);outline-offset:3px}
.top{padding:1.25rem var(--m) 0;font-family:var(--fh);font-weight:800}
.logo{height:28px;width:auto;max-width:9rem;display:block}
.intro{padding:clamp(2.5rem,7vw,5rem) var(--m) 2.5rem;display:grid;gap:1rem;max-width:52rem}
.intro h1{font-size:clamp(2rem,1.2rem + 4vw,4.5rem)}
.intro p{max-width:46ch}
.cta{background:var(--p);color:var(--on-p);padding:clamp(2.5rem,6vw,4.5rem) var(--m);display:grid;gap:1rem;justify-items:start}
.cta h2{font-size:clamp(1.75rem,1.2rem + 2.4vw,3rem)}
.cta p{max-width:44ch}
.who b{display:block;font-weight:600}
.cta .ken-cta{display:inline-flex!important;align-items:center;min-height:52px;padding:.95rem 1.6rem!important;border-radius:0!important;background:var(--on-p)!important;color:var(--p)!important;font-family:var(--fh);font-weight:800!important;text-decoration:none}
</style>
</head>
<body>
<header class="top">
  {%- if brand.logo_url and brand.logo_url != '' %}<img class="logo" src="{{ brand.logo_url | escape }}" alt="{{ brand_name | default: 'Logo' | escape }}">
  {%- elsif brand_name != '' %}{{ brand_name | escape }}{% endif -%}
</header>
<main>
  <section class="intro" data-section="intro">
    <h1>What manual work costs {{ account.name | escape }} each year</h1>
    <p>Hi {{ person.first_name | default: 'there' | escape }}, we are putting together a short worksheet for {{ account.name | escape }}. It estimates what the repetitive manual work in your team costs each year and what taking it off your plate would save.</p>
    <p>The worksheet is not ready on this page yet. On a call we can fill in the numbers together.</p>
  </section>
  <section class="cta" data-section="cta">
    <h2>Rather go through it now?</h2>
    <p>Thirty minutes. We go through the numbers together, using your own figures.</p>
    {%- if sender.name and sender.name != '' %}
    <p class="who"><b>{{ sender.name | escape }}</b>{% if sender.title and sender.title != '' %}{{ sender.title | escape }}{% if brand_name != '' %}, {{ brand_name | escape }}{% endif %}{% elsif brand_name != '' %}{{ brand_name | escape }}{% endif %}</p>
    {%- endif %}
    {% render 'ken/cta', label: 'Book 30 minutes', kind: 'booking' %}
  </section>
</main>
</body>
</html>
