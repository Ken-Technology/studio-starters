{%- comment -%}
Brand: only brand.colors.primary and .secondary, brand.fonts.heading and .body, brand.name and brand.logo_url, each with a default.
Primary is the accent (slider fill, payback marker, the closing field); secondary is the dark field the return chart stands on.
Text on either field takes a light or dark ink from the colour itself (CSS relative colour), so any brand colour stays readable.
The first screen is computed here in Liquid so the page reads right with JavaScript off. The Alpine CSP build then takes over: the
same maths runs as x-effect lines on the x-data object (the CSP build cannot define getters in a literal), so every number,
bar and the payback marker follows the sliders.
{%- endcomment -%}
{%- assign accent = brand.colors.primary | default: '#256f82' -%}
{%- assign accent2 = brand.colors.secondary | default: '#111111' -%}
{%- assign font_head = brand.fonts.heading | default: 'Libre Franklin' -%}
{%- assign font_body = brand.fonts.body | default: 'Libre Franklin' -%}
{%- assign head_q = font_head | replace: ' ', '+' -%}
{%- assign body_q = font_body | replace: ' ', '+' -%}
{%- if font_head == 'Libre Franklin' -%}{%- assign head_w = '400;600;800' -%}{%- else -%}{%- assign head_w = '400;700' -%}{%- endif -%}
{%- if font_body == 'Libre Franklin' -%}{%- assign body_w = '400;600;800' -%}{%- else -%}{%- assign body_w = '400;700' -%}{%- endif -%}
{%- assign brand_name = brand.name | default: '' -%}
{%- assign work = data.work_name | default: 'work' -%}
{%- assign sender_first = sender.name | default: '' | split: ' ' | first -%}

{%- comment %} Inputs, and the assumptions that come from the offer in Knowledge {%- endcomment -%}
{%- assign team = data.team_size | default: 0 -%}
{%- assign hours = data.hours_per_week | default: 0 -%}
{%- assign rate = data.hourly_cost | default: 0 -%}
{%- assign tools = data.tool_spend | default: 0 -%}
{%- assign seat = data.offer.seat_price | default: 0 -%}
{%- assign setup = data.offer.setup_fee | default: 0 -%}
{%- assign share = data.offer.recovered_share | default: 40 -%}
{%- assign tshare = data.offer.tool_replaced_share | default: 50 -%}
{%- assign ramp = data.offer.ramp_months | default: 6 | at_least: 1 | at_most: 9 -%}
{%- assign weeks = 48 -%}
{%- assign has_price = false -%}
{%- if seat > 0 -%}{%- assign has_price = true -%}{%- endif -%}

{%- comment %} Slider ranges {%- endcomment -%}
{%- assign team_max = team | times: 4 | at_least: 100 -%}
{%- assign hours_max = hours | times: 3 | at_least: 30 -%}
{%- assign rate_max = rate | times: 3 | at_least: 120 -%}
{%- assign tools_max = tools | times: 4 | at_least: 10000 -%}
{%- assign team_max_span = team_max | minus: 1 -%}
{%- assign hours_max_span = hours_max | minus: 1 -%}
{%- assign rate_max_span = rate_max | minus: 10 -%}
{%- assign team_pct = team | minus: 1 | times: 100.0 | divided_by: team_max_span | round: 1 -%}
{%- assign hours_pct = hours | minus: 1 | times: 100.0 | divided_by: hours_max_span | round: 1 -%}
{%- assign rate_pct = rate | minus: 10 | times: 100.0 | divided_by: rate_max_span | round: 1 -%}
{%- assign tools_pct = tools | times: 100.0 | divided_by: tools_max | round: 1 -%}

{%- comment %} The model {%- endcomment -%}
{%- assign manual = team | times: hours | times: weeks | times: rate -%}
{%- assign labor = manual | times: share | divided_by: 100.0 -%}
{%- assign tool_save = tools | times: 12 | times: tshare | divided_by: 100.0 -%}
{%- assign platform = team | times: seat | times: 12 -%}
{%- assign gross = labor | plus: tool_save -%}
{%- assign net = gross | minus: platform -%}
{%- assign hours_back = team | times: hours | times: weeks | times: share | divided_by: 100.0 -%}
{%- assign g = gross | divided_by: 12.0 -%}
{%- assign c = platform | divided_by: 12.0 -%}
{%- assign ramp_f = ramp | times: 1.0 -%}
{%- assign cum = 0 | minus: setup -%}
{%- assign gross_total = 0 -%}
{%- assign pb = 1 -%}
{%- assign qlist = '' -%}
{%- for m in (1..36) -%}
  {%- if m <= ramp -%}{%- assign f = m | divided_by: ramp_f -%}{%- else -%}{%- assign f = 1 -%}{%- endif -%}
  {%- assign inc = g | times: f -%}
  {%- assign gross_total = gross_total | plus: inc -%}
  {%- assign cum = cum | plus: inc | minus: c -%}
  {%- if cum < 0 -%}{%- assign pb = pb | plus: 1 -%}{%- endif -%}
  {%- assign mm = m | modulo: 3 -%}
  {%- if mm == 0 -%}{%- assign qlist = qlist | append: cum | append: '|' -%}{%- endif -%}
{%- endfor -%}
{%- assign three = cum -%}
{%- assign cost_total = c | times: 36 | plus: setup -%}
{%- assign mult = 0 -%}
{%- if cost_total > 0 -%}{%- assign mult = gross_total | divided_by: cost_total -%}{%- endif -%}
{%- assign mult10 = mult | times: 10 | round -%}
{%- assign mult_w = mult10 | divided_by: 10.0 | floor -%}
{%- assign mult_f = mult10 | modulo: 10 -%}
{%- if pb > 36 -%}{%- assign pb_text = 'Over 3 years' -%}{%- elsif pb == 1 -%}{%- assign pb_text = '1 month' -%}{%- else -%}{%- assign pb_text = pb | append: ' months' -%}{%- endif -%}

{%- comment %} Thousands separators: one pass over every figure the page prints. m = dollars, n = a plain count {%- endcomment -%}
{%- capture raw_list -%}
m{{ manual | round }}|m{{ labor | round }}|m{{ tool_save | round }}|m{{ platform | round }}|m{{ net | round }}|m{{ three | round }}|n{{ hours_back | round }}|m{{ seat }}|m{{ setup }}
{%- endcapture -%}
{%- assign raw_items = raw_list | split: '|' -%}
{%- assign fm_out = '' -%}
{%- for r in raw_items -%}
  {%- assign kind = r | slice: 0, 1 -%}
  {%- assign num = r | slice: 1, 24 -%}
  {%- assign neg = '' -%}
  {%- if num contains '-' -%}{%- assign neg = '-' -%}{%- assign num = num | remove: '-' -%}{%- endif -%}
  {%- assign len = num | size -%}
  {%- assign head = len | modulo: 3 -%}
  {%- if head == 0 -%}{%- assign head = 3 -%}{%- endif -%}
  {%- assign out = num | slice: 0, head -%}
  {%- for p in (1..4) -%}
    {%- assign pos = p | times: 3 | plus: head | minus: 3 -%}
    {%- if pos < len -%}{%- assign grp = num | slice: pos, 3 -%}{%- assign out = out | append: ',' | append: grp -%}{%- endif -%}
  {%- endfor -%}
  {%- if kind == 'm' -%}{%- assign out = '$' | append: out -%}{%- endif -%}
  {%- assign fm_out = fm_out | append: neg | append: out | append: '|' -%}
{%- endfor -%}
{%- assign fm = fm_out | split: '|' -%}

{%- comment %} Chart geometry, viewBox 600 x 230 {%- endcomment -%}
{%- assign qs = qlist | split: '|' -%}
{%- assign v3 = qs[0] | plus: 0 -%}
{%- assign v6 = qs[1] | plus: 0 -%}
{%- assign v9 = qs[2] | plus: 0 -%}
{%- assign v36 = qs[11] | plus: 0 -%}
{%- assign hi = v3 | at_least: v36 | at_least: 1 -%}
{%- assign lo = v3 | at_most: v6 | at_most: v9 | at_most: v36 | at_most: 0 -%}
{%- assign span = hi | minus: lo -%}
{%- assign k = 154.0 | divided_by: span -%}
{%- assign base = hi | times: k | plus: 34 -%}
{%- assign step = 584 | divided_by: 12.0 -%}
{%- assign step3 = step | divided_by: 3.0 -%}
{%- assign gap = step | times: 0.22 -%}
{%- assign bw = step | minus: gap -%}
{%- assign pb_x = step3 | times: pb | plus: 8 -%}

{%- comment %} Headline size from its length, so a long work name or account name still sets on two lines {%- endcomment -%}
{%- capture h1_text -%}What manual {{ work }} costs {{ account.name }} a year{%- endcapture -%}
{%- capture zig -%}0 0,100% 0{%- for t in (0..23) -%}{%- assign tx = 24 | minus: t | times: 4.1667 -%}{%- assign tm = tx | minus: 2.0833 -%},{{ tx | round: 2 }}% 0,{{ tm | round: 2 }}% 100%{%- endfor -%},0 0{%- endcapture -%}
{%- assign h1_len = h1_text | size | at_least: 1 -%}
{%- assign h1_v = 290.0 | divided_by: h1_len | round: 2 -%}

{%- capture xdata -%}
{ team: {{ team }}, hours: {{ hours }}, rate: {{ rate }}, tools: {{ tools }}, seat: {{ seat }}, setup: {{ setup }}, share: {{ share }}, toolShare: {{ tshare }}, ramp: {{ ramp }}, weeks: {{ weeks }}, manual: 0, labor: 0, toolSave: 0, platform: 0, gross: 0, net: 0, hoursBack: 0
{%- if has_price -%}
, g: 0, c: 0, pb: 0, three: 0, mult: 0, hi1: 0, hi: 0, lo1: 0, lo2: 0, lo3: 0, lo: 0, k: 0, base: 0
{%- for m in (1..36) -%}, z{{ m }}: 0{%- endfor -%}
{%- endif -%}
 }
{%- endcapture -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex">
<title>What manual {{ work | escape }} costs {{ account.name | escape }} each year</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ head_q | escape }}:wght@{{ head_w }}&display=swap">
{%- if body_q != head_q %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ body_q | escape }}:wght@{{ body_w }}&display=swap">
{%- endif %}
<style>
:root{
  --p:{{ accent | escape }};
  --s:{{ accent2 | escape }};
  --on-p:#fff;
  --on-p:oklch(from var(--p) clamp(0.16,(0.6 - l) * 1000,0.99) 0 0);
  --on-s:#fff;
  --on-s:oklch(from var(--s) clamp(0.16,(0.6 - l) * 1000,0.99) 0 0);
  --fh:'{{ font_head | escape }}','Helvetica Neue',Arial,sans-serif;
  --fb:'{{ font_body | escape }}','Helvetica Neue',Arial,sans-serif;
  --bg:#dedad3;
  --surface:#d1ccc3;
  --paper:#f3f3f1;
  --ink:#0a0a0a;
  --muted:#57534d;
  --m:clamp(1.125rem,3.2vw,2.5rem);
  --small:.875rem;
  --body:1.0625rem;
  --lead:clamp(1.1875rem,1.05rem + .5vw,1.4375rem);
}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:var(--bg);color:var(--ink);font:400 var(--body)/1.5 var(--fb);-webkit-font-smoothing:antialiased;font-variant-numeric:tabular-nums lining-nums}
h1,h2,h3{font-family:var(--fh);margin:0;font-weight:800;letter-spacing:-.025em;line-height:1;text-wrap:balance}
p{margin:0}
a{color:inherit;text-underline-offset:.18em;text-decoration-thickness:.07em}
button,input{font:inherit}
:focus-visible{outline:3px solid var(--ink);outline-offset:3px}
::selection{background:var(--ink);color:var(--paper)}

.top{display:flex;align-items:baseline;justify-content:space-between;gap:1rem;padding:1.25rem var(--m) 0}
.brand{display:flex;align-items:center;font-family:var(--fh);font-weight:800;font-size:1.0625rem;letter-spacing:-.01em;min-width:0}
.logo{height:28px;width:auto;max-width:9rem;display:block}
.for{font-size:var(--small);color:var(--muted);text-align:right}

.intro{padding:clamp(2.25rem,6vw,4.5rem) var(--m) clamp(1.75rem,3vw,2.75rem);display:grid;gap:1.1rem}
.intro h1{font-size:clamp(1.3rem,var(--h1v),5.25rem);letter-spacing:-.035em;line-height:.98}
.lede{font-size:var(--body);line-height:1.45;max-width:44ch}

/* The worksheet: four faders on the left, the printed tape on the right */
.work{display:grid;grid-template-columns:minmax(0,1fr);grid-template-areas:"result" "inputs" "ledger";padding:0 var(--m);gap:0}

/* The tape. On a phone its head (the result) sticks to the top while the faders move. */
.result{grid-area:result;background:var(--ink);color:var(--paper);padding:1rem 1.1rem 1.05rem;position:sticky;top:0;z-index:5;margin:0 calc(var(--m) * -1)}
.result h2{font-family:var(--fb);font-weight:400;font-size:var(--small);letter-spacing:0;line-height:1.35;color:color-mix(in srgb,var(--paper) 78%,var(--ink))}
.big{font-family:var(--fh);font-weight:800;font-size:clamp(2.6rem,11vw,3.4rem);line-height:.95;letter-spacing:-.04em;margin:.3rem 0 .7rem}
.kpis{display:grid;grid-template-columns:repeat(3,auto);justify-content:start;gap:.15rem 1.4rem;margin:0}
.kpis div{display:grid}
.kpis dt{font-size:var(--small);color:color-mix(in srgb,var(--paper) 78%,var(--ink))}
.kpis dd{margin:0;font-family:var(--fh);font-weight:600;font-size:var(--body)}

.inputs{grid-area:inputs;padding:2rem 0 2.5rem}
.inputs h2,.ledger h2{font-size:clamp(1.5rem,1.2rem + 1.2vw,2rem);margin-bottom:.4rem}
.ui{font-family:var(--fb)}
.field{padding:1.35rem 0 1.25rem}
.field + .field{border-top:2px solid var(--surface)}
.fhead{display:flex;align-items:baseline;justify-content:space-between;gap:.75rem;margin-bottom:.35rem}
.fhead label{font-weight:600;font-size:1.0625rem}
.tag{flex:none;font-size:var(--small);font-weight:600;color:var(--ink);background:var(--paper);padding:.12rem .55rem}
.tag[data-state=edited]{background:var(--p);color:var(--on-p)}
.frow{display:grid;grid-template-columns:minmax(0,1fr) 9.6rem;gap:1rem;align-items:center}
.range{-webkit-appearance:none;appearance:none;width:100%;height:44px;background:transparent;margin:0;cursor:pointer}
.range::-webkit-slider-runnable-track{height:8px;background:linear-gradient(to right,var(--p) var(--pct),var(--surface) var(--pct))}/* taste-skill-ignore: the slider fill, two flat colours with a hard stop at the value */
.range::-webkit-slider-thumb{-webkit-appearance:none;width:16px;height:30px;background:var(--p);border:3px solid var(--ink);margin-top:-11px}
.range::-moz-range-track{height:8px;background:var(--surface)}
.range::-moz-range-progress{height:8px;background:var(--p)}
.range::-moz-range-thumb{width:10px;height:24px;border-radius:0;background:var(--p);border:3px solid var(--ink)}
.range:active::-webkit-slider-thumb{transform:scaleY(1.12)}
.numwrap{display:flex;align-items:center;min-height:46px;background:var(--paper);padding:0 .65rem 0 0}
.numwrap:focus-within{outline:3px solid var(--ink);outline-offset:2px}
.numwrap input{width:100%;min-width:0;border:0;background:none;padding:.6rem .3rem .6rem .7rem;color:var(--ink);font-family:var(--fh);font-weight:800;font-size:var(--body);letter-spacing:-.02em;text-align:right;-moz-appearance:textfield}
.numwrap input::-webkit-outer-spin-button,.numwrap input::-webkit-inner-spin-button{-webkit-appearance:none;margin:0}
.numwrap input:focus{outline:none}
.numwrap span{font-size:var(--small);color:var(--muted);white-space:nowrap}
.fnote{font-size:1rem;line-height:1.45;color:var(--muted);margin-top:.25rem;max-width:52ch}

.ledger{grid-area:ledger;background:var(--paper);padding:1.6rem 1.25rem .4rem;margin:0 calc(var(--m) * -1)}
.lines{width:100%;border-collapse:collapse}
.lines th,.lines td{padding:.7rem 0;text-align:left;vertical-align:top;font-weight:400}
.lines td{text-align:right;white-space:nowrap;font-family:var(--fh);font-weight:600;font-size:1.0625rem;padding-left:1rem}
.lines th small{display:block;color:var(--muted);font-size:var(--small)}
.lines tr.sum th,.lines tr.sum td{border-top:4px solid var(--ink);padding-top:.85rem;font-family:var(--fh);font-weight:800;font-size:var(--lead)}
.lines sup{font-size:.7em;margin-left:.12rem}
.ledger{position:relative}
.ledger::after{content:"";position:absolute;left:0;right:0;top:100%;height:12px;background:var(--paper);clip-path:polygon({{ zig }})}

/* The return chart: bars standing on a dark field */
.chart{margin:clamp(3rem,7vw,6rem) 0 0;background:var(--s);color:var(--on-s);padding:clamp(2.25rem,5vw,4.5rem) var(--m) clamp(1.75rem,3vw,3rem);display:grid;gap:clamp(1.75rem,4vw,3.5rem)}
.chart figcaption{display:grid;gap:.6rem}
.chart figcaption p{max-width:44ch}
.chart h2{font-size:clamp(1.75rem,1.3rem + 2.2vw,3.25rem)}
.chart figcaption p{font-size:var(--body);color:color-mix(in srgb,var(--on-s) 80%,var(--s))}
.chart svg{display:block;width:100%;height:auto;overflow:visible}
.chart .pos{fill:color-mix(in srgb,var(--on-s) 90%,var(--s))}
.chart .neg{fill:color-mix(in srgb,var(--on-s) 32%,var(--s))}
.chart .base{stroke:var(--on-s);stroke-width:2}
.chart text{font-family:var(--fb);fill:color-mix(in srgb,var(--on-s) 80%,var(--s));font-size:15px}
.chart text.v{fill:var(--on-s);font-weight:600;font-family:var(--fh)}
.chart .pb{stroke:var(--p);stroke-width:4}
.chart text.pbl{fill:var(--on-s);font-weight:600}
@media (max-width:859px){.chart text{font-size:24px}}

/* The close: a field in the accent */
.cta{background:var(--p);color:var(--on-p);padding:clamp(3rem,8vw,7rem) var(--m) clamp(2.5rem,6vw,5rem);display:grid;gap:1.4rem;align-content:end}
.cta h2{font-size:clamp(2rem,1.2rem + 3.6vw,4.25rem);letter-spacing:-.04em;line-height:.94}
.cta p{font-size:var(--lead);line-height:1.4;max-width:40ch}
.who{font-size:var(--body);line-height:1.4}
.who b{display:block;font-weight:600}
.cta .ken-cta{display:inline-flex!important;align-items:center;justify-content:center;min-height:52px;padding:.95rem 1.6rem!important;border-radius:0!important;background:var(--on-p)!important;color:var(--p)!important;font-family:var(--fh);font-weight:800!important;font-size:1.125rem;letter-spacing:-.01em;text-decoration:none;width:fit-content}
.cta .ken-cta:hover{background:var(--ink)!important;color:var(--paper)!important}
.cta .ken-cta:focus-visible{outline:3px solid var(--on-p);outline-offset:4px}

.notes{padding:clamp(2.5rem,5vw,4rem) var(--m) 4rem;display:grid;gap:.8rem}
.notes h2{font-size:clamp(1.5rem,1.2rem + 1.2vw,2rem)}
.notes ol{margin:0;padding-left:1.3rem;display:grid;gap:.5rem;max-width:68ch;line-height:1.5}

@media (min-width:860px){
  .top{padding-top:1.6rem}
  .intro{grid-template-columns:minmax(0,1.5fr) minmax(0,1fr);column-gap:3rem}
  .intro h1{grid-column:1 / -1}
  .lede{grid-column:2}
  .lede{font-size:var(--lead);line-height:1.38}
  .work{grid-template-columns:minmax(0,1.25fr) minmax(0,1fr);grid-template-areas:"inputs result" "inputs ledger";grid-template-rows:auto 1fr;column-gap:clamp(2rem,5vw,5rem);align-items:start}
  .result{position:static;margin:0;padding:1.6rem 1.8rem 1.5rem}
  .big{font-size:clamp(3.5rem,6.4vw,6rem);margin:.4rem 0 1rem}
  .kpis{gap:.2rem 2.2rem}
  .kpis dd{font-size:var(--lead)}
  .inputs{padding:0}
  .field:first-of-type{padding-top:.8rem}
  .ledger{margin:0;padding:1.6rem 1.8rem .6rem}
  .chart figcaption{grid-template-columns:minmax(0,1.3fr) minmax(0,1fr);column-gap:4rem;align-items:end}
  .chart text{font-size:13px}
  .cta{grid-template-columns:minmax(0,1.3fr) minmax(0,1fr);column-gap:4rem;align-items:end}
  .cta h2{grid-row:1 / span 3}
  .notes{grid-template-columns:minmax(0,1fr) minmax(0,2.2fr);column-gap:4rem}
}
@media (max-width:420px){.kpis{grid-template-columns:repeat(3,minmax(0,1fr));gap:.1rem .8rem}.kpis dd{font-size:1rem}}

/* One moment on load: the tape prints down from the top of its column */
@media (prefers-reduced-motion:no-preference){
  @keyframes print{from{clip-path:inset(0 0 100% 0)}to{clip-path:inset(0 0 0 0)}}
  @media (min-width:860px){.result,.ledger{animation:print .9s cubic-bezier(.2,.7,.2,1) both}.ledger{animation-delay:.25s}}
  .range::-webkit-slider-thumb{transition:transform .12s}
  .cta .ken-cta{transition:background-color .15s,color .15s}
}
@media print{.result{position:static}.chart,.cta{break-inside:avoid}}
</style>
<script src="https://cdn.jsdelivr.net/npm/@alpinejs/csp@3/dist/cdn.min.js" defer></script>
</head>
<body style="--h1v:{{ h1_v }}vw">
<header class="top">
  <div class="brand">
    {%- if brand.logo_url and brand.logo_url != '' %}<img class="logo" src="{{ brand.logo_url | escape }}" alt="{{ brand_name | default: 'Logo' | escape }}">
    {%- elsif brand_name != '' %}<span>{{ brand_name | escape }}</span>{% endif -%}
  </div>
  <p class="for">{% if person.first_name and person.first_name != '' %}Prepared for {{ person.first_name | escape }}{% if person.last_name and person.last_name != '' %} {{ person.last_name | escape }}{% endif %}, {% else %}Prepared for {% endif %}{{ account.name | escape }}</p>
</header>

<main>
  <section class="intro" data-section="intro">
    <h1>What manual {{ work | escape }} costs {{ account.name | escape }} a year</h1>
    <p class="lede">We filled in the four inputs from what we know about {{ account.name | escape }}: {{ account.size_band | replace: '-', ' to ' | escape }} people in {{ account.industry | downcase | escape }}. They are estimates. Move them to match your team and every figure on this page follows, for a year and for three.</p>
  </section>

  <div class="calc" x-data="{{ xdata | escape }}">
    <div hidden aria-hidden="true">
      <i x-effect="manual = team * hours * weeks * rate"></i>
      <i x-effect="labor = manual * share / 100"></i>
      <i x-effect="toolSave = tools * 12 * toolShare / 100"></i>
      <i x-effect="platform = team * seat * 12"></i>
      <i x-effect="gross = labor + toolSave"></i>
      <i x-effect="net = gross - platform"></i>
      <i x-effect="hoursBack = team * hours * weeks * share / 100"></i>
      {%- if has_price %}
      <i x-effect="g = gross / 12"></i>
      <i x-effect="c = platform / 12"></i>
      {%- for m in (1..36) %}
      {%- assign m1 = m | plus: 1 %}
      <i x-effect="z{{ m }} = g * ({{ m }} &lt;= ramp ? {{ m }} * {{ m1 }} / (2 * ramp) : (ramp + 1) / 2 + {{ m }} - ramp) - c * {{ m }} - setup"></i>
      {%- endfor %}
      <i x-effect="pb = 1 + (z1 &lt; 0) + (z2 &lt; 0) + (z3 &lt; 0) + (z4 &lt; 0) + (z5 &lt; 0) + (z6 &lt; 0) + (z7 &lt; 0) + (z8 &lt; 0) + (z9 &lt; 0) + (z10 &lt; 0) + (z11 &lt; 0) + (z12 &lt; 0) + (z13 &lt; 0) + (z14 &lt; 0) + (z15 &lt; 0) + (z16 &lt; 0) + (z17 &lt; 0) + (z18 &lt; 0) + (z19 &lt; 0) + (z20 &lt; 0) + (z21 &lt; 0) + (z22 &lt; 0) + (z23 &lt; 0) + (z24 &lt; 0) + (z25 &lt; 0) + (z26 &lt; 0) + (z27 &lt; 0) + (z28 &lt; 0) + (z29 &lt; 0) + (z30 &lt; 0) + (z31 &lt; 0) + (z32 &lt; 0) + (z33 &lt; 0) + (z34 &lt; 0) + (z35 &lt; 0) + (z36 &lt; 0)"></i>
      <i x-effect="three = z36"></i>
      <i x-effect="mult = g * ((ramp + 1) / 2 + 36 - ramp) / (setup + c * 36)"></i>
      <i x-effect="hi1 = z3 &gt; z36 ? z3 : z36"></i>
      <i x-effect="hi = hi1 &gt; 1 ? hi1 : 1"></i>
      <i x-effect="lo1 = z3 &lt; z6 ? z3 : z6"></i>
      <i x-effect="lo2 = lo1 &lt; z9 ? lo1 : z9"></i>
      <i x-effect="lo3 = lo2 &lt; z36 ? lo2 : z36"></i>
      <i x-effect="lo = lo3 &lt; 0 ? lo3 : 0"></i>
      <i x-effect="k = 154 / (hi - lo)"></i>
      <i x-effect="base = 34 + hi * k"></i>
      {%- endif %}
    </div>

    <div class="work">
      <section class="result" data-section="result" aria-live="polite">
        <h2>Annual savings for {{ account.name | escape }}, after rollout</h2>
        <p class="big" x-text="(net &lt; 0 ? '-$' : '$') + (net &lt; 0 ? -net : net).toLocaleString('en-US', {maximumFractionDigits: 0})">{{ fm[4] }}</p>
        <dl class="kpis">
          {%- if has_price %}
          <div><dt>Payback</dt><dd x-text="pb &gt; 36 ? 'Over 3 years' : pb == 1 ? '1 month' : pb + ' months'">{{ pb_text }}</dd></div>
          <div><dt>3-year net return</dt><dd x-text="(three &lt; 0 ? '-$' : '$') + (three &lt; 0 ? -three : three).toLocaleString('en-US', {maximumFractionDigits: 0})">{{ fm[5] }}</dd></div>
          <div><dt>Return on cost</dt><dd x-text="mult.toFixed(1) + 'x'">{{ mult_w }}.{{ mult_f }}x</dd></div>
          {%- else %}
          <div><dt>Hours back a year</dt><dd x-text="hoursBack.toLocaleString('en-US', {maximumFractionDigits: 0})">{{ fm[6] }}</dd></div>
          <div><dt>Tool spend that goes away</dt><dd x-text="'$' + toolSave.toLocaleString('en-US', {maximumFractionDigits: 0})">{{ fm[2] }}</dd></div>
          {%- endif %}
        </dl>
      </section>

      <section class="inputs ui" data-section="inputs" data-ui>
        <h2>Your inputs</h2>

        <div class="field">
          <div class="fhead"><label for="team">People doing manual {{ work | escape }}</label><span class="tag" data-state="estimate" x-bind:data-state="team == {{ team }} ? 'estimate' : 'edited'" x-text="team == {{ team }} ? 'Estimate' : 'Yours'">Estimate</span></div>
          <div class="frow">
            <input class="range" type="range" min="1" max="{{ team_max }}" step="1" value="{{ team }}" style="--pct:{{ team_pct }}%" x-model.number="team" x-bind:style="'--pct:' + ((team - 1) * 100 / {{ team_max_span }}) + '%'" aria-label="People doing manual {{ work | escape }}, slider">
            <div class="numwrap"><input type="number" id="team" min="1" max="2000" step="1" value="{{ team }}" x-model.number="team"><span>people</span></div>
          </div>
          <p class="fnote">{{ data.reasons.team | escape }}</p>
        </div>

        <div class="field">
          <div class="fhead"><label for="hours">Hours a week each spends on it</label><span class="tag" data-state="estimate" x-bind:data-state="hours == {{ hours }} ? 'estimate' : 'edited'" x-text="hours == {{ hours }} ? 'Estimate' : 'Yours'">Estimate</span></div>
          <div class="frow">
            <input class="range" type="range" min="1" max="{{ hours_max }}" step="0.5" value="{{ hours }}" style="--pct:{{ hours_pct }}%" x-model.number="hours" x-bind:style="'--pct:' + ((hours - 1) * 100 / {{ hours_max_span }}) + '%'" aria-label="Hours a week spent on manual {{ work | escape }}, slider">
            <div class="numwrap"><input type="number" id="hours" min="0" max="60" step="0.5" value="{{ hours }}" x-model.number="hours"><span>hours</span></div>
          </div>
          <p class="fnote">{{ data.reasons.hours | escape }}</p>
        </div>

        <div class="field">
          <div class="fhead"><label for="rate">Loaded hourly cost per person</label><span class="tag" data-state="estimate" x-bind:data-state="rate == {{ rate }} ? 'estimate' : 'edited'" x-text="rate == {{ rate }} ? 'Estimate' : 'Yours'">Estimate</span></div>
          <div class="frow">
            <input class="range" type="range" min="10" max="{{ rate_max }}" step="1" value="{{ rate }}" style="--pct:{{ rate_pct }}%" x-model.number="rate" x-bind:style="'--pct:' + ((rate - 10) * 100 / {{ rate_max_span }}) + '%'" aria-label="Loaded hourly cost, slider">
            <div class="numwrap"><input type="number" id="rate" min="1" max="1000" step="1" value="{{ rate }}" x-model.number="rate"><span>$ an hour</span></div>
          </div>
          <p class="fnote">{{ data.reasons.rate | escape }}</p>
        </div>

        <div class="field">
          <div class="fhead"><label for="tools">Current tool spend a month</label><span class="tag" data-state="estimate" x-bind:data-state="tools == {{ tools }} ? 'estimate' : 'edited'" x-text="tools == {{ tools }} ? 'Estimate' : 'Yours'">Estimate</span></div>
          <div class="frow">
            <input class="range" type="range" min="0" max="{{ tools_max }}" step="100" value="{{ tools }}" style="--pct:{{ tools_pct }}%" x-model.number="tools" x-bind:style="'--pct:' + (tools * 100 / {{ tools_max }}) + '%'" aria-label="Current tool spend a month, slider">
            <div class="numwrap"><input type="number" id="tools" min="0" max="200000" step="50" value="{{ tools }}" x-model.number="tools"><span>$ a month</span></div>
          </div>
          <p class="fnote">{{ data.reasons.tools | escape }}</p>
        </div>
      </section>

      <div class="ledger" data-section="ledger">
        <h2>Where the number comes from</h2>
        <table class="lines">
          <tbody>
            <tr><th>Manual {{ work | escape }} today<small><span x-text="team">{{ team }}</span> <span x-text="team == 1 ? 'person' : 'people'">{% if team == 1 %}person{% else %}people{% endif %}</span>, <span x-text="hours">{{ hours }}</span> hours a week, {{ weeks }} weeks<sup>1</sup></small></th><td x-text="'$' + manual.toLocaleString('en-US', {maximumFractionDigits: 0})">{{ fm[0] }}</td></tr>
            <tr><th>Hours the platform takes back<small>{{ share }}% of that time<sup>2</sup></small></th><td x-text="'$' + labor.toLocaleString('en-US', {maximumFractionDigits: 0})">{{ fm[1] }}</td></tr>
            <tr><th>Tool spend that goes away<small>{{ tshare }}% of today's spend<sup>3</sup></small></th><td x-text="'$' + toolSave.toLocaleString('en-US', {maximumFractionDigits: 0})">{{ fm[2] }}</td></tr>
            {%- if has_price %}
            <tr><th>Platform cost<small><span x-text="team">{{ team }}</span> <span x-text="team == 1 ? 'person' : 'people'">{% if team == 1 %}person{% else %}people{% endif %}</span> at {{ fm[7] }} a month<sup>4</sup></small></th><td x-text="'-$' + platform.toLocaleString('en-US', {maximumFractionDigits: 0})">-{{ fm[3] }}</td></tr>
            {%- endif %}
            <tr class="sum"><th>Annual savings{% unless has_price %}<sup>4</sup>{% endunless %}</th><td x-text="(net &lt; 0 ? '-$' : '$') + (net &lt; 0 ? -net : net).toLocaleString('en-US', {maximumFractionDigits: 0})">{{ fm[4] }}</td></tr>
          </tbody>
        </table>
      </div>
    </div>

    {%- if has_price %}
    <figure class="chart" data-section="chart">
      <figcaption><h2>Cumulative return, quarter by quarter</h2><p>Net of the platform cost{% if setup > 0 %} and the setup fee{% endif %}. The pale bars sit below zero, before payback.</p></figcaption>
      <svg viewBox="0 0 600 230" role="img" aria-label="Cumulative return over three years, by quarter">
        {%- for i in (1..12) %}
        {%- assign idx = i | minus: 1 %}
        {%- assign m = i | times: 3 %}
        {%- assign v = qs[idx] | plus: 0 %}
        {%- assign absv = v %}
        {%- if v < 0 %}{%- assign absv = 0 | minus: v %}{%- endif %}
        {%- assign hk = absv | times: k %}
        {%- assign bh = hk | plus: 1 %}
        {%- assign half_gap = gap | divided_by: 2.0 %}
        {%- assign bx = idx | times: step | plus: 8 | plus: half_gap %}
        {%- if v < 0 %}{%- assign cls = 'neg' %}{%- assign by = base %}{%- else %}{%- assign cls = 'pos' %}{%- assign by = base | minus: bh %}{%- endif %}
        <rect class="{{ cls }}" x="{{ bx | round: 1 }}" y="{{ by | round: 1 }}" width="{{ bw | round: 1 }}" height="{{ bh | round: 1 }}" x-bind:y="z{{ m }} &lt; 0 ? base : base - (z{{ m }} * k + 1)" x-bind:height="(z{{ m }} &lt; 0 ? -z{{ m }} : z{{ m }}) * k + 1" x-bind:class="z{{ m }} &lt; 0 ? 'neg' : 'pos'"/>
        {%- if i == 1 or i == 4 or i == 8 or i == 12 %}
        {%- if v < 0 %}{%- assign ly = base | minus: 8 %}{%- else %}{%- assign ly = by | minus: 8 %}{%- endif %}
        {%- if absv >= 1000000 %}
          {%- assign tenths = absv | divided_by: 100000.0 | round %}
          {%- assign whole = tenths | divided_by: 10.0 | floor %}
          {%- assign frac = tenths | modulo: 10 %}
          {%- assign short = whole | append: '.' | append: frac | append: 'M' %}
        {%- elsif absv >= 1000 %}
          {%- assign short = absv | divided_by: 1000.0 | round | append: 'k' %}
        {%- else %}
          {%- assign short = absv | round %}
        {%- endif %}
        {%- assign tx = bw | divided_by: 2.0 | plus: bx %}{%- assign lanchor = 'middle' %}
        {%- if i == 1 %}{%- assign tx = 8 %}{%- assign lanchor = 'start' %}{%- elsif i == 12 %}{%- assign tx = 592 %}{%- assign lanchor = 'end' %}{%- endif %}
        <text class="v" x="{{ tx | round: 1 }}" y="{{ ly | round: 1 }}" text-anchor="{{ lanchor }}" x-bind:y="(z{{ m }} &lt; 0 ? base : base - (z{{ m }} * k + 1)) - 8" x-text="(z{{ m }} &lt; 0 ? '-$' : '$') + ((z{{ m }} &lt; 0 ? -z{{ m }} : z{{ m }}) &gt;= 1000000 ? ((z{{ m }} &lt; 0 ? -z{{ m }} : z{{ m }}) / 1000000).toFixed(1) + 'M' : (z{{ m }} &lt; 0 ? -z{{ m }} : z{{ m }}) &gt;= 1000 ? ((z{{ m }} &lt; 0 ? -z{{ m }} : z{{ m }}) / 1000).toFixed(0) + 'k' : (z{{ m }} &lt; 0 ? -z{{ m }} : z{{ m }}).toFixed(0))">{% if v < 0 %}-{% endif %}${{ short }}</text>
        {%- endif %}
        {%- endfor %}
        <line class="base" x1="8" x2="592" y1="{{ base | round: 1 }}" y2="{{ base | round: 1 }}" x-bind:y1="base" x-bind:y2="base"/>
        {%- for yr in (0..2) %}
        {%- assign cx = yr | times: 4 | plus: 2 | times: step | plus: 8 %}
        <text x="{{ cx | round: 1 }}" y="218" text-anchor="middle">Year {{ yr | plus: 1 }}</text>
        {%- endfor %}
        {%- assign pb_side = 'start' %}{%- assign pb_tx = pb_x | plus: 8 %}
        {%- if pb > 22 %}{%- assign pb_side = 'end' %}{%- assign pb_tx = pb_x | minus: 8 %}{%- endif %}
        <line class="pb" x1="{{ pb_x | round: 1 }}" x2="{{ pb_x | round: 1 }}" y1="24" y2="{{ base | round: 1 }}"{% if pb > 36 %} style="display:none"{% endif %} x-show="pb &lt; 37" x-bind:x1="8 + pb * {{ step3 }}" x-bind:x2="8 + pb * {{ step3 }}" x-bind:y2="base"/>
        <text class="pbl" x="{{ pb_tx | round: 1 }}" y="32" text-anchor="{{ pb_side }}"{% if pb > 36 %} style="display:none"{% endif %} x-show="pb &lt; 37" x-bind:x="pb &gt; 22 ? 8 + pb * {{ step3 }} - 8 : 8 + pb * {{ step3 }} + 8" x-bind:text-anchor="pb &gt; 22 ? 'end' : 'start'" x-text="'Payback, month ' + pb">Payback, month {{ pb }}</text>
      </svg>
    </figure>
    {%- endif %}
  </div>

  <section class="cta" data-section="cta">
    <h2>Walk through the numbers with {{ sender_first | default: 'us' | escape }}</h2>
    <p>Thirty minutes. We go through the four inputs together, put in your own figures, and find the assumption that moves the result most for a team like yours.</p>
    {%- if sender.name and sender.name != '' %}
    <p class="who"><b>{{ sender.name | escape }}</b>{% if sender.title and sender.title != '' %}{{ sender.title | escape }}{% if brand_name != '' %}, {{ brand_name | escape }}{% endif %}{% elsif brand_name != '' %}{{ brand_name | escape }}{% endif %}</p>
    {%- endif %}
    <div>{% render 'ken/cta', label: 'Book 30 minutes', kind: 'booking' %}</div>
  </section>

  <footer class="notes" data-section="assumptions">
    <h2>Assumptions</h2>
    <ol>
      <li>{{ weeks }} working weeks a year.</li>
      <li>{% if brand_name != '' %}{{ brand_name | escape }}{% else %}The platform{% endif %} takes back {{ share }}% of the hours spent on manual {{ work | escape }}. This is an assumption, not a measured result, and it moves the answer more than any other number on this page.</li>
      <li>{{ tshare }}% of the current tool spend is replaced. The rest stays.</li>
      {%- if has_price %}
      <li>{{ fm[7] }} per person a month{% if setup > 0 %}, plus a one-time setup fee of {{ fm[8] }}{% endif %}. This is list pricing. Nothing on this page is a quote.</li>
      <li>Savings ramp up evenly over the first {{ ramp }} {% if ramp == 1 %}month{% else %}months{% endif %}. The chart and the payback figure include that ramp. Payback is the first month the running total is above zero.</li>
      {%- else %}
      <li>The cost of the platform is not included. Savings are before it.</li>
      {%- endif %}
    </ol>
  </footer>
</main>
</body>
</html>
