{%- assign accent = brand.colors.primary | default: '#0f4c5c' -%}
{%- assign accent2 = brand.colors.secondary | default: '#d08c3a' -%}
{%- assign font_head = brand.fonts.heading | default: 'Bricolage Grotesque' -%}
{%- assign font_body = brand.fonts.body | default: 'Instrument Sans' -%}
{%- assign head_q = font_head | replace: ' ', '+' -%}
{%- assign body_q = font_body | replace: ' ', '+' -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex">
<title>A first piece of work for {{ account.name | escape }}</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ head_q }}:wght@400;600;700&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ body_q }}:wght@400;500;600;700&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&display=swap">
<style>
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:#f5f4f0;color:#17181a;font-family:'{{ font_body }}',ui-sans-serif,system-ui,-apple-system,sans-serif;font-size:17px;line-height:1.55;-webkit-font-smoothing:antialiased}
.sw{--a:{{ accent }};--a2:{{ accent2 }};--ink:#17181a;--text:#2b2a27;--mute:#6b6963;--line:#dbd9d2;--paper:#fff}
.sw h1,.sw h2{font-family:'{{ font_head }}',ui-sans-serif,system-ui,sans-serif;font-weight:600;letter-spacing:-.02em;text-wrap:balance;margin:0}
.sw-top-tag,.sw-ticket dt,.sw-foot{font-family:'IBM Plex Mono',ui-monospace,SFMono-Regular,Menlo,Consolas,monospace}
p{margin:0}
.sw-band{height:5px;background:var(--a)}
.sw-wrap{max-width:72rem;margin:0 auto;padding:0 1.25rem}
.sw-top{display:flex;align-items:center;justify-content:space-between;gap:1rem;min-height:3.75rem;border-bottom:1px solid var(--line)}
.sw-logo{display:block;height:28px;width:auto;max-width:11rem}
.sw-brand{font-weight:700;font-size:1rem}
.sw-top-tag{font-size:.74rem;color:var(--mute);text-align:right}
.sw-cover{padding:2.4rem 0 2.2rem}
.sw-kicker{display:flex;align-items:flex-start;gap:.6rem;font-size:.8rem;font-weight:600;color:var(--text);margin:0 0 1.1rem}
.sw-kicker i{display:inline-block;width:.6rem;height:.6rem;background:var(--a);flex:none;margin-top:.33rem}
.sw h1{font-size:2.3rem;line-height:1.04;overflow-wrap:anywhere}
.sw-intro{font-size:1.12rem;line-height:1.5;color:var(--text);margin:1.2rem 0 0;max-width:38rem}
.sw-intro+.sw-intro{margin-top:.8rem}
.sw-ticket{margin:1.9rem 0 0;border:1.5px solid var(--ink);background:var(--paper)}
.sw-ticket dl{margin:0;padding:0}
.sw-ticket div{display:grid;grid-template-columns:6.4rem minmax(0,1fr);gap:.8rem;padding:.75rem .95rem;border-bottom:1px solid var(--line)}
.sw-ticket div:last-child{border-bottom:0}
.sw-ticket dt{font-size:.68rem;font-weight:500;letter-spacing:.08em;text-transform:uppercase;color:var(--mute);padding-top:.28rem}
.sw-ticket dd{margin:0;font-weight:600;font-size:.98rem;line-height:1.35;overflow-wrap:anywhere}
.sw-ticket small{display:block;font-weight:400;color:var(--mute);font-size:.86rem;margin-top:.15rem}
.sw-next{background:var(--paper);background:color-mix(in srgb,var(--a2) 12%,#fff);border-top:1px solid var(--line)}
.sw-sec{padding:2.3rem 0 2.5rem}
.sw h2{font-size:1.65rem;line-height:1.12;margin:0 0 .8rem}
.sw-closing{font-size:1.12rem;line-height:1.5;max-width:36rem}
.sw-cta{display:flex;flex-wrap:wrap;align-items:center;gap:.9rem 1.1rem;margin:1.5rem 0 1.6rem}
.sw-cta .ken-cta{min-height:44px;display:inline-flex!important;align-items:center}
.sw-or{font-size:.92rem;color:var(--mute)}
.sw-sign{font-size:.95rem;line-height:1.4}
.sw-sign b{display:block;font-weight:600}
.sw-sign span{color:var(--mute)}
.sw-foot{font-size:.72rem;color:var(--mute);padding:1.6rem 0 2.6rem;line-height:1.6}
@media (min-width:900px){
.sw-wrap{padding:0 2.5rem}
.sw-cover{display:grid;grid-template-columns:minmax(0,7fr) minmax(0,5fr);gap:4rem;align-items:start;padding:4rem 0 3.6rem}
.sw h1{font-size:3.7rem}
.sw-intro{font-size:1.2rem;margin-top:1.5rem}
.sw-ticket{margin:.4rem 0 0}
.sw-ticket div{grid-template-columns:7rem minmax(0,1fr);padding:.9rem 1.1rem}
.sw-sec{display:grid;grid-template-columns:16rem minmax(0,1fr);gap:4rem;padding:3.4rem 0 3.8rem}
.sw h2{font-size:1.85rem}
.sw-closing{font-size:1.2rem}
}
</style>
</head>
<body>
<main class="sw">
<div class="sw-band"></div>
<div class="sw-wrap">
<header class="sw-top">
{%- if brand.logo_url %}<img class="sw-logo" src="{{ brand.logo_url | escape }}" alt="{{ brand.name | default: 'Logo' | escape }}">{% elsif brand.name %}<span class="sw-brand">{{ brand.name | escape }}</span>{% else %}<span></span>{% endif -%}
<p class="sw-top-tag">For {{ account.name | escape }}</p>
</header>
<section data-section="cover" class="sw-cover">
<div class="sw-cover-main">
<p class="sw-kicker"><i aria-hidden="true"></i>Made for {% if person.first_name %}{{ person.first_name | escape }} at {% endif %}{{ account.name | escape }}, before you asked</p>
<h1>A first piece of work for {{ account.name | escape }}</h1>
<p class="sw-intro">{% if person.first_name %}Hi {{ person.first_name | escape }}, nobody{% else %}Nobody{% endif %} at {{ account.name | escape }} asked for this. Before taking any of your time, we are making you a small piece of the work we do, from what is public about {{ account.name | escape }}.</p>
<p class="sw-intro">It is not on this page yet. Keep the link: it updates on its own.</p>
</div>
<aside class="sw-ticket" aria-label="About this piece">
<dl>
<div><dt>Prepared for</dt><dd>{% if person.first_name %}{{ person.first_name | escape }} {{ person.last_name | escape }}<small>{% if person.title %}{{ person.title | escape }}, {% endif %}{{ account.name | escape }}</small>{% else %}{{ account.name | escape }}{% if account.industry %}<small>{{ account.industry | capitalize | escape }}</small>{% endif %}{% endif %}</dd></div>
<div><dt>Made by</dt><dd>{{ sender.name | default: 'Our team' | escape }}{% if sender.title or brand.name %}<small>{% if sender.title %}{{ sender.title | escape }}{% endif %}{% if sender.title and brand.name %}, {% endif %}{% if brand.name %}{{ brand.name | escape }}{% endif %}</small>{% endif %}</dd></div>
<div><dt>Status</dt><dd>In progress<small>This page fills itself in</small></dd></div>
<div><dt>What it costs</dt><dd>Nothing<small>Keep it either way</small></dd></div>
</dl>
</aside>
</section>
</div>
<div class="sw-next">
<div class="sw-wrap">
<section data-section="next" class="sw-sec">
<div class="sw-rail"><h2>Rather talk first?</h2></div>
<div class="sw-body">
<p class="sw-closing">Book a time below and I will walk you through what we would make for {{ account.name | escape }} and why. Or wait for the page: it is the same work, done before the call.</p>
<div class="sw-cta">{% render 'ken/cta', label: 'Book 20 minutes', kind: 'booking' %}<span class="sw-or">or reply to the email this came with</span></div>
<p class="sw-sign"><b>{{ sender.name | default: 'Our team' | escape }}</b>{% if sender.title or brand.name %}<span>{% if sender.title %}{{ sender.title | escape }}{% endif %}{% if sender.title and brand.name %}, {% endif %}{% if brand.name %}{{ brand.name | escape }}{% endif %}</span>{% endif %}</p>
</div>
</section>
</div>
</div>
<div class="sw-wrap">
<p class="sw-foot">Made for {{ account.name | escape }} by {{ sender.name | default: 'our team' | escape }}{% if brand.name %} at {{ brand.name | escape }}{% endif %}. This is a private link, not a public page.</p>
</div>
</main>
</body>
</html>
