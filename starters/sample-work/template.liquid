{%- assign accent = brand.colors.primary | default: '#0b7a4d' -%}
{%- assign accent2 = brand.colors.secondary | default: '#000000' -%}
{%- assign font_head = brand.fonts.heading | default: 'Big Shoulders Display' -%}
{%- assign font_body = brand.fonts.body | default: 'Public Sans' -%}
{%- assign has_site = false -%}
{%- if data.site.url and data.site.url != '' -%}{%- assign has_site = true -%}{%- endif -%}
{%- assign has_signals = false -%}
{%- if data.signals.size > 0 -%}{%- assign has_signals = true -%}{%- endif -%}
{%- assign has_notes = false -%}
{%- if data.dossier and data.dossier != '' -%}{%- assign has_notes = true -%}{%- endif -%}
{%- assign has_sources = false -%}
{%- if has_site or has_signals or has_notes -%}{%- assign has_sources = true -%}{%- endif -%}
{%- assign has_work = false -%}
{%- if data.blocks.size > 0 -%}{%- assign has_work = true -%}{%- endif -%}
{%- assign has_full = false -%}
{%- if data.full.size > 0 -%}{%- assign has_full = true -%}{%- endif -%}
{%- assign hl_size = data.headline | size -%}
{%- assign wide = false -%}
{%- if font_head != 'Big Shoulders Display' -%}{%- assign wide = true -%}{%- endif -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex">
<title>{{ data.headline | escape }}</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_head | url_encode }}:wght@{% if wide %}700{% else %}800{% endif %}&display=swap">
{%- if font_body != font_head %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_body | url_encode }}:wght@400;700&display=swap">
{%- endif %}
<style>
:root{
  --p:{{ accent | escape }};
  --s:{{ accent2 | escape }};
  --fh:'{{ font_head | escape }}',ui-sans-serif,system-ui,sans-serif;
  --fb:'{{ font_body | escape }}',ui-sans-serif,system-ui,sans-serif;
  --kraft:#c8a780;
  --kraft-2:#e7d6bd;
  --ink:#000;
  --brown:#3d2e1c;
  --small:clamp(.9375rem,.9rem + .15vw,1rem);
  --body:clamp(1.0625rem,1rem + .25vw,1.1875rem);
  --lead:clamp(1.25rem,1.05rem + .7vw,1.625rem);
  --h3:clamp(1.5rem,1.1rem + 1.4vw,2.5rem);
  --tt:clamp(1.375rem,1.1rem + .75vw,2.125rem);
  --h2:clamp(2.5rem,1.4rem + 4vw,5rem);
  --m:clamp(1rem,3.4vw,3rem);
  --g:clamp(.625rem,1.2vw,1rem);
}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:var(--kraft);color:var(--ink);font:400 var(--body)/1.5 var(--fb);-webkit-font-smoothing:antialiased;overflow-wrap:break-word}
h1,h2,h3{font-family:var(--fh);font-weight:800;margin:0;line-height:.95;letter-spacing:-.005em;text-wrap:balance}
p{margin:0;text-wrap:pretty}
a{color:inherit;text-decoration-thickness:.08em;text-underline-offset:.18em}
a:focus-visible{outline:3px solid currentColor;outline-offset:3px}
/* a tile or field of a brand colour picks black or white text from that colour */
.on{background:var(--f);color:#000;color:rgb(from var(--f) clamp(0,(12800 - (r * r * .2126 + g * g * .7152 + b * b * .0722)) * 999,255) clamp(0,(12800 - (r * r * .2126 + g * g * .7152 + b * b * .0722)) * 999,255) clamp(0,(12800 - (r * r * .2126 + g * g * .7152 + b * b * .0722)) * 999,255))}
.wrap{max-width:90rem;margin:0 auto;padding:0 var(--m)}
.tile{background:#fff;padding:clamp(1.25rem,2.6vw,2.25rem)}
.tile.dark{--f:var(--s)}
.tile.on{background:var(--f)}

/* top */
.top{display:flex;align-items:center;justify-content:space-between;gap:1rem;min-height:2.75rem;padding-top:1.25rem;font-size:var(--small)}
.top .bname{font:800 1.5rem/1 var(--fh)}
.top img{display:block;height:28px;width:auto;max-width:11rem;object-fit:contain}

/* cover: the headline, then the intro beside the packing slip */
.cover{padding:clamp(2rem,6vh,4.5rem) 0 clamp(3rem,6vw,5rem)}
.cover h1{font-size:clamp(2.5rem,.4rem + 8.6vw,8rem)}
.cover h1.mid{font-size:clamp(1.75rem,.3rem + 7vw,6.75rem)}
.cover h1.long{font-size:clamp(1.375rem,.2rem + 5.3vw,5.75rem)}
.cover h1.xlong{font-size:clamp(1.125rem,.1rem + 4.4vw,4.75rem)}
/* a brand heading face is wider than the condensed default, so the display sizes step down */
.wide{--h2:clamp(2rem,1.1rem + 2.6vw,3.5rem);--h3:clamp(1.375rem,1.1rem + .9vw,2rem);--tt:clamp(1.25rem,1.1rem + .4vw,1.5rem)}
.wide .cover h1{font-size:clamp(2rem,.4rem + 6.6vw,6.25rem)}
.wide .cover h1.mid{font-size:clamp(1.5rem,.3rem + 5.6vw,5.25rem)}
.wide .cover h1.long{font-size:clamp(1.25rem,.2rem + 4.8vw,4.5rem)}
.wide .cover h1.xlong{font-size:clamp(1.125rem,.15rem + 4.5vw,4.25rem)}
.cover .lower{display:grid;gap:var(--g);margin-top:clamp(2rem,4vw,3rem)}
.intro{font-size:var(--lead);line-height:1.4;max-width:34ch;padding-bottom:1.5rem}
.slip{position:relative;overflow:clip}
.slip .made{font:800 var(--tt)/1 var(--fh);padding-right:6rem;min-height:5rem}
.slip dl{margin:1.5rem 0 0;display:grid;gap:1rem}
.slip dl div{display:grid;grid-template-columns:8rem minmax(0,1fr);gap:1rem}
.slip dt{font-weight:700;font-size:var(--small);padding-top:.1rem}
.slip dd{margin:0;font-weight:700;line-height:1.35;overflow-wrap:anywhere}
.slip small{display:block;font-weight:400;font-size:var(--small);margin-top:.15rem;color:var(--brown)}
/* the stamp, the page's one moment */
.stamp{--f:var(--p);position:absolute;top:clamp(1rem,2vw,1.75rem);right:clamp(1rem,2vw,1.75rem);width:5.75rem;height:5.75rem;border-radius:50%;display:grid;place-items:center;text-align:center;font:800 1.375rem/.95 var(--fh);transform:rotate(-12deg)}

/* section heads */
.sec{padding:clamp(3.5rem,8vw,7rem) 0 0}
.sec-head{display:grid;gap:1rem;margin-bottom:clamp(1.5rem,3vw,2.5rem)}
.sec-head h2{font-size:var(--h2)}
.sec-head p{max-width:40ch}

/* sources, laid out as tiles */
.src{list-style:none;margin:0;padding:0;display:grid;gap:var(--g)}
.src li{display:flex;flex-direction:column;gap:.5rem}
.src .t{font:800 var(--tt)/1.05 var(--fh);overflow-wrap:anywhere}
.src .meta{font-size:var(--small);color:var(--brown);overflow-wrap:anywhere}
.src .dark .meta{color:inherit}
.src p{margin-top:.25rem}

/* the work, one tile per part */
.parts{list-style:none;margin:0;padding:0;display:grid;gap:var(--g)}
.part{display:grid;gap:.75rem 2rem}
.part .lbl{font-weight:700;font-size:var(--lead);margin-top:.5rem}
.part h3{font-size:var(--h3)}
.part .body{max-width:56ch}
.items{list-style:none;margin:1.25rem 0 0;padding:0;display:grid;gap:.25rem}
.items li{background:var(--kraft-2);padding:.85rem 1rem;display:grid;gap:.15rem 1.5rem}
.items b{font-weight:700}
.rw{display:grid;gap:.375rem;margin-top:1.5rem}
.rw p{padding:1rem 1.15rem}
.rw .before{background:var(--kraft-2);color:var(--brown)}
.rw .after{--f:var(--s);font-weight:700;font-size:var(--lead);line-height:1.35}
.rw b{font-weight:700}

/* what the full version holds */
.box{--f:var(--s)}
.full{list-style:none;margin:0;padding:0;display:grid;gap:2rem clamp(2rem,3vw,3rem)}
.full li{display:flex;flex-direction:column;gap:.6rem}
.full h3{font-size:var(--tt);line-height:1.05}

/* close */
.next{--f:var(--p);margin-top:clamp(3.5rem,8vw,7rem);padding:clamp(3rem,7vw,6rem) 0}
.next .inner{display:grid;gap:1.5rem 3rem}
.next h2{font-size:var(--h2)}
.closing{font-size:var(--lead);line-height:1.4;max-width:38ch}
.cta{display:flex;flex-wrap:wrap;align-items:center;gap:1rem 1.25rem;margin-top:1.75rem}
.cta .ken-cta{display:inline-flex!important;align-items:center;min-height:52px;background:var(--s)!important;color:#fff!important;color:rgb(from var(--s) clamp(0,(12800 - (r * r * .2126 + g * g * .7152 + b * b * .0722)) * 999,255) clamp(0,(12800 - (r * r * .2126 + g * g * .7152 + b * b * .0722)) * 999,255) clamp(0,(12800 - (r * r * .2126 + g * g * .7152 + b * b * .0722)) * 999,255))!important;font:700 var(--body)/1.1 var(--fb)!important;padding:.9rem 1.5rem!important;border-radius:0!important;text-decoration:none}
.cta .ken-cta:focus-visible{outline:3px solid currentColor;outline-offset:3px}
.sign{margin-top:1.75rem}
.sign b{display:block;font-weight:700}
.foot{padding:1.5rem 0 2.5rem;font-size:var(--small);color:var(--brown)}

@media (min-width:760px){
  .src{grid-template-columns:repeat(2,minmax(0,1fr))}
  .src li{min-height:clamp(13rem,22vw,17rem)}
  .items li{grid-template-columns:minmax(0,2fr) minmax(0,3fr)}
  .rw{grid-template-columns:1fr 1fr}
  .full{grid-template-columns:repeat(2,minmax(0,1fr))}
}
@media (min-width:1200px){
  .full{grid-template-columns:repeat(4,minmax(0,1fr))}
}
@media (min-width:1000px){
  .cover .lower{grid-template-columns:minmax(0,5fr) minmax(0,6fr);align-items:start;column-gap:clamp(2rem,4vw,4rem)}
  .sec-head{grid-template-columns:minmax(0,5fr) minmax(0,6fr);column-gap:clamp(2rem,4vw,4rem);align-items:end}
  .src{grid-template-columns:repeat(3,minmax(0,1fr))}
  .src .site,.src .dark{grid-column:span 2}
  .part{grid-template-columns:minmax(0,5fr) minmax(0,6fr);column-gap:clamp(2rem,4vw,4rem);align-items:start}
  .part .head{grid-column:1}
  .part .text{grid-column:2}
  .next .inner{grid-template-columns:minmax(0,5fr) minmax(0,6fr);column-gap:clamp(2rem,4vw,4rem)}
}
@media (max-width:759px){
  .tile{margin-inline:calc(-1 * var(--m));padding-inline:var(--m)}
  .cover h1{text-wrap:pretty}
  .intro{font-size:var(--body)}
  .wide .top .bname{font-size:1.125rem}
}
@media (max-width:420px){
  .slip dl div{grid-template-columns:1fr;gap:.15rem}
}
@media (prefers-reduced-motion:no-preference){
  .stamp{animation:stamp .5s cubic-bezier(.3,1.4,.5,1) .5s both}
  @keyframes stamp{from{transform:rotate(-24deg) scale(1.6)}to{transform:rotate(-12deg)}}
}
@media print{.on,.tile{-webkit-print-color-adjust:exact;print-color-adjust:exact}}
</style>
</head>
<body{% if wide %} class="wide"{% endif %}>
<main>
<div class="wrap">
<header class="top">
{%- if brand.logo_url %}<img src="{{ brand.logo_url | escape }}" alt="{{ brand.name | default: 'Logo' | escape }}">{% elsif brand.name %}<span class="bname">{{ brand.name | escape }}</span>{% else %}<span></span>{% endif -%}
<p>For {{ account.name | escape }}</p>
</header>

<section data-section="cover" class="cover">
  <h1{% if hl_size > 72 %} class="xlong"{% elsif hl_size > 52 %} class="long"{% elsif hl_size > 36 %} class="mid"{% endif %}>{{ data.headline | escape }}</h1>
  <div class="lower">
    <p class="intro">{{ data.intro | escape | newline_to_br | strip_newlines | raw }}</p>
    <aside class="slip tile" aria-label="About this piece">
      <p class="made">Made for {% if person.first_name %}{{ person.first_name | escape }} at {% endif %}{{ account.name | escape }}, before you asked</p>
      <p class="stamp on">No charge</p>
      <dl>
        <div><dt>Prepared for</dt><dd>{% if person.first_name %}{{ person.first_name | escape }} {{ person.last_name | escape }}<small>{% if person.title %}{{ person.title | escape }}, {% endif %}{{ account.name | escape }}</small>{% else %}{{ account.name | escape }}{% if account.industry %}<small>{{ account.industry | capitalize | escape }}</small>{% endif %}{% endif %}</dd></div>
        <div><dt>Made by</dt><dd>{{ sender.name | default: 'Our team' | escape }}{% if sender.title or brand.name %}<small>{% if sender.title %}{{ sender.title | escape }}{% endif %}{% if sender.title and brand.name %}, {% endif %}{% if brand.name %}{{ brand.name | escape }}{% endif %}</small>{% endif %}</dd></div>
        {%- if data.kind and data.kind != '' %}
        <div><dt>The piece</dt><dd>{{ data.kind | escape }}</dd></div>
        {%- endif %}
        <div><dt>Built from</dt><dd>{% if has_site %}{{ account.domain | escape }}{% else %}What is public about {{ account.name | escape }}{% endif %}<small>{% if has_site %}Your site{% if has_signals %}, recent news{% endif %}{% if has_notes %} and our notes{% endif %}{% else %}{% if has_signals %}Recent news{% if has_notes %} and our notes{% endif %}{% elsif has_notes %}Our notes{% else %}No call, no questions asked{% endif %}{% endif %}</small></dd></div>
        <div><dt>What it costs</dt><dd>Nothing<small>Keep it either way</small></dd></div>
      </dl>
    </aside>
  </div>
</section>

{%- if has_sources %}
<section data-section="sources" class="sec">
  <div class="sec-head">
    <h2>What we looked at</h2>
    <p>Everything on this page comes from these sources and from how we do this work. Nobody at {{ account.name | escape }} was asked anything.</p>
  </div>
  <ol class="src">
    {%- if has_site %}
    <li class="tile site"><p class="t">{{ data.site.title | default: account.domain | escape }}</p><p class="meta">Your site, {{ data.site.url | escape }}</p>{% if data.site_note and data.site_note != '' %}<p>{{ data.site_note | escape }}</p>{% endif %}</li>
    {%- endif %}
    {%- for s in data.signals limit: 4 %}
    <li class="tile"><p class="t">{% if s.source_url and s.source_url != '' %}<a href="{{ s.source_url | escape }}" target="_blank" rel="noopener noreferrer">{{ s.title | escape }}</a>{% else %}{{ s.title | escape }}{% endif %}</p><p class="meta">News{% if s.date %}, {{ s.date | date: '%b %d, %Y' }}{% endif %}{% if s.type %}, {{ s.type | escape }}{% endif %}</p></li>
    {%- endfor %}
    {%- if has_notes %}
    <li class="tile dark on"><p class="t">Our notes on {{ account.name | escape }}</p><p>{{ data.dossier | escape }}{% if data.why_now and data.why_now != '' %} {{ data.why_now | escape }}{% endif %}</p></li>
    {%- endif %}
  </ol>
</section>
{%- endif %}

{%- if has_work %}
<section data-section="work" class="sec">
  <div class="sec-head">
    <h2>What we made</h2>
    <p>{{ data.blocks.size }} parts, in the order to read them. Each one stands on its own, so take what is useful and leave the rest.</p>
  </div>
  <ol class="parts">
    {%- for b in data.blocks %}
    <li class="part tile">
      <div class="head">
        <h3>{{ b.title | escape }}</h3>
        {%- if b.label and b.label != '' %}<p class="lbl">{{ b.label | escape }}</p>{% endif %}
      </div>
      <div class="text">
        <p class="body">{{ b.body | escape | newline_to_br | strip_newlines | raw }}</p>
        {%- if b.items.size > 0 %}
        <ul class="items">
          {%- for i in b.items %}
          <li><b>{{ i.name | escape }}</b>{% if i.note and i.note != '' %}<span>{{ i.note | escape }}</span>{% endif %}</li>
          {%- endfor %}
        </ul>
        {%- endif %}
        {%- if b.before and b.before != '' %}
        <div class="rw">
          <p class="before"><b>On your site now.</b> {{ b.before | escape }}</p>
          <p class="after on"><b>Our version.</b> {{ b.after | escape }}</p>
        </div>
        {%- endif %}
      </div>
    </li>
    {%- endfor %}
  </ol>
</section>
{%- endif %}

{%- if has_full %}
<section data-section="full" class="sec">
  <div class="sec-head">
    <h2>What the full version includes</h2>
    {%- if data.full_intro and data.full_intro != '' %}
    <p>{{ data.full_intro | escape }}</p>
    {%- endif %}
  </div>
  <div class="box tile on">
  <ol class="full">
    {%- for f in data.full %}
    <li><h3>{{ f.title | escape }}</h3><p>{{ f.detail | escape }}</p></li>
    {%- endfor %}
  </ol>
  </div>
</section>
{%- endif %}
</div>

<section data-section="next" class="next on">
  <div class="wrap inner">
    <h2>{% if has_work %}If this is useful{% else %}While it is being made{% endif %}</h2>
    <div>
      <p class="closing">{{ data.closing | escape | newline_to_br | strip_newlines | raw }}</p>
      <div class="cta">{% render 'ken/cta', label: 'Book 20 minutes', kind: 'booking' %}<span>or reply to the email this came with</span></div>
      <p class="sign"><b>{{ sender.name | default: 'Our team' | escape }}</b>{% if sender.title or brand.name %}{% if sender.title %}{{ sender.title | escape }}{% endif %}{% if sender.title and brand.name %}, {% endif %}{% if brand.name %}{{ brand.name | escape }}{% endif %}{% endif %}</p>
    </div>
  </div>
</section>

<div class="wrap">
  <p class="foot">Made for {{ account.name | escape }} by {{ sender.name | default: 'our team' | escape }}{% if brand.name %} at {{ brand.name | escape }}{% endif %}. This is a private link, not a public page.</p>
</div>
</main>
</body>
</html>
