{%- assign accent = brand.colors.primary | default: '#2a4bd7' -%}
{%- assign accent2 = brand.colors.secondary | default: '#0e1530' -%}
{%- assign font_head = brand.fonts.heading | default: 'Inter Tight' -%}
{%- assign font_body = brand.fonts.body | default: 'Inter' -%}
{%- assign head_q = font_head | replace: ' ', '+' -%}
{%- assign body_q = font_body | replace: ' ', '+' -%}
{%- assign brand_name = brand.name | default: '' -%}
{%- assign sender_name = sender.name | default: 'The team' -%}
{%- assign sender_first = sender_name | split: ' ' | first -%}
{%- if person.first_name and person.first_name != '' -%}{%- assign greeting = person.first_name | append: ',' -%}{%- else -%}{%- assign greeting = 'Hello,' -%}{%- endif -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex">
<title>Nothing new at {{ account.name | escape }} this month</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ head_q | escape }}:wght@400;500;600;700&display=swap">
{%- if font_body != font_head %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ body_q | escape }}:wght@400;500;600;700&display=swap">
{%- endif %}
<style>
:root{
  --p:{{ accent | escape }};
  --s:{{ accent2 | escape }};
  --fh:'{{ font_head | escape }}',ui-sans-serif,system-ui,sans-serif;
  --fb:'{{ font_body | escape }}',ui-sans-serif,system-ui,sans-serif;
  --ink:color-mix(in srgb,var(--s) 82%,#000);
  --text:color-mix(in srgb,var(--s) 86%,#fff);
  --mute:color-mix(in srgb,var(--s) 52%,#fff);
  --line:color-mix(in srgb,var(--s) 14%,#fff);
  --paper:color-mix(in srgb,var(--p) 3%,#fff);
  --p-deep:color-mix(in srgb,var(--p) 78%,#000);
  --p-btn:color-mix(in srgb,var(--p) 88%,#000);
}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:var(--paper);color:var(--text);font:17px/1.62 var(--fb);-webkit-font-smoothing:antialiased}
h1{font-family:var(--fh);color:var(--ink);margin:0 0 1rem;font-weight:600;letter-spacing:-.015em;line-height:1.12;font-size:2.2rem;max-width:16ch;text-wrap:balance;overflow-wrap:break-word}
p{margin:0 0 1rem}
.mast{max-width:58rem;margin:0 auto;padding:1.1rem 1.25rem;border-bottom:1px solid var(--line)}
.brand{display:flex;align-items:center;gap:.6rem;font-family:var(--fh);font-weight:600;color:var(--ink);font-size:1rem;margin:0}
.logo{width:26px;height:26px;display:block;flex:none}
.mark{border-radius:7px;background:var(--p);color:#fff;font:700 .85rem/26px var(--fh);text-align:center}
img.logo{width:auto;max-width:9rem;object-fit:contain}
.sheet{max-width:58rem;margin:0 auto;padding:2.2rem 1.25rem 5rem}
.sheet>section{max-width:36rem}
.cta{margin-top:1.6rem;padding:1.4rem 1.3rem;border:1px solid var(--line);border-radius:14px;background:#fff}
.cta p:last-child{margin:0}
.cta .ken-cta{display:inline-flex!important;align-items:center;justify-content:center;min-height:44px;background:var(--p-btn)!important;color:#fff!important;font-weight:500!important;font-size:.98rem;padding:.8rem 1.3rem!important;border-radius:10px!important;text-decoration:none}
.alt{font-size:.92rem;color:var(--mute)}
@media (min-width:760px){
  .mast{padding:1.3rem 2rem}
  .sheet{padding:3.4rem 2rem 6rem}
  h1{font-size:3rem}
}
</style>
</head>
<body>
<header class="mast">
  <p class="brand">
    {%- if brand.logo_url and brand.logo_url != '' -%}
    <img class="logo" src="{{ brand.logo_url | escape }}" alt="{{ brand_name | default: 'Logo' | escape }}" height="26">
    {%- elsif brand_name != '' -%}
    <span class="logo mark" aria-hidden="true">{{ brand_name | slice: 0, 1 | upcase | escape }}</span><span>{{ brand_name | escape }}</span>
    {%- endif -%}
  </p>
</header>
<main class="sheet">
  <section data-section="head">
    <h1>Nothing new at {{ account.name | escape }} this month</h1>
    <p>{{ greeting | escape }}</p>
    <p>I write down what changed at a few companies I follow, and what it usually means. This month I found nothing at {{ account.name | escape }} that I could back up with a source, so I am not going to make something up.</p>
    <p>I will look again next month.</p>
  </section>
  <section class="cta" data-section="cta">
    <p>If you would rather talk now, pick a time that suits you.</p>
    {%- assign cta_label = 'Pick a time with ' | append: sender_first %}
    <p>{% render 'ken/cta', label: cta_label, kind: 'booking' %}</p>
  </section>
</main>
</body>
</html>
