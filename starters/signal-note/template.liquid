{%- assign accent = brand.colors.primary | default: '#c42f3c' -%}
{%- assign accent2 = brand.colors.secondary | default: '#3d4750' -%}
{%- assign font_head = brand.fonts.heading | default: 'Zilla Slab' -%}
{%- assign font_body = brand.fonts.body | default: 'Zilla Slab' -%}
{%- assign brand_name = brand.name | default: '' -%}
{%- assign sender_name = sender.name | default: 'The team' -%}
{%- assign sender_first = sender_name | split: ' ' | first -%}
{%- assign has_brand_colour = false -%}
{%- if brand.colors.primary and brand.colors.primary != '' -%}{%- assign has_brand_colour = true -%}{%- endif -%}
{%- assign count = data.signals | size -%}
{%- case count -%}
{%- when 1 -%}{%- assign count_phrase = 'One thing' -%}
{%- when 2 -%}{%- assign count_phrase = 'Two things' -%}
{%- else -%}{%- assign count_phrase = 'Three things' -%}
{%- endcase -%}
{%- assign dates = data.signals | map: 'seen_on' | compact | sort -%}
{%- assign latest = dates | last -%}
{%- if person.first_name and person.first_name != '' -%}
{%- assign greeting = person.first_name | append: ',' -%}
{%- assign person_full = person.first_name | append: ' ' | append: person.last_name | strip -%}
{%- else -%}
{%- assign greeting = 'Hello,' -%}
{%- assign person_full = '' -%}
{%- endif -%}
{%- capture title_text -%}{{ count_phrase }} we noticed at {{ account.name }}{%- endcapture -%}
{%- assign title_size = title_text | size -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex">
<title>{{ count_phrase | escape }} we noticed about {{ account.name | escape }} this month</title>
{%- if font_head == 'Zilla Slab' %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Zilla+Slab:ital,wght@0,400;0,700;1,400;1,700&display=swap">
{%- else %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_head | url_encode }}&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_head | url_encode }}:wght@700&display=swap">
{%- endif %}
{%- if font_body != font_head %}
{%- if font_body == 'Zilla Slab' %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Zilla+Slab:ital,wght@0,400;0,700;1,400;1,700&display=swap">
{%- else %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_body | url_encode }}&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_body | url_encode }}:wght@700&display=swap">
{%- endif %}
{%- endif %}
<style>
:root{
  --p:{{ accent | escape }};
  --s:{{ accent2 | escape }};
  --fh:'{{ font_head | escape }}',ui-serif,Georgia,serif;
  --fb:'{{ font_body | escape }}',ui-serif,Georgia,serif;
  --pad:#fbeb98;
  --ink:#1e2532;
  --mute:#4a4636;
{%- if has_brand_colour %}
  --desk:color-mix(in srgb,var(--s) 85%,#000);
  --red:color-mix(in srgb,var(--p) 45%,#000);
{%- else %}
  --desk:var(--s);
  --red:var(--p);
{%- endif %}
  --m:clamp(.5rem,3vw,3rem);
  --px:clamp(1rem,4vw,3.5rem);
  --mw:clamp(2.5rem,1rem + 7vw,7.5rem);
  --gap:clamp(1rem,2.5vw,2.25rem);
  --small:clamp(.9375rem,.9rem + .15vw,1.0625rem);
  --lead:clamp(1.125rem,1rem + .5vw,1.375rem);
  --h2:clamp(1.25rem,.95rem + 1.4vw,2.25rem);
}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;font:400 clamp(1.0625rem,1rem + .3vw,1.25rem)/1.55 var(--fb);-webkit-font-smoothing:antialiased;overflow-wrap:break-word}
h1,h2{font-family:var(--fh);font-weight:700;margin:0;letter-spacing:-.01em;text-wrap:balance}
p{margin:0;text-wrap:pretty}
a{color:inherit;text-decoration-thickness:.07em;text-underline-offset:.18em}
a:focus-visible{outline:3px solid currentColor;outline-offset:3px}
/* the desk, and any field of a brand colour, picks black or white text from its own colour */
.on{--f:var(--desk);background:var(--f);color:#fff;color:rgb(from var(--f) clamp(0,(12800 - (r * r * .2126 + g * g * .7152 + b * b * .0722)) * 999,255) clamp(0,(12800 - (r * r * .2126 + g * g * .7152 + b * b * .0722)) * 999,255) clamp(0,(12800 - (r * r * .2126 + g * g * .7152 + b * b * .0722)) * 999,255))}
body.on{min-height:100svh}

.mast{display:flex;align-items:center;justify-content:space-between;gap:1rem;max-width:76rem;margin:0 auto;padding:1.1rem calc(var(--m) + .25rem) 1.25rem;font-size:var(--small)}
.brand{display:flex;align-items:center;font:700 var(--lead)/1 var(--fh);min-height:28px}
.brand img{display:block;height:28px;width:auto;max-width:9rem;object-fit:contain}
.issue{text-align:right}

/* the legal pad: one yellow sheet, a dark binding, a double red margin line */
.pad{position:relative;max-width:76rem;margin:0 auto;margin-inline:max(var(--m),calc((100% - 76rem) / 2));background:var(--pad);color:var(--ink);border-top:clamp(.875rem,1.5vw,1.25rem) solid var(--ink);padding:clamp(2.25rem,5vw,4.5rem) var(--px) clamp(3rem,6vw,5rem)}
.pad::before{content:"";position:absolute;top:0;bottom:0;left:calc(var(--px) + var(--mw) + var(--gap) / 2 - 4px);border-left:7px double var(--p)}
.ln{display:grid;grid-template-columns:var(--mw) minmax(0,1fr);column-gap:var(--gap)}
.ln>.mg{grid-column:1;color:var(--red);font-weight:700;font-size:var(--small);line-height:1.3;text-align:right;padding-top:.3em}
.ln>.tx{grid-column:2;min-width:0}

.head h1{font-size:clamp(2rem,1rem + 4.6vw,6rem);line-height:1;max-width:24ch}
.head h1.mid{font-size:clamp(1.5rem,.4rem + 4.8vw,5.5rem)}
.head h1.long{font-size:clamp(1.375rem,.3rem + 4.4vw,4.75rem)}
.head .to{margin-top:1.25rem;font-size:var(--lead)}
.open{margin-top:clamp(2rem,4vw,3rem)}
.open .tx{max-width:38rem}
.open p+p{margin-top:.75rem}

.signals{list-style:none;margin:clamp(2.5rem,5vw,4rem) 0 0;padding:0;display:grid;gap:clamp(2.5rem,5vw,4rem)}
.sig{display:grid;grid-template-columns:var(--mw) minmax(0,1fr);column-gap:var(--gap)}
.sig .mg{grid-column:1;grid-row:1/3;color:var(--red);text-align:right}
.sig .num{display:block;font:700 var(--h2)/1.1 var(--fh)}
.sig .meta{display:block;font-weight:700;font-size:var(--small);line-height:1.3;margin-top:.4rem}
.sig h2{grid-column:2;font-size:var(--h2);line-height:1.1;max-width:24ch}
.sig .body{grid-column:2;max-width:38rem;margin-top:.9rem}
.sig .body p+p{margin-top:.75rem}
.sig .ri b{font-weight:700}
.sig .idea{font-style:italic}
.sig .idea b{font-style:normal;color:var(--red)}
sup{font-size:.68em;line-height:0;color:var(--red);font-weight:700;margin-left:.1em}

.note{margin-top:clamp(3rem,6vw,4.5rem)}
.note .tx{max-width:38rem}
.note .sig-name{font:italic 700 var(--h2)/1 var(--fh);margin-top:1.5rem}
.note .sig-title{margin-top:.5rem;color:var(--mute)}

.cta{margin-top:clamp(2.5rem,5vw,3.5rem)}
.cta .tx{max-width:38rem;display:grid;gap:1rem;justify-items:start}
.cta .alt{color:var(--mute)}
.cta .ken-cta{display:inline-flex!important;align-items:center;min-height:50px;background:var(--p)!important;color:#fff!important;color:rgb(from var(--p) clamp(0,(12800 - (r * r * .2126 + g * g * .7152 + b * b * .0722)) * 999,255) clamp(0,(12800 - (r * r * .2126 + g * g * .7152 + b * b * .0722)) * 999,255) clamp(0,(12800 - (r * r * .2126 + g * g * .7152 + b * b * .0722)) * 999,255))!important;font:700 var(--small)/1.1 var(--fb)!important;padding:.85rem 1.4rem!important;border-radius:3px!important;text-decoration:none}
.cta .ken-cta:focus-visible{outline:3px solid var(--ink);outline-offset:3px}

/* sources sit on the desk under the pad */
.sources{max-width:76rem;margin:0 auto;padding:clamp(2rem,4vw,3rem) calc(var(--m) + .25rem) clamp(2.5rem,5vw,4rem);font-size:var(--small)}
.sources ol{margin:0;padding-left:1.4rem;display:grid;gap:.4rem;max-width:60rem}
.sources li{overflow-wrap:anywhere;padding-left:.25rem}
.sources .colophon{margin-top:1.25rem;max-width:60ch}

@media (min-width:1100px){
  .sig .body{max-width:none;display:grid;grid-template-columns:minmax(0,38rem) minmax(0,1fr);column-gap:calc(var(--gap) * 1.5);align-items:start}
  .sig .body .fact,.sig .body .ri{grid-column:1}
  .sig .body .idea{grid-column:2;grid-row:1/3;margin-top:0}
  .sig .body .idea b{display:block}
}
@media (max-width:759px){
  :root{--mw:1.25rem;--gap:1.125rem;--px:.875rem}
  .mast,.sources{padding-left:1.25rem;padding-right:1.25rem}
  .pad::before{border-left-width:5px}
  .ln>.mg{display:none}
  .head>.mg{display:block;grid-column:2;grid-row:2;text-align:left;padding-top:.5rem}
  .sig .mg{display:contents}
  .sig .num{grid-column:1;grid-row:1/4;text-align:right}
  .sig h2{grid-row:1;max-width:none}
  .sig .meta{grid-column:2;grid-row:2;margin-top:.5rem;text-align:left}
  .sig .body{grid-row:3}
  .issue .when{display:block}
}
@media (prefers-reduced-motion:no-preference){
  .pad{animation:lay .7s cubic-bezier(.2,.7,.2,1) both}
  @keyframes lay{from{transform:translateY(2.5rem)}to{transform:none}}
}
@media print{body.on{background:#fff}.pad{-webkit-print-color-adjust:exact;print-color-adjust:exact}}
</style>
</head>
<body class="on">
<header class="mast">
  <p class="brand">
    {%- if brand.logo_url and brand.logo_url != '' -%}
    <img src="{{ brand.logo_url | escape }}" alt="{{ brand_name | default: 'Logo' | escape }}" height="28">
    {%- elsif brand_name != '' -%}
    {{ brand_name | escape }}
    {%- endif -%}
  </p>
  <p class="issue">Notes from {{ sender_name | escape }}{% if latest %}, <span class="when">{{ latest | date: '%B %Y' }}</span>{% endif %}</p>
</header>

<main class="pad">
  <section class="head ln" data-section="head">
    <p class="mg">{% if latest %}{{ latest | date: '%B %Y' }}{% else %}This month{% endif %}</p>
    <div class="tx">
      <h1{% if title_size > 44 %} class="long"{% elsif title_size > 30 %} class="mid"{% endif %}>{{ title_text | escape }}</h1>
      <p class="to">For {% if person_full != '' %}{{ person_full | escape }}{% if person.title and person.title != '' %}, {{ person.title | escape }}{% endif %} at {% else %}the team at {% endif %}{{ account.name | escape }}</p>
    </div>
  </section>

  <section class="open ln" data-section="opening">
    <div class="tx">
      <p>{{ greeting | escape }}</p>
      <p>Each month I write down what changed at a few companies I follow, and what it usually means. This one is about {{ account.name | escape }}. {{ count_phrase | escape }} stood out.</p>
    </div>
  </section>

  <ol class="signals" data-section="signals">
    {%- for sig in data.signals %}
    {%- case sig.kind -%}
    {%- when 'hiring' -%}{%- assign kind_label = 'Hiring' -%}
    {%- when 'role_change', 'leadership', 'promotion' -%}{%- assign kind_label = 'Role change' -%}
    {%- when 'funding' -%}{%- assign kind_label = 'Funding' -%}
    {%- when 'expansion' -%}{%- assign kind_label = 'Expansion' -%}
    {%- when 'news' -%}{%- assign kind_label = 'News' -%}
    {%- else -%}{%- assign kind_label = sig.kind | replace: '_', ' ' | capitalize -%}
    {%- endcase %}
    <li class="sig">
      <div class="mg">
        <span class="num" aria-hidden="true">{{ forloop.index }}</span>
        <span class="meta">{{ kind_label | escape }}{% if sig.seen_on and sig.seen_on != '' %}, seen {{ sig.seen_on | date: '%B %-d' }}{% endif %}</span>
      </div>
      <h2>{{ sig.headline | escape }}</h2>
      <div class="body">
        <p class="fact">{{ sig.fact | escape }}<sup>{{ forloop.index }}</sup></p>
        <p class="ri"><b>What it usually means.</b> {{ sig.means | escape }}</p>
        <p class="ri idea"><b>One idea.</b> {{ sig.idea | escape }}</p>
      </div>
    </li>
    {%- endfor %}
  </ol>

  <section class="note ln" data-section="note">
    <div class="tx">
      <p>{{ data.note | escape | newline_to_br | strip_newlines | raw }}</p>
      <p class="sig-name">{{ sender_first | escape }}</p>
      <p class="sig-title">{{ sender_name | escape }}{% if sender.title and sender.title != '' %}, {{ sender.title | escape }}{% endif %}{% if brand_name != '' %}{% if sender.title and sender.title != '' %} at {% else %}, {% endif %}{{ brand_name | escape }}{% endif %}</p>
    </div>
  </section>

  <section class="cta ln" data-section="cta">
    <div class="tx">
      <p>If {% if count > 1 %}one of these is{% else %}this is{% endif %} worth a conversation, pick a time that suits you.</p>
      {%- assign cta_label = 'Pick a time with ' | append: sender_first %}
      <p>{% render 'ken/cta', label: cta_label, kind: 'booking' %}</p>
      <p class="alt">Or reply to the message this came with and tell me {% if count > 1 %}which one{% else %}what you think{% endif %}.</p>
    </div>
  </section>
</main>

<footer class="sources" data-section="sources">
  <ol aria-label="Sources">
    {%- for sig in data.signals %}
    <li id="source-{{ forloop.index }}">
      {%- assign url_start = sig.source_url | slice: 0, 4 -%}
      {%- if sig.source_url and url_start == 'http' -%}
      {%- assign url_parts = sig.source_url | split: '/' -%}
      <a href="{{ sig.source_url | escape }}" rel="noopener noreferrer">{{ sig.source_label | escape }}</a>, {{ url_parts[2] | escape }}
      {%- else -%}
      {{ sig.source_label | escape }}
      {%- endif -%}
      {%- if sig.seen_on and sig.seen_on != '' -%}, {{ sig.seen_on | date: '%B %-d, %Y' }}{%- endif -%}.
    </li>
    {%- endfor %}
  </ol>
  <p class="colophon">Written by {{ sender_name | escape }}{% if brand_name != '' %} at {{ brand_name | escape }}{% endif %} for {% if person_full != '' %}{{ person_full | escape }} at {% else %}the team at {% endif %}{{ account.name | escape }}. Every fact above has its source listed here.</p>
</footer>
</body>
</html>
