{%- assign accent = brand.colors.primary | default: '#2a4bd7' -%}
{%- assign accent2 = brand.colors.secondary | default: '#0e1530' -%}
{%- assign font_head = brand.fonts.heading | default: 'Inter Tight' -%}
{%- assign font_body = brand.fonts.body | default: 'Inter' -%}
{%- assign head_q = font_head | replace: ' ', '+' -%}
{%- assign body_q = font_body | replace: ' ', '+' -%}
{%- assign brand_name = brand.name | default: '' -%}
{%- assign sender_name = sender.name | default: 'The team' -%}
{%- assign sender_first = sender_name | split: ' ' | first -%}
{%- assign count = data.signals | size -%}
{%- case count -%}
{%- when 1 -%}{%- assign count_phrase = 'One thing' -%}
{%- when 2 -%}{%- assign count_phrase = 'Two things' -%}
{%- else -%}{%- assign count_phrase = 'Three things' -%}
{%- endcase -%}
{%- assign dates = data.signals | map: 'seen_on' | compact | sort -%}
{%- assign latest = dates | last -%}
{%- if person.first_name and person.first_name != '' -%}
{%- assign greeting = person.first_name | append: ',' -%}
{%- assign person_full = person.first_name | append: ' ' | append: person.last_name | strip -%}
{%- else -%}
{%- assign greeting = 'Hello,' -%}
{%- assign person_full = '' -%}
{%- endif -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex">
<title>{{ count_phrase | escape }} we noticed about {{ account.name | escape }} this month</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ head_q | escape }}:wght@400;500;600;700&display=swap">
{%- if font_body != font_head %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ body_q | escape }}:wght@400;500;600;700&display=swap">
{%- endif %}
<style>
:root{
  --p:{{ accent | escape }};
  --s:{{ accent2 | escape }};
  --fh:'{{ font_head | escape }}',ui-sans-serif,system-ui,sans-serif;
  --fb:'{{ font_body | escape }}',ui-sans-serif,system-ui,sans-serif;
  --ink:color-mix(in srgb,var(--s) 82%,#000);
  --text:color-mix(in srgb,var(--s) 86%,#fff);
  --mute:color-mix(in srgb,var(--s) 52%,#fff);
  --line:color-mix(in srgb,var(--s) 14%,#fff);
  --paper:color-mix(in srgb,var(--p) 3%,#fff);
  --p-deep:color-mix(in srgb,var(--p) 78%,#000);
  --p-btn:color-mix(in srgb,var(--p) 88%,#000);
}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:var(--paper);color:var(--text);font:17px/1.62 var(--fb);-webkit-font-smoothing:antialiased;font-variant-numeric:oldstyle-nums proportional-nums}
h1,h2{font-family:var(--fh);color:var(--ink);margin:0;font-weight:600;letter-spacing:-.015em;line-height:1.12}
p{margin:0 0 1rem}
a{color:var(--p-deep);text-decoration-thickness:1px;text-underline-offset:3px}
:focus-visible{outline:2px solid var(--p);outline-offset:3px}

.mast{max-width:58rem;margin:0 auto;padding:1.1rem 1.25rem;display:flex;align-items:center;justify-content:space-between;gap:1rem;border-bottom:1px solid var(--line)}
.brand{display:flex;align-items:center;gap:.6rem;font-family:var(--fh);font-weight:600;color:var(--ink);font-size:1rem;margin:0}
.logo{width:26px;height:26px;display:block;flex:none}
.mark{border-radius:7px;background:var(--p);color:#fff;font:700 .85rem/26px var(--fh);text-align:center}
img.logo{width:auto;max-width:9rem;object-fit:contain}
.issue{font-size:.85rem;color:var(--mute);text-align:right;line-height:1.35;margin:0}

.sheet{max-width:58rem;margin:0 auto;padding:2.2rem 1.25rem 5rem}
.head{max-width:36rem}
.date{font-size:.9rem;color:var(--mute);margin-bottom:1.1rem}
.head h1{font-size:2.2rem;margin-bottom:1rem;max-width:20ch;overflow-wrap:break-word;text-wrap:balance}
.head .to{font-size:1rem;color:var(--mute);margin-bottom:2rem;padding-bottom:1.6rem;border-bottom:1px solid var(--line)}
.head .to b{font-weight:500;color:var(--ink)}
.open{max-width:36rem}

.signals{list-style:none;margin:1.4rem 0 0;padding:0}
.sig{display:grid;grid-template-columns:minmax(0,1fr);gap:.4rem 2.2rem;padding:1.6rem 0 1.2rem;border-top:1px solid var(--line)}
.sig .side{display:flex;flex-wrap:wrap;align-items:baseline;gap:.2rem .7rem;font-size:.85rem;color:var(--mute)}
.sig .num{font-family:var(--fh);font-weight:600;font-size:1.6rem;line-height:1;color:var(--p);letter-spacing:-.02em}
.sig .kind{display:inline-flex;align-items:center;gap:.35rem;color:var(--ink);font-weight:500}
.sig .kind svg{width:15px;height:15px;color:var(--p)}
.sig .seen{white-space:nowrap}
.sig .body{max-width:36rem}
.sig h2{font-size:1.35rem;margin-bottom:.7rem;max-width:26ch;overflow-wrap:break-word;text-wrap:balance}
.sig .ri{margin-bottom:.9rem}
.sig .ri b{font-weight:600;color:var(--ink)}
.sig .ri.idea{padding-left:1rem;border-left:2px solid var(--p);margin-top:1.1rem}
sup{font-size:.68em;line-height:0;color:var(--p-deep);margin-left:.08em;font-variant-numeric:lining-nums}

.note{margin-top:1.4rem;padding-top:2rem;border-top:1px solid var(--line);max-width:36rem}
.note p{font-size:1.05rem;line-height:1.7}
.note .sig-name{font-family:var(--fh);font-size:1.5rem;font-weight:600;color:var(--ink);margin:1.4rem 0 .2rem;letter-spacing:-.01em}
.note .sig-title{font-size:.9rem;color:var(--mute);margin:0}

.cta{margin-top:2.2rem;max-width:36rem;padding:1.4rem 1.3rem;border:1px solid var(--line);border-radius:14px;background:#fff}
.cta p{margin-bottom:.9rem}
.cta p:last-child{margin:0}
.cta .alt{font-size:.92rem;color:var(--mute)}
.cta .ken-cta{display:inline-flex!important;align-items:center;justify-content:center;min-height:44px;background:var(--p-btn)!important;color:#fff!important;font-weight:500!important;font-size:.98rem;padding:.8rem 1.3rem!important;border-radius:10px!important;text-decoration:none}
.cta .ken-cta:hover{background:var(--p-deep)!important}

.sources{margin-top:3rem;padding-top:1.2rem;border-top:1px solid var(--line);font-size:.84rem;color:var(--mute);max-width:36rem}
.sources ol{margin:0;padding-left:1.2rem;display:grid;gap:.25rem}
.sources li{overflow-wrap:anywhere}
.sources li::marker{color:var(--p)}
.sources .colophon{margin-top:1.2rem;margin-bottom:0}

@media (min-width:760px){
  .mast{padding:1.3rem 2rem}
  .sheet{padding:3.4rem 2rem 6rem;display:grid;grid-template-columns:10rem minmax(0,1fr);column-gap:2.6rem}
  .sheet>*{grid-column:2}
  .sheet>.date{grid-column:1;margin:.4rem 0 0}
  .head{max-width:40rem}
  .head h1{font-size:3rem}
  .signals{grid-column:1/-1}
  .sig{grid-template-columns:10rem minmax(0,1fr);column-gap:2.6rem;padding:2rem 0 1.6rem}
  .sig .side{display:grid;align-content:start;gap:.35rem;padding-top:.35rem}
  .sig .num{font-size:2.6rem;margin-bottom:.4rem}
  .sig h2{font-size:1.65rem}
  .note p{font-size:1.1rem}
}
@media print{body{background:#fff}}
</style>
</head>
<body>
<header class="mast">
  <p class="brand">
    {%- if brand.logo_url and brand.logo_url != '' -%}
    <img class="logo" src="{{ brand.logo_url | escape }}" alt="{{ brand_name | default: 'Logo' | escape }}" height="26">
    {%- elsif brand_name != '' -%}
    <span class="logo mark" aria-hidden="true">{{ brand_name | slice: 0, 1 | upcase | escape }}</span><span>{{ brand_name | escape }}</span>
    {%- endif -%}
  </p>
  <p class="issue">Notes from {{ sender_name | escape }}{% if latest %}<br>{{ latest | date: '%B %Y' }}{% endif %}</p>
</header>

<main class="sheet">
  {%- if latest %}
  <p class="date">Latest signal<br>{{ latest | date: '%B %-d, %Y' }}</p>
  {%- endif %}
  <section class="head" data-section="head">
    <h1>{{ count_phrase | escape }} we noticed about {{ account.name | escape }} this month</h1>
    <p class="to">For {% if person_full != '' %}<b>{{ person_full | escape }}</b>{% if person.title and person.title != '' %}, {{ person.title | escape }}{% endif %} at {% else %}the team at {% endif %}<b>{{ account.name | escape }}</b></p>
  </section>

  <section class="open" data-section="opening">
    <p>{{ greeting | escape }}</p>
    <p>Each month I write down what changed at a few companies I follow, and what it usually means. This one is about {{ account.name | escape }}. {{ count_phrase | escape }} stood out.</p>
  </section>

  <ol class="signals" data-section="signals">
    {%- for sig in data.signals %}
    {%- case sig.kind -%}
    {%- when 'hiring' -%}{%- assign kind_label = 'Hiring' -%}
    {%- when 'role_change', 'leadership', 'promotion' -%}{%- assign kind_label = 'Role change' -%}
    {%- when 'funding' -%}{%- assign kind_label = 'Funding' -%}
    {%- when 'expansion' -%}{%- assign kind_label = 'Expansion' -%}
    {%- when 'news' -%}{%- assign kind_label = 'News' -%}
    {%- else -%}{%- assign kind_label = sig.kind | replace: '_', ' ' | capitalize -%}
    {%- endcase %}
    <li class="sig">
      <div class="side">
        <span class="num">{{ forloop.index }}</span>
        <span class="kind">
          {%- case sig.kind -%}
          {%- when 'hiring' -%}<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="6" cy="5" r="2.6"/><path d="M1.5 14a4.5 4.5 0 019 0M12.5 6v5M10 8.5h5"/></svg>
          {%- when 'role_change', 'leadership', 'promotion' -%}<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="8" cy="8" r="6.3"/><path d="M5.5 8.5l2 2L11 6"/></svg>
          {%- when 'funding' -%}<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12.5l4-4.5 3 2.5 5-6M10.5 4.5H14V8"/></svg>
          {%- when 'expansion' -%}<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 14.5s4.5-4 4.5-7.5a4.5 4.5 0 00-9 0c0 3.5 4.5 7.500 4.500 7.500z"/><circle cx="8" cy="7" r="1.6"/></svg>
          {%- else -%}<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 3.5h9a2 2 0 012 2v7h-11a2 2 0 01-2-2v-7zM13.5 5.5h.5a1.5 1.5 0 011.5 1.5v4a1.5 1.5 0 01-1.5 1.5M5 7h4M5 9.5h4"/></svg>
          {%- endcase -%}
          {{ kind_label | escape }}</span>
        {%- if sig.seen_on and sig.seen_on != '' %}
        <span class="seen">Seen {{ sig.seen_on | date: '%B %-d' }}</span>
        {%- endif %}
      </div>
      <div class="body">
        <h2>{{ sig.headline | escape }}</h2>
        <p class="fact">{{ sig.fact | escape }}<sup>{{ forloop.index }}</sup></p>
        <p class="ri"><b>What it usually means.</b> {{ sig.means | escape }}</p>
        <p class="ri idea"><b>One idea.</b> {{ sig.idea | escape }}</p>
      </div>
    </li>
    {%- endfor %}
  </ol>

  <section class="note" data-section="note">
    <p>{{ data.note | escape | newline_to_br | strip_newlines | raw }}</p>
    <p class="sig-name">{{ sender_first | escape }}</p>
    <p class="sig-title">{{ sender_name | escape }}{% if sender.title and sender.title != '' %}, {{ sender.title | escape }}{% endif %}{% if brand_name != '' %}{% if sender.title and sender.title != '' %} at {% else %}, {% endif %}{{ brand_name | escape }}{% endif %}</p>
  </section>

  <section class="cta" data-section="cta">
    <p>If {% if count > 1 %}one of these is{% else %}this is{% endif %} worth a conversation, pick a time that suits you.</p>
    {%- assign cta_label = 'Pick a time with ' | append: sender_first %}
    <p>{% render 'ken/cta', label: cta_label, kind: 'booking' %}</p>
    <p class="alt">Or reply to the message this came with and tell me {% if count > 1 %}which one{% else %}what you think{% endif %}.</p>
  </section>

  <footer class="sources" data-section="sources">
    <ol>
      {%- for sig in data.signals %}
      <li id="source-{{ forloop.index }}">
        {%- assign url_start = sig.source_url | slice: 0, 4 -%}
        {%- if sig.source_url and url_start == 'http' -%}
        {%- assign url_parts = sig.source_url | split: '/' -%}
        <a href="{{ sig.source_url | escape }}" rel="noopener noreferrer">{{ sig.source_label | escape }}</a>, {{ url_parts[2] | escape }}
        {%- else -%}
        {{ sig.source_label | escape }}
        {%- endif -%}
        {%- if sig.seen_on and sig.seen_on != '' -%}, {{ sig.seen_on | date: '%B %-d, %Y' }}{%- endif -%}.
      </li>
      {%- endfor %}
    </ol>
    <p class="colophon">Written by {{ sender_name | escape }}{% if brand_name != '' %} at {{ brand_name | escape }}{% endif %} for {% if person_full != '' %}{{ person_full | escape }} at {% else %}the team at {% endif %}{{ account.name | escape }}. Every fact above has its source listed here.</p>
  </footer>
</main>
</body>
</html>
