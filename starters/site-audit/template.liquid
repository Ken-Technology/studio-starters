{%- assign primary = brand.colors.primary | default: '#2a4bd7' -%}
{%- assign secondary = brand.colors.secondary | default: '#0e1530' -%}
{%- assign font_head = brand.fonts.heading | default: 'Inter Tight' -%}
{%- assign font_body = brand.fonts.body | default: 'Inter' -%}
{%- assign brand_name = brand.name | default: 'Northbeam' -%}
{%- assign first = person.first_name | default: 'there' -%}
{%- assign site = account.domain | default: account.name -%}
{%- assign sum = 0 -%}
{%- assign count = 0 -%}
{%- assign best_score = -1 -%}
{%- assign worst_score = 11 -%}
{%- for c in data.criteria -%}
{%- assign sum = sum | plus: c.score -%}
{%- assign count = count | plus: 1 -%}
{%- if c.score > best_score -%}{%- assign best_score = c.score -%}{%- assign best_name = c.name -%}{%- endif -%}
{%- if c.score < worst_score -%}{%- assign worst_score = c.score -%}{%- assign worst_name = c.name -%}{%- endif -%}
{%- endfor -%}
{%- assign total = sum | times: 10.0 | divided_by: count | round -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex">
<title>Website audit for {{ site | escape }}</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_head | url_encode }}:wght@500;600;700&display=swap">
{%- if font_body != font_head %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_body | url_encode }}:wght@400;500;600&display=swap">
{%- endif %}
<style>
:root{
  --p:{{ primary | escape }};
  --s:{{ secondary | escape }};
  --fh:'{{ font_head | escape }}',ui-sans-serif,system-ui,sans-serif;
  --fb:'{{ font_body | escape }}',ui-sans-serif,system-ui,sans-serif;
  --ink:var(--s);
  --mute:color-mix(in srgb,var(--s) 64%,#fff);
  --faint:color-mix(in srgb,var(--s) 34%,#fff);
  --rule:color-mix(in srgb,var(--s) 14%,#fff);
  --tint:color-mix(in srgb,var(--p) 7%,#fff);
  --tint2:color-mix(in srgb,var(--p) 18%,#fff);
  --tint3:color-mix(in srgb,var(--p) 30%,#fff);
}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:#fff;color:var(--ink);font:16px/1.55 var(--fb);-webkit-font-smoothing:antialiased;border-top:6px solid var(--p);padding-bottom:5.5rem;overflow-wrap:break-word}
.page{max-width:66rem;margin:0 auto;padding:0 1.25rem}
h1,h2,h3{font-family:var(--fh);font-weight:600;line-height:1.1;letter-spacing:-.015em;margin:0;text-wrap:balance}
blockquote,.after{text-wrap:balance}
p{text-wrap:pretty}
p{margin:0 0 1rem}
a{color:var(--p)}
a:focus-visible,[tabindex]:focus-visible{outline:2px solid var(--p);outline-offset:3px}
.num,.val,.tn{font-variant-numeric:tabular-nums}

.brandline{display:flex;align-items:center;gap:.6rem;padding:1rem 0;border-bottom:1px solid var(--rule);font-size:.9rem}
.logo{width:28px;height:28px;display:block;flex:none}
img.logo{width:auto;max-width:9rem;object-fit:contain}
.bname{font-weight:600}
.meta{margin-left:auto;color:var(--mute);text-align:right}

.hero{padding:2.25rem 0 0}
.for{color:var(--mute);font-size:.95rem;margin:0 0 .8rem}
.hero h1{font-size:clamp(1.85rem,6vw,3.5rem);max-width:21ch;margin-bottom:1.25rem}
.lead{max-width:40rem;font-size:1.05rem}

.score{margin-top:2.25rem;border-top:2px solid var(--ink);padding-top:1.5rem;display:grid;gap:1.5rem}
.total .what{display:block;font-weight:600;font-size:.95rem}
.total .num{display:inline-block;font:700 6.5rem/1 var(--fh);letter-spacing:-.045em;color:var(--p);margin:.3rem 0 .2rem}
.total .of{font:500 1.2rem/1 var(--fh);color:var(--mute);margin-left:.3rem}
.total p{color:var(--mute);font-size:.92rem;max-width:30rem;margin:.5rem 0 0}
.total .range{color:var(--ink);font-weight:500}
.criteria{list-style:none;margin:0;padding:0}
.criteria li{display:grid;grid-template-columns:1fr auto auto;grid-template-areas:"name val verdict" "cells cells cells";gap:.4rem .6rem;align-items:center;padding:.85rem 0;border-top:1px solid var(--rule)}
.criteria li:first-child{border-top:0;padding-top:0}
.criteria .name{grid-area:name;font-weight:500}
.criteria .val{grid-area:val;font:600 1.15rem/1 var(--fh);text-align:right}
.criteria .val small{font:500 .8rem/1 var(--fb);color:var(--mute)}
.criteria .verdict{grid-area:verdict;font-size:.8rem;color:var(--mute);min-width:3.2rem}
.cells{grid-area:cells;position:relative;height:14px;background:linear-gradient(90deg,var(--tint2) 0 calc(100% - 3px),transparent calc(100% - 3px) 100%) 0 0/10% 100% repeat-x}
.cells::before{content:"";position:absolute;inset:0;background:linear-gradient(90deg,var(--p) 0 calc(100% - 3px),transparent calc(100% - 3px) 100%) 0 0/10% 100% repeat-x;clip-path:inset(0 calc(100% - var(--n)*10%) 0 0)}
.cells.mini{height:7px;width:7.5rem;display:inline-block;vertical-align:middle}

.sec{margin-top:3rem}
.sec h2{font-size:1.7rem;margin-bottom:.4rem}
.sub{color:var(--mute);margin-bottom:1.25rem}

.f{display:grid;gap:.6rem;padding:1.4rem 0;border-top:1px solid var(--rule)}
.f:last-child{padding-bottom:0}
.fh h3{font-size:1.05rem;margin-bottom:.3rem}
.fh .tn{font-size:.82rem;color:var(--mute);white-space:nowrap}
.fh .tn b{color:var(--ink);font-weight:600}
blockquote{margin:0 0 .7rem;padding:.1rem 0 .1rem .9rem;border-left:3px solid var(--p);font-family:var(--fh);font-weight:500;font-size:1.2rem;line-height:1.3}
blockquote cite{display:block;font:400 .8rem/1.4 var(--fb);color:var(--mute);font-style:normal;margin-top:.35rem}
.f .fb p{max-width:40rem;margin:0}

.rewrites{background:var(--tint);padding:1.75rem 1.25rem;margin:3rem -1.25rem 0}
.rewrites .sub{margin-bottom:.5rem}
.rw{display:grid;gap:.9rem;padding:1.25rem 0;border-top:1px solid var(--tint3)}
.rw:last-child{padding-bottom:0}
.rw h3{grid-column:1/-1;font:600 .85rem/1.3 var(--fb);color:var(--mute);margin:0}
.lbl{display:block;font-size:.75rem;color:var(--mute);margin-bottom:.3rem}
.now{color:var(--mute);font-size:1.05rem;line-height:1.45;margin:0}
.after{font-family:var(--fh);font-weight:600;font-size:1.5rem;line-height:1.2;letter-spacing:-.01em;margin:0}
.btn-demo{display:inline-block;font:600 1rem/1 var(--fb);padding:.8rem 1.1rem;border-radius:3px;letter-spacing:0}
.btn-demo.on{background:var(--p);color:#fff}
.btn-demo.off{border:1.5px solid var(--faint);color:var(--mute)}
.why{grid-column:1/-1;margin:0;font-size:.95rem;max-width:44rem}
.grade{grid-column:1/-1;display:flex;align-items:center;gap:.45rem;font-size:.8rem;color:var(--mute);margin:0}
.grade svg{width:14px;height:14px;flex:none}

.wire{display:grid;gap:1.5rem}
.wire svg{width:100%;height:auto;display:block}
.key{list-style:none;margin:0;padding:0;counter-reset:k}
.key li{counter-increment:k;position:relative;padding:.7rem 0 .7rem 2.3rem;border-top:1px solid var(--rule);font-size:.95rem}
.key li:first-child{border-top:0;padding-top:0}
.key li:first-child::before{top:.05rem}
.key li::before{content:counter(k);position:absolute;left:0;top:.75rem;width:1.5rem;height:1.5rem;border-radius:50%;background:var(--p);color:#fff;font:700 .8rem/1.5rem var(--fh);text-align:center}
.key b{display:block;font-weight:600}

.fixes{list-style:none;margin:0;padding:0;counter-reset:f;display:grid;gap:1.25rem}
.fixes li{counter-increment:f;padding:1.25rem 0 0;border-top:2px solid var(--ink)}
.fixes li::before{content:counter(f);display:block;font:700 3rem/1 var(--fh);letter-spacing:-.04em;color:var(--p);margin-bottom:.6rem}
.fixes b{display:block;font-family:var(--fh);font-weight:600;font-size:1.25rem;line-height:1.2;margin-bottom:.4rem}
.fixes p{margin:0}
.fixes small{display:block;color:var(--mute);font-size:.82rem;margin-top:.6rem}

.next{margin-top:3rem;border-top:2px solid var(--ink);padding-top:1.5rem;display:grid;gap:1rem}
.next p{max-width:38rem;margin:0}
.next .ken-cta{display:inline-flex!important;align-items:center;justify-content:center;min-height:48px;background:var(--p)!important;color:#fff!important;text-decoration:none;font:600 1rem/1.2 var(--fb);padding:.95rem 1.4rem!important;border-radius:3px!important}
.next .ken-cta:hover{background:color-mix(in srgb,var(--p) 85%,#000)!important}
.next .cta{justify-self:start}
.sign{font-size:.95rem}
.sign b{display:block;font-weight:600}
.sign span{color:var(--mute)}
.foot{margin-top:2.5rem;padding-top:1rem;border-top:1px solid var(--rule);font-size:.78rem;color:var(--mute);max-width:46rem}

@media (min-width:760px){
  .page{padding:0 2.5rem}
  .brandline{padding:1.25rem 0}
  .hero{padding-top:3.5rem}
  .hero h1{margin-bottom:1.5rem}
  .score{grid-template-columns:minmax(0,1fr) minmax(0,1.7fr);gap:3.5rem;margin-top:3rem;padding-top:2rem}
  .total .num{font-size:9rem}
  .criteria li{grid-template-columns:11.5rem minmax(0,1fr) 3.4rem 4.2rem;grid-template-areas:"name cells val verdict";gap:1.25rem;padding:1rem 0}
  .criteria li:first-child{padding-top:.25rem}
  .criteria .verdict{text-align:left}
  .sec{margin-top:4.5rem}
  .sec h2{font-size:2.1rem}
  .f{grid-template-columns:14rem minmax(0,1fr);gap:0 3rem;padding:1.75rem 0}
  blockquote{font-size:1.35rem}
  .rewrites{margin:4.5rem 0 0;padding:2.5rem 3rem 2.5rem}
  .rw{grid-template-columns:minmax(0,1fr) minmax(0,1.35fr);gap:.9rem 3rem;padding:1.75rem 0}
  .after{font-size:1.9rem}
  .wire{grid-template-columns:minmax(0,1.3fr) minmax(0,1fr);gap:3rem;align-items:start}
  .wire svg{position:sticky;top:1.5rem}
  .fixes{grid-template-columns:repeat(3,minmax(0,1fr));gap:2.5rem}
  .next{grid-template-columns:minmax(0,1fr) auto;align-items:end;gap:1rem 3rem;padding-top:2rem;margin-top:4.5rem}
  .next .sign{grid-column:1;grid-row:2}
  .next .cta{grid-column:2;grid-row:1/3;align-self:center}
}
@media (prefers-reduced-motion:no-preference){.next .ken-cta{transition:background .15s}}
@media print{body{border-top:0;padding-bottom:0}.rewrites{background:#f3f3f3}}
</style>
</head>
<body>
<main class="page">

<header class="hero" data-section="hero">
  <div class="brandline">
    {%- if brand.logo_url %}
    <img class="logo" src="{{ brand.logo_url | escape }}" alt="">
    {%- else %}
    <svg class="logo" viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="8" fill="var(--p)"/><text x="16" y="21.5" text-anchor="middle" font-family="var(--fh)" font-weight="700" font-size="16" fill="#fff">{{ brand_name | slice: 0 | upcase | escape }}</text></svg>
    {%- endif %}
    <span class="bname">{{ brand_name | escape }}</span>
    <span class="meta">Website audit<br>{{ site | escape }}</span>
  </div>
  <p class="for">For {% if person %}{{ person.first_name | escape }}{% if person.last_name and person.last_name != '' %} {{ person.last_name | escape }}{% endif %}{% if person.title and person.title != '' %}, {{ person.title | escape }} at {% else %}, at {% endif %}{% else %}the team at {% endif %}{{ account.name | escape }}</p>
  <h1>{{ data.headline | escape }}</h1>
  <p class="lead">Hi {{ first | escape }}. I read {{ site | escape }} the way a first-time visitor would, scored it on the six things that decide whether they get in touch, and rewrote the two lines that matter most.</p>
</header>

<section class="score" data-section="score">
  <div class="total">
    <span class="what">Conversion score</span>
    <span class="num">{{ total }}</span><span class="of">of 100</span>
    <p>The mean of the six scores below, read from the text of the page. On this scale, 75 or more means a first-time visitor sees what you do, proof it works and how to reach you in one screen.</p>
    <p><span class="range">Strongest: {{ best_name | escape }}, {{ best_score }} of 10. Weakest: {{ worst_name | escape }}, {{ worst_score }} of 10.</span></p>
  </div>
  <ol class="criteria" aria-label="Six criteria scored out of 10">
    {%- for c in data.criteria %}
    <li><span class="name">{{ c.name | escape }}</span><span class="cells" style="--n:{{ c.score }}" role="img" aria-label="{{ c.score }} of 10"></span><span class="val">{{ c.score }}<small>/10</small></span><span class="verdict">{% if c.score <= 4 %}Weak{% elsif c.score <= 6 %}Fair{% else %}Strong{% endif %}</span></li>
    {%- endfor %}
  </ol>
</section>

<section class="sec" data-section="findings">
  <h2>What I found</h2>
  <p class="sub">Each quote is copied from {{ site | escape }} as it read when I scored it.</p>
  {%- for c in data.criteria %}

  <article class="f">
    <div class="fh"><h3>{{ c.name | escape }}</h3><span class="tn"><span class="cells mini" style="--n:{{ c.score }}" aria-hidden="true"></span> <b>{{ c.score }}</b> of 10</span></div>
    <div class="fb">
      <blockquote>&ldquo;{{ c.quote | escape }}&rdquo;<cite>{{ c.where | escape }}</cite></blockquote>
      <p>{{ c.cost | escape }}</p>
    </div>
  </article>
  {%- endfor %}
</section>

<section class="rewrites" data-section="rewrites">
  <h2>Two rewrites</h2>
  <p class="sub">Your copy as it reads now, then mine. Paste either as it is.</p>
  {%- for rw in data.rewrites %}

  <article class="rw">
    <h3>{{ rw.where | escape }}</h3>
    {%- if rw.kind == 'button' %}
    <div><span class="lbl">Now</span><p class="now"><span class="btn-demo off">{{ rw.before | escape }}</span></p></div>
    <div><span class="lbl">Rewrite</span><p class="after"><span class="btn-demo on">{{ rw.after | escape }}</span></p></div>
    {%- else %}
    <div><span class="lbl">Now</span><p class="now">{{ rw.before | escape }}</p></div>
    <div><span class="lbl">Rewrite</span><p class="after">{{ rw.after | escape }}</p></div>
    {%- endif %}
    <p class="why">{{ rw.why | escape }}</p>
    <p class="grade"><svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="7" fill="none" stroke="currentColor"/><path d="M4.5 8.2l2.3 2.3 4.7-5" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>Passed the rewrite check{% if rw.grade %} at {{ rw.grade | round: 1 }} of 10{% endif %}: verbatim before, specific, clearer, plain words.</p>
  </article>
  {%- endfor %}
</section>

<section class="sec" data-section="wireframe">
  <h2>Your first screen, marked up</h2>
  <p class="sub">A sketch of the first screen a visitor sees on a laptop, with a note on each part.</p>
  <div class="wire">
    <svg viewBox="0 0 400 250" role="img" aria-label="Wireframe of a first screen with five numbered callouts">
      <rect x="0.5" y="0.5" width="399" height="249" rx="6" fill="#fff" stroke="var(--rule)"/>
      <path d="M0.5 20.5H399.5" stroke="var(--rule)"/>
      <circle cx="12" cy="10.5" r="3" fill="var(--rule)"/><circle cx="22" cy="10.5" r="3" fill="var(--rule)"/><circle cx="32" cy="10.5" r="3" fill="var(--rule)"/>
      <rect x="150" y="6" width="100" height="9" rx="4.5" fill="var(--tint)"/>
      <rect x="18" y="32" width="46" height="10" rx="2" fill="var(--ink)"/>
      <rect x="236" y="34" width="24" height="6" rx="1" fill="var(--rule)"/>
      <rect x="268" y="34" width="24" height="6" rx="1" fill="var(--rule)"/>
      <rect x="300" y="34" width="24" height="6" rx="1" fill="var(--rule)"/>
      <rect x="332" y="34" width="24" height="6" rx="1" fill="var(--rule)"/>
      <rect x="18" y="66" width="170" height="13" rx="2" fill="var(--ink)"/>
      <rect x="18" y="85" width="132" height="13" rx="2" fill="var(--ink)"/>
      <rect x="18" y="110" width="176" height="6" rx="1" fill="var(--faint)"/>
      <rect x="18" y="121" width="160" height="6" rx="1" fill="var(--faint)"/>
      <rect x="18" y="132" width="118" height="6" rx="1" fill="var(--faint)"/>
      <rect x="18" y="152" width="78" height="22" rx="3" fill="var(--p)"/>
      <rect x="104.5" y="152.5" width="70" height="21" rx="3" fill="none" stroke="var(--ink)"/>
      <rect x="228.5" y="60.5" width="153" height="113" rx="3" fill="var(--tint)" stroke="var(--rule)"/>
      <path d="M228.5 60.5L381.5 173.5M381.5 60.5L228.5 173.5" stroke="var(--rule)"/>
      <path d="M18 198H382" stroke="var(--rule)"/>
      <rect x="36" y="211" width="150" height="5" rx="1" fill="var(--rule)"/>
      <rect x="36" y="226" width="48" height="14" rx="2" fill="var(--rule)"/>
      <rect x="96" y="226" width="48" height="14" rx="2" fill="var(--rule)"/>
      <rect x="156" y="226" width="48" height="14" rx="2" fill="var(--rule)"/>
      <rect x="216" y="226" width="48" height="14" rx="2" fill="var(--rule)"/>
      <rect x="276" y="226" width="48" height="14" rx="2" fill="var(--rule)"/>
      <rect x="336" y="226" width="48" height="14" rx="2" fill="var(--rule)"/>
      <g font-family="var(--fh)" font-weight="700" font-size="11" fill="#fff" text-anchor="middle">
        <circle cx="200" cy="72.5" r="10" fill="var(--p)"/><text x="200" y="76.5">1</text>
        <circle cx="206" cy="113" r="10" fill="var(--p)"/><text x="206" y="117">2</text>
        <circle cx="187" cy="163" r="10" fill="var(--p)"/><text x="187" y="167">3</text>
        <circle cx="372" cy="37" r="10" fill="var(--p)"/><text x="372" y="41">4</text>
        <circle cx="18" cy="233" r="10" fill="var(--p)"/><text x="18" y="237">5</text>
      </g>
    </svg>
    <ol class="key">
      {%- assign labels = 'Headline,Subline,Main button,Navigation,Proof row' | split: ',' %}
      {%- for note in data.callouts %}
      <li><b>{{ labels[forloop.index0] }}</b>{{ note | escape }}</li>
      {%- endfor %}
    </ol>
  </div>
</section>

<section class="sec" data-section="fixes">
  <h2>Three fixes, in order</h2>
  <p class="sub">Biggest effect for the least work first.</p>
  <ol class="fixes">
    {%- for fix in data.fixes %}
    <li><b>{{ fix.title | escape }}</b><p>{{ fix.body | escape }}</p><small>{{ fix.effort | escape }}</small></li>
    {%- endfor %}
  </ol>
</section>

<section class="next" data-section="next">
  <p>If you want the rest of the site gone through page by page, book 20 minutes and I will walk you through it, with the rewrites ready to paste.</p>
  <p class="sign"><b>{{ sender.name | default: brand_name | escape }}</b>{% if sender.title and sender.title != '' %}<span>{{ sender.title | escape }}, {{ brand_name | escape }}</span>{% else %}<span>{{ brand_name | escape }}</span>{% endif %}</p>
  <div class="cta">{% render 'ken/cta', label: 'Book 20 minutes', kind: 'booking' %}</div>
</section>

<p class="foot">Scored from the text of {{ site | escape }} when this page was built. Quotes are copied word for word. The score reads the words on the page, not speed, design or traffic, so it shows where a first-time visitor can get stuck, not how many do.</p>

</main>
</body>
</html>
