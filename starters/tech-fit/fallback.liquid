{%- assign accent = brand.colors.primary | default: '#4f35d1' -%}
{%- assign accent2 = brand.colors.secondary | default: '#15171b' -%}
{%- assign font_head = brand.fonts.heading | default: 'Geist' -%}
{%- assign font_body = brand.fonts.body | default: 'Geist' -%}
{%- assign head_q = font_head | replace: ' ', '+' -%}
{%- assign body_q = font_body | replace: ' ', '+' -%}
{%- assign us = brand.name | default: 'our product' -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex">
<title>How {{ us | escape }} fits the tools {{ account.name | escape }} runs</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ head_q }}:wght@400;500;600;700&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ body_q }}:wght@400;500;600;700&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500&display=swap">
<style>
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:#f3f3ef;color:#15171b;font-family:'{{ font_body }}',ui-sans-serif,system-ui,-apple-system,'Segoe UI',sans-serif;font-size:16px;line-height:1.55;-webkit-font-smoothing:antialiased}
.tf{--a:{{ accent }};--a2:{{ accent2 }};--ink:#15171b;--text:#34373d;--mute:#6a6e76;--line:#dcdbd4;--panel:#fff;--mono:'Geist Mono',ui-monospace,SFMono-Regular,Menlo,Consolas,monospace}
.tf h1,.tf h2{font-family:'{{ font_head }}',ui-sans-serif,system-ui,sans-serif;font-weight:600;letter-spacing:-.02em;margin:0;text-wrap:balance}
p{margin:0 0 1rem}
.tf-mono{font-family:var(--mono);font-size:.72rem;font-weight:500;letter-spacing:.08em;text-transform:uppercase;color:var(--mute);margin:0}
.tf-wrap{max-width:68rem;margin:0 auto;padding:0 1.25rem}
.tf-top{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:1rem 0;border-bottom:1px solid var(--ink)}
.tf-logo{height:24px;width:auto;display:block}
.tf-brand{font-weight:700;font-size:1rem;letter-spacing:-.01em}
.tf-top .tf-mono{text-align:right}
.tf-hero{padding:2rem 0 1.5rem;max-width:40rem}
.tf-kicker{display:flex;align-items:center;gap:.6rem;color:var(--a)}
.tf-kicker::before{content:'';flex:none;width:8px;height:8px;background:var(--a2)}
.tf h1{font-size:2.15rem;line-height:1.06;margin:.9rem 0 1rem}
.tf-intro{font-size:1.1rem;line-height:1.5;color:var(--text)}
.tf-stack{background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:1rem 1.1rem;max-width:40rem}
.tf-stack p{margin:0;color:var(--text)}
.tf-stack .tf-mono{margin-bottom:.4rem}
.tf-next{padding:2rem 0 3rem;max-width:40rem}
.tf-box{background:#fff;background:color-mix(in srgb,var(--a) 6%,#fff);border:1px solid var(--line);border-color:color-mix(in srgb,var(--a) 28%,var(--line));border-radius:12px;padding:1.4rem 1.2rem 1.2rem}
.tf-box h2{font-size:1.5rem;margin-bottom:.6rem}
.tf-box p{color:var(--text)}
.tf-cta{margin:1.1rem 0 1.3rem}
.tf-cta .ken-cta{background:var(--a)!important;display:inline-flex!important;align-items:center;min-height:48px;font-family:inherit}
.tf-sign{font-size:.95rem;margin:0}
.tf-sign b{font-weight:600}
.tf-sign span{display:block;color:var(--mute)}
@media (min-width:760px){body{font-size:17px}.tf-wrap{padding:0 2.5rem}.tf-top{padding:1.2rem 0}.tf-hero{padding:3.5rem 0 2rem}.tf h1{font-size:3.2rem;margin:1.1rem 0 1.2rem}.tf-intro{font-size:1.2rem}.tf-box{padding:2.2rem 2.4rem 2rem}}
</style>
</head>
<body>
<main class="tf">
<div class="tf-wrap">
<header class="tf-top">
{%- if brand.logo_url %}<img class="tf-logo" src="{{ brand.logo_url | escape }}" alt="{{ brand.name | default: 'Logo' | escape }}">{% elsif brand.name %}<span class="tf-brand">{{ brand.name | escape }}</span>{% else %}<span></span>{% endif -%}
<p class="tf-mono">Integration fit for {{ account.name | escape }}</p>
</header>
<section data-section="hero" class="tf-hero">
<p class="tf-mono tf-kicker">{% if person.first_name %}Prepared for {{ person.first_name | escape }} {{ person.last_name | escape }}, {{ account.name | escape }}{% else %}Prepared for {{ account.name | escape }}{% endif %}</p>
<h1>How {{ us | escape }} fits the tools {{ account.name | escape }} runs</h1>
<p class="tf-intro">Hi {{ person.first_name | default: 'there' | escape }}. I am reading {{ account.domain | escape }} and its careers page to guess which tools your team already runs, and matching each one to the integrations {{ us | escape }} has today.</p>
</section>
<aside class="tf-stack">
<p class="tf-mono">Your stack, as we guess it</p>
<p>The list is not on this page yet. This link stays the same, so check back later today.</p>
</aside>
<section data-section="next" class="tf-next">
<div class="tf-box">
<h2>Rather tell me your stack?</h2>
<p>Grab 20 minutes and name the two or three systems your team lives in. I will walk you through how {{ us | escape }} plugs into each, and say plainly where it does not yet.</p>
<div class="tf-cta">{% render 'ken/cta', label: 'Book 20 minutes', kind: 'booking' %}</div>
<p class="tf-sign"><b>{{ sender.name | default: 'Our team' | escape }}</b>{% if sender.title %}<span>{{ sender.title | escape }}{% if brand.name %}, {{ brand.name | escape }}{% endif %}</span>{% elsif brand.name %}<span>{{ brand.name | escape }}</span>{% endif %}</p>
</div>
</section>
</div>
</main>
</body>
</html>
