{%- assign accent = brand.colors.primary | default: '#7fb21c' -%}
{%- assign accent2 = brand.colors.secondary | default: '#161a17' -%}
{%- assign font_head = brand.fonts.heading | default: 'STIX Two Text' -%}
{%- assign font_body = brand.fonts.body | default: 'STIX Two Text' -%}
{%- assign us = brand.name | default: 'our product' -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex">
<title>How {{ us | escape }} fits the tools {{ account.name | escape }} runs</title>
{%- if font_head == 'STIX Two Text' %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=STIX+Two+Text:ital,wght@0,400;0,600;0,700;1,400&display=swap">
{%- else %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_head | url_encode }}&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_head | url_encode }}:wght@700&display=swap">
{%- endif %}
{%- if font_body != font_head %}
{%- if font_body == 'STIX Two Text' %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=STIX+Two+Text:ital,wght@0,400;0,600;0,700;1,400&display=swap">
{%- else %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_body | url_encode }}&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_body | url_encode }}:wght@700&display=swap">
{%- endif %}
{%- endif %}
<style>
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:#f4f5f1;color:#161a17;font-family:'{{ font_body }}',Georgia,'Times New Roman',serif;font-size:18px;line-height:1.5;-webkit-font-smoothing:antialiased}
.tf{--a:{{ accent }};--a2:{{ accent2 }};--ink:#161a17;--soft:#4a504b;--paper:#f4f5f1;--rule:#c9cec4;
--on-a:#161a17;--on-a:oklch(from var(--a) clamp(0.2,(0.6 - l) * 1000,0.985) 0.01 h);
--on-a2:#f4f5f1;--on-a2:oklch(from var(--a2) clamp(0.2,(0.6 - l) * 1000,0.975) 0.01 h);
--m:clamp(1.125rem,3vw,2.5rem);overflow-x:clip}
.tf h1,.tf h2,.nm{font-family:'{{ font_head }}',Georgia,'Times New Roman',serif;font-weight:600;letter-spacing:-.01em;line-height:1.1;text-wrap:balance;margin:0}
.tf p{margin:0}
.tf ol{margin:0;padding:0;list-style:none}
.tf .ken-cta:focus-visible{outline:3px solid var(--ink);outline-offset:3px}
.wrap{padding:0 var(--m);max-width:84rem;margin:0 auto}
.top{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:1.1rem 0;border-bottom:2px solid var(--ink)}
.logo{height:26px;width:auto;display:block}
.brand{font-weight:700;font-size:1rem}
.tag{font-size:1rem;font-style:italic;color:var(--soft);text-align:right}
.hero{padding:2rem 0 3rem}
.hero h1{font-size:2rem;margin-bottom:1.2rem}
.intro{font-size:1.125rem;max-width:38rem}
.for{font-size:1rem;color:var(--soft);margin-top:.9rem!important}
.for b{color:var(--ink);font-weight:600}
.line{position:relative;display:grid;padding:.4rem 0}
.tf .line{margin-top:2rem}
.line::before{content:'';position:absolute;left:calc(1.2rem - 6px);top:0;bottom:0;width:12px;border-radius:6px;background:var(--a)}
.stop{position:relative;padding:.75rem 0 .75rem 3.4rem;min-height:3.4rem}
.stop::before{content:'';position:absolute;left:calc(1.2rem - 11px);top:1.05rem;width:22px;height:22px;border-radius:50%;background:#fff;border:4px solid var(--ink)}
.stop.us::before{width:30px;height:30px;left:calc(1.2rem - 15px);top:.85rem;border-radius:7px;background:var(--a2);border-color:var(--a2)}
.stop.wait::before{background:var(--paper);border:3px dashed var(--soft)}
.nm{font-size:1.25rem}
.stop.wait .nm{font-weight:400;font-style:italic;color:var(--soft)}
.next{background:var(--a);color:var(--on-a);padding:3.4rem 0 3rem}
.next-in{display:grid;gap:1.4rem}
.next h2{font-size:2rem}
.next p{font-size:1.125rem;max-width:36rem}
.btn{margin:1.4rem 0 1.2rem}
.btn .ken-cta{display:inline-flex!important;align-items:center;min-height:52px;padding:.85rem 1.6rem!important;border-radius:999px!important;background:var(--a2)!important;color:var(--on-a2)!important;font-family:inherit;font-size:1rem;font-weight:600!important;text-decoration:none}
.sign{font-size:1rem}
.sign b{font-weight:600}
.sign span{display:block}
@media (min-width:860px){
body{font-size:19px}
.hero{padding:3rem 0 4rem}
.hero h1{font-size:3rem}
.line{grid-auto-flow:column;grid-auto-columns:minmax(0,1fr);padding:0 30% 0 0}
.tf .line{margin-top:5rem}
.line::before{left:0;right:0;top:calc(6rem - 8px);bottom:auto;width:auto;height:16px;border-radius:8px}
.stop{height:8rem;padding:0}
.stop::before{left:calc(50% - 16px);top:calc(6rem - 16px);width:32px;height:32px;border-width:5px}
.stop.us::before{left:calc(50% - 22px);top:calc(6rem - 22px);width:44px;height:44px;border-radius:9px}
.nm{position:absolute;left:50%;bottom:3.4rem;transform-origin:left bottom;transform:rotate(-38deg);white-space:nowrap;font-size:2rem}
.next{padding:5rem 0 4rem}
.next-in{grid-template-columns:minmax(0,7fr) minmax(0,5fr);column-gap:4rem;align-items:end}
.next h2{font-size:3rem}
}
</style>
</head>
<body>
<main class="tf">
<div class="wrap">
<header class="top">
{%- if brand.logo_url %}<img class="logo" src="{{ brand.logo_url | escape }}" alt="{{ brand.name | default: 'Logo' | escape }}">{% elsif brand.name %}<p class="brand">{{ brand.name | escape }}</p>{% else %}<span></span>{% endif -%}
<p class="tag">Integration fit for {{ account.name | escape }}</p>
</header>
<section data-section="hero" class="hero">
<h1>How {{ us | escape }} fits the tools {{ account.name | escape }} runs</h1>
<p class="intro">Hi {{ person.first_name | default: 'there' | escape }}. I am reading {{ account.domain | escape }} and its careers page to guess which tools your team already runs, and matching each one to the integrations {{ us | escape }} has today. The list is not on this page yet. This link stays the same, so check back later today.</p>
<p class="for">{% if person.first_name %}Prepared for <b>{{ person.first_name | escape }} {{ person.last_name | escape }}</b>, {{ account.name | escape }}{% else %}Prepared for <b>{{ account.name | escape }}</b>{% endif %}</p>
<ol class="line" aria-label="Your stack, still being worked out">
<li class="stop us"><span class="nm">{{ us | escape }}</span></li>
<li class="stop wait"><span class="nm">Your tools</span></li>
<li class="stop wait"><span class="nm">still being read</span></li>
</ol>
</section>
</div>
<section data-section="next" class="next">
<div class="wrap next-in">
<h2>Rather tell me your stack?</h2>
<div>
<p>Grab 20 minutes and name the two or three systems your team lives in. I will walk you through how {{ us | escape }} plugs into each, and say plainly where it does not yet.</p>
<div class="btn">{% render 'ken/cta', label: 'Book 20 minutes', kind: 'booking' %}</div>
<p class="sign"><b>{{ sender.name | default: 'Our team' | escape }}</b>{% if sender.title %}<span>{{ sender.title | escape }}{% if brand.name %}, {{ brand.name | escape }}{% endif %}</span>{% elsif brand.name %}<span>{{ brand.name | escape }}</span>{% endif %}</p>
</div>
</div>
</section>
</main>
</body>
</html>
