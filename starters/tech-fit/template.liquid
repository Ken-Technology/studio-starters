{%- assign accent = brand.colors.primary | default: '#4f35d1' -%}
{%- assign accent2 = brand.colors.secondary | default: '#15171b' -%}
{%- assign font_head = brand.fonts.heading | default: 'Geist' -%}
{%- assign font_body = brand.fonts.body | default: 'Geist' -%}
{%- assign head_q = font_head | replace: ' ', '+' -%}
{%- assign body_q = font_body | replace: ' ', '+' -%}
{%- assign us = brand.name | default: 'our product' -%}
{%- assign tool_count = data.tools | size -%}
{%- assign match_count = data.matches | size -%}
{%- assign catalog_count = data.integrations | size -%}
{%- assign catalog = data.integrations | map: 'tool' -%}
{%- assign matched = data.matches | map: 'tool' -%}
{%- assign gap_count = tool_count | minus: match_count -%}
{%- assign other_count = catalog_count | minus: match_count -%}
{%- assign setup_count = 0 -%}
{%- for m in data.matches -%}{%- for i in data.integrations -%}{%- if i.tool == m.tool and i.setup and i.setup != '' -%}{%- assign setup_count = setup_count | plus: 1 -%}{%- endif -%}{%- endfor -%}{%- endfor -%}
{%- assign n = 1 -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex">
<title>{{ data.headline | escape }}</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ head_q }}:wght@400;500;600;700&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ body_q }}:wght@400;500;600;700&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500&display=swap">
<style>
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:#f3f3ef;color:#15171b;font-family:'{{ font_body }}',ui-sans-serif,system-ui,-apple-system,'Segoe UI',sans-serif;font-size:16px;line-height:1.55;-webkit-font-smoothing:antialiased}
.tf{--a:{{ accent }};--a2:{{ accent2 }};--ink:#15171b;--text:#34373d;--mute:#6a6e76;--line:#dcdbd4;--panel:#fff;--mono:'Geist Mono',ui-monospace,SFMono-Regular,Menlo,Consolas,monospace}
.tf h1,.tf h2,.tf h3{font-family:'{{ font_head }}',ui-sans-serif,system-ui,sans-serif;font-weight:600;letter-spacing:-.02em;margin:0;text-wrap:balance}
p{margin:0 0 1rem}
.tf a{color:var(--a)}
.tf-mono{font-family:var(--mono);font-size:.72rem;font-weight:500;letter-spacing:.08em;text-transform:uppercase;color:var(--mute);margin:0}
.tf-wrap{max-width:68rem;margin:0 auto;padding:0 1.25rem}
.tf-top{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:1rem 0;border-bottom:1px solid var(--ink)}
.tf-logo{height:24px;width:auto;display:block}
.tf-brand{font-weight:700;font-size:1rem;letter-spacing:-.01em}
.tf-top .tf-mono{text-align:right;max-width:60%}
.tf-hero{padding:2rem 0 2.25rem;display:grid;gap:1.75rem}
.tf-kicker{display:flex;align-items:center;gap:.6rem;color:var(--a);text-wrap:balance}
.tf-kicker::before{content:'';flex:none;width:8px;height:8px;background:var(--a2)}
.tf h1{font-size:2.15rem;line-height:1.06;margin:.9rem 0 1rem}
.tf-intro{font-size:1.1rem;line-height:1.5;color:var(--text);max-width:34rem;margin-bottom:1.1rem}
.tf-by{font-size:.92rem;color:var(--mute);margin:0}
.tf-by b{color:var(--ink);font-weight:600}
.tf-stack{background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:1rem 1.1rem .9rem;align-self:start}
.tf-stack .tf-mono{margin-bottom:.4rem}
.tf-stack-body{position:relative}
.tf-stack-body::before{content:'';position:absolute;left:5px;top:.9rem;bottom:1rem;width:2px;background:var(--line)}
.tf-stack ol{list-style:none;margin:0;padding:0}
.tf-stack li,.tf-stack-us{position:relative;display:grid;grid-template-columns:12px 1fr auto;gap:.75rem;align-items:center;padding:.55rem 0;border-bottom:1px solid var(--line);font-size:.95rem}
.tf-stack li b{font-weight:600}
.tf-dot{width:12px;height:12px;border-radius:50%;border:2px solid var(--a);background:var(--a);justify-self:center}
.is-gap .tf-dot{background:var(--panel);border-color:#b4b8c0}
.no-catalog .tf-dot{background:var(--ink);border-color:var(--ink)}
.tf-stack .tf-cat{font-family:var(--mono);font-size:.72rem;color:var(--mute);text-align:right}
.tf-stack-us{border-bottom:0;padding:.75rem 0 .2rem;font-weight:600}
.tf-us-mark{width:12px;height:12px;border-radius:3px;background:var(--ink);justify-self:center}
.tf-stack-us .tf-cat{color:var(--a)}
.tf-sec{padding:2.5rem 0 0}
.tf-head{display:grid;grid-template-columns:2.5rem 1fr;gap:.5rem;align-items:baseline;padding-top:1rem;border-top:1px solid var(--ink);margin-bottom:.9rem}
.tf-num{font-family:var(--mono);font-size:.82rem;font-weight:500;color:var(--a)}
.tf h2{font-size:1.5rem;line-height:1.15}
.tf-lede{color:var(--text);max-width:40rem;margin:0 0 1.4rem}
.tf-tools{list-style:none;margin:0;padding:0;border-top:1px solid var(--line)}
.tf-tool{padding:1rem 0;border-bottom:1px solid var(--line);display:grid;gap:.45rem}
.tf-tool-name{display:flex;align-items:center;gap:.6rem;flex-wrap:wrap}
.tf-tool h3{font-size:1.1rem;line-height:1.25}
.tf-tag{font-family:var(--mono);font-size:.66rem;font-weight:500;letter-spacing:.08em;text-transform:uppercase;color:var(--mute);border:1px solid var(--line);border-radius:4px;padding:.15rem .4rem;line-height:1.3}
.tf-tool .tf-cat{font-family:var(--mono);font-size:.74rem;color:var(--mute)}
.tf-clue{margin:0;color:var(--text);font-size:.97rem}
.tf-src{margin:.1rem 0 0}
.tf-status{display:flex;align-items:center;gap:.5rem;color:var(--a);margin-top:.2rem}
.tf-status::before{content:'';flex:none;width:1.4rem;height:2px;background:var(--a)}
.is-gap .tf-status{color:var(--mute)}
.is-gap .tf-status::before{background:repeating-linear-gradient(90deg,#b4b8c0 0 4px,transparent 4px 7px)}
.tf-empty{background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:1.1rem 1.1rem 1rem}
.tf-empty p:last-child{margin:0}
.tf-matches{display:grid;gap:1rem}
.tf-match{background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:1.1rem 1.1rem 1rem}
.tf-wire{display:flex;align-items:center;gap:.6rem;margin-bottom:.8rem}
.tf-node{font-family:var(--mono);font-size:.8rem;font-weight:500;letter-spacing:.02em;border:1px solid var(--ink);border-radius:6px;padding:.45rem .7rem;line-height:1.2}
.tf-node--us{border-color:var(--a);color:var(--a)}
.tf-wire-line{flex:1;height:2px;background:var(--a);position:relative;min-width:1.5rem}
.tf-wire-line::after{content:'';position:absolute;left:50%;top:50%;width:8px;height:8px;margin:-4px 0 0 -4px;border-radius:50%;background:var(--panel);border:2px solid var(--a)}
.tf-conn{margin:0 0 .5rem}
.tf-conn span{color:var(--ink)}
.tf-sum{font-size:1.04rem;line-height:1.5;color:var(--ink);margin-bottom:.9rem}
.tf-dl{margin:0;display:grid;gap:.4rem}
.tf-dl div{display:grid;grid-template-columns:6rem 1fr;gap:.6rem;font-size:.92rem;align-items:start}
.tf-dl dt{font-family:var(--mono);font-size:.68rem;font-weight:500;letter-spacing:.08em;text-transform:uppercase;color:var(--mute);padding-top:.2rem}
.tf-dl dd{margin:0;color:var(--text);overflow-wrap:anywhere}
.tf-change{margin:1rem 0 0;padding-top:.9rem;border-top:1px dashed var(--line)}
.tf-change .tf-mono{color:var(--a);margin-bottom:.3rem}
.tf-change p{margin:0;font-size:.97rem}
.tf-steps{list-style:none;margin:0;padding:0;border-top:1px solid var(--line)}
.tf-step{display:grid;grid-template-columns:2.25rem 1fr;gap:.6rem;padding:.85rem 0;border-bottom:1px solid var(--line);align-items:baseline}
.tf-step-n{font-family:var(--mono);font-size:.8rem;font-weight:500;color:var(--a)}
.tf-step b{display:block;font-weight:600;margin-bottom:.1rem}
.tf-step span{color:var(--text);font-size:.95rem}
.tf-chips{display:flex;flex-wrap:wrap;gap:.5rem;margin:0;padding:0;list-style:none}
.tf-chip{display:inline-flex;align-items:baseline;gap:.5rem;border:1px solid var(--line);background:var(--panel);border-radius:999px;padding:.45rem .85rem;font-size:.9rem;font-weight:500;line-height:1.3}
.tf-chip small{font-family:var(--mono);font-size:.66rem;color:var(--mute);letter-spacing:.02em}
.tf-gaps{margin:1.25rem 0 0;padding:.9rem 1rem;background:var(--panel);border:1px solid var(--line);border-left:3px solid var(--ink);border-radius:8px;font-size:.95rem;color:var(--text)}
.tf-gaps b{color:var(--ink)}
.tf-next{padding:2.5rem 0 0}
.tf-box{background:#fff;background:color-mix(in srgb,var(--a) 6%,#fff);border:1px solid var(--line);border-color:color-mix(in srgb,var(--a) 28%,var(--line));border-radius:12px;padding:1.4rem 1.2rem 1.2rem}
.tf-box h2{margin-bottom:.6rem}
.tf-box p{color:var(--text)}
.tf-cta{margin:1.1rem 0 1.3rem}
.tf-cta .ken-cta{background:var(--a)!important;display:inline-flex!important;align-items:center;min-height:48px;font-family:inherit}
.tf-sign{font-size:.95rem;margin:0}
.tf-sign b{font-weight:600}
.tf-sign span{display:block;color:var(--mute)}
.tf-foot{font-size:.8rem;color:var(--mute);padding:1.75rem 0 2.5rem;max-width:46rem;margin:0}
.is-empty{display:none}
@media (min-width:760px){
body{font-size:17px}
.tf-wrap{padding:0 2.5rem}
.tf-top{padding:1.2rem 0}
.tf-hero{grid-template-columns:minmax(0,1.15fr) minmax(0,.85fr);gap:3.5rem;padding:3.5rem 0 2.5rem;align-items:start}
.tf h1{font-size:3.2rem;margin:1.1rem 0 1.2rem}
.tf-intro{font-size:1.2rem}
.tf-stack{padding:1.2rem 1.4rem 1.1rem}
.tf-sec{padding:3.5rem 0 0}
.tf-head{grid-template-columns:3.5rem 1fr;margin-bottom:1rem}
.tf h2{font-size:2rem}
.tf-lede{margin-left:3.5rem}
.tf-tool{grid-template-columns:14rem minmax(0,1fr) 12rem;gap:1.5rem;align-items:start;padding:1.1rem 0}
.tf-tool-name{display:grid;gap:.3rem;align-items:start;justify-items:start}
.tf-tool .tf-cat{display:block}
.tf-status{margin-top:.3rem;justify-content:flex-start}
.tf-match{padding:1.4rem 1.6rem 1.3rem;display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,.95fr);gap:1.25rem 2.5rem}
.tf-match .tf-wire{grid-column:1 / -1}
.tf-match .tf-dl{padding-top:.2rem}
.tf-match .tf-change{grid-column:1 / -1;margin-top:.2rem}
.tf-steps{display:grid;grid-template-columns:1fr 1fr;column-gap:2.5rem}
.tf-step{grid-template-columns:2.5rem 1fr}
.tf-box{padding:2.2rem 2.4rem 2rem;display:grid;grid-template-columns:minmax(0,1.3fr) minmax(0,1fr);gap:2rem;align-items:start}
.tf-box h2{font-size:1.7rem}
.tf-box-side{padding-top:.3rem}
.tf-cta{margin:0 0 1.2rem}
}
@media (min-width:1100px){.tf h1{font-size:3.5rem}}
</style>
</head>
<body>
<main class="tf">
<div class="tf-wrap">
<header class="tf-top">
{%- if brand.logo_url %}<img class="tf-logo" src="{{ brand.logo_url | escape }}" alt="{{ brand.name | default: 'Logo' | escape }}">{% elsif brand.name %}<span class="tf-brand">{{ brand.name | escape }}</span>{% else %}<span></span>{% endif -%}
<p class="tf-mono">Integration fit for {{ account.name | escape }}</p>
</header>
<section data-section="hero" class="tf-hero">
<div>
<p class="tf-mono tf-kicker">{% if person.first_name %}Prepared for {{ person.first_name | escape }} {{ person.last_name | escape }}{% if person.title %}, {{ person.title | escape }}{% endif %}, {{ account.name | escape }}{% else %}Prepared for {{ account.name | escape }}{% endif %}</p>
<h1>{{ data.headline | escape }}</h1>
<p class="tf-intro">{{ data.intro | escape }}</p>
<p class="tf-by">By <b>{{ sender.name | default: 'our team' | escape }}</b>{% if sender.title %}, {{ sender.title | escape }}{% endif %}{% if brand.name %} at {{ brand.name | escape }}{% endif %}</p>
</div>
{%- if tool_count > 0 %}
<aside class="tf-stack{% if catalog_count == 0 %} no-catalog{% endif %}" aria-label="Your stack, as we guess it">
<p class="tf-mono">Your stack, as we guess it</p>
<div class="tf-stack-body">
<ol>
{%- for t in data.tools %}
<li{% unless catalog contains t.name %} class="is-gap"{% endunless %}><span class="tf-dot"></span><b>{{ t.name | escape }}</b><span class="tf-cat">{{ t.category | escape }}</span></li>
{%- endfor %}
</ol>
<div class="tf-stack-us"><span class="tf-us-mark"></span><span>{{ us | escape }}</span>{% if catalog_count > 0 %}<span class="tf-cat">Connects to {{ match_count }} of {{ tool_count }}</span>{% endif %}</div>
</div>
</aside>
{%- endif %}
</section>
<section data-section="tools" class="tf-sec">
<div class="tf-head"><span class="tf-num">0{{ n }}</span>{%- assign n = n | plus: 1 -%}<h2>What we think you run</h2></div>
{%- if tool_count > 0 %}
<p class="tf-lede">Guessed from {{ account.domain | escape }}{% if data.careers %} and its careers page{% endif %}. Nothing here came from your systems, so a wrong guess costs you one reply.</p>
<ul class="tf-tools">
{%- for t in data.tools %}
<li class="tf-tool{% unless catalog contains t.name %} is-gap{% endunless %}">
<div class="tf-tool-name"><h3>{{ t.name | escape }}</h3><span class="tf-cat">{{ t.category | escape }}</span><span class="tf-tag">Guess</span></div>
<div><p class="tf-clue">{{ t.clue | escape }}</p><p class="tf-mono tf-src">{% if t.source == 'careers' %}Seen on the careers page{% else %}Seen on the website{% endif %}</p></div>
{%- if catalog_count > 0 %}
<p class="tf-mono tf-status">{% if catalog contains t.name %}Connects, see below{% else %}Not in our list yet{% endif %}</p>
{%- endif %}
</li>
{%- endfor %}
</ul>
{%- else %}
<div class="tf-empty">
<p>We could not tell from {{ account.domain | escape }} which tools you run, and we would rather ask than guess. Reply with the two or three systems your team lives in, and this page will show how {{ us | escape }} plugs into each.</p>
</div>
{%- endif %}
</section>
<section data-section="integrations" class="tf-sec{% if match_count == 0 %} is-empty{% endif %}">
{%- if match_count > 0 %}
<div class="tf-head"><span class="tf-num">0{{ n }}</span>{%- assign n = n | plus: 1 -%}<h2>How {{ us | escape }} plugs in</h2></div>
<p class="tf-lede">One block per tool we connect to today. What moves, how it is set up, and what changes for the people who use it.</p>
<div class="tf-matches">
{%- for m in data.matches %}
{%- for i in data.integrations %}
{%- if i.tool == m.tool %}
<article class="tf-match">
<div class="tf-wire"><span class="tf-node">{{ i.tool | escape }}</span><span class="tf-wire-line"></span><span class="tf-node tf-node--us">{{ us | escape }}</span></div>
<div>
<p class="tf-mono tf-conn"><span>{{ i.connection | escape }}</span> &middot; {{ i.category | escape }}</p>
<p class="tf-sum">{{ i.summary | escape }}</p>
</div>
<dl class="tf-dl">
{%- if i.syncs and i.syncs != '' %}
<div><dt>What moves</dt><dd>{{ i.syncs | escape }}</dd></div>
{%- endif %}
{%- if i.setup and i.setup != '' %}
<div><dt>Setup</dt><dd>{{ i.setup | escape }}</dd></div>
{%- endif %}
{%- if i.docs_url contains 'https://' %}
<div><dt>Docs</dt><dd><a href="{{ i.docs_url | escape }}" target="_blank" rel="noopener noreferrer">{{ i.docs_url | remove: 'https://' | escape }}</a></dd></div>
{%- endif %}
</dl>
<div class="tf-change"><p class="tf-mono">What changes for your team</p><p>{{ m.change | escape }}</p></div>
</article>
{%- endif %}
{%- endfor %}
{%- endfor %}
</div>
{%- endif %}
</section>
<section data-section="setup" class="tf-sec{% if setup_count == 0 %} is-empty{% endif %}">
{%- if setup_count > 0 %}
<div class="tf-head"><span class="tf-num">0{{ n }}</span>{%- assign n = n | plus: 1 -%}<h2>Setting it up</h2></div>
<p class="tf-lede">What each connection takes, from our own setup notes. Nothing here needs code on your side.</p>
<ol class="tf-steps">
{%- assign step = 0 -%}
{%- for m in data.matches %}
{%- for i in data.integrations %}
{%- if i.tool == m.tool and i.setup and i.setup != '' %}
{%- assign step = step | plus: 1 %}
<li class="tf-step"><span class="tf-step-n">0{{ step }}</span><div><b>{{ i.tool | escape }}</b><span>{{ i.setup | escape }}</span></div></li>
{%- endif %}
{%- endfor %}
{%- endfor %}
</ol>
{%- endif %}
</section>
{%- assign show_catalog = false -%}
{%- if catalog_count > 0 and other_count > 0 -%}{%- assign show_catalog = true -%}{%- endif -%}
{%- if catalog_count > 0 and gap_count > 0 -%}{%- assign show_catalog = true -%}{%- endif %}
<section data-section="catalog" class="tf-sec{% unless show_catalog %} is-empty{% endunless %}">
{%- if show_catalog %}
<div class="tf-head"><span class="tf-num">0{{ n }}</span>{%- assign n = n | plus: 1 -%}<h2>{% if match_count > 0 %}Also in our list{% else %}What we connect to{% endif %}</h2></div>
{%- if other_count > 0 %}
<p class="tf-lede">{% if match_count > 0 %}The other {{ other_count }} tools {{ us | escape }} connects to, in case one of them is already yours.{% else %}The {{ catalog_count }} tools {{ us | escape }} connects to today.{% endif %}</p>
{%- assign rest = data.integrations | sort: 'category' %}
<ul class="tf-chips">
{%- for i in rest %}
{%- unless matched contains i.tool %}
<li class="tf-chip">{{ i.tool | escape }}<small>{{ i.category | escape }}</small></li>
{%- endunless %}
{%- endfor %}
</ul>
{%- endif %}
{%- if gap_count > 0 %}
<p class="tf-gaps"><b>Not in our list yet:</b> {% assign gi = 0 %}{% for t in data.tools %}{% unless catalog contains t.name %}{% assign gi = gi | plus: 1 %}{% if gi > 1 %}, {% endif %}{{ t.name | escape }}{% endunless %}{% endfor %}. Ask and we will find out what the route is, and say plainly if there is none.</p>
{%- endif %}
{%- endif %}
</section>
<section data-section="next" class="tf-next">
<div class="tf-box">
<div>
<h2>Did we get your stack right?</h2>
<p>{{ data.closing | escape }}</p>
</div>
<div class="tf-box-side">
<div class="tf-cta">{% render 'ken/cta', label: 'Book 20 minutes', kind: 'booking' %}</div>
<p class="tf-sign"><b>{{ sender.name | default: 'Our team' | escape }}</b>{% if sender.title %}<span>{{ sender.title | escape }}{% if brand.name %}, {{ brand.name | escape }}{% endif %}</span>{% elsif brand.name %}<span>{{ brand.name | escape }}</span>{% endif %}</p>
</div>
</div>
<p class="tf-foot">How this page was made: the tools above were guessed from {{ account.domain | escape }}{% if data.careers %} and its careers page{% endif %}. Nothing came from {{ account.name | escape }}'s systems. Integration details come from {{ us | escape }}'s own integration list.</p>
</section>
</div>
</main>
</body>
</html>
