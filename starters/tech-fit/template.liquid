{%- assign accent = brand.colors.primary | default: '#8daa67' -%}
{%- assign accent2 = brand.colors.secondary | default: '#161a17' -%}
{%- assign font_head = brand.fonts.heading | default: 'STIX Two Text' -%}
{%- assign font_body = brand.fonts.body | default: 'STIX Two Text' -%}
{%- assign us = brand.name | default: 'our product' -%}
{%- assign tool_count = data.tools | size -%}
{%- assign match_count = data.matches | size -%}
{%- assign catalog_count = data.integrations | size -%}
{%- assign catalog = data.integrations | map: 'tool' -%}
{%- assign matched = data.matches | map: 'tool' -%}
{%- assign gap_count = tool_count | minus: match_count -%}
{%- assign other_count = catalog_count | minus: match_count -%}
{%- assign setup_count = 0 -%}
{%- for m in data.matches -%}{%- for i in data.integrations -%}{%- if i.tool == m.tool and i.setup and i.setup != '' -%}{%- assign setup_count = setup_count | plus: 1 -%}{%- endif -%}{%- endfor -%}{%- endfor -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex">
<title>{{ data.headline | escape }}</title>
{%- if font_head == 'STIX Two Text' %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=STIX+Two+Text:ital,wght@0,400;0,600;0,700;1,400&display=swap">
{%- else %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_head | url_encode }}&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_head | url_encode }}:wght@700&display=swap">
{%- endif %}
{%- if font_body != font_head %}
{%- if font_body == 'STIX Two Text' %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=STIX+Two+Text:ital,wght@0,400;0,600;0,700;1,400&display=swap">
{%- else %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_body | url_encode }}&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_body | url_encode }}:wght@700&display=swap">
{%- endif %}
{%- endif %}
<style>
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:#f4f5f1;color:#161a17;font-family:'{{ font_body }}',Georgia,'Times New Roman',serif;font-size:18px;line-height:1.5;-webkit-font-smoothing:antialiased}
.tf{--a:{{ accent }};--a2:{{ accent2 }};--ink:#161a17;--soft:#4a504b;--paper:#f4f5f1;--tone:#e4e7df;--rule:#c9cec4;
--on-a:#161a17;--on-a:color(from var(--a) xyz-d65 clamp(0,(.18 - y) * 1000000,.9505) clamp(0,(.18 - y) * 1000000,1) clamp(0,(.18 - y) * 1000000,1.089));
--on-a2:#f4f5f1;--on-a2:color(from var(--a2) xyz-d65 clamp(0,(.18 - y) * 1000000,.9505) clamp(0,(.18 - y) * 1000000,1) clamp(0,(.18 - y) * 1000000,1.089));
--mark:{{ accent }};--mark:oklch(from var(--a) min(l,0.45) c h);
--m:clamp(1.125rem,3vw,2.5rem);--ly:2rem;overflow-x:clip}
.tf h1,.tf h2,.tf h3,.nm,.step-n{font-family:'{{ font_head }}',Georgia,'Times New Roman',serif;font-weight:600;letter-spacing:-.01em;line-height:1.1;text-wrap:balance;margin:0}
.tf p{margin:0}
.tf ul,.tf ol{margin:0;padding:0;list-style:none}
.tf a{color:var(--ink);text-decoration-color:var(--a);text-decoration-thickness:2px;text-underline-offset:.2em}
.tf a:focus-visible,.tf .ken-cta:focus-visible{outline:3px solid var(--ink);outline-offset:3px}
.tf i,.tf em{font-style:italic}
.wrap{padding:0 var(--m);max-width:84rem;margin:0 auto}
.top{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:1.1rem 0;border-bottom:2px solid var(--ink)}
.logo{height:26px;width:auto;display:block}
.brand{font-weight:700;font-size:1rem}
.tag{font-size:1rem;font-style:italic;color:var(--soft);text-align:right}
.hero-head{display:grid;gap:1.2rem;padding:2rem 0 2.4rem}
.hero h1{font-size:2rem}
.intro{font-size:1.125rem;max-width:36rem}
.for{font-size:1rem;color:var(--soft);margin-top:.9rem!important}
.for b{color:var(--ink);font-weight:600}
.btn{margin:1.4rem 0 0}
.btn .ken-cta{display:inline-flex!important;align-items:center;min-height:52px;padding:.85rem 1.6rem!important;border-radius:999px!important;background:var(--a2)!important;color:var(--on-a2)!important;font-family:inherit;font-size:1rem;font-weight:600!important;text-decoration:none}
.btn .ken-cta:hover{background:var(--a)!important;color:var(--on-a)!important}
.strip{position:relative;padding:0 0 1.6rem}
.line{position:relative;display:grid;padding:.4rem 0}
.line::before{content:'';position:absolute;left:calc(1.2rem - 6px);top:0;bottom:0;width:12px;background:var(--a);border-radius:6px}
.no-catalog .line::before{background:var(--rule)}
.stop{position:relative;display:grid;gap:.1rem;padding:.75rem 0 .75rem 3.4rem;min-height:3.4rem}
.stop::before{content:'';position:absolute;left:calc(1.2rem - 11px);top:1.05rem;width:22px;height:22px;border-radius:50%;background:#fff;border:4px solid var(--ink);z-index:1}
.stop.off{padding-left:5.2rem}
.stop.off::before{left:3rem;background:var(--paper);border:3px dashed var(--soft)}
.stop.off::after{content:'';position:absolute;left:1.2rem;top:calc(1.05rem + 10px);width:1.8rem;border-top:3px dashed var(--soft)}
.stop.us::before{width:30px;height:30px;left:calc(1.2rem - 15px);top:.85rem;border-radius:7px;background:var(--a2);border:4px solid var(--a2)}
.nm{font-size:1.25rem}
.stop.off .nm{color:var(--soft);font-weight:400;font-style:italic}
.ct{font-size:1rem;font-style:italic;color:var(--soft)}
.key{display:flex;flex-wrap:wrap;gap:.5rem 1.6rem;font-size:1rem;color:var(--soft);margin-top:1rem!important}
.key b{color:var(--ink);font-weight:600}
.key span{display:inline-flex;align-items:center;gap:.5rem}
.key i{display:inline-block;width:16px;height:16px;border-radius:50%;background:#fff;border:3px solid var(--ink);font-style:normal}
.key .k-off i{background:var(--paper);border:2px dashed var(--soft)}
.sec{padding:4rem 0 0}
.sec.is-empty{display:none}
.tf h2{font-size:2rem;margin:0 0 .8rem}
.lede{font-size:1.125rem;color:var(--soft);max-width:40rem}
.lede+*{margin-top:1.8rem!important}
.tools{border-top:2px solid var(--ink)}
.tool{display:grid;gap:.5rem;padding:1.2rem 0 1.3rem;border-bottom:1px solid var(--rule)} /* taste-skill-ignore: data rows */
.tool h3{font-size:1.25rem}
.tool .ct{display:block;margin-top:.2rem}
.clue{font-size:1.125rem}
.src{font-size:1rem;font-style:italic;color:var(--soft);margin-top:.3rem!important}
.status{display:flex;align-items:center;gap:.6rem;font-size:1rem;font-weight:600}
.status::before{content:'';flex:none;width:16px;height:16px;border-radius:50%;background:#fff;border:3px solid var(--ink);box-sizing:border-box}
.status.on{color:var(--mark)}
.status.on::before{border-color:var(--ink);background:var(--a)}
.status.off{color:var(--soft);font-weight:400;font-style:italic}
.status.off::before{background:transparent;border:2px dashed var(--soft)}
.empty{background:#fff;padding:1.4rem;font-size:1.125rem;max-width:44rem}
.match{padding:1.8rem 0 2rem;border-top:2px solid var(--ink);display:grid;gap:1.2rem}
.wire{display:flex;align-items:center;gap:.8rem;flex-wrap:wrap}
.wire h3{font-size:1.5rem}
.w-line{flex:1 1 3rem;min-width:3rem;height:10px;border-radius:5px;background:var(--a);position:relative}
.w-line::before,.w-line::after{content:'';position:absolute;top:50%;width:18px;height:18px;margin-top:-9px;border-radius:50%;background:#fff;border:3px solid var(--ink);box-sizing:border-box}
.w-line::before{left:-4px}.w-line::after{right:-4px}
.w-us{font-size:1rem;font-weight:600}
.conn{font-size:1rem;margin-top:.6rem!important}
.conn b{font-weight:600}
.conn span{font-style:italic;color:var(--soft)}
.sum{font-size:1.125rem}
.facts{margin:0;display:grid;gap:.6rem}
.facts div{display:grid;grid-template-columns:7rem minmax(0,1fr);gap:.8rem;font-size:1rem;padding-top:.6rem;border-top:1px solid var(--rule)} /* taste-skill-ignore: data rows */
.facts dt{font-style:italic;color:var(--soft)}
.facts dd{margin:0;overflow-wrap:anywhere}
.change{background:var(--tone);padding:1rem 1.2rem;font-size:1rem}
.change p+p{margin-top:.3rem!important}
.change .ch-h{font-weight:600}
.steps{display:grid;border-top:2px solid var(--ink);padding-top:.4rem}
.step{display:grid;grid-template-columns:3rem minmax(0,1fr);gap:.8rem;padding:1.1rem 0}
.step-n{font-size:2rem;line-height:1;color:var(--mark);font-variant-numeric:oldstyle-nums}
.step b{display:block;font-weight:600;font-size:1.125rem}
.step span{display:block;font-size:1rem}
.cat{columns:2 10rem;column-gap:2rem}
.cat li{break-inside:avoid;padding:.55rem 0 .55rem 1.3rem;position:relative;font-size:1rem;font-weight:600}
.cat li::before{content:'';position:absolute;left:0;top:1.05rem;width:.75rem;height:5px;border-radius:3px;background:var(--a)}
.cat small{display:block;font-size:1rem;font-weight:400;font-style:italic;color:var(--soft)}
.gaps{margin-top:2rem!important;padding:1.1rem 1.3rem;border-left:4px dashed var(--soft);background:#fff;font-size:1rem;max-width:44rem}
.gaps b{font-weight:600}
.next{margin-top:4.5rem;background:var(--a);color:var(--on-a);padding:3.4rem 0 2.6rem}
.next-in{display:grid;gap:1.4rem}
.next h2{font-size:2rem}
.next p{font-size:1.125rem;max-width:36rem}
.next .btn{margin:.4rem 0 1.2rem}
.next .btn .ken-cta:hover{background:var(--paper)!important;color:var(--ink)!important}
.sign{font-size:1rem}
.sign b{font-weight:600}
.sign span{display:block}
.foot{font-size:1rem;font-style:italic;max-width:46rem;padding-top:2.4rem}
.vh{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
@media (prefers-reduced-motion:no-preference){
.line::before{animation:tf-run 1.1s cubic-bezier(.5,0,.2,1) both;transform-origin:top}
.stop::before{animation:tf-stop .4s .8s ease-out both}
@keyframes tf-run{from{transform:scaleY(0)}}
@keyframes tf-stop{from{transform:scale(.4);opacity:0}}
}
@media (min-width:860px){
body{font-size:19px}
.hero-head{padding:2.6rem 0 3.4rem}
.hero-head>div{display:grid;grid-template-columns:minmax(0,7fr) minmax(0,5fr);column-gap:3.5rem;align-items:start}
.intro{grid-row:1 / 3;font-size:1.25rem}
.for{margin-top:.2rem!important}
.hero h1{font-size:3rem}
.strip{--ly:10.5rem;padding:0 0 2.4rem}
.line{grid-auto-flow:column;grid-auto-columns:minmax(0,1fr);padding:0 5rem 0 0}
.line::before{left:0;right:0;top:calc(var(--ly) - 8px);bottom:auto;width:auto;height:16px;border-radius:8px;transform-origin:left}
.stop{display:block;min-height:0;height:calc(var(--ly) + 5rem);padding:0}
.stop::before{left:calc(50% - 16px);top:calc(var(--ly) - 16px);width:32px;height:32px;border-width:5px}
.stop.off{padding:0}
.stop.off::before{left:calc(50% - 16px);top:calc(var(--ly) + 1.9rem);border-width:3px}
.stop.off::after{left:calc(50% - 1px);top:calc(var(--ly) + 8px);width:0;height:calc(1.9rem - 8px);border-top:0;border-left:3px dashed var(--soft)}
.stop.us::before{left:calc(50% - 22px);top:calc(var(--ly) - 22px);width:44px;height:44px;border-radius:9px}
.nm{position:absolute;left:calc(50% - .1rem);bottom:calc(100% - var(--ly) + 1.4rem);transform-origin:left bottom;transform:rotate(-38deg);white-space:nowrap;font-size:2rem}
.stop.us .nm{font-weight:700}
.stop .ct{position:absolute;left:.3rem;right:.3rem;top:calc(var(--ly) + 1.7rem);text-align:center;line-height:1.25}
.stop.off .ct{top:calc(var(--ly) + 4rem)}
.line:has(.off) .stop{height:calc(var(--ly) + 7rem)}
.key{margin-top:1.4rem!important}
.sec{padding-top:5.5rem}
.tf h2{font-size:3rem}
.lede{font-size:1.25rem}
.tool{grid-template-columns:16rem minmax(0,1fr) 13rem;gap:2rem;align-items:start}
.status{margin-top:.2rem}
.match{grid-template-columns:minmax(0,5fr) minmax(0,7fr);grid-template-rows:auto 1fr;grid-template-areas:"h r" "c r";column-gap:3.5rem;padding:2.2rem 0 2.6rem}
.match>div:first-child{grid-area:h}
.match-r{grid-area:r}
.change{grid-area:c;align-self:start}
.match-r{display:grid;gap:1.2rem}
.steps{grid-template-columns:1fr 1fr;column-gap:3rem}
.cat{columns:3 12rem}
.next{margin-top:6rem;padding:5rem 0 3rem}
.next-in{grid-template-columns:minmax(0,7fr) minmax(0,5fr);column-gap:4rem;align-items:end}
.next h2{font-size:3rem}
.foot{grid-column:1 / -1}
}
@media (min-width:1100px){
.hero h1{font-size:3.5rem}
}
</style>
</head>
<body>
<main class="tf">
<div class="wrap">
<header class="top">
{%- if brand.logo_url %}<img class="logo" src="{{ brand.logo_url | escape }}" alt="{{ brand.name | default: 'Logo' | escape }}">{% elsif brand.name %}<p class="brand">{{ brand.name | escape }}</p>{% else %}<span></span>{% endif -%}
<p class="tag">Integration fit for {{ account.name | escape }}</p>
</header>
<section data-section="hero" class="hero">
<div class="hero-head">
<h1>{{ data.headline | escape }}</h1>
<div>
<p class="intro">{{ data.intro | escape }}</p>
<p class="for">{% if person.first_name %}Prepared for <b>{{ person.first_name | escape }} {{ person.last_name | escape }}</b>{% if person.title %}, {{ person.title | escape }}{% endif %}, {{ account.name | escape }}{% else %}Prepared for <b>{{ account.name | escape }}</b>{% endif %}, by {{ sender.name | default: 'our team' | escape }}{% if sender.title %}, {{ sender.title | escape }}{% endif %}{% if brand.name %} at {{ brand.name | escape }}{% endif %}</p>
<div class="btn">{% render 'ken/cta', label: 'Book 20 minutes', kind: 'booking', id: 'hero' %}</div>
</div>
</div>
{%- if tool_count > 0 %}
<div class="strip{% if catalog_count == 0 %} no-catalog{% endif %}">
<ol class="line" aria-label="Your stack, as we guess it, on the {{ us | escape }} line">
<li class="stop us"><span class="nm">{{ us | escape }}</span></li>
{%- for t in data.tools %}
{%- if catalog_count > 0 %}{% if catalog contains t.name %}{% assign st = 'on' %}{% else %}{% assign st = 'off' %}{% endif %}{% else %}{% assign st = 'unk' %}{% endif %}
<li class="stop {{ st }}"><span class="nm">{{ t.name | escape }}</span><span class="ct">{{ t.category | escape }}{% if st == 'off' %}<span class="vh">, not in our list yet</span>{% endif %}</span></li>
{%- endfor %}
</ol>
<p class="key">{% if catalog_count > 0 %}<span><i></i>On the line: connects today</span><span class="k-off"><i></i>Off the line: not in our list yet</span><b>Connects to {{ match_count }} of {{ tool_count }}</b>{% else %}<span>Your stack, as we guess it. Not matched to our integration list yet.</span>{% endif %}</p>
</div>
{%- endif %}
</section>
<section data-section="tools" class="sec">
<h2>What we think you run</h2>
{%- if tool_count > 0 %}
<p class="lede">Guessed from {{ account.domain | escape }}{% if data.careers %} and its careers page{% endif %}. Nothing here came from your systems, so a wrong guess costs you one reply.</p>
<ul class="tools">
{%- for t in data.tools %}
<li class="tool">
<div><h3>{{ t.name | escape }}</h3><span class="ct">{{ t.category | escape }}</span></div>
<div><p class="clue">{{ t.clue | escape }}</p><p class="src">A guess, {% if t.source == 'careers' %}seen on the careers page{% else %}seen on the website{% endif %}</p></div>
{%- if catalog_count > 0 %}
{%- if catalog contains t.name %}
<p class="status on">Connects, see below</p>
{%- else %}
<p class="status off">Not in our list yet</p>
{%- endif %}
{%- endif %}
</li>
{%- endfor %}
</ul>
{%- else %}
<p class="empty">We could not tell from {{ account.domain | escape }} which tools you run, and we would rather ask than guess. Reply with the two or three systems your team lives in, and this page will show how {{ us | escape }} plugs into each.</p>
{%- endif %}
</section>
<section data-section="integrations" class="sec{% if match_count == 0 %} is-empty{% endif %}">
{%- if match_count > 0 %}
<h2>How {{ us | escape }} plugs in</h2>
<p class="lede">One block per tool we connect to today. What moves, how it is set up, and what changes for the people who use it.</p>
<div>
{%- for m in data.matches %}
{%- for i in data.integrations %}
{%- if i.tool == m.tool %}
<article class="match">
<div>
<div class="wire"><h3>{{ i.tool | escape }}</h3><span class="w-line" aria-hidden="true"></span><span class="w-us">{{ us | escape }}</span></div>
<p class="conn"><b>{{ i.connection | escape }}</b> <span>{{ i.category | escape }}</span></p>
</div>
<div class="match-r">
<p class="sum">{{ i.summary | escape }}</p>
<dl class="facts">
{%- if i.syncs and i.syncs != '' %}
<div><dt>What moves</dt><dd>{{ i.syncs | escape }}</dd></div>
{%- endif %}
{%- if i.setup and i.setup != '' %}
<div><dt>Setup</dt><dd>{{ i.setup | escape }}</dd></div>
{%- endif %}
{%- if i.docs_url contains 'https://' %}
<div><dt>Docs</dt><dd><a href="{{ i.docs_url | escape }}" target="_blank" rel="noopener noreferrer">{{ i.docs_url | remove: 'https://' | escape }}</a></dd></div>
{%- endif %}
</dl>
</div>
<div class="change"><p class="ch-h">What changes for your team</p><p>{{ m.change | escape }}</p></div>
</article>
{%- endif %}
{%- endfor %}
{%- endfor %}
</div>
{%- endif %}
</section>
<section data-section="setup" class="sec{% if setup_count == 0 %} is-empty{% endif %}">
{%- if setup_count > 0 %}
<h2>Setting it up</h2>
<p class="lede">What each connection takes, from our own setup notes. Nothing here needs code on your side.</p>
<ol class="steps">
{%- assign step = 0 -%}
{%- for m in data.matches %}
{%- for i in data.integrations %}
{%- if i.tool == m.tool and i.setup and i.setup != '' %}
{%- assign step = step | plus: 1 %}
<li class="step"><span class="step-n">{{ step }}</span><div><b>{{ i.tool | escape }}</b><span>{{ i.setup | escape }}</span></div></li>
{%- endif %}
{%- endfor %}
{%- endfor %}
</ol>
{%- endif %}
</section>
{%- assign show_catalog = false -%}
{%- if catalog_count > 0 and other_count > 0 -%}{%- assign show_catalog = true -%}{%- endif -%}
{%- if catalog_count > 0 and gap_count > 0 -%}{%- assign show_catalog = true -%}{%- endif %}
<section data-section="catalog" class="sec{% unless show_catalog %} is-empty{% endunless %}">
{%- if show_catalog %}
<h2>{% if match_count > 0 %}Also in our list{% else %}What we connect to{% endif %}</h2>
{%- if other_count > 0 %}
<p class="lede">{% if match_count > 0 %}The other {{ other_count }} tools {{ us | escape }} connects to, in case one of them is already yours.{% else %}The {{ catalog_count }} tools {{ us | escape }} connects to today.{% endif %}</p>
{%- assign rest = data.integrations | sort: 'category' %}
<ul class="cat">
{%- for i in rest %}
{%- unless matched contains i.tool %}
<li>{{ i.tool | escape }}<small>{{ i.category | escape }}</small></li>
{%- endunless %}
{%- endfor %}
</ul>
{%- endif %}
{%- if gap_count > 0 %}
<p class="gaps"><b>Not in our list yet:</b> {% assign gi = 0 %}{% for t in data.tools %}{% unless catalog contains t.name %}{% assign gi = gi | plus: 1 %}{% if gi > 1 %}, {% endif %}{{ t.name | escape }}{% endunless %}{% endfor %}. Ask and we will find out what the route is, and say plainly if there is none.</p>
{%- endif %}
{%- endif %}
</section>
</div>
<section data-section="next" class="next">
<div class="wrap next-in">
<div>
<h2>Did we get your stack right?</h2>
</div>
<div>
<p>{{ data.closing | escape }}</p>
<div class="btn">{% render 'ken/cta', label: 'Book 20 minutes', kind: 'booking' %}</div>
<p class="sign"><b>{{ sender.name | default: 'Our team' | escape }}</b>{% if sender.title %}<span>{{ sender.title | escape }}{% if brand.name %}, {{ brand.name | escape }}{% endif %}</span>{% elsif brand.name %}<span>{{ brand.name | escape }}</span>{% endif %}</p>
</div>
<p class="foot">How this page was made: the tools above were guessed from {{ account.domain | escape }}{% if data.careers %} and its careers page{% endif %}. Nothing came from {{ account.name | escape }}'s systems. Integration details come from {{ us | escape }}'s own integration list.</p>
</div>
</section>
</main>
</body>
</html>
