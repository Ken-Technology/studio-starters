{%- assign accent = brand.colors.primary | default: '#351a2b' -%}
{%- assign accent2 = brand.colors.secondary | default: '#edccbe' -%}
{%- if brand.colors.secondary -%}{%- assign ground_mix = '22%' -%}{%- else -%}{%- assign ground_mix = '100%' -%}{%- endif -%}
{%- assign font_head = brand.fonts.heading | default: 'Brygada 1918' -%}
{%- assign font_body = brand.fonts.body | default: font_head -%}
{%- assign short_name = account.name | split: ' - ' | first | split: ' | ' | first | strip | default: account.name -%}
{%- assign industry = account.industry | default: 'your industry' -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex">
<title>A trend brief for {{ short_name | escape }}</title>
{%- if font_head == 'Brygada 1918' %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Brygada+1918:wght@400;600;700&display=swap">
{%- else %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_head | url_encode }}&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_head | url_encode }}:wght@700&display=swap">
{%- endif %}
{%- if font_body != font_head %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_body | url_encode }}&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_body | url_encode }}:wght@700&display=swap">
{%- endif %}
<style>
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:#edccbe}
.tb{--p:{{ accent }};--s:{{ accent2 }};--g:color-mix(in oklab,var(--s) {{ ground_mix }},#fff);--ink:#2a1422;--ink:oklch(from var(--p) min(l, 0.28) min(c, 0.06) h);--on:#efd9cf;--on:color(from var(--p) xyz-d65 clamp(0,(.18 - y) * 1000000,.9505) clamp(0,(.18 - y) * 1000000,1) clamp(0,(.18 - y) * 1000000,1.089));--fh:'{{ font_head }}',Georgia,'Times New Roman',serif;--fb:'{{ font_body }}',Georgia,'Times New Roman',serif;--m:clamp(1.25rem,2.6vw,2.5rem);min-height:100vh;background:var(--g);color:var(--ink);font-family:var(--fb);font-size:1.125rem;line-height:1.55;-webkit-font-smoothing:antialiased}
.tb p{margin:0}
.tb h1,.tb h2{font-family:var(--fh);margin:0;text-wrap:balance}
.wrap{max-width:84rem;margin:0 auto;padding:0 var(--m)}
.field{background:var(--p);color:var(--on)}
.top{display:flex;align-items:baseline;justify-content:space-between;gap:1rem;padding:1.1rem var(--m) 1rem;font-size:.875rem}
.logo{height:26px;width:auto;display:block}
.mark{font-family:var(--fh);font-weight:700;font-size:1.375rem;line-height:1}
.mast{padding:2.5rem 0 2.75rem}
.tb h1{font-weight:700;font-size:clamp(2rem,7vw,3.5rem);line-height:1.04;letter-spacing:-.02em;max-width:16ch}
.bar{display:block;height:1.1rem;margin-top:2rem;background:color-mix(in oklab,var(--on) 22%,var(--p))}
.cover-text{display:grid;gap:1rem;padding:2.25rem 0 3rem;max-width:38rem;font-size:1.375rem;line-height:1.4}
.next{padding:3rem 0 3.5rem}
.next h2{font-weight:700;font-size:clamp(1.75rem,5vw,2.5rem);line-height:1.08;max-width:16ch;margin-bottom:1rem}
.next p{max-width:34rem}
.cta{margin:1.5rem 0 1.75rem}
.cta .ken-cta{display:inline-block!important;min-height:52px;padding:15px 26px!important;border-radius:0!important;background:var(--on)!important;color:var(--p)!important;font-family:var(--fh);font-weight:700!important;font-size:1.125rem;line-height:22px}
.cta .ken-cta:focus-visible{outline:3px solid currentColor;outline-offset:3px}
.sign{font-family:var(--fh)}
.sign b{display:block;font-weight:700;font-size:1.375rem;line-height:1.2}
</style>
</head>
<body>
<main class="tb">
<header class="top">
{%- if brand.logo_url %}
<img class="logo" src="{{ brand.logo_url | escape }}" alt="{{ brand.name | default: 'Logo' | escape }}">
{%- elsif brand.name %}
<p class="mark">{{ brand.name | escape }}</p>
{%- else %}
<span></span>
{%- endif %}
<p>Trend brief on {{ industry | escape }}</p>
</header>
<section data-section="cover" class="cover">
<div class="mast field">
<div class="wrap">
<h1>A trend brief for {{ short_name | escape }}</h1>
<div class="bar" role="img" aria-label="The count is not on this page yet"></div>
</div>
</div>
<div class="wrap">
<div class="cover-text">
<p>Hi {{ person.first_name | default: 'there' | escape }}, I am pulling three counts on {{ industry | escape }} right now: how many companies are hiring fast, raising money, growing or moving up a size band, and what each one means for {{ short_name | escape }}.</p>
<p>The counts are not on this page yet.</p>
</div>
</div>
</section>
<section data-section="next" class="next field">
<div class="wrap">
<h2>Rather talk it through now?</h2>
<p>Twenty minutes and I will walk you through the three counts myself, with the names behind them.</p>
<div class="cta">{% render 'ken/cta', label: 'Book 20 minutes', kind: 'booking', color: accent %}</div>
<p class="sign"><b>{{ sender.name | default: 'Our team' | escape }}</b>{% if sender.title %}{{ sender.title | escape }}{% if brand.name %}, {{ brand.name | escape }}{% endif %}{% elsif brand.name %}{{ brand.name | escape }}{% endif %}</p>
</div>
</section>
</main>
</body>
</html>
