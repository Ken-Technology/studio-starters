{%- assign accent = brand.colors.primary | default: '#351a2b' -%}
{%- assign accent2 = brand.colors.secondary | default: '#edccbe' -%}
{%- if brand.colors.secondary -%}{%- assign ground_mix = '22%' -%}{%- else -%}{%- assign ground_mix = '100%' -%}{%- endif -%}
{%- assign font_head = brand.fonts.heading | default: 'Brygada 1918' -%}
{%- assign font_body = brand.fonts.body | default: font_head -%}
{%- assign short_name = account.name | split: ' - ' | first | split: ' | ' | first | strip | default: account.name -%}
{%- assign industry = account.industry | default: 'your industry' -%}
{%- assign base = data.counts[0].value | default: 0 -%}
{%- comment %} The counts as text with thousands commas: n0 is the baseline, n1 to n3 the three trends. {% endcomment -%}
{%- for c in data.counts limit: 4 -%}
{%- assign v = c.value | default: 0 | round -%}
{%- capture f -%}
{%- if v >= 1000 -%}
{%- assign k = v | divided_by: 1000.0 | floor -%}
{%- assign r = v | modulo: 1000 -%}
{%- if k >= 1000 -%}
{%- assign kk = k | divided_by: 1000.0 | floor -%}
{%- assign kr = k | modulo: 1000 -%}
{{ kk }},{% if kr < 10 %}00{% elsif kr < 100 %}0{% endif %}{{ kr }},{% if r < 10 %}00{% elsif r < 100 %}0{% endif %}{{ r }}
{%- else -%}
{{ k }},{% if r < 10 %}00{% elsif r < 100 %}0{% endif %}{{ r }}
{%- endif -%}
{%- else -%}
{{ v }}
{%- endif -%}
{%- endcapture -%}
{%- case forloop.index0 %}{% when 0 %}{% assign n0 = f %}{% when 1 %}{% assign n1 = f %}{% when 2 %}{% assign n2 = f %}{% else %}{% assign n3 = f %}{% endcase -%}
{%- endfor -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex">
<title>{{ data.headline | escape }}</title>
{%- if font_head == 'Brygada 1918' %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Brygada+1918:wght@400;600;700&display=swap">
{%- else %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_head | url_encode }}&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_head | url_encode }}:wght@700&display=swap">
{%- endif %}
{%- if font_body != font_head %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_body | url_encode }}&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_body | url_encode }}:wght@700&display=swap">
{%- endif %}
<style>
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:#edccbe;-webkit-print-color-adjust:exact;print-color-adjust:exact}
.tb{--p:{{ accent }};--s:{{ accent2 }};--g:color-mix(in oklab,var(--s) {{ ground_mix }},#fff);--ink:#2a1422;--ink:oklch(from var(--p) min(l, 0.28) min(c, 0.06) h);--soft:color-mix(in oklab,var(--ink) 80%,var(--g));--on:#efd9cf;--on:oklch(from var(--p) clamp(0.2, (0.6 - l) * 100, 0.9) 0.035 h);--track:color-mix(in oklab,var(--p) 16%,var(--g));--fh:'{{ font_head }}',Georgia,'Times New Roman',serif;--fb:'{{ font_body }}',Georgia,'Times New Roman',serif;--m:clamp(1.25rem,2.6vw,2.5rem);background:var(--g);color:var(--ink);font-family:var(--fb);font-size:1.125rem;line-height:1.55;-webkit-font-smoothing:antialiased;font-variant-numeric:lining-nums tabular-nums}
.tb p{margin:0}
.tb h1,.tb h2,.tb h3{font-family:var(--fh);margin:0;text-wrap:balance}
.tb a{color:inherit;text-decoration-thickness:.07em;text-underline-offset:.18em}
.tb a:focus-visible{outline:3px solid currentColor;outline-offset:3px}
.wrap{max-width:84rem;margin:0 auto;padding:0 var(--m)}
.field{background:var(--p);color:var(--on);--track:color-mix(in oklab,var(--on) 22%,var(--p))}
.top{display:flex;align-items:baseline;justify-content:space-between;gap:1rem;padding:1.1rem var(--m) 1rem;font-size:.875rem;line-height:1.4}
.logo{height:26px;width:auto;display:block}
.mark{font-family:var(--fh);font-weight:700;font-size:1.375rem;line-height:1}
.kind{color:var(--soft);text-align:right}
.mast-in{max-width:84rem;margin:0 auto;display:grid;gap:1.75rem;padding:2rem var(--m) 2.25rem}
.tb .whole{font-weight:600;font-size:clamp(4rem,17vw,7.5rem);line-height:.9;letter-spacing:-.035em;text-wrap:wrap}
.whole-of{display:block;font-family:var(--fh);font-weight:400;font-size:1.125rem;line-height:1.3;letter-spacing:0;margin-top:.6rem}
.cuts{list-style:none;margin:0;padding:0;display:grid;gap:1.25rem}
.cut{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:.15rem 1rem;align-items:baseline}
.cut b{font-weight:600}
.cut span{white-space:nowrap}
.bar{grid-column:1 / -1;height:1.1rem;background:var(--track);position:relative;overflow:hidden}
.bar i{position:absolute;left:0;top:0;bottom:0;background:currentColor;min-width:3px}
.cover-text{display:grid;gap:1.75rem;padding:2.25rem 0 3.5rem}
.headline{font-family:var(--fh);font-weight:700;font-size:1.5rem;line-height:1.12;letter-spacing:-.015em;max-width:24ch;text-wrap:balance}
.dek{font-size:1.375rem;line-height:1.4;max-width:36rem;margin-top:1.25rem!important}
.made{display:grid;gap:.6rem;align-content:start;max-width:24rem}
.sec{padding:4.5rem 0}
.sec h2{font-weight:700;font-size:clamp(1.25rem,4.6vw,2.5rem);line-height:1.1;letter-spacing:-.015em;max-width:34ch}
.grid{display:grid;gap:1.5rem}
.count{font-family:var(--fh);font-weight:600;font-size:clamp(4rem,17vw,7.5rem);line-height:.9;letter-spacing:-.035em}
.of{font-size:1.125rem;margin-top:.6rem!important}
.trend .bar{display:block;height:1.4rem}
.share{font-size:1.375rem;line-height:1.35;max-width:22ch}
.share b{font-weight:700}
.how{margin-top:2rem}
.how p+p{margin-top:.5rem}
.small{font-size:.875rem;line-height:1.45}
.tb h3{font-weight:700;font-size:1.125rem;line-height:1.3;margin-bottom:.35rem}
.prose{display:grid;gap:1.75rem;align-content:start}
.prose p{max-width:40rem}
.next .prose{gap:0}
.wide .bar{height:2.25rem}
.so{font-size:1.375rem;line-height:1.45;max-width:34rem}
.next .prose h3{margin-top:2rem}
.next h2{margin-bottom:.5rem}
.tb .next h2{font-size:clamp(2rem,6vw,3.5rem);line-height:1;max-width:12ch}
.cta{margin:1.75rem 0 1.75rem}
.cta .ken-cta{display:inline-block!important;min-height:52px;padding:15px 26px!important;border-radius:0!important;background:var(--on)!important;color:var(--p)!important;font-family:var(--fh);font-weight:700!important;font-size:1.125rem;line-height:22px}
.cta .ken-cta:hover{background:var(--g)!important}
.print-only{display:none}
.sign{font-family:var(--fh)}
.sign b{display:block;font-family:var(--fh);font-weight:700;font-size:1.375rem;line-height:1.2}
.method{padding:2.5rem 0 3rem;max-width:34rem}
.method b{font-weight:700}
@media (prefers-reduced-motion:no-preference){
.mast .bar i{transform-origin:left center;animation:cut .9s cubic-bezier(.2,.7,.2,1) .15s both}
.mast .cut:nth-child(2) .bar i{animation-delay:.27s}
.mast .cut:nth-child(3) .bar i{animation-delay:.39s}
@keyframes cut{from{transform:scaleX(0)}to{transform:none}}
}
@media (min-width:760px){
.mast-in{grid-template-columns:minmax(0,42fr) minmax(0,58fr);gap:0;padding:4rem var(--m) 4rem;align-items:end}
.cuts{padding-left:2.5rem}
.whole-of{font-size:1.375rem;max-width:20ch}
.sec{padding:6.5rem 0}
.headline{font-size:2rem}
}
@media (min-width:1000px){
.cover-text{grid-template-columns:minmax(0,42fr) minmax(0,58fr);gap:0;padding:3rem 0 5rem}
.cover-text .lead{grid-column:2;grid-row:1}
.headline{font-size:2.25rem;max-width:30ch}
.cover-text .made{grid-column:1;grid-row:1;padding-right:2.5rem;padding-top:.6rem}
.grid{grid-template-columns:minmax(0,42fr) minmax(0,58fr);grid-template-rows:auto auto 1fr;gap:1.25rem 0}
.grid>h2{grid-column:2;grid-row:1;align-self:end}
.grid>.num{grid-column:1;grid-row:1}
.grid>.bar{grid-column:1;grid-row:2;margin-right:3.5rem}
.grid>.txt{grid-column:1;grid-row:3;padding-right:3.5rem}
.grid>.prose{grid-column:2;grid-row:2 / span 2}
.wide .grid>.bar{grid-column:1 / -1;margin:1rem 0 1.5rem}
.wide .grid>.prose{grid-row:3;grid-template-columns:1fr 1fr;gap:2.5rem}
.next .grid>h2{grid-column:1;grid-row:1 / span 2;align-self:start;padding-right:2rem}
.next .grid>.prose{grid-column:2;grid-row:1 / span 3}
}
@media print{
@page{margin:14mm 15mm}
.tb{font-size:11pt}
.wrap{max-width:none;padding:0}
.mast-in{padding:9mm}
.cover-text{padding:7mm 0 0}
.sec{break-before:page;padding:6mm 0}
.field.sec{padding:9mm}
.tb .count,.tb .whole{font-size:40pt}
.cta{display:none}
.print-only{display:block}
.method{break-inside:avoid;padding:6mm 0 0}
}
</style>
</head>
<body>
<main class="tb">
<header class="top wrap">
{%- if brand.logo_url %}
<img class="logo" src="{{ brand.logo_url | escape }}" alt="{{ brand.name | default: 'Logo' | escape }}">
{%- elsif brand.name %}
<p class="mark">{{ brand.name | escape }}</p>
{%- else %}
<span></span>
{%- endif %}
<p class="kind">Trend brief on {{ industry | escape }}</p>
</header>
<section data-section="cover" class="cover">
<div class="mast field">
<div class="mast-in">
<div>
<h1 class="whole">{{ n0 }}<span class="whole-of"> companies in {{ industry | escape }}</span></h1>
</div>
<ul class="cuts" aria-label="The three trends">
{%- for t in data.trends limit: 3 %}
{%- assign c = data.counts[forloop.index] %}
{%- case forloop.index %}{% when 1 %}{% assign n = n1 %}{% when 2 %}{% assign n = n2 %}{% else %}{% assign n = n3 %}{% endcase %}
{%- assign pct = 0 %}
{%- if base > 0 and c %}{% assign pct = c.value | times: 100.0 | divided_by: base | round %}{% endif %}
{%- assign w = pct | at_least: 1 | at_most: 100 %}
<li class="cut"><b>{{ t.title | escape }}</b><span>{{ n }}, {% if pct < 1 %}under 1%{% else %}{{ pct }}%{% endif %}</span><span class="bar" role="img" aria-label="{{ pct }} percent of {{ n0 }}"><i style="width:{{ w }}%"></i></span></li>
{%- endfor %}
</ul>
</div>
</div>
<div class="wrap">
<div class="cover-text">
<div class="lead">
<p class="headline">{{ data.headline | escape }}</p>
<p class="dek">{{ data.dek | escape }}</p>
</div>
<div class="made">
<p>Prepared for {% if person.first_name %}{{ person.first_name | escape }} {{ person.last_name | escape }}{% if person.title %}, {{ person.title | escape }}{% endif %}, {{ short_name | escape }}{% else %}the team at {{ short_name | escape }}{% endif %}.</p>
<p>Written by {{ sender.name | default: 'Our team' | escape }}{% if sender.title %}, {{ sender.title | escape }}{% endif %}{% if brand.name %}, {{ brand.name | escape }}{% endif %}.</p>
<p>Source: company profiles and hiring data, {{ n0 }} companies in {{ industry | escape }}.</p>
</div>
</div>
</div>
</section>
{%- comment %} One body for the three trend sections. Each trend gets its own data-section, so reading time is tracked per trend. The second is a full colour page with its bar set across the page. {% endcomment %}
{%- for t in data.trends limit: 3 %}
{%- assign i = forloop.index %}
{%- assign c = data.counts[i] %}
{%- assign p = data.plan[forloop.index0] %}
{%- case i %}{% when 1 %}{% assign n = n1 %}{% when 2 %}{% assign n = n2 %}{% else %}{% assign n = n3 %}{% endcase %}
{%- assign pct = 0 %}
{%- if base > 0 and c %}{% assign pct = c.value | times: 100.0 | divided_by: base | round %}{% endif %}
{%- assign w = pct | at_least: 1 | at_most: 100 %}
{%- case i %}
{%- when 1 %}
<section data-section="trend_1" class="sec trend">
{%- when 2 %}
<section data-section="trend_2" class="sec trend wide field">
{%- else %}
<section data-section="trend_3" class="sec trend">
{%- endcase %}
<div class="wrap">
<div class="grid">
<h2>{{ t.title | escape }}</h2>
<div class="num">
<p class="count">{{ n }}</p>
{%- if c and c.label %}
<p class="of">{{ c.label | escape }}</p>
{%- endif %}
</div>
<div class="bar" role="img" aria-label="{{ pct }} percent of {{ n0 }}"><i style="width:{{ w }}%"></i></div>
<div class="txt">
<p class="share"><b>{% if pct < 1 %}Under 1%{% else %}{{ pct }}%{% endif %}</b> of {{ n0 }} companies in {{ industry | escape }}</p>
{%- if p and p.counted %}
<div class="how"><h3>How we counted</h3><p>{{ p.counted | escape }}</p><p class="small">From company profiles and hiring data, counted on the day this brief was filled.</p></div>
{%- endif %}
</div>
<div class="prose">
<div><h3>What the count says</h3><p>{{ t.what | escape | newline_to_br | strip_newlines | raw }}</p></div>
<div><h3>What it means for {{ short_name | escape }}</h3><p>{{ t.means | escape | newline_to_br | strip_newlines | raw }}</p></div>
</div>
</div>
</div>
</section>
{%- endfor %}
<section data-section="next" class="sec next field">
<div class="wrap">
<div class="grid">
<h2>Where I would start</h2>
<div class="prose">
<p class="so">{{ data.so_what | escape | newline_to_br | strip_newlines | raw }}</p>
{%- if data.offer and data.offer != '' %}
<h3>{% if brand.name %}Where {{ brand.name | escape }} fits{% else %}Where we fit{% endif %}</h3>
<p>{{ data.offer | escape | newline_to_br | strip_newlines | raw }}</p>
{%- endif %}
<h3>Talk it through</h3>
<p>Each count above is a list of companies, filtered the way the line under it says. I can pull the names behind any of the three, cut them to your region, and walk you through them in twenty minutes.</p>
{%- if link.booking_url %}
<div class="cta">{% render 'ken/cta', label: 'Book 20 minutes', kind: 'booking', color: accent %}</div>
<p class="print-only">To book the twenty minutes, reply to my email with a time that suits you.</p>
{%- else %}
<p>Reply to my email with a time that suits you and I will send an invite.</p>
{%- endif %}
<p class="sign"><b>{{ sender.name | default: 'Our team' | escape }}</b>{% if sender.title %}{{ sender.title | escape }}{% if brand.name %}, {{ brand.name | escape }}{% endif %}{% elsif brand.name %}{{ brand.name | escape }}{% endif %}</p>
</div>
</div>
</div>
</section>
<div class="wrap">
<p class="method small"><b>How this brief was built.</b> Every number is a count of companies, built from company profiles and hiring data on the day this brief was filled. The baseline is every company in {{ industry | escape }}. Each trend is that baseline with one filter added, named under its count. Shares are rounded to a whole percent. One count is one reading, so the brief says how many, not whether a number went up or down.</p>
</div>
</main>
</body>
</html>
