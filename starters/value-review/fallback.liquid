{%- assign primary = brand.colors.primary | default: '#2a4bd7' -%}
{%- assign font_head = brand.fonts.heading | default: 'Inter Tight' -%}
{%- assign font_body = brand.fonts.body | default: 'Inter' -%}
{%- assign bname = brand.name | default: '' | strip -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex">
<title>Quarterly value review for {{ account.name | escape }}</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_head | url_encode }}:wght@500;600;700{% if font_body != font_head %}&amp;family={{ font_body | url_encode }}:wght@400;600{% endif %}&amp;display=swap">
<style>
:root{--p:{{ primary | escape }};--ink:#14181f;--mute:#5d6470;--rule:#dfe2e7}
*{box-sizing:border-box}
body{margin:0;background:#fff;color:var(--ink);font:16px/1.55 '{{ font_body | escape }}',ui-sans-serif,system-ui,sans-serif;-webkit-font-smoothing:antialiased}
.fb{max-width:40rem;margin:0 auto;padding:1.5rem 1.25rem 4rem}
.fb .mark{margin:0 0 3rem;padding-bottom:1rem;border-bottom:1px solid var(--rule);font-size:.9rem;font-weight:600}
.fb h1{font:600 clamp(1.9rem,7vw,2.8rem)/1.08 '{{ font_head | escape }}',ui-sans-serif,system-ui,sans-serif;letter-spacing:-.02em;margin:0 0 1.25rem;padding-top:1.1rem;border-top:3px solid var(--p)}
.fb p{margin:0 0 1rem;max-width:34rem}
.fb .by{color:var(--mute);font-size:.95rem}
.fb .ken-cta{display:inline-block;min-height:44px;padding:.7rem 0;color:var(--ink)!important;font-weight:600;text-decoration:underline;text-decoration-color:var(--p);text-decoration-thickness:3px;text-underline-offset:5px}
@media print{.fb{padding:0}}
</style>
</head>
<body>
<main class="fb">
<section data-section="cover">
{%- if bname != '' -%}
<p class="mark">{{ bname | escape }}</p>
{%- endif -%}
<h1>Quarterly value review for {{ account.name | escape }}</h1>
<p>The usage numbers for this quarter were not ready when this page was made.</p>
<p>{{ sender.name | default: 'Your account owner' | escape }} will send the full review shortly. You can also book a time to go through it together.</p>
<p>{% render 'ken/cta', label: 'Book a time to talk', kind: 'booking', variant: 'link' %}</p>
</section>
</main>
</body>
</html>
