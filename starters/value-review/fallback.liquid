{%- assign primary = brand.colors.primary | default: '#06525c' -%}
{%- assign font_head = brand.fonts.heading | default: 'League Spartan' -%}
{%- assign font_body = brand.fonts.body | default: 'Figtree' -%}
{%- assign bname = brand.name | default: '' | strip -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex">
<title>Quarterly value review for {{ account.name | escape }}</title>
{%- if font_head == 'League Spartan' %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=League+Spartan:wght@700&display=swap">
{%- else %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_head | url_encode }}&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_head | url_encode }}:wght@700&display=swap">
{%- endif %}
{%- if font_body != font_head %}
{%- if font_body == 'Figtree' %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;600&display=swap">
{%- else %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_body | url_encode }}&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_body | url_encode }}:wght@700&display=swap">
{%- endif %}
{%- endif %}
<style>
:root{--p:{{ primary | escape }};--ink:#0f2e33}
*{box-sizing:border-box}
body{margin:0;background:#f7f9f8;color:var(--ink);font:16px/1.55 '{{ font_body | escape }}',ui-sans-serif,system-ui,sans-serif;-webkit-font-smoothing:antialiased}
.fb{max-width:40rem;margin:0 auto;padding:1.5rem 1.25rem 4rem}
.fb .mark{display:flex;align-items:center;gap:.6rem;margin:0 0 3rem;font-weight:600}
.fb .q{width:5rem;height:5rem;margin:0 0 1.5rem;background:var(--p);border-top-right-radius:100%}
.fb h1{font:700 clamp(2rem,7vw,3rem)/1.04 '{{ font_head | escape }}',ui-sans-serif,system-ui,sans-serif;letter-spacing:-.02em;margin:0 0 1.25rem}
.fb p{margin:0 0 1rem;max-width:34rem;font-size:1.0625rem}
.fb .ken-cta{display:inline-block;min-height:44px;padding:.7rem 0;color:var(--ink)!important;font-weight:600;text-decoration:underline;text-decoration-color:var(--p);text-decoration-thickness:3px;text-underline-offset:5px}
@media print{.fb{padding:0}}
</style>
</head>
<body>
<main class="fb">
<section data-section="cover">
{%- if bname != '' -%}
<p class="mark">{{ bname | escape }}</p>
{%- endif -%}
<div class="q" aria-hidden="true"></div>
<h1>Quarterly value review for {{ account.name | escape }}</h1>
<p>The usage numbers for this quarter were not ready when this page was made.</p>
<p>{{ sender.name | default: 'Your account owner' | escape }} will send the full review shortly. You can also book a time to go through it together.</p>
<p>{% render 'ken/cta', label: 'Book a time to talk', kind: 'booking', variant: 'link' %}</p>
</section>
</main>
</body>
</html>
