{%- comment -%}Brand: validate the two colours, then read how light each one is so text on them stays readable.{%- endcomment -%}
{%- assign bname = brand.name | default: '' | strip -%}
{%- assign font_head = brand.fonts.heading | default: 'League Spartan' -%}
{%- assign font_body = brand.fonts.body | default: 'Figtree' -%}
{%- assign head_wq = '400;700' -%}
{%- if font_head == 'League Spartan' -%}{%- assign head_wq = '700' -%}{%- endif -%}
{%- assign body_wq = '400;700' -%}
{%- if font_body == 'Figtree' -%}{%- assign body_wq = '400;600' -%}{%- endif -%}
{%- assign c1 = brand.colors.primary | default: '#06525c' | strip | downcase -%}
{%- assign c2 = brand.colors.secondary | default: '#06525c' | strip | downcase -%}
{%- assign hexd = '0123456789abcdef' | split: '' -%}
{%- assign cols = c1 | append: '|' | append: c2 | split: '|' -%}
{%- assign okc = '' -%}
{%- assign lumc = '' -%}
{%- for c in cols -%}
{%- assign n = c | size -%}
{%- assign chars = c | split: '' -%}
{%- assign digits = '' -%}
{%- assign bad = false -%}
{%- if n != 7 and n != 4 -%}{%- assign bad = true -%}{%- endif -%}
{%- for ch in chars offset: 1 -%}
{%- assign found = -1 -%}
{%- for hd in hexd -%}{%- if hd == ch -%}{%- assign found = forloop.index0 -%}{%- endif -%}{%- endfor -%}
{%- if found < 0 -%}{%- assign bad = true -%}{%- endif -%}
{%- assign digits = digits | append: found | append: ',' -%}
{%- endfor -%}
{%- if bad -%}
{%- assign okc = okc | append: 'n|' -%}
{%- assign lumc = lumc | append: '0|' -%}
{%- else -%}
{%- assign dg = digits | split: ',' -%}
{%- if n == 7 -%}
{%- assign cr = dg[0] | times: 16 | plus: dg[1] -%}
{%- assign cg = dg[2] | times: 16 | plus: dg[3] -%}
{%- assign cb = dg[4] | times: 16 | plus: dg[5] -%}
{%- else -%}
{%- assign cr = dg[0] | times: 17 -%}
{%- assign cg = dg[1] | times: 17 -%}
{%- assign cb = dg[2] | times: 17 -%}
{%- endif -%}
{%- assign lum = cr | times: 299 -%}
{%- assign lum_g = cg | times: 587 -%}
{%- assign lum_b = cb | times: 114 -%}
{%- assign lum = lum | plus: lum_g | plus: lum_b -%}
{%- assign okc = okc | append: 'y|' -%}
{%- assign lumc = lumc | append: lum | append: '|' -%}
{%- endif -%}
{%- endfor -%}
{%- assign oks = okc | split: '|' -%}
{%- assign lums = lumc | split: '|' -%}
{%- assign primary = c1 -%}
{%- assign p_lum = lums[0] | plus: 0 -%}
{%- if oks[0] != 'y' -%}{%- assign primary = '#06525c' -%}{%- assign p_lum = 60416 -%}{%- endif -%}
{%- assign secondary = c2 -%}
{%- assign s_lum = lums[1] | plus: 0 -%}
{%- if oks[1] != 'y' -%}{%- assign secondary = '#06525c' -%}{%- assign s_lum = 60416 -%}{%- endif -%}
{%- comment -%}On a pale primary, text on it turns dark and marks on the paper darken. A pale secondary is darkened before it becomes the ink.{%- endcomment -%}
{%- if p_lum < 110000 -%}
{%- assign on_p = '#ffffff' -%}
{%- assign mark_css = 'var(--p)' -%}
{%- else -%}
{%- assign on_p = '#10201f' -%}
{%- assign mark_css = 'color-mix(in srgb,var(--p) 40%,#10201f)' -%}
{%- endif -%}
{%- if s_lum < 110000 -%}
{%- assign ink_css = 'var(--brand-secondary)' -%}
{%- else -%}
{%- assign ink_css = 'color-mix(in srgb,var(--brand-secondary) 30%,#10201f)' -%}
{%- endif -%}
{%- comment -%}Rows: one pass for the quarters and the counts, one for the months.{%- endcomment -%}
{%- assign cq = nil -%}
{%- assign pq = nil -%}
{%- assign nq = 0 -%}
{%- assign nm = 0 -%}
{%- assign nt = 0 -%}
{%- assign ns = 0 -%}
{%- assign sum_a = 0 -%}
{%- assign sum_s = 0 -%}
{%- assign lab_max = 0 -%}
{%- assign vlen_max = 0 -%}
{%- assign m_start = '' -%}
{%- assign m_review = '' -%}
{%- assign m_renew = '' -%}
{%- for r in data.rows -%}
{%- if r.kind == 'quarter' -%}
{%- assign nq = nq | plus: 1 -%}
{%- assign pq = cq -%}
{%- assign cq = r -%}
{%- elsif r.kind == 'month' -%}
{%- assign nm = nm | plus: 1 -%}
{%- elsif r.kind == 'team' -%}
{%- assign nt = nt | plus: 1 -%}
{%- assign ta = r.active_seats | default: 0 -%}
{%- assign ts = r.seats | default: 0 -%}
{%- assign sum_a = sum_a | plus: ta -%}
{%- assign sum_s = sum_s | plus: ts -%}
{%- assign ln = r.label | truncate: 24 | size -%}
{%- if ln > lab_max -%}{%- assign lab_max = ln -%}{%- endif -%}
{%- assign vtext = ta | append: ' of ' | append: ts -%}
{%- assign vl = vtext | size -%}
{%- if vl > vlen_max -%}{%- assign vlen_max = vl -%}{%- endif -%}
{%- elsif r.kind == 'milestone' -%}
{%- assign ns = ns | plus: 1 -%}
{%- if r.marker == 'start' and r.date -%}{%- assign m_start = r.date -%}{%- endif -%}
{%- if r.marker == 'review' and r.date -%}{%- assign m_review = r.date -%}{%- endif -%}
{%- if r.marker == 'renewal' and r.date -%}{%- assign m_renew = r.date -%}{%- endif -%}
{%- endif -%}
{%- endfor -%}
{%- assign mi = 0 -%}
{%- assign max_m = 0 -%}
{%- assign qa = -1 -%}
{%- assign qz = -1 -%}
{%- assign m_first = '' -%}
{%- assign m_last = '' -%}
{%- assign v_first = 0 -%}
{%- assign v_last = 0 -%}
{%- for r in data.rows -%}
{%- if r.kind == 'month' -%}
{%- assign v = r.active_seats | default: 0 -%}
{%- if v > max_m -%}{%- assign max_m = v -%}{%- endif -%}
{%- if cq and r.quarter == cq.label -%}
{%- if qa < 0 -%}{%- assign qa = mi -%}{%- endif -%}
{%- assign qz = mi -%}
{%- endif -%}
{%- if mi == 0 -%}{%- assign m_first = r.label -%}{%- assign v_first = v -%}{%- endif -%}
{%- assign m_last = r.label -%}
{%- assign v_last = v -%}
{%- assign mi = mi | plus: 1 -%}
{%- endif -%}
{%- endfor -%}
{%- comment -%}Quarter names: the big numeral, and the quarter after this one.{%- endcomment -%}
{%- assign qt = '' -%}
{%- assign nextq = '' -%}
{%- assign pqt = '' -%}
{%- if cq -%}
{%- assign qt = cq.label | split: ' ' | first -%}
{%- assign qnum = qt | remove: 'Q' | remove: 'q' | plus: 0 -%}
{%- assign q1 = qt | slice: 0, 1 | upcase -%}
{%- if q1 == 'Q' and qnum >= 1 and qnum <= 4 -%}
{%- if qnum == 4 -%}
{%- assign nextq = 'Q1' -%}
{%- else -%}
{%- assign qn1 = qnum | plus: 1 -%}
{%- assign nextq = 'Q' | append: qn1 -%}
{%- endif -%}
{%- endif -%}
{%- endif -%}
{%- if pq -%}{%- assign pqt = pq.label | split: ' ' | first -%}{%- endif -%}
{%- assign cta_label = 'Book the planning call' -%}
{%- if nextq != '' -%}{%- assign cta_label = 'Book the ' | append: nextq | append: ' planning call' -%}{%- endif -%}
{%- comment -%}Term: months from contract start to renewal, how many have passed at the review, and the days left.{%- endcomment -%}
{%- assign term_ok = false -%}
{%- assign total = 0 -%}
{%- assign elapsed = 0 -%}
{%- assign days_left = 0 -%}
{%- if m_start != '' and m_renew != '' and m_review != '' -%}
{%- assign s_y = m_start | date: '%Y' | plus: 0 -%}
{%- assign s_m = m_start | date: '%-m' | plus: 0 -%}
{%- assign s_d = m_start | date: '%-d' | plus: 0 -%}
{%- assign r_y = m_renew | date: '%Y' | plus: 0 -%}
{%- assign r_m = m_renew | date: '%-m' | plus: 0 -%}
{%- assign r_d = m_renew | date: '%-d' | plus: 0 -%}
{%- assign v_y = m_review | date: '%Y' | plus: 0 -%}
{%- assign v_m = m_review | date: '%-m' | plus: 0 -%}
{%- assign v_d = m_review | date: '%-d' | plus: 0 -%}
{%- assign s_ym = s_y | times: 12 | plus: s_m -%}
{%- assign r_ym = r_y | times: 12 | plus: r_m -%}
{%- assign v_ym = v_y | times: 12 | plus: v_m -%}
{%- assign total = r_ym | minus: s_ym -%}
{%- if r_d < s_d -%}{%- assign total = total | minus: 1 -%}{%- endif -%}
{%- assign elapsed = v_ym | minus: s_ym -%}
{%- if v_d < s_d -%}{%- assign elapsed = elapsed | minus: 1 -%}{%- endif -%}
{%- if total >= 1 and total <= 36 -%}
{%- assign term_ok = true -%}
{%- assign elapsed = elapsed | at_least: 0 | at_most: total -%}
{%- assign s_sec = m_start | date: '%s' | plus: 0 -%}
{%- assign r_sec = m_renew | date: '%s' | plus: 0 -%}
{%- assign v_sec = m_review | date: '%s' | plus: 0 -%}
{%- assign days_left = r_sec | minus: v_sec | divided_by: 86400.0 | round -%}
{%- endif -%}
{%- endif -%}
{%- comment -%}Whole numbers with thousands commas, and the changes against last quarter.{%- endcomment -%}
{%- assign h_cur = cq.hours_saved | default: 0 -%}
{%- assign h_prev = pq.hours_saved | default: 0 -%}
{%- assign t_cur = cq.tasks_done | default: 0 -%}
{%- assign t_prev = pq.tasks_done | default: 0 -%}
{%- assign a_cur = cq.active_seats | default: 0 -%}
{%- assign a_prev = pq.active_seats | default: 0 -%}
{%- assign seats_cap = cq.seats | default: 0 -%}
{%- assign raws = h_cur | append: '|' | append: h_prev | append: '|' | append: t_cur | append: '|' | append: t_prev | append: '|' | append: a_cur | append: '|' | append: a_prev | append: '|' | append: seats_cap | split: '|' -%}
{%- assign fmts = '' -%}
{%- for rv in raws -%}
{%- assign nv = rv | plus: 0 | round -%}
{%- if nv < 1000 -%}
{%- assign fv = nv -%}
{%- else -%}
{%- assign k1 = nv | divided_by: 1000.0 | floor -%}
{%- assign r1 = nv | modulo: 1000 -%}
{%- assign p1 = r1 -%}
{%- if r1 < 10 -%}{%- assign p1 = '00' | append: r1 -%}{%- elsif r1 < 100 -%}{%- assign p1 = '0' | append: r1 -%}{%- endif -%}
{%- if k1 < 1000 -%}
{%- assign fv = k1 | append: ',' | append: p1 -%}
{%- else -%}
{%- assign m1 = k1 | divided_by: 1000.0 | floor -%}
{%- assign r2 = k1 | modulo: 1000 -%}
{%- assign p2 = r2 -%}
{%- if r2 < 10 -%}{%- assign p2 = '00' | append: r2 -%}{%- elsif r2 < 100 -%}{%- assign p2 = '0' | append: r2 -%}{%- endif -%}
{%- assign fv = m1 | append: ',' | append: p2 | append: ',' | append: p1 -%}
{%- endif -%}
{%- endif -%}
{%- assign fmts = fmts | append: fv | append: '|' -%}
{%- endfor -%}
{%- assign fm = fmts | split: '|' -%}
{%- assign fm0_sz = fm[0] | size -%}
{%- assign fm2_sz = fm[2] | size -%}
{%- assign fm4_sz = fm[4] | size -%}
{%- assign h_pct = 0 -%}
{%- if h_prev > 0 -%}{%- assign h_pct = h_cur | minus: h_prev | times: 100.0 | divided_by: h_prev | round -%}{%- endif -%}
{%- assign t_pct = 0 -%}
{%- if t_prev > 0 -%}{%- assign t_pct = t_cur | minus: t_prev | times: 100.0 | divided_by: t_prev | round -%}{%- endif -%}
{%- assign a_diff = a_cur | minus: a_prev -%}
{%- assign md_cur = cq.median_hours | default: 0 -%}
{%- assign md_prev = pq.median_hours | default: 0 -%}
{%- assign md_pct = 0 -%}
{%- if md_prev > 0 -%}{%- assign md_pct = md_prev | minus: md_cur | times: 100.0 | divided_by: md_prev | round -%}{%- endif -%}
{%- assign tile_count = 0 -%}
{%- if cq.hours_saved -%}{%- assign tile_count = tile_count | plus: 1 -%}{%- endif -%}
{%- if cq.active_seats -%}{%- assign tile_count = tile_count | plus: 1 -%}{%- endif -%}
{%- if cq.tasks_done -%}{%- assign tile_count = tile_count | plus: 1 -%}{%- endif -%}
{%- if cq.median_hours -%}{%- assign tile_count = tile_count | plus: 1 -%}{%- endif -%}
{%- comment -%}Chart geometry: the column scale runs to the seats on the contract, or the busiest month.{%- endcomment -%}
{%- assign top = max_m -%}
{%- if seats_cap > top -%}{%- assign top = seats_cap -%}{%- endif -%}
{%- assign top = top | at_least: 1 -%}
{%- assign lab_every = nm | plus: 8 | divided_by: 9.0 | floor | at_least: 1 -%}
{%- assign mid_i = nm | minus: 1 | divided_by: 2.0 | floor -%}
{%- assign last_i = nm | minus: 1 -%}
{%- comment -%}The quarter disc: four wedges clockwise from the top, the quarters before this one in a light tone, this one in full.{%- endcomment -%}
{%- assign q_ok = false -%}
{%- if cq and q1 == 'Q' and qnum >= 1 and qnum <= 4 -%}{%- assign q_ok = true -%}{%- endif -%}
{%- assign wedges = 'M103,97 L103,-3 A100,100 0 0 1 203,97 Z|M103,103 L203,103 A100,100 0 0 1 103,203 Z|M97,103 L97,203 A100,100 0 0 1 -3,103 Z|M97,97 L-3,97 A100,100 0 0 1 97,-3 Z' | split: '|' -%}
{%- assign qx = '145,145,55,55' | split: ',' -%}
{%- assign qy = '55,145,145,55' | split: ',' -%}
{%- comment -%}Month columns: heights against the contract seats or the busiest month.{%- endcomment -%}
{%- assign cap_pct = seats_cap | times: 100.0 | divided_by: top | round: 1 -%}
{%- assign show_all_v = false -%}
{%- if nm <= 12 -%}{%- assign show_all_v = true -%}{%- endif -%}
{%- assign win_count = data.wins | size -%}
{%- assign plan_count = data.plan | size -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex">
<meta name="description" content="A quarterly value review for {{ account.name | escape }}: usage against last quarter, adoption by team, wins, the plan for next quarter and the renewal timeline.">
<title>{% if cq %}{{ cq.label | escape }} value review{% else %}Quarterly value review{% endif %} for {{ account.name | escape }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com/">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_head | url_encode }}:wght@{{ head_wq }}&amp;display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_body | url_encode }}:wght@{{ body_wq }}&amp;display=swap">
<style>
:root{
  --brand-primary:{{ primary }};
  --brand-secondary:{{ secondary }};
  --brand-heading-font:'{{ font_head | escape }}';
  --brand-body-font:'{{ font_body | escape }}';
  --p:var(--brand-primary);
  --s:{{ ink_css }};
  --fh:var(--brand-heading-font),ui-sans-serif,system-ui,sans-serif;
  --fb:var(--brand-body-font),ui-sans-serif,system-ui,sans-serif;
  --bg:#f7f9f8;
  --surface:#ebf0ee;
  --ink:var(--s);
  --mute:color-mix(in srgb,var(--ink) 88%,var(--bg));
  --on-p:{{ on_p }};
  --mark:{{ mark_css }};
  --past:color-mix(in srgb,var(--p) 34%,var(--bg));
  --rule:color-mix(in srgb,var(--ink) 16%,var(--bg));
  --m:clamp(1.25rem,3vw,2.5rem);
  --t-small:.875rem;
  --t-body:clamp(1.0625rem,1rem + .25vw,1.1875rem);
  --t-lead:clamp(1.25rem,1.1rem + .7vw,1.625rem);
  --t-head:clamp(2.25rem,1.4rem + 3vw,4rem);
  --t-fig:clamp(3.5rem,2rem + 4.6vw,6rem);
  --qr:clamp(4rem,2rem + 6vw,8rem);
}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%;background:var(--bg)}
body{margin:0;background:var(--bg);color:var(--ink);font:400 var(--t-body)/1.5 var(--fb);-webkit-font-smoothing:antialiased;-webkit-print-color-adjust:exact;print-color-adjust:exact}
h1,h2,h3{font-family:var(--fh);font-weight:700;margin:0;letter-spacing:-.035em;line-height:.92;text-wrap:balance}
p{margin:0}
a{color:inherit;text-underline-offset:.18em;text-decoration-thickness:.07em}
:focus-visible{outline:3px solid var(--mark);outline-offset:3px}
::selection{background:var(--ink);color:var(--bg)}
.tn{font-variant-numeric:tabular-nums lining-nums}
.wrap{padding-inline:var(--m);max-width:96rem;margin-inline:auto}

.cover{position:relative;overflow:hidden;min-height:100svh;display:flex;flex-direction:column;padding-bottom:3rem}
.top{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding-block:1.25rem;font-size:var(--t-small);position:relative;z-index:1}
.brand{display:flex;align-items:center;gap:.55rem;font-weight:600}
.logo{width:28px;height:28px;display:grid;place-items:center;flex:none;background:var(--p);color:var(--on-p);font:700 .95rem/1 var(--fh);border-top-right-radius:28px}
.logo-img{display:block;flex:none;height:28px;width:auto;max-width:9rem;object-fit:contain}
.top .meta{text-align:right;color:var(--mute)}
.disc{display:block;width:78vw;margin:.5rem -16vw 0 auto;height:auto}
.disc .w{fill:var(--surface)}
.disc .w.past{fill:var(--past)}
.disc .w.now{fill:var(--p)}
.disc text{font:700 34px var(--fh);fill:var(--on-p);letter-spacing:-.03em}
.lede-col{display:grid;gap:1.4rem;position:relative;z-index:1;max-width:36rem;margin-top:1.5rem}
.cover h1{font-size:clamp(2rem,1rem + 3.8vw,4.25rem);max-width:16ch}
.period{font-size:var(--t-lead);line-height:1.3;max-width:28ch}
.head{font:400 var(--t-lead)/1.35 var(--fb);max-width:30ch;color:var(--ink)}
.who{max-width:42ch}

.sec{padding-top:clamp(4.5rem,3rem + 8vw,10rem)}
.sh{display:grid;gap:1rem;margin-bottom:2.5rem}
.sh h2{font-size:var(--t-head);max-width:14ch}
.sh .note{max-width:40ch}
.body{max-width:58ch;margin-top:2rem}

.tiles{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;align-items:start}
.tile{display:flex;flex-direction:column;justify-content:space-between;gap:2rem;padding:1.25rem;min-height:13rem;background:var(--surface);border-top-right-radius:var(--qr)}
.tile:first-child{grid-column:1/-1;min-height:16rem;background:var(--p);color:var(--on-p)}
.tile:nth-child(2){background:var(--ink);color:var(--bg)}
.tile:nth-child(4){margin-top:2rem}
.tile{container-type:inline-size}
.tile b{display:block;font:700 min(var(--t-fig),calc(140cqi / var(--len,4)))/.86 var(--fh);letter-spacing:-.04em}
.tile b small{font:700 var(--t-lead)/1 var(--fh);letter-spacing:-.01em;margin-left:.3rem}
.tile .lab{display:block;font-weight:600;margin-bottom:.3rem}
.delta{display:flex;flex-wrap:wrap;align-items:center;gap:.15rem .4rem;font-size:var(--t-small)}
.delta b{font:600 var(--t-small)/1.3 var(--fb);letter-spacing:0}

.field{background:var(--ink);color:var(--bg);margin-top:clamp(4.5rem,3rem + 8vw,10rem);padding-block:clamp(4rem,3rem + 5vw,8rem)}
.field.sec{padding-top:clamp(4rem,3rem + 5vw,8rem)}
.field .sh .note,.field figcaption{color:color-mix(in srgb,var(--bg) 82%,var(--ink))}
.chart{position:relative;margin-top:4rem}
.colz{display:grid;grid-template-columns:repeat(var(--nm),minmax(0,1fr));gap:clamp(3px,.8vw,10px);align-items:end;height:clamp(13rem,9rem + 14vw,24rem);position:relative}
.col{position:relative;background:color-mix(in srgb,var(--bg) 42%,var(--ink));border-top-right-radius:999px}
.col.inq{background:var(--bg)}
.col span{position:absolute;bottom:100%;left:0;right:0;text-align:center;font-size:var(--t-small);font-weight:600;padding-bottom:.3rem;font-variant-numeric:tabular-nums}
.cap{position:absolute;left:0;right:0;height:3px;background:color-mix(in srgb,var(--bg) 70%,var(--ink))}
.cap i{position:absolute;right:0;bottom:.4rem;font:600 var(--t-small)/1 var(--fb);font-style:normal;background:var(--ink);padding-left:.4rem}
.mons{display:grid;grid-template-columns:repeat(var(--nm),minmax(0,1fr));gap:clamp(3px,.8vw,10px);margin-top:.6rem;font-size:var(--t-small)}
.mons span{text-align:center;white-space:nowrap}
.field figcaption{margin-top:1.5rem;font-size:var(--t-small);max-width:52ch}
.field figcaption b{color:var(--bg)}
.field .body{color:var(--bg)}

.split{display:grid;gap:2rem}
.teams{list-style:none;margin:0;padding:0;display:grid;gap:1.1rem}
.teams li{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:.45rem 1rem;align-items:baseline}
.teams b{font-weight:600}
.teams .v{font-variant-numeric:tabular-nums}
.teams .t{grid-column:1/-1;height:.9rem;background:var(--surface)}
.teams .t i{display:block;height:100%;background:var(--ink)}
figcaption{font-size:var(--t-small);line-height:1.5;color:var(--mute);max-width:52ch;margin-top:1.25rem}
figcaption b{color:var(--ink);font-weight:600}
figure{margin:0}

.wins{list-style:none;margin:0;padding:0;display:grid;gap:5rem}
.wins li{display:grid;gap:.6rem;max-width:40rem}
.wins .st{font:700 var(--t-fig)/.86 var(--fh);letter-spacing:-.04em}
.wins .st small{font:700 var(--t-lead)/1 var(--fh);letter-spacing:-.01em;margin-left:.35rem}
.wins h3{font-size:var(--t-lead);letter-spacing:-.02em;line-height:1.1;margin-top:.4rem}
.wins .team{display:flex;align-items:center;gap:.5rem;color:var(--mute);font-size:var(--t-small)}
.wins .team::before{content:"";width:.8rem;height:.8rem;background:var(--p);border-top-right-radius:100%;flex:none}

.plan{width:100%;border-collapse:collapse}
.plan thead{display:none}
.plan thead tr{border:0}
.plan tr{display:block;padding:1rem 0;border-top:1px solid var(--rule)}
.plan tbody tr:first-child{border-top:4px solid var(--ink)}
.plan td{display:block;padding:.1rem 0}
.plan td.when{font-weight:600;font-variant-numeric:tabular-nums}
.plan td.who{color:var(--mute);font-size:var(--t-small)}

.term{display:grid;grid-template-columns:repeat(var(--tn),minmax(0,1fr));gap:4px;margin-top:2.5rem}
.term i{display:block;aspect-ratio:1;background:var(--surface);border-top-right-radius:100%}
.term i.on{background:var(--past)}
.term i.now{background:var(--p)}
.term-l{display:flex;justify-content:space-between;gap:1rem;font-size:var(--t-small);color:var(--mute);margin-top:.6rem;font-variant-numeric:tabular-nums}
.term-h{font:700 var(--t-lead)/1.1 var(--fh);letter-spacing:-.02em}
.renew{display:grid;gap:2.5rem}
.rail{list-style:none;margin:0;padding:0;display:grid;gap:1.1rem}
.rail li{display:grid;grid-template-columns:1rem minmax(0,1fr);gap:.25rem .9rem}
.rail li::before{content:"";grid-row:1/3;width:1rem;height:1rem;margin-top:.3rem;background:var(--surface);border-top-right-radius:100%}
.rail li.past::before{background:var(--past)}
.rail li.today::before{background:var(--p)}
.rail .d{font-weight:600;font-variant-numeric:tabular-nums}
.rail .d em{font-style:normal;color:var(--mark);margin-left:.5rem}
.rail .w{color:var(--ink)}
.rail li.past .w,.rail li.past .d{color:var(--mute)}

.next{margin-top:clamp(4.5rem,3rem + 8vw,10rem);background:var(--p);color:var(--on-p);border-top-left-radius:var(--qr);padding-block:clamp(3rem,2rem + 3.5vw,5rem) 3rem}
.field+.next{margin-top:clamp(3rem,2rem + 4vw,6rem)}
.next .in{display:grid;gap:2rem}
.next .say{font:400 var(--t-lead)/1.38 var(--fb);max-width:34ch}
.next .sign b{display:block;font-weight:600}
.cta-wrap .ken-cta{display:inline-block!important;min-height:52px;padding:15px 26px!important;border-radius:0 26px 0 0!important;background:var(--bg)!important;color:var(--ink)!important;font:600 var(--t-body)/1.3 var(--fb)!important;text-decoration:none!important}
.cta-wrap .ken-cta:hover{background:var(--ink)!important;color:var(--bg)!important}
.method{font-size:var(--t-small);line-height:1.55;max-width:60ch}
.method b{font-weight:600}

@keyframes pop{from{transform:scale(.55);opacity:0}to{transform:none;opacity:1}}
@media (prefers-reduced-motion:no-preference){
  .disc .w{transform-box:view-box;transform-origin:100px 100px;animation:pop .7s cubic-bezier(.2,.8,.2,1) both}
  .disc .w:nth-of-type(2){animation-delay:.09s}
  .disc .w:nth-of-type(3){animation-delay:.18s}
  .disc .w:nth-of-type(4){animation-delay:.27s}
}

@media (max-width:999px){
  .tiles{gap:1rem}
  .tile,.tile:first-child{min-height:0;justify-content:flex-start;gap:.75rem}
  .tile:first-child{padding-top:3rem}
  .tile:nth-child(4){margin-top:0}
}
@media (max-width:759px){
  .tile:not(:first-child)>b{font-size:min(2.75rem,calc(140cqi / var(--len,4)))}
}
@media (min-width:760px){
  .disc{width:min(62vw,30rem);margin-right:-10vw}
  .tile,.tile:first-child{grid-column:auto;margin-top:0}
  .split{grid-template-columns:repeat(12,minmax(0,1fr));column-gap:1.5rem}
  .split>.sh{grid-column:1/6;display:grid;grid-template-columns:none;align-content:start}
  .split>.sh h2,.split>.sh .note{grid-column:auto}
  .split>.bd{grid-column:7/-1}
  .wins{grid-template-columns:repeat(3,minmax(0,1fr));column-gap:2rem;align-items:start}
  .wins li:nth-child(2){margin-top:5rem}
  .wins li:nth-child(3){margin-top:10rem}
  .sh.stack{grid-template-columns:none}
  .sh.stack h2,.sh.stack .note{grid-column:auto}
  .plan thead{display:table-header-group}
  .plan th{text-align:left;font-weight:600;font-size:var(--t-small);color:var(--mute);padding:0 1.5rem .6rem 0;border-bottom:4px solid var(--ink)}
  .plan tr{display:table-row;padding:0}
  .plan tbody tr:first-child{border-top:0}
  .plan td{display:table-cell;padding:1rem 1.5rem 1rem 0;border-top:1px solid var(--rule);vertical-align:top}
  .plan tbody tr:first-child td{border-top:0}
  .plan td.when{white-space:nowrap;width:10rem}
  .plan td.who{width:16rem}
  .renew{gap:3.5rem}
  .rail{display:block;columns:2;column-gap:1.5rem}
  .rail li{break-inside:avoid;margin-bottom:1.5rem}
  .term{margin-top:1rem;gap:6px}
  .next .in{grid-template-columns:repeat(12,minmax(0,1fr));column-gap:1.5rem;align-items:end}
  .next .say{grid-column:1/8}
  .next .act{grid-column:9/-1;display:grid;gap:1.25rem;justify-items:start}
  .next .method{grid-column:1/8}
}
@media (min-width:1000px){
  .sh{grid-template-columns:repeat(12,minmax(0,1fr));column-gap:1.5rem;align-items:end}
  .sh h2{grid-column:1/7}
  .sh .note{grid-column:8/-1}
  .tiles{grid-template-columns:repeat(var(--tiles,4),minmax(0,1fr))}
  .tile,.tile:first-child{min-height:calc(22rem - var(--i,0) * 3rem);margin-top:calc(var(--i,0) * 3rem)}
  .disc{position:absolute;width:min(58vw,52rem);right:-9vw;top:50%;margin:0;transform:translateY(-46%)}
  .lede-col{max-width:min(36rem,44vw);margin-top:auto;padding-top:2rem}
  .cover-main{flex:1;display:flex;flex-direction:column;justify-content:center}
}
@media print{
  @page{margin:15mm}
  html,body{background:#fff}
  .cover{min-height:auto;overflow:visible}
  .disc{position:static;transform:none;width:16rem;margin:0 0 1rem}
  .sec{break-before:page;padding-top:0}
  .field{background:#fff;color:var(--ink);margin-top:0;padding-block:0}
  .field .col{background:var(--past)}
  .field .col.inq{background:var(--ink)}
  .field .cap{background:var(--mute)}
  .field .cap i{background:#fff}
  .field .sh .note,.field figcaption,.field .body,.field figcaption b{color:var(--ink)}
  .next{break-inside:avoid;background:#fff;color:var(--ink);border-top:4px solid var(--ink);border-radius:0;margin-top:2rem;padding-top:1.5rem}
  .cta-wrap{display:none}
  .tile,.wins li,.rail li,.plan tr,figure{break-inside:avoid}
  .disc .w{animation:none}
}
</style>
</head>
<body>
<main>
<section class="cover wrap" data-section="cover">
<header class="top">
<div class="brand">
{%- if brand.logo_url -%}
<img class="logo-img" src="{{ brand.logo_url | escape }}" alt="{{ bname | default: 'Logo' | escape }}">
{%- elsif bname != '' -%}
<span class="logo" aria-hidden="true">{{ bname | slice: 0, 1 | upcase | escape }}</span>
{%- endif -%}
{%- if bname != '' -%}
<span class="bname">{{ bname | escape }}</span>
{%- endif -%}
</div>
<p class="meta">Quarterly value review{% if m_review != '' %}, {{ m_review | date: '%-d %b %Y' }}{% endif %}</p>
</header>
<svg class="disc" viewBox="-4 -4 208 208" role="img" aria-label="{% if q_ok %}{{ qt | escape }}: quarter {{ qnum }} of 4 in the year{% else %}The quarter{% endif %}">
{%- for wp in wedges -%}
{%- assign k = forloop.index -%}
{%- assign wc = '' -%}
{%- if q_ok -%}{%- if k < qnum -%}{%- assign wc = ' past' -%}{%- elsif k == qnum -%}{%- assign wc = ' now' -%}{%- endif -%}{%- endif -%}
<path class="w{{ wc }}" d="{{ wp }}"/>
{%- endfor -%}
{%- if q_ok -%}
{%- assign qi = qnum | minus: 1 -%}
<text x="{{ qx[qi] }}" y="{{ qy[qi] }}" text-anchor="middle" dominant-baseline="middle">{{ qt | escape }}</text>
{%- endif -%}
</svg>
<div class="cover-main">
<div class="lede-col">
<h1>{{ account.name | escape }}{% if cq %}, {{ cq.label | escape }}{% endif %}</h1>
{%- if cq.detail and cq.detail != '' -%}
<p class="period">Quarterly value review for {{ cq.detail | escape }}.</p>
{%- endif -%}
<p class="head">{{ data.headline | escape }}</p>
<p class="who">Prepared for {% if person.first_name %}{{ person.first_name | escape }}{% if person.last_name %} {{ person.last_name | escape }}{% endif %}{% if person.title %}, {{ person.title | escape }}{% endif %}{% else %}the {{ account.name | escape }} team{% endif %}{% if sender.name %}, by {{ sender.name | escape }}{% if sender.title %}, {{ sender.title | escape }}{% endif %}{% if bname != '' %} at {{ bname | escape }}{% endif %}{% elsif bname != '' %}, by {{ bname | escape }}{% endif %}.{% if term_ok %} Month {{ elapsed }} of a {{ total }}-month term. The contract renews on {{ m_renew | date: '%-d %B %Y' }}.{% endif %}</p>
</div>
</div>
</section>
{%- if cq -%}
<section class="sec wrap" data-section="outcomes">
<div class="sh"><h2>Headline outcomes</h2><p class="note">{{ cq.label | escape }}{% if pq %} against {{ pq.label | escape }}{% endif %}, from the usage export.</p></div>
<div class="tiles" style="--tiles:{{ tile_count | at_least: 1 }}">
{%- assign ti = 0 -%}
{%- if cq.hours_saved -%}
<div class="tile" style="--i:{{ ti }}"><b class="tn" style="--len:{{ fm[0] | size }}">{{ fm[0] }}</b><div><span class="lab">Hours saved</span>
{%- if pq and pq.hours_saved and h_prev > 0 -%}
{%- if h_pct > 0 -%}
<p class="delta"><b>+{{ h_pct }}%</b><span>vs {{ fm[1] }} in {{ pqt | escape }}</span></p>
{%- elsif h_pct < 0 -%}
<p class="delta"><b>{{ h_pct }}%</b><span>vs {{ fm[1] }} in {{ pqt | escape }}</span></p>
{%- else -%}
<p class="delta"><b>No change</b><span>vs {{ fm[1] }} in {{ pqt | escape }}</span></p>
{%- endif -%}
{%- endif -%}
</div></div>
{%- assign ti = ti | plus: 1 -%}
{%- endif -%}
{%- if cq.active_seats -%}
<div class="tile" style="--i:{{ ti }}"><b class="tn" style="--len:{{ fm[4] | size | plus: 2 }}">{{ fm[4] }}{% if seats_cap > 0 %}<small>of {{ fm[6] }}</small>{% endif %}</b><div><span class="lab">Active seats</span>
{%- if pq and pq.active_seats -%}
{%- if a_diff > 0 -%}
<p class="delta"><b>+{{ a_diff }}</b><span>vs {{ fm[5] }} in {{ pqt | escape }}</span></p>
{%- elsif a_diff < 0 -%}
<p class="delta"><b>{{ a_diff }}</b><span>vs {{ fm[5] }} in {{ pqt | escape }}</span></p>
{%- else -%}
<p class="delta"><b>No change</b><span>vs {{ fm[5] }} in {{ pqt | escape }}</span></p>
{%- endif -%}
{%- endif -%}
</div></div>
{%- assign ti = ti | plus: 1 -%}
{%- endif -%}
{%- if cq.tasks_done -%}
<div class="tile" style="--i:{{ ti }}"><b class="tn" style="--len:{{ fm[2] | size }}">{{ fm[2] }}</b><div><span class="lab">Tasks completed</span>
{%- if pq and pq.tasks_done and t_prev > 0 -%}
{%- if t_pct > 0 -%}
<p class="delta"><b>+{{ t_pct }}%</b><span>vs {{ fm[3] }} in {{ pqt | escape }}</span></p>
{%- elsif t_pct < 0 -%}
<p class="delta"><b>{{ t_pct }}%</b><span>vs {{ fm[3] }} in {{ pqt | escape }}</span></p>
{%- else -%}
<p class="delta"><b>No change</b><span>vs {{ fm[3] }} in {{ pqt | escape }}</span></p>
{%- endif -%}
{%- endif -%}
</div></div>
{%- assign ti = ti | plus: 1 -%}
{%- endif -%}
{%- if cq.median_hours -%}
<div class="tile" style="--i:{{ ti }}"><b class="tn" style="--len:5">{{ md_cur | round: 1 }}<small>hours</small></b><div><span class="lab">Median time per task</span>
{%- if pq and pq.median_hours and md_prev > 0 -%}
{%- if md_pct > 0 -%}
<p class="delta"><b>{{ md_pct }}% faster</b><span>vs {{ md_prev | round: 1 }} h in {{ pqt | escape }}</span></p>
{%- elsif md_pct < 0 -%}
<p class="delta"><b>{{ md_pct | abs }}% slower</b><span>vs {{ md_prev | round: 1 }} h in {{ pqt | escape }}</span></p>
{%- else -%}
<p class="delta"><b>No change</b><span>vs {{ md_prev | round: 1 }} h in {{ pqt | escape }}</span></p>
{%- endif -%}
{%- endif -%}
</div></div>
{%- endif -%}
</div>
<p class="body">Every figure on this page is read from the usage export for {{ account.name | escape }}, so it counts what people did in the product, not what they said they did.</p>
</section>
{%- endif -%}
{%- if nm > 1 -%}
<section class="sec field" data-section="usage">
<div class="wrap">
<div class="sh"><h2>Usage by month</h2><p class="note">Active seats in each month{% if qt != '' %}, with {{ qt | escape }} in full tone{% endif %}.</p></div>
<figure>
<div class="chart" role="img" aria-label="Active seats per month, {{ m_first | escape }} to {{ m_last | escape }}, from {{ v_first }} to {{ v_last }}">
<div class="colz" style="--nm:{{ nm }}">
{%- assign mj = 0 -%}
{%- for r in data.rows -%}
{%- if r.kind == 'month' -%}
{%- assign v = r.active_seats | default: 0 -%}
{%- assign hp = v | times: 100.0 | divided_by: top | round: 1 -%}
{%- assign show_v = show_all_v -%}
{%- if mj == 0 or mj == mid_i or mj == last_i -%}{%- assign show_v = true -%}{%- endif -%}
<div class="col{% if cq and r.quarter == cq.label %} inq{% endif %}" style="height:{{ hp }}%">{% if show_v %}<span>{{ v }}</span>{% endif %}</div>
{%- assign mj = mj | plus: 1 -%}
{%- endif -%}
{%- endfor -%}
{%- if seats_cap > 0 -%}
<div class="cap" style="bottom:{{ cap_pct }}%"><i>{{ seats_cap }} on the contract</i></div>
{%- endif -%}
</div>
<div class="mons" style="--nm:{{ nm }}" aria-hidden="true">
{%- assign mj = 0 -%}
{%- for r in data.rows -%}
{%- if r.kind == 'month' -%}
{%- assign show_ax = false -%}
{%- if mj == last_i -%}
{%- assign show_ax = true -%}
{%- else -%}
{%- assign rem = mj | modulo: lab_every -%}
{%- assign left_i = last_i | minus: mj -%}
{%- if rem == 0 and left_i >= lab_every -%}{%- assign show_ax = true -%}{%- endif -%}
{%- endif -%}
<span>{% if show_ax %}{{ r.label | escape }}{% endif %}</span>
{%- assign mj = mj | plus: 1 -%}
{%- endif -%}
{%- endfor -%}
</div>
</div>
<figcaption><b>Figure 1.</b> Active seats per month, {{ m_first | escape }} to {{ m_last | escape }}.{% if seats_cap > 0 %} The line is the {{ seats_cap }} seats on the contract.{% endif %}</figcaption>
</figure>
{%- if data.usage_note and data.usage_note != '' -%}
<p class="body">{{ data.usage_note | escape }}</p>
{%- endif -%}
</div>
</section>
{%- endif -%}
{%- if nt > 0 -%}
<section class="sec wrap split" data-section="adoption">
<div class="sh"><h2>Adoption by team</h2><p class="note">Seats active against seats assigned, by team.</p>
{%- if data.adoption_note and data.adoption_note != '' -%}
<p class="body">{{ data.adoption_note | escape }}</p>
{%- endif -%}
</div>
<figure class="bd">
<ul class="teams" role="img" aria-label="Active seats against assigned seats per team">
{%- for r in data.rows -%}
{%- if r.kind == 'team' -%}
{%- assign ta = r.active_seats | default: 0 -%}
{%- assign ts = r.seats | default: 0 -%}
{%- assign fill_p = 0 -%}
{%- if ts > 0 -%}{%- assign fill_p = ta | times: 100.0 | divided_by: ts | at_most: 100 | round: 1 -%}{%- endif -%}
<li><b>{{ r.label | truncate: 24 | escape }}</b><span class="v">{{ ta }} of {{ ts }}</span><span class="t"><i style="width:{{ fill_p }}%"></i></span></li>
{%- endif -%}
{%- endfor -%}
</ul>
<figcaption><b>Figure 2.</b> Active seats against seats assigned, per team. {{ sum_a }} of {{ sum_s }} across these teams.</figcaption>
</figure>
</section>
{%- endif -%}
{%- if win_count > 0 -%}
<section class="sec wrap" data-section="wins">
<div class="sh stack"><h2>{% if win_count == 1 %}One win{% elsif win_count == 2 %}Two wins{% else %}Three wins{% endif %}</h2><p class="note">One per team, from the usage export.</p></div>
<ul class="wins">
{%- for w in data.wins -%}
<li><p class="st tn">{{ w.stat | escape }}{% if w.unit and w.unit != '' %}<small>{{ w.unit | escape }}</small>{% endif %}</p><h3>{{ w.title | escape }}</h3><p>{{ w.body | escape }}</p><p class="team">{{ w.team | escape }}</p></li>
{%- endfor -%}
</ul>
</section>
{%- endif -%}
{%- if plan_count > 0 -%}
<section class="sec wrap" data-section="plan">
<div class="sh"><h2>{% if nextq != '' %}Plan for {{ nextq | escape }}{% else %}Plan for next quarter{% endif %}</h2><p class="note">Next steps, each with a date and an owner.</p></div>
<table class="plan">
<thead><tr><th>When</th><th>What</th><th>Who</th></tr></thead>
<tbody>
{%- for p in data.plan -%}
<tr><td class="when">{{ p.when | escape }}</td><td>{{ p.what | escape }}</td><td class="who">{{ p.who | escape }}</td></tr>
{%- endfor -%}
</tbody>
</table>
</section>
{%- endif -%}
{%- if ns > 0 -%}
<section class="sec wrap" data-section="renewal">
<div class="sh"><h2>Renewal timeline</h2><p class="note">{% if term_ok %}{{ total }}-month term from {{ m_start | date: '%-d %b %Y' }}, renews {{ days_left }} day{% if days_left != 1 %}s{% endif %} after this review.{% else %}The dates ahead for {{ account.name | escape }}.{% endif %}</p></div>
<div class="renew">
{%- if term_ok -%}
<div class="meter">
<p class="term-h">Month {{ elapsed }} of {{ total }}</p>
<div class="term" style="--tn:{{ total }}" role="img" aria-label="Month {{ elapsed }} of a {{ total }}-month term">
{%- for b in (1..total) -%}
<i{% if b < elapsed %} class="on"{% elsif b == elapsed %} class="now"{% endif %}></i>
{%- endfor -%}
</div>
<p class="term-l"><span>{{ m_start | date: '%-d %b %Y' }}</span><span>{{ m_renew | date: '%-d %b %Y' }}</span></p>
</div>
{%- endif -%}
<ol class="rail">
{%- for r in data.rows -%}
{%- if r.kind == 'milestone' -%}
{%- assign rail_class = '' -%}
{%- if term_ok and r.date -%}
{%- assign row_sec = r.date | date: '%s' | plus: 0 -%}
{%- if r.marker == 'review' -%}{%- assign rail_class = 'today' -%}{%- elsif row_sec < v_sec -%}{%- assign rail_class = 'past' -%}{%- endif -%}
{%- endif -%}
<li{% if rail_class != '' %} class="{{ rail_class }}"{% endif %}><span class="d">{% if r.date %}{{ r.date | date: '%-d %b %Y' }}{% endif %}{% if r.marker == 'review' %}<em>This review</em>{% endif %}</span><span class="w">{{ r.label | escape }}{% if r.detail and r.detail != '' %}. {{ r.detail | escape }}{% endif %}</span></li>
{%- endif -%}
{%- endfor -%}
</ol>
</div>
</section>
{%- endif -%}
<section class="next" data-section="next">
<div class="wrap in">
<p class="say">{{ data.next_note | escape }}</p>
<div class="act">
<div class="cta-wrap">{% render 'ken/cta', label: cta_label, kind: 'booking' %}</div>
{%- if sender.name -%}
<p class="sign"><b>{{ sender.name | escape }}</b><span>{% if sender.title %}{{ sender.title | escape }}{% if bname != '' %}, {% endif %}{% endif %}{{ bname | escape }}</span></p>
{%- endif -%}
</div>
<p class="method"><b>Where the numbers come from.</b> The usage export for {{ account.name | escape }}, uploaded as a CSV. Each change is against the previous quarter in that file, rounded to a whole percent. Time per task is the median.</p>
</div>
</section>
</main>
</body>
</html>
