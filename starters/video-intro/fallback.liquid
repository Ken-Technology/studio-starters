{%- assign accent = brand.colors.primary | default: '#9fc7b8' -%}
{%- assign stage = brand.colors.secondary | default: '#161c1a' -%}
{%- assign font_head = brand.fonts.heading | default: 'Archivo' -%}
{%- assign font_body = brand.fonts.body | default: 'Archivo' -%}
{%- assign first_name = person.first_name | default: '' -%}
{%- assign sender_name = sender.name | default: 'Your contact' -%}
{%- capture booking_title -%}Pick a time with {{ sender_name }}{%- endcapture -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex">
<title>A short page for {{ account.name | escape }}</title>
{%- if font_head == 'Archivo' %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;600&display=swap">
{%- else %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_head | url_encode }}&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_head | url_encode }}:wght@600&display=swap">
{%- endif %}
{%- if font_body != font_head %}
{%- if font_body == 'Archivo' %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;600&display=swap">
{%- else %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_body | url_encode }}&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_body | url_encode }}:wght@600&display=swap">
{%- endif %}
{%- endif %}
<style>
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:#e3e2da;color:#161c1a;font-family:'{{ font_body }}',ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;font-size:1.125rem;line-height:1.5;-webkit-font-smoothing:antialiased}
.vp{--paper:#e3e2da;--ink:#161c1a;--a:{{ accent }};--stage:{{ stage }};--a-ink:#161c1a;--a-ink:color(from var(--a) xyz-d65 clamp(0,(.18 - y) * 1000000,.9505) clamp(0,(.18 - y) * 1000000,1) clamp(0,(.18 - y) * 1000000,1.089));--s-ink:#e3e2da;--s-ink:color(from var(--stage) xyz-d65 clamp(0,(.18 - y) * 1000000,.9505) clamp(0,(.18 - y) * 1000000,1) clamp(0,(.18 - y) * 1000000,1.089));--m:clamp(1.25rem,3.4vw,3rem);--head:'{{ font_head }}',ui-sans-serif,system-ui,sans-serif}
.vp h1,.vp h2{font-family:var(--head);font-weight:400;letter-spacing:-.03em;line-height:1.02;text-wrap:balance;margin:0}
.vp p{margin:0;text-wrap:pretty}
.vp a:focus-visible,.vp .ken-cta:focus-visible{outline:3px solid var(--a);outline-offset:3px}
.vp-stage{background:var(--stage);color:var(--s-ink)}
.vp-stage-in{display:grid;gap:1.75rem;padding:1rem var(--m) 3.5rem;max-width:96rem;margin:0 auto}
.vp-top{display:flex;align-items:center;justify-content:space-between;gap:1rem;min-height:3.25rem}
.vp-logo{height:28px;width:auto;display:block}
.vp-brand{font-family:var(--head);font-weight:600;font-size:1.125rem}
.vp-stage h1{font-size:clamp(2.25rem,1.2rem + 3.6vw,4.25rem)}
.vp-screen{display:flex;flex-direction:column;justify-content:space-between;gap:1.5rem;padding:clamp(1.25rem,3vw,2.25rem);background:var(--a);color:var(--a-ink)}
.vp-who b{font-weight:600}
.vp-who span{display:block}
.vp-intro{font-family:var(--head);font-size:clamp(1.25rem,1.1rem + .5vw,1.5rem);line-height:1.35;max-width:36rem}
.vp-intro+.vp-intro{margin-top:.75rem}
.vp-book{background:var(--a);color:var(--a-ink);padding:4.5rem 0}
.vp-book-in{display:grid;gap:2rem;padding:0 var(--m);max-width:96rem;margin:0 auto}
.vp-book h2{font-size:clamp(2rem,1.3rem + 2vw,3rem)}
.vp-lead{margin:1rem 0 0!important;max-width:34rem}
.vp-cal{min-width:0}
.vp .ken-booking{border:0!important;border-radius:0!important;background:var(--paper)!important;color:var(--ink)!important}
.vp .ken-cta{border-radius:0!important;background:var(--ink)!important;color:var(--paper)!important;min-height:48px;display:inline-flex!important;align-items:center;font-family:var(--head)}
.vp-sign b{display:block;font-weight:600}
.vp-foot{background:var(--stage);color:var(--s-ink);padding:2rem var(--m) 2.5rem;font-size:.9375rem}
@media (min-width:1000px){
.vp-stage-in{grid-template-columns:repeat(12,minmax(0,1fr));column-gap:1.5rem;padding-bottom:5rem}
.vp-top{grid-column:1/-1}
.vp-stage h1{grid-column:1/6;align-self:end}
.vp-screen{grid-column:7/13;aspect-ratio:16/9}
.vp-book{padding:6.5rem 0}
.vp-book-in{grid-template-columns:repeat(12,minmax(0,1fr));column-gap:1.5rem;grid-template-rows:auto 1fr}
.vp-book-text{grid-column:1/6}
.vp-cal{grid-column:7/13;grid-row:1/3}
.vp-sign{grid-column:1/6;align-self:start}
}
</style>
</head>
<body>
<main class="vp">
<section data-section="video" class="vp-stage">
<div class="vp-stage-in">
<header class="vp-top">
{%- if brand.logo_url %}<img class="vp-logo" src="{{ brand.logo_url | escape }}" alt="{{ brand.name | default: 'Logo' | escape }}">{% elsif brand.name %}<p class="vp-brand">{{ brand.name | escape }}</p>{% else %}<span></span>{% endif -%}
</header>
<h1>A short page for {{ account.name | escape }}</h1>
<div class="vp-screen">
<p class="vp-who"><b>{{ sender_name | escape }}</b>{% if sender.title %}, {{ sender.title | escape }}{% if brand.name %} at {{ brand.name | escape }}{% endif %}{% elsif brand.name %}, {{ brand.name | escape }}{% endif %}<span>{% if first_name != '' %}For {{ first_name | escape }}{% if person.title %}, {{ person.title | escape }}{% endif %} at {{ account.name | escape }}{% else %}For the team at {{ account.name | escape }}{% endif %}</span></p>
<div>
<p class="vp-intro">Hi {{ first_name | default: 'there' | escape }}, I am putting together a short page for {{ account.name | escape }}: a video from me, three things I looked at about {{ account.name | escape }}, and what I would do about each one.</p>
<p class="vp-intro">It is not on this page yet. The link stays the same, so check back later today.</p>
</div>
</div>
</div>
</section>
<section data-section="booking" class="vp-book" id="book">
<div class="vp-book-in">
<div class="vp-book-text">
<h2>Rather talk now?</h2>
<p class="vp-lead">Pick twenty minutes with {{ sender_name | escape }} and I will walk you through the three points myself. On video, no slides.</p>
</div>
<div class="vp-cal">{% render 'ken/booking', height: 560, title: booking_title, label: 'Book 20 minutes' %}</div>
<p class="vp-sign"><b>{{ sender_name | escape }}</b>{% if sender.title %}{{ sender.title | escape }}{% if brand.name %}, {{ brand.name | escape }}{% endif %}{% elsif brand.name %}{{ brand.name | escape }}{% endif %}</p>
</div>
</section>
<p class="vp-foot">Made for {{ account.name | escape }} by {{ sender_name | escape }}{% if brand.name %} at {{ brand.name | escape }}{% endif %}.</p>
</main>
</body>
</html>
