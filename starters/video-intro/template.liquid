{%- assign accent = brand.colors.primary | default: '#1a5e8a' -%}
{%- assign stage = brand.colors.secondary | default: '#171a21' -%}
{%- assign font_head = brand.fonts.heading | default: 'Newsreader' -%}
{%- assign font_body = brand.fonts.body | default: 'Instrument Sans' -%}
{%- assign head_q = font_head | replace: ' ', '+' -%}
{%- assign body_q = font_body | replace: ' ', '+' -%}
{%- comment -%} The video: a row from the videos dataset wins over the campaign-wide slot. {%- endcomment -%}
{%- assign video_url = '' -%}
{%- if data.video_url and data.video_url != '' -%}{%- assign video_url = data.video_url | strip -%}{%- endif -%}
{%- if data.video_rows.size > 0 -%}
{%- assign video_row = data.video_rows | first -%}
{%- if video_row.video_url and video_row.video_url != '' -%}{%- assign video_url = video_row.video_url | strip -%}{%- endif -%}
{%- endif -%}
{%- assign video_provider = '' -%}
{%- assign video_id = '' -%}
{%- assign video_hash = '' -%}
{%- if video_url != '' -%}
{%- assign video_clean = video_url | split: '#' | first | split: '?' | first -%}
{%- assign video_segs = video_clean | split: '/' -%}
{%- assign video_last = '' -%}
{%- for seg in video_segs reversed -%}{%- if video_last == '' and seg != '' -%}{%- assign video_last = seg -%}{%- endif -%}{%- endfor -%}
{%- if video_clean contains 'loom.com/' -%}
{%- assign video_provider = 'loom' -%}{%- assign video_id = video_last -%}
{%- elsif video_clean contains 'youtu.be/' or video_clean contains 'youtube.com/' or video_clean contains 'youtube-nocookie.com/' -%}
{%- assign video_provider = 'youtube' -%}
{%- if video_url contains 'v=' -%}
{%- assign video_id = video_url | split: 'v=' | last | split: '&' | first | split: '#' | first -%}
{%- else -%}
{%- assign video_id = video_last -%}
{%- endif -%}
{%- elsif video_clean contains 'vimeo.com/' -%}
{%- assign video_provider = 'vimeo' -%}
{%- for seg in video_segs offset: 3 -%}
{%- assign seg_num = seg | plus: 0 | append: '' -%}
{%- if video_id == '' and seg_num == seg -%}{%- assign video_id = seg -%}
{%- elsif video_id != '' and video_hash == '' and seg != '' -%}{%- assign video_hash = seg -%}
{%- endif -%}
{%- endfor -%}
{%- if video_id == '' -%}{%- assign video_provider = '' -%}{%- endif -%}
{%- elsif video_clean contains 'wistia.com/' or video_clean contains 'wistia.net/' -%}
{%- assign video_provider = 'wistia' -%}{%- assign video_id = video_last -%}
{%- endif -%}
{%- endif -%}
{%- assign has_video = false -%}
{%- if video_provider != '' and video_id != '' -%}{%- assign has_video = true -%}{%- endif -%}
{%- assign first_name = person.first_name | default: '' -%}
{%- assign sender_name = sender.name | default: 'Your contact' -%}
{%- assign name_parts = sender_name | split: ' ' -%}
{%- assign initial_a = name_parts | first | slice: 0, 1 -%}
{%- assign initial_b = '' -%}
{%- if name_parts.size > 1 -%}{%- assign initial_b = name_parts | last | slice: 0, 1 -%}{%- endif -%}
{%- capture booking_title -%}Pick a time with {{ sender_name }}{%- endcapture -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex">
<title>{{ data.title | escape }}</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ head_q }}:wght@400;500;600;700&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ body_q }}:wght@400;500;600;700&display=swap">
<style>
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%;scroll-behavior:smooth}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
body{margin:0;background:#f6f6f3;color:#1c1c1e;font-family:'{{ font_body }}',ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;font-size:17px;line-height:1.55;-webkit-font-smoothing:antialiased}
.vp{--a:{{ accent }};--stage:{{ stage }};--ink:#1c1c1e;--mute:#5d5f66;--line:#dcdcd6;--on-stage:#f4f3ef;--on-stage-mute:#a9abb3;--on-stage-line:rgba(255,255,255,.16)}
.vp h1,.vp h2,.vp h3{font-family:'{{ font_head }}',Georgia,"Times New Roman",serif;font-weight:500;letter-spacing:-.01em;text-wrap:balance;margin:0}
p{margin:0}
.vp a{color:var(--a)}
.vp a:focus-visible,.vp .ken-cta:focus-visible{outline:3px solid var(--a);outline-offset:3px}
.vp-wrap{max-width:68rem;margin:0 auto;padding:0 1.25rem}
.vp-top{display:flex;align-items:center;justify-content:space-between;gap:1rem;min-height:3.5rem;padding:.75rem 0}
.vp-logo{height:28px;width:auto;display:block}
.vp-brand{font-weight:600;font-size:1rem;letter-spacing:-.01em}
.vp-for{font-size:.875rem;color:var(--mute);text-align:right}
.vp-stage{background:var(--stage);color:var(--on-stage);padding:1.75rem 0 2rem}
.vp-kicker{font-size:.9rem;color:var(--on-stage-mute);margin:0 0 .65rem}
.vp-stage h1{font-size:1.9rem;line-height:1.15;color:#fff}
.vp-frame{margin:1.35rem 0 0;position:relative;aspect-ratio:16/9;background:#000;border-radius:6px;overflow:hidden;box-shadow:0 24px 48px -24px rgba(0,0,0,.7)}
.vp-frame iframe{position:absolute;inset:0;width:100%;height:100%;border:0}
.vp-aside{margin:1.5rem 0 0}
.vp-who{display:flex;align-items:center;gap:.8rem}
.vp-ava{width:44px;height:44px;border-radius:50%;background:var(--a);color:#fff;display:grid;place-items:center;font-weight:600;font-size:.95rem;flex:none;letter-spacing:.02em}
.vp-who b{display:block;font-weight:600;color:#fff}
.vp-who span{display:block;font-size:.9rem;color:var(--on-stage-mute)}
.vp-intro{font-size:1.05rem;line-height:1.55;margin:1.1rem 0 0;max-width:38rem}
.vp-next{margin:1.25rem 0 0;padding-top:1rem;border-top:1px solid var(--on-stage-line);font-size:.92rem;color:var(--on-stage-mute)}
.vp-next a{display:inline-block;padding:.6rem 0;color:#fff;font-weight:500;text-decoration:underline;text-underline-offset:4px;text-decoration-color:var(--on-stage-mute)}
.vp-stage.is-note .vp-intro{font-size:1.15rem;max-width:36rem}
.vp-reasons{padding:2.5rem 0 1.25rem}
.vp-reasons h2,.vp-book h2{font-size:1.6rem;line-height:1.2}
.vp-reasons h2::before{content:"";display:block;width:2.5rem;height:3px;background:var(--a);margin:0 0 1rem}
.vp-lead{color:var(--mute);margin:.6rem 0 0;max-width:34rem}
.vp-list{list-style:none;margin:1.5rem 0 0;padding:0;border-top:1px solid var(--ink)}
.vp-list li{padding:1.15rem 0;border-bottom:1px solid var(--line)}
.vp .vp-list h3{font-size:1.25rem;line-height:1.25;margin:0 0 .4rem;text-wrap:pretty}
.vp-list p{color:var(--mute);font-size:1rem;line-height:1.55}
.vp-book{padding:2rem 0 2.5rem}
.vp-book .vp-lead{margin:.6rem 0 1.4rem}
.vp-cal{color:var(--mute)}
.vp-sign{margin:1.4rem 0 0;font-size:.95rem}
.vp-book .vp-sign{margin-top:1.25rem}
.vp-sign b{display:block;font-weight:600;color:var(--ink)}
.vp-sign span{color:var(--mute)}
.vp-foot{border-top:1px solid var(--line);padding:1.25rem 0 2.5rem;font-size:.85rem;color:var(--mute)}
@media (min-width:900px){
body{font-size:18px}
.vp-wrap{padding:0 2.5rem}
.vp-top{min-height:4.25rem}
.vp-stage{padding:2.5rem 0 3rem}
.vp-stage h1{font-size:2.75rem;max-width:30ch}
.vp-grid{display:grid;grid-template-columns:minmax(0,1fr) 19rem;gap:2.75rem;align-items:stretch;margin-top:1.75rem}
.vp-frame{margin:0}
.vp-aside{margin:0;display:flex;flex-direction:column}
.vp-intro{font-size:1rem}
.vp-next{margin-top:auto;padding-top:1.1rem}
.vp-stage.is-note .vp-grid{display:block}
.vp-stage.is-note .vp-aside{display:grid;grid-template-columns:minmax(0,1fr) 19rem;gap:1rem 2.75rem;align-items:start;margin-top:2rem}
.vp-stage.is-note .vp-who{grid-column:2;grid-row:1}
.vp-stage.is-note .vp-intro{grid-column:1;grid-row:1 / span 2;margin:0;font-size:1.25rem;line-height:1.5;max-width:40rem}
.vp-stage.is-note .vp-next{grid-column:2;grid-row:2;margin-top:.25rem}
.vp-reasons{padding:3.5rem 0 1.5rem}
.vp-cols{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:3rem;align-items:start}
.vp-reasons h2,.vp-book h2{font-size:1.9rem}
.vp-list{margin-top:.4rem}
.vp-list li{padding:1.35rem 0}
.vp .vp-list h3{font-size:1.35rem}
.vp-book{padding:2.5rem 0 3.5rem}
.vp-book .vp-cols{grid-template-rows:auto 1fr;row-gap:0}
.vp-book .vp-lead{margin-bottom:0}
.vp-book .vp-cal{grid-column:2;grid-row:1 / span 2}
.vp-book .vp-sign{grid-column:1;grid-row:2;margin-top:1.5rem}
}
</style>
</head>
<body>
<main class="vp">
<div class="vp-wrap">
<header class="vp-top">
{%- if brand.logo_url %}<img class="vp-logo" src="{{ brand.logo_url | escape }}" alt="{{ brand.name | default: 'Logo' | escape }}">{% elsif brand.name %}<p class="vp-brand">{{ brand.name | escape }}</p>{% else %}<span></span>{% endif -%}
<p class="vp-for">{% if has_video %}A video for {{ account.name | escape }}{% else %}A note for {{ account.name | escape }}{% endif %}</p>
</header>
</div>
<section data-section="video" class="vp-stage{% unless has_video %} is-note{% endunless %}">
<div class="vp-wrap">
<p class="vp-kicker">{% if first_name != '' %}For {{ first_name | escape }}{% if person.title %}, {{ person.title | escape }}{% endif %} at {{ account.name | escape }}{% else %}For the team at {{ account.name | escape }}{% endif %}</p>
<h1>{{ data.title | escape }}</h1>
<div class="vp-grid">
{%- if has_video %}
<div class="vp-frame">
{%- case video_provider %}
{%- when 'loom' %}
<iframe src="https://www.loom.com/embed/{{ video_id | url_encode }}" title="A video from {{ sender_name | escape }}" loading="lazy" allow="fullscreen" allowfullscreen></iframe>
{%- when 'youtube' %}
<iframe src="https://www.youtube-nocookie.com/embed/{{ video_id | url_encode }}?rel=0" title="A video from {{ sender_name | escape }}" loading="lazy" allow="fullscreen; picture-in-picture" allowfullscreen></iframe>
{%- when 'vimeo' %}
<iframe src="https://player.vimeo.com/video/{{ video_id | url_encode }}?dnt=1{% if video_hash != '' %}&h={{ video_hash | url_encode }}{% endif %}" title="A video from {{ sender_name | escape }}" loading="lazy" allow="fullscreen; picture-in-picture" allowfullscreen></iframe>
{%- when 'wistia' %}
<iframe src="https://fast.wistia.net/embed/iframe/{{ video_id | url_encode }}" title="A video from {{ sender_name | escape }}" loading="lazy" allow="fullscreen" allowfullscreen></iframe>
{%- endcase %}
</div>
{%- endif %}
<div class="vp-aside">
<div class="vp-who">
<div class="vp-ava" aria-hidden="true">{{ initial_a | upcase | escape }}{{ initial_b | upcase | escape }}</div>
<p><b>{{ sender_name | escape }}</b><span>{% if sender.title %}{{ sender.title | escape }}{% if brand.name %}, {{ brand.name | escape }}{% endif %}{% elsif brand.name %}{{ brand.name | escape }}{% else %}{% if has_video %}Recorded this for you{% else %}Wrote this for you{% endif %}{% endif %}</span></p>
</div>
<p class="vp-intro">{{ data.intro | escape }}</p>
<p class="vp-next">{% if has_video %}Watch it, then pick a time below if it is worth twenty minutes.{% else %}Read the three points below, then pick a time if it is worth twenty minutes.{% endif %} <a href="#book">Pick a time</a></p>
</div>
</div>
</div>
</section>
<section data-section="reasons" class="vp-reasons">
<div class="vp-wrap vp-cols">
<div>
<h2>Why I made this for {{ account.name | escape }}</h2>
<p class="vp-lead">Three things I looked at before {% if has_video %}recording{% else %}writing{% endif %} this, and what I would do about each one.</p>
</div>
<ol class="vp-list">
{%- for r in data.reasons %}
<li><h3>{{ r.heading | escape }}</h3><p>{{ r.body | escape }}</p></li>
{%- endfor %}
</ol>
</div>
</section>
<section data-section="booking" class="vp-book" id="book">
<div class="vp-wrap vp-cols">
<div>
<h2>Twenty minutes with {{ sender_name | escape }}</h2>
<p class="vp-lead">On video, no slides. Bring anyone at {{ account.name | escape }} who should hear it. If none of the three points lands, say so and I will not follow up.</p>
</div>
<div class="vp-cal">{% render 'ken/booking', height: 560, title: booking_title, label: 'Book 20 minutes' %}</div>
<p class="vp-sign"><b>{{ sender_name | escape }}</b><span>{% if sender.title %}{{ sender.title | escape }}{% if brand.name %}, {{ brand.name | escape }}{% endif %}{% elsif brand.name %}{{ brand.name | escape }}{% endif %}</span></p>
</div>
</section>
<div class="vp-wrap">
<p class="vp-foot">Made for {{ account.name | escape }} by {{ sender_name | escape }}{% if brand.name %} at {{ brand.name | escape }}{% endif %}. {% if first_name != '' %}This is a private link for {{ first_name | escape }}.{% else %}This link is for the {{ account.name | escape }} team.{% endif %}</p>
</div>
</main>
</body>
</html>
