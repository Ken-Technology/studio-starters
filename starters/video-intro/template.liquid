{%- assign accent = brand.colors.primary | default: '#9fc7b8' -%}
{%- assign stage = brand.colors.secondary | default: '#161c1a' -%}
{%- assign font_head = brand.fonts.heading | default: 'Archivo' -%}
{%- assign font_body = brand.fonts.body | default: 'Archivo' -%}
{%- assign head_q = font_head | replace: ' ', '+' -%}
{%- assign body_q = font_body | replace: ' ', '+' -%}
{%- comment -%} The video: a row from the videos dataset wins over the campaign-wide slot. {%- endcomment -%}
{%- assign video_url = '' -%}
{%- if data.video_url and data.video_url != '' -%}{%- assign video_url = data.video_url | strip -%}{%- endif -%}
{%- if data.video_rows.size > 0 -%}
{%- assign video_row = data.video_rows | first -%}
{%- if video_row.video_url and video_row.video_url != '' -%}{%- assign video_url = video_row.video_url | strip -%}{%- endif -%}
{%- endif -%}
{%- assign video_provider = '' -%}
{%- assign video_id = '' -%}
{%- assign video_hash = '' -%}
{%- if video_url != '' -%}
{%- assign video_clean = video_url | split: '#' | first | split: '?' | first -%}
{%- assign video_segs = video_clean | split: '/' -%}
{%- assign video_last = '' -%}
{%- for seg in video_segs reversed -%}{%- if video_last == '' and seg != '' -%}{%- assign video_last = seg -%}{%- endif -%}{%- endfor -%}
{%- if video_clean contains 'loom.com/' -%}
{%- assign video_provider = 'loom' -%}{%- assign video_id = video_last -%}
{%- elsif video_clean contains 'youtu.be/' or video_clean contains 'youtube.com/' or video_clean contains 'youtube-nocookie.com/' -%}
{%- assign video_provider = 'youtube' -%}
{%- if video_url contains 'v=' -%}
{%- assign video_id = video_url | split: 'v=' | last | split: '&' | first | split: '#' | first -%}
{%- else -%}
{%- assign video_id = video_last -%}
{%- endif -%}
{%- elsif video_clean contains 'vimeo.com/' -%}
{%- assign video_provider = 'vimeo' -%}
{%- for seg in video_segs offset: 3 -%}
{%- assign seg_num = seg | plus: 0 | append: '' -%}
{%- if video_id == '' and seg_num == seg -%}{%- assign video_id = seg -%}
{%- elsif video_id != '' and video_hash == '' and seg != '' -%}{%- assign video_hash = seg -%}
{%- endif -%}
{%- endfor -%}
{%- if video_id == '' -%}{%- assign video_provider = '' -%}{%- endif -%}
{%- elsif video_clean contains 'wistia.com/' or video_clean contains 'wistia.net/' -%}
{%- assign video_provider = 'wistia' -%}{%- assign video_id = video_last -%}
{%- endif -%}
{%- endif -%}
{%- assign has_video = false -%}
{%- if video_provider != '' and video_id != '' -%}{%- assign has_video = true -%}{%- endif -%}
{%- assign has_link = false -%}
{%- if has_video == false and video_url != '' -%}{%- assign link_head = video_url | slice: 0, 8 -%}{%- if link_head == 'https://' -%}{%- assign has_link = true -%}{%- endif -%}{%- endif -%}
{%- assign has_clip = has_video -%}{%- if has_link -%}{%- assign has_clip = true -%}{%- endif -%}
{%- assign first_name = person.first_name | default: '' -%}
{%- assign sender_name = sender.name | default: 'Your contact' -%}
{%- capture booking_title -%}Pick a time with {{ sender_name }}{%- endcapture -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex">
<title>{{ data.title | escape }}</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ head_q }}:wght@400;600&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ body_q }}:wght@400;600&display=swap">
<style>
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%;scroll-behavior:smooth}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
body{margin:0;background:#e3e2da;color:#161c1a;font-family:'{{ font_body }}',ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;font-size:1.125rem;line-height:1.5;-webkit-font-smoothing:antialiased}
.vp{--paper:#e3e2da;--ink:#161c1a;--muted:#4b524e;--a:{{ accent }};--stage:{{ stage }};--a-ink:#161c1a;--a-ink:oklch(from var(--a) clamp(0.22,(0.62 - l) * 1000,0.91) 0.008 160);--s-ink:#e3e2da;--s-ink:oklch(from var(--stage) clamp(0.22,(0.62 - l) * 1000,0.91) 0.008 160);--s-mute:color-mix(in oklch,var(--s-ink) 72%,var(--stage));--s-step:color-mix(in oklch,var(--s-ink) 9%,var(--stage));--m:clamp(1.25rem,3.4vw,3rem);--head:'{{ font_head }}',ui-sans-serif,system-ui,sans-serif}
.vp h1,.vp h2,.vp h3{font-family:var(--head);font-weight:400;letter-spacing:-.02em;line-height:1.02;text-wrap:balance;margin:0}
.vp p{margin:0;text-wrap:pretty}
.vp ::selection{background:var(--a);color:var(--a-ink)}
.vp a:focus-visible,.vp .ken-cta:focus-visible{outline:3px solid var(--a);outline-offset:3px}
.vp-stage{background:var(--stage);color:var(--s-ink)}
.vp-stage-in{display:flex;flex-direction:column;gap:1.75rem;padding:1rem var(--m) 3rem}
.vp-top{display:flex;align-items:center;justify-content:space-between;gap:1rem;min-height:3.25rem}
.vp-logo{height:28px;width:auto;display:block}
.vp-brand{font-family:var(--head);font-weight:600;font-size:1.125rem}
.vp-navbtn{display:inline-flex;align-items:center;min-height:44px;padding:0 1.1rem;background:var(--a);color:var(--a-ink);font-weight:600;text-decoration:none;white-space:nowrap}
.vp-navbtn:hover{filter:brightness(1.08)}
.vp-head{display:grid;gap:1.25rem}
.vp-stage h1{font-size:clamp(2.25rem,1.2rem + 3.6vw,4.25rem);letter-spacing:-.035em}
.vp-state{font-family:var(--head);font-size:clamp(1.375rem,1.1rem + .9vw,1.75rem);line-height:1.25;max-width:30ch}
.vp-frame{position:relative;aspect-ratio:16/9;background:#000;overflow:hidden}
.vp-frame iframe{position:absolute;inset:0;width:100%;height:100%;border:0}
.vp-poster{display:grid;place-content:center;justify-items:center;gap:1rem;background:var(--s-step);color:var(--s-ink);text-decoration:none;padding:1rem;text-align:center}
.vp-play{width:5rem;height:5rem;border-radius:50%;background:var(--a);display:grid;place-items:center}
.vp-play svg{width:1.6rem;height:1.6rem;margin-left:.3rem;fill:var(--a-ink)}
.vp-watch{font-size:1.125rem;text-decoration:underline;text-underline-offset:.2em;text-decoration-thickness:.07em}
a.vp-poster:hover .vp-play{transform:scale(1.06)}
.vp-play{transition:transform .2s ease}
.vp-who{font-size:1.125rem}
.vp-who b{font-weight:600}
.vp-who span{display:block;color:var(--s-mute)}
.vp-intro{font-size:1.125rem;max-width:40rem}
.vp-screen{display:flex;flex-direction:column;justify-content:space-between;gap:1.5rem;padding:clamp(1.25rem,3vw,2.25rem);background:var(--a);color:var(--a-ink)}
.vp-screen .vp-who span{color:inherit}
.vp-screen .vp-intro{max-width:none;font-family:var(--head);font-size:clamp(1.25rem,1.1rem + .5vw,1.5rem);line-height:1.35}
.vp-next{color:var(--s-mute)}
.vp-next a{color:var(--s-ink);font-weight:600;white-space:nowrap;text-underline-offset:.2em;text-decoration-thickness:.07em;padding:.25rem 0}
.vp-reasons{padding:3.5rem var(--m) 4.5rem}
.vp-reasons h2,.vp-book h2{font-size:clamp(2rem,1.3rem + 2vw,3rem);letter-spacing:-.03em}
.vp-lead{margin:1rem 0 0!important;max-width:34rem;color:var(--muted)}
.vp-list{list-style:none;margin:3rem 0 0;padding:0;display:grid;gap:2.75rem}
.vp-list li{border-top:4px solid var(--ink);padding-top:1.1rem}
.vp-list h3{font-size:clamp(1.5rem,1.25rem + .6vw,1.75rem);letter-spacing:-.02em;line-height:1.12;margin:0 0 .75rem}
.vp-list p{max-width:38rem}
.vp-book{background:var(--a);color:var(--a-ink);padding:4.5rem 0}
.vp-book-in{display:grid;gap:2rem;padding:0 var(--m);max-width:96rem;margin:0 auto}
.vp-book .vp-lead{color:inherit}
.vp-cal{min-width:0}
.vp .ken-booking{border:0!important;border-radius:0!important;background:var(--paper)!important;color:var(--ink)!important}
.vp .ken-cta{border-radius:0!important;background:var(--ink)!important;color:var(--paper)!important;min-height:48px;display:inline-flex!important;align-items:center;font-family:var(--head)}
.vp-sign{font-size:1.125rem}
.vp-sign b{display:block;font-weight:600}
.vp-foot{background:var(--stage);color:var(--s-ink);padding:2rem var(--m) 2.5rem;font-size:.9375rem}
@keyframes vp-rise{from{opacity:0;transform:translateY(18px)}}
@keyframes vp-pop{from{opacity:0;transform:scale(.7)}}
.vp-head>*{animation:vp-rise .7s cubic-bezier(.2,.7,.2,1) both}
.vp-head>*+*{animation-delay:.12s}
.vp-play{animation:vp-pop .5s cubic-bezier(.2,.7,.2,1) .35s both}
@media (prefers-reduced-motion:reduce){.vp-head>*,.vp-play{animation:none}}
@media (min-width:1000px){
.vp-split{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr)}
.vp-stage-in{padding:1rem var(--m) 3.5rem;gap:1.75rem}
.vp-screen{aspect-ratio:16/9}
.vp-stage.is-note h1{font-size:clamp(2.75rem,1rem + 4.2vw,5rem)}
.vp-reasons{padding:5.5rem var(--m) 6rem}
.vp-book{padding:6.5rem 0}
.vp-book-in{grid-template-columns:repeat(12,minmax(0,1fr));column-gap:1.5rem;grid-template-rows:auto 1fr}
.vp-book-text{grid-column:1/6}
.vp-cal{grid-column:7/13;grid-row:1/3}
.vp-sign{grid-column:1/6;align-self:start}
}
</style>
</head>
<body>
<main class="vp">
<div class="vp-split">
<section data-section="video" class="vp-stage{% unless has_clip %} is-note{% endunless %}">
<div class="vp-stage-in">
<header class="vp-top">
{%- if brand.logo_url %}<img class="vp-logo" src="{{ brand.logo_url | escape }}" alt="{{ brand.name | default: 'Logo' | escape }}">{% elsif brand.name %}<p class="vp-brand">{{ brand.name | escape }}</p>{% else %}<span></span>{% endif -%}
<a class="vp-navbtn" href="#book">Pick a time</a>
</header>
<div class="vp-head">
<h1>{% if has_clip %}A video for {{ account.name | escape }}{% else %}A note for {{ account.name | escape }}{% endif %}</h1>
<p class="vp-state">{{ data.title | escape }}</p>
</div>
{%- if has_video %}
<div class="vp-frame">
{%- case video_provider %}
{%- when 'loom' %}
<iframe src="https://www.loom.com/embed/{{ video_id | url_encode }}" title="A video from {{ sender_name | escape }}" loading="lazy" allow="fullscreen" allowfullscreen></iframe>
{%- when 'youtube' %}
<iframe src="https://www.youtube-nocookie.com/embed/{{ video_id | url_encode }}?rel=0" title="A video from {{ sender_name | escape }}" loading="lazy" allow="fullscreen; picture-in-picture" allowfullscreen></iframe>
{%- when 'vimeo' %}
<iframe src="https://player.vimeo.com/video/{{ video_id | url_encode }}?dnt=1{% if video_hash != '' %}&h={{ video_hash | url_encode }}{% endif %}" title="A video from {{ sender_name | escape }}" loading="lazy" allow="fullscreen; picture-in-picture" allowfullscreen></iframe>
{%- when 'wistia' %}
<iframe src="https://fast.wistia.net/embed/iframe/{{ video_id | url_encode }}" title="A video from {{ sender_name | escape }}" loading="lazy" allow="fullscreen" allowfullscreen></iframe>
{%- endcase %}
</div>
{%- elsif has_link %}
<a class="vp-frame vp-poster" href="{{ video_url | escape }}" target="_blank" rel="noopener noreferrer" data-ken-cta="video">
<span class="vp-play" aria-hidden="true"><svg viewBox="0 0 20 20"><path d="M4 2.5v15l13-7.5z"/></svg></span>
<span class="vp-watch">Watch the video from {{ sender_name | escape }}</span>
</a>
{%- endif %}
{% unless has_clip %}<div class="vp-screen">{% endunless %}
<p class="vp-who"><b>{{ sender_name | escape }}</b>{% if sender.title %}, {{ sender.title | escape }}{% if brand.name %} at {{ brand.name | escape }}{% endif %}{% elsif brand.name %}, {{ brand.name | escape }}{% endif %}<span>{% if has_clip %}Recorded{% else %}Wrote{% endif %} this for {% if first_name != '' %}{{ first_name | escape }}{% if person.title %}, {{ person.title | escape }}{% endif %} at {{ account.name | escape }}{% else %}the team at {{ account.name | escape }}{% endif %}</span></p>
<p class="vp-intro">{{ data.intro | escape }}</p>
{% unless has_clip %}</div>{% endunless %}
<p class="vp-next">{% if has_clip %}Watch it, then pick a time below if it is worth twenty minutes.{% else %}Read the three points, then pick a time if it is worth twenty minutes.{% endif %} <a href="#book">Pick a time</a></p>
</div>
</section>
<section data-section="reasons" class="vp-reasons">
<h2>Why I made this for {{ account.name | escape }}</h2>
<p class="vp-lead">Three things I looked at before {% if has_clip %}recording{% else %}writing{% endif %} this, and what I would do about each one.</p>
<ul class="vp-list">
{%- for r in data.reasons %}
<li><h3>{{ r.heading | escape }}</h3><p>{{ r.body | escape }}</p></li>
{%- endfor %}
</ul>
</section>
</div>
<section data-section="booking" class="vp-book" id="book">
<div class="vp-book-in">
<div class="vp-book-text">
<h2>Twenty minutes with {{ sender_name | escape }}</h2>
<p class="vp-lead">On video, no slides. Bring anyone at {{ account.name | escape }} who should hear it. If none of the three points lands, say so and I will not follow up.</p>
</div>
<div class="vp-cal">{% render 'ken/booking', height: 560, title: booking_title, label: 'Book 20 minutes' %}</div>
<p class="vp-sign"><b>{{ sender_name | escape }}</b>{% if sender.title %}{{ sender.title | escape }}{% if brand.name %}, {{ brand.name | escape }}{% endif %}{% elsif brand.name %}{{ brand.name | escape }}{% endif %}</p>
</div>
</section>
<p class="vp-foot">Made for {{ account.name | escape }} by {{ sender_name | escape }}{% if brand.name %} at {{ brand.name | escape }}{% endif %}. {% if first_name != '' %}This is a private link for {{ first_name | escape }}.{% else %}This link is for the {{ account.name | escape }} team.{% endif %}</p>
</main>
</body>
</html>
