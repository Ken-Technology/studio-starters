{%- assign accent = brand.colors.primary | default: '#dc1928' -%}
{%- assign ink = brand.colors.secondary | default: '#2a1110' -%}
{%- assign font_head = brand.fonts.heading | default: 'Chivo' -%}
{%- assign font_body = brand.fonts.body | default: 'Chivo' -%}
{%- assign brand_name = brand.name | default: '' -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex">
<title>A live session for {{ account.name | escape }}</title>
{%- if font_head == 'Chivo' %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Chivo:wght@400;700;900&display=swap">
{%- else %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_head | url_encode }}&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_head | url_encode }}:wght@700&display=swap">
{%- endif %}
{%- if font_body != font_head %}
{%- if font_body == 'Chivo' %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Chivo:wght@400;700&display=swap">
{%- else %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_body | url_encode }}&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_body | url_encode }}:wght@700&display=swap">
{%- endif %}
{%- endif %}
<style>
:root{--p:{{ accent | escape }};--s:{{ ink | escape }};--fh:'{{ font_head | escape }}','Arial Black',Arial,sans-serif;--fb:'{{ font_body | escape }}',Arial,sans-serif;--bone:#e2dccf;--ink:var(--s);--on-p:#fff;--off-p:#2a1110;--m:clamp(1rem,3.2vw,2.5rem)}
@supports (color:oklch(from red l c h)){:root{--ink:oklch(from var(--s) min(l,.3) c h);--on-p:color(from var(--p) xyz-d65 clamp(0,(.18 - y) * 1000000,.9505) clamp(0,(.18 - y) * 1000000,1) clamp(0,(.18 - y) * 1000000,1.089));--off-p:color(from var(--p) xyz-d65 clamp(0,(y - .18) * 1000000,.9505) clamp(0,(y - .18) * 1000000,1) clamp(0,(y - .18) * 1000000,1.089))}}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:var(--p);color:var(--on-p);font-family:var(--fb);font-size:clamp(1.0625rem,1rem + .25vw,1.1875rem);line-height:1.45;-webkit-font-smoothing:antialiased}
h1,h2{font-family:var(--fh);font-weight:900;letter-spacing:-.045em;line-height:.92;margin:0;text-wrap:balance}
p{margin:0}
:focus-visible{outline:3px solid currentColor;outline-offset:4px}
.wrap{max-width:44rem;padding:1.4rem var(--m) 4rem}
.mark{font-family:var(--fh);font-weight:900;font-size:clamp(1.25rem,1.1rem + .7vw,1.625rem);letter-spacing:-.02em}
.mark img{height:28px;width:auto;max-width:10rem;display:block}
h1{margin-top:clamp(3rem,10vw,6rem);font-size:clamp(2.25rem,8vw,4.5rem);max-width:15ch}
.lead{margin-top:1.4rem;max-width:36ch}
.seat{margin-top:3rem}
.seat h2{font-size:clamp(1.6rem,1.2rem + 2vw,2.5rem)}
.seat p{margin-top:.8rem;max-width:40ch}
.ken-form{display:grid;gap:6px;margin-top:1.6rem}
.ken-form-field{display:grid;gap:.4rem;min-width:0;font-weight:700;font-size:.875rem;padding:.8rem .9rem .9rem;background:color-mix(in srgb,var(--off-p) 20%,var(--p))}
.ken-form input{font:inherit;font-weight:400;font-size:1.0625rem;width:100%;min-height:44px;padding:.4rem 0;border:0;border-bottom:3px solid currentColor;border-radius:0;background:transparent;color:inherit}
.ken-form-submit{font-family:var(--fh)!important;font-weight:900!important;font-size:1.0625rem!important;min-height:60px;background:var(--ink)!important;color:var(--bone)!important;border-radius:0!important;padding:1rem 1.6rem!important}
.ken-form-preview{opacity:1!important}
.sign{margin-top:2.4rem;font-size:.875rem}
.sign b{font-weight:700}
</style>
</head>
<body>
<main class="wrap">
  <header data-section="program">
    {%- if brand.logo_url %}
    <div class="mark"><img src="{{ brand.logo_url | escape }}" alt="{{ brand_name | default: 'Logo' | escape }}"></div>
    {%- elsif brand_name != '' %}
    <div class="mark">{{ brand_name | escape }}</div>
    {%- endif %}
    <h1>{{ person.first_name | default: 'Hello' | escape }}, you are invited to a live session</h1>
    <p class="lead">I am putting a short live session together for the team at {{ account.name | escape }}, but the date, the speakers and the agenda are not on this page yet.</p>
  </header>
  <section class="seat" data-section="register">
    <h2>Get the details first</h2>
    <p>Leave your name and work email and I will send you the date, the speakers and the link as soon as they are set.</p>
    {% render 'ken/form', id: 'register', fields: 'name*,email*,company', submit: 'Send me the details' %}
  </section>
  <p class="sign"><b>{{ sender.name | default: 'Our team' | escape }}</b>{% if sender.title %}, {{ sender.title | escape }}{% endif %}{% if brand_name != '' %}, {{ brand_name | escape }}{% endif %}</p>
</main>
</body>
</html>
