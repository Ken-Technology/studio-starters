{%- assign accent = brand.colors.primary | default: '#99514c' -%}
{%- assign ink = brand.colors.secondary | default: '#2a1110' -%}
{%- assign font_head = brand.fonts.heading | default: 'Chivo' -%}
{%- assign font_body = brand.fonts.body | default: 'Chivo' -%}
{%- assign brand_name = brand.name | default: '' -%}
{%- assign first = person.first_name | default: '' -%}
{%- assign local = data.local_zone | default: '' | strip | downcase -%}
{%- assign has_local = false -%}
{%- assign clock_time = '' -%}
{%- for z in data.zones -%}
{%- assign zc = z.city | downcase -%}
{%- if local != '' and zc == local -%}{%- assign has_local = true -%}{%- assign clock_time = z.time -%}{%- endif -%}
{%- endfor -%}
{%- assign zone_one = data.zones | first -%}
{%- if clock_time == '' and zone_one.time -%}{%- assign clock_time = zone_one.time -%}{%- endif -%}
{%- assign clock_parts = clock_time | split: ':' -%}
{%- assign clock_h = clock_parts[0] | plus: 0 | modulo: 12 -%}
{%- assign clock_m = clock_parts[1] | slice: 0, 2 | plus: 0 -%}
{%- assign hour_deg = clock_h | times: 60 | plus: clock_m | divided_by: 2 -%}
{%- assign minute_deg = clock_m | times: 6 -%}
{%- assign title_len = data.title | size -%}
{%- assign title_size = 'short' -%}
{%- if title_len > 50 -%}{%- assign title_size = 'long' -%}{%- elsif title_len > 30 -%}{%- assign title_size = 'mid' -%}{%- endif -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex">
<title>{{ data.title | escape }}: a live session for {% if person.first_name %}{{ person.first_name | escape }}{% if person.last_name %} {{ person.last_name | escape }}{% endif %}{% else %}{{ account.name | escape }}{% endif %}</title>
{%- if font_head == 'Chivo' %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Chivo:wght@400;700;900&display=swap">
{%- else %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_head | url_encode }}&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_head | url_encode }}:wght@700&display=swap">
{%- endif %}
{%- if font_body != font_head %}
{%- if font_body == 'Chivo' %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Chivo:wght@400;700&display=swap">
{%- else %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_body | url_encode }}&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_body | url_encode }}:wght@700&display=swap">
{%- endif %}
{%- endif %}
<style>
:root{
  --p:{{ accent | escape }};
  --s:{{ ink | escape }};
  --fh:'{{ font_head | escape }}','Arial Black',Arial,sans-serif;
  --fb:'{{ font_body | escape }}',Arial,sans-serif;
  --bone:#e2dccf;
  --ink:var(--s);
{%- if brand.colors.primary %}
  --mustard:color-mix(in oklab,var(--p) 30%,var(--bone));
  --slate:color-mix(in oklab,var(--p) 45%,var(--s));
{%- else %}
  --mustard:#d4b26e;
  --slate:#4a6f84;
{%- endif %}
  --on-p:#fff;--off-p:#2a1110;--on-s:var(--bone);--on-mustard:var(--ink);--on-slate:#fff;
  --m:clamp(1rem,3.2vw,2.5rem);
  --step-small:clamp(.8125rem,.79rem + .1vw,.875rem);
  --step-body:clamp(1.0625rem,1rem + .25vw,1.1875rem);
  --step-lead:clamp(1.25rem,1.1rem + .7vw,1.625rem);
  --step-head:clamp(2.5rem,1.2rem + 5vw,5.5rem);
}
@supports (color:oklch(from red l c h)){
  :root{
    --ink:oklch(from var(--s) min(l,.3) c h);
    --on-p:color(from var(--p) xyz-d65 clamp(0,(.18 - y) * 1000000,.9505) clamp(0,(.18 - y) * 1000000,1) clamp(0,(.18 - y) * 1000000,1.089));
    --off-p:color(from var(--p) xyz-d65 clamp(0,(y - .18) * 1000000,.9505) clamp(0,(y - .18) * 1000000,1) clamp(0,(y - .18) * 1000000,1.089));
    --on-mustard:color(from var(--mustard) xyz-d65 clamp(0,(.18 - y) * 1000000,.9505) clamp(0,(.18 - y) * 1000000,1) clamp(0,(.18 - y) * 1000000,1.089));
    --on-slate:color(from var(--slate) xyz-d65 clamp(0,(.18 - y) * 1000000,.9505) clamp(0,(.18 - y) * 1000000,1) clamp(0,(.18 - y) * 1000000,1.089));
  }
}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%;scroll-behavior:smooth}
body{margin:0;background:var(--bone);color:var(--ink);font-family:var(--fb);font-size:var(--step-body);line-height:1.45;-webkit-font-smoothing:antialiased;font-variant-numeric:tabular-nums}
h1,h2,h3{font-family:var(--fh);margin:0;text-wrap:balance;hyphens:none}
h2{font-weight:900;font-size:var(--step-head);line-height:.9;letter-spacing:-.04em;max-width:16ch}
p{margin:0}
a{color:inherit;text-underline-offset:.18em;text-decoration-thickness:.08em}
:focus-visible{outline:3px solid currentColor;outline-offset:4px}
::selection{background:var(--ink);color:var(--bone)}
.field{padding:clamp(4.5rem,9vw,8.5rem) var(--m);position:relative}

/* the studio clock: the opening chapter */
.program{background:var(--p);color:var(--on-p);overflow:hidden;padding-top:1.4rem;min-height:100svh;display:flex;flex-direction:column}
.bar{display:flex;justify-content:space-between;align-items:center;gap:1rem;min-height:2.5rem;position:relative;z-index:1}
.mark{display:flex;align-items:center;gap:.6rem;font-family:var(--fh);font-weight:900;font-size:var(--step-lead);letter-spacing:-.02em}
.mark img{height:28px;width:auto;max-width:10rem;display:block}
.series{font-weight:700;font-size:var(--step-small);text-align:right}
.stage{position:relative;z-index:1;flex:1;display:flex;flex-direction:column;justify-content:center;padding:2.2rem 0 1rem;max-width:40rem}
.program h1{font-weight:900;letter-spacing:-.045em;line-height:.92;font-size:clamp(2.25rem,10vw,5rem);max-width:15ch}
.program h1.mid{font-size:clamp(1.9rem,7.6vw,4rem);max-width:20ch}
.program h1.long{font-size:clamp(1.75rem,6.6vw,3.4rem);max-width:24ch}
.sub{margin-top:1.4rem;font-size:var(--step-body);line-height:1.45;max-width:36ch}
.when{margin-top:2rem;font-family:var(--fh);font-weight:900;font-size:var(--step-lead);letter-spacing:-.02em;line-height:1.1}
.where{margin-top:.35rem;max-width:40ch}
.zones{list-style:none;margin:1.3rem 0 0;padding:0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:4px;max-width:34rem}
.zones li{padding:.75rem .9rem .8rem;background:color-mix(in srgb,var(--off-p) 20%,var(--p));min-width:0}
.zones b{display:block;white-space:nowrap;font-family:var(--fh);font-weight:900;font-size:var(--step-lead);letter-spacing:-.03em;line-height:1}
.zones span{display:block;margin-top:.3rem;font-size:var(--step-small);line-height:1.3}
.zones li.you{background:var(--ink);color:var(--bone)}
.actions{display:flex;flex-wrap:wrap;align-items:center;gap:.6rem 1.6rem;margin-top:1.6rem}
.btn{display:inline-flex;align-items:center;min-height:52px;padding:0 1.7rem;background:var(--ink);color:var(--bone);font-family:var(--fh);font-weight:900;font-size:var(--step-body);letter-spacing:-.01em;text-decoration:none;transition:transform .15s ease}
.btn:hover{transform:translateY(-2px)}
.btn:active{transform:translateY(0)}
.cal{display:inline-flex;align-items:center;min-height:44px;font-weight:700;text-decoration:underline}
.rec{margin-top:1.2rem;font-size:var(--step-small);line-height:1.45;max-width:40ch}
.clock{position:absolute;z-index:0;width:132vw;max-width:none;left:50%;top:auto;bottom:-62vw;transform:translateX(-50%);pointer-events:none}
.clock .face{fill:var(--ink)}
.clock .dot{fill:color-mix(in srgb,var(--bone) 34%,var(--ink))}
.clock .lit{fill:var(--bone)}
.clock .hr{fill:var(--p)}
.clock .hand{fill:var(--bone)}
.clock .pin{fill:var(--p)}
.sweep{transform-origin:100px 100px;animation:sweep 1.5s cubic-bezier(.2,.7,.2,1) .2s both}
@keyframes sweep{from{transform:rotate(-150deg)}to{transform:rotate(0)}}
.program .after{height:72vw}

/* note from the host */
.hello{background:var(--bone);color:var(--ink)}
.hello h2{font-size:var(--step-head)}
.hello .note{margin-top:1.6rem;font-size:var(--step-lead);line-height:1.35;letter-spacing:-.01em;max-width:38ch}
.hello .sig{margin-top:1.8rem;font-size:var(--step-body)}
.hello .sig b{font-weight:700}

/* lower thirds */
.speakers{background:var(--ink);color:var(--on-s)}
.thirds{list-style:none;margin:3rem 0 0;padding:0;display:grid;gap:2.6rem}
.thirds li{min-width:0}
.strap{display:inline-block;max-width:100%}
.strap b{display:block;width:fit-content;max-width:100%;padding:.55rem .85rem .5rem;background:var(--p);color:var(--on-p);font-family:var(--fh);font-weight:900;font-size:var(--step-lead);letter-spacing:-.03em;line-height:1}
.strap span{display:block;width:fit-content;max-width:100%;margin-left:1rem;padding:.45rem .85rem .5rem;background:var(--bone);color:var(--ink);font-family:var(--fh);font-weight:700;font-size:var(--step-small);line-height:1.3}
.thirds p{margin-top:1rem;max-width:34ch}

/* the rundown */
.agenda{background:var(--mustard);color:var(--on-mustard)}
.agenda .tz{margin-top:1rem;font-weight:700}
.rundown{list-style:none;margin:2.8rem 0 0;padding:0}
.rundown li{display:grid;grid-template-columns:minmax(0,1fr);gap:.4rem;padding:1.4rem 0}
.rundown .t{font-family:var(--fh);font-weight:900;font-size:clamp(2rem,1.4rem + 2.2vw,3.25rem);letter-spacing:-.04em;line-height:.95}
.rundown .t small{display:block;font-weight:700;font-size:var(--step-small);letter-spacing:0;margin-top:.45rem}
.rundown h3{font-weight:900;font-size:var(--step-lead);letter-spacing:-.02em;line-height:1.1}
.rundown p{margin-top:.45rem;max-width:52ch}
.rundown .who{margin-top:.6rem;font-weight:700}
.rundown li:nth-child(odd){background:color-mix(in srgb,var(--on-mustard) 7%,var(--mustard));margin:0 calc(var(--m) * -1);padding-left:var(--m);padding-right:var(--m)}

/* takeaways */
.takeaways{background:var(--slate);color:var(--on-slate)}
.takeaways .for{margin-top:1.2rem;font-size:var(--step-lead);line-height:1.3;max-width:34ch}
.takes{list-style:none;margin:3rem 0 0;padding:0;display:grid;gap:2rem}
.takes li{max-width:40ch}
.takes b{display:block;font-family:var(--fh);font-weight:900;font-size:var(--step-lead);letter-spacing:-.02em;line-height:1.1;margin-bottom:.45rem}

/* register: the closing chapter */
.register{background:var(--p);color:var(--on-p);scroll-margin-top:0}
.register .lede{margin-top:1.2rem;max-width:40ch}
.ken-form{display:grid;gap:6px;margin-top:2.4rem}
.ken-form-field{display:grid;gap:.4rem;min-width:0;font-weight:700;font-size:var(--step-small);padding:.8rem .9rem .9rem;background:color-mix(in srgb,var(--off-p) 20%,var(--p))}
.ken-form-field:focus-within{background:color-mix(in srgb,var(--off-p) 36%,var(--p))}
.ken-form input,.ken-form textarea{font:inherit;font-weight:400;font-size:var(--step-body);width:100%;min-height:44px;padding:.4rem 0;border:0;border-bottom:3px solid currentColor;border-radius:0;background:transparent;color:inherit}
.ken-form input:focus-visible{outline:none;border-bottom-color:var(--ink)}
.ken-form-submit{font-family:var(--fh)!important;font-weight:900!important;font-size:var(--step-body)!important;min-height:64px;background:var(--ink)!important;color:var(--bone)!important;border-radius:0!important;padding:1rem 1.6rem!important}
.ken-form-preview{opacity:1!important}
.fine{margin-top:1.4rem;font-size:var(--step-small);line-height:1.45;max-width:46ch}
.foot{margin-top:clamp(4rem,8vw,7rem);font-size:var(--step-small);line-height:1.45}
.foot b{font-weight:700}

@media (min-width:600px){
  .zones{grid-template-columns:repeat(4,minmax(0,1fr))}
  .ken-form{grid-template-columns:repeat(2,minmax(0,1fr))}
  .thirds{grid-template-columns:repeat(2,minmax(0,1fr));gap:2.6rem 1.5rem}
  .rundown li{grid-template-columns:minmax(0,3fr) minmax(0,9fr);column-gap:1.5rem;align-items:baseline}
  .ken-form>:not(.ken-form-field){grid-column:1/-1}
}
@media (min-width:900px){
  .program{padding-top:1.8rem}
  .stage{max-width:56%;padding:3rem 0 2.4rem}
  .program h1{font-size:clamp(3.25rem,6vw,6.5rem)}
  .program h1.mid{font-size:clamp(2.75rem,4.6vw,5rem)}
  .program h1.long{font-size:clamp(2.4rem,3.6vw,4rem)}
  .zones{grid-template-columns:repeat(auto-fit,minmax(7.5rem,1fr))}
  .clock{width:min(118vh,64vw);left:auto;right:calc(min(118vh,64vw) * -.2);top:50%;bottom:auto;transform:translateY(-46%)}
  .program .after{display:none}
  .hello{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));column-gap:1.5rem;align-items:start}
  .hello h2{grid-column:1/5}
  .hello .body{grid-column:5/13}
  .hello .note{margin-top:0}
  .thirds{grid-template-columns:repeat(auto-fit,minmax(16rem,1fr));gap:3rem 2rem;margin-top:4rem}
  .rundown{margin-top:3.6rem}
  .rundown li{padding:1.8rem 0}
  .rundown li:nth-child(odd){padding-left:var(--m);padding-right:var(--m)}
  .takeaways{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));column-gap:1.5rem;align-items:start}
  .takeaways .head{grid-column:1/6}
  .takes{grid-column:6/13;margin-top:0;grid-template-columns:repeat(2,minmax(0,1fr));gap:2.6rem 2rem}
  .register{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));column-gap:1.5rem;align-items:start}
  .register .head{grid-column:1/6}
  .register .form{grid-column:6/13}
  .register .ken-form{margin-top:0}
  .register .foot{grid-column:1/-1}
}
@media (prefers-reduced-motion:reduce){
  html{scroll-behavior:auto}
  .sweep{animation:none}
  .btn{transition:none}
}
</style>
</head>
<body>
<header class="program field" data-section="program">
  <div class="bar">
    {%- if brand.logo_url %}
    <div class="mark"><img src="{{ brand.logo_url | escape }}" alt="{{ brand_name | default: 'Logo' | escape }}"></div>
    {%- elsif brand_name != '' %}
    <div class="mark">{{ brand_name | escape }}</div>
    {%- else %}
    <div></div>
    {%- endif %}
    <p class="series">{{ data.kicker | escape }}</p>
  </div>
  <div class="stage">
    <h1 class="{{ title_size }}">{{ data.title | escape }}</h1>
    <p class="sub">{{ data.subtitle | escape }}</p>
    <p class="when">{{ data.date_text | escape }}</p>
    <p class="where">{{ data.where_text | escape }}</p>
    <ul class="zones" aria-label="Start time by city">
      {%- if has_local %}
      {%- for z in data.zones %}
      {%- assign zc = z.city | downcase %}
      {%- if zc == local %}
      <li class="you"><b>{{ z.time | escape }}</b><span>{{ z.city | escape }}, your time</span></li>
      {%- endif %}
      {%- endfor %}
      {%- endif %}
      {%- for z in data.zones %}
      {%- assign zc = z.city | downcase %}
      {%- unless has_local and zc == local %}
      <li><b>{{ z.time | escape }}</b><span>{{ z.city | escape }}</span></li>
      {%- endunless %}
      {%- endfor %}
    </ul>
    <div class="actions">
      <a class="btn" href="#register">Save my seat</a>
      {%- if data.calendar_url and data.calendar_url != '' %}
      <a class="cal" href="{{ data.calendar_url | escape }}">Add to calendar</a>
      {%- endif %}
    </div>
    <p class="rec">{{ data.recording_note | escape }}</p>
  </div>
  <svg class="clock" viewBox="0 0 200 200" aria-hidden="true">
    <circle class="face" cx="100" cy="100" r="99"/>
    {%- for i in (0..59) %}
    {%- assign hmod = i | modulo: 5 %}
    {%- if hmod == 0 %}
    <circle class="hr" cx="100" cy="12" r="3.4" transform="rotate({{ i | times: 6 }} 100 100)"/>
    {%- elsif i <= clock_m %}
    <circle class="lit" cx="100" cy="12" r="1.5" transform="rotate({{ i | times: 6 }} 100 100)"/>
    {%- else %}
    <circle class="dot" cx="100" cy="12" r="1.5" transform="rotate({{ i | times: 6 }} 100 100)"/>
    {%- endif %}
    {%- endfor %}
    <g class="sweep">
      <rect class="hand" x="96" y="46" width="8" height="58" transform="rotate({{ hour_deg }} 100 100)"/>
      <rect class="hand" x="97.5" y="24" width="5" height="80" transform="rotate({{ minute_deg }} 100 100)"/>
    </g>
    <circle class="pin" cx="100" cy="100" r="6"/>
  </svg>
  <div class="after" aria-hidden="true"></div>
</header>

<main>
  <section class="hello field" data-section="hello">
    <h2>{% if first != '' %}{{ first | escape }},{% else %}Hello,{% endif %}</h2>
    <div class="body">
      <p class="note">{{ data.why_you | escape | newline_to_br | strip_newlines | raw }}</p>
      <p class="sig"><b>{{ sender.name | default: 'Our team' | escape }}</b>{% if sender.title %}, {{ sender.title | escape }}{% endif %}{% if brand_name != '' %}, {{ brand_name | escape }}{% endif %}</p>
    </div>
  </section>

  <section class="speakers field" data-section="speakers">
    <h2>Who is speaking</h2>
    <ul class="thirds">
      {%- for sp in data.speakers %}
      <li><p class="strap"><b>{{ sp.name | escape }}</b>{% if sp.role and sp.role != '' %}<span>{{ sp.role | escape }}</span>{% endif %}</p>{% if sp.line and sp.line != '' %}<p>{{ sp.line | escape }}</p>{% endif %}</li>
      {%- endfor %}
    </ul>
  </section>

  <section class="agenda field" data-section="agenda">
    <h2>The agenda</h2>
    {%- if zone_one.city %}
    <p class="tz">Times in {{ zone_one.city | escape }}.</p>
    {%- endif %}
    <ol class="rundown">
      {%- for item in data.agenda %}
      <li><p class="t">{{ item.time | escape }}{% if item.minutes %}<small>{{ item.minutes | escape }} minutes</small>{% endif %}</p><div><h3>{{ item.title | escape }}</h3>{% if item.note and item.note != '' %}<p>{{ item.note | escape }}</p>{% endif %}{% if item.speaker and item.speaker != '' %}<p class="who">{{ item.speaker | escape }}</p>{% endif %}</div></li>
      {%- endfor %}
    </ol>
  </section>

  <section class="takeaways field" data-section="takeaways">
    <div class="head">
      <h2>What you take away</h2>
      <p class="for">{% if person.title %}Written for the {{ person.title | escape }} at {{ account.name | escape }}.{% else %}Written for the team at {{ account.name | escape }}.{% endif %}</p>
    </div>
    <ul class="takes">
      {%- for t in data.takeaways %}
      <li><b>{{ t.lead | escape }}</b>{{ t.detail | escape }}</li>
      {%- endfor %}
    </ul>
  </section>

  <section class="register field" id="register" data-section="register">
    <div class="head">
      <h2>Save your seat</h2>
      <p class="lede">{{ data.date_text | escape }}{% if has_local %}, {% for z in data.zones %}{% assign zc = z.city | downcase %}{% if zc == local %}{{ z.time | escape }} in {{ z.city | escape }}{% endif %}{% endfor %}{% elsif zone_one.time %}, {{ zone_one.time | escape }} in {{ zone_one.city | escape }}{% endif %}.</p>
    </div>
    <div class="form">
      {% render 'ken/form', id: 'register', fields: 'name*,email*,company,title', submit: 'Save my seat' %}
      <p class="fine">{{ data.register_note | escape }}</p>
    </div>
    <footer class="foot">A live session{% if brand_name != '' %} from <b>{{ brand_name | escape }}</b>{% endif %}, made for {% if person.first_name %}{{ person.first_name | escape }}{% if person.last_name %} {{ person.last_name | escape }}{% endif %}{% else %}the team{% endif %} at {{ account.name | escape }}.</footer>
  </section>
</main>
</body>
</html>
