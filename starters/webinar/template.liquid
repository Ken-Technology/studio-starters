{%- assign accent = brand.colors.primary | default: '#2a4bd7' -%}
{%- assign ink = brand.colors.secondary | default: '#0e1530' -%}
{%- assign font_head = brand.fonts.heading | default: 'Inter Tight' -%}
{%- assign font_body = brand.fonts.body | default: 'Inter' -%}
{%- assign brand_name = brand.name | default: '' -%}
{%- assign head_q = font_head | replace: ' ', '+' -%}
{%- assign body_q = font_body | replace: ' ', '+' -%}
{%- assign first = person.first_name | default: '' -%}
{%- assign local = data.local_zone | default: '' | strip | downcase -%}
{%- assign has_local = false -%}
{%- for z in data.zones -%}
{%- assign zc = z.city | downcase -%}
{%- if local != '' and zc == local -%}{%- assign has_local = true -%}{%- endif -%}
{%- endfor -%}
{%- assign variants = 'a,b,c' | split: ',' -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex">
<title>{{ data.title | escape }}: a live session for {% if person.first_name %}{{ person.first_name | escape }}{% if person.last_name %} {{ person.last_name | escape }}{% endif %}{% else %}{{ account.name | escape }}{% endif %}</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ head_q }}:wght@500;600;700&display=swap">
{%- if font_body != font_head %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ body_q }}:wght@400;500;600;700&display=swap">
{%- endif %}
<style>
:root{
  --p:{{ accent | escape }};
  --s:{{ ink | escape }};
  --fh:'{{ font_head | escape }}',ui-sans-serif,system-ui,sans-serif;
  --fb:'{{ font_body | escape }}',ui-sans-serif,system-ui,sans-serif;
  --paper:#fff;
  --on-p:#fff;
  --ink:var(--s);
  --mute:color-mix(in srgb,var(--ink) 60%,#fff);
  --rule:color-mix(in srgb,var(--ink) 13%,#fff);
  --panel:color-mix(in srgb,var(--p) 7%,#fff);
  --tint:color-mix(in srgb,var(--p) 14%,#fff);
  --accent:color-mix(in srgb,var(--p) 86%,var(--ink));
}
@supports (color:oklch(from red l c h)){
  :root{
    --on-p:oklch(from var(--p) clamp(0,(0.66 - l) * 1000,1) 0 0);
    --ink:oklch(from var(--s) min(l,0.34) c h);
  }
}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%;scroll-behavior:smooth}
body{margin:0;background:var(--paper);color:var(--ink);font:17px/1.55 var(--fb);-webkit-font-smoothing:antialiased;font-variant-numeric:tabular-nums}
h1,h2,h3{font-family:var(--fh);font-weight:600;line-height:1.1;letter-spacing:-.018em;margin:0;text-wrap:balance}
h2{font-size:1.5rem;margin-bottom:1.1rem}
p{margin:0 0 .85rem}
a{color:var(--accent)}
a:focus-visible,button:focus-visible,input:focus-visible{outline:2px solid var(--accent);outline-offset:3px}

/* program panel */
.side{background:var(--panel);border-bottom:1px solid var(--rule)}
.panel{padding:1.5rem 1.35rem 2rem}
.mark{display:flex;align-items:center;gap:.55rem;font-weight:600;font-size:.95rem;min-height:24px}
.mark .logo{height:24px;width:auto;max-width:9rem;display:block}
.mark .sq{width:24px;height:24px;border-radius:6px;background:var(--p);color:var(--on-p);display:grid;place-items:center;font-family:var(--fh);font-weight:700;font-size:.8rem;line-height:1}
.live{display:flex;align-items:center;gap:.5rem;margin:2.2rem 0 .8rem;color:var(--accent);font-weight:500;font-size:.95rem}
.live i{flex:none;width:9px;height:9px;border-radius:50%;background:var(--p);box-shadow:0 0 0 4px var(--tint)}
.panel h1{font-size:2.4rem;max-width:14ch}
.panel .sub{margin:1rem 0 0;max-width:34ch;color:var(--mute);font-size:1.02rem}
.date{margin:1.8rem 0 .7rem;font-family:var(--fh);font-weight:600;font-size:1.28rem;letter-spacing:-.01em}
.date small{display:block;font-family:var(--fb);font-weight:400;font-size:.92rem;color:var(--mute);letter-spacing:0;margin-top:.1rem}
.zones{display:grid;grid-template-columns:1fr 1fr;border:1px solid var(--rule);background:#fff}
.zones div{padding:.8rem .9rem;border-top:1px solid var(--rule);min-width:0}
.zones div:nth-child(-n+2){border-top:0}
.zones div:nth-child(even){border-left:1px solid var(--rule)}
.zones div:last-child:nth-child(odd){grid-column:1/-1}
.zones b{display:block;font-family:var(--fh);font-weight:600;font-size:1.22rem;letter-spacing:-.01em;line-height:1.1}
.zones span{display:block;font-size:.84rem;color:var(--mute);margin-top:.2rem}
.zones .you{background:var(--p);color:var(--on-p)}
.zones .you span{color:color-mix(in srgb,var(--on-p) 82%,var(--p))}
.actions{display:flex;flex-wrap:wrap;align-items:center;gap:.4rem 1.4rem;margin-top:1.4rem}
.btn{display:inline-flex;align-items:center;min-height:48px;background:var(--p);color:var(--on-p);text-decoration:none;font-weight:600;font-size:1rem;padding:0 1.6rem;border-radius:6px}
.cal{display:inline-flex;align-items:center;min-height:44px;gap:.45rem;font-size:.95rem;text-decoration:none}
.cal span{border-bottom:1px solid color-mix(in srgb,var(--accent) 40%,transparent)}
.cal svg{width:16px;height:16px;flex:none}
.rec{margin:1.2rem 0 0;font-size:.9rem;color:var(--mute);max-width:36ch}

/* content */
.content{padding:1.8rem 1.35rem 3rem;max-width:44rem}
section{padding:1.6rem 0;border-top:1px solid var(--rule)}
section:first-child{border-top:0;padding-top:0}
.hello p{font-size:1.08rem;line-height:1.6;max-width:36rem}
.hello .sal{font-family:var(--fh);font-size:1.3rem;font-weight:600;margin-bottom:.5rem}
.hello .sig{color:var(--mute);font-size:.95rem;margin-top:.9rem}
.hello .sig b{color:var(--ink);font-weight:600}

.speakers{list-style:none;margin:0;padding:0;display:grid;gap:1rem}
.speakers li{display:grid;grid-template-columns:3rem minmax(0,1fr);gap:.95rem;align-items:start}
.av{width:3rem;height:3rem;border-radius:50%;display:grid;place-items:center;font-family:var(--fh);font-weight:600;font-size:.98rem;letter-spacing:.02em}
.av.a{background:var(--p);color:var(--on-p)}
.av.b{background:var(--tint);color:var(--accent)}
.av.c{background:var(--ink);color:#fff}
.speakers b{display:block;font-weight:600}
.speakers .r{display:block;color:var(--mute);font-size:.93rem}
.speakers em{display:block;font-style:normal;font-size:.93rem;margin-top:.25rem;color:var(--ink)}

.agenda-zone{margin:-.5rem 0 1.2rem;font-size:.9rem;color:var(--mute)}
.agenda{list-style:none;margin:0;padding:0}
.agenda li{display:grid;grid-template-columns:4.1rem 1.1rem minmax(0,1fr);column-gap:.6rem;padding:0 0 1.3rem}
.agenda li:last-child{padding-bottom:0}
.agenda .t{font-weight:600;font-size:.95rem;line-height:1.3}
.agenda .t small{display:block;font-weight:400;color:var(--mute);font-size:.8rem}
.agenda .dot{position:relative}
.agenda .dot::before{content:'';position:absolute;top:.38rem;left:50%;transform:translateX(-50%);width:9px;height:9px;border-radius:50%;background:var(--p);box-shadow:0 0 0 3px #fff}
.agenda .dot::after{content:'';position:absolute;top:.6rem;bottom:-1.4rem;left:50%;width:1px;background:var(--rule)}
.agenda li:last-child .dot::after{display:none}
.agenda li:last-child .dot::before{background:var(--ink)}
.agenda h3{font-size:1.02rem;font-weight:600;letter-spacing:-.01em;line-height:1.3}
.agenda p{margin:.25rem 0 0;color:var(--mute);font-size:.93rem}
.agenda .who{display:inline-flex;align-items:center;gap:.4rem;margin-top:.4rem;font-size:.84rem;color:var(--mute)}
.agenda .who i{display:inline-grid;place-items:center;width:1.35rem;height:1.35rem;border-radius:50%;font-style:normal;font-size:.62rem;font-weight:700;font-family:var(--fh)}
.agenda .who i.a{background:var(--p);color:var(--on-p)}
.agenda .who i.b{background:var(--tint);color:var(--accent)}
.agenda .who i.c{background:var(--ink);color:#fff}

.takes{list-style:none;margin:0;padding:0;display:grid;gap:.9rem}
.takes li{position:relative;padding-left:1.5rem;max-width:36rem}
.takes li::before{content:'';position:absolute;left:0;top:.62rem;width:.75rem;height:2px;background:var(--p)}
.takes b{font-weight:600}
.for{margin:-.4rem 0 1.1rem;color:var(--mute);font-size:.95rem}

.register{scroll-margin-top:1rem}
.ken-form{display:grid;gap:.9rem;margin-top:.4rem;max-width:34rem}
.ken-form-field{display:grid;gap:.3rem;font-size:.9rem;color:var(--mute);min-width:0}
.ken-form input{font:inherit;font-size:1rem;width:100%;min-height:48px;padding:.72rem .8rem;border:1px solid color-mix(in srgb,var(--ink) 28%,#fff);border-radius:6px;background:#fff;color:var(--ink)}
.ken-form-submit{font:inherit!important;font-weight:600!important;font-size:1rem!important;min-height:48px;background:var(--p)!important;color:var(--on-p)!important;border-radius:6px!important;padding:.95rem 1.6rem!important;justify-self:start}
.fine{font-size:.86rem;color:var(--mute);margin:.2rem 0 0;max-width:30rem}
footer{padding:1.2rem 0 0;border-top:1px solid var(--rule);font-size:.86rem;color:var(--mute)}
footer b{color:var(--ink);font-weight:500}

@media (min-width:520px){
  .ken-form{grid-template-columns:1fr 1fr}
  .ken-form>:not(.ken-form-field){grid-column:1/-1}
}
@media (min-width:860px){
  body{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);min-height:100vh}
  .side{border-bottom:0;border-right:1px solid var(--rule)}
  .panel{position:sticky;top:0;min-height:100vh;padding:2.2rem 2.8rem 2.6rem;display:flex;flex-direction:column}
  .panel h1{font-size:3rem}
  .content{padding:3.2rem 3.4rem 4rem;max-width:48rem}
  section{padding:2.2rem 0}
  .speakers{grid-template-columns:repeat(3,minmax(0,1fr));gap:1.4rem}
  .speakers li{grid-template-columns:1fr;gap:.7rem;align-content:start}
  .speakers .r{min-height:2.8em}
  .agenda li{grid-template-columns:5.2rem 1.1rem minmax(0,1fr)}
}
@media (min-width:1180px){
  .panel{padding:2.8rem 3.6rem 3rem}
  .content{padding:3.6rem 4.2rem 4.5rem}
}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
</style>
</head>
<body>
<div class="side"><aside class="panel" data-section="program">
  {%- if brand.logo_url %}
  <div class="mark"><img class="logo" src="{{ brand.logo_url | escape }}" alt="{{ brand_name | default: 'Logo' | escape }}"></div>
  {%- elsif brand_name != '' %}
  <div class="mark"><span class="sq" aria-hidden="true">{{ brand_name | slice: 0, 1 | upcase | escape }}</span><span>{{ brand_name | escape }}</span></div>
  {%- endif %}
  <p class="live"><i aria-hidden="true"></i>{{ data.kicker | escape }}</p>
  <h1>{{ data.title | escape }}</h1>
  <p class="sub">{{ data.subtitle | escape }}</p>
  <p class="date">{{ data.date_text | escape }}<small>{{ data.where_text | escape }}</small></p>
  <div class="zones" role="list" aria-label="Start time by time zone">
    {%- if has_local %}
    {%- for z in data.zones %}
    {%- assign zc = z.city | downcase %}
    {%- if zc == local %}
    <div class="you" role="listitem"><b>{{ z.time | escape }}</b><span>{{ z.city | escape }}, your time</span></div>
    {%- endif %}
    {%- endfor %}
    {%- endif %}
    {%- for z in data.zones %}
    {%- assign zc = z.city | downcase %}
    {%- unless has_local and zc == local %}
    <div role="listitem"><b>{{ z.time | escape }}</b><span>{{ z.city | escape }}</span></div>
    {%- endunless %}
    {%- endfor %}
  </div>
  <div class="actions">
    <a class="btn" href="#register">Save my seat</a>
    {%- if data.calendar_url and data.calendar_url != '' %}
    <a class="cal" href="{{ data.calendar_url | escape }}">
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><rect x="1.5" y="2.5" width="13" height="12" rx="1.5"/><path d="M1.5 6.5h13M5 1v3M11 1v3"/></svg>
      <span>Add to calendar</span>
    </a>
    {%- endif %}
  </div>
  <p class="rec">{{ data.recording_note | escape }}</p>
</aside></div>

<main class="content">
  <section class="hello" data-section="hello">
    <p class="sal">{% if first != '' %}{{ first | escape }},{% else %}Hello,{% endif %}</p>
    <p>{{ data.why_you | escape | newline_to_br | strip_newlines | raw }}</p>
    <p class="sig"><b>{{ sender.name | default: 'Our team' | escape }}</b>{% if sender.title %}, {{ sender.title | escape }}{% endif %}{% if brand_name != '' %}, {{ brand_name | escape }}{% endif %}</p>
  </section>

  <section data-section="speakers">
    <h2>Who is speaking</h2>
    <ul class="speakers">
      {%- for sp in data.speakers %}
      {%- assign parts = sp.name | split: ' ' %}
      {%- assign i1 = parts | first | slice: 0, 1 %}
      {%- assign i2 = parts | last | slice: 0, 1 %}
      {%- assign v = forloop.index0 | modulo: 3 %}
      <li><span class="av {{ variants[v] }}" aria-hidden="true">{{ i1 | upcase | escape }}{% if parts.size > 1 %}{{ i2 | upcase | escape }}{% endif %}</span><div><b>{{ sp.name | escape }}</b><span class="r">{{ sp.role | escape }}</span>{% if sp.line and sp.line != '' %}<em>{{ sp.line | escape }}</em>{% endif %}</div></li>
      {%- endfor %}
    </ul>
  </section>

  <section data-section="agenda">
    <h2>The agenda</h2>
    {%- assign zone_one = data.zones | first %}
    {%- if zone_one.city %}
    <p class="agenda-zone">Times in {{ zone_one.city | escape }}.</p>
    {%- endif %}
    <ol class="agenda">
      {%- for item in data.agenda %}
      <li><div class="t">{{ item.time | escape }}{% if item.minutes %}<small>{{ item.minutes }} min</small>{% endif %}</div><div class="dot" aria-hidden="true"></div><div><h3>{{ item.title | escape }}</h3>{% if item.note and item.note != '' %}<p>{{ item.note | escape }}</p>{% endif %}
        {%- if item.speaker and item.speaker != '' %}
        <span class="who">
        {%- for sp in data.speakers %}
        {%- if sp.name == item.speaker %}
        {%- assign parts = sp.name | split: ' ' %}
        {%- assign i1 = parts | first | slice: 0, 1 %}
        {%- assign i2 = parts | last | slice: 0, 1 %}
        {%- assign v = forloop.index0 | modulo: 3 %}
        <i class="{{ variants[v] }}" aria-hidden="true">{{ i1 | upcase | escape }}{% if parts.size > 1 %}{{ i2 | upcase | escape }}{% endif %}</i>
        {%- endif %}
        {%- endfor -%}
        {{ item.speaker | escape }}</span>
        {%- endif %}</div></li>
      {%- endfor %}
    </ol>
  </section>

  <section data-section="takeaways">
    <h2>What you will take away</h2>
    <p class="for">{% if person.title %}Written for the {{ person.title | escape }} at {{ account.name | escape }}{% else %}Written for the team at {{ account.name | escape }}{% endif %}</p>
    <ul class="takes">
      {%- for t in data.takeaways %}
      <li><b>{{ t.lead | escape }}</b> {{ t.detail | escape }}</li>
      {%- endfor %}
    </ul>
  </section>

  <section class="register" id="register" data-section="register">
    <h2>Save your seat</h2>
    {% render 'ken/form', id: 'register', fields: 'name*,email*,company,title', submit: 'Save my seat' %}
    <p class="fine">{{ data.register_note | escape }}</p>
  </section>

  <footer>A live session{% if brand_name != '' %} from <b>{{ brand_name | escape }}</b>{% endif %}, made for {% if person.first_name %}{{ person.first_name | escape }}{% if person.last_name %} {{ person.last_name | escape }}{% endif %}{% else %}the team{% endif %} at {{ account.name | escape }}</footer>
</main>
</body>
</html>
