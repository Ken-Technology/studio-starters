{%- assign accent = brand.colors.primary | default: '#f3b588' -%}
{%- assign accent2 = brand.colors.secondary | default: '#050f16' -%}
{%- assign font_head = brand.fonts.heading | default: 'Bebas Neue' -%}
{%- assign font_body = brand.fonts.body | default: 'EB Garamond' -%}
{%- assign caps = true -%}
{%- if brand.fonts.heading -%}{%- assign caps = false -%}{%- endif -%}
{%- assign first = person.first_name | default: '' -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex">
<title>A workshop seat for {{ account.name | escape }}</title>
{%- if font_head == 'Bebas Neue' %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bebas+Neue&display=swap">
{%- else %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_head | url_encode }}&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_head | url_encode }}:wght@700&display=swap">
{%- endif %}
{%- if font_body != font_head %}
{%- if font_body == 'EB Garamond' %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;1,400&display=swap">
{%- else %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_body | url_encode }}&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_body | url_encode }}:wght@700&display=swap">
{%- endif %}
{%- endif %}
<style>
:root{--p:{{ accent | escape }};--s:{{ accent2 | escape }};--fh:'{{ font_head | escape }}','Arial Narrow',Arial,sans-serif;--fb:'{{ font_body | escape }}',Georgia,serif;--paper:#ffffff;--ink:var(--s);--on-p:#050f16;--k:{% if caps %}1{% else %}.7{% endif %};--m:clamp(1rem,3vw,2.25rem);--pad:clamp(1.5rem,4vw,3rem)}
@supports (color:oklch(from red l c h)){:root{--ink:oklch(from var(--s) min(l,.28) c h);--on-p:color(from var(--p) xyz-d65 clamp(0,(.18 - y) * 1000000,.9505) clamp(0,(.18 - y) * 1000000,1) clamp(0,(.18 - y) * 1000000,1.089))}}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:var(--p);color:var(--on-p);font-family:var(--fb);font-size:clamp(1.125rem,1.06rem + .25vw,1.25rem);line-height:1.45;-webkit-font-smoothing:antialiased}
h1,h2{font-family:var(--fh);font-weight:400;line-height:.9;margin:0;text-wrap:balance}
.caps h1,.caps h2{text-transform:uppercase}
p{margin:0}
:focus-visible{outline:3px solid var(--ink);outline-offset:3px}
.page{max-width:56rem;padding:0 var(--m) 3rem;display:grid;gap:1.5rem}
.top{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:1.2rem 0 .4rem}
.top img{height:28px;width:auto;max-width:10rem;display:block}
.top .brand{font-family:var(--fh);font-size:1.75rem;line-height:1}
.top .tag{font-style:italic}
.sheet{background:var(--paper);color:var(--ink);padding:var(--pad)}
.held{font-style:italic;font-size:clamp(1.375rem,1.2rem + .7vw,1.75rem);line-height:1.2}
h1{margin-top:1.2rem;font-size:calc(clamp(2.75rem,1.4rem + 6vw,6rem) * var(--k));max-width:18ch}
.dek{margin-top:1.2rem;font-size:clamp(1.375rem,1.2rem + .7vw,1.75rem);line-height:1.3;max-width:34ch}
h2{font-size:calc(2.25rem * var(--k))}
.later p{margin-top:.9rem;max-width:42ch}
.sig{margin-top:1.4rem;font-style:italic;font-size:1.375rem}
.sig span{display:block;font-style:normal;font-size:1.125rem;margin-top:.2rem}
</style>
</head>
<body{% if caps %} class="caps"{% endif %}>
<main class="page">
<header class="top">
{%- if brand.logo_url %}<img src="{{ brand.logo_url | escape }}" alt="{{ brand.name | default: 'Logo' | escape }}">{% elsif brand.name %}<p class="brand">{{ brand.name | escape }}</p>{% else %}<span></span>{% endif -%}
<p class="tag">A workshop</p>
</header>
<section data-section="invite" class="sheet">
<p class="held">{% if first != '' %}A seat held for {{ first | escape }} at {{ account.name | escape }}{% else %}A seat held for {{ account.name | escape }}{% endif %}</p>
<h1>A workshop seat for {{ account.name | escape }}</h1>
<p class="dek">{% if first != '' %}Hi {{ first | escape }}, I{% else %}I{% endif %}'m writing the invitation for {{ account.name | escape }} now: the agenda, what to bring, and what your team would leave with.</p>
</section>
<section data-section="note" class="sheet later">
<h2>The details are on their way</h2>
<p>This link stays the same, so check back later today. Once the page is ready you can hold a seat here in under a minute.</p>
<p>If you would rather hear about it now, reply to my email.</p>
<p class="sig">{{ sender.name | default: 'The host' | escape }}{% if sender.title %}<span>{{ sender.title | escape }}{% if brand.name %}, {{ brand.name | escape }}{% endif %}</span>{% elsif brand.name %}<span>{{ brand.name | escape }}</span>{% endif %}</p>
</section>
</main>
</body>
</html>
