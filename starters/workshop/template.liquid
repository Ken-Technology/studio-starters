{%- assign accent = brand.colors.primary | default: '#c2410c' -%}
{%- assign accent2 = brand.colors.secondary | default: '#1b1a17' -%}
{%- assign font_head = brand.fonts.heading | default: 'Archivo' -%}
{%- assign font_body = brand.fonts.body | default: 'Instrument Sans' -%}
{%- assign head_q = font_head | url_encode -%}
{%- assign body_q = font_body | url_encode -%}
{%- assign first = person.first_name | default: '' -%}
{%- assign in_person = true -%}
{%- if data.format == 'online' -%}{%- assign in_person = false -%}{%- endif -%}
{%- assign seats = data.seats | default: 0 -%}
{%- assign seats_left = data.seats_left | default: 0 -%}
{%- assign has_venue = false -%}
{%- if data.venue and data.venue != '' -%}{%- assign has_venue = true -%}{%- endif -%}
{%- assign has_city = false -%}
{%- if data.city and data.city != '' -%}{%- assign has_city = true -%}{%- endif -%}
{%- assign has_platform = false -%}
{%- if data.platform and data.platform != '' -%}{%- assign has_platform = true -%}{%- endif -%}
{%- assign has_audience = false -%}
{%- if data.audience and data.audience != '' -%}{%- assign has_audience = true -%}{%- endif -%}
{%- assign has_host_note = false -%}
{%- if data.host_note and data.host_note != '' -%}{%- assign has_host_note = true -%}{%- endif -%}
{%- assign submit_label = 'Hold my seat' -%}
{%- if seats_left < 1 -%}{%- assign submit_label = 'Join the waitlist' -%}{%- endif -%}
{%- assign has_confirm = false -%}
{%- if data.confirm_note and data.confirm_note != '' -%}{%- assign has_confirm = true -%}{%- endif -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex">
<title>{{ data.title | escape }}</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ head_q }}:wght@500;600;700&display=swap">
{%- if font_body != font_head %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ body_q }}:wght@400;500;600&display=swap">
{%- endif %}
<style>
:root{--p:{{ accent | escape }};--s:{{ accent2 | escape }};--paper:#f4f2ec;--card:#fffdfa;--ink:#1b1a17;--text:#3b3934;--mute:#6b675e;--line:#d9d5cb;--soft:#e9e6de;--fh:'{{ font_head | escape }}',ui-sans-serif,system-ui,'Helvetica Neue',Arial,sans-serif;--fb:'{{ font_body | escape }}',ui-sans-serif,system-ui,'Helvetica Neue',Arial,sans-serif;--mono:ui-monospace,'SF Mono',Menlo,Consolas,'Liberation Mono',monospace}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%;scroll-behavior:smooth}
body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--fb);font-size:16px;line-height:1.55;-webkit-font-smoothing:antialiased}
h1,h2,h3{font-family:var(--fh);font-weight:700;letter-spacing:-.02em;line-height:1.08;margin:0;text-wrap:balance}
p{margin:0 0 .9rem}
a{color:inherit}
.ws{max-width:72rem;margin:0 auto;padding:0 1.1rem 2.5rem}
.ws-mono{font-family:var(--mono);font-size:.72rem;letter-spacing:.09em;text-transform:uppercase}
.ws-top{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:1rem 0;border-bottom:1px solid var(--ink)}
.ws-logo{height:24px;width:auto;display:block}
.ws-brand{font-weight:600;font-size:1rem;margin:0}
.ws-tag{color:var(--mute);margin:0;white-space:nowrap}
.ws-hero{padding:2.2rem 0 1.6rem;order:1}
.ws-kicker{color:var(--p);margin:0 0 1rem;font-weight:500}
.ws-hero h1{font-size:2.55rem}
.ws-dek{font-size:1.1rem;line-height:1.5;color:var(--text);max-width:38rem;margin:1rem 0 0}
.ws-cols{display:grid;gap:0}
.ws-main,.ws-side{display:contents}
.ws-card{order:2;margin-bottom:.8rem}
.ws-note{order:3}
.ws-leave{order:4}
.ws-agenda{order:5}
.ws-bring{order:6}
.ws-host{order:7}
.ws-card{background:var(--card);border:1px solid var(--line);border-top:3px solid var(--p);border-radius:4px;padding:1.1rem 1.1rem 1.15rem}
.ws-card dl{margin:0}
.ws-card dl div{display:grid;grid-template-columns:4rem minmax(0,1fr);gap:.7rem;padding:.7rem 0;border-top:1px solid var(--soft)}
.ws-card dl div:first-child{border-top:0;padding-top:0}
.ws-card dt{color:var(--mute);padding-top:.3rem}
.ws-card dd{margin:0;font-weight:600;line-height:1.4}
.ws-card dd small{display:block;font-weight:400;color:var(--mute);font-size:.9rem;margin-top:.1rem}
.ws-seatnum{font-family:var(--fh);font-weight:700;font-size:1.7rem;line-height:1;color:var(--p);letter-spacing:-.03em;margin-right:.15rem;vertical-align:-.05em}
.ws-btn{display:flex;align-items:center;justify-content:center;min-height:48px;margin-top:1rem;background:var(--p);color:#fff;text-decoration:none;font-weight:600;font-size:1rem;border-radius:8px;padding:.7rem 1.2rem}
.ws-btn:focus-visible,.ken-form :focus-visible{outline:2px solid var(--p);outline-offset:3px}
.ws-sec{padding:1.7rem 0 1.5rem;border-top:1px solid var(--line)}
.ws-sec.ws-note{border-top:0;padding-top:.6rem}
.ws-label{color:var(--mute);margin:0 0 .7rem}
.ws-sec h2{font-size:1.55rem;margin:0 0 1rem}
.ws-note{font-size:1.06rem;color:var(--ink)}
.ws-note p{max-width:36rem}
.ws-sig{font-weight:600;margin:1.1rem 0 0}
.ws-sig span{display:block;font-weight:400;color:var(--mute);font-size:.92rem}
.ws-leave ol,.ws-agenda ol,.ws-bring ul{list-style:none;margin:0;padding:0}
.ws-leave li{display:grid;grid-template-columns:2.6rem minmax(0,1fr);gap:.5rem;padding:1rem 0;border-top:1px solid var(--soft)}
.ws-leave li:first-child{border-top:0;padding-top:0}
.ws-leave .n{font-family:var(--fh);font-weight:700;font-size:1.9rem;line-height:1;color:var(--p);letter-spacing:-.04em;padding-top:.1rem}
.ws-leave h3{font-size:1.15rem;margin:0 0 .35rem}
.ws-leave p{margin:0;color:var(--text)}
.ws-agenda li{display:grid;grid-template-columns:4.4rem minmax(0,1fr);gap:.7rem;padding:.8rem .2rem .8rem .8rem;border-top:1px solid var(--soft);border-left:3px solid transparent}
.ws-agenda li:first-child{border-top:0}
.ws-agenda li.is-hands-on{border-left-color:var(--p)}
.ws-agenda .t{font-family:var(--mono);font-size:.8rem;letter-spacing:.02em;color:var(--ink);padding-top:.2rem;line-height:1.4}
.ws-agenda .t small{display:block;color:var(--mute);font-size:.72rem}
.ws-agenda b{display:block;font-weight:600;font-size:1.02rem;line-height:1.35}
.ws-agenda li p{margin:.2rem 0 0;color:var(--mute);font-size:.95rem;max-width:34rem}
.ws-agenda li.is-break b{font-weight:500;color:var(--mute)}
.ws-pill{display:inline-block;font-family:var(--mono);font-size:.62rem;letter-spacing:.08em;text-transform:uppercase;padding:.22rem .45rem .18rem;border-radius:3px;margin-left:.45rem;vertical-align:.15em;line-height:1}
.ws-pill.hands{background:var(--p);color:#fff}
.ws-pill.talk{border:1px solid var(--line);color:var(--mute)}
.ws-bring ul{display:grid;gap:.65rem}
.ws-bring li{display:grid;grid-template-columns:1.15rem minmax(0,1fr);gap:.75rem;align-items:start;line-height:1.45}
.ws-bring li::before{content:'';width:1.1rem;height:1.1rem;border:1.5px solid var(--s);border-radius:3px;margin-top:.2rem}
.ws-who{margin:1.4rem 0 0;padding-top:1.1rem;border-top:1px solid var(--soft);display:grid;gap:.9rem}
.ws-who .ws-label{margin:0 0 .25rem}
.ws-who p{margin:0;color:var(--text)}
.ws-host .name{font-family:var(--fh);font-weight:700;font-size:1.3rem;letter-spacing:-.02em;margin:0}
.ws-host .role{color:var(--mute);margin:.15rem 0 0}
.ws-host p.note{margin:.8rem 0 0;color:var(--text);max-width:36rem}
.ws-seat{margin-top:1.6rem;background:var(--card);border:1px solid var(--line);border-radius:4px;padding:1.5rem 1.1rem 1.4rem;scroll-margin-top:1rem}
.ws-seat h2{font-size:1.6rem;margin:0 0 .8rem}
.ws-seat .left p{color:var(--text);max-width:30rem}
.ws-seat .left p.ws-seats{color:var(--p);font-weight:600}
.ws-seat .right{margin-top:1.2rem}
.ken-form{display:grid;gap:.9rem}
.ken-form-field{display:grid;gap:.35rem;font-size:.9rem;font-weight:500}
.ken-form input,.ken-form textarea,.ken-form select{font:inherit;font-size:1rem;width:100%;min-height:2.85rem;padding:.7rem .85rem;border:1px solid #bfbab0;border-radius:6px;background:#fff;color:var(--ink)}
.ken-form textarea{min-height:5.5rem;resize:vertical}
.ken-form-submit{font-family:inherit!important;font-size:1rem!important;min-height:3rem;width:100%}
.ken-form-preview{margin:0!important}
.ws-after{font-size:.9rem;color:var(--mute);margin:1rem 0 0}
.ws-after p{margin:0 0 .4rem}
.ws-foot{font-size:.8rem;color:var(--mute);padding:2rem 0 0;margin:0}
@media (min-width:900px){
body{font-size:17px}
.ws{padding:0 2rem 4rem}
.ws-top{padding:1.2rem 0}
.ws-hero{padding:3.6rem 0 2.8rem}
.ws-hero h1{font-size:4.2rem;max-width:17ch}
.ws-dek{font-size:1.25rem;margin-top:1.3rem}
.ws-cols{grid-template-columns:minmax(0,1fr) 23rem;gap:4.5rem;align-items:start}
.ws-main,.ws-side{display:block}
.ws-side{padding-top:3.6rem}
.ws-card{padding:1.3rem 1.3rem 1.35rem;margin-bottom:.4rem}
.ws-side .ws-sec{padding:1.8rem 0 1.6rem}
.ws-side .ws-sec h2{font-size:1.45rem;margin-bottom:1rem}
.ws-sec.ws-note{padding-top:.2rem}
.ws-sec{padding:2.2rem 0 2rem}
.ws-sec h2{font-size:1.9rem;margin-bottom:1.3rem}
.ws-leave li{grid-template-columns:3.6rem minmax(0,1fr);padding:1.2rem 0}
.ws-leave .n{font-size:2.6rem}
.ws-leave h3{font-size:1.25rem}
.ws-agenda li{grid-template-columns:6.4rem minmax(0,1fr);padding:.9rem .4rem .9rem 1rem}
.ws-agenda .t{font-size:.84rem}
.ws-seat{margin-top:2.5rem;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.25fr);gap:3.5rem;padding:2.6rem 2.6rem 2.4rem}
.ws-seat .right{margin-top:0}
.ws-seat h2{font-size:2rem}
}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
</style>
</head>
<body>
<main class="ws">
<header class="ws-top">
{%- if brand.logo_url %}<img class="ws-logo" src="{{ brand.logo_url | escape }}" alt="{{ brand.name | default: 'Logo' | escape }}">{% elsif brand.name %}<p class="ws-brand">{{ brand.name | escape }}</p>{% else %}<span></span>{% endif -%}
<p class="ws-tag ws-mono">Workshop &middot; {% if in_person %}In person{% else %}Online{% endif %}</p>
</header>

<div class="ws-cols">
<div class="ws-main">

<section data-section="invite" class="ws-hero">
<p class="ws-kicker ws-mono">{% if first != '' %}A seat held for {{ first | escape }} at {{ account.name | escape }}{% else %}A seat held for {{ account.name | escape }}{% endif %}</p>
<h1>{{ data.title | escape }}</h1>
<p class="ws-dek">{{ data.tagline | escape }}</p>
</section>

<section data-section="note" class="ws-sec ws-note">
<p>{% if first != '' %}Hi {{ first | escape }},{% else %}To the team at {{ account.name | escape }},{% endif %}</p>
<p>{{ data.why_you | escape | newline_to_br | strip_newlines | raw }}</p>
<p class="ws-sig">{{ sender.name | default: 'The host' | escape }}{% if sender.title %}<span>{{ sender.title | escape }}{% if brand.name %}, {{ brand.name | escape }}{% endif %}</span>{% elsif brand.name %}<span>{{ brand.name | escape }}</span>{% endif %}</p>
</section>

<section data-section="leave_with" class="ws-sec ws-leave">
<p class="ws-label ws-mono">What you leave with</p>
<h2>{% if data.leave_with.size == 3 %}Three things{% else %}What{% endif %} {{ account.name | escape }} would take home</h2>
<ol>
{%- for item in data.leave_with %}
<li><span class="n" aria-hidden="true">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span><div><h3>{{ item.lead | escape }}</h3><p>{{ item.text | escape }}</p></div></li>
{%- endfor %}
</ol>
</section>

<section data-section="agenda" class="ws-sec ws-agenda">
<p class="ws-label ws-mono">Agenda</p>
<h2>{% if in_person %}The day, hour by hour{% else %}The session, hour by hour{% endif %}</h2>
<ol>
{%- for item in data.agenda %}
{%- assign kind_class = item.kind | default: 'talk' | replace: '_', '-' %}
<li class="is-{{ kind_class }}"><span class="t">{{ item.time | escape }}{% if item.length and item.length != '' %}<small>{{ item.length | escape }}</small>{% endif %}</span><div><b>{{ item.title | escape }}{% if item.kind == 'hands_on' %}<span class="ws-pill hands">Hands-on</span>{% elsif item.kind == 'talk' %}<span class="ws-pill talk">Talk</span>{% endif %}</b>{% if item.note and item.note != '' %}<p>{{ item.note | escape }}</p>{% endif %}</div></li>
{%- endfor %}
</ol>
</section>

</div>

<aside class="ws-side">
<div class="ws-card" data-section="details">
<dl>
<div><dt class="ws-mono">When</dt><dd>{{ data.date_text | escape }}<small>{{ data.time_text | escape }}</small></dd></div>
<div><dt class="ws-mono">Where</dt><dd>
{%- if in_person -%}
{% if has_venue %}{{ data.venue | escape }}{% elsif has_city %}{{ data.city | escape }}{% else %}Venue to be confirmed{% endif %}{% if has_venue and has_city %}<small>{{ data.city | escape }}</small>{% endif %}
{%- else -%}
Online{% if has_platform %}, on {{ data.platform | escape }}{% endif %}<small>The link comes by email once your seat is confirmed.</small>
{%- endif -%}
</dd></div>
<div><dt class="ws-mono">Seats</dt><dd>
{%- if seats_left > 0 -%}
<span class="ws-seatnum">{{ seats_left }}</span>{% if seats > 0 %} of {{ seats }}{% endif %} left
{%- else -%}
<span class="ws-seatnum">Full</span><small>Leave your details and you are first in line if a seat opens.</small>
{%- endif -%}
</dd></div>
{%- if sender.name or brand.name %}
<div><dt class="ws-mono">Host</dt><dd>{{ sender.name | default: brand.name | escape }}{% if sender.name and brand.name %}<small>{% if sender.title %}{{ sender.title | escape }}, {% endif %}{{ brand.name | escape }}</small>{% elsif sender.title %}<small>{{ sender.title | escape }}</small>{% endif %}</dd></div>
{%- endif %}
</dl>
<a class="ws-btn" href="#seat">{% if seats_left > 0 %}Hold my seat{% else %}Join the waitlist{% endif %}</a>
</div>

<section data-section="bring" class="ws-sec ws-bring">
<p class="ws-label ws-mono">Bring</p>
<h2>What to bring</h2>
<ul>
{%- for item in data.bring %}
<li>{{ item | escape }}</li>
{%- endfor %}
</ul>
{%- if has_audience or seats > 0 %}
<div class="ws-who">
{%- if has_audience %}
<div><p class="ws-label ws-mono">Who it's for</p><p>{{ data.audience | escape }}</p></div>
{%- endif %}
{%- if seats > 0 %}
<div><p class="ws-label ws-mono">Group size</p><p>{{ seats }} people{% if in_person %} in one room{% else %} on one call{% endif %}, so everyone's work gets looked at.</p></div>
{%- endif %}
</div>
{%- endif %}
</section>

<section data-section="host" class="ws-sec ws-host">
<p class="ws-label ws-mono">Host</p>
<p class="name">{{ sender.name | default: brand.name | default: 'The host' | escape }}</p>
{%- if sender.title or brand.name %}
<p class="role">{% if sender.title %}{{ sender.title | escape }}{% if brand.name %}, {{ brand.name | escape }}{% endif %}{% else %}{{ brand.name | escape }}{% endif %}</p>
{%- endif %}
{%- if has_host_note %}
<p class="note">{{ data.host_note | escape | newline_to_br | strip_newlines | raw }}</p>
{%- endif %}
</section>
</aside>
</div>

<section data-section="seat" class="ws-seat" id="seat">
<div class="left">
<h2>{% if seats_left > 0 %}Hold your seat{% else %}Join the waitlist{% endif %}</h2>
{%- if seats_left > 0 %}
<p class="ws-seats">{{ seats_left }} {% if seats_left == 1 %}seat{% else %}seats{% endif %} left{% if seats > 0 %} of {{ seats }}{% endif %}.</p>
<p>Leave your details and the seat is yours. In the note, say what you would like to work on, so {{ sender.name | default: 'the host' | escape }} can prepare for it.</p>
{%- else %}
<p class="ws-seats">The room is full.</p>
<p>Leave your details anyway. If a seat opens, it goes to you first, and you hear about the next date before anyone else.</p>
{%- endif %}
<div class="ws-after">
{%- if seats_left > 0 and has_confirm %}
<p>{{ data.confirm_note | escape }}</p>
{%- elsif seats_left < 1 %}
<p>You hear by email as soon as a seat opens.</p>
{%- endif %}
<p>Can't make this date? Reply to my email and I'll tell you when the next one runs.</p>
</div>
</div>
<div class="right">
{% render 'ken/form', id: 'seat', fields: 'name*,email*,company,title,note', submit: submit_label, color: accent %}
</div>
</section>

<p class="ws-foot">This page was made for {% if first != '' %}{{ first | escape }}{% if person.last_name %} {{ person.last_name | escape }}{% endif %} at {% endif %}{{ account.name | escape }} by {{ sender.name | default: 'the host' | escape }}{% if brand.name %}, {{ brand.name | escape }}{% endif %}.</p>
</main>
</body>
</html>
